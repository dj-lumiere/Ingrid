# The slot stores behind Revare's entities. Every entity type has its own store, and each of its entities lives in a
# slot of that store: an 8-byte header holding the slot's generation, then the entity's bytes. A reference or a link to
# an entity is its address and the generation its slot had when it was made, so ending an entity raises the generation
# and every reference and link made before reads as ended from then on. The slot is free again as soon as its entity's
# destruct is done, and is reused only for the same type.
#
# A store keeps its slots in pages of 64 KiB, aligned to their size, so a slot finds its page from its own address. A
# page whose slots are all free gives its memory back to the operating system, all but its first 4 KiB, which holds the
# page's own record. The address range stays the store's, so a stale reference can always read a header: it reads the
# generation it left, or zero, and neither is a live entity's. A page used again starts its slots past every generation
# it had.
#
# The builder reads and compares generations itself (Link.rvr). This library is llvm-linked into each Revare module, so
# an optimized build inlines these routines. A store is locked while a slot is taken or given back, since entities of
# one type may be made and ended on several threads.

import Hosted

### The bytes of a page, which is aligned to them. A slot too big for one gets a page of its own, a multiple of this.
secret preset SLOT_PAGE_BYTES: U64 = 65536

### The bytes at the start of a page that keep their memory when the page is emptied: the page's record and its first
### slots.
secret preset SLOT_PAGE_KEPT: U64 = 4096

### Where a page's first entity starts: the page's record (80 bytes), then 8 spare bytes and the first slot's header, so
### each entity is 16-byte aligned.
secret preset SLOT_FIRST_ENTITY: U64 = 96

### One type's store: the zeroed global the builder makes for each entity type.
secret record SlotStore
    ### 0 while no thread is taking or giving back a slot, 1 while one is.
    lock: U64
    ### The first page with a free slot or room for a new one, 0 for none.
    room: Addr
    ### The bytes from one slot to the next, 0 before the first slot.
    stride: U64
    ### Unused, so the store is 32 bytes.
    spare: U64

### The record at the start of each page.
secret record SlotPage
    ### The store the page belongs to.
    store: Addr
    ### The first free slot's entity address, 0 for none. A free slot keeps the next one in its entity's first 8 bytes.
    free: Addr
    ### How many slots of the page were ever handed out. The ones past this have never held an entity.
    used: U64
    ### How many slots the page has.
    slots: U64
    ### How many of its slots hold an entity right now.
    live: U64
    ### The least generation a slot of the page starts at: past every generation the page had before it was emptied.
    floor: U64
    ### The next page with room, 0 for the last.
    next: Addr
    ### The page before in the list of pages with room, 0 for the first.
    previous: Addr
    ### 1 while the page is in its store's list of pages with room.
    listed: U64
    ### The page's bytes.
    bytes: U64

### C's aligned_alloc: `size` bytes aligned to `alignment`.
### :param alignment: The alignment, a power of two.
### :param size: The bytes, a multiple of the alignment.
### :returns: The memory, or null when the allocation fails.
@external("c")
@symbol("aligned_alloc")
@target(os: ("linux", "macos"))
secret routine slot_aligned_alloc(alignment: CSize, size: CSize) -> Addr

### The Windows C runtime's _aligned_malloc: `size` bytes aligned to `alignment`.
### :param size: The bytes.
### :param alignment: The alignment, a power of two.
### :returns: The memory, or null when the allocation fails.
@external("c")
@symbol("_aligned_malloc")
@target(os: "windows")
secret routine slot_aligned_malloc(size: CSize, alignment: CSize) -> Addr

### C's memset: fills `n` bytes at `dst` with the low byte of `value`.
### :param dst: Where to fill.
### :param value: The byte to fill with.
### :param n: How many bytes.
### :returns: `dst`.
@external("c")
@symbol("memset")
secret routine slot_memset(dst: Addr, value: CInt, n: CSize) -> Addr

### The C `madvise` function: tells the operating system how pages will be used.
### :param addr: The first page, page aligned.
### :param length: The bytes.
### :param advice: The `MADV_*` advice.
### :returns: 0 on success, -1 otherwise.
@external("c")
@symbol("madvise")
@target(os: ("linux", "macos"))
secret routine slot_madvise(addr: Addr, length: CSize, advice: CInt) -> CInt

### The Win32 `VirtualAlloc` function, here only to reset pages whose contents are no longer needed.
### :param addr: The first page.
### :param size: The bytes.
### :param type: The `MEM_*` type.
### :param protect: The `PAGE_*` protection.
### :returns: The start of the pages, or null.
@external("c")
@symbol("VirtualAlloc")
@callconv("stdcall")
@target(os: "windows")
secret routine slot_virtual_alloc(addr: Addr, size: CSize, type: U32, protect: U32) -> Addr

### A runtime error with the crash report and exit status (the runtime library).
### :param error_type: The error's name.
### :param message: What went wrong.
@external("c")
@symbol("__rf_throw")
@noreturn
secret routine slot_throw(error_type: CStrView, message: CStrView) -> None

### Memory for a page, aligned to the page size.
### :param bytes: The page's bytes, a multiple of the page size.
### :returns: The page's memory, or null when there is none.
@target(os: ("linux", "macos"))
secret routine slot_page_memory(bytes: U64) -> Addr
    return slot_aligned_alloc(SLOT_PAGE_BYTES.to[CSize](), bytes.to[CSize]())

### Memory for a page, aligned to the page size.
### :param bytes: The page's bytes, a multiple of the page size.
### :returns: The page's memory, or null when there is none.
@target(os: "windows")
secret routine slot_page_memory(bytes: U64) -> Addr
    return slot_aligned_malloc(bytes.to[CSize](), SLOT_PAGE_BYTES.to[CSize]())

### Gives the memory of an emptied page's bytes back to Linux: the range stays mapped and reads as zero from now on.
### :param at: The first byte, page aligned.
### :param bytes: How many bytes.
@target(os: "linux")
secret routine slot_release(at: Addr, bytes: U64) -> None
    # MADV_DONTNEED
    slot_madvise(at, bytes.to[CSize](), 4)
    return

### Gives the memory of an emptied page's bytes back to macOS: the range stays mapped and its contents may go.
### :param at: The first byte, page aligned.
### :param bytes: How many bytes.
@target(os: "macos")
secret routine slot_release(at: Addr, bytes: U64) -> None
    # MADV_FREE
    slot_madvise(at, bytes.to[CSize](), 5)
    return

### Gives the memory of an emptied page's bytes back to Windows: the pages stay committed and their contents may go.
### :param at: The first byte, page aligned.
### :param bytes: How many bytes.
@target(os: "windows")
secret routine slot_release(at: Addr, bytes: U64) -> None
    # MEM_RESET, PAGE_READWRITE
    slot_virtual_alloc(at, bytes.to[CSize](), 0x80000, 4)
    return

### Takes a store's lock, waiting while another thread holds it.
### :param store: The store.
secret routine slot_lock(store: @SlotStore) -> None
    loop
        taken: Optional[U64] = store.lock.compare_exchange_unbroken(expected: 0, new: 1)
        when taken
            is None => return
            is U64 => continue

### Leaves a store's lock.
### :param store: The store.
@inline
secret routine slot_unlock(store: @SlotStore) -> None
    store.lock.poke_unbroken(0)
    return

### The header (the generation) of the slot an entity is in.
### :param box: The entity's address.
### :returns: Its slot's generation.
@inline
secret routine slot_generation(box: Addr) -> @U64
    return (box -% ByteSize.construct(bytes: 8)).to[@U64]()

### The page a slot is in: its address rounded down to the page size.
### :param box: The entity's address.
### :returns: The page.
@inline
secret routine slot_page(box: Addr) -> @SlotPage
    at: U64 = ptrtoint[Addr, U64](box) & ~(SLOT_PAGE_BYTES - 1)
    return inttoptr[U64, Addr](at).to[@SlotPage]()

### The entity address of a page's slot.
### :param page: The page.
### :param stride: The bytes from one slot to the next.
### :param index: The slot's number in the page.
### :returns: The address the slot's entity starts at.
@inline
secret routine slot_at(page: @SlotPage, stride: U64, index: U64) -> Addr
    return bitcast[@SlotPage, Addr](page) +% ByteSize.construct(bytes: SLOT_FIRST_ENTITY + index * stride)

### Puts a page first in its store's list of pages with room.
### :param store: The store.
### :param page: The page.
secret routine slot_list_first(store: @SlotStore, page: @SlotPage) -> None
    head: Addr = store.room.peek()
    page.next.poke(head)
    page.previous.poke(Addr.zero())
    if not head.is_hollow()
        head.to[@SlotPage]().previous.poke(bitcast[@SlotPage, Addr](page))
    store.room.poke(bitcast[@SlotPage, Addr](page))
    page.listed.poke(1)
    return

### Takes a page out of its store's list of pages with room.
### :param store: The store.
### :param page: The page.
secret routine slot_unlist(store: @SlotStore, page: @SlotPage) -> None
    next: Addr = page.next.peek()
    previous: Addr = page.previous.peek()
    if previous.is_hollow()
        store.room.poke(next)
    else
        previous.to[@SlotPage]().next.poke(next)
    if not next.is_hollow()
        next.to[@SlotPage]().previous.poke(previous)
    page.next.poke(Addr.zero())
    page.previous.poke(Addr.zero())
    page.listed.poke(0)
    return

### The last page of a list of pages with room.
### :param first: The first page.
### :returns: The last page.
secret routine slot_last_page(first: Addr) -> Addr
    loop with at: Addr = first
        next: Addr = at.to[@SlotPage]().next.peek()
        if next.is_hollow()
            return at
        continue with at: next

### Puts a page last in its store's list of pages with room, so the pages that hold entities are taken from first.
### :param store: The store.
### :param page: The page.
secret routine slot_list_last(store: @SlotStore, page: @SlotPage) -> None
    if page.listed.peek() == 1
        slot_unlist(store, page)
    if store.room.peek().is_hollow()
        slot_list_first(store, page)
        return
    last: Addr = slot_last_page(store.room.peek())
    last.to[@SlotPage]().next.poke(bitcast[@SlotPage, Addr](page))
    page.previous.poke(last)
    page.next.poke(Addr.zero())
    page.listed.poke(1)
    return

### A new page for a store, first in its list of pages with room.
### :param store: The store.
### :param stride: The bytes from one slot to the next.
### :returns: The page.
secret routine slot_new_page(store: @SlotStore, stride: U64) -> @SlotPage
    bytes: U64 = when
        SLOT_FIRST_ENTITY + stride <= SLOT_PAGE_BYTES => SLOT_PAGE_BYTES
        else => (SLOT_FIRST_ENTITY + stride + SLOT_PAGE_BYTES - 1) // SLOT_PAGE_BYTES * SLOT_PAGE_BYTES
    memory: Addr = slot_page_memory(bytes)
    if memory.is_hollow()
        slot_throw("OutOfMemoryError", "Failed to allocate a page of entity slots")
    slot_memset(memory, 0, SLOT_FIRST_ENTITY.to[CSize]())
    page: @SlotPage = memory.to[@SlotPage]()
    page.store.poke(bitcast[@SlotStore, Addr](store))
    slots: U64 = when
        bytes == SLOT_PAGE_BYTES => (SLOT_PAGE_BYTES - SLOT_FIRST_ENTITY + 8) // stride
        else => 1
    page.slots.poke(slots)
    page.floor.poke(1)
    page.bytes.poke(bytes)
    slot_list_first(store, page)
    return page

### A slot for a new entity: a free one of the type's store, else a new one. The entity's bytes are zero. The slot keeps
### the generation its last entity left it with, and a slot never used starts past every generation its page had.
### :param store: The type's store.
### :param size: The entity's bytes.
### :returns: The address the entity's bytes go to.
@export("rf_slot_take")
routine rf_slot_take(store: Addr, size: U64) -> Addr
    s: @SlotStore = store.to[@SlotStore]()
    slot_lock(s)
    if s.stride.peek() == 0
        least: U64 = when
            size < 8 => 8
            else => size
        s.stride.poke((least + 8 + 15) // 16 * 16)
    stride: U64 = s.stride.peek()
    page: @SlotPage = when
        s.room.peek().is_hollow() => slot_new_page(s, stride)
        else => s.room.peek().to[@SlotPage]()
    box: Addr = when
        page.free.peek().is_hollow() => slot_at(page, stride, page.used.peek())
        else => page.free.peek()
    if page.free.peek().is_hollow()
        page.used.poke(page.used.peek() + 1)
    else
        page.free.poke(box.to[@Addr]().peek())
    generation: @U64 = slot_generation(box)
    if generation.peek() < page.floor.peek()
        generation.poke(page.floor.peek())
    page.live.poke(page.live.peek() + 1)
    if page.free.peek().is_hollow() and page.used.peek() == page.slots.peek()
        slot_unlist(s, page)
    slot_unlock(s)
    slot_memset(box, 0, size.to[CSize]())
    return box

### The start of an entity's end, run first in its destruct: the generation goes up, so every reference and link made
### before reads as ended from now on.
### :param box: The entity's address.
@export("rf_slot_end")
@inline
routine rf_slot_end(box: Addr) -> None
    generation: @U64 = slot_generation(box)
    generation.poke(generation.peek() + 1)
    return

### Empties a page whose slots are all free: it starts its slots past every generation it had, forgets its free slots,
### and gives back the memory past its first 4 KiB when the store has another page with room.
### :param store: The store.
### :param page: The page.
### :param stride: The bytes from one slot to the next.
secret routine slot_empty_page(store: @SlotStore, page: @SlotPage, stride: U64) -> None
    floor: &U64 <- page.floor.peek()
    for i in 0 til page.used.peek()
        seen: U64 = slot_generation(slot_at(page, stride, i)).peek()
        if seen > floor.load()
            floor.store(seen)
    page.floor.poke(floor.load())
    page.free.poke(Addr.zero())
    page.used.poke(0)
    if store.room.peek() === bitcast[@SlotPage, Addr](page) and page.next.peek().is_hollow()
        return
    slot_list_last(store, page)
    kept: Addr = bitcast[@SlotPage, Addr](page) +% ByteSize.construct(bytes: SLOT_PAGE_KEPT)
    slot_release(kept, page.bytes.peek() - SLOT_PAGE_KEPT)
    return

### Gives an ended entity's slot back to its store, run last in its destruct. The slot can hold a new entity at once.
### :param box: The entity's address.
@export("rf_slot_give_back")
routine rf_slot_give_back(box: Addr) -> None
    page: @SlotPage = slot_page(box)
    s: @SlotStore = page.store.peek().to[@SlotStore]()
    slot_lock(s)
    box.to[@Addr]().poke(page.free.peek())
    page.free.poke(box)
    page.live.poke(page.live.peek() - 1)
    if page.listed.peek() == 0
        slot_list_first(s, page)
    if page.live.peek() == 0
        slot_empty_page(s, page, s.stride.peek())
    slot_unlock(s)
    return
