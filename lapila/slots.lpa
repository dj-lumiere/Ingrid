# The slot stores behind Revare's entities. Every entity type has its own store, a zeroed 32-byte global the builder
# makes, and each of its entities lives in a slot of that store: an 8-byte header holding the slot's generation, then
# the entity's bytes. A reference or a link to an entity is its address and the generation its slot had when it was
# made, so ending an entity raises the generation and every reference and link made before reads as ended from then
# on. The slot is free again as soon as its entity's destruct is done, and is reused only for the same type.
#
# The store itself is Lapila's standard library SlotStore (System/Memory/SlotStore.lpa): its pages, the memory it
# gives back to the operating system, and its lock. This file exports its routines under the C names Revare's builder
# calls. The builder reads and compares generations itself (Link.rvr). This library is llvm-linked into each Revare
# module, so an optimized build inlines these routines.

### A runtime error with the crash report and exit status (the runtime library).
### :param error_type: The error's name.
### :param message: What went wrong.
@external("c")
@symbol("__rf_throw")
@noreturn
secret routine slot_throw(error_type: CStrView, message: CStrView) -> None

### A slot for a new entity: a free one of the type's store, else a new one. The entity's bytes are zero.
### :param store: The type's store.
### :param size: The entity's bytes.
### :returns: The address the entity's bytes go to.
@export("rf_slot_take")
routine rf_slot_take(store: Addr, size: U64) -> Addr
    box: Addr = store.to[@SlotStore]().take(size)
    if box.is_hollow()
        slot_throw("OutOfMemoryError", "Failed to allocate a page of entity slots")
    return box

### The start of an entity's end, run first in its destruct: the generation goes up, so every reference and link made
### before reads as ended from now on.
### :param box: The entity's address.
@export("rf_slot_end")
@inline
routine rf_slot_end(box: Addr) -> None
    SlotStore.end(box)
    return

### Gives an ended entity's slot back to its store, run last in its destruct. The slot can hold a new entity at once.
### :param box: The entity's address.
@export("rf_slot_give_back")
routine rf_slot_give_back(box: Addr) -> None
    SlotStore.give_back(box)
    return
