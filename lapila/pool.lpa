# The fetch of Revare's `Stamped[E]` and the range test of `rf_invalidate`. This library is llvm-linked into each Revare
# module, so an optimized build inlines the fetch into the program: no call per fetch. The pool is the runtime's
# (Ingrid/runtime-lapila/pool.lpa), whose range start and size it exports under C names: a slot is the range's start
# plus the slot's number times 16, and the entity's bytes follow the slot's 16-byte header.

### The start of the pool's reserved range, 0 while no pool is set up.
@external("c")
@symbol("lapila_pool_base")
secret global POOL_BASE: &Addr

### The bytes the pool reserved, 0 while no pool is set up.
@external("c")
@symbol("lapila_pool_reserved")
secret global POOL_RESERVED: &U64

### The head of a slot: the type id, the generation, and room that keeps the entity 16-byte aligned.
secret record PoolSlotHeader
    ### The type id of the slot's entity, 0 while it holds none.
    type_id: U32
    ### Goes up each time the slot's entity is removed or the pool ends.
    generation: U32
    ### Keeps the entity 16-byte aligned.
    spare: U64

### Whether an address is inside the pool's range, where an entity's block is a slot that is not the heap's to free.
### :param ptr: The address.
### :returns: True for an address of the range.
@inline
secret routine in_pool(ptr: Addr) -> Bool
    base: U64 = ptrtoint[Addr, U64](POOL_BASE.load())
    return ptrtoint[Addr, U64](ptr) -% base < POOL_RESERVED.load()

### The entity a stamp names, or zero once it was removed or the pool ended. One read of the range's start and one of the
### slot's generation.
### :param slot: The stamp's slot.
### :param generation: The stamp's generation.
### :returns: The address of the entity's bytes, or zero.
@export("rf_pool_fetch")
routine rf_pool_fetch(slot: U32, generation: U32) -> Addr
    start: Addr = POOL_BASE.load()
    if start.is_hollow()
        return Addr.zero()
    base: @Byte = bitcast[Addr, @Byte](start).stride(slot.to[U64]() << 4)
    if base.to[@PoolSlotHeader]().generation.peek() != generation
        return Addr.zero()
    return base.stride(16).to[Addr]()
