# The B128 arithmetic RazorForge's B128 is built on, and the few B16, B32, and BF16 operations that are not one
# builder operation: each is Tessera's software routine. A B128 goes in as its low and high 64 bits and comes back in
# Words (words.te), `w0` its low bits and `w1` its high bits. Every routine is the raw IEEE operation, so the checked
# forms keep their crash in RazorForge.

# ── B128 arithmetic ──────────────────────────────────────────────────────────────

### `x + y`, rounded to nearest (ties to even), for B128.add_unchecked.
### :param low: The low 64 bits of x.
### :param high: The high 64 bits of x.
### :param y_low: The low 64 bits of y.
### :param y_high: The high 64 bits of y.
### :returns: `x + y`, its low 64 bits in w0 and its high 64 bits in w1.
@export("ingrid_b128_add")
routine b128_add(low: U64, high: U64, y_low: U64, y_high: U64) -> Words
    x: B128 = b128_from_halves(low, high)
    y: B128 = b128_from_halves(low: y_low, high: y_high)
    return b128_words(x.add_unchecked(y))

### `x - y`, rounded to nearest (ties to even), for B128.sub_unchecked.
### :param low: The low 64 bits of x.
### :param high: The high 64 bits of x.
### :param y_low: The low 64 bits of y.
### :param y_high: The high 64 bits of y.
### :returns: `x - y`, its low 64 bits in w0 and its high 64 bits in w1.
@export("ingrid_b128_sub")
routine b128_sub(low: U64, high: U64, y_low: U64, y_high: U64) -> Words
    x: B128 = b128_from_halves(low, high)
    y: B128 = b128_from_halves(low: y_low, high: y_high)
    return b128_words(x.sub_unchecked(y))

### `x * y`, rounded to nearest (ties to even), for B128.mul_unchecked.
### :param low: The low 64 bits of x.
### :param high: The high 64 bits of x.
### :param y_low: The low 64 bits of y.
### :param y_high: The high 64 bits of y.
### :returns: `x * y`, its low 64 bits in w0 and its high 64 bits in w1.
@export("ingrid_b128_mul")
routine b128_mul(low: U64, high: U64, y_low: U64, y_high: U64) -> Words
    x: B128 = b128_from_halves(low, high)
    y: B128 = b128_from_halves(low: y_low, high: y_high)
    return b128_words(x.mul_unchecked(y))

### `x / y`, rounded to nearest (ties to even), for B128.truediv_unchecked.
### :param low: The low 64 bits of x.
### :param high: The high 64 bits of x.
### :param y_low: The low 64 bits of y.
### :param y_high: The high 64 bits of y.
### :returns: `x / y`, its low 64 bits in w0 and its high 64 bits in w1.
@export("ingrid_b128_div")
routine b128_div(low: U64, high: U64, y_low: U64, y_high: U64) -> Words
    x: B128 = b128_from_halves(low, high)
    y: B128 = b128_from_halves(low: y_low, high: y_high)
    return b128_words(x.truediv_unchecked(y))

### The remainder of `x / y` with the quotient truncated (C fmod), exact, for B128.mod_trunc.
### :param low: The low 64 bits of x.
### :param high: The high 64 bits of x.
### :param y_low: The low 64 bits of y.
### :param y_high: The high 64 bits of y.
### :returns: The remainder, its low 64 bits in w0 and its high 64 bits in w1.
@export("ingrid_b128_mod_trunc")
routine b128_mod_trunc(low: U64, high: U64, y_low: U64, y_high: U64) -> Words
    x: B128 = b128_from_halves(low, high)
    y: B128 = b128_from_halves(low: y_low, high: y_high)
    return b128_words(x.mod_trunc_unchecked(y))

### The remainder of `x / y` with the quotient rounded to nearest, ties to even (C remainder), exact, for B128.rem.
### :param low: The low 64 bits of x.
### :param high: The high 64 bits of x.
### :param y_low: The low 64 bits of y.
### :param y_high: The high 64 bits of y.
### :returns: The remainder, its low 64 bits in w0 and its high 64 bits in w1.
@export("ingrid_b128_rem")
routine b128_rem(low: U64, high: U64, y_low: U64, y_high: U64) -> Words
    x: B128 = b128_from_halves(low, high)
    y: B128 = b128_from_halves(low: y_low, high: y_high)
    return b128_words(x.rem_unchecked(y))

### `x` rounded to an integer, for B128.trunc, floor, ceil, round, and rint.
### :param low: The low 64 bits of x.
### :param high: The high 64 bits of x.
### :param mode: 0 toward zero, 1 down, 2 up, 3 to nearest with ties away from zero, 4 to nearest with ties to even.
### :returns: The integer value, its low 64 bits in w0 and its high 64 bits in w1.
@export("ingrid_b128_round_int")
routine b128_round_int_export(low: U64, high: U64, mode: U32) -> Words
    x: B128 = b128_from_halves(low, high)
    r: B128 = when mode
        0 => x.trunc()
        1 => x.floor()
        2 => x.ceil()
        3 => x.round()
        else => x.round_ties_even()
    return b128_words(r)

### `x * 2^n` (C scalbn), rounded once, for B128.scalbn.
### :param low: The low 64 bits of x.
### :param high: The high 64 bits of x.
### :param n: The power of two.
### :returns: `x * 2^n`, its low 64 bits in w0 and its high 64 bits in w1.
@export("ingrid_b128_scalbn")
routine b128_scalbn(low: U64, high: U64, n: S64) -> Words
    x: B128 = b128_from_halves(low, high)
    return b128_words(x.scalbn_unchecked(n))

# ── B128 conversions ─────────────────────────────────────────────────────────────

### The B128 nearest the unsigned 128-bit integer high × 2^64 + low, for U128.to[B128].
### :param low: The low 64 bits of the integer.
### :param high: The high 64 bits of the integer.
### :returns: The B128, its low 64 bits in w0 and its high 64 bits in w1.
@export("ingrid_b128_from_u128")
routine b128_from_u128(low: U64, high: U64) -> Words
    n: U128 = (high.to[U128]() << 64) | low.to[U128]()
    return b128_words(n.to[B128]())

### The unsigned 256-bit integer (w3 w2 w1 w0, w0 lowest) as hi × 2^128 + lo with hi and lo each rounded to B128
### first and the sum rounded once more, for U256.to[B128].
### :param w0: The lowest 64 bits.
### :param w1: The next 64 bits.
### :param w2: The next 64 bits.
### :param w3: The highest 64 bits.
### :returns: The B128, its low 64 bits in w0 and its high 64 bits in w1.
@export("ingrid_b128_from_u256")
routine b128_from_u256(w0: U64, w1: U64, w2: U64, w3: U64) -> Words
    lo: U128 = (w1.to[U128]() << 64) | w0.to[U128]()
    hi: U128 = (w3.to[U128]() << 64) | w2.to[U128]()
    # 2^128: biased exponent 16383 + 128
    two128: B128 = B128.from_bits(0x407F0000000000000000000000000000)
    top: B128 = hi.to[B128]() *! two128
    return b128_words(top +! lo.to[B128]())

### A B64 widened to B128 (exact), for B64.to[B128]. An infinity or a NaN keeps its sign and its 52 payload bits,
### moved to the top of the B128's, the quiet bit as it was.
### :param x: The B64's bits.
### :returns: The B128, its low 64 bits in w0 and its high 64 bits in w1.
@export("ingrid_b128_from_b64")
routine b128_from_b64(x: U64) -> Words
    if (x >> 52) & 0x7FF == 0x7FF
        sign: U128 = (x >> 63).to[U128]() << 127
        payload: U128 = (x & 0x000FFFFFFFFFFFFF).to[U128]() << 60
        return b128_words(B128.from_bits(sign | B128_INF | payload))
    return b128_words(B64.from_bits(x).to[B128]())

### The B64 nearest x (an infinity past its range, a NaN the quiet NaN with x's sign), for B128.to_unchecked[B64].
### :param low: The low 64 bits of x.
### :param high: The high 64 bits of x.
### :returns: The B64's bits.
@export("ingrid_b128_to_b64")
routine b128_to_b64(low: U64, high: U64) -> U64
    x: B128 = b128_from_halves(low, high)
    if x.is_nan()
        return (high & 0x8000000000000000) | 0x7FF8000000000000
    return x.to_unchecked[B64]().bits()

# ── B16, B32, BF16 ───────────────────────────────────────────────────────────────

### x * y + z with one rounding, for B16.mul_add_unchecked.
### :param x: The first factor's bits.
### :param y: The second factor's bits.
### :param z: The addend's bits.
### :returns: The result's bits.
@export("ingrid_b16_mul_add")
routine b16_mul_add(x: U16, y: U16, z: U16) -> U16
    return B16.from_bits(x).mul_add_unchecked(B16.from_bits(y), B16.from_bits(z)).bits()

### The remainder of `x / y` with the quotient truncated (C fmod), exact, for B32.mod_trunc.
### :param x: The dividend's bits.
### :param y: The divisor's bits.
### :returns: The remainder's bits.
@export("ingrid_b32_mod_trunc")
routine b32_mod_trunc(x: U32, y: U32) -> U32
    return B32.from_bits(x).mod_trunc_unchecked(B32.from_bits(y)).bits()

### The BF16 nearest a B32 (ties to even, an infinity past the range), for B32.to_unchecked[BF16]. A NaN keeps its
### sign and its top payload bits, with the quiet bit set.
### :param x: The B32's bits.
### :returns: The BF16's bits.
@export("ingrid_b32_to_bf16")
routine b32_to_bf16(x: U32) -> U16
    if x & 0x7FFFFFFF > 0x7F800000
        return (x >> 16).to_wrap[U16]() | 0x0040
    return B32.from_bits(x).to_unchecked[BF16]().bits()

### The BF16 nearest a B64 in one rounding (ties to even, an infinity past the range), for B64.to_unchecked[BF16].
### A NaN keeps its sign and its top payload bits, with the quiet bit set.
### :param x: The B64's bits.
### :returns: The BF16's bits.
@export("ingrid_b64_to_bf16")
routine b64_to_bf16(x: U64) -> U16
    if x & 0x7FFFFFFFFFFFFFFF > 0x7FF0000000000000
        sign: U16 = (x >> 48).to_wrap[U16]() & 0x8000
        payload: U16 = ((x & 0x000FFFFFFFFFFFFF) >> 45).to_wrap[U16]()
        return sign | 0x7FC0 | payload
    return B64.from_bits(x).to_unchecked[BF16]().bits()
