// The cycle collector for Roamed entities, shared by the RazorForge and Suflae standard libraries: a Bacon-Rajan
// synchronous recycler (trial deletion). Reference counting alone leaks a cycle, since the cycle keeps its own counts
// above zero. Every strong release that leaves a count above zero reports the entity here as a possible cycle root
// (roam.tess), and a collection pass finds which of those are reachable only from each other and frees them.
//
// A pass stops the world: mutators change counts under the world lock held shared, a pass holds it exclusive. The
// thread running a pass releases objects itself (a freed entity drops its other handles), and those releases must not
// take the lock it already holds, so the collector thread is marked.

import Standard/Alloc
import Standard/Collections
import Standard/Os

/// Possible cycle roots, reported by strong releases.
global ROOTS: @HeaderBuffer
/// The children of the entity being traced, filled by its type's trace routine.
global SCRATCH: @HeaderBuffer

/// The garbage a pass found, freed once the walk is over (freeing during it would leave dangling addresses).
global REAP: @HeaderBuffer

/// Guards ROOTS, which two mutators holding the world lock shared can append to at once.
global ROOTS_LOCK: @Mutex
/// The world lock's pass side: the WRITER bit while a pass runs. Mutators only read it, so it stays in every core's
/// cache. Which mutators are inside is kept per thread, in SLOTS.
global WORLD: @U32
/// Every thread's slot, a list that only grows (a thread's slot stays after the thread ends). A pass waits on each.
global SLOTS: @Addr
/// This thread's slot, null until its first share or release.
#threadlocal
global MY_SLOT: @Addr
/// Whether this thread is running a pass (and so already holds the world lock exclusive).
#threadlocal
global IN_COLLECTOR: @Bool

preset WRITER: U32 = 0x80000000
/// Set in a thread's slot by a pass waiting for that thread to leave, so only then does leaving make the wake call.
preset WAITING: U32 = 0x40000000
preset LIVE: S32 = 0
preset SCANNING: S32 = 1
preset GARBAGE: S32 = 2
preset SUSPECTED: S32 = 3

/// One thread's part of the world lock: how deep the thread is inside (a share or release can run another one inside
/// it, through a destroy routine), with the WAITING bit while a pass waits for it. Only its own thread changes the
/// depth, so the cache line is not shared with other mutators.
record WorldSlot
    inside: U32
    next: Addr

/// A growable list of header addresses: the possible roots, one trace's children, or the garbage to free.
record HeaderBuffer
    items: @Addr
    count: U64
    capacity: U64

// ── The world lock ─────────────────────────────────────────────────────────

/// This thread's slot, made and added to SLOTS the first time.
/// :returns: The slot.
/// :throws: Crashes with `MemoryAllocationError` when the slot can't be allocated.
routine my_slot() -> @WorldSlot
    block entry()
        mine: Addr = MY_SLOT.load()
        branch mine.to[@Byte]().is_null()
            ? make()
            : return(mine.to[@WorldSlot]())

    block make()
        claim alloc: @Allocator <- make_c_heap_allocator()
        slot: @WorldSlot = allocate[WorldSlot](1, alloc)
        slot.store(WorldSlot(inside: 0, next: null))
        MY_SLOT.store(slot)
        jump link(slot)

    block link(slot: @WorldSlot)
        head: Addr = SLOTS.atomic_load()
        slot.next.store(head)
        added: Result[Addr, Addr] = SLOTS.atomic_compare_exchange(head, slot)
        when added
            .Success => return(slot)
            .Failure => link(slot)

/// Enters the world as a mutator: one step deeper in this thread's slot. Many mutators may be inside at once, each in
/// its own slot. A pass sets WRITER first and then waits on every slot, and a mutator raises its slot first and then
/// reads WRITER, so one of them always sees the other (both are sequentially consistent).
routine world_enter() -> Void
    block entry()
        branch IN_COLLECTOR.load()
            ? return()
            : continue
        slot: @WorldSlot = my_slot()
        jump attempt(slot)

    block attempt(slot: @WorldSlot)
        previous: U32 = slot.inside.atomic_fetch_add(1)
        nested: Bool = previous.bitand(WAITING.bitnot()).ne(0)
        branch nested
            ? return()
            : check(slot)

    block check(slot: @WorldSlot)
        state: U32 = WORLD.atomic_load()
        branch state.bitand(WRITER).eq(0)
            ? return()
            : back_off(slot, state)

    // A pass is running: step back out (waking it if it waits for this thread) and wait for it to finish.
    block back_off(slot: @WorldSlot, state: U32)
        step_out(slot)
        wait_on(WORLD, state)
        jump attempt(slot)

/// Leaves the world as a mutator: one step shallower in this thread's slot.
routine world_leave() -> Void
    block entry()
        branch IN_COLLECTOR.load()
            ? return()
            : continue
        step_out(MY_SLOT.load().to[@WorldSlot]())
        return()

/// One step out of `slot`. Leaving the last step wakes a pass that waits for this thread. With no pass waiting it
/// wakes nobody, so sharing and releasing an entity make no system call.
/// :param slot: This thread's slot.
routine step_out(slot: @WorldSlot) -> Void
    block entry()
        previous: U32 = slot.inside.atomic_fetch_sub(1)
        branch previous.eq(WAITING.bitor(1))
            ? wake()
            : return()

    block wake()
        before: U32 = slot.inside.atomic_fetch_and(WAITING.bitnot())
        wake_all(slot.inside)
        return()

/// Stops the world for a pass: takes WRITER (waiting for another pass to finish first), then waits until every
/// thread's slot is empty. A slot with someone inside gets WAITING, so leaving wakes the pass.
routine world_stop() -> Void
    block entry()
        jump attempt()

    block attempt()
        state: U32 = WORLD.atomic_load()
        branch state.bitand(WRITER).eq(0)
            ? take(state)
            : behind(state)

    block take(state: U32)
        taken: Result[U32, U32] = WORLD.atomic_compare_exchange(state, WRITER)
        when taken
            .Success => marked()
            .Failure => attempt()

    // Another pass runs. Its restart wakes everyone waiting on WORLD.
    block behind(state: U32)
        wait_on(WORLD, state)
        jump attempt()

    block marked()
        true.store_into(IN_COLLECTOR)
        jump each_slot(SLOTS.atomic_load())

    block each_slot(at: Addr)
        branch at.to[@Byte]().is_null()
            ? return()
            : drain(at.to[@WorldSlot]())

    block drain(slot: @WorldSlot)
        inside: U32 = slot.inside.atomic_load()
        branch inside.bitand(WAITING.bitnot()).eq(0)
            ? next(slot)
            : announce(slot, inside)

    block announce(slot: @WorldSlot, inside: U32)
        waiting: U32 = inside.bitor(WAITING)
        set: Result[U32, U32] = slot.inside.atomic_compare_exchange(inside, waiting)
        when set
            .Success => sleep(slot, waiting)
            .Failure => drain(slot)

    block sleep(slot: @WorldSlot, waiting: U32)
        wait_on(slot.inside, waiting)
        jump drain(slot)

    block next(slot: @WorldSlot)
        jump each_slot(slot.next.load())

/// Restarts the world after a pass and wakes every mutator and pass waiting for it.
routine world_restart() -> Void
    block entry()
        false.store_into(IN_COLLECTOR)
        WORLD.atomic_store(0)
        wake_all(WORLD)
        return()

// ── Buffers ────────────────────────────────────────────────────────────────

/// Appends `item` to `buffer`, growing it (to 16 items, then twice its capacity) from the C heap when it is full.
/// :param buffer: The buffer to append to.
/// :param item: The header address to append.
/// :throws: Crashes with `MemoryAllocationError` when growing the buffer fails.
routine buffer_push(buffer: @HeaderBuffer, item: Addr) -> Void
    local count: U64 = buffer.count.load()
    local capacity: U64 = buffer.capacity.load()

    block entry()
        full: Bool = count.eq(capacity)
        branch full
            ? grow()
            : put()

    block grow()
        larger: U64 = capacity.eq(0)
            ? 16
            : capacity.mul(2)
        claim alloc: @Allocator <- make_c_heap_allocator()
        grown: @Addr = reallocate[Addr](buffer.items.load(), larger.to[USize](), alloc)
        branch grown.is_null()
            ? crash_allocation()
            : continue
        grown.store_into(buffer.items)
        larger.store_into(buffer.capacity)
        jump put()

    block put()
        slot: @Addr = buffer.items.load().stride(count.to[USize]())
        slot.store(item)
        count.add(1).store_into(buffer.count)
        return()

/// Empties `buffer`, keeping its memory for the next items.
/// :param buffer: The buffer to empty.
routine buffer_clear(buffer: @HeaderBuffer) -> Void
    block entry()
        0.store_into(buffer.count)
        return()

/// The header at index `i` of `buffer`, unchecked.
/// :param buffer: The buffer to read.
/// :param i: The index, below the buffer's count.
/// :returns: The header stored there.
routine buffer_at(buffer: @HeaderBuffer, i: U64) -> @RoamHeader
    block entry()
        slot: @Addr = buffer.items.load().stride(i.to[USize]())
        item: Addr = slot.load()
        return(item.to[@RoamHeader]())

/// Reports a possible cycle root. Mutators can report at once, so the append takes the roots lock (a pass reports
/// only from its own thread, with no mutator running).
/// :param header: The entity's header.
/// :throws: Crashes with `MemoryAllocationError` when growing the roots buffer fails.
routine add_candidate(header: @RoamHeader) -> Void
    block entry()
        branch IN_COLLECTOR.load()
            ? push()
            : locked()

    block locked()
        ROOTS_LOCK.lock()
        buffer_push(ROOTS, header)
        ROOTS_LOCK.unlock()
        return()

    block push()
        buffer_push(ROOTS, header)
        return()

/// Drops one root that is about to be freed by its last strong release, so no pass reaches the freed header. Swaps
/// the last root into its place (the order of roots doesn't matter).
/// :param header: The header about to be freed.
routine remove_candidate(header: @RoamHeader) -> Void
    block entry()
        branch IN_COLLECTOR.load()
            ? search(false)
            : locked()

    block locked()
        ROOTS_LOCK.lock()
        jump search(true)

    block search(unlock: Bool)
        buffer_remove(ROOTS, header)
        jump done(unlock)

    block done(unlock: Bool)
        branch unlock
            ? release()
            : return()

    block release()
        ROOTS_LOCK.unlock()
        return()

/// Removes `header` from `buffer` if it is there, moving the last item into its place.
/// :param buffer: The buffer to remove from.
/// :param header: The header to remove.
routine buffer_remove(buffer: @HeaderBuffer, header: @RoamHeader) -> Void
    block entry()
        jump scan(0, buffer.count.load())

    block scan(i: U64, n: U64)
        branch i.ge(n)
            ? return()
            : continue
        found: Bool = buffer_at(buffer, i).ptr_eq(header)
        branch found
            ? remove(i, n)
            : scan(i.add(1), n)

    block remove(i: U64, n: U64)
        last: U64 = n.sub(1)
        last_slot: @Addr = buffer.items.load().stride(last.to[USize]())
        moved: Addr = last_slot.load()
        hole: @Addr = buffer.items.load().stride(i.to[USize]())
        hole.store(moved)
        last.store_into(buffer.count)
        return()

/// Called by a type's trace routine for each of the entity's Roamed fields: records that field's header as a child.
/// :param child: The field's header.
/// :throws: Crashes with `MemoryAllocationError` when growing the children buffer fails.
#[export("ingrid_cyclic_visit_child")]
routine visit_child(child: Addr) -> Void
    block entry()
        buffer_push(SCRATCH, child)
        return()

/// Puts the children of `node` (the headers its Roamed fields hold) into `kids`, replacing what was there. A type
/// with no trace routine has no Roamed fields and so no children.
/// :param node: The entity whose children to list.
/// :param kids: The list that receives the children's headers.
/// :throws: Crashes with `MemoryAllocationError` when an allocation fails.
routine children(node: @RoamHeader, kids: @List[Addr]) -> Void
    block entry()
        kids.clear()
        trace: Addr = node.trace_hook.load()
        branch trace.to[@Byte]().is_null()
            ? return()
            : continue
        buffer_clear(SCRATCH)
        run_hook(trace, node.data.load())
        jump copy(0, SCRATCH.count.load())

    block copy(i: U64, n: U64)
        branch i.ge(n)
            ? return()
            : continue
        kids.add_last(buffer_at(SCRATCH, i))
        jump copy(i.add(1), n)

// ── The three passes ───────────────────────────────────────────────────────

/// Paints `root` and everything it reaches SCANNING, subtracting each internal edge from its target's count. What
/// is left of a count afterwards is the references from outside the scanned graph.
/// :param root: The possible cycle root to start from.
/// :param alloc: The allocator for the walk's work lists.
/// :throws: Crashes with `MemoryAllocationError` when an allocation fails.
routine mark_scanning(root: @RoamHeader, alloc: @Allocator) -> Void
    local work: @List[Addr] <- .construct(alloc)
    local kids: @List[Addr] <- .construct(alloc)

    block entry()
        branch root.state.load().eq(SCANNING)
            ? finish()
            : continue
        SCANNING.store_into(root.state)
        work.add_last(root)
        jump next()

    block next()
        branch work.is_empty()
            ? finish()
            : continue
        node: @RoamHeader = work.remove_last().to[@RoamHeader]()
        children(node, kids)
        jump edges(0, kids.count())

    block edges(i: USize, n: USize)
        branch i.ge(n)
            ? next()
            : continue
        kid_address: Addr = kids.getitem(i)
        kid: @RoamHeader = kid_address.to[@RoamHeader]()
        kid_count: U64 = kid.count.load().sub(1)
        kid_count.store_into(kid.count)
        branch kid.state.load().eq(SCANNING)
            ? edges(i.add(1), n)
            : continue
        SCANNING.store_into(kid.state)
        work.add_last(kid)
        jump edges(i.add(1), n)

    block finish()
        work.destruct()
        kids.destruct()
        return()

/// Decides each SCANNING node: one with references from outside is live, with everything it reaches. One without
/// is garbage for now, and its children are decided the same way.
/// :param root: The root whose graph to decide.
/// :param alloc: The allocator for the walk's work lists.
/// :throws: Crashes with `MemoryAllocationError` when an allocation fails.
routine scan(root: @RoamHeader, alloc: @Allocator) -> Void
    local work: @List[Addr] <- .construct(alloc)
    local kids: @List[Addr] <- .construct(alloc)

    block entry()
        work.add_last(root)
        jump next()

    block next()
        branch work.is_empty()
            ? finish()
            : continue
        node: @RoamHeader = work.remove_last().to[@RoamHeader]()
        branch node.state.load().eq(SCANNING)
            ? continue
            : next()
        branch node.count.load().gt(0)
            ? live(node)
            : continue
        GARBAGE.store_into(node.state)
        children(node, kids)
        jump push(0, kids.count())

    block live(node: @RoamHeader)
        scan_live(node, alloc)
        jump next()

    block push(i: USize, n: USize)
        branch i.ge(n)
            ? next()
            : continue
        work.add_last(kids.getitem(i))
        jump push(i.add(1), n)

    block finish()
        work.destruct()
        kids.destruct()
        return()

/// Undoes the scan below a node that turned out live: paints its graph LIVE again and gives back each edge's count.
/// :param root: The node found live.
/// :param alloc: The allocator for the walk's work lists.
/// :throws: Crashes with `MemoryAllocationError` when an allocation fails.
routine scan_live(root: @RoamHeader, alloc: @Allocator) -> Void
    local work: @List[Addr] <- .construct(alloc)
    local kids: @List[Addr] <- .construct(alloc)

    block entry()
        LIVE.store_into(root.state)
        work.add_last(root)
        jump next()

    block next()
        branch work.is_empty()
            ? finish()
            : continue
        node: @RoamHeader = work.remove_last().to[@RoamHeader]()
        children(node, kids)
        jump edges(0, kids.count())

    block edges(i: USize, n: USize)
        branch i.ge(n)
            ? next()
            : continue
        kid_address: Addr = kids.getitem(i)
        kid: @RoamHeader = kid_address.to[@RoamHeader]()
        kid_count: U64 = kid.count.load().add(1)
        kid_count.store_into(kid.count)
        branch kid.state.load().eq(LIVE)
            ? edges(i.add(1), n)
            : continue
        LIVE.store_into(kid.state)
        work.add_last(kid)
        jump edges(i.add(1), n)

    block finish()
        work.destruct()
        kids.destruct()
        return()

/// Gathers the garbage reachable from `root` into REAP, painting it LIVE so no node is gathered twice. A node still
/// in the roots buffer is left for a later pass.
/// :param root: The root whose garbage to gather.
/// :param alloc: The allocator for the walk's work lists.
/// :throws: Crashes with `MemoryAllocationError` when an allocation fails.
routine collect_garbage(root: @RoamHeader, alloc: @Allocator) -> Void
    local work: @List[Addr] <- .construct(alloc)
    local kids: @List[Addr] <- .construct(alloc)

    block entry()
        work.add_last(root)
        jump next()

    block next()
        branch work.is_empty()
            ? finish()
            : continue
        node: @RoamHeader = work.remove_last().to[@RoamHeader]()
        garbage: Bool = node.state.load().eq(GARBAGE)
        buffered: Bool = node.buffered.load()
        branch garbage.bitand(buffered.bitnot())
            ? continue
            : next()
        LIVE.store_into(node.state)
        buffer_push(REAP, node)
        children(node, kids)
        jump push(0, kids.count())

    block push(i: USize, n: USize)
        branch i.ge(n)
            ? next()
            : continue
        work.add_last(kids.getitem(i))
        jump push(i.add(1), n)

    block finish()
        work.destruct()
        kids.destruct()
        return()

/// Runs one pass over the possible roots and frees the cyclic garbage it finds, with the world stopped.
/// :returns: How many entities it freed.
/// :throws: Crashes with `MemoryAllocationError` when an allocation fails.
#[export("ingrid_cyclic_collect")]
routine collect() -> U64
    local alloc: @Allocator <- .hollow()
    local roots: @List[Addr] <- .hollow()

    block entry()
        world_stop()
        alloc.store(make_c_heap_allocator())
        roots.store(.construct(alloc))
        jump mark(0, ROOTS.count.load())

    // MarkRoots: a root still SUSPECTED seeds the scan. Any other root is stale and only leaves the buffer.
    block mark(i: U64, n: U64)
        branch i.ge(n)
            ? marked(n)
            : continue
        node: @RoamHeader = buffer_at(ROOTS, i)
        branch node.state.load().eq(SUSPECTED)
            ? seed(i, n, node)
            : continue
        false.store_into(node.buffered)
        jump mark(i.add(1), n)

    block seed(i: U64, n: U64, node: @RoamHeader)
        mark_scanning(node, alloc)
        roots.add_last(node)
        jump mark(i.add(1), n)

    // Exactly the n roots this pass took leave the buffer: a root reported while freeing must stay for a later pass.
    block marked(n: U64)
        remove_front(ROOTS, n)
        jump scanning(0, roots.count())

    block scanning(i: USize, n: USize)
        branch i.ge(n)
            ? gather()
            : continue
        root_address: Addr = roots.getitem(i)
        scan(root_address.to[@RoamHeader](), alloc)
        jump scanning(i.add(1), n)

    block gather()
        buffer_clear(REAP)
        jump gathering(0, roots.count())

    block gathering(i: USize, n: USize)
        branch i.ge(n)
            ? reap(0, REAP.count.load())
            : continue
        root_address: Addr = roots.getitem(i)
        root: @RoamHeader = root_address.to[@RoamHeader]()
        false.store_into(root.buffered)
        collect_garbage(root, alloc)
        jump gathering(i.add(1), n)

    // Frees the garbage: each entity's type tears it down, then its header goes unless a weak observer remains.
    block reap(j: U64, m: U64)
        branch j.ge(m)
            ? done(m)
            : continue
        node: @RoamHeader = buffer_at(REAP, j)
        run_hook(node.free_hook.load(), node.data.load())
        roam_cyclic_finalize(node)
        jump reap(j.add(1), m)

    block done(freed: U64)
        buffer_clear(REAP)
        roots.destruct()
        world_restart()
        return(freed)

/// Removes the first n items of `buffer`, keeping any added after them.
/// :param buffer: The buffer to shorten.
/// :param n: How many items to remove from the front (all of them when `n` is at least the count).
routine remove_front(buffer: @HeaderBuffer, n: U64) -> Void
    block entry()
        count: U64 = buffer.count.load()
        branch n.ge(count)
            ? clear()
            : shift(0, count.sub(n))

    block clear()
        buffer_clear(buffer)
        return()

    block shift(k: U64, remaining: U64)
        branch k.ge(remaining)
            ? shifted(remaining)
            : continue
        from_slot: @Addr = buffer.items.load().stride(n.add(k).to[USize]())
        moved: Addr = from_slot.load()
        to_slot: @Addr = buffer.items.load().stride(k.to[USize]())
        to_slot.store(moved)
        jump shift(k.add(1), remaining)

    block shifted(remaining: U64)
        remaining.store_into(buffer.count)
        return()
