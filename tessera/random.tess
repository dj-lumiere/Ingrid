// Random-number building blocks shared by the RazorForge and Suflae standard libraries.

/// One round of the splitmix64 mixer: expands a seed into well-spread state words (xoshiro256** seeding).
#[export("ingrid_splitmix64"), inline]
routine splitmix64(x: U64) -> U64
    block entry():
        z : U64 = x.add_wrap(0x9E3779B97F4A7C15)
        a : U64 = z.bitxor(z.shr(30)).mul_wrap(0xBF58476D1CE4E5B9)
        b : U64 = a.bitxor(a.shr(27)).mul_wrap(0x94D049BB133111EB)
        return(b.bitxor(b.shr(31)))
