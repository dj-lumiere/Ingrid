# Where the program is when it takes an access, for the AccessManager's crash reports (Ingrid/runtime-tessera/
# access.te, in the runtime library). The program's main hands this routine to rf_access_configure, and the
# AccessManager calls it each time an access is taken while one of its checks is on: the most recent frame of the
# crash trace is the program's routine that opens the access, at the line of the block or the call.

### Writes where the running program is: the routine, the line and the column of the most recent frame of the crash
### trace. Writes nothing in a build that keeps no trace.
### :param out: Where to write the place.
@export("ingrid_access_place")
routine access_place(out: @SourceLocation) -> None
    frame: &RingFrame <- RingFrame(routine_name: Addr.zero(), file: Addr.zero(), line: 0, column: 0)

    if innermost_frame(frame) == 0
        return
    file_ptr: @CChar = frame.file.peek().to[@CChar]()
    file: @[Byte] = file_ptr.to[CStrView]().getview()
    line: U32 = frame.line.peek().to_clamp[U32]()
    column: U32 = frame.column.peek().to_clamp[U32]()
    out.poke(SourceLocation(file, line, column))
    return

### The innermost frame of the calling flow's crash trace, from the program's trace helpers.
### :param out: Where the frame goes.
### :returns: 1 when there is one, 0 for a build that keeps no trace or an empty trace.
@external("c")
@symbol("_rf_trace_get_innermost_shared")
secret routine innermost_frame(out: @RingFrame) -> S32
