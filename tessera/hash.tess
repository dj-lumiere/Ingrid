// Keyed hashing shared by the RazorForge and Suflae standard libraries: SipHash-2-4, which hash tables use so that
// keys an attacker picks can't be steered into one bucket. The algorithm is Tessera's (Standard/SipHash.tess, the
// same one behind Tessera's own `hash()`): these are its C entry points, under the key the caller passes.

/// SipHash-2-4 of one 64-bit value under the key (k0, k1), as the 8 bytes it is in memory (little-endian): the
/// value is one full block, so the length (8) goes in the top byte of a block of its own, as the algorithm says.
#[export("ingrid_siphash24_u64"), inline]
routine siphash24_u64(value: U64, k0: U64, k1: U64) -> U64
    block entry()
        key : SipKey = { k0: k0, k1: k1 }
        return(siphash24(value, key))

/// SipHash-2-4 of a 128-bit value under the key (k0, k1), given as its low and high 64-bit words: the 16 bytes
/// it is in memory, two full blocks, then the length (16) in the top byte of a block of its own.
#[export("ingrid_siphash24_u128"), inline]
routine siphash24_u128(low: U64, high: U64, k0: U64, k1: U64) -> U64
    block entry()
        key : SipKey = { k0: k0, k1: k1 }
        return(siphash24(low, high, key))
