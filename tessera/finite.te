# RazorForge's checked float arithmetic, for the Ingrid routines that compute RazorForge's complex numbers,
# quaternions, and matrices. RazorForge's `+ - * /` on B32, B64, and B128 crash when the IEEE result is not finite:
# NaN is a NumericDomainError, an infinity a NumericOverflowError, and a nonzero value over zero a
# DivisionByZeroError. These routines do the same with the same names and messages, so a body moved here crashes
# at the same operation, and the same way, as it did in RazorForge. Each passes its caller's place on, so the report
# names the line of the formula.

### Crashes for an arithmetic result that is not finite: NaN has no real result, an infinity is out of range.
### :param nan: True when the result is NaN, false when it is an infinity.
### :throws: Crashes with `NumericDomainError` when `nan` is true, else with `NumericOverflowError`.
@noreturn
@track_caller
routine crash_not_finite(nan: Bool) -> None
    if nan
        crash(name: "NumericDomainError", message: "domain error: no real result")
    crash(name: "NumericOverflowError", message: "overflow: out of range")

### Crashes for a quotient that is not finite: a nonzero value over zero divides by zero, otherwise like any result.
### :param by_zero: True when a nonzero value was divided by zero.
### :param nan: True when the quotient is NaN, false when it is an infinity.
### :throws: Crashes with `DivisionByZeroError` when `by_zero` is true, else with `NumericDomainError` when `nan` is
###     true, else with `NumericOverflowError`.
@noreturn
@track_caller
routine crash_quotient_not_finite(by_zero: Bool, nan: Bool) -> None
    if by_zero
        crash_division_by_zero()
    crash_not_finite(nan)

### Crashes for a division by a zero divisor (0 + 0i, the zero quaternion) the way real division does: 0 / 0 has no
### result, and a nonzero value over zero divides by zero.
### :param zero_dividend: True when the dividend is zero too.
### :throws: Crashes with `NumericDomainError` when `zero_dividend` is true, else with `DivisionByZeroError`.
@noreturn
@track_caller
routine crash_zero_divisor(zero_dividend: Bool) -> None
    if zero_dividend
        crash_not_finite(true)
    crash_division_by_zero()

### `me + other`, crashing unless the sum is finite.
### :param other: The value to add.
### :returns: The sum.
### :throws: Crashes with `NumericDomainError` when the sum is NaN, or `NumericOverflowError` when it is
###     infinite.
@inline
@track_caller
routine B32.add_finite(other: Me) -> Me
    local r: Me = me + other

    if r.is_finite()
        return r
    crash_not_finite(r.is_nan())

### `me - other`, crashing unless the difference is finite.
### :param other: The value to subtract.
### :returns: The difference.
### :throws: Crashes with `NumericDomainError` when the difference is NaN, or `NumericOverflowError` when it is
###     infinite.
@inline
@track_caller
routine B32.sub_finite(other: Me) -> Me
    local r: Me = me - other

    if r.is_finite()
        return r
    crash_not_finite(r.is_nan())

### `me * other`, crashing unless the product is finite.
### :param other: The value to multiply by.
### :returns: The product.
### :throws: Crashes with `NumericDomainError` when the product is NaN, or `NumericOverflowError` when it is
###     infinite.
@inline
@track_caller
routine B32.mul_finite(other: Me) -> Me
    local r: Me = me * other

    if r.is_finite()
        return r
    crash_not_finite(r.is_nan())

### `me / other`, crashing unless the quotient is finite.
### :param other: The value to divide by.
### :returns: The quotient.
### :throws: Crashes with `DivisionByZeroError` when `other` is zero and `me` is not, else with
###     `NumericDomainError` when the quotient is NaN, or `NumericOverflowError` when it is infinite.
@inline
@track_caller
routine B32.truediv_finite(other: Me) -> Me
    local r: Me = me / other

    if r.is_finite()
        return r
    by_zero: Bool = other == 0.0 and me != 0.0
    crash_quotient_not_finite(by_zero, nan: r.is_nan())

### `me + other`, crashing unless the sum is finite.
### :param other: The value to add.
### :returns: The sum.
### :throws: Crashes with `NumericDomainError` when the sum is NaN, or `NumericOverflowError` when it is
###     infinite.
@inline
@track_caller
routine B64.add_finite(other: Me) -> Me
    local r: Me = me + other

    if r.is_finite()
        return r
    crash_not_finite(r.is_nan())

### `me - other`, crashing unless the difference is finite.
### :param other: The value to subtract.
### :returns: The difference.
### :throws: Crashes with `NumericDomainError` when the difference is NaN, or `NumericOverflowError` when it is
###     infinite.
@inline
@track_caller
routine B64.sub_finite(other: Me) -> Me
    local r: Me = me - other

    if r.is_finite()
        return r
    crash_not_finite(r.is_nan())

### `me * other`, crashing unless the product is finite.
### :param other: The value to multiply by.
### :returns: The product.
### :throws: Crashes with `NumericDomainError` when the product is NaN, or `NumericOverflowError` when it is
###     infinite.
@inline
@track_caller
routine B64.mul_finite(other: Me) -> Me
    local r: Me = me * other

    if r.is_finite()
        return r
    crash_not_finite(r.is_nan())

### `me / other`, crashing unless the quotient is finite.
### :param other: The value to divide by.
### :returns: The quotient.
### :throws: Crashes with `DivisionByZeroError` when `other` is zero and `me` is not, else with
###     `NumericDomainError` when the quotient is NaN, or `NumericOverflowError` when it is infinite.
@inline
@track_caller
routine B64.truediv_finite(other: Me) -> Me
    local r: Me = me / other

    if r.is_finite()
        return r
    by_zero: Bool = other == 0.0 and me != 0.0
    crash_quotient_not_finite(by_zero, nan: r.is_nan())

### `me + other`, crashing unless the sum is finite.
### :param other: The value to add.
### :returns: The sum.
### :throws: Crashes with `NumericDomainError` when the sum is NaN, or `NumericOverflowError` when it is
###     infinite.
@inline
@track_caller
routine B128.add_finite(other: Me) -> Me
    local r: Me = me + other

    if r.is_finite()
        return r
    crash_not_finite(r.is_nan())

### `me - other`, crashing unless the difference is finite.
### :param other: The value to subtract.
### :returns: The difference.
### :throws: Crashes with `NumericDomainError` when the difference is NaN, or `NumericOverflowError` when it is
###     infinite.
@inline
@track_caller
routine B128.sub_finite(other: Me) -> Me
    local r: Me = me - other

    if r.is_finite()
        return r
    crash_not_finite(r.is_nan())

### `me * other`, crashing unless the product is finite.
### :param other: The value to multiply by.
### :returns: The product.
### :throws: Crashes with `NumericDomainError` when the product is NaN, or `NumericOverflowError` when it is
###     infinite.
@inline
@track_caller
routine B128.mul_finite(other: Me) -> Me
    local r: Me = me * other

    if r.is_finite()
        return r
    crash_not_finite(r.is_nan())

### `me / other`, crashing unless the quotient is finite.
### :param other: The value to divide by.
### :returns: The quotient.
### :throws: Crashes with `DivisionByZeroError` when `other` is zero and `me` is not, else with
###     `NumericDomainError` when the quotient is NaN, or `NumericOverflowError` when it is infinite.
@inline
@track_caller
routine B128.truediv_finite(other: Me) -> Me
    local r: Me = me / other

    if r.is_finite()
        return r
    by_zero: Bool = other.is_zero() and not me.is_zero()
    crash_quotient_not_finite(by_zero, nan: r.is_nan())

### Whether this is +0 or -0.
### :returns: True when `me` is +0 or -0.
@inline
routine B128.is_zero() -> Bool
    magnitude: U128 = me.abs().bits()
    return magnitude == 0
