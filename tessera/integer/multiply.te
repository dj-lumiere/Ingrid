# Multiplying two limb numbers: the schoolbook method for short factors and the number theoretic transform
# (ntt.te) once the smaller factor has FFT_MUL_THRESHOLD limbs, as in LibBF's mp_mul.

module Ingrid/Integer

### The limbs of the smaller factor from which a product runs the transform instead of the schoolbook method.
secret preset FFT_MUL_THRESHOLD: U64 = 100

### result[0 .. a.count + b.count) = a × b by the schoolbook method (LibBF mp_mul_basecase).
### :param result: The product, which must not overlap the factors.
### :param a: The first factor.
### :param b: The second factor.
secret routine limbs_mul_schoolbook(result: @U64, a: @[U64], b: @[U64]) -> None
    a_tab: @U64 = a.to[@U64]()
    b_tab: @U64 = b.to[@U64]()
    a_len: U64 = a.count()
    set_limb(tab: result, i: a_len,
        value: limbs_mul_word(tabr: result, taba: a_tab, n: a_len, b: limb(tab: b_tab, i: 0)))
    for i in 1 til b.count()
        carry: U64 = limbs_addmul_word(tabr: result.stride(i), taba: a_tab, n: a_len,
            b: limb(tab: b_tab, i))
        set_limb(tab: result, i: i + a_len, value: carry)
    return

### result[0 .. a.count + b.count) = a × b by the transform (LibBF fft_mul, without its bookkeeping for reduced memory
### and overlap).
### :param result: The product, which must not overlap the factors.
### :param a: The first factor.
### :param b: The second factor.
### :param scratch: The call's arena.
secret routine limbs_mul_ntt(result: @U64, a: @[U64], b: @[U64], scratch: @Arena) -> None
    len: U64 = a.count() + b.count()
    plan: NttPlan = fft_size(len)
    fft_len: U64 = plan.fft_len()
    buf1: @U64 = alloc_limbs(n: fft_len * plan.nb_mods, scratch)
    limb_to_ntt(tabr: buf1, a, plan)
    buf2: @U64 = alloc_limbs(n: fft_len * plan.nb_mods, scratch)
    limb_to_ntt(tabr: buf2, a: b, plan)
    for j in 0 til plan.nb_mods
        job: NttJob = (log2: plan.fft_len_log2, inverse: 0, m_idx: plan.first_m_idx() + j)
        ntt_conv(bufs: (first: buf1.stride(fft_len * j), second: buf2.stride(fft_len * j)), job,
            k_tot: plan.fft_len_log2, scratch)
    ntt_to_limb(tabr: limbs_span(tab: result, n: len), buf: buf1, plan, scratch)
    return

### result[0 .. a.count + b.count) = a × b, by the schoolbook method below FFT_MUL_THRESHOLD limbs of the smaller factor
### and by the transform from there (LibBF mp_mul).
### :param result: The product, which must not overlap the factors.
### :param a: The first factor.
### :param b: The second factor.
### :param scratch: The call's arena.
secret routine limbs_mul(result: @U64, a: @[U64], b: @[U64], scratch: @Arena) -> None
    if a.count().min(b.count()) >= FFT_MUL_THRESHOLD
        limbs_mul_ntt(result, a, b, scratch)
        return
    limbs_mul_schoolbook(result, a, b)
    return

### The most limbs `limbs_mul` takes for an a_len × b_len product: the transform's buffers, 0 for the schoolbook method.
### :param a_len: The first factor's limbs.
### :param b_len: The second factor's limbs.
### :returns: The limbs.
secret routine limbs_mul_scratch(a_len: U64, b_len: U64) -> U64
    if a_len.min(b_len) < FFT_MUL_THRESHOLD
        return 0
    plan: NttPlan = fft_size(a_len + b_len)
    # buf1 and buf2, each convolution, and ntt_to_limb's three 5-limb vectors
    return 2 * plan.fft_len() * plan.nb_mods + plan.nb_mods * ntt_conv_scratch(k: plan.fft_len_log2) + 15
