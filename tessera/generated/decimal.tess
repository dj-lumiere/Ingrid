        t2 : U64  = ptrtoint<@U8, U64>(t1)
        return(t2)

private routine `[member] Core.Hijacked[Core.U64].assign()`(arg_me: @U64) -> @U64
    shared me_0 : @@U64 <- arg_me

    block entry()
        t0 : @U64 = me_0.load()
        return(t0)

private routine `[member] Core.Address.add(offset: Core.ByteSize)`(arg_me: U64,
    arg_offset: U64) -> U64
    shared me_0     : @U64 <- arg_me
    shared offset_1 : @U64 <- arg_offset

    block entry()
        t0 : U64 = me_0.load()
        t1 : U64 = offset_1.load()
        t2 : U64 = add<U64>(t0, t1)
        return(t2)
