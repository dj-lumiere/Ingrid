#export("ingrid_d32_add")
routine ingrid_d32_add(arg_a: U32, arg_b: U32) -> U32
    shared a_0 : @U32 <- arg_a
    shared b_1 : @U32 <- arg_b

    block entry()
        t0 : U32 = a_0.load()
        t1 : U32 = `[common member] Core.D32.from_bits(bits: Core.U32)`(t0)
        t2 : U32 = b_1.load()
        t3 : U32 = `[common member] Core.D32.from_bits(bits: Core.U32)`(t2)
        t4 : U32 = `[independent] Core.d32_add(a: Core.D32 b: Core.D32)`(t1, t3)
        t5 : U32 = `[member] Core.D32.to_bits()`(t4)
        return(t5)

#export("ingrid_d32_sub")
routine ingrid_d32_sub(arg_a: U32, arg_b: U32) -> U32
    shared a_0 : @U32 <- arg_a
    shared b_1 : @U32 <- arg_b

    block entry()
        t0 : U32 = a_0.load()
