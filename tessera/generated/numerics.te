### A crash message as UTF-8.
secret routine `text bytes`(text: `System.Text`, into: @List[Byte]) -> @[Byte]
    data: @U32 = text.data
    count: U64 = text.count

    for i in 0 til count
        code: U32 = data.stride(i).peek()
        character: Char = code.to[Char]()
        into.write("{character}")
    return into.getview()

