// JSON string escaping for the RazorForge and Suflae JSON encoders. The escaping is Tessera's (Standard/Json.tess):
// these are its C entry points for text held as code points, the way RazorForge's Text keeps it (one U32 per
// character). The encoder sizes its result with the count, allocates it, and has the second routine fill it.

import Standard::Json

/// How many code points text takes as a JSON string, quotes included.
/// :param chars: The text's first code point (anything when `count` is 0).
/// :param count: How many code points it has.
/// :returns: The JSON string's length in code points.
#export("ingrid_json_quoted_count_utf32")
routine json_quoted_count_utf32(chars: @U32, count: U64) -> U64
    block entry()
        text : Slice<U32> = .construct(chars, count.to<USize>())
        return(text.json_quoted_count().to<U64>())

/// Writes text as a JSON string, quotes included, one code point per element of `out`.
/// :param chars: The text's first code point (anything when `count` is 0).
/// :param count: How many code points it has.
/// :param out: Where the JSON string goes.
/// :param out_count: How many code points `out` has room for: at least what `ingrid_json_quoted_count_utf32` gives.
/// :returns: How many code points it wrote.
#export("ingrid_json_quote_utf32")
routine json_quote_utf32(chars: @U32, count: U64, out: @U32, out_count: U64) -> U64
    block entry()
        text   : Slice<U32> = .construct(chars, count.to<USize>())
        quoted : Slice<U32> = .construct(out, out_count.to<USize>())
        return(text.json_quote_into(quoted).to<U64>())
