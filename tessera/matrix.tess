// RazorForge's 4x4 matrix Matrix4R4C (B32, Tessera's B32, column-major): the bodies of its determinant, inverse, and
// rotation-from-quaternion, moved here from RazorForge's Math3D/Matrix4R4C.rf. RazorForge keeps the type, the SIMD
// column arithmetic (sum, product, transpose, and the rest are vector operations it lowers itself), and thin
// routines that call the ingrid_ exports below.
//
// The formulas are RazorForge's own, unchanged, so every result has the same bits as before, and each `+ - * /` is
// the checked one (finite.tess), which crashes where RazorForge's B32 operators do. The exports take the sixteen
// elements as m{row}{column}, and hand a matrix back as Matrix4: 64 bytes in RazorForge's column-major order, which
// every target returns through a hidden pointer, as it does RazorForge's Matrix4R4C.

/// A 4x4 B32 matrix laid out as RazorForge's Matrix4R4C: column after column, m{row}{column}.
record Matrix4
    m00: B32
    m10: B32
    m20: B32
    m30: B32
    m01: B32
    m11: B32
    m21: B32
    m31: B32
    m02: B32
    m12: B32
    m22: B32
    m32: B32
    m03: B32
    m13: B32
    m23: B32
    m33: B32

/// a × b - c × d.
/// :param a: The first factor of the first product.
/// :param b: The second factor of the first product.
/// :param c: The first factor of the subtracted product.
/// :param d: The second factor of the subtracted product.
/// :returns: The difference.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is
///     infinite.
#inline
routine cross_difference(a: B32, b: B32, c: B32, d: B32) -> B32
    ab: B32 = a.mul_finite(b)
    cd: B32 = c.mul_finite(d)
    return(ab.sub_finite(cd))

/// row.x × minors.x - row.y × minors.y + row.z × minors.z: three elements of a row, each times the 2x2 determinant
/// that goes with it.
/// :param row: The row's three elements.
/// :param minors: The three 2x2 determinants, in the same order.
/// :returns: The sum.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is
///     infinite.
#inline
routine cofactor(row: Vector3D[B32], minors: Vector3D[B32]) -> B32
    ap: B32 = row.x.mul_finite(minors.x)
    bq: B32 = row.y.mul_finite(minors.y)
    d: B32 = ap.sub_finite(bq)
    cr: B32 = row.z.mul_finite(minors.z)
    return(d.add_finite(cr))

/// -row.x × minors.x + row.y × minors.y - row.z × minors.z: the cofactor with the opposite sign.
/// :param row: The row's three elements.
/// :param minors: The three 2x2 determinants, in the same order.
/// :returns: The sum.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is
///     infinite.
#inline
routine negated_cofactor(row: Vector3D[B32], minors: Vector3D[B32]) -> B32
    ap: B32 = row.x.neg().mul_finite(minors.x)
    bq: B32 = row.y.mul_finite(minors.y)
    d: B32 = ap.add_finite(bq)
    cr: B32 = row.z.mul_finite(minors.z)
    return(d.sub_finite(cr))

/// The determinant, by cofactor expansion along the top row with the bottom two rows' 2x2 determinants.
/// :param m00: The element in row 0, column 0.
/// :param m01: The element in row 0, column 1.
/// :param m02: The element in row 0, column 2.
/// :param m03: The element in row 0, column 3.
/// :param m10: The element in row 1, column 0.
/// :param m11: The element in row 1, column 1.
/// :param m12: The element in row 1, column 2.
/// :param m13: The element in row 1, column 3.
/// :param m20: The element in row 2, column 0.
/// :param m21: The element in row 2, column 1.
/// :param m22: The element in row 2, column 2.
/// :param m23: The element in row 2, column 3.
/// :param m30: The element in row 3, column 0.
/// :param m31: The element in row 3, column 1.
/// :param m32: The element in row 3, column 2.
/// :param m33: The element in row 3, column 3.
/// :returns: The determinant.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is
///     infinite.
#[export("ingrid_m4_determinant"), inline]
routine m4_determinant(m00: B32, m01: B32, m02: B32, m03: B32, m10: B32, m11: B32, m12: B32,
    m13: B32, m20: B32, m21: B32, m22: B32, m23: B32, m30: B32, m31: B32, m32: B32, m33: B32) -> B32
    s0: B32 = cross_difference(a: m20, b: m31, c: m21, d: m30)
    s1: B32 = cross_difference(a: m20, b: m32, c: m22, d: m30)
    s2: B32 = cross_difference(a: m20, b: m33, c: m23, d: m30)
    s3: B32 = cross_difference(a: m21, b: m32, c: m22, d: m31)
    s4: B32 = cross_difference(a: m21, b: m33, c: m23, d: m31)
    s5: B32 = cross_difference(a: m22, b: m33, c: m23, d: m32)
    d0: B32 = m00.mul_finite(cofactor(row: Vector3D[B32](x: m11, y: m12, z: m13),
        minors: Vector3D[B32](x: s5, y: s4, z: s3)))
    d1: B32 = m01.mul_finite(cofactor(row: Vector3D[B32](x: m10, y: m12, z: m13),
        minors: Vector3D[B32](x: s5, y: s2, z: s1)))
    d2: B32 = m02.mul_finite(cofactor(row: Vector3D[B32](x: m10, y: m11, z: m13),
        minors: Vector3D[B32](x: s4, y: s2, z: s0)))
    d3: B32 = m03.mul_finite(cofactor(row: Vector3D[B32](x: m10, y: m11, z: m12),
        minors: Vector3D[B32](x: s3, y: s1, z: s0)))
    e: B32 = d0.sub_finite(d1).add_finite(d2)
    return(e.sub_finite(d3))

/// The inverse: the adjugate (the transposed cofactors, from the 2x2 determinants of rows 0-1 and rows 2-3) over the
/// determinant. A singular matrix (determinant 0) gives the zero matrix.
/// :param m00: The element in row 0, column 0.
/// :param m01: The element in row 0, column 1.
/// :param m02: The element in row 0, column 2.
/// :param m03: The element in row 0, column 3.
/// :param m10: The element in row 1, column 0.
/// :param m11: The element in row 1, column 1.
/// :param m12: The element in row 1, column 2.
/// :param m13: The element in row 1, column 3.
/// :param m20: The element in row 2, column 0.
/// :param m21: The element in row 2, column 1.
/// :param m22: The element in row 2, column 2.
/// :param m23: The element in row 2, column 3.
/// :param m30: The element in row 3, column 0.
/// :param m31: The element in row 3, column 1.
/// :param m32: The element in row 3, column 2.
/// :param m33: The element in row 3, column 3.
/// :returns: The inverse, or the zero matrix.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is
///     infinite.
#[export("ingrid_m4_inverse"), inline]
routine m4_inverse(m00: B32, m01: B32, m02: B32, m03: B32, m10: B32, m11: B32, m12: B32, m13: B32,
    m20: B32, m21: B32, m22: B32, m23: B32, m30: B32, m31: B32, m32: B32, m33: B32) -> Matrix4
    local a0: B32 = cross_difference(a: m00, b: m11, c: m01, d: m10)
    local a1: B32 = cross_difference(a: m00, b: m12, c: m02, d: m10)
    local a2: B32 = cross_difference(a: m00, b: m13, c: m03, d: m10)
    local a3: B32 = cross_difference(a: m01, b: m12, c: m02, d: m11)
    local a4: B32 = cross_difference(a: m01, b: m13, c: m03, d: m11)
    local a5: B32 = cross_difference(a: m02, b: m13, c: m03, d: m12)
    local b0: B32 = cross_difference(a: m20, b: m31, c: m21, d: m30)
    local b1: B32 = cross_difference(a: m20, b: m32, c: m22, d: m30)
    local b2: B32 = cross_difference(a: m20, b: m33, c: m23, d: m30)
    local b3: B32 = cross_difference(a: m21, b: m32, c: m22, d: m31)
    local b4: B32 = cross_difference(a: m21, b: m33, c: m23, d: m31)
    local b5: B32 = cross_difference(a: m22, b: m33, c: m23, d: m32)

    t0: B32 = cross_difference(a: a0, b: b5, c: a1, d: b4)
    t1: B32 = t0.add_finite(a2.mul_finite(b3))
    t2: B32 = t1.add_finite(a3.mul_finite(b2))
    t3: B32 = t2.sub_finite(a4.mul_finite(b1))
    det: B32 = t3.add_finite(a5.mul_finite(b0))
    branch det.eq(0.0)
        ? return(m4_zero())
        : adjugate(B32.div_finite(1.0, det))

    block adjugate(inv: B32)
        r00: B32 = cofactor(row: Vector3D[B32](x: m11, y: m12, z: m13),
            minors: Vector3D[B32](x: b5, y: b4, z: b3)).mul_finite(inv)
        r01: B32 = negated_cofactor(row: Vector3D[B32](x: m01, y: m02, z: m03),
            minors: Vector3D[B32](x: b5, y: b4, z: b3)).mul_finite(inv)
        r02: B32 = cofactor(row: Vector3D[B32](x: m31, y: m32, z: m33),
            minors: Vector3D[B32](x: a5, y: a4, z: a3)).mul_finite(inv)
        r03: B32 = negated_cofactor(row: Vector3D[B32](x: m21, y: m22, z: m23),
            minors: Vector3D[B32](x: a5, y: a4, z: a3)).mul_finite(inv)
        r10: B32 = negated_cofactor(row: Vector3D[B32](x: m10, y: m12, z: m13),
            minors: Vector3D[B32](x: b5, y: b2, z: b1)).mul_finite(inv)
        r11: B32 = cofactor(row: Vector3D[B32](x: m00, y: m02, z: m03),
            minors: Vector3D[B32](x: b5, y: b2, z: b1)).mul_finite(inv)
        r12: B32 = negated_cofactor(row: Vector3D[B32](x: m30, y: m32, z: m33),
            minors: Vector3D[B32](x: a5, y: a2, z: a1)).mul_finite(inv)
        r13: B32 = cofactor(row: Vector3D[B32](x: m20, y: m22, z: m23),
            minors: Vector3D[B32](x: a5, y: a2, z: a1)).mul_finite(inv)
        r20: B32 = cofactor(row: Vector3D[B32](x: m10, y: m11, z: m13),
            minors: Vector3D[B32](x: b4, y: b2, z: b0)).mul_finite(inv)
        r21: B32 = negated_cofactor(row: Vector3D[B32](x: m00, y: m01, z: m03),
            minors: Vector3D[B32](x: b4, y: b2, z: b0)).mul_finite(inv)
        r22: B32 = cofactor(row: Vector3D[B32](x: m30, y: m31, z: m33),
            minors: Vector3D[B32](x: a4, y: a2, z: a0)).mul_finite(inv)
        r23: B32 = negated_cofactor(row: Vector3D[B32](x: m20, y: m21, z: m23),
            minors: Vector3D[B32](x: a4, y: a2, z: a0)).mul_finite(inv)
        r30: B32 = negated_cofactor(row: Vector3D[B32](x: m10, y: m11, z: m12),
            minors: Vector3D[B32](x: b3, y: b1, z: b0)).mul_finite(inv)
        r31: B32 = cofactor(row: Vector3D[B32](x: m00, y: m01, z: m02),
            minors: Vector3D[B32](x: b3, y: b1, z: b0)).mul_finite(inv)
        r32: B32 = negated_cofactor(row: Vector3D[B32](x: m30, y: m31, z: m32),
            minors: Vector3D[B32](x: a3, y: a1, z: a0)).mul_finite(inv)
        r33: B32 = cofactor(row: Vector3D[B32](x: m20, y: m21, z: m22),
            minors: Vector3D[B32](x: a3, y: a1, z: a0)).mul_finite(inv)
        return((m00: r00, m10: r10, m20: r20, m30: r30, m01: r01, m11: r11, m21: r21, m31: r31, m02: r02, m12: r12, m22: r22, m32: r32, m03: r03, m13: r13, m23: r23, m33: r33))

/// The zero matrix.
/// :returns: A matrix of sixteen zeros.
#inline
routine m4_zero() -> Matrix4
    return((m00: 0.0, m10: 0.0, m20: 0.0, m30: 0.0, m01: 0.0, m11: 0.0, m21: 0.0, m31: 0.0, m02: 0.0, m12: 0.0, m22: 0.0, m32: 0.0, m03: 0.0, m13: 0.0, m23: 0.0, m33: 0.0))

/// The rotation matrix of the unit quaternion w + xi + yj + zk.
/// :param w: The real part.
/// :param x: The i part.
/// :param y: The j part.
/// :param z: The k part.
/// :returns: The 4x4 rotation matrix, with 0 0 0 1 as its last row and column.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is
///     infinite.
#[export("ingrid_m4_from_quaternion"), inline]
routine m4_from_quaternion(w: B32, x: B32, y: B32, z: B32) -> Matrix4
    xx: B32 = x.mul_finite(x)
    yy: B32 = y.mul_finite(y)
    zz: B32 = z.mul_finite(z)
    xy: B32 = x.mul_finite(y)
    xz: B32 = x.mul_finite(z)
    yz: B32 = y.mul_finite(z)
    wx: B32 = w.mul_finite(x)
    wy: B32 = w.mul_finite(y)
    wz: B32 = w.mul_finite(z)
    r00: B32 = B32.sub_finite(1.0, twice(yy.add_finite(zz)))
    r10: B32 = twice(xy.add_finite(wz))
    r20: B32 = twice(xz.sub_finite(wy))
    r01: B32 = twice(xy.sub_finite(wz))
    r11: B32 = B32.sub_finite(1.0, twice(xx.add_finite(zz)))
    r21: B32 = twice(yz.add_finite(wx))
    r02: B32 = twice(xz.add_finite(wy))
    r12: B32 = twice(yz.sub_finite(wx))
    r22: B32 = B32.sub_finite(1.0, twice(xx.add_finite(yy)))
    return((m00: r00, m10: r10, m20: r20, m30: 0.0, m01: r01, m11: r11, m21: r21, m31: 0.0, m02: r02, m12: r12, m22: r22, m32: 0.0, m03: 0.0, m13: 0.0, m23: 0.0, m33: 1.0))

/// 2 × v.
/// :param v: The value to double.
/// :returns: The doubled value.
/// :throws: Crashes with `NumericDomainError` when the result is NaN, or `NumericOverflowError` when it is
///     infinite.
#inline
routine twice(v: B32) -> B32
    return(B32.mul_finite(2.0, v))
