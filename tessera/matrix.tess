// RazorForge's 4x4 matrix Matrix4R4C (B32, Tessera's F32, column-major): the bodies of its determinant, inverse, and
// rotation-from-quaternion, moved here from RazorForge's Math3D/Matrix4R4C.rf. RazorForge keeps the type, the SIMD
// column arithmetic (sum, product, transpose, and the rest are vector operations it lowers itself), and thin
// routines that call the ingrid_ exports below.
//
// The formulas are RazorForge's own, unchanged, so every result has the same bits as before, and each `+ - * /` is
// the checked one (finite.tess), which crashes where RazorForge's B32 operators do. The exports take the sixteen
// elements as m{row}{column}, and hand a matrix back as Matrix4: 64 bytes in RazorForge's column-major order, which
// every target returns through a hidden pointer, as it does RazorForge's Matrix4R4C.

/// A 4x4 F32 matrix laid out as RazorForge's Matrix4R4C: column after column, m{row}{column}.
record Matrix4
    m00 : F32
    m10 : F32
    m20 : F32
    m30 : F32
    m01 : F32
    m11 : F32
    m21 : F32
    m31 : F32
    m02 : F32
    m12 : F32
    m22 : F32
    m32 : F32
    m03 : F32
    m13 : F32
    m23 : F32
    m33 : F32

/// a × b - c × d.
#inline
routine cross_difference(a: F32, b: F32, c: F32, d: F32) -> F32
    block entry()
        ab : F32 = a.mul_finite(b)
        cd : F32 = c.mul_finite(d)
        return(ab.sub_finite(cd))

/// a × p - b × q + c × r.
#inline
routine cofactor(a: F32, p: F32, b: F32, q: F32, c: F32, r: F32) -> F32
    block entry()
        ap : F32 = a.mul_finite(p)
        bq : F32 = b.mul_finite(q)
        d  : F32 = ap.sub_finite(bq)
        cr : F32 = c.mul_finite(r)
        return(d.add_finite(cr))

/// -a × p + b × q - c × r.
#inline
routine negated_cofactor(a: F32, p: F32, b: F32, q: F32, c: F32, r: F32) -> F32
    block entry()
        ap : F32 = a.neg().mul_finite(p)
        bq : F32 = b.mul_finite(q)
        d  : F32 = ap.add_finite(bq)
        cr : F32 = c.mul_finite(r)
        return(d.sub_finite(cr))

/// The determinant, by cofactor expansion along the top row with the bottom two rows' 2x2 determinants.
#[export("ingrid_m4_determinant"), inline]
routine m4_determinant(m00: F32, m01: F32, m02: F32, m03: F32, m10: F32, m11: F32, m12: F32,
    m13: F32, m20: F32, m21: F32, m22: F32, m23: F32, m30: F32, m31: F32, m32: F32, m33: F32) -> F32
    block entry()
        s0 : F32 = cross_difference(m20, m31, m21, m30)
        s1 : F32 = cross_difference(m20, m32, m22, m30)
        s2 : F32 = cross_difference(m20, m33, m23, m30)
        s3 : F32 = cross_difference(m21, m32, m22, m31)
        s4 : F32 = cross_difference(m21, m33, m23, m31)
        s5 : F32 = cross_difference(m22, m33, m23, m32)
        d0 : F32 = m00.mul_finite(cofactor(m11, s5, m12, s4, m13, s3))
        d1 : F32 = m01.mul_finite(cofactor(m10, s5, m12, s2, m13, s1))
        d2 : F32 = m02.mul_finite(cofactor(m10, s4, m11, s2, m13, s0))
        d3 : F32 = m03.mul_finite(cofactor(m10, s3, m11, s1, m12, s0))
        e  : F32 = d0.sub_finite(d1).add_finite(d2)
        return(e.sub_finite(d3))

/// The inverse: the adjugate (the transposed cofactors, from the 2x2 determinants of rows 0-1 and rows 2-3) over the
/// determinant. A singular matrix (determinant 0) gives the zero matrix.
#[export("ingrid_m4_inverse"), inline]
routine m4_inverse(m00: F32, m01: F32, m02: F32, m03: F32, m10: F32, m11: F32, m12: F32, m13: F32,
    m20: F32, m21: F32, m22: F32, m23: F32, m30: F32, m31: F32, m32: F32, m33: F32) -> Matrix4
    shared a0 : F32 = cross_difference(m00, m11, m01, m10)
    shared a1 : F32 = cross_difference(m00, m12, m02, m10)
    shared a2 : F32 = cross_difference(m00, m13, m03, m10)
    shared a3 : F32 = cross_difference(m01, m12, m02, m11)
    shared a4 : F32 = cross_difference(m01, m13, m03, m11)
    shared a5 : F32 = cross_difference(m02, m13, m03, m12)
    shared b0 : F32 = cross_difference(m20, m31, m21, m30)
    shared b1 : F32 = cross_difference(m20, m32, m22, m30)
    shared b2 : F32 = cross_difference(m20, m33, m23, m30)
    shared b3 : F32 = cross_difference(m21, m32, m22, m31)
    shared b4 : F32 = cross_difference(m21, m33, m23, m31)
    shared b5 : F32 = cross_difference(m22, m33, m23, m32)

    block entry()
        t0  : F32 = cross_difference(a0, b5, a1, b4)
        t1  : F32 = t0.add_finite(a2.mul_finite(b3))
        t2  : F32 = t1.add_finite(a3.mul_finite(b2))
        t3  : F32 = t2.sub_finite(a4.mul_finite(b1))
        det : F32 = t3.add_finite(a5.mul_finite(b0))
        branch det.eq(0.0)
            ? return(m4_zero())
            : adjugate(F32.div_finite(1.0, det))

    block adjugate(inv: F32)
        r00 : F32 = cofactor(m11, b5, m12, b4, m13, b3).mul_finite(inv)
        r01 : F32 = negated_cofactor(m01, b5, m02, b4, m03, b3).mul_finite(inv)
        r02 : F32 = cofactor(m31, a5, m32, a4, m33, a3).mul_finite(inv)
        r03 : F32 = negated_cofactor(m21, a5, m22, a4, m23, a3).mul_finite(inv)
        r10 : F32 = negated_cofactor(m10, b5, m12, b2, m13, b1).mul_finite(inv)
        r11 : F32 = cofactor(m00, b5, m02, b2, m03, b1).mul_finite(inv)
        r12 : F32 = negated_cofactor(m30, a5, m32, a2, m33, a1).mul_finite(inv)
        r13 : F32 = cofactor(m20, a5, m22, a2, m23, a1).mul_finite(inv)
        r20 : F32 = cofactor(m10, b4, m11, b2, m13, b0).mul_finite(inv)
        r21 : F32 = negated_cofactor(m00, b4, m01, b2, m03, b0).mul_finite(inv)
        r22 : F32 = cofactor(m30, a4, m31, a2, m33, a0).mul_finite(inv)
        r23 : F32 = negated_cofactor(m20, a4, m21, a2, m23, a0).mul_finite(inv)
        r30 : F32 = negated_cofactor(m10, b3, m11, b1, m12, b0).mul_finite(inv)
        r31 : F32 = cofactor(m00, b3, m01, b1, m02, b0).mul_finite(inv)
        r32 : F32 = negated_cofactor(m30, a3, m31, a1, m32, a0).mul_finite(inv)
        r33 : F32 = cofactor(m20, a3, m21, a1, m22, a0).mul_finite(inv)
        return({ m00: r00, m10: r10, m20: r20, m30: r30, m01: r01, m11: r11, m21: r21, m31: r31,
            m02: r02, m12: r12, m22: r22, m32: r32, m03: r03, m13: r13, m23: r23, m33: r33 })

/// The zero matrix.
#inline
routine m4_zero() -> Matrix4
    block entry()
        return({ m00: 0.0, m10: 0.0, m20: 0.0, m30: 0.0, m01: 0.0, m11: 0.0, m21: 0.0, m31: 0.0,
            m02: 0.0, m12: 0.0, m22: 0.0, m32: 0.0, m03: 0.0, m13: 0.0, m23: 0.0, m33: 0.0 })

/// The rotation matrix of the unit quaternion w + xi + yj + zk.
#[export("ingrid_m4_from_quaternion"), inline]
routine m4_from_quaternion(w: F32, x: F32, y: F32, z: F32) -> Matrix4
    block entry()
        xx  : F32 = x.mul_finite(x)
        yy  : F32 = y.mul_finite(y)
        zz  : F32 = z.mul_finite(z)
        xy  : F32 = x.mul_finite(y)
        xz  : F32 = x.mul_finite(z)
        yz  : F32 = y.mul_finite(z)
        wx  : F32 = w.mul_finite(x)
        wy  : F32 = w.mul_finite(y)
        wz  : F32 = w.mul_finite(z)
        r00 : F32 = F32.sub_finite(1.0, twice(yy.add_finite(zz)))
        r10 : F32 = twice(xy.add_finite(wz))
        r20 : F32 = twice(xz.sub_finite(wy))
        r01 : F32 = twice(xy.sub_finite(wz))
        r11 : F32 = F32.sub_finite(1.0, twice(xx.add_finite(zz)))
        r21 : F32 = twice(yz.add_finite(wx))
        r02 : F32 = twice(xz.add_finite(wy))
        r12 : F32 = twice(yz.sub_finite(wx))
        r22 : F32 = F32.sub_finite(1.0, twice(xx.add_finite(yy)))
        return({ m00: r00, m10: r10, m20: r20, m30: 0.0, m01: r01, m11: r11, m21: r21, m31: 0.0,
            m02: r02, m12: r12, m22: r22, m32: 0.0, m03: 0.0, m13: 0.0, m23: 0.0, m33: 1.0 })

/// 2 × v.
#inline
routine twice(v: F32) -> F32
    block entry()
        return(F32.mul_finite(2.0, v))
