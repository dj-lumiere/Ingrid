# The deadlock detector for the Roamed lock (opt-in: RF_DEADLOCK_DETECT=1). A statement that touches two escaped
# entities holds both their locks at once (the builder inserts the lock entries, so the call site doesn't show them),
# and two tasks taking the same pair in opposite order deadlock. With the detector on, a task that finds a lock taken
# records whom it waits for and walks the chain of holders. If the chain comes back to it, the wait is a cycle, and the
# program stops with both task ids instead of hanging. Off by default, at no cost. The table is fixed. When it is full,
# or a task waits on itself, nothing is detected (never a false report).

import Standard/Format
import Standard/Os

global WAITS: @Array[DeadlockWait, 256]
### Guards WAITS.
global WAITS_LOCK: @ExclusiveLock
### 0 before the environment is read, 1 off, 2 on.
global DETECTOR: @U8

preset WAIT_SLOTS: U64 = 256

### One task waiting for a lock: who waits, and the task holding the lock.
record DeadlockWait
    task: U64
    holder: U64
    used: Bool

### C's getenv: the value of the environment variable `name`.
### :param name: The variable's name.
### :returns: The value as a C string, or null when the variable is not set.
@external("c")
@symbol("getenv")
routine c_getenv(name: CStrView) -> @Byte

### Whether RF_DEADLOCK_DETECT asks for the detector: set, not empty, and not "0". Read once. Two threads reading it
### at once both find the same answer.
### :returns: True when the detector is on.
routine is_detector_on() -> Bool
    state: U8 = DETECTOR.peek_atomic()
    if state == 0
        value: @Byte = c_getenv("RF_DEADLOCK_DETECT")
        on: Bool = when
            value.is_hollow() => false
            else =>
                first: Byte = value.peek()
                off: Bool = first == 0x00 or first == b'0'
                becomes not off
        state2: U8 = when
            on => 2
            else => 1
        DETECTOR.poke_atomic(state2)
        return on
    else
        return state == 2

### The slot where `task` waits, or WAIT_SLOTS when it waits nowhere.
### :param task: The waiting task's id.
### :returns: The slot's index, or WAIT_SLOTS.
routine slot_of(task: U64) -> U64
    each i in 0 til WAIT_SLOTS
        slot: @DeadlockWait = WAITS.getslot(i)
        if slot.used.peek() & (slot.task.peek() == task)
            return i
        else
            continue
    then
        return WAIT_SLOTS

### The first free slot, or WAIT_SLOTS when the table is full.
### :returns: The slot's index, or WAIT_SLOTS.
routine free_slot() -> U64
    each i in 0 til WAIT_SLOTS
        if WAITS.getslot(i).used.peek()
            continue
        else
            return i
    then
        return WAIT_SLOTS

### Records that `waiter` waits for `holder`, then follows the holders: a chain that leads back to `waiter` is a
### deadlock, and the program stops. Does nothing when the detector is off, when `holder` is 0 or `waiter` itself, or
### when the table is full.
### :param waiter: The id of the task that found the lock taken.
### :param holder: The id of the task holding the lock.
### :note: A deadlock writes both task ids to standard error and exits with the crash status.
routine deadlock_wait_begin(waiter: U64, holder: U64) -> None
    if not is_detector_on()
        return
    if holder == 0 or holder == waiter
        return
    WAITS_LOCK.lock()
    existing: U64 = slot_of(waiter)
    slot: U64 = when
        existing < WAIT_SLOTS => existing
        else => free_slot()
    if slot >= WAIT_SLOTS
        WAITS_LOCK.unlock()
        return
    else
        entry: @DeadlockWait = WAITS.getslot(slot)
        waiter.poke_into(entry.task)
        holder.poke_into(entry.holder)
        true.poke_into(entry.used)

        each steps in 0 til WAIT_SLOTS with current: U64 = holder
            at: U64 = slot_of(current)
            if at >= WAIT_SLOTS
                WAITS_LOCK.unlock()
                return
            else
                next: U64 = WAITS.getslot(at).holder.peek()
                if next == waiter
                    WAITS_LOCK.unlock()
                    Console.alert("runtime error: Roamed lock deadlock: task {waiter} and task {current} took the same escaped entities in opposite order. Take shared entities in one consistent order.")
                    rf_crash_exit()
                else
                    continue with current: next
        then
            WAITS_LOCK.unlock()
            return

### Clears `waiter`'s wait once it holds the lock. Does nothing when the detector is off.
### :param waiter: The id of the task that now holds the lock.
routine deadlock_wait_end(waiter: U64) -> None
    if not is_detector_on()
        return
    WAITS_LOCK.lock()
    slot: U64 = slot_of(waiter)
    if slot < WAIT_SLOTS
        false.poke_into(WAITS.getslot(slot).used)
    WAITS_LOCK.unlock()
    return
