### x raised to y, for BF16.pow in RazorForge.
### :param x: The base's bits.
### :param y: The exponent's bits.
### :returns: The result's bits.
@export("ingrid_bf16_pow")
routine bf16_pow(x: U16, y: U16) -> U16
    return BF16.from_bits(x).powf(BF16.from_bits(y)).bits()

### x raised to the integer n, for BF16.powi in RazorForge.
### :param x: The base's bits.
### :param n: The power.
### :returns: The result's bits.
@export("ingrid_bf16_powi")
routine bf16_powi(x: U16, n: S32) -> U16
    return BF16.from_bits(x).powi(n).bits()

### The angle of the point (x, y), for atan2 in RazorForge.
### :param y: The y-coordinate's bits.
### :param x: The x-coordinate's bits.
### :returns: The result's bits.
@export("ingrid_bf16_atan2")
routine bf16_atan2(y: U16, x: U16) -> U16
    return atan2(y: BF16.from_bits(y), x: BF16.from_bits(x)).bits()

### The hypotenuse of x and y, for hypot in RazorForge.
### :param x: One leg's bits.
### :param y: The other leg's bits.
### :returns: The result's bits.
@export("ingrid_bf16_hypot")
routine bf16_hypot(x: U16, y: U16) -> U16
    return hypot(x: BF16.from_bits(x), y: BF16.from_bits(y)).bits()

### sqrt(x^2 + y^2 + z^2) of BF16 legs, correctly rounded, for hypot in RazorForge.
### :param x: The first leg's bits.
### :param y: The second leg's bits.
### :param z: The third leg's bits.
### :returns: The result's bits.
@export("ingrid_bf16_hypot3")
routine bf16_hypot3(x: U16, y: U16, z: U16) -> U16
    return hypot(x: BF16.from_bits(x), y: BF16.from_bits(y), z: BF16.from_bits(z)).bits()

### x * y + z with one rounding, for BF16.fma in RazorForge.
### :param x: The first factor's bits.
### :param y: The second factor's bits.
### :param z: The addend's bits.
### :returns: The result's bits.
@export("ingrid_bf16_fma")
routine bf16_fma(x: U16, y: U16, z: U16) -> U16
    return BF16.from_bits(x).mul_add(BF16.from_bits(y), BF16.from_bits(z)).bits()

