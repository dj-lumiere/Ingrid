@export("ingrid_b16_powi")
@inline
routine b16_powi(x: B16, n: S32) -> B16
    return x.powi(n)

### The angle of the point (x, y), for `atan2(...)` over B16.
### :param y: The point's y coordinate.
### :param x: The point's x coordinate.
### :returns: The angle of the point (x, y).
@export("ingrid_b16_atan2")
@inline
routine b16_atan2(y: B16, x: B16) -> B16
    return atan2(y: y, x: x)

### sqrt(x^2 + y^2) without overflow on the way, for `hypot_unchecked(...)` over B16.
### :param x: The first side.
### :param y: The second side.
### :returns: sqrt(x^2 + y^2).
@export("ingrid_b16_hypot")
@inline
routine b16_hypot(x: B16, y: B16) -> B16
    return hypot(x: x, y: y)

### sqrt(x^2 + y^2 + z^2), correctly rounded, for `hypot_unchecked(x:, y:, z:)` over B16.
### :param x: The first leg.
### :param y: The second leg.
### :param z: The third leg.
### :returns: sqrt(x^2 + y^2 + z^2).
@export("ingrid_b16_hypot3")
@inline
routine b16_hypot3(x: B16, y: B16, z: B16) -> B16
    return hypot(x: x, y: y, z: z)

# ── BF16 ─────────────────────────────────────────────────────────────────────────

# A BF16 crosses as its 16 bits: its C type differs between targets, and a U16 never does.

### exp of a BF16, for BF16.exp in RazorForge.
### :param x: The argument's bits.
### :returns: The result's bits.
@export("ingrid_bf16_exp")
routine bf16_exp(x: U16) -> U16
    return BF16.from_bits(x).exp().bits()

