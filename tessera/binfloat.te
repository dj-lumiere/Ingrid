### The sine and the cosine of a BF16, for BF16.sin_cos in RazorForge.
### :param x: The argument's bits.
### :returns: The sine's bits in the low 16 bits and the cosine's in the high 16 bits.
@export("ingrid_bf16_sin_cos")
routine bf16_sin_cos(x: U16) -> U32
    both: BF16SinCos = BF16.from_bits(x).sin_cos()
    return both.sin.bits().to[U32]() | (both.cos.bits().to[U32]() << 16)

### (1 + x)^y, for BF16.compound in RazorForge.
### :param x: The base's bits, less 1.
### :param y: The exponent's bits.
### :returns: The result's bits.
@export("ingrid_bf16_compound")
routine bf16_compound(x: U16, y: U16) -> U16
    return BF16.from_bits(x).compound(BF16.from_bits(y)).bits()

### The angle of the point (x, y) divided by pi, for atan2pi in RazorForge.
### :param y: The y-coordinate's bits.
### :param x: The x-coordinate's bits.
### :returns: The result's bits.
@export("ingrid_bf16_atan2_pi")
routine bf16_atan2_pi(y: U16, x: U16) -> U16
    return atan2_pi(y: BF16.from_bits(y), x: BF16.from_bits(x)).bits()

# ── B32 ──────────────────────────────────────────────────────────────────────────

### E^x, for B32.exp_unchecked.
### :param x: The argument.
### :returns: E^x.
@export("ingrid_b32_exp")
@inline
