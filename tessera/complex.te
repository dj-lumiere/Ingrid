### The polar form, for C128.to_polar.
### :param real: The real part.
### :param imag: The imaginary part.
### :returns: The modulus in w0, the angle in w1, and zero in w2 and w3.
### :throws: Crashes where `abs` does.
@export("ingrid_c128_polar")
@inline
routine c128_polar(real: B64, imag: B64) -> Words
    z: C128 = (real: real, imag: imag)
    return z.to_polar().words()

# ── C256 ──────────────────────────────────────────────────────────────────────────

### RazorForge's C256: a complex number over B128, RazorForge's B128.
record C256
obeys Addable[C256], Subtractable[C256], Multiplicable[C256], Divisible[C256], Exponentiable[C256]
    real: B128
    imag: B128

### 1 + 0i.
### :returns: 1 + 0i.
@inline
common routine C256.one() -> Me
    return (real: B128_ONE, imag: B128_ZERO)

### The sum, part by part.
### :param other: The number to add.
### :returns: The sum.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@inline
routine C256.add(other: Me) -> Me
    re: B128 = me.real.add_finite(other.real)
    im: B128 = me.imag.add_finite(other.imag)
    return (real: re, imag: im)

### The difference, part by part.
### :param other: The number to subtract.
### :returns: The difference.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@inline
routine C256.sub(other: Me) -> Me
    re: B128 = me.real.sub_finite(other.real)
    im: B128 = me.imag.sub_finite(other.imag)
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The product (ac - bd) + (ad + bc)i.
### :param other: The number to multiply by.
### :returns: The product.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C256.mul_textbook(other: Me) -> Me
    ac: B128 = me.real.mul_finite(other.real)
    bd: B128 = me.imag.mul_finite(other.imag)
    re: B128 = ac.sub_finite(bd)
    ad: B128 = me.real.mul_finite(other.imag)
    bc: B128 = me.imag.mul_finite(other.real)
    im: B128 = ad.add_finite(bc)
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The quotient: me times the conjugate of other, over other's squared modulus.
### :param other: The divisor.
### :returns: The quotient.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN. Dividing by 0 + 0i is a `DivisionByZeroError`, and 0 / (0 + 0i) a `NumericDomainError`, as
###     with real division. A nonzero divisor whose squared modulus underflows to zero divides a nonzero value by
###     zero, a `DivisionByZeroError` too.
secret routine C256.truediv_textbook(other: Me) -> Me
    if other.is_zero()
        crash_zero_divisor(me.is_zero())
    d: B128 = other.norm_textbook()
    ac: B128 = me.real.mul_finite(other.real)
    bd: B128 = me.imag.mul_finite(other.imag)
    re: B128 = ac.add_finite(bd).truediv_finite(d)
    bc: B128 = me.imag.mul_finite(other.real)
    ad: B128 = me.real.mul_finite(other.imag)
    im: B128 = bc.sub_finite(ad).truediv_finite(d)
    return (real: re, imag: im)

### Whether both parts are zero (+0 or -0).
### :returns: True for 0 + 0i.
@inline
routine C256.is_zero() -> Bool
    return me.real.is_zero() and me.imag.is_zero()

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The squared modulus real² + imag².
### :returns: The squared modulus.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C256.norm_textbook() -> B128
    rr: B128 = me.real.mul_finite(me.real)
    ii: B128 = me.imag.mul_finite(me.imag)
    return rr.add_finite(ii)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The modulus, the square root of the squared modulus.
### :returns: The modulus.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C256.abs_textbook() -> B128
    return me.norm_textbook().sqrt_unchecked()

### The phase angle atan2(imag, real), in (-π, π].
### :returns: The phase angle.
routine C256.arg() -> B128
    return atan2(y: me.imag, x: me.real)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The sine, sin a cosh b + i cos a sinh b.
### :returns: The sine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C256.sin_textbook() -> Me
    re: B128 = me.real.sin().mul_finite(me.imag.cosh_unchecked())
    im: B128 = me.real.cos().mul_finite(me.imag.sinh_unchecked())
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The cosine, cos a cosh b - i sin a sinh b.
### :returns: The cosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C256.cos_textbook() -> Me
    re: B128 = me.real.cos().mul_finite(me.imag.cosh_unchecked())
    im: B128 = -me.real.sin().mul_finite(me.imag.sinh_unchecked())
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The tangent, (sin 2a + i sinh 2b) / (cos 2a + cosh 2b).
### :returns: The tangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
secret routine C256.tan_textbook() -> Me
    a2: B128 = me.real.add_finite(me.real)
    b2: B128 = me.imag.add_finite(me.imag)
    d: B128 = a2.cos().add_finite(b2.cosh_unchecked())
    re: B128 = a2.sin().truediv_finite(d)
    im: B128 = b2.sinh_unchecked().truediv_finite(d)
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The arcsine, -i log(iz + √(1 - z²)).
### :returns: The arcsine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C256.asin_textbook() -> Me
    iz: Me = (real: -me.imag, imag: me.real)
    zz: Me = me * me
    s: Me = (Me.one() - zz).sqrt()
    v: Me = (iz + s).ln()
    return (real: v.imag, imag: -v.real)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The arccosine, -i log(z + i √(1 - z²)).
### :returns: The arccosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C256.acos_textbook() -> Me
    zz: Me = me * me
    s: Me = (Me.one() - zz).sqrt()
    `is`: Me = (real: -s.imag, imag: s.real)
    v: Me = (me + `is`).ln()
    return (real: v.imag, imag: -v.real)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The arctangent, (i/2) log((i + z) / (i - z)).
### :returns: The arctangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
secret routine C256.atan_textbook() -> Me
    num_imag: B128 = me.imag.add_finite(B128_ONE)
    den_imag: B128 = B128.sub_finite(B128_ONE, me.imag)
    num: Me = (real: me.real, imag: num_imag)
    den: Me = (real: -me.real, imag: den_imag)
    v: Me = (num / den).ln()
    re: B128 = (-v.imag).truediv_finite(B128_TWO)
    im: B128 = v.real.truediv_finite(B128_TWO)
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The hyperbolic sine, sinh a cos b + i cosh a sin b.
### :returns: The hyperbolic sine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C256.sinh_textbook() -> Me
    re: B128 = me.real.sinh_unchecked().mul_finite(me.imag.cos())
    im: B128 = me.real.cosh_unchecked().mul_finite(me.imag.sin())
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The hyperbolic cosine, cosh a cos b + i sinh a sin b.
### :returns: The hyperbolic cosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C256.cosh_textbook() -> Me
    re: B128 = me.real.cosh_unchecked().mul_finite(me.imag.cos())
    im: B128 = me.real.sinh_unchecked().mul_finite(me.imag.sin())
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The hyperbolic tangent, (sinh 2a + i sin 2b) / (cosh 2a + cos 2b).
### :returns: The hyperbolic tangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
secret routine C256.tanh_textbook() -> Me
    a2: B128 = me.real.add_finite(me.real)
    b2: B128 = me.imag.add_finite(me.imag)
    d: B128 = a2.cosh_unchecked().add_finite(b2.cos())
    re: B128 = a2.sinh_unchecked().truediv_finite(d)
    im: B128 = b2.sin().truediv_finite(d)
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The inverse hyperbolic sine, log(z + √(z² + 1)).
### :returns: The inverse hyperbolic sine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C256.asinh_textbook() -> Me
    zz: Me = me * me
    s: Me = (zz + Me.one()).sqrt()
    return (me + s).ln()

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The inverse hyperbolic cosine, log(z + √(z² - 1)).
### :returns: The inverse hyperbolic cosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C256.acosh_textbook() -> Me
    zz: Me = me * me
    s: Me = (zz - Me.one()).sqrt()
    return (me + s).ln()

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The inverse hyperbolic tangent, log((1 + z) / (1 - z)) / 2.
### :returns: The inverse hyperbolic tangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
secret routine C256.atanh_textbook() -> Me
    p: Me = Me.one() + me
    m: Me = Me.one() - me
    v: Me = (p / m).ln()
    re: B128 = v.real.truediv_finite(B128_TWO)
    im: B128 = v.imag.truediv_finite(B128_TWO)
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### e to this power, eᵃ (cos b + i sin b).
### :returns: e to this power.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C256.exp_textbook() -> Me
    ea: B128 = me.real.exp_unchecked()
    re: B128 = ea.mul_finite(me.imag.cos())
    im: B128 = ea.mul_finite(me.imag.sin())
    return (real: re, imag: im)

### The principal natural logarithm, ln |z| + i arg z.
### :returns: The principal natural logarithm.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.ln() -> Me
    re: B128 = me.abs().ln_unchecked()
    return (real: re, imag: me.arg())

### The base-10 logarithm, ln z / ln 10.
### :returns: The base-10 logarithm.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.log10() -> Me
    v: Me = me.ln()
    re: B128 = v.real.truediv_finite(C256_LN_10)
    im: B128 = v.imag.truediv_finite(C256_LN_10)
    return (real: re, imag: im)

### The base-2 logarithm, ln z / ln 2.
### :returns: The base-2 logarithm.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.log2() -> Me
    v: Me = me.ln()
    re: B128 = v.real.truediv_finite(C256_LN_2)
    im: B128 = v.imag.truediv_finite(C256_LN_2)
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### 1 / z, the conjugate over the squared modulus.
### :returns: 1 / z.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN. The reciprocal of 0 + 0i is 1 / 0, a `DivisionByZeroError`, as with real division. A
###     squared modulus that underflows to zero divides a nonzero value by zero, a `DivisionByZeroError` too.
secret routine C256.reciprocal_textbook() -> Me
    if me.is_zero()
        throw DivisionByZeroError()
    d: B128 = me.norm_textbook()
    re: B128 = me.real.truediv_finite(d)
    im: B128 = (-me.imag).truediv_finite(d)
    return (real: re, imag: im)

### The product (ac - bd) + (ad + bc)i, each part rounded once (b128_dot2: the products are exact integers).
### :param other: The number to multiply by.
### :returns: The product.
### :throws: Crashes with `NumericOverflowError` when a part is past B128's range. With an operand that is not finite
###     it crashes where the textbook formula does (`mul_textbook`).
routine C256.mul(other: Me) -> Me
    if not (me.is_finite() and other.is_finite())
        return me.mul_textbook(other)
    re: B128 = b128_dot2(a: me.real, b: other.real, c: -me.imag, d: other.imag).hi
    im: B128 = b128_dot2(a: me.real, b: other.imag, c: me.imag, d: other.real).hi
    return c256_finite(re, im)

### The quotient (ac + bd)/(c² + d²) + (bc - ad)/(c² + d²) i, each part rounded once (b128_divide).
### :param other: The divisor.
### :returns: The quotient.
### :throws: Crashes with `DivisionByZeroError` when dividing by 0 + 0i, with `NumericDomainError` for 0 / (0 + 0i), and
###     with `NumericOverflowError` when a part is past B128's range. With an operand that is not finite it crashes
###     where the textbook formula does (`truediv_textbook`).
routine C256.truediv(other: Me) -> Me
    if other.is_zero()
        crash_zero_divisor(me.is_zero())
    if not (me.is_finite() and other.is_finite())
        return me.truediv_textbook(other)
    q: B128Pair = b128_divide(operands: (a: me.real, b: me.imag, c: other.real, d: other.imag))
    return c256_finite(re: q.hi, im: q.lo)

### The squared modulus real² + imag², rounded once.
### :returns: The squared modulus.
### :throws: Crashes with `NumericOverflowError` when it is past B128's range. With a part that is not finite it
###     crashes where the textbook formula does (`norm_textbook`).
routine C256.norm() -> B128
    if not me.is_finite()
        return me.norm_textbook()
    n: B128 = b128_dot2(a: me.real, b: me.real, c: me.imag, d: me.imag).hi
    if n.is_finite()
        return n
    crash_not_finite(false)

### The modulus √(real² + imag²), rounded once (the correctly rounded hypot), with no overflow or underflow on the
### way.
### :returns: The modulus.
### :throws: Crashes with `NumericOverflowError` when it is past B128's range. With a part that is not finite it
###     crashes where the textbook formula does (`abs_textbook`).
routine C256.abs() -> B128
    if not me.is_finite()
        return me.abs_textbook()
    r: B128 = hypot_unchecked(x: me.real, y: me.imag)
    if r.is_finite()
        return r
    crash_not_finite(false)

### 1 / z = real/(real² + imag²) - imag/(real² + imag²) i, each part rounded once (as in `truediv`), a zero part
### with the sign of real / (real² + imag²) and -imag / (real² + imag²).
### :returns: 1 / z.
### :throws: Crashes with `DivisionByZeroError` for 0 + 0i, as with real division, and with `NumericOverflowError` when
###     a part is past B128's range. With a part that is not finite it crashes where the textbook formula does
###     (`reciprocal_textbook`).
routine C256.reciprocal() -> Me
    if me.is_zero()
        throw DivisionByZeroError()
    if not me.is_finite()
        return me.reciprocal_textbook()
    q: B128Pair = b128_divide(operands: (a: B128_ONE, b: B128_ZERO, c: me.real, d: me.imag))
    re: B128 = when
        me.real.is_zero() => me.real
        else => q.hi
    im: B128 = when
        me.imag.is_zero() => -me.imag
        else => q.lo
    return c256_finite(re, im)

### Both parts, crashing unless both are finite: the check behind the arithmetic rounded once, whose operands were
### finite, so a part that is not finite is past the range.
### :param re: The real part.
### :param im: The imaginary part.
### :returns: The number re + im i.
### :throws: Crashes with `NumericOverflowError` when a part is infinite, or with `NumericDomainError` when one is NaN.
@inline
secret routine c256_finite(re: B128, im: B128) -> C256
    if re.is_finite() and im.is_finite()
        return (real: re, imag: im)
    crash_not_finite(re.is_nan() or im.is_nan())

### The negation, part by part.
### :returns: -real - imag i.
@inline
routine C256.neg() -> Me
    return (real: -me.real, imag: -me.imag)

### The conjugate: the imaginary part negated.
### :returns: real - imag i.
@inline
routine C256.conjugate() -> Me
    return (real: me.real, imag: -me.imag)

### Whether both parts compare equal, as floats do: -0 equals +0, and a NaN equals nothing.
### :param other: The number to compare with.
### :returns: True when real == other.real and imag == other.imag.
@inline
routine C256.eq(other: Me) -> Bool
    return me.real == other.real and me.imag == other.imag

### Whether both parts are finite.
### :returns: True when neither part is infinite or NaN.
@inline
routine C256.is_finite() -> Bool
    return me.real.is_finite() and me.imag.is_finite()

### Whether a part is NaN.
### :returns: True when the real or the imaginary part is NaN.
@inline
routine C256.is_nan() -> Bool
    return me.real.is_nan() or me.imag.is_nan()

### Whether a part is infinite.
### :returns: True when the real or the imaginary part is an infinity.
@inline
routine C256.is_infinite() -> Bool
    return me.real.is_infinite() or me.imag.is_infinite()

### What kind of number this is, as flags: 1 both parts zero, 2 the imaginary part zero (on the real axis), 4 the real
### part zero (on the imaginary axis), 8 a part NaN, 16 a part infinite, 32 both parts finite. A zero is +0 or -0.
### :returns: The flags.
@inline
routine C256.classify() -> U32
    real_zero: Bool = me.real.is_zero()
    imag_zero: Bool = me.imag.is_zero()
    zero: U32 = (real_zero and imag_zero).to[U32]()
    on_real: U32 = imag_zero.to[U32]() << 1
    on_imaginary: U32 = real_zero.to[U32]() << 2
    not_a_number: U32 = me.is_nan().to[U32]() << 3
    infinite: U32 = me.is_infinite().to[U32]() << 4
    finite: U32 = me.is_finite().to[U32]() << 5
    return zero | on_real | on_imaginary | not_a_number | infinite | finite

### The product with a real number, both parts multiplied by it (the real part first).
### :param factor: The real factor.
### :returns: real × factor + imag × factor i.
### :throws: Crashes with `NumericOverflowError` when a product is infinite, or with `NumericDomainError` when one is
###     NaN.
@inline
routine C256.mul_real(factor: B128) -> Me
    re: B128 = me.real.mul_finite(factor)
    im: B128 = me.imag.mul_finite(factor)
    return (real: re, imag: im)

### The quotient by a real number, both parts divided by it (the real part first).
### :param divisor: The real divisor.
### :returns: real / divisor + imag / divisor i.
### :throws: Crashes with `DivisionByZeroError` when a nonzero part is divided by zero, with `NumericDomainError` when a
###     quotient is NaN, or with `NumericOverflowError` when one is infinite.
@inline
routine C256.truediv_real(divisor: B128) -> Me
    re: B128 = me.real.truediv_finite(divisor)
    im: B128 = me.imag.truediv_finite(divisor)
    return (real: re, imag: im)

### The polar form: the modulus (`abs`) and the phase angle (`arg`).
### :returns: The modulus in `real` and the angle in `imag`.
### :throws: Crashes where `abs` does.
@inline
routine C256.to_polar() -> Me
    return (real: me.abs(), imag: me.arg())

### SipHash-2-4 of the value under the key (k0, k1): both parts' bits with a zero part as +0, so numbers that compare
### equal hash the same.
### :param k0: The key's first 64-bit word.
### :param k1: The key's second 64-bit word.
### :returns: The 64-bit hash.
routine C256.hash_keyed(k0: U64, k1: U64) -> U64
    re: U128 = when
        me.real.is_zero() => 0
        else => me.real.bits()
    im: U128 = when
        me.imag.is_zero() => 0
        else => me.imag.bits()
    words: &[U64] <- [re.to_wrap[U64](), (re >> 64).to_wrap[U64](), im.to_wrap[U64](),
        (im >> 64).to_wrap[U64]()]
    key: SipKey = (k0: k0, k1: k1)
    return siphash24(data: words.to[@U64]().to[@Byte](), count: 32, key)

### Whether both parts are at most 2^8189 in magnitude: past it the products the inverse functions form could
### overflow, so those keep the textbook formulas.
### :returns: True when neither part is larger.
@inline
secret routine C256.is_moderate() -> Bool
    return me.real.abs() <= CX_B128_BIG and me.imag.abs() <= CX_B128_BIG

### The principal square root (real part >= 0), Kahan's: t = √((|z| + |real|) / 2) from the correctly rounded modulus,
### then the other part as imag / 2t, so neither part cancels. The imaginary part takes the sign of this imaginary part,
### so -0 and +0 pick the two sides of the cut along the negative reals: √(-4 - 0i) is 0 - 2i. A modulus below
### 2^-16156 is computed from this number scaled up by 4^115, exactly.
### :returns: The principal square root.
### :throws: With a part that is not finite it crashes where the textbook formula does (`sqrt_textbook`).
routine C256.sqrt() -> Me
    if not me.is_finite()
        return me.sqrt_textbook()
    if me.real.is_zero() and me.imag.is_zero()
        return (real: B128_ZERO, imag: me.imag)
    r: B128 = hypot_unchecked(x: me.real, y: me.imag)
    if r < CX_B128_SQRT_TINY
        up: B128 = CX_B128_SQRT_UP
        big: Me = (real: me.real *! up *! up, imag: me.imag *! up *! up)
        root: Me = big.sqrt()
        down: B128 = CX_B128_SQRT_DOWN
        return (real: root.real *! down, imag: root.imag *! down)
    t: B128 = ((r *! CX_B128_HALF) +! (me.real.abs() *! CX_B128_HALF)).sqrt_unchecked()
    if not me.real.is_sign_negative()
        return (real: t, imag: me.imag /! (t +! t))
    return (real: me.imag.abs() /! (t +! t), imag: t.copysign(me.imag))

### The arcsine on the principal branch, Kahan's: real part atan(real / Re(√(1 - z) √(1 + z))), imaginary part
### asinh(Im(conj(√(1 - z)) √(1 + z))). On the cuts beyond ±1 the sign of a zero imaginary part picks the side.
### :returns: The arcsine.
### :throws: With a part that is not finite or larger than 2^8189 it crashes where the textbook formula does
###     (`asin_textbook`).
routine C256.asin() -> Me
    if not (me.is_finite() and me.is_moderate())
        return me.asin_textbook()
    s1: Me = Me.sqrt_of(real: B128_ONE -! me.real, imag: -me.imag)
    s2: Me = Me.sqrt_of(real: B128_ONE +! me.real, imag: me.imag)
    den: B128 = (s1.real *! s2.real) -! (s1.imag *! s2.imag)
    re: B128 = atan2(y: me.real, x: den)
    im: B128 = ((s1.real *! s2.imag) -! (s1.imag *! s2.real)).asinh()
    return c256_finite(re, im)

### The arccosine on the principal branch, Kahan's: real part 2 atan(Re √(1 - z) / Re √(1 + z)), imaginary part
### asinh(Im(conj(√(1 + z)) √(1 - z))).
### :returns: The arccosine.
### :throws: With a part that is not finite or larger than 2^8189 it crashes where the textbook formula does
###     (`acos_textbook`).
routine C256.acos() -> Me
    if not (me.is_finite() and me.is_moderate())
        return me.acos_textbook()
    s1: Me = Me.sqrt_of(real: B128_ONE -! me.real, imag: -me.imag)
    s2: Me = Me.sqrt_of(real: B128_ONE +! me.real, imag: me.imag)
    re: B128 = B128_TWO *! atan2(y: s1.real, x: s2.real)
    im: B128 = ((s2.real *! s1.imag) -! (s2.imag *! s1.real)).asinh()
    return c256_finite(re, im)

### The inverse hyperbolic sine, -i asin(iz), on the principal branch.
### :returns: The inverse hyperbolic sine.
### :throws: With a part that is not finite or larger than 2^8189 it crashes where the textbook formula does
###     (`asinh_textbook`).
routine C256.asinh() -> Me
    if not (me.is_finite() and me.is_moderate())
        return me.asinh_textbook()
    v: Me = (real: -me.imag, imag: me.real).asin()
    return (real: v.imag, imag: -v.real)

### The inverse hyperbolic cosine on the principal branch, Kahan's: real part asinh(Re(conj(√(z - 1)) √(z + 1))),
### imaginary part 2 atan(Im √(z - 1) / Re √(z + 1)).
### :returns: The inverse hyperbolic cosine.
### :throws: With a part that is not finite or larger than 2^8189 it crashes where the textbook formula does
###     (`acosh_textbook`).
routine C256.acosh() -> Me
    if not (me.is_finite() and me.is_moderate())
        return me.acosh_textbook()
    s1: Me = Me.sqrt_of(real: me.real -! B128_ONE, imag: me.imag)
    s2: Me = Me.sqrt_of(real: me.real +! B128_ONE, imag: me.imag)
    re: B128 = ((s1.real *! s2.real) +! (s1.imag *! s2.imag)).asinh()
    im: B128 = B128_TWO *! atan2(y: s1.imag, x: s2.real)
    return c256_finite(re, im)

### The inverse hyperbolic tangent on the principal branch: real part ln(((1 + real)² + imag²) / ((1 - real)² + imag²))
### / 4, as ln_1p(4 real / ((1 - real)² + imag²)) / 4 when |real| < 1/2 so nothing cancels, imaginary part
### atan2(2 imag, (1 - real)(1 + real) - imag²) / 2. On the cuts beyond ±1 the sign of a zero imaginary part picks the
### side.
### :returns: The inverse hyperbolic tangent.
### :throws: Crashes with `DivisionByZeroError` at the poles ±1. With a part that is not finite or larger than
###     2^8189 it crashes where the textbook formula does (`atanh_textbook`).
routine C256.atanh() -> Me
    if not (me.is_finite() and me.is_moderate())
        return me.atanh_textbook()
    if me.imag.is_zero() and me.real.abs() == B128_ONE
        throw DivisionByZeroError()
    one_minus: B128 = B128_ONE -! me.real
    one_plus: B128 = B128_ONE +! me.real
    yy: B128 = me.imag *! me.imag
    den: B128 = (one_minus *! one_minus) +! yy
    re: B128 = when
        me.real.abs() < CX_B128_HALF => (CX_B128_FOUR *! me.real /! den).ln_1p_unchecked() *! CX_B128_QUARTER
        else => (((one_plus *! one_plus) +! yy) /! den).ln_unchecked() *! CX_B128_QUARTER
    x: B128 = (one_minus *! one_plus) -! yy
    im: B128 = atan2(y: B128_TWO *! me.imag, x) *! CX_B128_HALF
    return c256_finite(re, im)

### The arctangent, -i atanh(iz), on the principal branch.
### :returns: The arctangent.
### :throws: Crashes with `DivisionByZeroError` at the poles ±i. With a part that is not finite or larger than
###     2^8189 it crashes where the textbook formula does (`atan_textbook`).
routine C256.atan() -> Me
    if not (me.is_finite() and me.is_moderate())
        return me.atan_textbook()
    v: Me = (real: -me.imag, imag: me.real).atanh()
    return (real: v.imag, imag: -v.real)

### The hyperbolic tangent, Kahan's: with t = tan(imag), β = 1 + t², s = sinh(real) and ρ = √(1 + s²), it is
### (β ρ s + i t) / (1 + β s²), with nothing to cancel. Where β s² is past the range the real part is ±1 and the
### imaginary part t / (β s²).
### :returns: The hyperbolic tangent.
### :throws: With a part that is not finite it crashes where the textbook formula does (`tanh_textbook`).
routine C256.tanh() -> Me
    if not me.is_finite()
        return me.tanh_textbook()
    t: B128 = me.imag.tan()
    beta: B128 = B128_ONE +! (t *! t)
    s: B128 = me.real.sinh_unchecked()
    if s.abs() > CX_B128_BIG
        return (real: B128_ONE.copysign(me.real), imag: (t /! (beta *! s)) /! s)
    rho: B128 = (B128_ONE +! (s *! s)).sqrt_unchecked()
    den: B128 = B128_ONE +! (beta *! s *! s)
    return c256_finite(re: (beta *! rho *! s) /! den, im: t /! den)

### The tangent, -i tanh(iz).
### :returns: The tangent.
### :throws: With a part that is not finite it crashes where the textbook formula does (`tan_textbook`).
routine C256.tan() -> Me
    if not me.is_finite()
        return me.tan_textbook()
    v: Me = (real: -me.imag, imag: me.real).tanh()
    return (real: v.imag, imag: -v.real)

### The principal square root of real + imag i, for the inverse functions.
### :param real: The real part.
### :param imag: The imaginary part.
### :returns: Its square root.
@inline
secret common routine C256.sqrt_of(real: B128, imag: B128) -> Me
    z: Me = (real: real, imag: imag)
    return z.sqrt()

### e to this power, e^real (cos imag + i sin imag), from the real exponential and the correctly rounded cosine and
### sine.
### Past the range a part is an infinity, not a crash (it is `exp_unchecked`), and a zero imaginary part stays as it is,
### so e^(real + 0i) is e^real + 0i.
### :returns: e to this power.
### :throws: With a part that is not finite it crashes where the textbook formula does (`exp_textbook`).
routine C256.exp() -> Me
    if not me.is_finite()
        return me.exp_textbook()
    e: B128 = me.real.exp_unchecked()
    im: B128 = when
        me.imag.is_zero() => me.imag
        else => e *! me.imag.sin()
    return (real: e *! me.imag.cos(), imag: im)

### The sine, sin real cosh imag + i cos real sinh imag, from the correctly rounded real functions. A zero real part
### stays as it is.
### :returns: The sine.
### :throws: Crashes with `NumericOverflowError` when a part is past B128's range. With a part that is not finite it
###     crashes where the textbook formula does (`sin_textbook`).
routine C256.sin() -> Me
    if not me.is_finite()
        return me.sin_textbook()
    re: B128 = when
        me.real.is_zero() => me.real
        else => me.real.sin() *! me.imag.cosh_unchecked()
    return c256_finite(re, im: me.real.cos() *! me.imag.sinh_unchecked())

### The cosine, cos real cosh imag - i sin real sinh imag, from the correctly rounded real functions. A zero real part
### gives a zero imaginary part with the sign -real × imag has.
### :returns: The cosine.
### :throws: Crashes with `NumericOverflowError` when a part is past B128's range. With a part that is not finite it
###     crashes where the textbook formula does (`cos_textbook`).
routine C256.cos() -> Me
    if not me.is_finite()
        return me.cos_textbook()
    im: B128 = when
        me.real.is_zero() and me.imag.is_sign_negative() => me.real
        me.real.is_zero() => -me.real
        else => -(me.real.sin() *! me.imag.sinh_unchecked())
    return c256_finite(re: me.real.cos() *! me.imag.cosh_unchecked(), im)

### The hyperbolic sine, sinh real cos imag + i cosh real sin imag, from the correctly rounded real functions. Past
### the range a part is an infinity, not a crash (it is `sinh_unchecked`), and a zero imaginary part stays as it is.
### :returns: The hyperbolic sine.
### :throws: With a part that is not finite it crashes where the textbook formula does (`sinh_textbook`).
routine C256.sinh() -> Me
    if not me.is_finite()
        return me.sinh_textbook()
    im: B128 = when
        me.imag.is_zero() => me.imag
        else => me.real.cosh_unchecked() *! me.imag.sin()
    return (real: me.real.sinh_unchecked() *! me.imag.cos(), imag: im)

### The hyperbolic cosine, cosh real cos imag + i sinh real sin imag, from the correctly rounded real functions. Past
### the range a part is an infinity, not a crash (it is `cosh_unchecked`), and a zero imaginary part gives a zero
### imaginary part with the sign real × imag has.
### :returns: The hyperbolic cosine.
### :throws: With a part that is not finite it crashes where the textbook formula does (`cosh_textbook`).
routine C256.cosh() -> Me
    if not me.is_finite()
        return me.cosh_textbook()
    im: B128 = when
        me.imag.is_zero() and me.real.is_sign_negative() => -me.imag
        me.imag.is_zero() => me.imag
        else => me.real.sinh_unchecked() *! me.imag.sin()
    return (real: me.real.cosh_unchecked() *! me.imag.cos(), imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The principal square root (real part >= 0), from half the modulus plus and minus the real part. The imaginary part
### takes the sign of this imaginary part, so -0 and +0 pick the two sides of the cut along the negative reals.
### :returns: The principal square root.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C256.sqrt_textbook() -> Me
    r: B128 = me.abs()

    if r == B128_ZERO
        return (real: B128_ZERO, imag: B128_ZERO)
    rp: B128 = r.add_finite(me.real).truediv_finite(B128_TWO).sqrt_unchecked()
    ip: B128 = r.sub_finite(me.real).truediv_finite(B128_TWO).sqrt_unchecked()
    if me.imag < B128_ZERO
        return (real: rp, imag: -ip)
    return (real: rp, imag: ip)

### This number to the complex power `power`, exp(power × ln me).
### :param power: The complex exponent.
### :returns: This number to the power `power`.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.pow(power: Me) -> Me
    r: Me = (power * me.ln()).exp()
    return c256_finite(re: r.real, im: r.imag)

### This number to the integer power n, by repeated squaring: each product rounds once, with no ln and exp. A
### negative n starts from the reciprocal, and n = 0 gives 1. The base is squared once more after the last product,
### as RazorForge's loop does, so that squaring can overflow too.
### :param n: The integer exponent.
### :returns: This number to the power `n`.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C256.powi(n: S64) -> Me
    result: &Me <- Me.one()
    k: U64 = n.to_wrap[U64]()
    base: &Me <- me

    left: U64 = when
        not (n < 0) => k
        else =>
            me.reciprocal().poke_into(base)
            becomes U64.sub_wrap(0, k)

    until left2 == 0 with left2: U64 = left
        if left2 & 1 == 1
            (result.load() * base.load()).poke_into(result)
        (base.load() * base.load()).poke_into(base)
        continue with left2: left2 >> 1
    then
        return result.load()

### The number at distance r and angle theta: r cos θ + i r sin θ.
### :param r: The distance from 0.
### :param theta: The angle, in radians.
### :returns: The number r cos θ + i r sin θ.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
common routine C256.from_polar(r: B128, theta: B128) -> Me
    re: B128 = r.mul_finite(theta.cos())
    im: B128 = r.mul_finite(theta.sin())
    return (real: re, imag: im)

### The C256 whose parts' bits are given as their low and high 64 bits.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The C256 with those parts.
@inline
common routine C256.from_halves(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> Me
    re: B128 = b128_from_halves(low: real_low, high: real_high)
    im: B128 = b128_from_halves(low: imag_low, high: imag_high)
    return (real: re, imag: im)

# The exports RazorForge's C256 calls.

### The product, for C256.mul.
### :param real_low: The low 64 bits of the first number's real part.
### :param real_high: The high 64 bits of the first number's real part.
### :param imag_low: The low 64 bits of the first number's imaginary part.
### :param imag_high: The high 64 bits of the first number's imaginary part.
### :param other_real_low: The low 64 bits of the second number's real part.
### :param other_real_high: The high 64 bits of the second number's real part.
### :param other_imag_low: The low 64 bits of the second number's imaginary part.
### :param other_imag_high: The high 64 bits of the second number's imaginary part.
### :returns: The product.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_mul")
@inline
routine c256_mul(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64, other_real_low: U64,
    other_real_high: U64, other_imag_low: U64, other_imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    w: C256 = C256.from_halves(real_low: other_real_low, real_high: other_real_high,
        imag_low: other_imag_low, imag_high: other_imag_high)
    return z * w

### The quotient, for C256.truediv.
### :param real_low: The low 64 bits of the first number's real part.
### :param real_high: The high 64 bits of the first number's real part.
### :param imag_low: The low 64 bits of the first number's imaginary part.
### :param imag_high: The high 64 bits of the first number's imaginary part.
### :param other_real_low: The low 64 bits of the second number's real part.
### :param other_real_high: The high 64 bits of the second number's real part.
### :param other_imag_low: The low 64 bits of the second number's imaginary part.
### :param other_imag_high: The high 64 bits of the second number's imaginary part.
### :returns: The quotient.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN. Dividing by 0 + 0i is a `DivisionByZeroError`, and 0 / (0 + 0i) a `NumericDomainError`, as
###     with real division. A nonzero divisor whose squared modulus underflows to zero divides a nonzero value by
###     zero, a `DivisionByZeroError` too.
@export("ingrid_c256_div")
@inline
routine c256_div(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64, other_real_low: U64,
    other_real_high: U64, other_imag_low: U64, other_imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    w: C256 = C256.from_halves(real_low: other_real_low, real_high: other_real_high,
        imag_low: other_imag_low, imag_high: other_imag_high)
    return z / w

### The first number to the power of the second, for C256.pow.
### :param real_low: The low 64 bits of the first number's real part.
### :param real_high: The high 64 bits of the first number's real part.
### :param imag_low: The low 64 bits of the first number's imaginary part.
### :param imag_high: The high 64 bits of the first number's imaginary part.
### :param other_real_low: The low 64 bits of the second number's real part.
### :param other_real_high: The high 64 bits of the second number's real part.
### :param other_imag_low: The low 64 bits of the second number's imaginary part.
### :param other_imag_high: The high 64 bits of the second number's imaginary part.
### :returns: The first number to the power of the second.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_pow")
@inline
routine c256_pow(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64, other_real_low: U64,
    other_real_high: U64, other_imag_low: U64, other_imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    w: C256 = C256.from_halves(real_low: other_real_low, real_high: other_real_high,
        imag_low: other_imag_low, imag_high: other_imag_high)
    return z ** w

### The modulus of the given number, for C256.abs.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The modulus, its low 64 bits in w0 and its high 64 bits in w1.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_abs")
@inline
routine c256_abs(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> Words
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return b128_words(z.abs())

### The phase angle of the given number, for C256.arg.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The phase angle, its low 64 bits in w0 and its high 64 bits in w1.
@export("ingrid_c256_arg")
@inline
routine c256_arg(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> Words
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return b128_words(z.arg())

### The squared modulus of the given number, for C256.norm.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The squared modulus, its low 64 bits in w0 and its high 64 bits in w1.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_norm")
@inline
routine c256_norm(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> Words
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return b128_words(z.norm())

### The sine of the given number, for C256.sin.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The sine of the given number.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_sin")
@inline
routine c256_sin(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return z.sin()

### The cosine of the given number, for C256.cos.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The cosine of the given number.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_cos")
@inline
routine c256_cos(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return z.cos()

### The tangent of the given number, for C256.tan.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The tangent of the given number.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
@export("ingrid_c256_tan")
@inline
routine c256_tan(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return z.tan()

### The arcsine of the given number, for C256.asin.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The arcsine of the given number.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_asin")
@inline
routine c256_asin(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return z.asin()

### The arccosine of the given number, for C256.acos.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The arccosine of the given number.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_acos")
@inline
routine c256_acos(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return z.acos()

