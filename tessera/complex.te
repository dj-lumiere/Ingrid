### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c64_from_polar")
@inline
routine c64_from_polar(r: B32, theta: B32) -> U64
    return C64.from_polar(r, theta).bits()

# ── C128 ──────────────────────────────────────────────────────────────────────────

### RazorForge's C128: a complex number over B64, RazorForge's B64.
record C128
obeys Addable[C128], Subtractable[C128], Multiplicable[C128], Divisible[C128], Exponentiable[C128]
    real: B64
    imag: B64

### 1 + 0i.
### :returns: 1 + 0i.
@inline
common routine C128.one() -> Me
    return (real: 1.0, imag: 0.0)

### The sum, part by part.
### :param other: The number to add.
### :returns: The sum.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@inline
routine C128.add(other: Me) -> Me
    re: B64 = me.real.add_finite(other.real)
    im: B64 = me.imag.add_finite(other.imag)
    return (real: re, imag: im)

### The difference, part by part.
### :param other: The number to subtract.
### :returns: The difference.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@inline
routine C128.sub(other: Me) -> Me
    re: B64 = me.real.sub_finite(other.real)
    im: B64 = me.imag.sub_finite(other.imag)
    return (real: re, imag: im)

### The product (ac - bd) + (ad + bc)i.
### :param other: The number to multiply by.
### :returns: The product.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.mul(other: Me) -> Me
    ac: B64 = me.real.mul_finite(other.real)
    bd: B64 = me.imag.mul_finite(other.imag)
    re: B64 = ac.sub_finite(bd)
    ad: B64 = me.real.mul_finite(other.imag)
    bc: B64 = me.imag.mul_finite(other.real)
    im: B64 = ad.add_finite(bc)
    return (real: re, imag: im)

### The quotient: me times the conjugate of other, over other's squared modulus.
### :param other: The divisor.
### :returns: The quotient.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN. Dividing by 0 + 0i is a `DivisionByZeroError`, and 0 / (0 + 0i) a `NumericDomainError`, as
###     with real division. A nonzero divisor whose squared modulus underflows to zero divides a nonzero value by
###     zero, a `DivisionByZeroError` too.
routine C128.truediv(other: Me) -> Me
    if other.is_zero()
        crash_zero_divisor(me.is_zero())
    d: B64 = other.norm()
    ac: B64 = me.real.mul_finite(other.real)
    bd: B64 = me.imag.mul_finite(other.imag)
    re: B64 = ac.add_finite(bd).truediv_finite(d)
    bc: B64 = me.imag.mul_finite(other.real)
    ad: B64 = me.real.mul_finite(other.imag)
    im: B64 = bc.sub_finite(ad).truediv_finite(d)
    return (real: re, imag: im)

### Whether both parts are zero (+0 or -0).
### :returns: True for 0 + 0i.
@inline
routine C128.is_zero() -> Bool
    return me.real == 0.0 and me.imag == 0.0

### The squared modulus real² + imag².
### :returns: The squared modulus.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.norm() -> B64
    rr: B64 = me.real.mul_finite(me.real)
    ii: B64 = me.imag.mul_finite(me.imag)
    return rr.add_finite(ii)

### The modulus, the square root of the squared modulus.
### :returns: The modulus.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.abs() -> B64
    return me.norm().sqrt()

### The phase angle atan2(imag, real), in (-π, π].
### :returns: The phase angle.
routine C128.arg() -> B64
    return atan2(y: me.imag, x: me.real)

### The sine, sin a cosh b + i cos a sinh b, with cosh and sinh from e^b and e^-b.
### :returns: The sine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.sin() -> Me
    ep: B64 = me.imag.exp()
    em: B64 = (-me.imag).exp()
    ch: B64 = ep.add_finite(em).truediv_finite(2.0)
    sh: B64 = ep.sub_finite(em).truediv_finite(2.0)
    re: B64 = me.real.sin().mul_finite(ch)
    im: B64 = me.real.cos().mul_finite(sh)
    return (real: re, imag: im)

### The cosine, cos a cosh b - i sin a sinh b, with cosh and sinh from e^b and e^-b.
### :returns: The cosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.cos() -> Me
    ep: B64 = me.imag.exp()
    em: B64 = (-me.imag).exp()
    ch: B64 = ep.add_finite(em).truediv_finite(2.0)
    sh: B64 = ep.sub_finite(em).truediv_finite(2.0)
    re: B64 = me.real.cos().mul_finite(ch)
    im: B64 = -me.real.sin().mul_finite(sh)
    return (real: re, imag: im)

### The tangent, (sin 2a + i sinh 2b) / (cos 2a + cosh 2b).
### :returns: The tangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C128.tan() -> Me
    a2: B64 = me.real.add_finite(me.real)
    b2: B64 = me.imag.add_finite(me.imag)
    ep: B64 = b2.exp()
    em: B64 = (-b2).exp()
    ca: B64 = a2.cos()
    ch: B64 = ep.add_finite(em).truediv_finite(2.0)
    d: B64 = ca.add_finite(ch)
    re: B64 = a2.sin().truediv_finite(d)
    sh: B64 = ep.sub_finite(em).truediv_finite(2.0)
    im: B64 = sh.truediv_finite(d)
    return (real: re, imag: im)

### The arcsine, -i log(iz + √(1 - z²)).
### :returns: The arcsine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.asin() -> Me
    iz: Me = (real: -me.imag, imag: me.real)
    zz: Me = me * me
    s: Me = (Me.one() - zz).sqrt()
    v: Me = (iz + s).ln()
    return (real: v.imag, imag: -v.real)

### The arccosine, -i log(z + i √(1 - z²)).
### :returns: The arccosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.acos() -> Me
    zz: Me = me * me
    s: Me = (Me.one() - zz).sqrt()
    `is`: Me = (real: -s.imag, imag: s.real)
    v: Me = (me + `is`).ln()
    return (real: v.imag, imag: -v.real)

### The arctangent, (i/2) log((i + z) / (i - z)).
### :returns: The arctangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C128.atan() -> Me
    num_imag: B64 = me.imag.add_finite(1.0)
    den_imag: B64 = B64.sub_finite(1.0, me.imag)
    num: Me = (real: me.real, imag: num_imag)
    den: Me = (real: -me.real, imag: den_imag)
    v: Me = (num / den).ln()
    re: B64 = (-v.imag).truediv_finite(2.0)
    im: B64 = v.real.truediv_finite(2.0)
    return (real: re, imag: im)

### The hyperbolic sine, sinh a cos b + i cosh a sin b, with sinh and cosh from e^a and e^-a.
### :returns: The hyperbolic sine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.sinh() -> Me
    ep: B64 = me.real.exp()
    em: B64 = (-me.real).exp()
    sh: B64 = ep.sub_finite(em).truediv_finite(2.0)
    ch: B64 = ep.add_finite(em).truediv_finite(2.0)
    re: B64 = sh.mul_finite(me.imag.cos())
    im: B64 = ch.mul_finite(me.imag.sin())
    return (real: re, imag: im)

### The hyperbolic cosine, cosh a cos b + i sinh a sin b, with sinh and cosh from e^a and e^-a.
### :returns: The hyperbolic cosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.cosh() -> Me
    ep: B64 = me.real.exp()
    em: B64 = (-me.real).exp()
    sh: B64 = ep.sub_finite(em).truediv_finite(2.0)
    ch: B64 = ep.add_finite(em).truediv_finite(2.0)
    re: B64 = ch.mul_finite(me.imag.cos())
    im: B64 = sh.mul_finite(me.imag.sin())
    return (real: re, imag: im)

### The hyperbolic tangent, (sinh 2a + i sin 2b) / (cosh 2a + cos 2b).
### :returns: The hyperbolic tangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C128.tanh() -> Me
    a2: B64 = me.real.add_finite(me.real)
    b2: B64 = me.imag.add_finite(me.imag)
    ep: B64 = a2.exp()
    em: B64 = (-a2).exp()
    ch: B64 = ep.add_finite(em).truediv_finite(2.0)
    d: B64 = ch.add_finite(b2.cos())
    sh: B64 = ep.sub_finite(em).truediv_finite(2.0)
    re: B64 = sh.truediv_finite(d)
    im: B64 = b2.sin().truediv_finite(d)
    return (real: re, imag: im)

### The inverse hyperbolic sine, log(z + √(z² + 1)).
### :returns: The inverse hyperbolic sine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.asinh() -> Me
    zz: Me = me * me
    s: Me = (zz + Me.one()).sqrt()
    return (me + s).ln()

### The inverse hyperbolic cosine, log(z + √(z² - 1)).
### :returns: The inverse hyperbolic cosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.acosh() -> Me
    zz: Me = me * me
    s: Me = (zz - Me.one()).sqrt()
    return (me + s).ln()

### The inverse hyperbolic tangent, log((1 + z) / (1 - z)) / 2.
### :returns: The inverse hyperbolic tangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C128.atanh() -> Me
    p: Me = Me.one() + me
    m: Me = Me.one() - me
    v: Me = (p / m).ln()
    re: B64 = v.real.truediv_finite(2.0)
    im: B64 = v.imag.truediv_finite(2.0)
    return (real: re, imag: im)

### e to this power, eᵃ (cos b + i sin b).
### :returns: e to this power.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.exp() -> Me
    ea: B64 = me.real.exp()
    re: B64 = ea.mul_finite(me.imag.cos())
    im: B64 = ea.mul_finite(me.imag.sin())
    return (real: re, imag: im)

### The principal natural logarithm, ln |z| + i arg z.
### :returns: The principal natural logarithm.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.ln() -> Me
    re: B64 = me.abs().ln()
    return (real: re, imag: me.arg())

### The base-10 logarithm, ln z / ln 10.
### :returns: The base-10 logarithm.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.log10() -> Me
    v: Me = me.ln()
    re: B64 = v.real.truediv_finite(C128_LN_10)
    im: B64 = v.imag.truediv_finite(C128_LN_10)
    return (real: re, imag: im)

### The base-2 logarithm, ln z / ln 2.
### :returns: The base-2 logarithm.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.log2() -> Me
    v: Me = me.ln()
    re: B64 = v.real.truediv_finite(C128_LN_2)
    im: B64 = v.imag.truediv_finite(C128_LN_2)
    return (real: re, imag: im)

### 1 / z, the conjugate over the squared modulus.
### :returns: 1 / z.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN. The reciprocal of 0 + 0i is 1 / 0, a `DivisionByZeroError`, as with real division. A
###     squared modulus that underflows to zero divides a nonzero value by zero, a `DivisionByZeroError` too.
routine C128.reciprocal() -> Me
    if me.is_zero()
        crash_division_by_zero()
    d: B64 = me.norm()
    re: B64 = me.real.truediv_finite(d)
    im: B64 = (-me.imag).truediv_finite(d)
    return (real: re, imag: im)

### The principal square root (real part >= 0), from half the modulus plus and minus the real part. The imaginary part
### takes the sign of this imaginary part, so -0 and +0 pick the two sides of the cut along the negative reals.
### :returns: The principal square root.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.sqrt() -> Me
    local r: B64 = me.abs()

    if r == 0.0
        return (real: 0.0, imag: 0.0)
    rp: B64 = r.add_finite(me.real).truediv_finite(2.0).sqrt()
    ip: B64 = r.sub_finite(me.real).truediv_finite(2.0).sqrt()
    if me.imag < 0.0
        return (real: rp, imag: -ip)
    return (real: rp, imag: ip)

### This number to the complex power `power`, exp(power × ln me).
### :param power: The complex exponent.
### :returns: This number to the power `power`.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.pow(power: Me) -> Me
    return (power * me.ln()).exp()

### This number to the integer power n, by repeated squaring: each product rounds once, with no ln and exp. A
### negative n starts from the reciprocal, and n = 0 gives 1. The base is squared once more after the last product,
### as RazorForge's loop does, so that squaring can overflow too.
### :param n: The integer exponent.
### :returns: This number to the power `n`.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C128.powi(n: S64) -> Me
    local result: @Me <- Me.one()
    local k: U64 = n.to_wrap[U64]()
    local base: @Me <- me

    left: U64 = when
        not (n < 0) => k
        else =>
            me.reciprocal().poke_into(base)
            becomes U64.sub_wrap(0, k)

    while left2 != 0 with left2: U64 = left
        if left2 & 1 == 1
            (result.peek() * base.peek()).poke_into(result)
        (base.peek() * base.peek()).poke_into(base)
        continue with left2: left2 >> 1
    then
        return result.peek()

### The number at distance r and angle theta: r cos θ + i r sin θ.
### :param r: The distance from 0.
### :param theta: The angle, in radians.
### :returns: The number r cos θ + i r sin θ.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
common routine C128.from_polar(r: B64, theta: B64) -> Me
    re: B64 = r.mul_finite(theta.cos())
    im: B64 = r.mul_finite(theta.sin())
    return (real: re, imag: im)

### Both parts in Words, the way an export hands a C128 back: the real part's bits in w0, the imaginary part's in w1.
### :returns: The real part in w0, the imaginary part in w1, and zero in w2 and w3.
@inline
routine C128.words() -> Words
    return Words.construct(a: me.real, b: me.imag, c: 0.0, d: 0.0)

# The exports RazorForge's C128 calls.

### The product, for C128.mul.
### :param real: The first number's real part.
### :param imag: The first number's imaginary part.
### :param other_real: The second number's real part.
### :param other_imag: The second number's imaginary part.
### :returns: The result's real part in w0, its imaginary part in w1, and zero in w2 and w3.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c128_mul")
@inline
routine c128_mul(real: B64, imag: B64, other_real: B64, other_imag: B64) -> Words
    z: C128 = (real: real, imag: imag)
    w: C128 = (real: other_real, imag: other_imag)
    return (z * w).words()

### The quotient, for C128.truediv.
### :param real: The first number's real part.
### :param imag: The first number's imaginary part.
### :param other_real: The second number's real part.
### :param other_imag: The second number's imaginary part.
### :returns: The result's real part in w0, its imaginary part in w1, and zero in w2 and w3.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN. Dividing by 0 + 0i is a `DivisionByZeroError`, and 0 / (0 + 0i) a `NumericDomainError`, as
###     with real division. A nonzero divisor whose squared modulus underflows to zero divides a nonzero value by
###     zero, a `DivisionByZeroError` too.
@export("ingrid_c128_div")
@inline
routine c128_div(real: B64, imag: B64, other_real: B64, other_imag: B64) -> Words
    z: C128 = (real: real, imag: imag)
    w: C128 = (real: other_real, imag: other_imag)
    return (z / w).words()

### The first number to the power of the second, for C128.pow.
### :param real: The first number's real part.
### :param imag: The first number's imaginary part.
### :param other_real: The second number's real part.
### :param other_imag: The second number's imaginary part.
### :returns: The result's real part in w0, its imaginary part in w1, and zero in w2 and w3.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c128_pow")
@inline
routine c128_pow(real: B64, imag: B64, other_real: B64, other_imag: B64) -> Words
    z: C128 = (real: real, imag: imag)
    w: C128 = (real: other_real, imag: other_imag)
    return (z ** w).words()

### The modulus of the given number, for C128.abs.
### :param real: The real part.
### :param imag: The imaginary part.
### :returns: The modulus.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c128_abs")
@inline
routine c128_abs(real: B64, imag: B64) -> B64
    z: C128 = (real: real, imag: imag)
