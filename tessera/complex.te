### The inverse hyperbolic cosine of the given number, for C256.acosh.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The inverse hyperbolic cosine of the given number.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_acosh")
@inline
routine c256_acosh(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return z.acosh()

### The inverse hyperbolic tangent of the given number, for C256.atanh.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The inverse hyperbolic tangent of the given number.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
@export("ingrid_c256_atanh")
@inline
routine c256_atanh(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return z.atanh()

### e to the power of the given number, for C256.exp.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: e to the power of the given number.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_exp")
@inline
routine c256_exp(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return z.exp()

### The principal natural logarithm of the given number, for C256.ln.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The principal natural logarithm of the given number.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_ln")
@inline
routine c256_ln(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return z.ln()

### The base-10 logarithm of the given number, for C256.log10.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
