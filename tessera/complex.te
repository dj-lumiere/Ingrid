@export("ingrid_c256_log10")
@inline
routine c256_log10(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return z.log10()

### The base-2 logarithm of the given number, for C256.log2.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The base-2 logarithm of the given number.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_log2")
@inline
routine c256_log2(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return z.log2()

### The reciprocal of the given number, for C256.reciprocal.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The reciprocal of the given number.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN. The reciprocal of 0 + 0i is 1 / 0, a `DivisionByZeroError`, as with real division. A
###     squared modulus that underflows to zero divides a nonzero value by zero, a `DivisionByZeroError` too.
@export("ingrid_c256_reciprocal")
@inline
routine c256_reciprocal(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return z.reciprocal()

### The principal square root of the given number, for C256.sqrt.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The principal square root of the given number.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_sqrt")
@inline
routine c256_sqrt(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return z.sqrt()

### C256 to an integer power.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :param n: The integer exponent.
### :returns: The number to the power `n`.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
@export("ingrid_c256_powi")
@inline
routine c256_powi(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64, n: S64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return z.powi(n)

### The C256 at distance r and angle theta.
### :param r_low: The low 64 bits of the distance.
### :param r_high: The high 64 bits of the distance.
### :param theta_low: The low 64 bits of the angle.
### :param theta_high: The high 64 bits of the angle.
### :returns: The number r cos θ + i r sin θ.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_from_polar")
@inline
routine c256_from_polar(r_low: U64, r_high: U64, theta_low: U64, theta_high: U64) -> C256
    return C256.from_polar(r: b128_from_halves(low: r_low, high: r_high),
        theta: b128_from_halves(low: theta_low, high: theta_high))
