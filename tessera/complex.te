# ── C256 ──────────────────────────────────────────────────────────────────────────

### RazorForge's C256: a complex number over B128, RazorForge's B128.
record C256
obeys Addable[C256], Subtractable[C256], Multiplicable[C256], Divisible[C256], Exponentiable[C256]
    real: B128
    imag: B128

### 1 + 0i.
### :returns: 1 + 0i.
@inline
common routine C256.one() -> Me
    return (real: B128_ONE, imag: B128_ZERO)

### The sum, part by part.
### :param other: The number to add.
### :returns: The sum.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@inline
routine C256.add(other: Me) -> Me
    re: B128 = me.real.add_finite(other.real)
    im: B128 = me.imag.add_finite(other.imag)
    return (real: re, imag: im)

### The difference, part by part.
### :param other: The number to subtract.
### :returns: The difference.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@inline
routine C256.sub(other: Me) -> Me
    re: B128 = me.real.sub_finite(other.real)
    im: B128 = me.imag.sub_finite(other.imag)
    return (real: re, imag: im)

### The product (ac - bd) + (ad + bc)i.
### :param other: The number to multiply by.
### :returns: The product.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.mul(other: Me) -> Me
    ac: B128 = me.real.mul_finite(other.real)
    bd: B128 = me.imag.mul_finite(other.imag)
    re: B128 = ac.sub_finite(bd)
    ad: B128 = me.real.mul_finite(other.imag)
    bc: B128 = me.imag.mul_finite(other.real)
    im: B128 = ad.add_finite(bc)
    return (real: re, imag: im)

### The quotient: me times the conjugate of other, over other's squared modulus.
### :param other: The divisor.
### :returns: The quotient.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN. Dividing by 0 + 0i is a `DivisionByZeroError`, and 0 / (0 + 0i) a `NumericDomainError`, as
###     with real division. A nonzero divisor whose squared modulus underflows to zero divides a nonzero value by
###     zero, a `DivisionByZeroError` too.
routine C256.truediv(other: Me) -> Me
    if other.is_zero()
        crash_zero_divisor(me.is_zero())
    d: B128 = other.norm()
    ac: B128 = me.real.mul_finite(other.real)
    bd: B128 = me.imag.mul_finite(other.imag)
    re: B128 = ac.add_finite(bd).truediv_finite(d)
    bc: B128 = me.imag.mul_finite(other.real)
    ad: B128 = me.real.mul_finite(other.imag)
    im: B128 = bc.sub_finite(ad).truediv_finite(d)
    return (real: re, imag: im)

### Whether both parts are zero (+0 or -0).
### :returns: True for 0 + 0i.
@inline
routine C256.is_zero() -> Bool
    return me.real.is_zero() and me.imag.is_zero()

### The squared modulus real² + imag².
### :returns: The squared modulus.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.norm() -> B128
    rr: B128 = me.real.mul_finite(me.real)
    ii: B128 = me.imag.mul_finite(me.imag)
    return rr.add_finite(ii)

### The modulus, the square root of the squared modulus.
### :returns: The modulus.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.abs() -> B128
    return me.norm().sqrt()

### The phase angle atan2(imag, real), in (-π, π].
### :returns: The phase angle.
routine C256.arg() -> B128
    return atan2(y: me.imag, x: me.real)

### The sine, sin a cosh b + i cos a sinh b.
### :returns: The sine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.sin() -> Me
    re: B128 = me.real.sin().mul_finite(me.imag.cosh())
    im: B128 = me.real.cos().mul_finite(me.imag.sinh())
    return (real: re, imag: im)

### The cosine, cos a cosh b - i sin a sinh b.
### :returns: The cosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.cos() -> Me
    re: B128 = me.real.cos().mul_finite(me.imag.cosh())
    im: B128 = -me.real.sin().mul_finite(me.imag.sinh())
    return (real: re, imag: im)

### The tangent, (sin 2a + i sinh 2b) / (cos 2a + cosh 2b).
### :returns: The tangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C256.tan() -> Me
    a2: B128 = me.real.add_finite(me.real)
    b2: B128 = me.imag.add_finite(me.imag)
    d: B128 = a2.cos().add_finite(b2.cosh())
    re: B128 = a2.sin().truediv_finite(d)
    im: B128 = b2.sinh().truediv_finite(d)
    return (real: re, imag: im)

### The arcsine, -i log(iz + √(1 - z²)).
### :returns: The arcsine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.asin() -> Me
    iz: Me = (real: -me.imag, imag: me.real)
    zz: Me = me * me
    s: Me = (Me.one() - zz).sqrt()
    v: Me = (iz + s).ln()
    return (real: v.imag, imag: -v.real)

### The arccosine, -i log(z + i √(1 - z²)).
### :returns: The arccosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.acos() -> Me
    zz: Me = me * me
    s: Me = (Me.one() - zz).sqrt()
    `is`: Me = (real: -s.imag, imag: s.real)
    v: Me = (me + `is`).ln()
    return (real: v.imag, imag: -v.real)

### The arctangent, (i/2) log((i + z) / (i - z)).
### :returns: The arctangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C256.atan() -> Me
    num_imag: B128 = me.imag.add_finite(B128_ONE)
    den_imag: B128 = B128.sub_finite(B128_ONE, me.imag)
    num: Me = (real: me.real, imag: num_imag)
    den: Me = (real: -me.real, imag: den_imag)
    v: Me = (num / den).ln()
    re: B128 = (-v.imag).truediv_finite(B128_TWO)
    im: B128 = v.real.truediv_finite(B128_TWO)
    return (real: re, imag: im)

### The hyperbolic sine, sinh a cos b + i cosh a sin b.
### :returns: The hyperbolic sine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.sinh() -> Me
    re: B128 = me.real.sinh().mul_finite(me.imag.cos())
    im: B128 = me.real.cosh().mul_finite(me.imag.sin())
    return (real: re, imag: im)

### The hyperbolic cosine, cosh a cos b + i sinh a sin b.
### :returns: The hyperbolic cosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.cosh() -> Me
    re: B128 = me.real.cosh().mul_finite(me.imag.cos())
    im: B128 = me.real.sinh().mul_finite(me.imag.sin())
    return (real: re, imag: im)

### The hyperbolic tangent, (sinh 2a + i sin 2b) / (cosh 2a + cos 2b).
### :returns: The hyperbolic tangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C256.tanh() -> Me
    a2: B128 = me.real.add_finite(me.real)
    b2: B128 = me.imag.add_finite(me.imag)
    d: B128 = a2.cosh().add_finite(b2.cos())
    re: B128 = a2.sinh().truediv_finite(d)
    im: B128 = b2.sin().truediv_finite(d)
    return (real: re, imag: im)

### The inverse hyperbolic sine, log(z + √(z² + 1)).
### :returns: The inverse hyperbolic sine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.asinh() -> Me
    zz: Me = me * me
    s: Me = (zz + Me.one()).sqrt()
    return (me + s).ln()

### The inverse hyperbolic cosine, log(z + √(z² - 1)).
### :returns: The inverse hyperbolic cosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.acosh() -> Me
    zz: Me = me * me
    s: Me = (zz - Me.one()).sqrt()
    return (me + s).ln()

### The inverse hyperbolic tangent, log((1 + z) / (1 - z)) / 2.
### :returns: The inverse hyperbolic tangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C256.atanh() -> Me
    p: Me = Me.one() + me
    m: Me = Me.one() - me
    v: Me = (p / m).ln()
    re: B128 = v.real.truediv_finite(B128_TWO)
    im: B128 = v.imag.truediv_finite(B128_TWO)
    return (real: re, imag: im)

### e to this power, eᵃ (cos b + i sin b).
### :returns: e to this power.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.exp() -> Me
    ea: B128 = me.real.exp()
    re: B128 = ea.mul_finite(me.imag.cos())
    im: B128 = ea.mul_finite(me.imag.sin())
    return (real: re, imag: im)

### The principal natural logarithm, ln |z| + i arg z.
### :returns: The principal natural logarithm.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.ln() -> Me
    re: B128 = me.abs().ln()
    return (real: re, imag: me.arg())

### The base-10 logarithm, ln z / ln 10.
### :returns: The base-10 logarithm.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.log10() -> Me
    v: Me = me.ln()
    re: B128 = v.real.truediv_finite(C256_LN_10)
    im: B128 = v.imag.truediv_finite(C256_LN_10)
    return (real: re, imag: im)

### The base-2 logarithm, ln z / ln 2.
### :returns: The base-2 logarithm.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.log2() -> Me
    v: Me = me.ln()
    re: B128 = v.real.truediv_finite(C256_LN_2)
    im: B128 = v.imag.truediv_finite(C256_LN_2)
    return (real: re, imag: im)

### 1 / z, the conjugate over the squared modulus.
### :returns: 1 / z.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN. The reciprocal of 0 + 0i is 1 / 0, a `DivisionByZeroError`, as with real division. A
###     squared modulus that underflows to zero divides a nonzero value by zero, a `DivisionByZeroError` too.
routine C256.reciprocal() -> Me
    if me.is_zero()
        crash_division_by_zero()
    d: B128 = me.norm()
    re: B128 = me.real.truediv_finite(d)
    im: B128 = (-me.imag).truediv_finite(d)
    return (real: re, imag: im)

### The principal square root (real part >= 0), from half the modulus plus and minus the real part. The imaginary part
### takes the sign of this imaginary part, so -0 and +0 pick the two sides of the cut along the negative reals.
### :returns: The principal square root.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.sqrt() -> Me
    local r: B128 = me.abs()

    if r == B128_ZERO
        return (real: B128_ZERO, imag: B128_ZERO)
    rp: B128 = r.add_finite(me.real).truediv_finite(B128_TWO).sqrt()
    ip: B128 = r.sub_finite(me.real).truediv_finite(B128_TWO).sqrt()
    if me.imag < B128_ZERO
        return (real: rp, imag: -ip)
    return (real: rp, imag: ip)

### This number to the complex power `power`, exp(power × ln me).
### :param power: The complex exponent.
### :returns: This number to the power `power`.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C256.pow(power: Me) -> Me
    return (power * me.ln()).exp()

### This number to the integer power n, by repeated squaring: each product rounds once, with no ln and exp. A
### negative n starts from the reciprocal, and n = 0 gives 1. The base is squared once more after the last product,
### as RazorForge's loop does, so that squaring can overflow too.
### :param n: The integer exponent.
### :returns: This number to the power `n`.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C256.powi(n: S64) -> Me
    local result: @Me <- Me.one()
    local k: U64 = n.to_wrap[U64]()
    local base: @Me <- me

    left: U64 = when
        not (n < 0) => k
        else =>
            me.reciprocal().poke_into(base)
            becomes U64.sub_wrap(0, k)

    while left2 != 0 with left2: U64 = left
        if left2 & 1 == 1
            (result.peek() * base.peek()).poke_into(result)
        (base.peek() * base.peek()).poke_into(base)
        continue with left2: left2 >> 1
    then
        return result.peek()

### The number at distance r and angle theta: r cos θ + i r sin θ.
### :param r: The distance from 0.
### :param theta: The angle, in radians.
### :returns: The number r cos θ + i r sin θ.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
common routine C256.from_polar(r: B128, theta: B128) -> Me
    re: B128 = r.mul_finite(theta.cos())
    im: B128 = r.mul_finite(theta.sin())
    return (real: re, imag: im)

### The C256 whose parts' bits are given as their low and high 64 bits.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The C256 with those parts.
@inline
common routine C256.from_halves(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> Me
    re: B128 = b128_from_halves(low: real_low, high: real_high)
    im: B128 = b128_from_halves(low: imag_low, high: imag_high)
    return (real: re, imag: im)

# The exports RazorForge's C256 calls.

### The product, for C256.mul.
### :param real_low: The low 64 bits of the first number's real part.
### :param real_high: The high 64 bits of the first number's real part.
### :param imag_low: The low 64 bits of the first number's imaginary part.
### :param imag_high: The high 64 bits of the first number's imaginary part.
### :param other_real_low: The low 64 bits of the second number's real part.
### :param other_real_high: The high 64 bits of the second number's real part.
### :param other_imag_low: The low 64 bits of the second number's imaginary part.
### :param other_imag_high: The high 64 bits of the second number's imaginary part.
### :returns: The product.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_mul")
@inline
routine c256_mul(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64, other_real_low: U64,
    other_real_high: U64, other_imag_low: U64, other_imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    w: C256 = C256.from_halves(real_low: other_real_low, real_high: other_real_high,
        imag_low: other_imag_low, imag_high: other_imag_high)
    return z * w

### The quotient, for C256.truediv.
### :param real_low: The low 64 bits of the first number's real part.
### :param real_high: The high 64 bits of the first number's real part.
### :param imag_low: The low 64 bits of the first number's imaginary part.
### :param imag_high: The high 64 bits of the first number's imaginary part.
### :param other_real_low: The low 64 bits of the second number's real part.
### :param other_real_high: The high 64 bits of the second number's real part.
### :param other_imag_low: The low 64 bits of the second number's imaginary part.
### :param other_imag_high: The high 64 bits of the second number's imaginary part.
### :returns: The quotient.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN. Dividing by 0 + 0i is a `DivisionByZeroError`, and 0 / (0 + 0i) a `NumericDomainError`, as
###     with real division. A nonzero divisor whose squared modulus underflows to zero divides a nonzero value by
###     zero, a `DivisionByZeroError` too.
@export("ingrid_c256_div")
@inline
routine c256_div(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64, other_real_low: U64,
    other_real_high: U64, other_imag_low: U64, other_imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    w: C256 = C256.from_halves(real_low: other_real_low, real_high: other_real_high,
        imag_low: other_imag_low, imag_high: other_imag_high)
    return z / w

### The first number to the power of the second, for C256.pow.
### :param real_low: The low 64 bits of the first number's real part.
### :param real_high: The high 64 bits of the first number's real part.
### :param imag_low: The low 64 bits of the first number's imaginary part.
### :param imag_high: The high 64 bits of the first number's imaginary part.
### :param other_real_low: The low 64 bits of the second number's real part.
### :param other_real_high: The high 64 bits of the second number's real part.
### :param other_imag_low: The low 64 bits of the second number's imaginary part.
### :param other_imag_high: The high 64 bits of the second number's imaginary part.
### :returns: The first number to the power of the second.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_pow")
@inline
routine c256_pow(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64, other_real_low: U64,
    other_real_high: U64, other_imag_low: U64, other_imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    w: C256 = C256.from_halves(real_low: other_real_low, real_high: other_real_high,
        imag_low: other_imag_low, imag_high: other_imag_high)
    return z ** w

### The modulus of the given number, for C256.abs.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The modulus, its low 64 bits in w0 and its high 64 bits in w1.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_abs")
@inline
routine c256_abs(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> Words
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return b128_words(z.abs())

### The phase angle of the given number, for C256.arg.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The phase angle, its low 64 bits in w0 and its high 64 bits in w1.
@export("ingrid_c256_arg")
@inline
routine c256_arg(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> Words
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return b128_words(z.arg())

### The squared modulus of the given number, for C256.norm.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The squared modulus, its low 64 bits in w0 and its high 64 bits in w1.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_norm")
@inline
routine c256_norm(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> Words
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return b128_words(z.norm())

### The sine of the given number, for C256.sin.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
### :returns: The sine of the given number.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c256_sin")
@inline
routine c256_sin(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> C256
    z: C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
    return z.sin()

### The cosine of the given number, for C256.cos.
### :param real_low: The low 64 bits of the real part.
### :param real_high: The high 64 bits of the real part.
### :param imag_low: The low 64 bits of the imaginary part.
### :param imag_high: The high 64 bits of the imaginary part.
