# RazorForge's complex numbers C64, C128, and C256 (over B32, B64, and B128, which are Tessera's B32, B64, and B128):
# the bodies of their routines, moved here from RazorForge's Core/Numerics/C64.rf, C128.rf, and C256.rf. RazorForge
# keeps the types, their protocols, and thin routines that call the ingrid_ exports below, so both languages share
# one implementation.
#
# The formulas are RazorForge's own, unchanged, so every result has the same bits as before: the textbook
# identities, with no rescaling against overflow. Each `+ - * /` is the checked one (finite.te), which crashes on
# a result that is not finite exactly where RazorForge's B32, B64, and B128 operators do, and the elementary
# functions are the standard library's correctly rounded ones (CORE-MATH ports), as RazorForge's are.
#
# The exports take each part as its own float, except a C256's: a B128 is a 128-bit integer to the C ABI, which
# Win64 passes by pointer from Tessera and by value from RazorForge, so each part goes in as its low and high 64
# bits, and a B128 result comes back in Words. A C64 result comes back packed in one U64 (the real part's bits
# low, the imaginary part's high), a C128 result in Words (words.te), and a C256 result as itself: 32 bytes of
# 128-bit integers to both builders, which every target returns through a hidden pointer.

### The B128 constants the C256 formulas use.
secret preset B128_ZERO: B128 = B128.from_bits(0)
secret preset B128_ONE:  B128 = B128.from_bits(0x3FFF0000000000000000000000000000)
secret preset B128_TWO:  B128 = B128.from_bits(0x40000000000000000000000000000000)

### ln 10 and ln 2 as each RazorForge type spells them: B32_LN_10 and B32_LN_2, the B64 literal 2.302585092994046 and
### B64_LN_2, B128_LN_10 and B128_LN_2.
secret preset C64_LN_10:  B32  = B32.from_bits(0x40135D8E)
secret preset C64_LN_2:   B32  = B32.from_bits(0x3F317218)
secret preset C128_LN_10: B64  = B64.from_bits(0x40026BB1BBB55516)
secret preset C128_LN_2:  B64  = B64.from_bits(0x3FE62E42FEFA39EF)
secret preset C256_LN_10: B128 = B128.from_bits(0x400026BB1BBB5551582DD4ADAC5705A6)
secret preset C256_LN_2:  B128 = B128.from_bits(0x3FFE62E42FEFA39EF35793C7673007E6)

# ── C64 ──────────────────────────────────────────────────────────────────────────

### RazorForge's C64: a complex number over B32, RazorForge's B32.
record C64
obeys Addable[C64], Subtractable[C64], Multiplicable[C64], Divisible[C64], Exponentiable[C64]
    real: B32
    imag: B32

### 1 + 0i.
### :returns: 1 + 0i.
@inline
common routine C64.one() -> Me
    return (real: 1.0, imag: 0.0)

### The sum, part by part.
### :param other: The number to add.
### :returns: The sum.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@inline
routine C64.add(other: Me) -> Me
    re: B32 = me.real.add_finite(other.real)
    im: B32 = me.imag.add_finite(other.imag)
    return (real: re, imag: im)

### The difference, part by part.
### :param other: The number to subtract.
### :returns: The difference.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@inline
routine C64.sub(other: Me) -> Me
    re: B32 = me.real.sub_finite(other.real)
    im: B32 = me.imag.sub_finite(other.imag)
    return (real: re, imag: im)

### The product (ac - bd) + (ad + bc)i.
### :param other: The number to multiply by.
### :returns: The product.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.mul(other: Me) -> Me
    ac: B32 = me.real.mul_finite(other.real)
    bd: B32 = me.imag.mul_finite(other.imag)
    re: B32 = ac.sub_finite(bd)
    ad: B32 = me.real.mul_finite(other.imag)
    bc: B32 = me.imag.mul_finite(other.real)
    im: B32 = ad.add_finite(bc)
    return (real: re, imag: im)

### The quotient: me times the conjugate of other, over other's squared modulus.
### :param other: The divisor.
### :returns: The quotient.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN. Dividing by 0 + 0i is a `DivisionByZeroError`, and 0 / (0 + 0i) a `NumericDomainError`, as
###     with real division. A nonzero divisor whose squared modulus underflows to zero divides a nonzero value by
###     zero, a `DivisionByZeroError` too.
routine C64.truediv(other: Me) -> Me
    if other.is_zero()
        crash_zero_divisor(me.is_zero())
    d: B32 = other.norm()
    ac: B32 = me.real.mul_finite(other.real)
    bd: B32 = me.imag.mul_finite(other.imag)
    re: B32 = ac.add_finite(bd).truediv_finite(d)
    bc: B32 = me.imag.mul_finite(other.real)
    ad: B32 = me.real.mul_finite(other.imag)
    im: B32 = bc.sub_finite(ad).truediv_finite(d)
    return (real: re, imag: im)

### Whether both parts are zero (+0 or -0).
### :returns: True for 0 + 0i.
@inline
routine C64.is_zero() -> Bool
    return me.real == 0.0 and me.imag == 0.0

### The squared modulus real² + imag².
### :returns: The squared modulus.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.norm() -> B32
    rr: B32 = me.real.mul_finite(me.real)
    ii: B32 = me.imag.mul_finite(me.imag)
    return rr.add_finite(ii)

### The modulus, the square root of the squared modulus.
### :returns: The modulus.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.abs() -> B32
    return me.norm().sqrt()

### The phase angle atan2(imag, real), in (-π, π].
### :returns: The phase angle.
routine C64.arg() -> B32
    return atan2(y: me.imag, x: me.real)

### The sine, sin a cosh b + i cos a sinh b, with cosh and sinh from e^b and e^-b.
### :returns: The sine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.sin() -> Me
    ep: B32 = me.imag.exp()
    em: B32 = (-me.imag).exp()
    ch: B32 = ep.add_finite(em).truediv_finite(2.0)
    sh: B32 = ep.sub_finite(em).truediv_finite(2.0)
    re: B32 = me.real.sin().mul_finite(ch)
    im: B32 = me.real.cos().mul_finite(sh)
    return (real: re, imag: im)

### The cosine, cos a cosh b - i sin a sinh b, with cosh and sinh from e^b and e^-b.
### :returns: The cosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.cos() -> Me
    ep: B32 = me.imag.exp()
    em: B32 = (-me.imag).exp()
    ch: B32 = ep.add_finite(em).truediv_finite(2.0)
    sh: B32 = ep.sub_finite(em).truediv_finite(2.0)
    re: B32 = me.real.cos().mul_finite(ch)
    im: B32 = -me.real.sin().mul_finite(sh)
    return (real: re, imag: im)

### The tangent, (sin 2a + i sinh 2b) / (cos 2a + cosh 2b).
### :returns: The tangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C64.tan() -> Me
    a2: B32 = me.real.add_finite(me.real)
    b2: B32 = me.imag.add_finite(me.imag)
    ep: B32 = b2.exp()
    em: B32 = (-b2).exp()
    ca: B32 = a2.cos()
    ch: B32 = ep.add_finite(em).truediv_finite(2.0)
    d: B32 = ca.add_finite(ch)
    re: B32 = a2.sin().truediv_finite(d)
    sh: B32 = ep.sub_finite(em).truediv_finite(2.0)
    im: B32 = sh.truediv_finite(d)
    return (real: re, imag: im)

### The arcsine, -i log(iz + √(1 - z²)).
### :returns: The arcsine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.asin() -> Me
    iz: Me = (real: -me.imag, imag: me.real)
    zz: Me = me * me
    s: Me = (Me.one() - zz).sqrt()
    v: Me = (iz + s).ln()
    return (real: v.imag, imag: -v.real)

### The arccosine, -i log(z + i √(1 - z²)).
### :returns: The arccosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.acos() -> Me
    zz: Me = me * me
    s: Me = (Me.one() - zz).sqrt()
    `is`: Me = (real: -s.imag, imag: s.real)
    v: Me = (me + `is`).ln()
    return (real: v.imag, imag: -v.real)

### The arctangent, (i/2) log((i + z) / (i - z)).
### :returns: The arctangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C64.atan() -> Me
    num_imag: B32 = me.imag.add_finite(1.0)
    den_imag: B32 = B32.sub_finite(1.0, me.imag)
    num: Me = (real: me.real, imag: num_imag)
    den: Me = (real: -me.real, imag: den_imag)
    v: Me = (num / den).ln()
    re: B32 = (-v.imag).truediv_finite(2.0)
    im: B32 = v.real.truediv_finite(2.0)
    return (real: re, imag: im)

### The hyperbolic sine, sinh a cos b + i cosh a sin b, with sinh and cosh from e^a and e^-a.
### :returns: The hyperbolic sine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.sinh() -> Me
    ep: B32 = me.real.exp()
    em: B32 = (-me.real).exp()
    sh: B32 = ep.sub_finite(em).truediv_finite(2.0)
    ch: B32 = ep.add_finite(em).truediv_finite(2.0)
    re: B32 = sh.mul_finite(me.imag.cos())
    im: B32 = ch.mul_finite(me.imag.sin())
    return (real: re, imag: im)

### The hyperbolic cosine, cosh a cos b + i sinh a sin b, with sinh and cosh from e^a and e^-a.
### :returns: The hyperbolic cosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.cosh() -> Me
    ep: B32 = me.real.exp()
    em: B32 = (-me.real).exp()
    sh: B32 = ep.sub_finite(em).truediv_finite(2.0)
    ch: B32 = ep.add_finite(em).truediv_finite(2.0)
    re: B32 = ch.mul_finite(me.imag.cos())
    im: B32 = sh.mul_finite(me.imag.sin())
    return (real: re, imag: im)

### The hyperbolic tangent, (sinh 2a + i sin 2b) / (cosh 2a + cos 2b).
### :returns: The hyperbolic tangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C64.tanh() -> Me
    a2: B32 = me.real.add_finite(me.real)
    b2: B32 = me.imag.add_finite(me.imag)
    ep: B32 = a2.exp()
    em: B32 = (-a2).exp()
    ch: B32 = ep.add_finite(em).truediv_finite(2.0)
    d: B32 = ch.add_finite(b2.cos())
    sh: B32 = ep.sub_finite(em).truediv_finite(2.0)
    re: B32 = sh.truediv_finite(d)
    im: B32 = b2.sin().truediv_finite(d)
    return (real: re, imag: im)

### The inverse hyperbolic sine, log(z + √(z² + 1)).
### :returns: The inverse hyperbolic sine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.asinh() -> Me
    zz: Me = me * me
    s: Me = (zz + Me.one()).sqrt()
    return (me + s).ln()

### The inverse hyperbolic cosine, log(z + √(z² - 1)).
### :returns: The inverse hyperbolic cosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.acosh() -> Me
    zz: Me = me * me
    s: Me = (zz - Me.one()).sqrt()
    return (me + s).ln()

### The inverse hyperbolic tangent, log((1 + z) / (1 - z)) / 2.
### :returns: The inverse hyperbolic tangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C64.atanh() -> Me
    p: Me = Me.one() + me
    m: Me = Me.one() - me
    v: Me = (p / m).ln()
    re: B32 = v.real.truediv_finite(2.0)
    im: B32 = v.imag.truediv_finite(2.0)
    return (real: re, imag: im)

### e to this power, eᵃ (cos b + i sin b).
### :returns: e to this power.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.exp() -> Me
    ea: B32 = me.real.exp()
    re: B32 = ea.mul_finite(me.imag.cos())
    im: B32 = ea.mul_finite(me.imag.sin())
    return (real: re, imag: im)

### The principal natural logarithm, ln |z| + i arg z.
### :returns: The principal natural logarithm.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.ln() -> Me
    re: B32 = me.abs().ln()
    return (real: re, imag: me.arg())

### The base-10 logarithm, ln z / ln 10.
### :returns: The base-10 logarithm.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.log10() -> Me
    v: Me = me.ln()
    re: B32 = v.real.truediv_finite(C64_LN_10)
    im: B32 = v.imag.truediv_finite(C64_LN_10)
    return (real: re, imag: im)

### The base-2 logarithm, ln z / ln 2.
### :returns: The base-2 logarithm.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.log2() -> Me
    v: Me = me.ln()
    re: B32 = v.real.truediv_finite(C64_LN_2)
    im: B32 = v.imag.truediv_finite(C64_LN_2)
    return (real: re, imag: im)

### 1 / z, the conjugate over the squared modulus.
### :returns: 1 / z.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN. The reciprocal of 0 + 0i is 1 / 0, a `DivisionByZeroError`, as with real division. A
###     squared modulus that underflows to zero divides a nonzero value by zero, a `DivisionByZeroError` too.
routine C64.reciprocal() -> Me
    if me.is_zero()
        crash_division_by_zero()
    d: B32 = me.norm()
    re: B32 = me.real.truediv_finite(d)
    im: B32 = (-me.imag).truediv_finite(d)
    return (real: re, imag: im)

### The principal square root (real part >= 0), from half the modulus plus and minus the real part. The imaginary part
### takes the sign of this imaginary part, so -0 and +0 pick the two sides of the cut along the negative reals.
### :returns: The principal square root.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.sqrt() -> Me
    local r: B32 = me.abs()

    if r == 0.0
        return (real: 0.0, imag: 0.0)
    rp: B32 = r.add_finite(me.real).truediv_finite(2.0).sqrt()
    ip: B32 = r.sub_finite(me.real).truediv_finite(2.0).sqrt()
    if me.imag < 0.0
        return (real: rp, imag: -ip)
    return (real: rp, imag: ip)

### This number to the complex power `power`, exp(power × ln me).
### :param power: The complex exponent.
### :returns: This number to the power `power`.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C64.pow(power: Me) -> Me
    return (power * me.ln()).exp()

### This number to the integer power n, by repeated squaring: each product rounds once, with no ln and exp. A
### negative n starts from the reciprocal, and n = 0 gives 1. The base is squared once more after the last product,
### as RazorForge's loop does, so that squaring can overflow too.
### :param n: The integer exponent.
### :returns: This number to the power `n`.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C64.powi(n: S64) -> Me
    local result: @Me <- Me.one()
    local k: U64 = n.to_wrap[U64]()
    local base: @Me <- me

    left: U64 = when
        not (n < 0) => k
        else =>
            me.reciprocal().poke_into(base)
            becomes U64.sub_wrap(0, k)

    while left2 != 0 with left2: U64 = left
        if left2 & 1 == 1
            (result.peek() * base.peek()).poke_into(result)
        (base.peek() * base.peek()).poke_into(base)
        continue with left2: left2 >> 1
    then
        return result.peek()

### The number at distance r and angle theta: r cos θ + i r sin θ.
### :param r: The distance from 0.
### :param theta: The angle, in radians.
### :returns: The number r cos θ + i r sin θ.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
common routine C64.from_polar(r: B32, theta: B32) -> Me
    re: B32 = r.mul_finite(theta.cos())
    im: B32 = r.mul_finite(theta.sin())
    return (real: re, imag: im)

### Both parts in one U64, the way an export hands a C64 back: the real part's bits low, the imaginary part's high.
### :returns: The real part's bits in the low 32 bits, the imaginary part's in the high 32.
@inline
routine C64.bits() -> U64
    low: U64 = me.real.bits().to[U64]()
    high: U64 = me.imag.bits().to[U64]()
    return low | (high << 32)

# The exports RazorForge's C64 calls.

### The product, for C64.mul.
### :param real: The first number's real part.
### :param imag: The first number's imaginary part.
### :param other_real: The second number's real part.
### :param other_imag: The second number's imaginary part.
### :returns: The result's real part's bits in the low 32 bits, its imaginary part's in the high 32.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c64_mul")
@inline
routine c64_mul(real: B32, imag: B32, other_real: B32, other_imag: B32) -> U64
    z: C64 = (real: real, imag: imag)
    w: C64 = (real: other_real, imag: other_imag)
    return (z * w).bits()

### The quotient, for C64.truediv.
### :param real: The first number's real part.
### :param imag: The first number's imaginary part.
### :param other_real: The second number's real part.
### :param other_imag: The second number's imaginary part.
### :returns: The result's real part's bits in the low 32 bits, its imaginary part's in the high 32.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN. Dividing by 0 + 0i is a `DivisionByZeroError`, and 0 / (0 + 0i) a `NumericDomainError`, as
###     with real division. A nonzero divisor whose squared modulus underflows to zero divides a nonzero value by
###     zero, a `DivisionByZeroError` too.
@export("ingrid_c64_div")
@inline
routine c64_div(real: B32, imag: B32, other_real: B32, other_imag: B32) -> U64
    z: C64 = (real: real, imag: imag)
    w: C64 = (real: other_real, imag: other_imag)
    return (z / w).bits()

### The first number to the power of the second, for C64.pow.
### :param real: The first number's real part.
### :param imag: The first number's imaginary part.
### :param other_real: The second number's real part.
### :param other_imag: The second number's imaginary part.
### :returns: The result's real part's bits in the low 32 bits, its imaginary part's in the high 32.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c64_pow")
@inline
routine c64_pow(real: B32, imag: B32, other_real: B32, other_imag: B32) -> U64
    z: C64 = (real: real, imag: imag)
    w: C64 = (real: other_real, imag: other_imag)
    return (z ** w).bits()

### The modulus of the given number, for C64.abs.
### :param real: The real part.
### :param imag: The imaginary part.
### :returns: The modulus.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c64_abs")
@inline
routine c64_abs(real: B32, imag: B32) -> B32
    z: C64 = (real: real, imag: imag)
    return z.abs()

### The phase angle of the given number, for C64.arg.
### :param real: The real part.
### :param imag: The imaginary part.
### :returns: The phase angle.
@export("ingrid_c64_arg")
@inline
routine c64_arg(real: B32, imag: B32) -> B32
    z: C64 = (real: real, imag: imag)
    return z.arg()

### The squared modulus of the given number, for C64.norm.
### :param real: The real part.
### :param imag: The imaginary part.
### :returns: The squared modulus.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c64_norm")
@inline
routine c64_norm(real: B32, imag: B32) -> B32
    z: C64 = (real: real, imag: imag)
    return z.norm()

### The sine of the given number, for C64.sin.
### :param real: The real part.
### :param imag: The imaginary part.
### :returns: The result's real part's bits in the low 32 bits, its imaginary part's in the high 32.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c64_sin")
@inline
routine c64_sin(real: B32, imag: B32) -> U64
    z: C64 = (real: real, imag: imag)
    return z.sin().bits()

### The cosine of the given number, for C64.cos.
### :param real: The real part.
### :param imag: The imaginary part.
### :returns: The result's real part's bits in the low 32 bits, its imaginary part's in the high 32.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c64_cos")
@inline
routine c64_cos(real: B32, imag: B32) -> U64
    z: C64 = (real: real, imag: imag)
    return z.cos().bits()

### The tangent of the given number, for C64.tan.
### :param real: The real part.
### :param imag: The imaginary part.
### :returns: The result's real part's bits in the low 32 bits, its imaginary part's in the high 32.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
@export("ingrid_c64_tan")
@inline
routine c64_tan(real: B32, imag: B32) -> U64
    z: C64 = (real: real, imag: imag)
    return z.tan().bits()

### The arcsine of the given number, for C64.asin.
### :param real: The real part.
### :param imag: The imaginary part.
### :returns: The result's real part's bits in the low 32 bits, its imaginary part's in the high 32.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c64_asin")
@inline
routine c64_asin(real: B32, imag: B32) -> U64
    z: C64 = (real: real, imag: imag)
    return z.asin().bits()

### The arccosine of the given number, for C64.acos.
### :param real: The real part.
### :param imag: The imaginary part.
