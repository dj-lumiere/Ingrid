    return z.sqrt().bits()

### C64 to an integer power.
### :param real: The real part.
### :param imag: The imaginary part.
### :param n: The integer exponent.
### :returns: The result's real part's bits in the low 32 bits, its imaginary part's in the high 32.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
@export("ingrid_c64_powi")
@inline
routine c64_powi(real: B32, imag: B32, n: S64) -> U64
    z: C64 = (real: real, imag: imag)
    return z.powi(n).bits()

### The C64 at distance r and angle theta.
### :param r: The distance from 0.
### :param theta: The angle, in radians.
### :returns: The result's real part's bits in the low 32 bits, its imaginary part's in the high 32.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c64_from_polar")
@inline
routine c64_from_polar(r: B32, theta: B32) -> U64
    return C64.from_polar(r, theta).bits()

### The sum, for C64.add (a real addend comes as a number whose imaginary part is +0).
### :param real: The first number's real part.
### :param imag: The first number's imaginary part.
### :param other_real: The second number's real part.
### :param other_imag: The second number's imaginary part.
### :returns: The result's real part's bits in the low 32 bits, its imaginary part's in the high 32.
### :throws: Crashes with `NumericOverflowError` when a part is infinite, or with `NumericDomainError` when one is NaN.
@export("ingrid_c64_add")
@inline
routine c64_add(real: B32, imag: B32, other_real: B32, other_imag: B32) -> U64
    z: C64 = (real: real, imag: imag)
    w: C64 = (real: other_real, imag: other_imag)
    return (z + w).bits()

### The difference, for C64.sub.
### :param real: The first number's real part.
### :param imag: The first number's imaginary part.
### :param other_real: The second number's real part.
### :param other_imag: The second number's imaginary part.
### :returns: The result's real part's bits in the low 32 bits, its imaginary part's in the high 32.
### :throws: Crashes with `NumericOverflowError` when a part is infinite, or with `NumericDomainError` when one is NaN.
@export("ingrid_c64_sub")
@inline
routine c64_sub(real: B32, imag: B32, other_real: B32, other_imag: B32) -> U64
    z: C64 = (real: real, imag: imag)
    w: C64 = (real: other_real, imag: other_imag)
    return (z - w).bits()

### The product with a real number, for C64.mul with a B32.
### :param real: The real part.
### :param imag: The imaginary part.
### :param factor: The real factor.
### :returns: The result's real part's bits in the low 32 bits, its imaginary part's in the high 32.
### :throws: Crashes with `NumericOverflowError` when a part is infinite, or with `NumericDomainError` when one is NaN.
@export("ingrid_c64_mul_real")
@inline
routine c64_mul_real(real: B32, imag: B32, factor: B32) -> U64
    z: C64 = (real: real, imag: imag)
    return (z.mul_real(factor)).bits()

### The quotient by a real number, for C64.truediv with a B32.
### :param real: The real part.
### :param imag: The imaginary part.
### :param divisor: The real divisor.
### :returns: The result's real part's bits in the low 32 bits, its imaginary part's in the high 32.
### :throws: Crashes with `DivisionByZeroError` when a nonzero part is divided by zero, with `NumericDomainError` when a
###     quotient is NaN, or with `NumericOverflowError` when one is infinite.
@export("ingrid_c64_div_real")
@inline
routine c64_div_real(real: B32, imag: B32, divisor: B32) -> U64
    z: C64 = (real: real, imag: imag)
    return (z.truediv_real(divisor)).bits()

### The negation, for C64.neg.
### :param real: The real part.
### :param imag: The imaginary part.
### :returns: The result's real part's bits in the low 32 bits, its imaginary part's in the high 32.
@export("ingrid_c64_neg")
@inline
routine c64_neg(real: B32, imag: B32) -> U64
    z: C64 = (real: real, imag: imag)
    return (z.neg()).bits()

### The conjugate, for C64.conjugate.
### :param real: The real part.
### :param imag: The imaginary part.
### :returns: The result's real part's bits in the low 32 bits, its imaginary part's in the high 32.
@export("ingrid_c64_conjugate")
@inline
routine c64_conjugate(real: B32, imag: B32) -> U64
    z: C64 = (real: real, imag: imag)
    return (z.conjugate()).bits()

### Whether two numbers compare equal, for C64.eq.
### :param real: The first number's real part.
### :param imag: The first number's imaginary part.
### :param other_real: The second number's real part.
### :param other_imag: The second number's imaginary part.
### :returns: 1 when both parts compare equal, else 0.
@export("ingrid_c64_eq")
@inline
routine c64_eq(real: B32, imag: B32, other_real: B32, other_imag: B32) -> U32
    z: C64 = (real: real, imag: imag)
    w: C64 = (real: other_real, imag: other_imag)
    return z.eq(w).to[U32]()

### What kind of number this is, for C64.is_zero, is_real, is_imaginary, is_nan, is_infinite, and is_finite.
### :param real: The real part.
### :param imag: The imaginary part.
### :returns: The flags of `classify`: 1 zero, 2 on the real axis, 4 on the imaginary axis, 8 NaN, 16 infinite, 32
###     finite.
@export("ingrid_c64_class")
@inline
routine c64_class(real: B32, imag: B32) -> U32
    z: C64 = (real: real, imag: imag)
    return z.classify()

### The polar form, for C64.to_polar.
### :param real: The real part.
### :param imag: The imaginary part.
### :returns: The modulus's bits in the low 32 bits, the angle's in the high 32.
### :throws: Crashes where `abs` does.
@export("ingrid_c64_polar")
@inline
routine c64_polar(real: B32, imag: B32) -> U64
    z: C64 = (real: real, imag: imag)
    return z.to_polar().bits()

# ── C128 ──────────────────────────────────────────────────────────────────────────

### RazorForge's C128: a complex number over B64, RazorForge's B64.
record C128
obeys Addable[C128], Subtractable[C128], Multiplicable[C128], Divisible[C128], Exponentiable[C128]
    real: B64
    imag: B64

### 1 + 0i.
### :returns: 1 + 0i.
@inline
common routine C128.one() -> Me
    return (real: 1.0, imag: 0.0)

### The sum, part by part.
### :param other: The number to add.
### :returns: The sum.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@inline
routine C128.add(other: Me) -> Me
    re: B64 = me.real.add_finite(other.real)
    im: B64 = me.imag.add_finite(other.imag)
    return (real: re, imag: im)

### The difference, part by part.
### :param other: The number to subtract.
### :returns: The difference.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@inline
routine C128.sub(other: Me) -> Me
    re: B64 = me.real.sub_finite(other.real)
    im: B64 = me.imag.sub_finite(other.imag)
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The product (ac - bd) + (ad + bc)i.
### :param other: The number to multiply by.
### :returns: The product.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C128.mul_textbook(other: Me) -> Me
    ac: B64 = me.real.mul_finite(other.real)
    bd: B64 = me.imag.mul_finite(other.imag)
    re: B64 = ac.sub_finite(bd)
    ad: B64 = me.real.mul_finite(other.imag)
    bc: B64 = me.imag.mul_finite(other.real)
    im: B64 = ad.add_finite(bc)
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The quotient: me times the conjugate of other, over other's squared modulus.
### :param other: The divisor.
### :returns: The quotient.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN. Dividing by 0 + 0i is a `DivisionByZeroError`, and 0 / (0 + 0i) a `NumericDomainError`, as
###     with real division. A nonzero divisor whose squared modulus underflows to zero divides a nonzero value by
###     zero, a `DivisionByZeroError` too.
secret routine C128.truediv_textbook(other: Me) -> Me
    if other.is_zero()
        crash_zero_divisor(me.is_zero())
    d: B64 = other.norm_textbook()
    ac: B64 = me.real.mul_finite(other.real)
    bd: B64 = me.imag.mul_finite(other.imag)
    re: B64 = ac.add_finite(bd).truediv_finite(d)
    bc: B64 = me.imag.mul_finite(other.real)
    ad: B64 = me.real.mul_finite(other.imag)
    im: B64 = bc.sub_finite(ad).truediv_finite(d)
    return (real: re, imag: im)

### Whether both parts are zero (+0 or -0).
### :returns: True for 0 + 0i.
@inline
routine C128.is_zero() -> Bool
    return me.real == 0.0 and me.imag == 0.0

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The squared modulus real² + imag².
### :returns: The squared modulus.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C128.norm_textbook() -> B64
    rr: B64 = me.real.mul_finite(me.real)
    ii: B64 = me.imag.mul_finite(me.imag)
    return rr.add_finite(ii)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The modulus, the square root of the squared modulus.
### :returns: The modulus.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C128.abs_textbook() -> B64
    return me.norm_textbook().sqrt_unchecked()

### The phase angle atan2(imag, real), in (-π, π].
### :returns: The phase angle.
routine C128.arg() -> B64
    return atan2(y: me.imag, x: me.real)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The sine, sin a cosh b + i cos a sinh b, with cosh and sinh from e^b and e^-b.
### :returns: The sine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C128.sin_textbook() -> Me
    ep: B64 = me.imag.exp_unchecked()
    em: B64 = (-me.imag).exp_unchecked()
    ch: B64 = ep.add_finite(em).truediv_finite(2.0)
    sh: B64 = ep.sub_finite(em).truediv_finite(2.0)
    re: B64 = me.real.sin().mul_finite(ch)
    im: B64 = me.real.cos().mul_finite(sh)
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The cosine, cos a cosh b - i sin a sinh b, with cosh and sinh from e^b and e^-b.
### :returns: The cosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C128.cos_textbook() -> Me
    ep: B64 = me.imag.exp_unchecked()
    em: B64 = (-me.imag).exp_unchecked()
    ch: B64 = ep.add_finite(em).truediv_finite(2.0)
    sh: B64 = ep.sub_finite(em).truediv_finite(2.0)
    re: B64 = me.real.cos().mul_finite(ch)
    im: B64 = -me.real.sin().mul_finite(sh)
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The tangent, (sin 2a + i sinh 2b) / (cos 2a + cosh 2b).
### :returns: The tangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
secret routine C128.tan_textbook() -> Me
    a2: B64 = me.real.add_finite(me.real)
    b2: B64 = me.imag.add_finite(me.imag)
    ep: B64 = b2.exp_unchecked()
    em: B64 = (-b2).exp_unchecked()
    ca: B64 = a2.cos()
    ch: B64 = ep.add_finite(em).truediv_finite(2.0)
    d: B64 = ca.add_finite(ch)
    re: B64 = a2.sin().truediv_finite(d)
    sh: B64 = ep.sub_finite(em).truediv_finite(2.0)
    im: B64 = sh.truediv_finite(d)
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The arcsine, -i log(iz + √(1 - z²)).
### :returns: The arcsine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C128.asin_textbook() -> Me
    iz: Me = (real: -me.imag, imag: me.real)
    zz: Me = me * me
    s: Me = (Me.one() - zz).sqrt()
    v: Me = (iz + s).ln()
    return (real: v.imag, imag: -v.real)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The arccosine, -i log(z + i √(1 - z²)).
### :returns: The arccosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C128.acos_textbook() -> Me
    zz: Me = me * me
    s: Me = (Me.one() - zz).sqrt()
    `is`: Me = (real: -s.imag, imag: s.real)
    v: Me = (me + `is`).ln()
    return (real: v.imag, imag: -v.real)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The arctangent, (i/2) log((i + z) / (i - z)).
### :returns: The arctangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
secret routine C128.atan_textbook() -> Me
    num_imag: B64 = me.imag.add_finite(1.0)
    den_imag: B64 = B64.sub_finite(1.0, me.imag)
    num: Me = (real: me.real, imag: num_imag)
    den: Me = (real: -me.real, imag: den_imag)
    v: Me = (num / den).ln()
    re: B64 = (-v.imag).truediv_finite(2.0)
    im: B64 = v.real.truediv_finite(2.0)
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The hyperbolic sine, sinh a cos b + i cosh a sin b, with sinh and cosh from e^a and e^-a.
### :returns: The hyperbolic sine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C128.sinh_textbook() -> Me
    ep: B64 = me.real.exp_unchecked()
    em: B64 = (-me.real).exp_unchecked()
    sh: B64 = ep.sub_finite(em).truediv_finite(2.0)
    ch: B64 = ep.add_finite(em).truediv_finite(2.0)
    re: B64 = sh.mul_finite(me.imag.cos())
    im: B64 = ch.mul_finite(me.imag.sin())
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The hyperbolic cosine, cosh a cos b + i sinh a sin b, with sinh and cosh from e^a and e^-a.
### :returns: The hyperbolic cosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C128.cosh_textbook() -> Me
    ep: B64 = me.real.exp_unchecked()
    em: B64 = (-me.real).exp_unchecked()
    sh: B64 = ep.sub_finite(em).truediv_finite(2.0)
    ch: B64 = ep.add_finite(em).truediv_finite(2.0)
    re: B64 = ch.mul_finite(me.imag.cos())
    im: B64 = sh.mul_finite(me.imag.sin())
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The hyperbolic tangent, (sinh 2a + i sin 2b) / (cosh 2a + cos 2b).
### :returns: The hyperbolic tangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
secret routine C128.tanh_textbook() -> Me
    a2: B64 = me.real.add_finite(me.real)
    b2: B64 = me.imag.add_finite(me.imag)
    ep: B64 = a2.exp_unchecked()
    em: B64 = (-a2).exp_unchecked()
    ch: B64 = ep.add_finite(em).truediv_finite(2.0)
    d: B64 = ch.add_finite(b2.cos())
    sh: B64 = ep.sub_finite(em).truediv_finite(2.0)
    re: B64 = sh.truediv_finite(d)
    im: B64 = b2.sin().truediv_finite(d)
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The inverse hyperbolic sine, log(z + √(z² + 1)).
### :returns: The inverse hyperbolic sine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C128.asinh_textbook() -> Me
    zz: Me = me * me
    s: Me = (zz + Me.one()).sqrt()
    return (me + s).ln()

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The inverse hyperbolic cosine, log(z + √(z² - 1)).
### :returns: The inverse hyperbolic cosine.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C128.acosh_textbook() -> Me
    zz: Me = me * me
    s: Me = (zz - Me.one()).sqrt()
    return (me + s).ln()

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The inverse hyperbolic tangent, log((1 + z) / (1 - z)) / 2.
### :returns: The inverse hyperbolic tangent.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
secret routine C128.atanh_textbook() -> Me
    p: Me = Me.one() + me
    m: Me = Me.one() - me
    v: Me = (p / m).ln()
    re: B64 = v.real.truediv_finite(2.0)
    im: B64 = v.imag.truediv_finite(2.0)
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### e to this power, eᵃ (cos b + i sin b).
### :returns: e to this power.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C128.exp_textbook() -> Me
    ea: B64 = me.real.exp_unchecked()
    re: B64 = ea.mul_finite(me.imag.cos())
    im: B64 = ea.mul_finite(me.imag.sin())
    return (real: re, imag: im)

### The principal natural logarithm, ln |z| + i arg z.
### :returns: The principal natural logarithm.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.ln() -> Me
    re: B64 = me.abs().ln_unchecked()
    return (real: re, imag: me.arg())

### The base-10 logarithm, ln z / ln 10.
### :returns: The base-10 logarithm.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.log10() -> Me
    v: Me = me.ln()
    re: B64 = v.real.truediv_finite(C128_LN_10)
    im: B64 = v.imag.truediv_finite(C128_LN_10)
    return (real: re, imag: im)

### The base-2 logarithm, ln z / ln 2.
### :returns: The base-2 logarithm.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.log2() -> Me
    v: Me = me.ln()
    re: B64 = v.real.truediv_finite(C128_LN_2)
    im: B64 = v.imag.truediv_finite(C128_LN_2)
    return (real: re, imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### 1 / z, the conjugate over the squared modulus.
### :returns: 1 / z.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN. The reciprocal of 0 + 0i is 1 / 0, a `DivisionByZeroError`, as with real division. A
###     squared modulus that underflows to zero divides a nonzero value by zero, a `DivisionByZeroError` too.
secret routine C128.reciprocal_textbook() -> Me
    if me.is_zero()
        throw DivisionByZeroError()
    d: B64 = me.norm_textbook()
    re: B64 = me.real.truediv_finite(d)
    im: B64 = (-me.imag).truediv_finite(d)
    return (real: re, imag: im)

### The product (ac - bd) + (ad + bc)i, each part rounded once (b64_dot2: the products are exact integers).
### :param other: The number to multiply by.
### :returns: The product.
### :throws: Crashes with `NumericOverflowError` when a part is past B64's range. With an operand that is not finite
###     it crashes where the textbook formula does (`mul_textbook`).
routine C128.mul(other: Me) -> Me
    if not (me.is_finite() and other.is_finite())
        return me.mul_textbook(other)
    re: B64 = b64_dot2_fast(a: me.real, b: other.real, c: -me.imag, d: other.imag).hi
    im: B64 = b64_dot2_fast(a: me.real, b: other.imag, c: me.imag, d: other.real).hi
    return c128_finite(re, im)

### The quotient (ac + bd)/(c² + d²) + (bc - ad)/(c² + d²) i, each part rounded once (b64_divide).
### :param other: The divisor.
### :returns: The quotient.
### :throws: Crashes with `DivisionByZeroError` when dividing by 0 + 0i, with `NumericDomainError` for 0 / (0 + 0i), and
###     with `NumericOverflowError` when a part is past B64's range. With an operand that is not finite it crashes
###     where the textbook formula does (`truediv_textbook`).
routine C128.truediv(other: Me) -> Me
    if other.is_zero()
        crash_zero_divisor(me.is_zero())
    if not (me.is_finite() and other.is_finite())
        return me.truediv_textbook(other)
    q: B64Pair = b64_divide(operands: (a: me.real, b: me.imag, c: other.real, d: other.imag))
    return c128_finite(re: q.hi, im: q.lo)

### The squared modulus real² + imag², rounded once.
### :returns: The squared modulus.
### :throws: Crashes with `NumericOverflowError` when it is past B64's range. With a part that is not finite it
###     crashes where the textbook formula does (`norm_textbook`).
routine C128.norm() -> B64
    if not me.is_finite()
        return me.norm_textbook()
    n: B64 = b64_dot2_fast(a: me.real, b: me.real, c: me.imag, d: me.imag).hi
    if n.is_finite()
        return n
    crash_not_finite(false)

### The modulus √(real² + imag²), rounded once (the correctly rounded hypot), with no overflow or underflow on the
### way.
### :returns: The modulus.
### :throws: Crashes with `NumericOverflowError` when it is past B64's range. With a part that is not finite it
###     crashes where the textbook formula does (`abs_textbook`).
routine C128.abs() -> B64
    if not me.is_finite()
        return me.abs_textbook()
    r: B64 = hypot_unchecked(x: me.real, y: me.imag)
    if r.is_finite()
        return r
    crash_not_finite(false)

### 1 / z = real/(real² + imag²) - imag/(real² + imag²) i, each part rounded once (as in `truediv`), a zero part
### with the sign of real / (real² + imag²) and -imag / (real² + imag²).
### :returns: 1 / z.
### :throws: Crashes with `DivisionByZeroError` for 0 + 0i, as with real division, and with `NumericOverflowError` when
###     a part is past B64's range. With a part that is not finite it crashes where the textbook formula does
###     (`reciprocal_textbook`).
routine C128.reciprocal() -> Me
    if me.is_zero()
        throw DivisionByZeroError()
    if not me.is_finite()
        return me.reciprocal_textbook()
    q: B64Pair = b64_divide(operands: (a: 1.0, b: 0.0, c: me.real, d: me.imag))
    re: B64 = when
        me.real == 0.0 => me.real
        else => q.hi
    im: B64 = when
        me.imag == 0.0 => -me.imag
        else => q.lo
    return c128_finite(re, im)

### Both parts, crashing unless both are finite: the check behind the arithmetic rounded once, whose operands were
### finite, so a part that is not finite is past the range.
### :param re: The real part.
### :param im: The imaginary part.
### :returns: The number re + im i.
### :throws: Crashes with `NumericOverflowError` when a part is infinite, or with `NumericDomainError` when one is NaN.
@inline
secret routine c128_finite(re: B64, im: B64) -> C128
    if re.is_finite() and im.is_finite()
        return (real: re, imag: im)
    crash_not_finite(re.is_nan() or im.is_nan())

### The negation, part by part.
### :returns: -real - imag i.
@inline
routine C128.neg() -> Me
    return (real: -me.real, imag: -me.imag)

### The conjugate: the imaginary part negated.
### :returns: real - imag i.
@inline
routine C128.conjugate() -> Me
    return (real: me.real, imag: -me.imag)

### Whether both parts compare equal, as floats do: -0 equals +0, and a NaN equals nothing.
### :param other: The number to compare with.
### :returns: True when real == other.real and imag == other.imag.
@inline
routine C128.eq(other: Me) -> Bool
    return me.real == other.real and me.imag == other.imag

### Whether both parts are finite.
### :returns: True when neither part is infinite or NaN.
@inline
routine C128.is_finite() -> Bool
    return me.real.is_finite() and me.imag.is_finite()

### Whether a part is NaN.
### :returns: True when the real or the imaginary part is NaN.
@inline
routine C128.is_nan() -> Bool
    return me.real.is_nan() or me.imag.is_nan()

### Whether a part is infinite.
### :returns: True when the real or the imaginary part is an infinity.
@inline
routine C128.is_infinite() -> Bool
    return me.real.is_infinite() or me.imag.is_infinite()

### What kind of number this is, as flags: 1 both parts zero, 2 the imaginary part zero (on the real axis), 4 the real
### part zero (on the imaginary axis), 8 a part NaN, 16 a part infinite, 32 both parts finite. A zero is +0 or -0.
### :returns: The flags.
@inline
routine C128.classify() -> U32
    real_zero: Bool = me.real == 0.0
    imag_zero: Bool = me.imag == 0.0
    zero: U32 = (real_zero and imag_zero).to[U32]()
    on_real: U32 = imag_zero.to[U32]() << 1
    on_imaginary: U32 = real_zero.to[U32]() << 2
    not_a_number: U32 = me.is_nan().to[U32]() << 3
    infinite: U32 = me.is_infinite().to[U32]() << 4
    finite: U32 = me.is_finite().to[U32]() << 5
    return zero | on_real | on_imaginary | not_a_number | infinite | finite

### The product with a real number, both parts multiplied by it (the real part first).
### :param factor: The real factor.
### :returns: real × factor + imag × factor i.
### :throws: Crashes with `NumericOverflowError` when a product is infinite, or with `NumericDomainError` when one is
###     NaN.
@inline
routine C128.mul_real(factor: B64) -> Me
    re: B64 = me.real.mul_finite(factor)
    im: B64 = me.imag.mul_finite(factor)
    return (real: re, imag: im)

### The quotient by a real number, both parts divided by it (the real part first).
### :param divisor: The real divisor.
### :returns: real / divisor + imag / divisor i.
### :throws: Crashes with `DivisionByZeroError` when a nonzero part is divided by zero, with `NumericDomainError` when a
###     quotient is NaN, or with `NumericOverflowError` when one is infinite.
@inline
routine C128.truediv_real(divisor: B64) -> Me
    re: B64 = me.real.truediv_finite(divisor)
    im: B64 = me.imag.truediv_finite(divisor)
    return (real: re, imag: im)

### The polar form: the modulus (`abs`) and the phase angle (`arg`).
### :returns: The modulus in `real` and the angle in `imag`.
### :throws: Crashes where `abs` does.
@inline
routine C128.to_polar() -> Me
    return (real: me.abs(), imag: me.arg())

### SipHash-2-4 of the value under the key (k0, k1): both parts' bits with a zero part as +0, so numbers that compare
### equal hash the same.
### :param k0: The key's first 64-bit word.
### :param k1: The key's second 64-bit word.
### :returns: The 64-bit hash.
routine C128.hash_keyed(k0: U64, k1: U64) -> U64
    re: U64 = when
        me.real == 0.0 => 0
        else => me.real.bits()
    im: U64 = when
        me.imag == 0.0 => 0
        else => me.imag.bits()
    return siphash24_u128(low: re, high: im, k0, k1)

### Whether both parts are at most 2^509 in magnitude: past it the products the inverse functions form could
### overflow, so those keep the textbook formulas.
### :returns: True when neither part is larger.
@inline
secret routine C128.is_moderate() -> Bool
    return me.real.abs() <= B64.from_bits(0x5FC0000000000000) and me.imag.abs() <= B64.from_bits(0x5FC0000000000000)

### The principal square root (real part >= 0), Kahan's: t = √((|z| + |real|) / 2) from the correctly rounded modulus,
### then the other part as imag / 2t, so neither part cancels. The imaginary part takes the sign of this imaginary part,
### so -0 and +0 pick the two sides of the cut along the negative reals: √(-4 - 0i) is 0 - 2i. A modulus below
### 2^-916 is computed from this number scaled up by 4^55, exactly.
### :returns: The principal square root.
### :throws: With a part that is not finite it crashes where the textbook formula does (`sqrt_textbook`).
routine C128.sqrt() -> Me
    if not me.is_finite()
        return me.sqrt_textbook()
    if me.real == 0.0 and me.imag == 0.0
        return (real: 0.0, imag: me.imag)
    r: B64 = hypot_unchecked(x: me.real, y: me.imag)
    if r < B64.from_bits(0x06B0000000000000)
        up: B64 = B64.from_bits(0x4360000000000000)
        big: Me = (real: me.real *! up *! up, imag: me.imag *! up *! up)
        root: Me = big.sqrt()
        down: B64 = B64.from_bits(0x3C80000000000000)
        return (real: root.real *! down, imag: root.imag *! down)
    t: B64 = ((r *! 0.5) +! (me.real.abs() *! 0.5)).sqrt_unchecked()
    if not me.real.is_sign_negative()
        return (real: t, imag: me.imag /! (t +! t))
    return (real: me.imag.abs() /! (t +! t), imag: t.copysign(me.imag))

### The arcsine on the principal branch, Kahan's: real part atan(real / Re(√(1 - z) √(1 + z))), imaginary part
### asinh(Im(conj(√(1 - z)) √(1 + z))). On the cuts beyond ±1 the sign of a zero imaginary part picks the side.
### :returns: The arcsine.
### :throws: With a part that is not finite or larger than 2^509 it crashes where the textbook formula does
###     (`asin_textbook`).
routine C128.asin() -> Me
    if not (me.is_finite() and me.is_moderate())
        return me.asin_textbook()
    s1: Me = Me.sqrt_of(real: 1.0 -! me.real, imag: -me.imag)
    s2: Me = Me.sqrt_of(real: 1.0 +! me.real, imag: me.imag)
    den: B64 = (s1.real *! s2.real) -! (s1.imag *! s2.imag)
    re: B64 = atan2(y: me.real, x: den)
    im: B64 = ((s1.real *! s2.imag) -! (s1.imag *! s2.real)).asinh()
    return c128_finite(re, im)

### The arccosine on the principal branch, Kahan's: real part 2 atan(Re √(1 - z) / Re √(1 + z)), imaginary part
### asinh(Im(conj(√(1 + z)) √(1 - z))).
### :returns: The arccosine.
### :throws: With a part that is not finite or larger than 2^509 it crashes where the textbook formula does
###     (`acos_textbook`).
routine C128.acos() -> Me
    if not (me.is_finite() and me.is_moderate())
        return me.acos_textbook()
    s1: Me = Me.sqrt_of(real: 1.0 -! me.real, imag: -me.imag)
    s2: Me = Me.sqrt_of(real: 1.0 +! me.real, imag: me.imag)
    re: B64 = 2.0 *! atan2(y: s1.real, x: s2.real)
    im: B64 = ((s2.real *! s1.imag) -! (s2.imag *! s1.real)).asinh()
    return c128_finite(re, im)

### The inverse hyperbolic sine, -i asin(iz), on the principal branch.
### :returns: The inverse hyperbolic sine.
### :throws: With a part that is not finite or larger than 2^509 it crashes where the textbook formula does
###     (`asinh_textbook`).
routine C128.asinh() -> Me
    if not (me.is_finite() and me.is_moderate())
        return me.asinh_textbook()
    v: Me = (real: -me.imag, imag: me.real).asin()
    return (real: v.imag, imag: -v.real)

### The inverse hyperbolic cosine on the principal branch, Kahan's: real part asinh(Re(conj(√(z - 1)) √(z + 1))),
### imaginary part 2 atan(Im √(z - 1) / Re √(z + 1)).
### :returns: The inverse hyperbolic cosine.
### :throws: With a part that is not finite or larger than 2^509 it crashes where the textbook formula does
###     (`acosh_textbook`).
routine C128.acosh() -> Me
    if not (me.is_finite() and me.is_moderate())
        return me.acosh_textbook()
    s1: Me = Me.sqrt_of(real: me.real -! 1.0, imag: me.imag)
    s2: Me = Me.sqrt_of(real: me.real +! 1.0, imag: me.imag)
    re: B64 = ((s1.real *! s2.real) +! (s1.imag *! s2.imag)).asinh()
    im: B64 = 2.0 *! atan2(y: s1.imag, x: s2.real)
    return c128_finite(re, im)

### The inverse hyperbolic tangent on the principal branch: real part ln(((1 + real)² + imag²) / ((1 - real)² + imag²))
### / 4, as ln_1p(4 real / ((1 - real)² + imag²)) / 4 when |real| < 1/2 so nothing cancels, imaginary part
### atan2(2 imag, (1 - real)(1 + real) - imag²) / 2. On the cuts beyond ±1 the sign of a zero imaginary part picks the
### side.
### :returns: The inverse hyperbolic tangent.
### :throws: Crashes with `DivisionByZeroError` at the poles ±1. With a part that is not finite or larger than
###     2^509 it crashes where the textbook formula does (`atanh_textbook`).
routine C128.atanh() -> Me
    if not (me.is_finite() and me.is_moderate())
        return me.atanh_textbook()
    if me.imag == 0.0 and me.real.abs() == 1.0
        throw DivisionByZeroError()
    one_minus: B64 = 1.0 -! me.real
    one_plus: B64 = 1.0 +! me.real
    yy: B64 = me.imag *! me.imag
    den: B64 = (one_minus *! one_minus) +! yy
    re: B64 = when
        me.real.abs() < 0.5 => (4.0 *! me.real /! den).ln_1p_unchecked() *! 0.25
        else => (((one_plus *! one_plus) +! yy) /! den).ln_unchecked() *! 0.25
    x: B64 = (one_minus *! one_plus) -! yy
    im: B64 = atan2(y: 2.0 *! me.imag, x) *! 0.5
    return c128_finite(re, im)

### The arctangent, -i atanh(iz), on the principal branch.
### :returns: The arctangent.
### :throws: Crashes with `DivisionByZeroError` at the poles ±i. With a part that is not finite or larger than
###     2^509 it crashes where the textbook formula does (`atan_textbook`).
routine C128.atan() -> Me
    if not (me.is_finite() and me.is_moderate())
        return me.atan_textbook()
    v: Me = (real: -me.imag, imag: me.real).atanh()
    return (real: v.imag, imag: -v.real)

### The hyperbolic tangent, Kahan's: with t = tan(imag), β = 1 + t², s = sinh(real) and ρ = √(1 + s²), it is
### (β ρ s + i t) / (1 + β s²), with nothing to cancel. Where β s² is past the range the real part is ±1 and the
### imaginary part t / (β s²).
### :returns: The hyperbolic tangent.
### :throws: With a part that is not finite it crashes where the textbook formula does (`tanh_textbook`).
routine C128.tanh() -> Me
    if not me.is_finite()
        return me.tanh_textbook()
    t: B64 = me.imag.tan()
    beta: B64 = 1.0 +! (t *! t)
    s: B64 = me.real.sinh_unchecked()
    if s.abs() > B64.from_bits(0x5FC0000000000000)
        return (real: 1.0.copysign(me.real), imag: (t /! (beta *! s)) /! s)
    rho: B64 = (1.0 +! (s *! s)).sqrt_unchecked()
    den: B64 = 1.0 +! (beta *! s *! s)
    return c128_finite(re: (beta *! rho *! s) /! den, im: t /! den)

### The tangent, -i tanh(iz).
### :returns: The tangent.
### :throws: With a part that is not finite it crashes where the textbook formula does (`tan_textbook`).
routine C128.tan() -> Me
    if not me.is_finite()
        return me.tan_textbook()
    v: Me = (real: -me.imag, imag: me.real).tanh()
    return (real: v.imag, imag: -v.real)

### The principal square root of real + imag i, for the inverse functions.
### :param real: The real part.
### :param imag: The imaginary part.
### :returns: Its square root.
@inline
secret common routine C128.sqrt_of(real: B64, imag: B64) -> Me
    z: Me = (real: real, imag: imag)
    return z.sqrt()

### e to this power, e^real (cos imag + i sin imag), from the real exponential and the correctly rounded cosine and
### sine.
### Past the range a part is an infinity, not a crash (it is `exp_unchecked`), and a zero imaginary part stays as it is,
### so e^(real + 0i) is e^real + 0i.
### :returns: e to this power.
### :throws: With a part that is not finite it crashes where the textbook formula does (`exp_textbook`).
routine C128.exp() -> Me
    if not me.is_finite()
        return me.exp_textbook()
    e: B64 = me.real.exp_unchecked()
    im: B64 = when
        me.imag == 0.0 => me.imag
        else => e *! me.imag.sin()
    return (real: e *! me.imag.cos(), imag: im)

### The sine, sin real cosh imag + i cos real sinh imag, from the correctly rounded real functions. A zero real part
### stays as it is.
### :returns: The sine.
### :throws: Crashes with `NumericOverflowError` when a part is past B64's range. With a part that is not finite it
###     crashes where the textbook formula does (`sin_textbook`).
routine C128.sin() -> Me
    if not me.is_finite()
        return me.sin_textbook()
    re: B64 = when
        me.real == 0.0 => me.real
        else => me.real.sin() *! me.imag.cosh_unchecked()
    return c128_finite(re, im: me.real.cos() *! me.imag.sinh_unchecked())

### The cosine, cos real cosh imag - i sin real sinh imag, from the correctly rounded real functions. A zero real part
### gives a zero imaginary part with the sign -real × imag has.
### :returns: The cosine.
### :throws: Crashes with `NumericOverflowError` when a part is past B64's range. With a part that is not finite it
###     crashes where the textbook formula does (`cos_textbook`).
routine C128.cos() -> Me
    if not me.is_finite()
        return me.cos_textbook()
    im: B64 = when
        me.real == 0.0 and me.imag.is_sign_negative() => me.real
        me.real == 0.0 => -me.real
        else => -(me.real.sin() *! me.imag.sinh_unchecked())
    return c128_finite(re: me.real.cos() *! me.imag.cosh_unchecked(), im)

### The hyperbolic sine, sinh real cos imag + i cosh real sin imag, from the correctly rounded real functions. Past
### the range a part is an infinity, not a crash (it is `sinh_unchecked`), and a zero imaginary part stays as it is.
### :returns: The hyperbolic sine.
### :throws: With a part that is not finite it crashes where the textbook formula does (`sinh_textbook`).
routine C128.sinh() -> Me
    if not me.is_finite()
        return me.sinh_textbook()
    im: B64 = when
        me.imag == 0.0 => me.imag
        else => me.real.cosh_unchecked() *! me.imag.sin()
    return (real: me.real.sinh_unchecked() *! me.imag.cos(), imag: im)

### The hyperbolic cosine, cosh real cos imag + i sinh real sin imag, from the correctly rounded real functions. Past
### the range a part is an infinity, not a crash (it is `cosh_unchecked`), and a zero imaginary part gives a zero
### imaginary part with the sign real × imag has.
### :returns: The hyperbolic cosine.
### :throws: With a part that is not finite it crashes where the textbook formula does (`cosh_textbook`).
routine C128.cosh() -> Me
    if not me.is_finite()
        return me.cosh_textbook()
    im: B64 = when
        me.imag == 0.0 and me.real.is_sign_negative() => -me.imag
        me.imag == 0.0 => me.imag
        else => me.real.sinh_unchecked() *! me.imag.sin()
    return (real: me.real.cosh_unchecked() *! me.imag.cos(), imag: im)

### The textbook formula, kept for operands that are not finite: it crashes where RazorForge's did before C98.
### The principal square root (real part >= 0), from half the modulus plus and minus the real part. The imaginary part
### takes the sign of this imaginary part, so -0 and +0 pick the two sides of the cut along the negative reals.
### :returns: The principal square root.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
secret routine C128.sqrt_textbook() -> Me
    r: B64 = me.abs()

    if r == 0.0
        return (real: 0.0, imag: 0.0)
    rp: B64 = r.add_finite(me.real).truediv_finite(2.0).sqrt_unchecked()
    ip: B64 = r.sub_finite(me.real).truediv_finite(2.0).sqrt_unchecked()
    if me.imag < 0.0
        return (real: rp, imag: -ip)
    return (real: rp, imag: ip)

### This number to the complex power `power`, exp(power × ln me).
### :param power: The complex exponent.
### :returns: This number to the power `power`.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
routine C128.pow(power: Me) -> Me
    r: Me = (power * me.ln()).exp()
    return c128_finite(re: r.real, im: r.imag)

### This number to the integer power n, by repeated squaring: each product rounds once, with no ln and exp. A
### negative n starts from the reciprocal, and n = 0 gives 1. The base is squared once more after the last product,
### as RazorForge's loop does, so that squaring can overflow too.
### :param n: The integer exponent.
### :returns: This number to the power `n`.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, with `NumericDomainError` when
###     one is NaN, or with `DivisionByZeroError` when it divides a nonzero value by zero.
routine C128.powi(n: S64) -> Me
    result: &Me <- Me.one()
    k: U64 = n.to_wrap[U64]()
    base: &Me <- me

    left: U64 = when
        not (n < 0) => k
        else =>
            me.reciprocal().poke_into(base)
            becomes U64.sub_wrap(0, k)

    until left2 == 0 with left2: U64 = left
        if left2 & 1 == 1
            (result.load() * base.load()).poke_into(result)
        (base.load() * base.load()).poke_into(base)
        continue with left2: left2 >> 1
    then
        return result.load()

### The number at distance r and angle theta: r cos θ + i r sin θ.
### :param r: The distance from 0.
### :param theta: The angle, in radians.
### :returns: The number r cos θ + i r sin θ.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
common routine C128.from_polar(r: B64, theta: B64) -> Me
    re: B64 = r.mul_finite(theta.cos())
    im: B64 = r.mul_finite(theta.sin())
    return (real: re, imag: im)

### Both parts in Words, the way an export hands a C128 back: the real part's bits in w0, the imaginary part's in w1.
### :returns: The real part in w0, the imaginary part in w1, and zero in w2 and w3.
@inline
routine C128.words() -> Words
    return Words.construct(a: me.real, b: me.imag, c: 0.0, d: 0.0)

# The exports RazorForge's C128 calls.

### The product, for C128.mul.
### :param real: The first number's real part.
### :param imag: The first number's imaginary part.
### :param other_real: The second number's real part.
### :param other_imag: The second number's imaginary part.
### :returns: The result's real part in w0, its imaginary part in w1, and zero in w2 and w3.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c128_mul")
@inline
routine c128_mul(real: B64, imag: B64, other_real: B64, other_imag: B64) -> Words
    z: C128 = (real: real, imag: imag)
    w: C128 = (real: other_real, imag: other_imag)
    return (z * w).words()

### The quotient, for C128.truediv.
### :param real: The first number's real part.
### :param imag: The first number's imaginary part.
### :param other_real: The second number's real part.
### :param other_imag: The second number's imaginary part.
### :returns: The result's real part in w0, its imaginary part in w1, and zero in w2 and w3.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN. Dividing by 0 + 0i is a `DivisionByZeroError`, and 0 / (0 + 0i) a `NumericDomainError`, as
###     with real division. A nonzero divisor whose squared modulus underflows to zero divides a nonzero value by
###     zero, a `DivisionByZeroError` too.
@export("ingrid_c128_div")
@inline
routine c128_div(real: B64, imag: B64, other_real: B64, other_imag: B64) -> Words
    z: C128 = (real: real, imag: imag)
    w: C128 = (real: other_real, imag: other_imag)
    return (z / w).words()

### The first number to the power of the second, for C128.pow.
### :param real: The first number's real part.
### :param imag: The first number's imaginary part.
### :param other_real: The second number's real part.
### :param other_imag: The second number's imaginary part.
### :returns: The result's real part in w0, its imaginary part in w1, and zero in w2 and w3.
### :throws: Crashes with `NumericOverflowError` when an intermediate result is infinite, or with `NumericDomainError`
###     when one is NaN.
@export("ingrid_c128_pow")
@inline
routine c128_pow(real: B64, imag: B64, other_real: B64, other_imag: B64) -> Words
    z: C128 = (real: real, imag: imag)
    w: C128 = (real: other_real, imag: other_imag)
    return (z ** w).words()

