// Word division for the standard library's wide integers: (hi × 2^64 + lo) / d with hi < d. On x86-64 it is the
// hardware divq, elsewhere Möller–Granlund division by a precomputed reciprocal of a normalized d (its top bit set),
// with no divide instruction (Möller & Granlund, "Improved division by invariant integers", algorithm 4, and the
// reciprocal of algorithm 3 as intx writes it). In every module, so each inlines into its caller.

/// rf_reciprocal_word's seed table: t[i] = 0x7fd00 / (i + 256).
preset RECIPROCAL_SEED: @Array<U16, 256> <- { 2045, 2037, 2029, 2021, 2013, 2005, 1998, 1990, 1983,
    1975, 1968, 1960, 1953, 1946, 1938, 1931, 1924, 1917, 1910, 1903, 1896, 1889, 1883, 1876, 1869,
    1863, 1856, 1849, 1843, 1836, 1830, 1824, 1817, 1811, 1805, 1799, 1792, 1786, 1780, 1774, 1768,
    1762, 1756, 1750, 1745, 1739, 1733, 1727, 1722, 1716, 1710, 1705, 1699, 1694, 1688, 1683, 1677,
    1672, 1667, 1661, 1656, 1651, 1646, 1641, 1636, 1630, 1625, 1620, 1615, 1610, 1605, 1600, 1596,
    1591, 1586, 1581, 1576, 1572, 1567, 1562, 1558, 1553, 1548, 1544, 1539, 1535, 1530, 1526, 1521,
    1517, 1513, 1508, 1504, 1500, 1495, 1491, 1487, 1483, 1478, 1474, 1470, 1466, 1462, 1458, 1454,
    1450, 1446, 1442, 1438, 1434, 1430, 1426, 1422, 1418, 1414, 1411, 1407, 1403, 1399, 1396, 1392,
    1388, 1384, 1381, 1377, 1374, 1370, 1366, 1363, 1359, 1356, 1352, 1349, 1345, 1342, 1338, 1335,
    1332, 1328, 1325, 1322, 1318, 1315, 1312, 1308, 1305, 1302, 1299, 1295, 1292, 1289, 1286, 1283,
    1280, 1276, 1273, 1270, 1267, 1264, 1261, 1258, 1255, 1252, 1249, 1246, 1243, 1240, 1237, 1234,
    1231, 1228, 1226, 1223, 1220, 1217, 1214, 1211, 1209, 1206, 1203, 1200, 1197, 1195, 1192, 1189,
    1187, 1184, 1181, 1179, 1176, 1173, 1171, 1168, 1165, 1163, 1160, 1158, 1155, 1153, 1150, 1148,
    1145, 1143, 1140, 1138, 1135, 1133, 1130, 1128, 1125, 1123, 1121, 1118, 1116, 1113, 1111, 1109,
    1106, 1104, 1102, 1099, 1097, 1095, 1092, 1090, 1088, 1086, 1083, 1081, 1079, 1077, 1074, 1072,
    1070, 1068, 1066, 1064, 1061, 1059, 1057, 1055, 1053, 1051, 1049, 1047, 1044, 1042, 1040, 1038,
    1036, 1034, 1032, 1030, 1028, 1026, 1024 }

/// The high word of a × b.
#inline
routine high(a: U64, b: U64) -> U64
    block entry()
        product : U128 = a.to<U128>().mul(b.to<U128>())
        return(product.shr(64).to_wrap<U64>())

/// The reciprocal of a normalized d (top bit set), for rf_udivrem_128_64_pre. On x86-64 the divide is hardware and
/// this is 0.
#[export("rf_reciprocal_word"), target(arch: "x86_64")]
routine rf_reciprocal_word(d: U64) -> U64
    block entry()
        return(0)

#[export("rf_reciprocal_word"), target(arch: not "x86_64")]
routine rf_reciprocal_word(d: U64) -> U64
    block entry()
        d9        : U64  = d.shr(55)
        v0        : U64  = RECIPROCAL_SEED.getitem(d9.sub(256).to<USize>()).to<U64>()
        d40       : U64  = d.shr(24).add(1)
        v0sq_d40  : U64  = v0.mul_wrap(v0).mul_wrap(d40)
        v1a       : U64  = v0.shl(11).sub_wrap(v0sq_d40.shr(40))
        v1        : U64  = v1a.sub_wrap(1)
        v2        : U64  = v1.shl(13).add_wrap(v1.mul_wrap(0x1000000000000000.sub_wrap(v1.mul_wrap(d40))).shr(47))
        d0        : U64  = d.bitand(1)
        d63       : U64  = d.shr(1).add(d0)
        v2_masked : U64  = v2.shr(1).bitand(0.sub_wrap(d0))
        e         : U64  = v2_masked.sub_wrap(v2.mul_wrap(d63))
        v3a       : U64  = high(v2, e)
        v3        : U64  = v3a.shr(1).add_wrap(v2.shl(31))
        v3d       : U128 = v3.to<U128>().mul_wrap(d.to<U128>())
        t         : U128 = v3d.add_wrap(d.to<U128>())
        v4        : U64  = v3.sub_wrap(t.shr(64).to_wrap<U64>()).sub_wrap(d)
        return(v4)

/// (hi × 2^64 + lo) / d for hi < d and d normalized, with v = rf_reciprocal_word(d): the quotient, and the
/// remainder through rem.
#[export("rf_udivrem_128_64_pre"), target(arch: "x86_64")]
routine rf_udivrem_128_64_pre(hi: U64, lo: U64, d: U64, v: U64, rem: @U64) -> U64
    block entry()
        q, r = divq(hi, lo, d)
        rem.store(r)
        return(q)

#[export("rf_udivrem_128_64_pre"), target(arch: not "x86_64")]
routine rf_udivrem_128_64_pre(hi: U64, lo: U64, d: U64, v: U64, rem: @U64) -> U64
    block entry()
        vh         : U128 = v.to<U128>().mul_wrap(hi.to<U128>())
        hi_shifted : U128 = hi.to<U128>().shl(64)
        n          : U128 = hi_shifted.bitor(lo.to<U128>())
        q          : U128 = vh.add_wrap(n)
        q_hi       : U64  = q.shr(64).to_wrap<U64>()
        q1         : U64  = q_hi.add_wrap(1)
        q0         : U64  = q.to_wrap<U64>()
        r          : U64  = lo.sub_wrap(q1.mul_wrap(d))
        branch r.gt(q0)
            ? back(q1.sub_wrap(1), r.add_wrap(d))
            : back(q1, r)

    block back(q1: U64, r: U64)
        branch r.ge(d)
            ? done(q1.add_wrap(1), r.sub_wrap(d))
            : done(q1, r)

    block done(q1: U64, r: U64)
        rem.store(r)
        return(q1)

/// (hi × 2^64 + lo) / d for hi < d, without a reciprocal (benchmarks compare it against the reciprocal form).
#[export("rf_udivrem_128_64"), target(arch: "x86_64")]
routine rf_udivrem_128_64(hi: U64, lo: U64, d: U64, rem: @U64) -> U64
    block entry()
        q, r = divq(hi, lo, d)
        rem.store(r)
        return(q)

#[export("rf_udivrem_128_64"), target(arch: not "x86_64")]
routine rf_udivrem_128_64(hi: U64, lo: U64, d: U64, rem: @U64) -> U64
    block entry()
        hi_shifted : U128 = hi.to<U128>().shl(64)
        n          : U128 = hi_shifted.bitor(lo.to<U128>())
        rem.store(n.mod(d.to<U128>()).to_wrap<U64>())
        return(n.div(d.to<U128>()).to_wrap<U64>())
