# The crash handler for every RazorForge and Suflae program. Ingrid's Tessera code reaches it when a check fails
# (an overflow, an index out of bounds, a failed allocation): Standard/Core's crash calls tessera_crash_handler,
# and this definition takes the place of the standard library's weak default. It reports a Tessera crash the way
# RazorForge's crash report does (Core's crash_report): the crash's name (the RazorForge crashable it
# matches, such as IntegerOverflowError) and its message, where it happened, the calling thread's crash trace, then
# exit status 82, through the same runtime calls. A stack overflow is reported here too (stack_overflow_report).

import Standard/Format
import Standard/Os

### How many of the most recent frames may come before the repeating calls (the routine the stack ran out in, such as
### an add the recursive routine called), and the longest repeating run of calls looked for.
preset CYCLE_MAX_START:  S32 = 4

preset CYCLE_MAX_PERIOD: S32 = 12

### One frame of the crash trace, laid out as the builder keeps it: the routine's name and the source file as C
### strings, and the line and column the routine has reached.
secret record TraceFrame
    routine_name: Addr
    file: Addr
    line: S32
    column: S32

### Makes a `TraceFrame` from its fields.
### :param routine_name: Its `routine_name`.
### :param file: Its `file`.
### :param line: Its `line`.
### :param column: Its `column`.
### :returns: The new value.
secret routine TraceFrame.construct(routine_name: Addr, file: Addr, line: S32, column: S32) -> Me
    return Me(routine_name, file, line, column)

### Releases nothing: a `TraceFrame` holds no memory of its own.
secret routine TraceFrame.destruct(me: @Me) -> None
    return

### Flushes standard output, so what the program printed comes before the report.
@external("c")
@symbol("rf_flush_output")
secret routine rf_flush_output() -> None

### Exits with the crash status.
@external("c")
@symbol("rf_crash_exit")
@noreturn
secret routine rf_crash_exit() -> None

### How many frames the calling thread's crash trace has pushed (0 for a build that keeps no trace).
### :returns: The trace's depth.
@external("c")
@symbol("_rf_trace_get_depth_shared")
secret routine trace_depth() -> S32

### The calling thread's 32 trace frames, a ring: the most recent is at (depth - 1) mod 32.
### :returns: The address of the first of the 32 frames.
@external("c")
@symbol("_rf_trace_get_frames_shared")
secret routine trace_frames() -> @TraceFrame

### Reports a crash and exits with the crash status (82): flushes standard output, then writes to standard error, in
### red, the crash's name and message, where it happened (unless `place` is null), and the calling thread's crash
### trace. Standard/Core's crash calls it in place of the standard library's weak default.
### :param name: The crash's name, such as `IntegerOverflowError`.
### :param message: What went wrong.
### :param place: Where it happened, or null when that isn't known.
@export("tessera_crash_handler")
@noreturn
routine crash_handler(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    rf_flush_output()
    if Console.errors().is_terminal()
        Console.alert("[91m", end: "")
    write_title(name)
    Console.alert(": {message}", end: "")
    if not place.is_hollow()
        file: @[Byte] = place.file.peek()
        line: U32 = place.line.peek()
        column: U32 = place.column.peek()
        Console.alert("\nat {file}:{line}:{column}", end: "")
    Console.alert("")
    write_trace()
    if Console.errors().is_terminal()
        Console.alert("[0m", end: "")
    rf_crash_exit()

### Writes a crash's name as its title, the way a crashable's crash_title reads: `IntegerOverflowError` as
### "Integer overflow error" (a space before each capital after the first, which becomes lowercase). One byte at a
### time, with nothing allocated: it runs because something crashed, possibly out of memory.
### :param name: The crash's name.
routine write_title(name: @[Byte]) -> None
    local one: @U8 <- 0

    each i in 0 til name.count
        c: U8 = name.byte_at(i)
        capital: Bool = c >= 65 and c <= 90
        new_word: Bool = capital and i > 0
        c2: U8 = when
            new_word =>
                one.poke(32)
                Console.errors().write_bytes(data: one.to[@Byte](), count: 1)
                becomes c + 32
            else => c
        one.poke(c2)
        Console.errors().write_bytes(data: one.to[@Byte](), count: 1)
    then
        return

### A stack overflow, reported like any crash (exit status 82): which routines kept calling, then the trace (which
### says how deep the calls went). The runtime's fault handler calls it on the faulting thread, in the stack the
### system keeps back for it.
### :param stack_size: The size of the stack the calls used up, in bytes. The report does not show it: the size of the
###     stack says nothing about the program's mistake.
@export("tessera_stack_overflow_report")
@noreturn
routine stack_overflow_report(stack_size: U64) -> None
    rf_flush_output()
    if Console.errors().is_terminal()
        Console.alert("[91m", end: "")
    Console.alert("Stack overflow error: ", end: "")
    write_deep_calls()
    write_trace()
    if Console.errors().is_terminal()
        Console.alert("[0m", end: "")
    rf_crash_exit()

### Suflae's report for the same event: Suflae has no "stack" in its vocabulary, so it is an out of memory error that
### says which routines kept calling.
### :param memory_size: The size of the memory the calls used up, in bytes. Not shown, like the stack's size.
@export("tessera_deep_calls_report")
@noreturn
routine deep_calls_report(memory_size: U64) -> None
    rf_flush_output()
    if Console.errors().is_terminal()
        Console.alert("[91m", end: "")
    Console.alert("Out of memory error: ", end: "")
    write_deep_calls()
    write_trace()
    if Console.errors().is_terminal()
        Console.alert("[0m", end: "")
    rf_crash_exit()

### The sentence of a call-depth crash: the routine that called itself too many times before returning, or the
### routines that called each other, found as the run of calls that repeats at the top of the crash trace. Without a
### trace, or without a repeating run, it says the calls went too deep.
routine write_deep_calls() -> None
    local depth: S32 = trace_depth()
    local shown: S32 = depth.min(32)

    # the repeating run may start a few frames below the most recent one
    while start <= CYCLE_MAX_START with start: S32 = 0
        period: S32 = cycle_period(depth, shown, start)
        if period > 0
            if one_routine(depth, start, period)
                name: @[Byte] = frame_name(depth, k: start)
                Console.alert("{name} called itself too many times before returning. ", end: "")
            else
                # the names in the run, most recent first: "a and b", "a, b and c"
                last: S32 = start + period - 1
                while k < last with k: S32 = start
                    n: @[Byte] = frame_name(depth, k)
                    if k + 1 == last
                        Console.alert("{n} and ", end: "")
                    else
                        Console.alert("{n}, ", end: "")
                    continue with k: k + 1
                then
                    final: @[Byte] = frame_name(depth, k)
                    Console.alert("{final} called each other too many times before returning. ", end: "")
            break
        continue with start: start + 1
    then
        # left by its own end: no frame started a repeating run
        if start > CYCLE_MAX_START
            Console.alert("the routine calls went too deep before returning. ", end: "")
    Console.alert("Make the recursion shallower, or turn it into a loop.")
    return

### The k-th most recent frame of the calling thread's crash trace (0 is the most recent, below 32).
### :param depth: The trace's depth.
### :param k: How far back the frame is.
### :returns: The frame.
routine recent_frame(depth: S32, k: S32) -> @TraceFrame
    back: S32 = depth -% 1 -% k
    slot: U64 = (back & 31).to[U64]()
    at: @TraceFrame = trace_frames().stride(slot)
    return at

### Whether two frames are the same call: the same routine, stopped at the same line.
### :param a: One frame.
### :param b: The other.
### :returns: True for the same call.
routine same_call(a: @TraceFrame, b: @TraceFrame) -> Bool
    a_routine: U64 = ptrtoint[Addr, U64](a.routine_name.peek())
    b_routine: U64 = ptrtoint[Addr, U64](b.routine_name.peek())
    same_routine: Bool = a_routine == b_routine
    same_line: Bool = a.line.peek() == b.line.peek()
    return same_routine and same_line

### The shortest run of calls that repeats from frame `start` down through every frame the trace kept, at least twice
### over, or 0 when none does.
### :param depth: The trace's depth.
### :param shown: How many frames the trace kept.
### :param start: The most recent frame of the run.
### :returns: The run's length, or 0.
routine cycle_period(depth: S32, shown: S32, start: S32) -> S32
    while period <= CYCLE_MAX_PERIOD with period: S32 = 1
        # the frames compared against the run must hold it at least twice
        if shown - start < period * 3
            return 0

        while k + period < shown with k: S32 = start
            if same_call(a: recent_frame(depth, k), b: recent_frame(depth, k: k + period))
                continue with k: k + 1
            else
                break
        then
            # every frame compared matched
            if k + period >= shown
                return period

        continue with period: period + 1
    then
        return 0

### Whether every call in the run is the same routine (a routine that calls itself from two places, such as a tree
### walk's two halves).
### :param depth: The trace's depth.
### :param start: The most recent frame of the run.
### :param period: The run's length.
### :returns: True when the run has one routine.
routine one_routine(depth: S32, start: S32, period: S32) -> Bool
    local first: U64 = ptrtoint[Addr, U64](recent_frame(depth, k: start).routine_name.peek())

    each k in start + 1 til start + period
        routine_address: U64 = ptrtoint[Addr, U64](recent_frame(depth, k).routine_name.peek())
        if routine_address == first
            continue
        else
            return false
    then
        return true

### A frame's routine name without its parameter list: `OverflowRf.dive(Core.S64)` is `OverflowRf.dive`.
### :param depth: The trace's depth.
### :param k: How far back the frame is.
### :returns: The name.
routine frame_name(depth: S32, k: S32) -> @[Byte]
    local routine_ptr: @CChar = recent_frame(depth, k).routine_name.peek().to[@CChar]()
    local name: @[Byte] = routine_ptr.to[CStr]().getview()

    each i in 0 til name.count()
        # '('
        if name.byte_at(i) == 40
            return name.slice(start: 0, end: i)
        else
            continue
    then
        return name

### The calling thread's crash trace, most recent frame first: the last 32 frames, and how many there were in all when
### there were more. Nothing for a build that keeps no trace.
routine write_trace() -> None
    local depth: S32 = trace_depth()
    local shown: S32 = depth.min(32)

    if depth <= 0
        # The frames, most recent first.
        # A trace keeps 32 frames, and says how many there were in all when there were more.
        return
    else
        Console.alert("Stack trace:")
        each i in 0 til shown
            back: S32 = depth -% 1 -% i
            slot: U64 = (back & 31).to[U64]()
            frames: @TraceFrame = trace_frames()
            at: @TraceFrame = frames.stride(slot)
            routine_ptr: @CChar = at.routine_name.peek().to[@CChar]()
            file_ptr: @CChar = at.file.peek().to[@CChar]()
            routine_name: @[Byte] = routine_ptr.to[CStr]().getview()
            file: @[Byte] = file_ptr.to[CStr]().getview()
            line: S32 = at.line.peek()
            column: S32 = at.column.peek()
            Console.alert("  {i}: at {routine_name} ({file}:{line}:{column})")
        if not (depth > 32)
            return
        else
            Console.alert("  ... ({depth} frames total)")
            return
