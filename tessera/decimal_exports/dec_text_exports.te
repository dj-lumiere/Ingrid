# The text of the decimals RazorForge and Suflae call (dec_text.te): a value's text written as U32 code points into
# the caller's buffer, and text read back from code points. A routine that writes returns how many code points the
# text has, and when that is more than the room it wrote only what fit.

module Ingrid/Decimal/Exports

import Ingrid/Abi
import Ingrid/Decimal

### The text of a decimal given its fields, in one of the styles of `write_decimal_text`: 0 scientific (D32, D64, and
### D128), 1 scientific without fractional trailing zeros (Decimal), 2 exactly `places` digits after the point, 3 the
### `diagnose` text (`places` 32, 64, or 128 for D32, D64, or D128, 0 for Decimal), 4 Decimal's digits after the point.
### :param sign: 1 for a negative value, else 0.
### :param special: 0 finite, 1 an infinity, 2 a quiet NaN, 3 a signaling NaN.
### :param exp: The exponent of a finite value.
### :param c_low: The low 64 bits of the coefficient.
### :param c_high: The high 64 bits of the coefficient.
### :param style: 0 scientific, 1 scientific without fractional trailing zeros, 2 digits after the point, 3 the
###     `diagnose` text, 4 Decimal's digits after the point.
### :param places: The digits after the point for styles 2 and 4, the type for style 3.
### :param out: Where the code points go.
### :param out_count: How many code points `out` has room for.
### :returns: How many code points the text has: more than `out_count` when it didn't fit, and only that much was
###     written.
@export("ingrid_decimal_text_utf32")
routine decimal_text_utf32(sign: U32, special: U32, exp: S64, c_low: U64, c_high: U64, style: U32,
    places: U64, out: @U32, out_count: U64) -> U64
    writer: &Utf32Writer <- .construct(data: out, capacity: out_count)

    coeff: U128 = (c_high.to[U128]() << 64) | c_low.to[U128]()
    fields: DecimalFields = (negative: sign == 1, special: special, exp: exp, coeff: coeff)
    write_decimal_text(out: writer, fields, style, places)
    return writer.written()

### Reads decimal text into its fields without rounding (dec_scan).
### :param chars: The text's first code point (anything when `count` is 0).
### :param count: How many code points.
### :returns: In w0, 1 when the text is not a number, else the sign (1 negative) in bits 8 and up and the special kind
###     (0 finite, 1 an infinity, 2 a NaN) in bits 16 and up. The coefficient's low 64 bits in w1, its high 64 in w2,
###     the exponent's bits in w3.
@export("ingrid_decimal_scan_utf32")
routine decimal_scan_utf32(chars: @U32, count: U64) -> Words
    scanned: DecScanned = dec_scan(chars: DecPoints(data: chars, count))

    if scanned.bad
        return (w0: 1, w1: 0, w2: 0, w3: 0)
    flags: U64 = (scanned.negative.to[U64]() << 8) | (scanned.special.to[U64]() << 16)
    return (w0: flags, w1: scanned.coeff.to_wrap[U64](), w2: (scanned.coeff >> 64).to_wrap[U64](), w3: scanned.exp.to_wrap[U64]())
