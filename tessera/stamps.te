# The fetch of RazorForge's `Stamped[E]` (Standard/System/Memory/Stamped.rf). This library is llvm-linked into each
# RazorForge module, so an optimized build inlines the fetch into the program: no call per fetch. The table is the
# Tessera PoolManager's, which lives in the runtime library (Ingrid/runtime-tessera/stamps.te takes and ends slots
# there). Its directory address and its next-slot bound are exported by the runtime under C names, and this file reads
# them the way `PoolManager.lookup` does (Tessera's Standard/System/Memory/Stamped.te).

### The address of the stamp table's directory: one Addr per chunk of 4,096 entries. Set before the first slot is
### taken, so it is never read while it is still zero.
@external("c")
@symbol("tessera_stamp_directory")
secret global STAMP_DIRECTORY: &Addr

### The slot after the last one ever taken, 0 before the first. Every slot below it has an entry in a chunk.
@external("c")
@symbol("tessera_stamp_next")
secret global STAMP_NEXT: &U32

### One entry of the table: 16 bytes, the layout of the PoolManager's own entry.
secret record StampEntry
    ### The entity's address while it lives, zero after it ends.
    at: Addr
    ### Goes up each time the entity in the slot ends.
    generation: U32
    ### The next free slot after this one, while this one is free.
    next_free: U32

### The address of the entity a stamp was taken of, or zero once it has ended. A slot at or past the next-slot bound
### (a stamp no `stamp()` made) is zero without a read of the table, so a stamp never reads outside it. Slot 0's entry
### is all zero, so it is zero too. One read of the entry: on one thread nothing ends the entity between the reads.
### :param slot: The stamp's slot.
### :param generation: The stamp's generation.
### :returns: The address, or zero.
@export("rf_stamp_fetch")
routine rf_stamp_fetch(slot: U32, generation: U32) -> Addr
    if slot >= STAMP_NEXT.peek()
        return Addr.zero()
    directory: @Addr = bitcast[Addr, @Addr](STAMP_DIRECTORY.peek())
    chunk: Addr = directory.stride((slot >> 12).to[U64]()).peek()
    entry: @StampEntry = bitcast[Addr, @StampEntry](chunk).stride((slot & 4095).to[U64]())
    if entry.generation.peek() != generation
        return Addr.zero()
    return entry.at.peek()
