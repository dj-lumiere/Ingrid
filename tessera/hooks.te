# What Suflae's ObjectHacker change hooks keep for the whole program: how many objects have hooks, and the registry
# that finds an object's hooks. The builder puts a test of the count before every change of an entity's member
# variable in a program that imports ObjectHacker, so a program with no hooks pays one load and one branch per change.
# The registry itself is an ObjectHacker entity, and only its address is kept here.

### How many objects have change hooks right now.
global HOOKED: &U64

### The controller of ObjectHacker's hook registry, null until the first hook.
global HOOK_REGISTRY: &Addr

### Whether any object has change hooks.
### :returns: True when at least one does.
@export("ingrid_hooks_any")
@inline
routine hooks_any() -> Bool
    return HOOKED.peek_unbroken() != 0

### Sets how many objects have change hooks.
### :param count: The new count.
@export("ingrid_hooks_set_count")
routine hooks_set_count(count: U64) -> None
    HOOKED.poke_unbroken(count)
    return

### The controller of the hook registry.
### :returns: Its address, or null before the first hook.
@export("ingrid_hooks_registry")
routine hooks_registry() -> Addr
    return HOOK_REGISTRY.peek_unbroken()

### Keeps the controller of the hook registry.
### :param registry: Its address.
@export("ingrid_hooks_set_registry")
routine hooks_set_registry(registry: Addr) -> None
    HOOK_REGISTRY.poke_unbroken(registry)
    return
