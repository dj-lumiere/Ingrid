// How an Ingrid export hands RazorForge a result wider than one register (a C128, a Q128, a Q256, a B128, or several
// values at once).
//
// A small record of floats crosses a call by rules that differ between targets (Win64 passes 16 bytes through
// memory, System V splits them over two registers, AArch64 passes up to four floats of one type as a homogeneous
// float aggregate), and the two builders that meet at the call write those rules in different LLVM forms. Four U64
// words make 32 bytes of integers, which every target returns through a hidden pointer the caller passes, in the
// same form from both builders. RazorForge declares the same record (IngridWords in Core/NativeDeclarations.rf) and
// reads each float back from its word's bits: a B64 fills a word, a B32 the word's low half.

/// Four 64-bit words, returned through a hidden pointer on every target.
record Words
    w0: U64
    w1: U64
    w2: U64
    w3: U64

/// Four B32s, one in the low half of each word.
/// :param a: The B32 for `w0`.
/// :param b: The B32 for `w1`.
/// :param c: The B32 for `w2`.
/// :param d: The B32 for `w3`.
/// :returns: The words, each B32's bits zero-extended.
#inline
routine Words.construct(a: B32, b: B32, c: B32, d: B32) -> Me
    block entry()
        w0: U64 = a.bits().to[U64]()
        w1: U64 = b.bits().to[U64]()
        w2: U64 = c.bits().to[U64]()
        w3: U64 = d.bits().to[U64]()
        return((w0: w0, w1: w1, w2: w2, w3: w3))

/// Four B64s, one in each word.
/// :param a: The B64 for `w0`.
/// :param b: The B64 for `w1`.
/// :param c: The B64 for `w2`.
/// :param d: The B64 for `w3`.
/// :returns: The words, each holding one B64's bits.
#inline
routine Words.construct(a: B64, b: B64, c: B64, d: B64) -> Me
    block entry()
        return((w0: a.bits(), w1: b.bits(), w2: c.bits(), w3: d.bits()))

/// Two B128s, each as its low 64 bits and then its high 64 bits: a in w0 and w1, b in w2 and w3.
/// :param a: The B128 for `w0` and `w1`.
/// :param b: The B128 for `w2` and `w3`.
/// :returns: The words.
#inline
routine Words.construct(a: B128, b: B128) -> Me
    block entry()
        a_bits: U128 = a.bits()
        b_bits: U128 = b.bits()
        w0: U64 = a_bits.to_wrap[U64]()
        w1: U64 = a_bits.shr(64).to_wrap[U64]()
        w2: U64 = b_bits.to_wrap[U64]()
        w3: U64 = b_bits.shr(64).to_wrap[U64]()
        return((w0: w0, w1: w1, w2: w2, w3: w3))

/// A B128 in Words, the way an export hands one back: its low 64 bits in w0, its high 64 bits in w1.
/// :param v: The value.
/// :returns: The words, with `w2` and `w3` zero.
#inline
routine b128_words(v: B128) -> Words
    block entry()
        bits: U128 = v.bits()
        low: U64 = bits.to_wrap[U64]()
        high: U64 = bits.shr(64).to_wrap[U64]()
        return((w0: low, w1: high, w2: 0, w3: 0))

/// The B128 whose bits are high × 2^64 + low, the way an export takes one: a B128 is a 128-bit integer to the C
/// ABI, which Win64 passes by pointer from Tessera and by value from RazorForge, so neither side passes one whole.
/// :param low: The low 64 bits.
/// :param high: The high 64 bits.
/// :returns: The B128.
#inline
routine b128_from_halves(low: U64, high: U64) -> B128
    block entry()
        top: U128 = high.to[U128]().shl(64)
        bits: U128 = top.bitor(low.to[U128]())
        return(B128.from_bits(bits))
