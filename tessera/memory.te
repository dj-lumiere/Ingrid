# The heap allocation the builder's code and the standard library call: zeroed or not, reallocated, freed, copied,
# filled, and a scratch region released in bulk. They are in every module (this library is llvm-linked into each),
# so the optimizer sees through them to malloc / calloc / free.
#
# An allocation that fails is a runtime error (OutOfMemoryError) with the crash report, never a null pointer that
# would crash later with no diagnosis.

import Hosted

### C's calloc: `count` zeroed values of `size` bytes each.
### :param count: How many values.
### :param size: The size of one value, in bytes.
### :returns: The memory, or null when the allocation fails.
@external("c")
@symbol("calloc")
secret routine c_calloc(count: CSize, size: CSize) -> Addr

### C's malloc: `size` bytes, not initialized.
### :param size: How many bytes.
### :returns: The memory, or null when the allocation fails.
@external("c")
@symbol("malloc")
secret routine c_malloc(size: CSize) -> Addr

### C's realloc: resizes the block at `ptr` to `size` bytes, keeping its contents up to the smaller size.
### :param ptr: The block, or null to allocate a new one.
### :param size: The new size, in bytes.
### :returns: The block, maybe moved, or null when the allocation fails. It may be null when `size` is 0.
@external("c")
@symbol("realloc")
secret routine c_realloc(ptr: Addr, size: CSize) -> Addr

### C's free: gives the block at `ptr` back to the heap.
### :param ptr: The block, or null to do nothing.
@external("c")
@symbol("free")
secret routine c_free(ptr: Addr) -> None

### C's memmove: copies `n` bytes from `src` to `dst`. The regions may overlap.
### :param dst: Where the bytes go.
### :param src: Where the bytes come from.
### :param n: How many bytes.
### :returns: `dst`.
@external("c")
@symbol("memmove")
secret routine c_memmove(dst: Addr, src: Addr, n: CSize) -> Addr

### C's memset: fills `n` bytes at `dst` with the low byte of `value`.
### :param dst: Where to fill.
### :param value: The byte to fill with.
### :param n: How many bytes.
### :returns: `dst`.
@external("c")
@symbol("memset")
secret routine c_memset(dst: Addr, value: CInt, n: CSize) -> Addr

### glibc's malloc_usable_size: how many bytes the block at `ptr` holds, at least what was asked for.
### :param ptr: A block from the C heap.
### :returns: Its size, in bytes.
@external("c")
@symbol("malloc_usable_size")
@target(os: "linux")
secret routine c_block_size(ptr: Addr) -> CSize

### macOS's malloc_size: how many bytes the block at `ptr` holds, at least what was asked for.
### :param ptr: A block from the C heap.
### :returns: Its size, in bytes.
@external("c")
@symbol("malloc_size")
@target(os: "macos")
secret routine c_block_size(ptr: Addr) -> CSize

### The Windows C runtime's _msize: how many bytes the block at `ptr` holds.
### :param ptr: A block from the C heap.
### :returns: Its size, in bytes.
@external("c")
@symbol("_msize")
@target(os: "windows")
secret routine c_block_size(ptr: Addr) -> CSize

### A runtime error with the crash report and exit status (the runtime library).
### :param error_type: The error's name, such as `OutOfMemoryError`.
### :param message: What went wrong.
@external("c")
@symbol("__rf_throw")
@noreturn
secret routine rf_throw(error_type: CStrView, message: CStrView) -> None

### "Failed to <what> <bytes> bytes", as an OutOfMemoryError.
### :param what: What failed, such as "allocate".
### :param bytes: How many bytes were asked for.
### :throws: Always crashes with `OutOfMemoryError`.
@noreturn
secret routine out_of_memory(what: @[Byte], bytes: U64) -> None
    buffer: &Items[Byte, 128] <- .hollow()
    out: &SliceWriter <- SliceWriter.construct(data: buffer.getview().to[@Byte](), capacity: 127)

    out.write("Failed to {what} {bytes} bytes")
    text: @[Byte] = out.getview()
    terminator: @Byte = buffer.getview().to[@Byte]().stride(text.count)
    terminator.poke(0x00)
    rf_throw("OutOfMemoryError", buffer.to[@CChar]().to[CStrView]())

# -- heap counting -------------------------------------------------------------------
#
# A routine test with @memory_limit runs with its heap counted: the test command sets RF_MEMORY_LIMIT, the runtime's
# start-up turns counting on, and the exit status the program ends with reports a peak above the limit. Off, the
# count costs one load and a branch per allocation.

### Whether heap blocks are counted: 1 while a memory limit is checked, 0 otherwise.
global HEAP_COUNTING: &U32

### The bytes the counted heap holds now. A block made before counting began and freed after it makes this smaller
### than the program's heap, never larger.
global HEAP_IN_USE: &S64

### The most HEAP_IN_USE has been since counting began.
global HEAP_PEAK: &S64
### The heap limit a routine test runs under, in bytes, or 0 when there is none.
global HEAP_LIMIT: &U64

### Counts a block the heap just gave out. Null (a failed or empty allocation) counts nothing.
### :param p: The block.
routine count_allocated(p: Addr) -> None
    if HEAP_COUNTING.peek_unbroken[RELAXED]() == 0 or p.is_hollow()
        return
    size: S64 = c_block_size(p).to[U64]().to[S64]()
    now: S64 = HEAP_IN_USE.fetch_add_unbroken[RELAXED](size) + size
    peak: &S64 <- HEAP_PEAK.peek_unbroken[RELAXED]()
    until now <= peak.load()
        when HEAP_PEAK.compare_exchange_unbroken(expected: peak.load(), new: now)
            is None => return
            else as seen => seen.poke_into(peak)
    return

### Counts a block about to go back to the heap. Null counts nothing.
### :param p: The block.
routine count_freed(p: Addr) -> None
    if HEAP_COUNTING.peek_unbroken[RELAXED]() == 0 or p.is_hollow()
        return
    size: S64 = c_block_size(p).to[U64]().to[S64]()
    HEAP_IN_USE.fetch_sub_unbroken[RELAXED](size)
    return

### C's getenv: the value of the environment variable `name`, or null when it is not set.
### :param name: The variable's name.
### :returns: The value as a C string.
@external("c")
@symbol("getenv")
secret routine memory_getenv(name: CStrView) -> @Byte

### Reads RF_MEMORY_LIMIT (the test command sets it, in bytes, for a test with @memory_limit) and, when it holds a
### number above 0, counts the heap from here on. The builder's `main` calls it first.
@export("rf_heap_limit_init")
routine rf_heap_limit_init() -> None
    text: @Byte = memory_getenv("RF_MEMORY_LIMIT")
    if text.is_hollow()
        return
    limit: &U64 <- 0
    at: &U64 <- 0
    until text.stride(at.load()).peek() < b'0' or text.stride(at.load()).peek() > b'9'
        digit: U64 = (text.stride(at.load()).peek().to[U8]() - 48).to[U64]()
        next: U64 = limit.load() *% 10 +% digit
        next.poke_into(limit)
        (at.load() + 1).poke_into(at)
    if limit.load() == 0
        return
    HEAP_LIMIT.poke(limit.load())
    HEAP_IN_USE.poke_unbroken(0)
    HEAP_PEAK.poke_unbroken(0)
    HEAP_COUNTING.poke_unbroken(1)
    return

### The exit status the program ends with: `status`, or the crash status (82) with a report when the counted heap went
### past its limit. The builder's `main` calls it last.
### :param status: The status the program would end with.
### :returns: The status to end with.
@export("rf_heap_limit_status")
routine rf_heap_limit_status(status: CInt) -> CInt
    limit: U64 = HEAP_LIMIT.peek()
    peak: S64 = HEAP_PEAK.peek_unbroken()
    if limit == 0 or peak <= 0 or peak.to[U64]() <= limit
        return status
    used: U64 = peak.to[U64]()
    Console.alert("Memory limit error: the program held {used} bytes, more than the limit of {limit} bytes.")
    return 0x52

### Allocates `bytes` zeroed bytes from the C heap.
### :param bytes: How many bytes.
### :returns: The memory.
### :throws: Crashes with `OutOfMemoryError` when the allocation fails, or with `IntegerOverflowError` when `bytes`
###     does not fit in U64 (on a 32-bit target).
@export("rf_allocate_dynamic")
@expensive("allocates heap memory")
routine rf_allocate_dynamic(bytes: U64) -> Addr
    p: Addr = c_calloc(bytes.to[CSize](), 1)
    if p.is_hollow()
        out_of_memory(what: "allocate", bytes)
    else
        count_allocated(p)
        return p

### Allocates `bytes` bytes from the C heap, not zeroed: the caller writes them before reading.
### :param bytes: How many bytes.
### :returns: The memory.
### :throws: Crashes with `OutOfMemoryError` when the allocation fails, or with `IntegerOverflowError` when `bytes`
###     does not fit in U64 (on a 32-bit target).
@export("rf_allocate_dynamic_uninit")
@expensive("allocates heap memory")
routine rf_allocate_dynamic_uninit(bytes: U64) -> Addr
    p: Addr = c_malloc(bytes.to[CSize]())
    if p.is_hollow()
        out_of_memory(what: "allocate", bytes)
    else
        count_allocated(p)
        return p

### Frees a block. Null is fine.
### :param ptr: The block to free, or null.
@export("rf_invalidate")
@expensive("frees heap memory")
routine rf_invalidate(ptr: Addr) -> None
    count_freed(ptr)
    c_free(ptr)
    return

### Resizes the block at `ptr` to `bytes` bytes, keeping its contents up to the smaller size. Reallocating to 0 bytes
### may give null: that is a free, not a failure.
### :param ptr: The block, or null to allocate a new one.
### :param bytes: The new size, in bytes.
### :returns: The block, maybe moved.
### :throws: Crashes with `OutOfMemoryError` when the allocation fails, or with `IntegerOverflowError` when `bytes`
###     does not fit in U64 (on a 32-bit target).
@export("rf_reallocate_dynamic")
@expensive("reallocates heap memory")
routine rf_reallocate_dynamic(ptr: Addr, bytes: U64) -> Addr
    count_freed(ptr)
    p: Addr = c_realloc(ptr, bytes.to[CSize]())
    if p.is_hollow() and bytes != 0
        out_of_memory(what: "reallocate to", bytes)
    else
        count_allocated(p)
        return p

### Allocates `bytes` zeroed bytes from the C heap, or gives null when the heap has no room for them. A caller that
### reports the failure itself (a failable reserve) uses this one.
### :param bytes: How many bytes.
### :returns: The memory, or null.
@export("rf_allocate_dynamic_or_hollow")
@expensive("allocates heap memory")
routine rf_allocate_dynamic_or_hollow(bytes: U64) -> Addr
    p: Addr = c_calloc(bytes.to[CSize](), 1)
    count_allocated(p)
    return p

### Allocates `bytes` bytes from the C heap, not zeroed, or gives null when the heap has no room for them.
### :param bytes: How many bytes.
### :returns: The memory, or null.
@export("rf_allocate_dynamic_uninit_or_hollow")
@expensive("allocates heap memory")
routine rf_allocate_dynamic_uninit_or_hollow(bytes: U64) -> Addr
    p: Addr = c_malloc(bytes.to[CSize]())
    count_allocated(p)
    return p

### Resizes the block at `ptr` to `bytes` bytes as `rf_reallocate_dynamic` does, or gives null when the heap has no
### room for them. The block at `ptr` then stays as it was, and the caller still frees it.
### :param ptr: The block, or null to allocate a new one.
### :param bytes: The new size, in bytes, above 0.
### :returns: The block, maybe moved, or null.
@export("rf_reallocate_dynamic_or_hollow")
@expensive("reallocates heap memory")
routine rf_reallocate_dynamic_or_hollow(ptr: Addr, bytes: U64) -> Addr
    count_freed(ptr)
    p: Addr = c_realloc(ptr, bytes.to[CSize]())
    if p.is_hollow()
        count_allocated(ptr)
        return p
    count_allocated(p)
    return p

### Copies `bytes` bytes from `src_address` to `dst_address`. The regions may overlap. A hollow address or no bytes
### does nothing.
### :param dst_address: Where the bytes go.
### :param src_address: Where the bytes come from.
### :param bytes: How many bytes.
@export("rf_copy_bytes_at")
routine rf_copy_bytes_at(dst_address: Addr, src_address: Addr, bytes: U64) -> None
    if src_address.is_hollow() or dst_address.is_hollow() or bytes == 0
        return
    c_memmove(dst_address, src_address, bytes.to[CSize]())
    return

### Fills `bytes` bytes at `dest_address` with `value`. A hollow address or no bytes does nothing.
### :param dest_address: Where to fill.
### :param value: The byte to fill with.
### :param bytes: How many bytes.
### :throws: Crashes with `IntegerOverflowError` when `bytes` does not fit in U64 (on a 32-bit target).
@export("rf_set_bytes_at")
routine rf_set_bytes_at(dest_address: Addr, value: U8, bytes: U64) -> None
    if dest_address.is_hollow() or bytes == 0
        return
    c_memset(dest_address, value.to[CInt](), bytes.to[CSize]())
    return

# -- the scratch region --------------------------------------------------------------
#
# A thread's stack of zeroed temporary blocks, released in bulk: a caller takes a mark, allocates any number of
# blocks, and releases back to the mark, which frees every block since. For computations whose intermediates alias
# one another (an engine that shares limb buffers between temporaries). Marks nest in stack order. The region is
# the thread's, so a computation doesn't suspend between its mark and its release.

@threadlocal
global REGION_TOP: &@RegionBlock

record RegionBlock
    prev: @RegionBlock

### The current top: release to it to free everything allocated after.
### :returns: The mark, the address of this thread's top block (0 when the region is empty).
@export("rf_region_mark")
routine rf_region_mark() -> U64
    return ptrtoint[@RegionBlock, U64](REGION_TOP.peek())

### Allocates `bytes` zeroed bytes in this thread's region, freed by the release to a mark taken before.
### :param bytes: How many bytes.
### :returns: The memory.
### :throws: Crashes with `OutOfMemoryError` when the allocation fails, or with `IntegerOverflowError` when `bytes`
###     plus the block header does not fit in U64.
@export("rf_region_alloc")
routine rf_region_alloc(bytes: U64) -> Addr
    p: Addr = c_calloc(1, (sizeof[RegionBlock]() + bytes.to[U64]()).to[CSize]())
    if p.is_hollow()
        out_of_memory(what: "allocate scratch", bytes)
    node: @RegionBlock = p.to[@RegionBlock]()
    node.prev.poke(REGION_TOP.peek())
    REGION_TOP.poke(node)
    return node.stride(1)

### Frees every block allocated since `mark`, in this thread's region.
### :param mark: A mark from rf_region_mark.
@export("rf_region_release")
routine rf_region_release(mark: U64) -> None
    stop: @RegionBlock = inttoptr[U64, @RegionBlock](mark)

    loop
        top2: @RegionBlock = REGION_TOP.peek()
        if top2.is_hollow() or (top2 === stop)
            return
        REGION_TOP.poke(top2.prev.peek())
        c_free(top2)
