// ── C256 ──────────────────────────────────────────────────────────────────────────

/// RazorForge's C256: a complex number over F128, RazorForge's B128.
record C256
    real : F128
    imag : F128

/// 1 + 0i.
#inline
routine C256.one() -> Self
    block entry()
        return({ real: F128_ONE, imag: F128_ZERO })

/// The sum, part by part.
#inline
routine C256.add(self: Self, other: Self) -> Self
    block entry()
        re : F128 = self.real.add_finite(other.real)
        im : F128 = self.imag.add_finite(other.imag)
        return({ real: re, imag: im })

/// The difference, part by part.
#inline
routine C256.sub(self: Self, other: Self) -> Self
    block entry()
        re : F128 = self.real.sub_finite(other.real)
        im : F128 = self.imag.sub_finite(other.imag)
        return({ real: re, imag: im })

/// The product (ac - bd) + (ad + bc)i.
routine C256.mul(self: Self, other: Self) -> Self
    block entry()
        ac : F128 = self.real.mul_finite(other.real)
        bd : F128 = self.imag.mul_finite(other.imag)
        re : F128 = ac.sub_finite(bd)
        ad : F128 = self.real.mul_finite(other.imag)
        bc : F128 = self.imag.mul_finite(other.real)
        im : F128 = ad.add_finite(bc)
        return({ real: re, imag: im })

/// The quotient: self times the conjugate of other, over other's squared modulus.
routine C256.div(self: Self, other: Self) -> Self
    block entry()
        d  : F128 = other.norm()
        ac : F128 = self.real.mul_finite(other.real)
        bd : F128 = self.imag.mul_finite(other.imag)
        re : F128 = ac.add_finite(bd).div_finite(d)
        bc : F128 = self.imag.mul_finite(other.real)
        ad : F128 = self.real.mul_finite(other.imag)
        im : F128 = bc.sub_finite(ad).div_finite(d)
        return({ real: re, imag: im })

/// The squared modulus real² + imag².
routine C256.norm(self: Self) -> F128
    block entry()
        rr : F128 = self.real.mul_finite(self.real)
        ii : F128 = self.imag.mul_finite(self.imag)
        return(rr.add_finite(ii))

/// The modulus, the square root of the squared modulus.
routine C256.abs(self: Self) -> F128
    block entry()
        return(self.norm().sqrt())

/// The phase angle atan2(imag, real), in (-π, π].
routine C256.arg(self: Self) -> F128
    block entry()
        return(self.imag.atan2(self.real))

/// The sine, sin a cosh b + i cos a sinh b.
routine C256.sin(self: Self) -> Self
    block entry()
        re : F128 = self.real.sin().mul_finite(self.imag.cosh())
        im : F128 = self.real.cos().mul_finite(self.imag.sinh())
        return({ real: re, imag: im })

/// The cosine, cos a cosh b - i sin a sinh b.
routine C256.cos(self: Self) -> Self
    block entry()
        re : F128 = self.real.cos().mul_finite(self.imag.cosh())
        im : F128 = self.real.sin().mul_finite(self.imag.sinh()).neg()
        return({ real: re, imag: im })

/// The tangent, (sin 2a + i sinh 2b) / (cos 2a + cosh 2b).
routine C256.tan(self: Self) -> Self
    block entry()
        a2 : F128 = self.real.add_finite(self.real)
        b2 : F128 = self.imag.add_finite(self.imag)
        d  : F128 = a2.cos().add_finite(b2.cosh())
        re : F128 = a2.sin().div_finite(d)
        im : F128 = b2.sinh().div_finite(d)
        return({ real: re, imag: im })

/// The arcsine, -i log(iz + √(1 - z²)).
routine C256.asin(self: Self) -> Self
    block entry()
        iz : Self = { real: self.imag.neg(), imag: self.real }
        zz : Self = self.mul(self)
        s  : Self = Self.one().sub(zz).sqrt()
        v  : Self = iz.add(s).ln()
        return({ real: v.imag, imag: v.real.neg() })

/// The arccosine, -i log(z + i √(1 - z²)).
routine C256.acos(self: Self) -> Self
    block entry()
        zz : Self = self.mul(self)
        s  : Self = Self.one().sub(zz).sqrt()
        is : Self = { real: s.imag.neg(), imag: s.real }
        v  : Self = self.add(is).ln()
        return({ real: v.imag, imag: v.real.neg() })

/// The arctangent, (i/2) log((i + z) / (i - z)).
routine C256.atan(self: Self) -> Self
    block entry()
        num_imag : F128 = self.imag.add_finite(F128_ONE)
        den_imag : F128 = F128.sub_finite(F128_ONE, self.imag)
        num      : Self = { real: self.real, imag: num_imag }
        den      : Self = { real: self.real.neg(), imag: den_imag }
        v        : Self = num.div(den).ln()
        re       : F128 = v.imag.neg().div_finite(F128_TWO)
        im       : F128 = v.real.div_finite(F128_TWO)
        return({ real: re, imag: im })

/// The hyperbolic sine, sinh a cos b + i cosh a sin b.
routine C256.sinh(self: Self) -> Self
    block entry()
        re : F128 = self.real.sinh().mul_finite(self.imag.cos())
        im : F128 = self.real.cosh().mul_finite(self.imag.sin())
        return({ real: re, imag: im })

/// The hyperbolic cosine, cosh a cos b + i sinh a sin b.
routine C256.cosh(self: Self) -> Self
    block entry()
        re : F128 = self.real.cosh().mul_finite(self.imag.cos())
        im : F128 = self.real.sinh().mul_finite(self.imag.sin())
        return({ real: re, imag: im })

/// The hyperbolic tangent, (sinh 2a + i sin 2b) / (cosh 2a + cos 2b).
routine C256.tanh(self: Self) -> Self
    block entry()
        a2 : F128 = self.real.add_finite(self.real)
        b2 : F128 = self.imag.add_finite(self.imag)
        d  : F128 = a2.cosh().add_finite(b2.cos())
        re : F128 = a2.sinh().div_finite(d)
        im : F128 = b2.sin().div_finite(d)
        return({ real: re, imag: im })

/// The inverse hyperbolic sine, log(z + √(z² + 1)).
routine C256.asinh(self: Self) -> Self
    block entry()
        zz : Self = self.mul(self)
        s  : Self = zz.add(Self.one()).sqrt()
        return(self.add(s).ln())

/// The inverse hyperbolic cosine, log(z + √(z² - 1)).
routine C256.acosh(self: Self) -> Self
    block entry()
        zz : Self = self.mul(self)
        s  : Self = zz.sub(Self.one()).sqrt()
        return(self.add(s).ln())

/// The inverse hyperbolic tangent, log((1 + z) / (1 - z)) / 2.
routine C256.atanh(self: Self) -> Self
    block entry()
        p  : Self = Self.one().add(self)
        m  : Self = Self.one().sub(self)
        v  : Self = p.div(m).ln()
        re : F128 = v.real.div_finite(F128_TWO)
        im : F128 = v.imag.div_finite(F128_TWO)
        return({ real: re, imag: im })

/// e to this power, eᵃ (cos b + i sin b).
routine C256.exp(self: Self) -> Self
    block entry()
        ea : F128 = self.real.exp()
        re : F128 = ea.mul_finite(self.imag.cos())
        im : F128 = ea.mul_finite(self.imag.sin())
        return({ real: re, imag: im })

/// The principal natural logarithm, ln |z| + i arg z.
routine C256.ln(self: Self) -> Self
    block entry()
        re : F128 = self.abs().ln()
        return({ real: re, imag: self.arg() })

/// The base-10 logarithm, ln z / ln 10.
routine C256.log10(self: Self) -> Self
    block entry()
        v  : Self = self.ln()
        re : F128 = v.real.div_finite(C256_LN_10)
        im : F128 = v.imag.div_finite(C256_LN_10)
        return({ real: re, imag: im })

/// The base-2 logarithm, ln z / ln 2.
routine C256.log2(self: Self) -> Self
    block entry()
        v  : Self = self.ln()
        re : F128 = v.real.div_finite(C256_LN_2)
        im : F128 = v.imag.div_finite(C256_LN_2)
        return({ real: re, imag: im })

/// 1 / z, the conjugate over the squared modulus.
routine C256.reciprocal(self: Self) -> Self
    block entry()
        d  : F128 = self.norm()
        re : F128 = self.real.div_finite(d)
        im : F128 = self.imag.neg().div_finite(d)
        return({ real: re, imag: im })

/// The principal square root (real part >= 0), from half the modulus plus and minus the real part. The imaginary part
/// takes the sign of this imaginary part, so -0 and +0 pick the two sides of the cut along the negative reals.
routine C256.sqrt(self: Self) -> Self
    shared r : F128 = self.abs()

    block entry()
        branch r.eq(F128_ZERO)
            ? return({ real: F128_ZERO, imag: F128_ZERO })
            : continue
        rp : F128 = r.add_finite(self.real).div_finite(F128_TWO).sqrt()
        ip : F128 = r.sub_finite(self.real).div_finite(F128_TWO).sqrt()
        branch self.imag.lt(F128_ZERO)
            ? return({ real: rp, imag: ip.neg() })
            : return({ real: rp, imag: ip })

/// This number to the complex power `power`, exp(power × ln self).
routine C256.pow(self: Self, power: Self) -> Self
    block entry()
        return(power.mul(self.ln()).exp())

/// This number to the integer power n, by repeated squaring: each product rounds once, with no ln and exp. A
/// negative n starts from the reciprocal, and n = 0 gives 1. The base is squared once more after the last product,
/// as RazorForge's loop does, so that squaring can overflow too.
routine C256.powi(self: Self, n: S64) -> Self
    shared result : @Self <- Self.one()
    shared k      : U64   = n.to_wrap<U64>()

    block entry()
        branch n.lt(0)
            ? square(self.reciprocal(), U64.sub_wrap(0, k))
            : square(self, k)

    block square(base: Self, left: U64)
        branch left.eq(0)
            ? return(result.load())
            : continue
        odd : Bool = left.bitand(1).eq(1)
        branch odd
            ? multiply(base, left)
            : next(base, left)

    block multiply(base: Self, left: U64)
        result.load().mul(base).store_into(result)
        jump next(base, left)

    block next(base: Self, left: U64)
        jump square(base.mul(base), left.shr(1))

/// The number at distance r and angle theta: r cos θ + i r sin θ.
routine C256.from_polar(r: F128, theta: F128) -> Self
    block entry()
        re : F128 = r.mul_finite(theta.cos())
        im : F128 = r.mul_finite(theta.sin())
        return({ real: re, imag: im })

/// The F128 whose bits are high × 2^64 + low.
#inline
routine f128_from_halves(low: U64, high: U64) -> F128
    block entry()
        top  : U128 = high.to<U128>().shl(64)
        bits : U128 = top.bitor(low.to<U128>())
        return(F128.from_bits(bits))

/// The C256 whose parts' bits are given as their low and high 64 bits.
#inline
routine C256.from_halves(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> Self
    block entry()
        re : F128 = f128_from_halves(real_low, real_high)
        im : F128 = f128_from_halves(imag_low, imag_high)
        return({ real: re, imag: im })

/// An F128 in Words, the way an export hands one back: its low 64 bits in w0, its high 64 bits in w1.
#inline
routine f128_words(v: F128) -> Words
    block entry()
        bits : U128 = v.bits()
        low  : U64  = bits.to_wrap<U64>()
        high : U64  = bits.shr(64).to_wrap<U64>()
        return({ w0: low, w1: high, w2: 0, w3: 0 })

// The exports RazorForge's C256 calls.

/// The product, for C256.mul.
#[export("ingrid_c256_mul"), inline]
routine c256_mul(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64, other_real_low: U64,
    other_real_high: U64, other_imag_low: U64, other_imag_high: U64) -> C256
    block entry()
        z : C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
        w : C256 = C256.from_halves(other_real_low, other_real_high, other_imag_low,
            other_imag_high)
        return(z.mul(w))

/// The quotient, for C256.truediv.
#[export("ingrid_c256_div"), inline]
routine c256_div(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64, other_real_low: U64,
    other_real_high: U64, other_imag_low: U64, other_imag_high: U64) -> C256
    block entry()
        z : C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
        w : C256 = C256.from_halves(other_real_low, other_real_high, other_imag_low,
            other_imag_high)
        return(z.div(w))

/// The first number to the power of the second, for C256.pow.
#[export("ingrid_c256_pow"), inline]
routine c256_pow(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64, other_real_low: U64,
    other_real_high: U64, other_imag_low: U64, other_imag_high: U64) -> C256
    block entry()
        z : C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
        w : C256 = C256.from_halves(other_real_low, other_real_high, other_imag_low,
            other_imag_high)
        return(z.pow(w))

/// C256.abs.
#[export("ingrid_c256_abs"), inline]
routine c256_abs(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> Words
    block entry()
        z : C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
        return(f128_words(z.abs()))

/// C256.arg.
#[export("ingrid_c256_arg"), inline]
routine c256_arg(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> Words
    block entry()
        z : C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
        return(f128_words(z.arg()))

/// C256.norm.
#[export("ingrid_c256_norm"), inline]
routine c256_norm(real_low: U64, real_high: U64, imag_low: U64, imag_high: U64) -> Words
    block entry()
        z : C256 = C256.from_halves(real_low, real_high, imag_low, imag_high)
