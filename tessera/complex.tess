        z : C64 = { real: real, imag: imag }
        return(z.powi(n).bits())

/// The C64 at distance r and angle theta.
#[export("ingrid_c64_from_polar"), inline]
routine c64_from_polar(r: F32, theta: F32) -> U64
    block entry()
        return(C64.from_polar(r, theta).bits())

// ── C128 ──────────────────────────────────────────────────────────────────────────

/// RazorForge's C128: a complex number over F64, RazorForge's B64.
record C128
    real : F64
    imag : F64

/// 1 + 0i.
#inline
routine C128.one() -> Self
    block entry()
        return({ real: 1.0, imag: 0.0 })

/// The sum, part by part.
#inline
routine C128.add(self: Self, other: Self) -> Self
    block entry()
        re : F64 = self.real.add_finite(other.real)
        im : F64 = self.imag.add_finite(other.imag)
        return({ real: re, imag: im })

/// The difference, part by part.
#inline
routine C128.sub(self: Self, other: Self) -> Self
    block entry()
        re : F64 = self.real.sub_finite(other.real)
        im : F64 = self.imag.sub_finite(other.imag)
        return({ real: re, imag: im })

/// The product (ac - bd) + (ad + bc)i.
routine C128.mul(self: Self, other: Self) -> Self
    block entry()
        ac : F64 = self.real.mul_finite(other.real)
        bd : F64 = self.imag.mul_finite(other.imag)
        re : F64 = ac.sub_finite(bd)
        ad : F64 = self.real.mul_finite(other.imag)
        bc : F64 = self.imag.mul_finite(other.real)
        im : F64 = ad.add_finite(bc)
        return({ real: re, imag: im })

/// The quotient: self times the conjugate of other, over other's squared modulus.
routine C128.div(self: Self, other: Self) -> Self
    block entry()
        d  : F64 = other.norm()
        ac : F64 = self.real.mul_finite(other.real)
        bd : F64 = self.imag.mul_finite(other.imag)
        re : F64 = ac.add_finite(bd).div_finite(d)
        bc : F64 = self.imag.mul_finite(other.real)
        ad : F64 = self.real.mul_finite(other.imag)
        im : F64 = bc.sub_finite(ad).div_finite(d)
        return({ real: re, imag: im })

/// The squared modulus real² + imag².
routine C128.norm(self: Self) -> F64
    block entry()
        rr : F64 = self.real.mul_finite(self.real)
        ii : F64 = self.imag.mul_finite(self.imag)
        return(rr.add_finite(ii))

/// The modulus, the square root of the squared modulus.
routine C128.abs(self: Self) -> F64
    block entry()
        return(self.norm().sqrt())

/// The phase angle atan2(imag, real), in (-π, π].
routine C128.arg(self: Self) -> F64
    block entry()
        return(self.imag.atan2(self.real))

/// The sine, sin a cosh b + i cos a sinh b, with cosh and sinh from e^b and e^-b.
routine C128.sin(self: Self) -> Self
    block entry()
        ep : F64 = self.imag.exp()
        em : F64 = self.imag.neg().exp()
        ch : F64 = ep.add_finite(em).div_finite(2.0)
        sh : F64 = ep.sub_finite(em).div_finite(2.0)
        re : F64 = self.real.sin().mul_finite(ch)
        im : F64 = self.real.cos().mul_finite(sh)
        return({ real: re, imag: im })

/// The cosine, cos a cosh b - i sin a sinh b, with cosh and sinh from e^b and e^-b.
routine C128.cos(self: Self) -> Self
    block entry()
        ep : F64 = self.imag.exp()
        em : F64 = self.imag.neg().exp()
        ch : F64 = ep.add_finite(em).div_finite(2.0)
        sh : F64 = ep.sub_finite(em).div_finite(2.0)
        re : F64 = self.real.cos().mul_finite(ch)
        im : F64 = self.real.sin().mul_finite(sh).neg()
        return({ real: re, imag: im })

/// The tangent, (sin 2a + i sinh 2b) / (cos 2a + cosh 2b).
routine C128.tan(self: Self) -> Self
    block entry()
        a2 : F64 = self.real.add_finite(self.real)
        b2 : F64 = self.imag.add_finite(self.imag)
        ep : F64 = b2.exp()
        em : F64 = b2.neg().exp()
        ca : F64 = a2.cos()
        ch : F64 = ep.add_finite(em).div_finite(2.0)
        d  : F64 = ca.add_finite(ch)
        re : F64 = a2.sin().div_finite(d)
        sh : F64 = ep.sub_finite(em).div_finite(2.0)
        im : F64 = sh.div_finite(d)
        return({ real: re, imag: im })

/// The arcsine, -i log(iz + √(1 - z²)).
routine C128.asin(self: Self) -> Self
    block entry()
        iz : Self = { real: self.imag.neg(), imag: self.real }
        zz : Self = self.mul(self)
        s  : Self = Self.one().sub(zz).sqrt()
        v  : Self = iz.add(s).ln()
        return({ real: v.imag, imag: v.real.neg() })

/// The arccosine, -i log(z + i √(1 - z²)).
routine C128.acos(self: Self) -> Self
    block entry()
        zz : Self = self.mul(self)
        s  : Self = Self.one().sub(zz).sqrt()
        is : Self = { real: s.imag.neg(), imag: s.real }
        v  : Self = self.add(is).ln()
        return({ real: v.imag, imag: v.real.neg() })

/// The arctangent, (i/2) log((i + z) / (i - z)).
routine C128.atan(self: Self) -> Self
    block entry()
        num_imag : F64  = self.imag.add_finite(1.0)
        den_imag : F64  = F64.sub_finite(1.0, self.imag)
        num      : Self = { real: self.real, imag: num_imag }
        den      : Self = { real: self.real.neg(), imag: den_imag }
        v        : Self = num.div(den).ln()
        re       : F64  = v.imag.neg().div_finite(2.0)
        im       : F64  = v.real.div_finite(2.0)
        return({ real: re, imag: im })

/// The hyperbolic sine, sinh a cos b + i cosh a sin b, with sinh and cosh from e^a and e^-a.
routine C128.sinh(self: Self) -> Self
    block entry()
        ep : F64 = self.real.exp()
        em : F64 = self.real.neg().exp()
        sh : F64 = ep.sub_finite(em).div_finite(2.0)
        ch : F64 = ep.add_finite(em).div_finite(2.0)
        re : F64 = sh.mul_finite(self.imag.cos())
        im : F64 = ch.mul_finite(self.imag.sin())
        return({ real: re, imag: im })

/// The hyperbolic cosine, cosh a cos b + i sinh a sin b, with sinh and cosh from e^a and e^-a.
routine C128.cosh(self: Self) -> Self
    block entry()
        ep : F64 = self.real.exp()
        em : F64 = self.real.neg().exp()
        sh : F64 = ep.sub_finite(em).div_finite(2.0)
        ch : F64 = ep.add_finite(em).div_finite(2.0)
        re : F64 = ch.mul_finite(self.imag.cos())
        im : F64 = sh.mul_finite(self.imag.sin())
        return({ real: re, imag: im })

/// The hyperbolic tangent, (sinh 2a + i sin 2b) / (cosh 2a + cos 2b).
routine C128.tanh(self: Self) -> Self
    block entry()
        a2 : F64 = self.real.add_finite(self.real)
        b2 : F64 = self.imag.add_finite(self.imag)
        ep : F64 = a2.exp()
        em : F64 = a2.neg().exp()
        ch : F64 = ep.add_finite(em).div_finite(2.0)
        d  : F64 = ch.add_finite(b2.cos())
        sh : F64 = ep.sub_finite(em).div_finite(2.0)
        re : F64 = sh.div_finite(d)
        im : F64 = b2.sin().div_finite(d)
        return({ real: re, imag: im })

/// The inverse hyperbolic sine, log(z + √(z² + 1)).
routine C128.asinh(self: Self) -> Self
    block entry()
        zz : Self = self.mul(self)
        s  : Self = zz.add(Self.one()).sqrt()
        return(self.add(s).ln())

/// The inverse hyperbolic cosine, log(z + √(z² - 1)).
routine C128.acosh(self: Self) -> Self
    block entry()
        zz : Self = self.mul(self)
        s  : Self = zz.sub(Self.one()).sqrt()
        return(self.add(s).ln())

/// The inverse hyperbolic tangent, log((1 + z) / (1 - z)) / 2.
routine C128.atanh(self: Self) -> Self
    block entry()
        p  : Self = Self.one().add(self)
        m  : Self = Self.one().sub(self)
        v  : Self = p.div(m).ln()
        re : F64  = v.real.div_finite(2.0)
        im : F64  = v.imag.div_finite(2.0)
        return({ real: re, imag: im })

/// e to this power, eᵃ (cos b + i sin b).
routine C128.exp(self: Self) -> Self
    block entry()
        ea : F64 = self.real.exp()
        re : F64 = ea.mul_finite(self.imag.cos())
        im : F64 = ea.mul_finite(self.imag.sin())
        return({ real: re, imag: im })

/// The principal natural logarithm, ln |z| + i arg z.
routine C128.ln(self: Self) -> Self
    block entry()
        re : F64 = self.abs().ln()
        return({ real: re, imag: self.arg() })

/// The base-10 logarithm, ln z / ln 10.
routine C128.log10(self: Self) -> Self
    block entry()
        v  : Self = self.ln()
        re : F64  = v.real.div_finite(C128_LN_10)
        im : F64  = v.imag.div_finite(C128_LN_10)
        return({ real: re, imag: im })

/// The base-2 logarithm, ln z / ln 2.
routine C128.log2(self: Self) -> Self
    block entry()
        v  : Self = self.ln()
        re : F64  = v.real.div_finite(C128_LN_2)
        im : F64  = v.imag.div_finite(C128_LN_2)
        return({ real: re, imag: im })

/// 1 / z, the conjugate over the squared modulus.
routine C128.reciprocal(self: Self) -> Self
    block entry()
        d  : F64 = self.norm()
        re : F64 = self.real.div_finite(d)
        im : F64 = self.imag.neg().div_finite(d)
        return({ real: re, imag: im })

/// The principal square root (real part >= 0), from half the modulus plus and minus the real part. The imaginary part
/// takes the sign of this imaginary part, so -0 and +0 pick the two sides of the cut along the negative reals.
routine C128.sqrt(self: Self) -> Self
    shared r : F64 = self.abs()

    block entry()
        branch r.eq(0.0)
            ? return({ real: 0.0, imag: 0.0 })
            : continue
        rp : F64 = r.add_finite(self.real).div_finite(2.0).sqrt()
        ip : F64 = r.sub_finite(self.real).div_finite(2.0).sqrt()
        branch self.imag.lt(0.0)
            ? return({ real: rp, imag: ip.neg() })
            : return({ real: rp, imag: ip })

/// This number to the complex power `power`, exp(power × ln self).
routine C128.pow(self: Self, power: Self) -> Self
    block entry()
        return(power.mul(self.ln()).exp())

/// This number to the integer power n, by repeated squaring: each product rounds once, with no ln and exp. A
/// negative n starts from the reciprocal, and n = 0 gives 1. The base is squared once more after the last product,
/// as RazorForge's loop does, so that squaring can overflow too.
routine C128.powi(self: Self, n: S64) -> Self
    shared result : @Self <- Self.one()
    shared k      : U64   = n.to_wrap<U64>()

    block entry()
        branch n.lt(0)
            ? square(self.reciprocal(), U64.sub_wrap(0, k))
            : square(self, k)

    block square(base: Self, left: U64)
        branch left.eq(0)
            ? return(result.load())
            : continue
        odd : Bool = left.bitand(1).eq(1)
        branch odd
            ? multiply(base, left)
            : next(base, left)

    block multiply(base: Self, left: U64)
        result.load().mul(base).store_into(result)
        jump next(base, left)

    block next(base: Self, left: U64)
        jump square(base.mul(base), left.shr(1))

/// The number at distance r and angle theta: r cos θ + i r sin θ.
routine C128.from_polar(r: F64, theta: F64) -> Self
    block entry()
        re : F64 = r.mul_finite(theta.cos())
        im : F64 = r.mul_finite(theta.sin())
        return({ real: re, imag: im })

/// Both parts in Words, the way an export hands a C128 back: the real part's bits in w0, the imaginary part's in w1.
#inline
routine C128.words(self: Self) -> Words
    block entry()
        return(Words.construct(self.real, self.imag, 0.0, 0.0))

// The exports RazorForge's C128 calls.

/// The product, for C128.mul.
#[export("ingrid_c128_mul"), inline]
routine c128_mul(real: F64, imag: F64, other_real: F64, other_imag: F64) -> Words
    block entry()
        z : C128 = { real: real, imag: imag }
        w : C128 = { real: other_real, imag: other_imag }
        return(z.mul(w).words())

/// The quotient, for C128.truediv.
#[export("ingrid_c128_div"), inline]
routine c128_div(real: F64, imag: F64, other_real: F64, other_imag: F64) -> Words
    block entry()
        z : C128 = { real: real, imag: imag }
        w : C128 = { real: other_real, imag: other_imag }
        return(z.div(w).words())

/// The first number to the power of the second, for C128.pow.
#[export("ingrid_c128_pow"), inline]
routine c128_pow(real: F64, imag: F64, other_real: F64, other_imag: F64) -> Words
    block entry()
        z : C128 = { real: real, imag: imag }
        w : C128 = { real: other_real, imag: other_imag }
        return(z.pow(w).words())

/// C128.abs.
#[export("ingrid_c128_abs"), inline]
routine c128_abs(real: F64, imag: F64) -> F64
    block entry()
        z : C128 = { real: real, imag: imag }
        return(z.abs())

