// RazorForge's complex numbers C64, C128, and C256 (over B32, B64, and B128, which are Tessera's F32, F64, and F128):
// the bodies of their routines, moved here from RazorForge's Core/Numerics/C64.rf, C128.rf, and C256.rf. RazorForge
// keeps the types, their protocols, and thin routines that call the ingrid_ exports below, so both languages share
// one implementation.
//
// The formulas are RazorForge's own, unchanged, so every result has the same bits as before: the textbook
// identities, with no rescaling against overflow. Each `+ - * /` is the checked one (finite.tess), which crashes on
// a result that is not finite exactly where RazorForge's B32, B64, and B128 operators do, and the elementary
// functions are the standard library's correctly rounded ones (CORE-MATH ports), as RazorForge's are.
//
// The exports take each part as its own float, except a C256's: an F128 is a 128-bit integer to the C ABI, which
// Win64 passes by pointer from Tessera and by value from RazorForge, so each part goes in as its low and high 64
// bits, and an F128 result comes back in Words. A C64 result comes back packed in one U64 (the real part's bits
// low, the imaginary part's high), a C128 result in Words (words.tess), and a C256 result as itself: 32 bytes of
// 128-bit integers to both builders, which every target returns through a hidden pointer.

/// The F128 constants the C256 formulas use.
private preset F128_ZERO: F128 = F128.from_bits(0)
private preset F128_ONE:  F128 = F128.from_bits(0x3FFF0000000000000000000000000000)
private preset F128_TWO:  F128 = F128.from_bits(0x40000000000000000000000000000000)

/// ln 10 and ln 2 as each RazorForge type spells them: B32_LN_10 and B32_LN_2, the B64 literal 2.302585092994046 and
/// B64_LN_2, B128_LN_10 and B128_LN_2.
private preset C64_LN_10:  F32  = F32.from_bits(0x40135D8E)
private preset C64_LN_2:   F32  = F32.from_bits(0x3F317218)
private preset C128_LN_10: F64  = F64.from_bits(0x40026BB1BBB55516)
private preset C128_LN_2:  F64  = F64.from_bits(0x3FE62E42FEFA39EF)
private preset C256_LN_10: F128 = F128.from_bits(0x400026BB1BBB5551582DD4ADAC5705A6)
private preset C256_LN_2:  F128 = F128.from_bits(0x3FFE62E42FEFA39EF35793C7673007E6)

// ── C64 ──────────────────────────────────────────────────────────────────────────

/// RazorForge's C64: a complex number over F32, RazorForge's B32.
record C64
    real : F32
    imag : F32

/// 1 + 0i.
#inline
routine C64.one() -> Self
    block entry()
        return({ real: 1.0, imag: 0.0 })

/// The sum, part by part.
#inline
routine C64.add(self: Self, other: Self) -> Self
    block entry()
        re : F32 = self.real.add_finite(other.real)
        im : F32 = self.imag.add_finite(other.imag)
        return({ real: re, imag: im })

/// The difference, part by part.
#inline
routine C64.sub(self: Self, other: Self) -> Self
    block entry()
        re : F32 = self.real.sub_finite(other.real)
        im : F32 = self.imag.sub_finite(other.imag)
        return({ real: re, imag: im })

/// The product (ac - bd) + (ad + bc)i.
routine C64.mul(self: Self, other: Self) -> Self
    block entry()
        ac : F32 = self.real.mul_finite(other.real)
        bd : F32 = self.imag.mul_finite(other.imag)
        re : F32 = ac.sub_finite(bd)
        ad : F32 = self.real.mul_finite(other.imag)
        bc : F32 = self.imag.mul_finite(other.real)
        im : F32 = ad.add_finite(bc)
        return({ real: re, imag: im })

/// The quotient: self times the conjugate of other, over other's squared modulus.
routine C64.div(self: Self, other: Self) -> Self
    block entry()
        d  : F32 = other.norm()
        ac : F32 = self.real.mul_finite(other.real)
        bd : F32 = self.imag.mul_finite(other.imag)
        re : F32 = ac.add_finite(bd).div_finite(d)
        bc : F32 = self.imag.mul_finite(other.real)
        ad : F32 = self.real.mul_finite(other.imag)
        im : F32 = bc.sub_finite(ad).div_finite(d)
        return({ real: re, imag: im })

/// The squared modulus real² + imag².
routine C64.norm(self: Self) -> F32
    block entry()
        rr : F32 = self.real.mul_finite(self.real)
        ii : F32 = self.imag.mul_finite(self.imag)
        return(rr.add_finite(ii))

/// The modulus, the square root of the squared modulus.
routine C64.abs(self: Self) -> F32
    block entry()
        return(self.norm().sqrt())

/// The phase angle atan2(imag, real), in (-π, π].
routine C64.arg(self: Self) -> F32
    block entry()
        return(self.imag.atan2(self.real))

/// The sine, sin a cosh b + i cos a sinh b, with cosh and sinh from e^b and e^-b.
routine C64.sin(self: Self) -> Self
    block entry()
        ep : F32 = self.imag.exp()
        em : F32 = self.imag.neg().exp()
        ch : F32 = ep.add_finite(em).div_finite(2.0)
        sh : F32 = ep.sub_finite(em).div_finite(2.0)
        re : F32 = self.real.sin().mul_finite(ch)
        im : F32 = self.real.cos().mul_finite(sh)
        return({ real: re, imag: im })

/// The cosine, cos a cosh b - i sin a sinh b, with cosh and sinh from e^b and e^-b.
routine C64.cos(self: Self) -> Self
    block entry()
        ep : F32 = self.imag.exp()
        em : F32 = self.imag.neg().exp()
        ch : F32 = ep.add_finite(em).div_finite(2.0)
        sh : F32 = ep.sub_finite(em).div_finite(2.0)
        re : F32 = self.real.cos().mul_finite(ch)
        im : F32 = self.real.sin().mul_finite(sh).neg()
        return({ real: re, imag: im })

/// The tangent, (sin 2a + i sinh 2b) / (cos 2a + cosh 2b).
routine C64.tan(self: Self) -> Self
    block entry()
        a2 : F32 = self.real.add_finite(self.real)
        b2 : F32 = self.imag.add_finite(self.imag)
        ep : F32 = b2.exp()
        em : F32 = b2.neg().exp()
        ca : F32 = a2.cos()
        ch : F32 = ep.add_finite(em).div_finite(2.0)
        d  : F32 = ca.add_finite(ch)
        re : F32 = a2.sin().div_finite(d)
        sh : F32 = ep.sub_finite(em).div_finite(2.0)
        im : F32 = sh.div_finite(d)
        return({ real: re, imag: im })

/// The arcsine, -i log(iz + √(1 - z²)).
routine C64.asin(self: Self) -> Self
    block entry()
        iz : Self = { real: self.imag.neg(), imag: self.real }
        zz : Self = self.mul(self)
        s  : Self = Self.one().sub(zz).sqrt()
        v  : Self = iz.add(s).ln()
        return({ real: v.imag, imag: v.real.neg() })

/// The arccosine, -i log(z + i √(1 - z²)).
routine C64.acos(self: Self) -> Self
    block entry()
        zz : Self = self.mul(self)
        s  : Self = Self.one().sub(zz).sqrt()
        is : Self = { real: s.imag.neg(), imag: s.real }
        v  : Self = self.add(is).ln()
        return({ real: v.imag, imag: v.real.neg() })

/// The arctangent, (i/2) log((i + z) / (i - z)).
routine C64.atan(self: Self) -> Self
    block entry()
        num_imag : F32  = self.imag.add_finite(1.0)
        den_imag : F32  = F32.sub_finite(1.0, self.imag)
        num      : Self = { real: self.real, imag: num_imag }
        den      : Self = { real: self.real.neg(), imag: den_imag }
        v        : Self = num.div(den).ln()
        re       : F32  = v.imag.neg().div_finite(2.0)
        im       : F32  = v.real.div_finite(2.0)
        return({ real: re, imag: im })

/// The hyperbolic sine, sinh a cos b + i cosh a sin b, with sinh and cosh from e^a and e^-a.
routine C64.sinh(self: Self) -> Self
    block entry()
        ep : F32 = self.real.exp()
        em : F32 = self.real.neg().exp()
        sh : F32 = ep.sub_finite(em).div_finite(2.0)
        ch : F32 = ep.add_finite(em).div_finite(2.0)
        re : F32 = sh.mul_finite(self.imag.cos())
        im : F32 = ch.mul_finite(self.imag.sin())
        return({ real: re, imag: im })

/// The hyperbolic cosine, cosh a cos b + i sinh a sin b, with sinh and cosh from e^a and e^-a.
routine C64.cosh(self: Self) -> Self
    block entry()
        ep : F32 = self.real.exp()
        em : F32 = self.real.neg().exp()
        sh : F32 = ep.sub_finite(em).div_finite(2.0)
        ch : F32 = ep.add_finite(em).div_finite(2.0)
        re : F32 = ch.mul_finite(self.imag.cos())
        im : F32 = sh.mul_finite(self.imag.sin())
        return({ real: re, imag: im })

/// The hyperbolic tangent, (sinh 2a + i sin 2b) / (cosh 2a + cos 2b).
routine C64.tanh(self: Self) -> Self
    block entry()
        a2 : F32 = self.real.add_finite(self.real)
        b2 : F32 = self.imag.add_finite(self.imag)
        ep : F32 = a2.exp()
        em : F32 = a2.neg().exp()
        ch : F32 = ep.add_finite(em).div_finite(2.0)
        d  : F32 = ch.add_finite(b2.cos())
        sh : F32 = ep.sub_finite(em).div_finite(2.0)
        re : F32 = sh.div_finite(d)
        im : F32 = b2.sin().div_finite(d)
        return({ real: re, imag: im })

/// The inverse hyperbolic sine, log(z + √(z² + 1)).
routine C64.asinh(self: Self) -> Self
    block entry()
        zz : Self = self.mul(self)
        s  : Self = zz.add(Self.one()).sqrt()
        return(self.add(s).ln())

/// The inverse hyperbolic cosine, log(z + √(z² - 1)).
routine C64.acosh(self: Self) -> Self
    block entry()
        zz : Self = self.mul(self)
        s  : Self = zz.sub(Self.one()).sqrt()
        return(self.add(s).ln())

/// The inverse hyperbolic tangent, log((1 + z) / (1 - z)) / 2.
routine C64.atanh(self: Self) -> Self
    block entry()
        p  : Self = Self.one().add(self)
        m  : Self = Self.one().sub(self)
        v  : Self = p.div(m).ln()
        re : F32  = v.real.div_finite(2.0)
        im : F32  = v.imag.div_finite(2.0)
        return({ real: re, imag: im })

/// e to this power, eᵃ (cos b + i sin b).
routine C64.exp(self: Self) -> Self
    block entry()
        ea : F32 = self.real.exp()
        re : F32 = ea.mul_finite(self.imag.cos())
        im : F32 = ea.mul_finite(self.imag.sin())
        return({ real: re, imag: im })

/// The principal natural logarithm, ln |z| + i arg z.
routine C64.ln(self: Self) -> Self
    block entry()
        re : F32 = self.abs().ln()
        return({ real: re, imag: self.arg() })

/// The base-10 logarithm, ln z / ln 10.
routine C64.log10(self: Self) -> Self
    block entry()
        v  : Self = self.ln()
        re : F32  = v.real.div_finite(C64_LN_10)
        im : F32  = v.imag.div_finite(C64_LN_10)
        return({ real: re, imag: im })

/// The base-2 logarithm, ln z / ln 2.
routine C64.log2(self: Self) -> Self
    block entry()
        v  : Self = self.ln()
        re : F32  = v.real.div_finite(C64_LN_2)
        im : F32  = v.imag.div_finite(C64_LN_2)
        return({ real: re, imag: im })

/// 1 / z, the conjugate over the squared modulus.
routine C64.reciprocal(self: Self) -> Self
    block entry()
        d  : F32 = self.norm()
        re : F32 = self.real.div_finite(d)
        im : F32 = self.imag.neg().div_finite(d)
        return({ real: re, imag: im })

/// The principal square root (real part >= 0), from half the modulus plus and minus the real part. The imaginary part
/// takes the sign of this imaginary part, so -0 and +0 pick the two sides of the cut along the negative reals.
routine C64.sqrt(self: Self) -> Self
    shared r : F32 = self.abs()

    block entry()
        branch r.eq(0.0)
            ? return({ real: 0.0, imag: 0.0 })
            : continue
        rp : F32 = r.add_finite(self.real).div_finite(2.0).sqrt()
        ip : F32 = r.sub_finite(self.real).div_finite(2.0).sqrt()
        branch self.imag.lt(0.0)
            ? return({ real: rp, imag: ip.neg() })
            : return({ real: rp, imag: ip })

/// This number to the complex power `power`, exp(power × ln self).
routine C64.pow(self: Self, power: Self) -> Self
    block entry()
        return(power.mul(self.ln()).exp())

/// This number to the integer power n, by repeated squaring: each product rounds once, with no ln and exp. A
/// negative n starts from the reciprocal, and n = 0 gives 1. The base is squared once more after the last product,
/// as RazorForge's loop does, so that squaring can overflow too.
routine C64.powi(self: Self, n: S64) -> Self
    shared result : @Self <- Self.one()
    shared k      : U64   = n.to_wrap<U64>()

    block entry()
        branch n.lt(0)
            ? square(self.reciprocal(), U64.sub_wrap(0, k))
            : square(self, k)

    block square(base: Self, left: U64)
        branch left.eq(0)
            ? return(result.load())
            : continue
        odd : Bool = left.bitand(1).eq(1)
        branch odd
            ? multiply(base, left)
            : next(base, left)

    block multiply(base: Self, left: U64)
        result.load().mul(base).store_into(result)
        jump next(base, left)

    block next(base: Self, left: U64)
        jump square(base.mul(base), left.shr(1))

/// The number at distance r and angle theta: r cos θ + i r sin θ.
routine C64.from_polar(r: F32, theta: F32) -> Self
    block entry()
        re : F32 = r.mul_finite(theta.cos())
        im : F32 = r.mul_finite(theta.sin())
        return({ real: re, imag: im })

/// Both parts in one U64, the way an export hands a C64 back: the real part's bits low, the imaginary part's high.
#inline
routine C64.bits(self: Self) -> U64
    block entry()
        low  : U64 = self.real.bits().to<U64>()
        high : U64 = self.imag.bits().to<U64>()
        return(low.bitor(high.shl(32)))

// The exports RazorForge's C64 calls.

/// The product, for C64.mul.
#[export("ingrid_c64_mul"), inline]
routine c64_mul(real: F32, imag: F32, other_real: F32, other_imag: F32) -> U64
    block entry()
        z : C64 = { real: real, imag: imag }
        w : C64 = { real: other_real, imag: other_imag }
        return(z.mul(w).bits())

/// The quotient, for C64.truediv.
#[export("ingrid_c64_div"), inline]
routine c64_div(real: F32, imag: F32, other_real: F32, other_imag: F32) -> U64
    block entry()
        z : C64 = { real: real, imag: imag }
        w : C64 = { real: other_real, imag: other_imag }
        return(z.div(w).bits())

/// The first number to the power of the second, for C64.pow.
#[export("ingrid_c64_pow"), inline]
routine c64_pow(real: F32, imag: F32, other_real: F32, other_imag: F32) -> U64
    block entry()
        z : C64 = { real: real, imag: imag }
        w : C64 = { real: other_real, imag: other_imag }
        return(z.pow(w).bits())

/// C64.abs.
#[export("ingrid_c64_abs"), inline]
routine c64_abs(real: F32, imag: F32) -> F32
    block entry()
        z : C64 = { real: real, imag: imag }
        return(z.abs())

/// C64.arg.
#[export("ingrid_c64_arg"), inline]
routine c64_arg(real: F32, imag: F32) -> F32
    block entry()
        z : C64 = { real: real, imag: imag }
        return(z.arg())

/// C64.norm.
#[export("ingrid_c64_norm"), inline]
routine c64_norm(real: F32, imag: F32) -> F32
    block entry()
        z : C64 = { real: real, imag: imag }
        return(z.norm())

/// C64.sin.
#[export("ingrid_c64_sin"), inline]
routine c64_sin(real: F32, imag: F32) -> U64
    block entry()
        z : C64 = { real: real, imag: imag }
        return(z.sin().bits())

/// C64.cos.
#[export("ingrid_c64_cos"), inline]
routine c64_cos(real: F32, imag: F32) -> U64
    block entry()
        z : C64 = { real: real, imag: imag }
        return(z.cos().bits())

/// C64.tan.
#[export("ingrid_c64_tan"), inline]
routine c64_tan(real: F32, imag: F32) -> U64
    block entry()
        z : C64 = { real: real, imag: imag }
        return(z.tan().bits())

/// C64.asin.
#[export("ingrid_c64_asin"), inline]
routine c64_asin(real: F32, imag: F32) -> U64
    block entry()
        z : C64 = { real: real, imag: imag }
        return(z.asin().bits())

/// C64.acos.
#[export("ingrid_c64_acos"), inline]
routine c64_acos(real: F32, imag: F32) -> U64
    block entry()
        z : C64 = { real: real, imag: imag }
        return(z.acos().bits())

/// C64.atan.
#[export("ingrid_c64_atan"), inline]
routine c64_atan(real: F32, imag: F32) -> U64
    block entry()
        z : C64 = { real: real, imag: imag }
        return(z.atan().bits())

/// C64.sinh.
#[export("ingrid_c64_sinh"), inline]
routine c64_sinh(real: F32, imag: F32) -> U64
    block entry()
        z : C64 = { real: real, imag: imag }
        return(z.sinh().bits())

/// C64.cosh.
#[export("ingrid_c64_cosh"), inline]
routine c64_cosh(real: F32, imag: F32) -> U64
    block entry()
        z : C64 = { real: real, imag: imag }
        return(z.cosh().bits())

/// C64.tanh.
#[export("ingrid_c64_tanh"), inline]
routine c64_tanh(real: F32, imag: F32) -> U64
    block entry()
        z : C64 = { real: real, imag: imag }
        return(z.tanh().bits())

/// C64.asinh.
#[export("ingrid_c64_asinh"), inline]
routine c64_asinh(real: F32, imag: F32) -> U64
    block entry()
        z : C64 = { real: real, imag: imag }
        return(z.asinh().bits())

/// C64.acosh.
#[export("ingrid_c64_acosh"), inline]
routine c64_acosh(real: F32, imag: F32) -> U64
    block entry()
        z : C64 = { real: real, imag: imag }
        return(z.acosh().bits())

/// C64.atanh.
#[export("ingrid_c64_atanh"), inline]
routine c64_atanh(real: F32, imag: F32) -> U64
    block entry()
        z : C64 = { real: real, imag: imag }
        return(z.atanh().bits())

/// C64.exp.
#[export("ingrid_c64_exp"), inline]
routine c64_exp(real: F32, imag: F32) -> U64
