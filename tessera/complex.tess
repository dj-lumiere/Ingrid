        return(z.powi(n))

/// The C256 at distance r and angle theta.
#[export("ingrid_c256_from_polar"), inline]
routine c256_from_polar(r_low: U64, r_high: U64, theta_low: U64, theta_high: U64) -> C256
    block entry()
        return(C256.from_polar(f128_from_halves(r_low, r_high),
            f128_from_halves(theta_low, theta_high)))
