// The crash handler for every RazorForge and Suflae program. Ingrid's Tessera code reaches it when a check fails
// (an overflow, an index out of bounds, a failed allocation): Standard::Core's crash calls tessera_crash_handler,
// and this definition takes the place of the standard library's weak default. It reports a Tessera crash the way
// RazorForge's crash report does (Core's crash_report): the crash's name (the RazorForge crashable it
// matches, such as IntegerOverflowError) and its message, where it happened, the calling thread's crash trace, then
// exit status 82, through the same runtime calls. A stack overflow is reported here too (stack_overflow_report).

import Standard::Format
import Standard::Os

/// One frame of the crash trace, laid out as the builder keeps it: the routine's name and the source file as C
/// strings, and the line and column the routine has reached.
private record TraceFrame
    routine_name : Addr
    file         : Addr
    line         : S32
    column       : S32

/// Flushes standard output, so what the program printed comes before the report.
#[external("c"), symbol("rf_flush_output")]
private routine rf_flush_output() -> Void

/// Exits with the crash status.
#[external("c"), symbol("rf_crash_exit"), noreturn]
private routine rf_crash_exit() -> Void

/// How many frames the calling thread's crash trace has pushed (0 for a build that keeps no trace).
/// :returns: The trace's depth.
#[external("c"), symbol("_rf_trace_get_depth_shared")]
private routine trace_depth() -> S32

/// The calling thread's 32 trace frames, a ring: the most recent is at (depth - 1) mod 32.
/// :returns: The address of the first of the 32 frames.
#[external("c"), symbol("_rf_trace_get_frames_shared")]
private routine trace_frames() -> @TraceFrame

/// Reports a crash and exits with the crash status (82): flushes standard output, then writes to standard error, in
/// red, the crash's name and message, where it happened (unless `place` is null), and the calling thread's crash
/// trace. Standard::Core's crash calls it in place of the standard library's weak default.
/// :param name: The crash's name, such as `IntegerOverflowError`.
/// :param message: What went wrong.
/// :param place: Where it happened, or null when that isn't known.
#[export("tessera_crash_handler"), noreturn]
routine crash_handler(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        rf_flush_output()
        Err.write("\x1B[91m{name}: {message}")
        jump where()

    block where()
        nowhere : Bool = place.is_null()
        branch nowhere
            ? newline()
            : continue
        file   : Bytes = place.file.load()
        line   : U32   = place.line.load()
        column : U32   = place.column.load()
        Err.write("\nat {file}:{line}:{column}")
        jump newline()

    block newline()
        Err.write("\n")
        write_trace()
        Err.write("\x1B[0m")
        rf_crash_exit()

/// A stack overflow, reported like any crash (exit status 82): which routines kept calling, then the trace (which
/// says how deep the calls went). The runtime's fault handler calls it on the faulting thread, in the stack the
/// system keeps back for it.
/// :param stack_size: The size of the stack the calls used up, in bytes. The report does not show it: the size of the
///     stack says nothing about the program's mistake.
#[export("tessera_stack_overflow_report"), noreturn]
routine stack_overflow_report(stack_size: U64) -> Void
    block entry()
        rf_flush_output()
        Err.write("\x1B[91mStackOverflowError: ")
        write_deep_calls()
        write_trace()
        Err.write("\x1B[0m")
        rf_crash_exit()

/// Suflae's report for the same event: Suflae has no "stack" in its vocabulary, so it is an OutOfMemoryError that
/// says which routines kept calling.
/// :param memory_size: The size of the memory the calls used up, in bytes. Not shown, like the stack's size.
#[export("tessera_deep_calls_report"), noreturn]
routine deep_calls_report(memory_size: U64) -> Void
    block entry()
        rf_flush_output()
        Err.write("\x1B[91mOutOfMemoryError: ")
        write_deep_calls()
        write_trace()
        Err.write("\x1B[0m")
        rf_crash_exit()

/// How many of the most recent frames may come before the repeating calls (the routine the stack ran out in, such as
/// an add the recursive routine called), and the longest repeating run of calls looked for.
preset CYCLE_MAX_START:  S32 = 4
preset CYCLE_MAX_PERIOD: S32 = 12

/// The sentence of a call-depth crash: the routine that called itself too many times before returning, or the
/// routines that called each other, found as the run of calls that repeats at the top of the crash trace. Without a
/// trace, or without a repeating run, it says the calls went too deep.
routine write_deep_calls() -> Void
    shared depth : S32 = trace_depth()
    shared shown : S32 = depth.min(32)

    block entry()
        jump start_at(0)

    // the repeating run may start a few frames below the most recent one
    block start_at(start: S32)
        branch start.gt(CYCLE_MAX_START)
            ? unknown()
            : continue
        period : S32 = cycle_period(depth, shown, start)
        branch period.gt(0)
            ? found(start, period)
            : start_at(start.add(1))

    block found(start: S32, period: S32)
        branch one_routine(depth, start, period)
            ? itself(start)
            : each_other(start, period)

    block itself(start: S32)
        name : Bytes = frame_name(depth, start)
        Err.write("{name} called itself too many times before returning. ")
        jump advice()

    block each_other(start: S32, period: S32)
        last : S32 = start.add(period).sub(1)
        jump name(start, last)

    // the names in the run, most recent first: "a and b", "a, b and c"
    block name(k: S32, last: S32)
        n : Bytes = frame_name(depth, k)
        branch k.eq(last)
            ? final_name(n)
            : continue
        branch k.add(1).eq(last)
            ? before_last(k, last, n)
            : continue
        Err.write("{n}, ")
        jump name(k.add(1), last)

    block before_last(k: S32, last: S32, n: Bytes)
        Err.write("{n} and ")
        jump name(k.add(1), last)

    block final_name(n: Bytes)
        Err.write("{n} called each other too many times before returning. ")
        jump advice()

    block unknown()
        Err.write("the routine calls went too deep before returning. ")
        jump advice()

    block advice()
        Err.write("Make the recursion shallower, or turn it into a loop.\n")
        return()

/// The k-th most recent frame of the calling thread's crash trace (0 is the most recent, below 32).
/// :param depth: The trace's depth.
/// :param k: How far back the frame is.
/// :returns: The frame.
routine recent_frame(depth: S32, k: S32) -> @TraceFrame
    block entry()
        back : S32         = depth.sub_wrap(1).sub_wrap(k)
        slot : USize       = back.bitand(31).to<USize>()
        at   : @TraceFrame = trace_frames().stride(slot)
        return(at)

/// Whether two frames are the same call: the same routine, stopped at the same line.
/// :param a: One frame.
/// :param b: The other.
/// :returns: True for the same call.
routine same_call(a: @TraceFrame, b: @TraceFrame) -> Bool
    block entry()
        a_routine    : U64  = ptrtoint<Addr, U64>(a.routine_name.load())
        b_routine    : U64  = ptrtoint<Addr, U64>(b.routine_name.load())
        same_routine : Bool = a_routine.eq(b_routine)
        same_line    : Bool = a.line.load().eq(b.line.load())
        return(same_routine.bitand(same_line))

/// The shortest run of calls that repeats from frame `start` down through every frame the trace kept, at least twice
/// over, or 0 when none does.
/// :param depth: The trace's depth.
/// :param shown: How many frames the trace kept.
/// :param start: The most recent frame of the run.
/// :returns: The run's length, or 0.
routine cycle_period(depth: S32, shown: S32, start: S32) -> S32
    block entry()
        jump try_period(1)

    block try_period(period: S32)
        branch period.gt(CYCLE_MAX_PERIOD)
            ? return(0)
            : continue
        // the frames compared against the run must hold it at least twice
        branch shown.sub(start).lt(period.mul(3))
            ? return(0)
            : continue
        jump compare(period, start)

    block compare(period: S32, k: S32)
        branch k.add(period).ge(shown)
            ? return(period)
            : continue
        branch same_call(recent_frame(depth, k), recent_frame(depth, k.add(period)))
            ? compare(period, k.add(1))
            : try_period(period.add(1))

/// Whether every call in the run is the same routine (a routine that calls itself from two places, such as a tree
/// walk's two halves).
/// :param depth: The trace's depth.
/// :param start: The most recent frame of the run.
/// :param period: The run's length.
/// :returns: True when the run has one routine.
routine one_routine(depth: S32, start: S32, period: S32) -> Bool
    shared first : U64 = ptrtoint<Addr, U64>(recent_frame(depth, start).routine_name.load())

    block entry()
        jump check(start.add(1))

    block check(k: S32)
        branch k.ge(start.add(period))
            ? return(true)
            : continue
        routine_address : U64 = ptrtoint<Addr, U64>(recent_frame(depth, k).routine_name.load())
        branch routine_address.eq(first)
            ? check(k.add(1))
            : return(false)

/// A frame's routine name without its parameter list: `OverflowRf.dive(Core.S64)` is `OverflowRf.dive`.
/// :param depth: The trace's depth.
/// :param k: How far back the frame is.
/// :returns: The name.
routine frame_name(depth: S32, k: S32) -> Bytes
    shared routine_ptr : @CChar = recent_frame(depth, k).routine_name.load().to<@CChar>()
    shared name        : Bytes  = routine_ptr.to<CStr>().to<Bytes>()

    block entry()
        jump scan(0)

    block scan(i: USize)
        branch i.eq(name.count())
            ? return(name)
            : continue
        // '('
        branch name.byte_at(i).eq(40)
            ? return(name.slice(0, i))
            : scan(i.add(1))

/// The calling thread's crash trace, most recent frame first: the last 32 frames, and how many there were in all when
/// there were more. Nothing for a build that keeps no trace.
routine write_trace() -> Void
    shared depth : S32 = trace_depth()
    shared shown : S32 = depth.min(32)

    block entry()
        empty : Bool = depth.le(0)
        branch empty
            ? finish()
            : continue
        Err.write("Stack trace:\n")
        jump frame(0)

    // The frames, most recent first.
    block frame(i: S32)
        done : Bool = i.ge(shown)
        branch done
            ? total()
            : continue
        back         : S32         = depth.sub_wrap(1).sub_wrap(i)
        slot         : USize       = back.bitand(31).to<USize>()
        frames       : @TraceFrame = trace_frames()
        at           : @TraceFrame = frames.stride(slot)
        routine_ptr  : @CChar      = at.routine_name.load().to<@CChar>()
        file_ptr     : @CChar      = at.file.load().to<@CChar>()
        routine_name : Bytes       = routine_ptr.to<CStr>().to<Bytes>()
        file         : Bytes       = file_ptr.to<CStr>().to<Bytes>()
        line         : S32         = at.line.load()
        column       : S32         = at.column.load()
        Err.write("  {i}: at {routine_name} ({file}:{line}:{column})\n")
        jump frame(i.add(1))

    // A trace keeps 32 frames, and says how many there were in all when there were more.
    block total()
        more : Bool = depth.gt(32)
        branch more
            ? continue
            : finish()
        Err.write("  ... ({depth} frames total)\n")
        jump finish()

    block finish()
        return()
