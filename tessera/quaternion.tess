// RazorForge's quaternions Q128 and Q256 (over B32 and B64, Tessera's F32 and F64): the bodies of their routines,
// moved here from RazorForge's Math3D/Q128.rf and Q256.rf. RazorForge keeps the types, their protocols, and thin
// routines that call the ingrid_ exports below.
//
// The formulas are RazorForge's own, unchanged, so every result has the same bits as before, and each `+ - * /` is
// the checked one (finite.tess), which crashes where RazorForge's B32 and B64 operators do. Geometry comes in as
// RazorForge's Vector3D and Matrix4R4C hold it, in F32: Q256 widens it exactly to F64 and narrows a vector it hands
// back to F32, rounding to nearest, as RazorForge's conversions do.
//
// The exports take each component as its own float and hand a quaternion, a vector, or a tuple back in Words
// (words.tess): an F32 in a word's low half, an F64 in a whole word.

/// The tolerances RazorForge writes as literals: 0.000001_b32 (a rotation that is no turn, or half a turn), 0.00001_b32
/// (unit length), 0.000000000001_b64 (Q256 uses it for all three), and 0.9995 (where slerp falls back to a normalized
/// linear interpolation).
private preset Q128_TOLERANCE:      F32 = F32.from_bits(0x358637BD)
private preset Q128_UNIT_TOLERANCE: F32 = F32.from_bits(0x3727C5AC)
private preset Q128_LINEAR:         F32 = F32.from_bits(0x3F7FDF3B)
private preset Q256_TOLERANCE:      F64 = F64.from_bits(0x3D719799812DEA11)
private preset Q256_LINEAR:         F64 = F64.from_bits(0x3FEFFBE76C8B4396)

/// Two values of one type: a direction or a point in 2D space, as RazorForge's Vector2D holds it.
/// :typeparam T: The type of the components.
record Vector2D<T>
require T: typename
    /// The x component.
    x : T
    /// The y component.
    y : T

/// Three values of one type: a direction or a point in 3D space, as RazorForge's Vector3D holds it, or three numbers
/// that go together, such as a matrix row's elements.
/// :typeparam T: The type of the components.
record Vector3D<T>
require T: typename
    /// The x component.
    x : T
    /// The y component.
    y : T
    /// The z component.
    z : T

/// Four values of one type: a vector in 4D space, as RazorForge's Vector4D holds it.
/// :typeparam T: The type of the components.
record Vector4D<T>
require T: typename
    /// The x component.
    x : T
    /// The y component.
    y : T
    /// The z component.
    z : T
    /// The w component.
    w : T

/// The upper-left 3x3 part of a rotation matrix, row after row, m{row}{column}.
/// :typeparam T: The float of the elements, F32 or F64.
record Matrix3<T>
require T: typename
    /// Row 0, column 0.
    m00 : T
    /// Row 0, column 1.
    m01 : T
    /// Row 0, column 2.
    m02 : T
    /// Row 1, column 0.
    m10 : T
    /// Row 1, column 1.
    m11 : T
    /// Row 1, column 2.
    m12 : T
    /// Row 2, column 0.
    m20 : T
    /// Row 2, column 1.
    m21 : T
    /// Row 2, column 2.
    m22 : T

// ── Q128 ──────────────────────────────────────────────────────────────────────────

/// RazorForge's Q128: a quaternion w + xi + yj + zk over F32, RazorForge's B32.
record Q128
    w : F32
    x : F32
    y : F32
    z : F32

/// The identity rotation 1 + 0i + 0j + 0k.
/// :returns: The identity quaternion.
#inline
routine Q128.identity() -> Me
    block entry()
        return({ w: 1.0, x: 0.0, y: 0.0, z: 0.0 })

/// The sum, component by component.
/// :param other: The quaternion to add.
/// :returns: The sum.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#inline
routine Q128.add(me: Me, other: Me) -> Me
    block entry()
        w : F32 = me.w.add_finite(other.w)
        x : F32 = me.x.add_finite(other.x)
        y : F32 = me.y.add_finite(other.y)
        z : F32 = me.z.add_finite(other.z)
        return({ w: w, x: x, y: y, z: z })

/// The difference, component by component.
/// :param other: The quaternion to subtract.
/// :returns: The difference.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#inline
routine Q128.sub(me: Me, other: Me) -> Me
    block entry()
        w : F32 = me.w.sub_finite(other.w)
        x : F32 = me.x.sub_finite(other.x)
        y : F32 = me.y.sub_finite(other.y)
        z : F32 = me.z.sub_finite(other.z)
        return({ w: w, x: x, y: y, z: z })

/// Every component negated.
/// :returns: The negated quaternion.
#inline
routine Q128.neg(me: Me) -> Me
    block entry()
        return({ w: me.w.neg(), x: me.x.neg(), y: me.y.neg(), z: me.z.neg() })

/// The conjugate w - xi - yj - zk.
/// :returns: The conjugate.
#inline
routine Q128.conjugate(me: Me) -> Me
    block entry()
        return({ w: me.w, x: me.x.neg(), y: me.y.neg(), z: me.z.neg() })

/// Every component times factor.
/// :param factor: The factor each component is multiplied by.
/// :returns: The scaled quaternion.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#inline
routine Q128.scale(me: Me, factor: F32) -> Me
    block entry()
        w : F32 = me.w.mul_finite(factor)
        x : F32 = me.x.mul_finite(factor)
        y : F32 = me.y.mul_finite(factor)
        z : F32 = me.z.mul_finite(factor)
        return({ w: w, x: x, y: y, z: z })

/// The Hamilton product me · other, which turns by other and then by me (it doesn't commute).
/// :param other: The right-hand factor.
/// :returns: The product.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.mul(me: Me, other: Me) -> Me
    block entry()
        ww : F32 = me.w.mul_finite(other.w)
        xx : F32 = me.x.mul_finite(other.x)
        w1 : F32 = ww.sub_finite(xx)
        yy : F32 = me.y.mul_finite(other.y)
        w2 : F32 = w1.sub_finite(yy)
        zz : F32 = me.z.mul_finite(other.z)
        w  : F32 = w2.sub_finite(zz)
        wx : F32 = me.w.mul_finite(other.x)
        xw : F32 = me.x.mul_finite(other.w)
        x1 : F32 = wx.add_finite(xw)
        yz : F32 = me.y.mul_finite(other.z)
        x2 : F32 = x1.add_finite(yz)
        zy : F32 = me.z.mul_finite(other.y)
        x  : F32 = x2.sub_finite(zy)
        wy : F32 = me.w.mul_finite(other.y)
        xz : F32 = me.x.mul_finite(other.z)
        y1 : F32 = wy.sub_finite(xz)
        yw : F32 = me.y.mul_finite(other.w)
        y2 : F32 = y1.add_finite(yw)
        zx : F32 = me.z.mul_finite(other.x)
        y  : F32 = y2.add_finite(zx)
        wz : F32 = me.w.mul_finite(other.z)
        xy : F32 = me.x.mul_finite(other.y)
        z1 : F32 = wz.add_finite(xy)
        yx : F32 = me.y.mul_finite(other.x)
        z2 : F32 = z1.sub_finite(yx)
        zw : F32 = me.z.mul_finite(other.w)
        z  : F32 = z2.add_finite(zw)
        return({ w: w, x: x, y: y, z: z })

/// The quotient me · other⁻¹.
/// :param other: The divisor.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `other` is zero and `me` is not, `NumericDomainError` when both
///     are zero (0 / 0, as with real division) or a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.div(me: Me, other: Me) -> Me
    block entry()
        branch other.is_zero()
            ? crash_zero_divisor(me.is_zero())
            : continue
        inverse : Me = other.reciprocal()
        return(me.mul(inverse))

/// Whether all four components are zero (+0 or -0).
/// :returns: True for the zero quaternion.
#inline
routine Q128.is_zero(me: Me) -> Bool
    block entry()
        wx : Bool = me.w.eq(0.0).bitand(me.x.eq(0.0))
        yz : Bool = me.y.eq(0.0).bitand(me.z.eq(0.0))
        return(wx.bitand(yz))

/// The dot product of the two as 4-vectors.
/// :param other: The other quaternion.
/// :returns: The dot product.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.dot(me: Me, other: Me) -> F32
    block entry()
        ww : F32 = me.w.mul_finite(other.w)
        xx : F32 = me.x.mul_finite(other.x)
        s1 : F32 = ww.add_finite(xx)
        yy : F32 = me.y.mul_finite(other.y)
        s2 : F32 = s1.add_finite(yy)
        zz : F32 = me.z.mul_finite(other.z)
        return(s2.add_finite(zz))

/// The squared norm w² + x² + y² + z².
/// :returns: The squared norm.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.norm(me: Me) -> F32
    block entry()
        return(me.dot(me))

/// The norm, the square root of the squared norm.
/// :returns: The norm.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.abs(me: Me) -> F32
    block entry()
        return(me.norm().sqrt())

/// The unit quaternion in the same direction, or this one when its norm is zero.
/// :returns: The unit quaternion, or `me` when its norm is zero.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.normalize(me: Me) -> Me
    shared n : F32 = me.abs()

    block entry()
        branch n.eq(0.0)
            ? return(me)
            : continue
        return(me.scale(F32.div_finite(1.0, n)))

/// The inverse, the conjugate over the squared norm.
/// :returns: The inverse.
/// :throws: Crashes with `DivisionByZeroError` when `me` is zero, `NumericDomainError` when a step gives NaN, or
///     `NumericOverflowError` when one is infinite.
routine Q128.reciprocal(me: Me) -> Me
    block entry()
        n : F32 = me.norm()
        return(me.conjugate().scale(F32.div_finite(1.0, n)))

/// Whether the norm is 1 within the tolerance.
/// :returns: True when the squared norm is within the tolerance of 1.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.is_unit(me: Me) -> Bool
    block entry()
        d     : F32  = me.norm().sub_finite(1.0)
        below : Bool = d.le(Q128_UNIT_TOLERANCE)
        return(below.bitand(d.ge(Q128_UNIT_TOLERANCE.neg())))

/// v clamped to [-1, 1], so a unit quaternion whose w drifted just past 1 still has a real acos. NaN stays NaN.
/// :param v: The value to clamp.
/// :returns: `v` clamped to [-1, 1], or NaN when `v` is NaN.
#inline
routine Q128.clamp_unit(v: F32) -> F32
    block entry()
        when
            v.gt(1.0)  -> return(1.0)
            v.lt(-1.0) -> return(-1.0)
            else       -> return(v)

/// The vector (vx, vy, vz) turned by this unit quaternion: the vector part of me · (0, v) · conj(me).
/// :param vx: The vector's x.
/// :param vy: The vector's y.
/// :param vz: The vector's z.
/// :returns: A quaternion whose x, y, and z are the turned vector.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.rotate(me: Me, vx: F32, vy: F32, vz: F32) -> Me
    block entry()
        p  : Me = { w: 0.0, x: vx, y: vy, z: vz }
        sp : Me = me.mul(p)
        return(sp.mul(me.conjugate()))

/// The spherical interpolation from me (t = 0) to other (t = 1) along the shorter arc, both unit length. Nearly
/// parallel ends fall back to a normalized linear interpolation, which avoids dividing by sin θ near 0.
/// :param other: The end at t = 1.
/// :param t: How far along, 0 at `me` and 1 at the other end.
/// :returns: The interpolated rotation.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.slerp(me: Me, other: Me, t: F32) -> Me
    shared d : F32 = me.dot(other)

    block entry()
        branch d.lt(0.0)
            ? arc(other.neg(), d.neg())
            : arc(other, d)

    block arc(target: Me, cosine: F32)
        branch cosine.gt(Q128_LINEAR)
            ? return(me.lerp(target, t))
            : continue
        theta     : F32 = cosine.acos()
        sin_theta : F32 = theta.sin()
        rest      : F32 = F32.sub_finite(1.0, t)
        wa        : F32 = rest.mul_finite(theta).sin().div_finite(sin_theta)
        wb        : F32 = t.mul_finite(theta).sin().div_finite(sin_theta)
        a         : Me  = me.scale(wa)
        b         : Me  = target.scale(wb)
        return(a.add(b))

/// me + (target - me) t, normalized.
/// :param target: The end at t = 1.
/// :param t: How far along, 0 at `me` and 1 at the other end.
/// :returns: The normalized interpolation.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.lerp(me: Me, target: Me, t: F32) -> Me
    block entry()
        step : Me = target.sub(me).scale(t)
        return(me.add(step).normalize())

/// The normalized linear interpolation from me to other along the shorter arc.
/// :param other: The end at t = 1.
/// :param t: How far along, 0 at `me` and 1 at the other end.
/// :returns: The normalized interpolation.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.nlerp(me: Me, other: Me, t: F32) -> Me
    block entry()
        branch me.dot(other).lt(0.0)
            ? return(me.lerp(other.neg(), t))
            : return(me.lerp(other, t))

/// The angle this unit quaternion turns by, 2 acos w.
/// :returns: The angle in radians.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.angle(me: Me) -> F32
    block entry()
        half : F32 = Me.clamp_unit(me.w).acos()
        return(F32.mul_finite(2.0, half))

/// The unit axis (x, y, z) and the angle this unit quaternion turns by, the angle in the last place. A turn by
/// nothing has no axis: it reports the x axis.
/// :returns: The axis's x, y, and z, then the angle in radians.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.to_axis_angle(me: Me) -> (F32, F32, F32, F32)
    shared w     : F32 = Me.clamp_unit(me.w)
    shared angle : F32 = F32.mul_finite(2.0, w.acos())

    block entry()
        ww : F32 = w.mul_finite(w)
        s  : F32 = F32.sub_finite(1.0, ww).sqrt()
        branch s.lt(Q128_TOLERANCE)
            ? return({ 1.0, 0.0, 0.0, angle })
            : continue
        x : F32 = me.x.div_finite(s)
        y : F32 = me.y.div_finite(s)
        z : F32 = me.z.div_finite(s)
        return({ x, y, z, angle })

/// The rotation by angle about the axis (ax, ay, az), which needn't be unit length (right-hand rule). An axis of
/// length zero gives the identity.
/// :param ax: The axis's x.
/// :param ay: The axis's y.
/// :param az: The axis's z.
/// :param angle: The angle in radians.
/// :returns: The rotation.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.from_axis_angle(ax: F32, ay: F32, az: F32, angle: F32) -> Me
    shared length : F32 = Me.length(ax, ay, az)

    block entry()
        branch length.eq(0.0)
            ? return(Me.identity())
            : continue
        half : F32 = angle.mul_finite(0.5)
        s    : F32 = half.sin().div_finite(length)
        x    : F32 = ax.mul_finite(s)
        y    : F32 = ay.mul_finite(s)
        z    : F32 = az.mul_finite(s)
        return({ w: half.cos(), x: x, y: y, z: z })

/// The length of the vector (x, y, z).
/// :param x: The vector's x.
/// :param y: The vector's y.
/// :param z: The vector's z.
/// :returns: The length.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.length(x: F32, y: F32, z: F32) -> F32
    block entry()
        xx : F32 = x.mul_finite(x)
        yy : F32 = y.mul_finite(y)
        s  : F32 = xx.add_finite(yy)
        zz : F32 = z.mul_finite(z)
        return(s.add_finite(zz).sqrt())

/// The shortest rotation that turns the direction `source` onto the direction `target`, neither unit length. Opposite
/// directions turn half a turn about an axis perpendicular to the first.
/// :param source: The direction to turn from.
/// :param target: The direction to turn onto.
/// :returns: The rotation.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.from_to(source: Vector3D<F32>, target: Vector3D<F32>) -> Me
    shared la : F32 = Me.length(source.x, source.y, source.z)
    shared lb : F32 = Me.length(target.x, target.y, target.z)

    block entry()
        degenerate : Bool = la.eq(0.0).bitor(lb.eq(0.0))
        branch degenerate
            ? return(Me.identity())
            : continue
        au : F32 = source.x.div_finite(la)
        bu : F32 = source.y.div_finite(la)
        cu : F32 = source.z.div_finite(la)
        av : F32 = target.x.div_finite(lb)
        bv : F32 = target.y.div_finite(lb)
        cv : F32 = target.z.div_finite(lb)
        aa : F32 = au.mul_finite(av)
        bb : F32 = bu.mul_finite(bv)
        s  : F32 = aa.add_finite(bb)
        cc : F32 = cu.mul_finite(cv)
        d  : F32 = s.add_finite(cc)
        branch d.ge(F32.sub_finite(1.0, Q128_TOLERANCE))
            ? return(Me.identity())
            : continue
        branch d.le(F32.add_finite(-1.0, Q128_TOLERANCE))
            ? return(Me.half_turn(au, bu, cu))
            : continue
        w  : F32 = F32.add_finite(1.0, d)
        b1 : F32 = bu.mul_finite(cv)
        b2 : F32 = cu.mul_finite(bv)
        x  : F32 = b1.sub_finite(b2)
        c1 : F32 = cu.mul_finite(av)
        c2 : F32 = au.mul_finite(cv)
        y  : F32 = c1.sub_finite(c2)
        a1 : F32 = au.mul_finite(bv)
        a2 : F32 = bu.mul_finite(av)
        z  : F32 = a1.sub_finite(a2)
        q  : Me  = { w: w, x: x, y: y, z: z }
        return(q.normalize())

/// Half a turn about an axis perpendicular to the unit vector (ux, uy, uz): the x axis crossed with it, or the y axis
/// crossed with it when that is too short.
/// :param ux: The unit vector's x.
/// :param uy: The unit vector's y.
/// :param uz: The unit vector's z.
/// :returns: The half-turn rotation, with w = 0.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.half_turn(ux: F32, uy: F32, uz: F32) -> Me
    shared py : F32 = uz.neg()

    block entry()
        yy    : F32  = py.mul_finite(py)
        zz    : F32  = uy.mul_finite(uy)
        short : Bool = yy.add_finite(zz).lt(Q128_TOLERANCE)
        branch short
            ? axis(uz, 0.0, ux.neg())
            : axis(0.0, py, uy)

    block axis(px: F32, qy: F32, pz: F32)
        l : F32 = Me.length(px, qy, pz)
        x : F32 = px.div_finite(l)
        y : F32 = qy.div_finite(l)
        z : F32 = pz.div_finite(l)
        return({ w: 0.0, x: x, y: y, z: z })

/// The rotation of a pure rotation matrix's upper-left 3x3 part, m{row}{column}. Shepperd's method divides by the
/// largest of 4w, 4x, 4y, and 4z to stay well conditioned.
/// :param m: The 3x3 part.
/// :returns: The rotation.
/// :throws: Crashes with `DivisionByZeroError` when a step divides by zero, `NumericDomainError` when one gives NaN,
///     or `NumericOverflowError` when one is infinite.
routine Q128.from_matrix(m: Matrix3<F32>) -> Me
    shared trace : F32 = m.m00.add_finite(m.m11).add_finite(m.m22)

    block entry()
        when
            trace.gt(0.0)                           -> by_w()
            m.m00.gt(m.m11).bitand(m.m00.gt(m.m22)) -> by_x()
            m.m11.gt(m.m22)                         -> by_y()
            else                                    -> by_z()

    block by_w()
        sw : F32 = trace.add_finite(1.0).sqrt().mul_finite(2.0)
        w  : F32 = F32.mul_finite(0.25, sw)
        x  : F32 = m.m21.sub_finite(m.m12).div_finite(sw)
        y  : F32 = m.m02.sub_finite(m.m20).div_finite(sw)
        z  : F32 = m.m10.sub_finite(m.m01).div_finite(sw)
        return({ w: w, x: x, y: y, z: z })

    block by_x()
        sx : F32 = F32.add_finite(1.0, m.m00).sub_finite(m.m11).sub_finite(m.m22)
        s  : F32 = sx.sqrt().mul_finite(2.0)
        w  : F32 = m.m21.sub_finite(m.m12).div_finite(s)
        x  : F32 = F32.mul_finite(0.25, s)
        y  : F32 = m.m01.add_finite(m.m10).div_finite(s)
        z  : F32 = m.m02.add_finite(m.m20).div_finite(s)
        return({ w: w, x: x, y: y, z: z })

    block by_y()
        sy : F32 = F32.add_finite(1.0, m.m11).sub_finite(m.m00).sub_finite(m.m22)
        s  : F32 = sy.sqrt().mul_finite(2.0)
        w  : F32 = m.m02.sub_finite(m.m20).div_finite(s)
        x  : F32 = m.m01.add_finite(m.m10).div_finite(s)
        y  : F32 = F32.mul_finite(0.25, s)
        z  : F32 = m.m12.add_finite(m.m21).div_finite(s)
        return({ w: w, x: x, y: y, z: z })

    block by_z()
        sz : F32 = F32.add_finite(1.0, m.m22).sub_finite(m.m00).sub_finite(m.m11)
        s  : F32 = sz.sqrt().mul_finite(2.0)
        w  : F32 = m.m10.sub_finite(m.m01).div_finite(s)
        x  : F32 = m.m02.add_finite(m.m20).div_finite(s)
        y  : F32 = m.m12.add_finite(m.m21).div_finite(s)
        z  : F32 = F32.mul_finite(0.25, s)
        return({ w: w, x: x, y: y, z: z })

/// The rotation by Euler angles in radians: yaw about z, then pitch about y, then roll about x (the aerospace Z-Y-X
/// order, yaw · pitch · roll).
/// :param roll: The turn about x, in radians.
/// :param pitch: The turn about y, in radians.
/// :param yaw: The turn about z, in radians.
/// :returns: The rotation.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.from_euler(roll: F32, pitch: F32, yaw: F32) -> Me
    block entry()
        cr : F32 = roll.mul_finite(0.5).cos()
        sr : F32 = roll.mul_finite(0.5).sin()
        cp : F32 = pitch.mul_finite(0.5).cos()
        sp : F32 = pitch.mul_finite(0.5).sin()
        cy : F32 = yaw.mul_finite(0.5).cos()
        sy : F32 = yaw.mul_finite(0.5).sin()
        w1 : F32 = cr.mul_finite(cp).mul_finite(cy)
        w2 : F32 = sr.mul_finite(sp).mul_finite(sy)
        w  : F32 = w1.add_finite(w2)
        x1 : F32 = sr.mul_finite(cp).mul_finite(cy)
        x2 : F32 = cr.mul_finite(sp).mul_finite(sy)
        x  : F32 = x1.sub_finite(x2)
        y1 : F32 = cr.mul_finite(sp).mul_finite(cy)
        y2 : F32 = sr.mul_finite(cp).mul_finite(sy)
        y  : F32 = y1.add_finite(y2)
        z1 : F32 = cr.mul_finite(cp).mul_finite(sy)
        z2 : F32 = sr.mul_finite(sp).mul_finite(cy)
        z  : F32 = z1.sub_finite(z2)
        return({ w: w, x: x, y: y, z: z })

/// The Z-Y-X Euler angles (roll, pitch, yaw) of this unit quaternion, the inverse of from_euler. At pitch ±90 degrees
/// (gimbal lock) roll and yaw aren't unique, and pitch is clamped there.
/// :returns: Roll, pitch, and yaw, in radians.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q128.to_euler(me: Me) -> (F32, F32, F32)
    block entry()
        wx    : F32 = me.w.mul_finite(me.x)
        yz    : F32 = me.y.mul_finite(me.z)
        ry    : F32 = F32.mul_finite(2.0, wx.add_finite(yz))
        xx    : F32 = me.x.mul_finite(me.x)
        yy    : F32 = me.y.mul_finite(me.y)
        rx2   : F32 = F32.mul_finite(2.0, xx.add_finite(yy))
        rx    : F32 = F32.sub_finite(1.0, rx2)
        roll  : F32 = ry.atan2(rx)
        wy    : F32 = me.w.mul_finite(me.y)
        zx    : F32 = me.z.mul_finite(me.x)
        sp    : F32 = F32.mul_finite(2.0, wy.sub_finite(zx))
        pitch : F32 = Me.clamp_unit(sp).asin()
        wz    : F32 = me.w.mul_finite(me.z)
        xy    : F32 = me.x.mul_finite(me.y)
        yy2   : F32 = F32.mul_finite(2.0, wz.add_finite(xy))
        y2    : F32 = me.y.mul_finite(me.y)
        z2    : F32 = me.z.mul_finite(me.z)
        yx2   : F32 = F32.mul_finite(2.0, y2.add_finite(z2))
        yx    : F32 = F32.sub_finite(1.0, yx2)
        yaw   : F32 = yy2.atan2(yx)
        return({ roll, pitch, yaw })

/// The four components in Words, w first.
/// :returns: The components w, x, y, and z in Words.
#inline
routine Q128.words(me: Me) -> Words
    block entry()
        return(Words.construct(me.w, me.x, me.y, me.z))

// The exports RazorForge's Q128 calls: each component of a quaternion is its own F32, and a Vector3D's or a
// Matrix4R4C's is its own F32.

/// The Hamilton product, for Q128.mul.
/// :param w: The first quaternion's w.
/// :param x: The first quaternion's x.
/// :param y: The first quaternion's y.
/// :param z: The first quaternion's z.
/// :param other_w: The second quaternion's w.
/// :param other_x: The second quaternion's x.
/// :param other_y: The second quaternion's y.
/// :param other_z: The second quaternion's z.
/// :returns: The product's components in Words, w first.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_mul"), inline]
routine q128_mul(w: F32, x: F32, y: F32, z: F32, other_w: F32, other_x: F32, other_y: F32,
    other_z: F32) -> Words
    block entry()
        a : Q128 = { w: w, x: x, y: y, z: z }
        b : Q128 = { w: other_w, x: other_x, y: other_y, z: other_z }
        return(a.mul(b).words())

/// The quotient, for Q128.truediv.
/// :param w: The first quaternion's w.
/// :param x: The first quaternion's x.
/// :param y: The first quaternion's y.
/// :param z: The first quaternion's z.
/// :param other_w: The second quaternion's w.
/// :param other_x: The second quaternion's x.
/// :param other_y: The second quaternion's y.
/// :param other_z: The second quaternion's z.
/// :returns: The quotient's components in Words, w first.
/// :throws: Crashes with `DivisionByZeroError` when the second quaternion is zero and the first is not,
///     `NumericDomainError` when both are zero (0 / 0, as with real division) or a step gives NaN, or
///     `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_div"), inline]
routine q128_div(w: F32, x: F32, y: F32, z: F32, other_w: F32, other_x: F32, other_y: F32,
    other_z: F32) -> Words
    block entry()
        a : Q128 = { w: w, x: x, y: y, z: z }
        b : Q128 = { w: other_w, x: other_x, y: other_y, z: other_z }
        return(a.div(b).words())

/// The dot product, for Q128.dot.
/// :param w: The first quaternion's w.
/// :param x: The first quaternion's x.
/// :param y: The first quaternion's y.
/// :param z: The first quaternion's z.
/// :param other_w: The second quaternion's w.
/// :param other_x: The second quaternion's x.
/// :param other_y: The second quaternion's y.
/// :param other_z: The second quaternion's z.
/// :returns: The dot product.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_dot"), inline]
routine q128_dot(w: F32, x: F32, y: F32, z: F32, other_w: F32, other_x: F32, other_y: F32,
    other_z: F32) -> F32
    block entry()
        a : Q128 = { w: w, x: x, y: y, z: z }
        b : Q128 = { w: other_w, x: other_x, y: other_y, z: other_z }
        return(a.dot(b))

/// The squared norm, for Q128.norm.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :returns: The squared norm.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_norm"), inline]
routine q128_norm(w: F32, x: F32, y: F32, z: F32) -> F32
    block entry()
        a : Q128 = { w: w, x: x, y: y, z: z }
        return(a.norm())

/// The norm, for Q128.abs.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :returns: The norm.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_abs"), inline]
routine q128_abs(w: F32, x: F32, y: F32, z: F32) -> F32
    block entry()
        a : Q128 = { w: w, x: x, y: y, z: z }
        return(a.abs())

/// The angle the unit quaternion turns by, for Q128.angle.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :returns: The angle in radians.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_angle"), inline]
routine q128_angle(w: F32, x: F32, y: F32, z: F32) -> F32
    block entry()
        a : Q128 = { w: w, x: x, y: y, z: z }
        return(a.angle())

/// The unit quaternion in the same direction, for Q128.normalize.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :returns: The unit quaternion's components in Words, w first.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_normalize"), inline]
routine q128_normalize(w: F32, x: F32, y: F32, z: F32) -> Words
    block entry()
        a : Q128 = { w: w, x: x, y: y, z: z }
        return(a.normalize().words())

/// The inverse, for Q128.reciprocal.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :returns: The inverse's components in Words, w first.
/// :throws: Crashes with `DivisionByZeroError` when the quaternion is zero, `NumericDomainError` when a step gives
///     NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_reciprocal"), inline]
routine q128_reciprocal(w: F32, x: F32, y: F32, z: F32) -> Words
    block entry()
        a : Q128 = { w: w, x: x, y: y, z: z }
        return(a.reciprocal().words())

/// Whether the norm is 1 within the tolerance, for Q128.is_unit.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :returns: True when the squared norm is within the tolerance of 1.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_is_unit"), inline]
routine q128_is_unit(w: F32, x: F32, y: F32, z: F32) -> Bool
    block entry()
        a : Q128 = { w: w, x: x, y: y, z: z }
        return(a.is_unit())

/// Q128.rotate: the turned vector's x, y, and z in w0, w1, and w2, as F32s.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :param vx: The vector's x.
/// :param vy: The vector's y.
/// :param vz: The vector's z.
/// :returns: The turned vector in Words.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_rotate"), inline]
routine q128_rotate(w: F32, x: F32, y: F32, z: F32, vx: F32, vy: F32, vz: F32) -> Words
    block entry()
        a : Q128 = { w: w, x: x, y: y, z: z }
        r : Q128 = a.rotate(vx, vy, vz)
        return(Words.construct(r.x, r.y, r.z, F32.from_bits(0)))

/// The spherical interpolation, for Q128.slerp.
/// :param w: The first quaternion's w.
/// :param x: The first quaternion's x.
/// :param y: The first quaternion's y.
/// :param z: The first quaternion's z.
/// :param other_w: The second quaternion's w.
/// :param other_x: The second quaternion's x.
/// :param other_y: The second quaternion's y.
/// :param other_z: The second quaternion's z.
/// :param t: How far along, 0 at the first quaternion and 1 at the second.
/// :returns: The interpolated rotation's components in Words, w first.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_slerp"), inline]
routine q128_slerp(w: F32, x: F32, y: F32, z: F32, other_w: F32, other_x: F32, other_y: F32,
    other_z: F32, t: F32) -> Words
    block entry()
        a : Q128 = { w: w, x: x, y: y, z: z }
        b : Q128 = { w: other_w, x: other_x, y: other_y, z: other_z }
        return(a.slerp(b, t).words())

/// The normalized linear interpolation, for Q128.nlerp.
/// :param w: The first quaternion's w.
/// :param x: The first quaternion's x.
/// :param y: The first quaternion's y.
/// :param z: The first quaternion's z.
/// :param other_w: The second quaternion's w.
/// :param other_x: The second quaternion's x.
/// :param other_y: The second quaternion's y.
/// :param other_z: The second quaternion's z.
/// :param t: How far along, 0 at the first quaternion and 1 at the second.
/// :returns: The interpolation's components in Words, w first.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_nlerp"), inline]
routine q128_nlerp(w: F32, x: F32, y: F32, z: F32, other_w: F32, other_x: F32, other_y: F32,
    other_z: F32, t: F32) -> Words
    block entry()
        a : Q128 = { w: w, x: x, y: y, z: z }
        b : Q128 = { w: other_w, x: other_x, y: other_y, z: other_z }
        return(a.nlerp(b, t).words())

/// Q128.to_axis_angle: the axis's x, y, and z as F32s in w0, w1, and w2, the angle as F32 in w3.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :returns: The axis and the angle in Words.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_to_axis_angle"), inline]
routine q128_to_axis_angle(w: F32, x: F32, y: F32, z: F32) -> Words
    block entry()
        a : Q128 = { w: w, x: x, y: y, z: z }
        ax, ay, az, angle = a.to_axis_angle()
        w0 : U64 = ax.bits().to<U64>()
        w1 : U64 = ay.bits().to<U64>()
        w2 : U64 = az.bits().to<U64>()
        w3 : U64 = angle.bits().to<U64>()
        return({ w0: w0, w1: w1, w2: w2, w3: w3 })

/// Q128.to_euler: roll, pitch, and yaw in w0, w1, and w2.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :returns: The three angles in Words.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_to_euler"), inline]
routine q128_to_euler(w: F32, x: F32, y: F32, z: F32) -> Words
    block entry()
        a : Q128 = { w: w, x: x, y: y, z: z }
        roll, pitch, yaw = a.to_euler()
        return(Words.construct(roll, pitch, yaw, F32.from_bits(0)))

/// Q128.from_axis_angle, for an F32 axis.
/// :param ax: The axis's x.
/// :param ay: The axis's y.
/// :param az: The axis's z.
/// :param angle: The angle in radians.
/// :returns: The resulting quaternion's components in Words, w first.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_from_axis_angle"), inline]
routine q128_from_axis_angle(ax: F32, ay: F32, az: F32, angle: F32) -> Words
    block entry()
        return(Q128.from_axis_angle(ax, ay, az, angle).words())

/// Q128.from_to, for F32 directions.
/// :param ux: The first direction's x.
/// :param uy: The first direction's y.
/// :param uz: The first direction's z.
/// :param vx: The second direction's x.
/// :param vy: The second direction's y.
/// :param vz: The second direction's z.
/// :returns: The resulting quaternion's components in Words, w first.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_from_to"), inline]
routine q128_from_to(ux: F32, uy: F32, uz: F32, vx: F32, vy: F32, vz: F32) -> Words
    block entry()
        source : Vector3D<F32> = { x: ux, y: uy, z: uz }
        target : Vector3D<F32> = { x: vx, y: vy, z: vz }
        q      : Q128          = Q128.from_to(source, target)
        return(q.words())

/// Q128.from_matrix, for the F32 elements m{row}{column} of the upper-left 3x3 part.
/// :param m00: The element in row 0, column 0.
/// :param m01: The element in row 0, column 1.
/// :param m02: The element in row 0, column 2.
/// :param m10: The element in row 1, column 0.
/// :param m11: The element in row 1, column 1.
/// :param m12: The element in row 1, column 2.
/// :param m20: The element in row 2, column 0.
/// :param m21: The element in row 2, column 1.
/// :param m22: The element in row 2, column 2.
/// :returns: The resulting quaternion's components in Words, w first.
/// :throws: Crashes with `DivisionByZeroError` when a step divides by zero, `NumericDomainError` when one gives NaN,
///     or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_from_matrix"), inline]
routine q128_from_matrix(m00: F32, m01: F32, m02: F32, m10: F32, m11: F32, m12: F32, m20: F32,
    m21: F32, m22: F32) -> Words
    block entry()
        m : Matrix3<F32> = { m00: m00, m01: m01, m02: m02, m10: m10, m11: m11, m12: m12, m20: m20,
            m21: m21, m22: m22 }
        q : Q128         = Q128.from_matrix(m)
        return(q.words())

/// The rotation by Euler angles, for Q128.from_euler.
/// :param roll: The turn about x, in radians.
/// :param pitch: The turn about y, in radians.
/// :param yaw: The turn about z, in radians.
/// :returns: The resulting quaternion's components in Words, w first.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q128_from_euler"), inline]
routine q128_from_euler(roll: F32, pitch: F32, yaw: F32) -> Words
    block entry()
        return(Q128.from_euler(roll, pitch, yaw).words())

// ── Q256 ──────────────────────────────────────────────────────────────────────────

/// RazorForge's Q256: a quaternion w + xi + yj + zk over F64, RazorForge's B64.
record Q256
    w : F64
    x : F64
    y : F64
    z : F64

/// The identity rotation 1 + 0i + 0j + 0k.
/// :returns: The identity quaternion.
#inline
routine Q256.identity() -> Me
    block entry()
        return({ w: 1.0, x: 0.0, y: 0.0, z: 0.0 })

/// The sum, component by component.
/// :param other: The quaternion to add.
/// :returns: The sum.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#inline
routine Q256.add(me: Me, other: Me) -> Me
    block entry()
        w : F64 = me.w.add_finite(other.w)
        x : F64 = me.x.add_finite(other.x)
        y : F64 = me.y.add_finite(other.y)
        z : F64 = me.z.add_finite(other.z)
        return({ w: w, x: x, y: y, z: z })

/// The difference, component by component.
/// :param other: The quaternion to subtract.
/// :returns: The difference.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#inline
routine Q256.sub(me: Me, other: Me) -> Me
    block entry()
        w : F64 = me.w.sub_finite(other.w)
        x : F64 = me.x.sub_finite(other.x)
        y : F64 = me.y.sub_finite(other.y)
        z : F64 = me.z.sub_finite(other.z)
        return({ w: w, x: x, y: y, z: z })

/// Every component negated.
/// :returns: The negated quaternion.
#inline
routine Q256.neg(me: Me) -> Me
    block entry()
        return({ w: me.w.neg(), x: me.x.neg(), y: me.y.neg(), z: me.z.neg() })

/// The conjugate w - xi - yj - zk.
/// :returns: The conjugate.
#inline
routine Q256.conjugate(me: Me) -> Me
    block entry()
        return({ w: me.w, x: me.x.neg(), y: me.y.neg(), z: me.z.neg() })

/// Every component times factor.
/// :param factor: The factor each component is multiplied by.
/// :returns: The scaled quaternion.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#inline
routine Q256.scale(me: Me, factor: F64) -> Me
    block entry()
        w : F64 = me.w.mul_finite(factor)
        x : F64 = me.x.mul_finite(factor)
        y : F64 = me.y.mul_finite(factor)
        z : F64 = me.z.mul_finite(factor)
        return({ w: w, x: x, y: y, z: z })

/// The Hamilton product me · other, which turns by other and then by me (it doesn't commute).
/// :param other: The right-hand factor.
/// :returns: The product.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.mul(me: Me, other: Me) -> Me
    block entry()
        ww : F64 = me.w.mul_finite(other.w)
        xx : F64 = me.x.mul_finite(other.x)
        w1 : F64 = ww.sub_finite(xx)
        yy : F64 = me.y.mul_finite(other.y)
        w2 : F64 = w1.sub_finite(yy)
        zz : F64 = me.z.mul_finite(other.z)
        w  : F64 = w2.sub_finite(zz)
        wx : F64 = me.w.mul_finite(other.x)
        xw : F64 = me.x.mul_finite(other.w)
        x1 : F64 = wx.add_finite(xw)
        yz : F64 = me.y.mul_finite(other.z)
        x2 : F64 = x1.add_finite(yz)
        zy : F64 = me.z.mul_finite(other.y)
        x  : F64 = x2.sub_finite(zy)
        wy : F64 = me.w.mul_finite(other.y)
        xz : F64 = me.x.mul_finite(other.z)
        y1 : F64 = wy.sub_finite(xz)
        yw : F64 = me.y.mul_finite(other.w)
        y2 : F64 = y1.add_finite(yw)
        zx : F64 = me.z.mul_finite(other.x)
        y  : F64 = y2.add_finite(zx)
        wz : F64 = me.w.mul_finite(other.z)
        xy : F64 = me.x.mul_finite(other.y)
        z1 : F64 = wz.add_finite(xy)
        yx : F64 = me.y.mul_finite(other.x)
        z2 : F64 = z1.sub_finite(yx)
        zw : F64 = me.z.mul_finite(other.w)
        z  : F64 = z2.add_finite(zw)
        return({ w: w, x: x, y: y, z: z })

/// The quotient me · other⁻¹.
/// :param other: The divisor.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `other` is zero and `me` is not, `NumericDomainError` when both
///     are zero (0 / 0, as with real division) or a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.div(me: Me, other: Me) -> Me
    block entry()
        branch other.is_zero()
            ? crash_zero_divisor(me.is_zero())
            : continue
        inverse : Me = other.reciprocal()
        return(me.mul(inverse))

/// Whether all four components are zero (+0 or -0).
/// :returns: True for the zero quaternion.
#inline
routine Q256.is_zero(me: Me) -> Bool
    block entry()
        wx : Bool = me.w.eq(0.0).bitand(me.x.eq(0.0))
        yz : Bool = me.y.eq(0.0).bitand(me.z.eq(0.0))
        return(wx.bitand(yz))

/// The dot product of the two as 4-vectors.
/// :param other: The other quaternion.
/// :returns: The dot product.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.dot(me: Me, other: Me) -> F64
    block entry()
        ww : F64 = me.w.mul_finite(other.w)
        xx : F64 = me.x.mul_finite(other.x)
        s1 : F64 = ww.add_finite(xx)
        yy : F64 = me.y.mul_finite(other.y)
        s2 : F64 = s1.add_finite(yy)
        zz : F64 = me.z.mul_finite(other.z)
        return(s2.add_finite(zz))

/// The squared norm w² + x² + y² + z².
/// :returns: The squared norm.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.norm(me: Me) -> F64
    block entry()
        return(me.dot(me))

/// The norm, the square root of the squared norm.
/// :returns: The norm.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.abs(me: Me) -> F64
    block entry()
        return(me.norm().sqrt())

/// The unit quaternion in the same direction, or this one when its norm is zero.
/// :returns: The unit quaternion, or `me` when its norm is zero.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.normalize(me: Me) -> Me
    shared n : F64 = me.abs()

    block entry()
        branch n.eq(0.0)
            ? return(me)
            : continue
        return(me.scale(F64.div_finite(1.0, n)))

/// The inverse, the conjugate over the squared norm.
/// :returns: The inverse.
/// :throws: Crashes with `DivisionByZeroError` when `me` is zero, `NumericDomainError` when a step gives NaN, or
///     `NumericOverflowError` when one is infinite.
routine Q256.reciprocal(me: Me) -> Me
    block entry()
        n : F64 = me.norm()
        return(me.conjugate().scale(F64.div_finite(1.0, n)))

/// Whether the norm is 1 within the tolerance.
/// :returns: True when the squared norm is within the tolerance of 1.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.is_unit(me: Me) -> Bool
    block entry()
        d     : F64  = me.norm().sub_finite(1.0)
        below : Bool = d.le(Q256_TOLERANCE)
        return(below.bitand(d.ge(Q256_TOLERANCE.neg())))

/// v clamped to [-1, 1], so a unit quaternion whose w drifted just past 1 still has a real acos. NaN stays NaN.
/// :param v: The value to clamp.
/// :returns: `v` clamped to [-1, 1], or NaN when `v` is NaN.
#inline
routine Q256.clamp_unit(v: F64) -> F64
    block entry()
        when
            v.gt(1.0)  -> return(1.0)
            v.lt(-1.0) -> return(-1.0)
            else       -> return(v)

/// The vector (vx, vy, vz) turned by this unit quaternion: the vector part of me · (0, v) · conj(me).
/// :param vx: The vector's x.
/// :param vy: The vector's y.
/// :param vz: The vector's z.
/// :returns: A quaternion whose x, y, and z are the turned vector.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.rotate(me: Me, vx: F64, vy: F64, vz: F64) -> Me
    block entry()
        p  : Me = { w: 0.0, x: vx, y: vy, z: vz }
        sp : Me = me.mul(p)
        return(sp.mul(me.conjugate()))

/// The spherical interpolation from me (t = 0) to other (t = 1) along the shorter arc, both unit length. Nearly
/// parallel ends fall back to a normalized linear interpolation, which avoids dividing by sin θ near 0.
/// :param other: The end at t = 1.
/// :param t: How far along, 0 at `me` and 1 at the other end.
/// :returns: The interpolated rotation.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.slerp(me: Me, other: Me, t: F64) -> Me
    shared d : F64 = me.dot(other)

    block entry()
        branch d.lt(0.0)
            ? arc(other.neg(), d.neg())
            : arc(other, d)

    block arc(target: Me, cosine: F64)
        branch cosine.gt(Q256_LINEAR)
            ? return(me.lerp(target, t))
            : continue
        theta     : F64 = cosine.acos()
        sin_theta : F64 = theta.sin()
        rest      : F64 = F64.sub_finite(1.0, t)
        wa        : F64 = rest.mul_finite(theta).sin().div_finite(sin_theta)
        wb        : F64 = t.mul_finite(theta).sin().div_finite(sin_theta)
        a         : Me  = me.scale(wa)
        b         : Me  = target.scale(wb)
        return(a.add(b))

/// me + (target - me) t, normalized.
/// :param target: The end at t = 1.
/// :param t: How far along, 0 at `me` and 1 at the other end.
/// :returns: The normalized interpolation.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.lerp(me: Me, target: Me, t: F64) -> Me
    block entry()
        step : Me = target.sub(me).scale(t)
        return(me.add(step).normalize())

/// The normalized linear interpolation from me to other along the shorter arc.
/// :param other: The end at t = 1.
/// :param t: How far along, 0 at `me` and 1 at the other end.
/// :returns: The normalized interpolation.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.nlerp(me: Me, other: Me, t: F64) -> Me
    block entry()
        branch me.dot(other).lt(0.0)
            ? return(me.lerp(other.neg(), t))
            : return(me.lerp(other, t))

/// The angle this unit quaternion turns by, 2 acos w.
/// :returns: The angle in radians.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.angle(me: Me) -> F64
    block entry()
        half : F64 = Me.clamp_unit(me.w).acos()
        return(F64.mul_finite(2.0, half))

/// The unit axis (x, y, z) and the angle this unit quaternion turns by, the angle in the last place. A turn by
/// nothing has no axis: it reports the x axis.
/// :returns: The axis's x, y, and z, then the angle in radians.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.to_axis_angle(me: Me) -> (F64, F64, F64, F64)
    shared w     : F64 = Me.clamp_unit(me.w)
    shared angle : F64 = F64.mul_finite(2.0, w.acos())

    block entry()
        ww : F64 = w.mul_finite(w)
        s  : F64 = F64.sub_finite(1.0, ww).sqrt()
        branch s.lt(Q256_TOLERANCE)
            ? return({ 1.0, 0.0, 0.0, angle })
            : continue
        x : F64 = me.x.div_finite(s)
        y : F64 = me.y.div_finite(s)
        z : F64 = me.z.div_finite(s)
        return({ x, y, z, angle })

/// The rotation by angle about the axis (ax, ay, az), which needn't be unit length (right-hand rule). An axis of
/// length zero gives the identity.
/// :param ax: The axis's x.
/// :param ay: The axis's y.
/// :param az: The axis's z.
/// :param angle: The angle in radians.
/// :returns: The rotation.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.from_axis_angle(ax: F64, ay: F64, az: F64, angle: F64) -> Me
    shared length : F64 = Me.length(ax, ay, az)

    block entry()
        branch length.eq(0.0)
            ? return(Me.identity())
            : continue
        half : F64 = angle.mul_finite(0.5)
        s    : F64 = half.sin().div_finite(length)
        x    : F64 = ax.mul_finite(s)
        y    : F64 = ay.mul_finite(s)
        z    : F64 = az.mul_finite(s)
        return({ w: half.cos(), x: x, y: y, z: z })

/// The length of the vector (x, y, z).
/// :param x: The vector's x.
/// :param y: The vector's y.
/// :param z: The vector's z.
/// :returns: The length.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.length(x: F64, y: F64, z: F64) -> F64
    block entry()
        xx : F64 = x.mul_finite(x)
        yy : F64 = y.mul_finite(y)
        s  : F64 = xx.add_finite(yy)
        zz : F64 = z.mul_finite(z)
        return(s.add_finite(zz).sqrt())

/// The shortest rotation that turns the direction `source` onto the direction `target`, neither unit length. Opposite
/// directions turn half a turn about an axis perpendicular to the first.
/// :param source: The direction to turn from.
/// :param target: The direction to turn onto.
/// :returns: The rotation.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.from_to(source: Vector3D<F64>, target: Vector3D<F64>) -> Me
    shared la : F64 = Me.length(source.x, source.y, source.z)
    shared lb : F64 = Me.length(target.x, target.y, target.z)

    block entry()
        degenerate : Bool = la.eq(0.0).bitor(lb.eq(0.0))
        branch degenerate
            ? return(Me.identity())
            : continue
        au : F64 = source.x.div_finite(la)
        bu : F64 = source.y.div_finite(la)
        cu : F64 = source.z.div_finite(la)
        av : F64 = target.x.div_finite(lb)
        bv : F64 = target.y.div_finite(lb)
        cv : F64 = target.z.div_finite(lb)
        aa : F64 = au.mul_finite(av)
        bb : F64 = bu.mul_finite(bv)
        s  : F64 = aa.add_finite(bb)
        cc : F64 = cu.mul_finite(cv)
        d  : F64 = s.add_finite(cc)
        branch d.ge(F64.sub_finite(1.0, Q256_TOLERANCE))
            ? return(Me.identity())
            : continue
        branch d.le(F64.add_finite(-1.0, Q256_TOLERANCE))
            ? return(Me.half_turn(au, bu, cu))
            : continue
        w  : F64 = F64.add_finite(1.0, d)
        b1 : F64 = bu.mul_finite(cv)
        b2 : F64 = cu.mul_finite(bv)
        x  : F64 = b1.sub_finite(b2)
        c1 : F64 = cu.mul_finite(av)
        c2 : F64 = au.mul_finite(cv)
        y  : F64 = c1.sub_finite(c2)
        a1 : F64 = au.mul_finite(bv)
        a2 : F64 = bu.mul_finite(av)
        z  : F64 = a1.sub_finite(a2)
        q  : Me  = { w: w, x: x, y: y, z: z }
        return(q.normalize())

/// Half a turn about an axis perpendicular to the unit vector (ux, uy, uz): the x axis crossed with it, or the y axis
/// crossed with it when that is too short.
/// :param ux: The unit vector's x.
/// :param uy: The unit vector's y.
/// :param uz: The unit vector's z.
/// :returns: The half-turn rotation, with w = 0.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.half_turn(ux: F64, uy: F64, uz: F64) -> Me
    shared py : F64 = uz.neg()

    block entry()
        yy    : F64  = py.mul_finite(py)
        zz    : F64  = uy.mul_finite(uy)
        short : Bool = yy.add_finite(zz).lt(Q256_TOLERANCE)
        branch short
            ? axis(uz, 0.0, ux.neg())
            : axis(0.0, py, uy)

    block axis(px: F64, qy: F64, pz: F64)
        l : F64 = Me.length(px, qy, pz)
        x : F64 = px.div_finite(l)
        y : F64 = qy.div_finite(l)
        z : F64 = pz.div_finite(l)
        return({ w: 0.0, x: x, y: y, z: z })

/// The rotation of a pure rotation matrix's upper-left 3x3 part, m{row}{column}. Shepperd's method divides by the
/// largest of 4w, 4x, 4y, and 4z to stay well conditioned.
/// :param m: The 3x3 part.
/// :returns: The rotation.
/// :throws: Crashes with `DivisionByZeroError` when a step divides by zero, `NumericDomainError` when one gives NaN,
///     or `NumericOverflowError` when one is infinite.
routine Q256.from_matrix(m: Matrix3<F64>) -> Me
    shared trace : F64 = m.m00.add_finite(m.m11).add_finite(m.m22)

    block entry()
        when
            trace.gt(0.0)                           -> by_w()
            m.m00.gt(m.m11).bitand(m.m00.gt(m.m22)) -> by_x()
            m.m11.gt(m.m22)                         -> by_y()
            else                                    -> by_z()

    block by_w()
        sw : F64 = trace.add_finite(1.0).sqrt().mul_finite(2.0)
        w  : F64 = F64.mul_finite(0.25, sw)
        x  : F64 = m.m21.sub_finite(m.m12).div_finite(sw)
        y  : F64 = m.m02.sub_finite(m.m20).div_finite(sw)
        z  : F64 = m.m10.sub_finite(m.m01).div_finite(sw)
        return({ w: w, x: x, y: y, z: z })

    block by_x()
        sx : F64 = F64.add_finite(1.0, m.m00).sub_finite(m.m11).sub_finite(m.m22)
        s  : F64 = sx.sqrt().mul_finite(2.0)
        w  : F64 = m.m21.sub_finite(m.m12).div_finite(s)
        x  : F64 = F64.mul_finite(0.25, s)
        y  : F64 = m.m01.add_finite(m.m10).div_finite(s)
        z  : F64 = m.m02.add_finite(m.m20).div_finite(s)
        return({ w: w, x: x, y: y, z: z })

    block by_y()
        sy : F64 = F64.add_finite(1.0, m.m11).sub_finite(m.m00).sub_finite(m.m22)
        s  : F64 = sy.sqrt().mul_finite(2.0)
        w  : F64 = m.m02.sub_finite(m.m20).div_finite(s)
        x  : F64 = m.m01.add_finite(m.m10).div_finite(s)
        y  : F64 = F64.mul_finite(0.25, s)
        z  : F64 = m.m12.add_finite(m.m21).div_finite(s)
        return({ w: w, x: x, y: y, z: z })

    block by_z()
        sz : F64 = F64.add_finite(1.0, m.m22).sub_finite(m.m00).sub_finite(m.m11)
        s  : F64 = sz.sqrt().mul_finite(2.0)
        w  : F64 = m.m10.sub_finite(m.m01).div_finite(s)
        x  : F64 = m.m02.add_finite(m.m20).div_finite(s)
        y  : F64 = m.m12.add_finite(m.m21).div_finite(s)
        z  : F64 = F64.mul_finite(0.25, s)
        return({ w: w, x: x, y: y, z: z })

/// The rotation by Euler angles in radians: yaw about z, then pitch about y, then roll about x (the aerospace Z-Y-X
/// order, yaw · pitch · roll).
/// :param roll: The turn about x, in radians.
/// :param pitch: The turn about y, in radians.
/// :param yaw: The turn about z, in radians.
/// :returns: The rotation.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.from_euler(roll: F64, pitch: F64, yaw: F64) -> Me
    block entry()
        cr : F64 = roll.mul_finite(0.5).cos()
        sr : F64 = roll.mul_finite(0.5).sin()
        cp : F64 = pitch.mul_finite(0.5).cos()
        sp : F64 = pitch.mul_finite(0.5).sin()
        cy : F64 = yaw.mul_finite(0.5).cos()
        sy : F64 = yaw.mul_finite(0.5).sin()
        w1 : F64 = cr.mul_finite(cp).mul_finite(cy)
        w2 : F64 = sr.mul_finite(sp).mul_finite(sy)
        w  : F64 = w1.add_finite(w2)
        x1 : F64 = sr.mul_finite(cp).mul_finite(cy)
        x2 : F64 = cr.mul_finite(sp).mul_finite(sy)
        x  : F64 = x1.sub_finite(x2)
        y1 : F64 = cr.mul_finite(sp).mul_finite(cy)
        y2 : F64 = sr.mul_finite(cp).mul_finite(sy)
        y  : F64 = y1.add_finite(y2)
        z1 : F64 = cr.mul_finite(cp).mul_finite(sy)
        z2 : F64 = sr.mul_finite(sp).mul_finite(cy)
        z  : F64 = z1.sub_finite(z2)
        return({ w: w, x: x, y: y, z: z })

/// The Z-Y-X Euler angles (roll, pitch, yaw) of this unit quaternion, the inverse of from_euler. At pitch ±90 degrees
/// (gimbal lock) roll and yaw aren't unique, and pitch is clamped there.
/// :returns: Roll, pitch, and yaw, in radians.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
routine Q256.to_euler(me: Me) -> (F64, F64, F64)
    block entry()
        wx    : F64 = me.w.mul_finite(me.x)
        yz    : F64 = me.y.mul_finite(me.z)
        ry    : F64 = F64.mul_finite(2.0, wx.add_finite(yz))
        xx    : F64 = me.x.mul_finite(me.x)
        yy    : F64 = me.y.mul_finite(me.y)
        rx2   : F64 = F64.mul_finite(2.0, xx.add_finite(yy))
        rx    : F64 = F64.sub_finite(1.0, rx2)
        roll  : F64 = ry.atan2(rx)
        wy    : F64 = me.w.mul_finite(me.y)
        zx    : F64 = me.z.mul_finite(me.x)
        sp    : F64 = F64.mul_finite(2.0, wy.sub_finite(zx))
        pitch : F64 = Me.clamp_unit(sp).asin()
        wz    : F64 = me.w.mul_finite(me.z)
        xy    : F64 = me.x.mul_finite(me.y)
        yy2   : F64 = F64.mul_finite(2.0, wz.add_finite(xy))
        y2    : F64 = me.y.mul_finite(me.y)
        z2    : F64 = me.z.mul_finite(me.z)
        yx2   : F64 = F64.mul_finite(2.0, y2.add_finite(z2))
        yx    : F64 = F64.sub_finite(1.0, yx2)
        yaw   : F64 = yy2.atan2(yx)
        return({ roll, pitch, yaw })

/// The four components in Words, w first.
/// :returns: The components w, x, y, and z in Words.
#inline
routine Q256.words(me: Me) -> Words
    block entry()
        return(Words.construct(me.w, me.x, me.y, me.z))

// The exports RazorForge's Q256 calls: each component of a quaternion is its own F64, and a Vector3D's or a
// Matrix4R4C's is its own F32.

/// The Hamilton product, for Q256.mul.
/// :param w: The first quaternion's w.
/// :param x: The first quaternion's x.
/// :param y: The first quaternion's y.
/// :param z: The first quaternion's z.
/// :param other_w: The second quaternion's w.
/// :param other_x: The second quaternion's x.
/// :param other_y: The second quaternion's y.
/// :param other_z: The second quaternion's z.
/// :returns: The product's components in Words, w first.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_mul"), inline]
routine q256_mul(w: F64, x: F64, y: F64, z: F64, other_w: F64, other_x: F64, other_y: F64,
    other_z: F64) -> Words
    block entry()
        a : Q256 = { w: w, x: x, y: y, z: z }
        b : Q256 = { w: other_w, x: other_x, y: other_y, z: other_z }
        return(a.mul(b).words())

/// The quotient, for Q256.truediv.
/// :param w: The first quaternion's w.
/// :param x: The first quaternion's x.
/// :param y: The first quaternion's y.
/// :param z: The first quaternion's z.
/// :param other_w: The second quaternion's w.
/// :param other_x: The second quaternion's x.
/// :param other_y: The second quaternion's y.
/// :param other_z: The second quaternion's z.
/// :returns: The quotient's components in Words, w first.
/// :throws: Crashes with `DivisionByZeroError` when the second quaternion is zero and the first is not,
///     `NumericDomainError` when both are zero (0 / 0, as with real division) or a step gives NaN, or
///     `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_div"), inline]
routine q256_div(w: F64, x: F64, y: F64, z: F64, other_w: F64, other_x: F64, other_y: F64,
    other_z: F64) -> Words
    block entry()
        a : Q256 = { w: w, x: x, y: y, z: z }
        b : Q256 = { w: other_w, x: other_x, y: other_y, z: other_z }
        return(a.div(b).words())

/// The dot product, for Q256.dot.
/// :param w: The first quaternion's w.
/// :param x: The first quaternion's x.
/// :param y: The first quaternion's y.
/// :param z: The first quaternion's z.
/// :param other_w: The second quaternion's w.
/// :param other_x: The second quaternion's x.
/// :param other_y: The second quaternion's y.
/// :param other_z: The second quaternion's z.
/// :returns: The dot product.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_dot"), inline]
routine q256_dot(w: F64, x: F64, y: F64, z: F64, other_w: F64, other_x: F64, other_y: F64,
    other_z: F64) -> F64
    block entry()
        a : Q256 = { w: w, x: x, y: y, z: z }
        b : Q256 = { w: other_w, x: other_x, y: other_y, z: other_z }
        return(a.dot(b))

/// The squared norm, for Q256.norm.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :returns: The squared norm.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_norm"), inline]
routine q256_norm(w: F64, x: F64, y: F64, z: F64) -> F64
    block entry()
        a : Q256 = { w: w, x: x, y: y, z: z }
        return(a.norm())

/// The norm, for Q256.abs.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :returns: The norm.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_abs"), inline]
routine q256_abs(w: F64, x: F64, y: F64, z: F64) -> F64
    block entry()
        a : Q256 = { w: w, x: x, y: y, z: z }
        return(a.abs())

/// The angle the unit quaternion turns by, for Q256.angle.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :returns: The angle in radians.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_angle"), inline]
routine q256_angle(w: F64, x: F64, y: F64, z: F64) -> F64
    block entry()
        a : Q256 = { w: w, x: x, y: y, z: z }
        return(a.angle())

/// The unit quaternion in the same direction, for Q256.normalize.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :returns: The unit quaternion's components in Words, w first.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_normalize"), inline]
routine q256_normalize(w: F64, x: F64, y: F64, z: F64) -> Words
    block entry()
        a : Q256 = { w: w, x: x, y: y, z: z }
        return(a.normalize().words())

/// The inverse, for Q256.reciprocal.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :returns: The inverse's components in Words, w first.
/// :throws: Crashes with `DivisionByZeroError` when the quaternion is zero, `NumericDomainError` when a step gives
///     NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_reciprocal"), inline]
routine q256_reciprocal(w: F64, x: F64, y: F64, z: F64) -> Words
    block entry()
        a : Q256 = { w: w, x: x, y: y, z: z }
        return(a.reciprocal().words())

/// Whether the norm is 1 within the tolerance, for Q256.is_unit.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :returns: True when the squared norm is within the tolerance of 1.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_is_unit"), inline]
routine q256_is_unit(w: F64, x: F64, y: F64, z: F64) -> Bool
    block entry()
        a : Q256 = { w: w, x: x, y: y, z: z }
        return(a.is_unit())

/// Q256.rotate: the turned vector's x, y, and z in w0, w1, and w2, as F32s.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :param vx: The vector's x.
/// :param vy: The vector's y.
/// :param vz: The vector's z.
/// :returns: The turned vector in Words.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_rotate"), inline]
routine q256_rotate(w: F64, x: F64, y: F64, z: F64, vx: F32, vy: F32, vz: F32) -> Words
    block entry()
        a : Q256 = { w: w, x: x, y: y, z: z }
        r : Q256 = a.rotate(vx.to<F64>(), vy.to<F64>(), vz.to<F64>())
        return(Words.construct(r.x.to<F32>(), r.y.to<F32>(), r.z.to<F32>(), F32.from_bits(0)))

/// The spherical interpolation, for Q256.slerp.
/// :param w: The first quaternion's w.
/// :param x: The first quaternion's x.
/// :param y: The first quaternion's y.
/// :param z: The first quaternion's z.
/// :param other_w: The second quaternion's w.
/// :param other_x: The second quaternion's x.
/// :param other_y: The second quaternion's y.
/// :param other_z: The second quaternion's z.
/// :param t: How far along, 0 at the first quaternion and 1 at the second.
/// :returns: The interpolated rotation's components in Words, w first.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_slerp"), inline]
routine q256_slerp(w: F64, x: F64, y: F64, z: F64, other_w: F64, other_x: F64, other_y: F64,
    other_z: F64, t: F64) -> Words
    block entry()
        a : Q256 = { w: w, x: x, y: y, z: z }
        b : Q256 = { w: other_w, x: other_x, y: other_y, z: other_z }
        return(a.slerp(b, t).words())

/// The normalized linear interpolation, for Q256.nlerp.
/// :param w: The first quaternion's w.
/// :param x: The first quaternion's x.
/// :param y: The first quaternion's y.
/// :param z: The first quaternion's z.
/// :param other_w: The second quaternion's w.
/// :param other_x: The second quaternion's x.
/// :param other_y: The second quaternion's y.
/// :param other_z: The second quaternion's z.
/// :param t: How far along, 0 at the first quaternion and 1 at the second.
/// :returns: The interpolation's components in Words, w first.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_nlerp"), inline]
routine q256_nlerp(w: F64, x: F64, y: F64, z: F64, other_w: F64, other_x: F64, other_y: F64,
    other_z: F64, t: F64) -> Words
    block entry()
        a : Q256 = { w: w, x: x, y: y, z: z }
        b : Q256 = { w: other_w, x: other_x, y: other_y, z: other_z }
        return(a.nlerp(b, t).words())

/// Q256.to_axis_angle: the axis's x, y, and z as F32s in w0, w1, and w2, the angle as F64 in w3.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :returns: The axis and the angle in Words.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_to_axis_angle"), inline]
routine q256_to_axis_angle(w: F64, x: F64, y: F64, z: F64) -> Words
    block entry()
        a : Q256 = { w: w, x: x, y: y, z: z }
        ax, ay, az, angle = a.to_axis_angle()
        w0 : U64 = ax.to<F32>().bits().to<U64>()
        w1 : U64 = ay.to<F32>().bits().to<U64>()
        w2 : U64 = az.to<F32>().bits().to<U64>()
        w3 : U64 = angle.bits()
        return({ w0: w0, w1: w1, w2: w2, w3: w3 })

/// Q256.to_euler: roll, pitch, and yaw in w0, w1, and w2.
/// :param w: The quaternion's w.
/// :param x: The quaternion's x.
/// :param y: The quaternion's y.
/// :param z: The quaternion's z.
/// :returns: The three angles in Words.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_to_euler"), inline]
routine q256_to_euler(w: F64, x: F64, y: F64, z: F64) -> Words
    block entry()
        a : Q256 = { w: w, x: x, y: y, z: z }
        roll, pitch, yaw = a.to_euler()
        return(Words.construct(roll, pitch, yaw, F64.from_bits(0)))

/// Q256.from_axis_angle, for an F32 axis.
/// :param ax: The axis's x.
/// :param ay: The axis's y.
/// :param az: The axis's z.
/// :param angle: The angle in radians.
/// :returns: The resulting quaternion's components in Words, w first.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_from_axis_angle"), inline]
routine q256_from_axis_angle(ax: F32, ay: F32, az: F32, angle: F64) -> Words
    block entry()
        return(Q256.from_axis_angle(ax.to<F64>(), ay.to<F64>(), az.to<F64>(), angle).words())

/// Q256.from_to, for F32 directions.
/// :param ux: The first direction's x.
/// :param uy: The first direction's y.
/// :param uz: The first direction's z.
/// :param vx: The second direction's x.
/// :param vy: The second direction's y.
/// :param vz: The second direction's z.
/// :returns: The resulting quaternion's components in Words, w first.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_from_to"), inline]
routine q256_from_to(ux: F32, uy: F32, uz: F32, vx: F32, vy: F32, vz: F32) -> Words
    block entry()
        source : Vector3D<F64> = { x: ux.to<F64>(), y: uy.to<F64>(), z: uz.to<F64>() }
        target : Vector3D<F64> = { x: vx.to<F64>(), y: vy.to<F64>(), z: vz.to<F64>() }
        q      : Q256          = Q256.from_to(source, target)
        return(q.words())

/// Q256.from_matrix, for the F32 elements m{row}{column} of the upper-left 3x3 part.
/// :param m00: The element in row 0, column 0.
/// :param m01: The element in row 0, column 1.
/// :param m02: The element in row 0, column 2.
/// :param m10: The element in row 1, column 0.
/// :param m11: The element in row 1, column 1.
/// :param m12: The element in row 1, column 2.
/// :param m20: The element in row 2, column 0.
/// :param m21: The element in row 2, column 1.
/// :param m22: The element in row 2, column 2.
/// :returns: The resulting quaternion's components in Words, w first.
/// :throws: Crashes with `DivisionByZeroError` when a step divides by zero, `NumericDomainError` when one gives NaN,
///     or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_from_matrix"), inline]
routine q256_from_matrix(m00: F32, m01: F32, m02: F32, m10: F32, m11: F32, m12: F32, m20: F32,
    m21: F32, m22: F32) -> Words
    block entry()
        m : Matrix3<F64> = { m00: m00.to<F64>(), m01: m01.to<F64>(), m02: m02.to<F64>(),
            m10: m10.to<F64>(), m11: m11.to<F64>(), m12: m12.to<F64>(), m20: m20.to<F64>(),
            m21: m21.to<F64>(), m22: m22.to<F64>() }
        q : Q256         = Q256.from_matrix(m)
        return(q.words())

/// The rotation by Euler angles, for Q256.from_euler.
/// :param roll: The turn about x, in radians.
/// :param pitch: The turn about y, in radians.
/// :param yaw: The turn about z, in radians.
/// :returns: The resulting quaternion's components in Words, w first.
/// :throws: Crashes with `NumericDomainError` when a step gives NaN, or `NumericOverflowError` when one is infinite.
#[export("ingrid_q256_from_euler"), inline]
routine q256_from_euler(roll: F64, pitch: F64, yaw: F64) -> Words
    block entry()
        return(Q256.from_euler(roll, pitch, yaw).words())
