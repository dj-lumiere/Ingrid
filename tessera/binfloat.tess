        return(f128_words(x.cbrt()))

/// The square root, for B128.sqrt_unchecked.
/// :param low: The low 64 bits of x.
/// :param high: The high 64 bits of x.
/// :returns: The square root of x, its low 64 bits in w0 and its high 64 bits in w1.
#[export("ingrid_b128_sqrt"), inline]
routine b128_sqrt(low: U64, high: U64) -> Words
    block entry()
        x : F128 = f128_from_halves(low, high)
        return(f128_words(x.sqrt()))

/// x^y, for B128.pow_unchecked.
/// :param low: The low 64 bits of the base x.
/// :param high: The high 64 bits of the base x.
/// :param y_low: The low 64 bits of the exponent y.
/// :param y_high: The high 64 bits of the exponent y.
/// :returns: x^y, its low 64 bits in w0 and its high 64 bits in w1.
#[export("ingrid_b128_pow"), inline]
routine b128_pow(low: U64, high: U64, y_low: U64, y_high: U64) -> Words
    block entry()
        x : F128 = f128_from_halves(low, high)
        y : F128 = f128_from_halves(y_low, y_high)
        return(f128_words(x.powf(y)))

/// x^n for an integer n, for B128.powi.
/// :param low: The low 64 bits of the base x.
/// :param high: The high 64 bits of the base x.
/// :param n: The integer exponent.
/// :returns: x^n, its low 64 bits in w0 and its high 64 bits in w1.
#[export("ingrid_b128_powi"), inline]
routine b128_powi(low: U64, high: U64, n: S32) -> Words
    block entry()
        x : F128 = f128_from_halves(low, high)
        return(f128_words(x.powi(n)))

/// The angle of the point (x, y), for `atan2(...)` over B128.
/// :param y_low: The low 64 bits of the y coordinate.
/// :param y_high: The high 64 bits of the y coordinate.
/// :param x_low: The low 64 bits of the x coordinate.
/// :param x_high: The high 64 bits of the x coordinate.
/// :returns: The angle of the point (x, y), its low 64 bits in w0 and its high 64 bits in w1.
#[export("ingrid_b128_atan2"), inline]
routine b128_atan2(y_low: U64, y_high: U64, x_low: U64, x_high: U64) -> Words
    block entry()
        y : F128 = f128_from_halves(y_low, y_high)
        x : F128 = f128_from_halves(x_low, x_high)
        return(f128_words(y.atan2(x)))

/// sqrt(x^2 + y^2) without overflow on the way, for `hypot_unchecked(...)` over B128.
/// :param low: The low 64 bits of x.
/// :param high: The high 64 bits of x.
/// :param y_low: The low 64 bits of y.
/// :param y_high: The high 64 bits of y.
/// :returns: sqrt(x^2 + y^2), its low 64 bits in w0 and its high 64 bits in w1.
#[export("ingrid_b128_hypot"), inline]
routine b128_hypot(low: U64, high: U64, y_low: U64, y_high: U64) -> Words
    block entry()
        x : F128 = f128_from_halves(low, high)
        y : F128 = f128_from_halves(y_low, y_high)
        return(f128_words(x.hypot(y)))

/// x × y + z with one rounding, for B128.fma_unchecked.
/// :param low: The low 64 bits of x.
/// :param high: The high 64 bits of x.
/// :param y_low: The low 64 bits of y.
/// :param y_high: The high 64 bits of y.
/// :param z_low: The low 64 bits of z.
/// :param z_high: The high 64 bits of z.
/// :returns: x × y + z, rounded once, its low 64 bits in w0 and its high 64 bits in w1.
#[export("ingrid_b128_fma"), inline]
routine b128_fma(low: U64, high: U64, y_low: U64, y_high: U64, z_low: U64, z_high: U64) -> Words
    block entry()
        x : F128 = f128_from_halves(low, high)
        y : F128 = f128_from_halves(y_low, y_high)
        z : F128 = f128_from_halves(z_low, z_high)
        return(f128_words(x.mul_add(y, z)))

/// The sine and the cosine with one argument reduction, for B128.sincos: the sine in w0 and w1, the cosine in w2
/// and w3.
/// :param low: The low 64 bits of x.
/// :param high: The high 64 bits of x.
/// :returns: The sine in w0 and w1 and the cosine in w2 and w3, each as its low and then its high 64 bits.
#[export("ingrid_b128_sincos"), inline]
routine b128_sincos(low: U64, high: U64) -> Words
    block entry()
        x  : F128       = f128_from_halves(low, high)
        sc : F128SinCos = x.sin_cos()
        return(Words.construct(sc.sin, sc.cos))
