/// Sin(pi x), for B16.sinpi.
/// :param x: The argument.
/// :returns: Sin(pi x).
#[export("ingrid_b16_sinpi"), inline]
routine b16_sinpi(x: F16) -> F16
    block entry()
        return(x.sin_pi())

/// Cos(pi x), for B16.cospi.
