// RazorForge's binary floats B16, B32, B64, and B128 (Tessera's F16, F32, F64, and F128): the library functions
// their RazorForge routines call. Each export is one call to the standard library's correctly rounded routine (the
// CORE-MATH ports, and for F128 what CORE-MATH has no binary128 version of), so both languages share one
// implementation. The operations the builder knows (`+ - * /`, comparisons, conversions, sqrt, fma, and rounding
// to an integer of B16, B32, and B64) stay builder operations in RazorForge and are not here.
//
// Every routine is the raw IEEE function: a NaN, an infinity, or a pole passes through, so RazorForge's checked
// routines keep their crash in RazorForge. A B16, B32, or B64 crosses the C ABI as itself. An F128 is a 128-bit
// integer to the C ABI, which Win64 passes by pointer from Tessera and by value from RazorForge, so each F128
// argument goes in as its low and high 64 bits, and an F128 result comes back in Words (words.tess).

// ── B16 ──────────────────────────────────────────────────────────────────────────

/// E^x, for B16.exp_unchecked.
/// :param x: The argument.
/// :returns: E^x.
#[export("ingrid_b16_exp"), inline]
routine b16_exp(x: F16) -> F16
    block entry()
        return(x.exp())

/// 2^x, for B16.exp2_unchecked.
/// :param x: The argument.
/// :returns: 2^x.
#[export("ingrid_b16_exp2"), inline]
routine b16_exp2(x: F16) -> F16
    block entry()
        return(x.exp2())

/// 10^x, for B16.exp10_unchecked.
/// :param x: The argument.
/// :returns: 10^x.
#[export("ingrid_b16_exp10"), inline]
routine b16_exp10(x: F16) -> F16
    block entry()
        return(x.exp10())

/// E^x - 1, for B16.expm1_unchecked.
/// :param x: The argument.
/// :returns: E^x - 1.
#[export("ingrid_b16_expm1"), inline]
routine b16_expm1(x: F16) -> F16
    block entry()
        return(x.exp_m1())

/// The natural logarithm, for B16.log_unchecked.
/// :param x: The argument.
/// :returns: The natural logarithm of x.
#[export("ingrid_b16_log"), inline]
routine b16_log(x: F16) -> F16
    block entry()
        return(x.ln())

/// The base-2 logarithm, for B16.log2_unchecked.
/// :param x: The argument.
/// :returns: The base-2 logarithm of x.
#[export("ingrid_b16_log2"), inline]
routine b16_log2(x: F16) -> F16
    block entry()
        return(x.log2())

/// The base-10 logarithm, for B16.log10_unchecked.
/// :param x: The argument.
/// :returns: The base-10 logarithm of x.
#[export("ingrid_b16_log10"), inline]
routine b16_log10(x: F16) -> F16
    block entry()
        return(x.log10())

/// Ln(1 + x), for B16.log1p_unchecked.
/// :param x: The argument.
/// :returns: Ln(1 + x).
#[export("ingrid_b16_log1p"), inline]
routine b16_log1p(x: F16) -> F16
    block entry()
        return(x.ln_1p())

/// The sine, for B16.sin.
/// :param x: The argument.
/// :returns: The sine of x.
#[export("ingrid_b16_sin"), inline]
routine b16_sin(x: F16) -> F16
    block entry()
        return(x.sin())

