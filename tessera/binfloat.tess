#[export("ingrid_b16_pow"), inline]
routine b16_pow(x: F16, y: F16) -> F16
    block entry()
        return(x.powf(y))

/// x^n for an integer n, for B16.powi.
/// :param x: The base.
/// :param n: The integer exponent.
/// :returns: x^n.
#[export("ingrid_b16_powi"), inline]
routine b16_powi(x: F16, n: S32) -> F16
    block entry()
        return(x.powi(n))

/// The angle of the point (x, y), for `atan2(...)` over B16.
/// :param y: The point's y coordinate.
/// :param x: The point's x coordinate.
/// :returns: The angle of the point (x, y).
#[export("ingrid_b16_atan2"), inline]
routine b16_atan2(y: F16, x: F16) -> F16
    block entry()
        return(y.atan2(x))

/// sqrt(x^2 + y^2) without overflow on the way, for `hypot_unchecked(...)` over B16.
/// :param x: The first side.
/// :param y: The second side.
/// :returns: sqrt(x^2 + y^2).
#[export("ingrid_b16_hypot"), inline]
routine b16_hypot(x: F16, y: F16) -> F16
    block entry()
        return(x.hypot(y))

