// RazorForge's checked float arithmetic, for the Ingrid routines that compute RazorForge's complex numbers,
// quaternions, and matrices. RazorForge's `+ - * /` on B32, B64, and B128 crash when the IEEE result is not finite:
// NaN is a NumericDomainError, an infinity a NumericOverflowError, and a nonzero value over zero a
// DivisionByZeroError. These routines do the same with the same names and messages, so a body moved here crashes
// at the same operation, and the same way, as it did in RazorForge. Each passes its caller's place on, so the report
// names the line of the formula.

/// Crashes for an arithmetic result that is not finite: NaN has no real result, an infinity is out of range.
/// :param nan: True when the result is NaN, false when it is an infinity.
/// :throws: Crashes with `NumericDomainError` when `nan` is true, else with `NumericOverflowError`.
#[noreturn, track_caller]
routine crash_not_finite(nan: Bool) -> Void
    block entry()
        branch nan
            ? crash("NumericDomainError", "domain error: no real result")
            : crash("NumericOverflowError", "overflow: out of range")

/// Crashes for a quotient that is not finite: a nonzero value over zero divides by zero, otherwise like any result.
/// :param by_zero: True when a nonzero value was divided by zero.
/// :param nan: True when the quotient is NaN, false when it is an infinity.
/// :throws: Crashes with `DivisionByZeroError` when `by_zero` is true, else with `NumericDomainError` when `nan` is
///     true, else with `NumericOverflowError`.
#[noreturn, track_caller]
routine crash_quotient_not_finite(by_zero: Bool, nan: Bool) -> Void
    block entry()
        branch by_zero
            ? crash_division_by_zero()
            : crash_not_finite(nan)

/// Crashes for a division by a zero divisor (0 + 0i, the zero quaternion) the way real division does: 0 / 0 has no
/// result, and a nonzero value over zero divides by zero.
/// :param zero_dividend: True when the dividend is zero too.
/// :throws: Crashes with `NumericDomainError` when `zero_dividend` is true, else with `DivisionByZeroError`.
#[noreturn, track_caller]
routine crash_zero_divisor(zero_dividend: Bool) -> Void
    block entry()
        branch zero_dividend
            ? crash_not_finite(true)
            : crash_division_by_zero()

/// `self + other`, crashing unless the sum is finite.
/// :param other: The value to add.
/// :returns: The sum.
/// :throws: Crashes with `NumericDomainError` when the sum is NaN, or `NumericOverflowError` when it is
///     infinite.
#[inline, track_caller]
routine F32.add_finite(self: Self, other: Self) -> Self
    shared r : Self = self.add(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self - other`, crashing unless the difference is finite.
/// :param other: The value to subtract.
/// :returns: The difference.
/// :throws: Crashes with `NumericDomainError` when the difference is NaN, or `NumericOverflowError` when it is
///     infinite.
#[inline, track_caller]
routine F32.sub_finite(self: Self, other: Self) -> Self
    shared r : Self = self.sub(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self * other`, crashing unless the product is finite.
/// :param other: The value to multiply by.
/// :returns: The product.
/// :throws: Crashes with `NumericDomainError` when the product is NaN, or `NumericOverflowError` when it is
///     infinite.
#[inline, track_caller]
routine F32.mul_finite(self: Self, other: Self) -> Self
    shared r : Self = self.mul(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self / other`, crashing unless the quotient is finite.
/// :param other: The value to divide by.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `other` is zero and `self` is not, else with
///     `NumericDomainError` when the quotient is NaN, or `NumericOverflowError` when it is infinite.
#[inline, track_caller]
routine F32.div_finite(self: Self, other: Self) -> Self
    shared r : Self = self.div(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : failed()

    block failed()
        by_zero : Bool = other.eq(0.0).bitand(self.eq(0.0).bitnot())
        crash_quotient_not_finite(by_zero, r.is_nan())

/// `self + other`, crashing unless the sum is finite.
/// :param other: The value to add.
/// :returns: The sum.
/// :throws: Crashes with `NumericDomainError` when the sum is NaN, or `NumericOverflowError` when it is
///     infinite.
#[inline, track_caller]
routine F64.add_finite(self: Self, other: Self) -> Self
    shared r : Self = self.add(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self - other`, crashing unless the difference is finite.
/// :param other: The value to subtract.
/// :returns: The difference.
/// :throws: Crashes with `NumericDomainError` when the difference is NaN, or `NumericOverflowError` when it is
///     infinite.
#[inline, track_caller]
routine F64.sub_finite(self: Self, other: Self) -> Self
    shared r : Self = self.sub(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self * other`, crashing unless the product is finite.
/// :param other: The value to multiply by.
/// :returns: The product.
/// :throws: Crashes with `NumericDomainError` when the product is NaN, or `NumericOverflowError` when it is
///     infinite.
#[inline, track_caller]
routine F64.mul_finite(self: Self, other: Self) -> Self
    shared r : Self = self.mul(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self / other`, crashing unless the quotient is finite.
/// :param other: The value to divide by.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `other` is zero and `self` is not, else with
///     `NumericDomainError` when the quotient is NaN, or `NumericOverflowError` when it is infinite.
#[inline, track_caller]
routine F64.div_finite(self: Self, other: Self) -> Self
    shared r : Self = self.div(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : failed()

    block failed()
        by_zero : Bool = other.eq(0.0).bitand(self.eq(0.0).bitnot())
        crash_quotient_not_finite(by_zero, r.is_nan())

/// `self + other`, crashing unless the sum is finite.
/// :param other: The value to add.
/// :returns: The sum.
/// :throws: Crashes with `NumericDomainError` when the sum is NaN, or `NumericOverflowError` when it is
///     infinite.
#[inline, track_caller]
routine F128.add_finite(self: Self, other: Self) -> Self
    shared r : Self = self.add(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self - other`, crashing unless the difference is finite.
/// :param other: The value to subtract.
/// :returns: The difference.
/// :throws: Crashes with `NumericDomainError` when the difference is NaN, or `NumericOverflowError` when it is
///     infinite.
#[inline, track_caller]
routine F128.sub_finite(self: Self, other: Self) -> Self
    shared r : Self = self.sub(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self * other`, crashing unless the product is finite.
/// :param other: The value to multiply by.
/// :returns: The product.
/// :throws: Crashes with `NumericDomainError` when the product is NaN, or `NumericOverflowError` when it is
///     infinite.
#[inline, track_caller]
routine F128.mul_finite(self: Self, other: Self) -> Self
    shared r : Self = self.mul(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self / other`, crashing unless the quotient is finite.
/// :param other: The value to divide by.
/// :returns: The quotient.
/// :throws: Crashes with `DivisionByZeroError` when `other` is zero and `self` is not, else with
///     `NumericDomainError` when the quotient is NaN, or `NumericOverflowError` when it is infinite.
#[inline, track_caller]
routine F128.div_finite(self: Self, other: Self) -> Self
    shared r : Self = self.div(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : failed()

    block failed()
        by_zero : Bool = other.is_zero().bitand(self.is_zero().bitnot())
        crash_quotient_not_finite(by_zero, r.is_nan())

/// Whether this is +0 or -0.
/// :returns: True when `self` is +0 or -0.
#inline
routine F128.is_zero(self: Self) -> Bool
    block entry()
        magnitude : U128 = self.abs().bits()
        return(magnitude.eq(0))
