// RazorForge's checked float arithmetic, for the Ingrid routines that compute RazorForge's complex numbers,
// quaternions, and matrices. RazorForge's `+ - * /` on B32, B64, and B128 crash when the IEEE result is not finite:
// NaN is a NumericDomainError, an infinity a NumericOverflowError, and a nonzero value over zero a
// DivisionByZeroError. These routines do the same with the same names and messages, so a body moved here crashes
// at the same operation, and the same way, as it did in RazorForge. Each passes its caller's place on, so the report
// names the line of the formula.

/// Crashes for an arithmetic result that is not finite: NaN has no real result, an infinity is out of range.
#[noreturn, track_caller]
routine crash_not_finite(nan: Bool) -> Void
    block entry()
        branch nan
            ? crash("NumericDomainError", "domain error: no real result")
            : crash("NumericOverflowError", "overflow: out of range")

/// Crashes for a quotient that is not finite: a nonzero value over zero divides by zero, otherwise like any result.
#[noreturn, track_caller]
routine crash_quotient_not_finite(by_zero: Bool, nan: Bool) -> Void
    block entry()
        branch by_zero
            ? crash_division_by_zero()
            : crash_not_finite(nan)

/// `self + other`, crashing unless the sum is finite.
#[inline, track_caller]
routine F32.add_finite(self: Self, other: Self) -> Self
    shared r : Self = self.add(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self - other`, crashing unless the difference is finite.
#[inline, track_caller]
routine F32.sub_finite(self: Self, other: Self) -> Self
    shared r : Self = self.sub(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self * other`, crashing unless the product is finite.
#[inline, track_caller]
routine F32.mul_finite(self: Self, other: Self) -> Self
    shared r : Self = self.mul(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self / other`, crashing unless the quotient is finite.
#[inline, track_caller]
routine F32.div_finite(self: Self, other: Self) -> Self
    shared r : Self = self.div(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : failed()

    block failed()
        by_zero : Bool = other.eq(0.0).bitand(self.eq(0.0).bitnot())
        crash_quotient_not_finite(by_zero, r.is_nan())

/// `self + other`, crashing unless the sum is finite.
#[inline, track_caller]
routine F64.add_finite(self: Self, other: Self) -> Self
    shared r : Self = self.add(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self - other`, crashing unless the difference is finite.
#[inline, track_caller]
routine F64.sub_finite(self: Self, other: Self) -> Self
    shared r : Self = self.sub(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self * other`, crashing unless the product is finite.
#[inline, track_caller]
routine F64.mul_finite(self: Self, other: Self) -> Self
    shared r : Self = self.mul(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self / other`, crashing unless the quotient is finite.
#[inline, track_caller]
routine F64.div_finite(self: Self, other: Self) -> Self
    shared r : Self = self.div(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : failed()

    block failed()
        by_zero : Bool = other.eq(0.0).bitand(self.eq(0.0).bitnot())
        crash_quotient_not_finite(by_zero, r.is_nan())

/// `self + other`, crashing unless the sum is finite.
#[inline, track_caller]
routine F128.add_finite(self: Self, other: Self) -> Self
    shared r : Self = self.add(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self - other`, crashing unless the difference is finite.
#[inline, track_caller]
routine F128.sub_finite(self: Self, other: Self) -> Self
    shared r : Self = self.sub(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self * other`, crashing unless the product is finite.
#[inline, track_caller]
routine F128.mul_finite(self: Self, other: Self) -> Self
    shared r : Self = self.mul(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : crash_not_finite(r.is_nan())

/// `self / other`, crashing unless the quotient is finite.
#[inline, track_caller]
routine F128.div_finite(self: Self, other: Self) -> Self
    shared r : Self = self.div(other)

    block entry()
        branch r.is_finite()
            ? return(r)
            : failed()

    block failed()
        by_zero : Bool = other.is_zero().bitand(self.is_zero().bitnot())
        crash_quotient_not_finite(by_zero, r.is_nan())

/// Whether this is +0 or -0.
#inline
routine F128.is_zero(self: Self) -> Bool
    block entry()
        magnitude : U128 = self.abs().bits()
        return(magnitude.eq(0))
