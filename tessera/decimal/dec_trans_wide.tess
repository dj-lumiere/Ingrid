// The decimal transcendentals evaluated once at 192 bits on the W engine (dec_wide.tess): dec_trans.tess's
// evaluations at three limbs, the same algorithms and the same error bounds, on values of five words instead of
// Mp's twenty limbs. dec_ziv tries this before the multiprecision loop, which then starts above 192 bits.

/// Two values.
record WePair
    a : We
    b : We

/// An argument reduced modulo pi/2: x = r + k pi/2, k taken mod 4.
record WReduced
    k : U64
    r : We

/// A signed fixed-point number: (-1)^neg × mag.
record XS
    neg : Bool
    mag : X

/// fn(x, y) correctly rounded to f from one evaluation at 192 bits, or not ok when the band of that evaluation
/// reaches a rounding midpoint.
/// :param fn: Which function (a DEC_ code).
/// :param x: The operand.
/// :param y: The second argument (pow and atan2), else ignored.
/// :param f: The format the result rounds to.
/// :returns: The result, or not ok.
routine dec_wide(fn: U32, x: Dec, y: Dec, f: DecFormat) -> DecTry
    block entry()
        bits : S64 = f.digits.mul(4).add(40)
        v    : We  = wide_eval(fn, x, y, bits)
        return(wide_round(v, f))

/// e^x for |x| < 2^40: x = k ln 2 + r with |r| < 1/2 (its bound from the subtraction), then r = j1/32 + j2/2048 + s
/// exactly in fixed point (|s| <= 2^-12), e^s by its Taylor series to s^13 in fixed point, and e^x = 2^k e^(j1/32)
/// e^(j2/2048) e^s with the two powers from tables.
///
/// The bound: |r| 2^190 truncated to an integer R is off by 2^-190, r itself by r.err 2^-192 |r|, and e^r follows its
/// argument's absolute error, so those give 4 + r.err 2^e_r units. Horner's scheme on acc = 1/k! + s acc cuts each
/// product at 2^-190 and starts from coefficients cut there too, so the sum is off by at most 2 × 2^-190 ×
/// (1 + |s| + |s|^2 + ...) < 2.01 × 2^-190, and the terms left out are below |s|^14 / 14! < 2^-204: 12.1 units of a
/// sum above 0.9997. The tables add 2 units each and the two products 2 each.
/// :param x: The operand.
/// :returns: e^x.
routine we_exp(x: We) -> We
    shared kf   : F64  = x.v.to_f64().mul(1.4426950408889634)
    shared k    : S64  = kf.round().to_clamp<S64>()
    shared ln2k : We   = we_mul_u64(we_const(DEC_LN2), k.abs_diff(0)).with_sign(k.lt(0))
    shared r    : We   = we_sub(x, ln2k)
    shared neg  : Bool = r.v.neg
    shared big  : X    = x_of_w(r.v, 190)

    block entry()
        wild : Bool = r.v.exp.gt(-1).bitand(r.v.is_zero().bitnot())
        branch wild
            ? return({ v: r.v, err: F64.from_bits(0x7FF0000000000000) })
            : high()

    // j1 = round(|r| 32) from R's bits above 2^185 (bit 57 of its top limb), and s1 = |r| - j1/32 with its sign
    block high()
        j1    : U64  = big.h.add(U64.shl(1, 56)).shr(57)
        hj    : X    = { h: j1.shl(57), m: 0, l: 0 }
        above : Bool = big.h.ge(hj.h)
        s1    : X    = above
            ? x_sub(big, hj)
            : x_sub(hj, big)
        jump low(j1, s1, neg.bitxor(above.bitnot()))

    // j2 = round(|s1| 2048) from the bits above 2^179 (bit 51), and s = |s1| - j2/2048
    block low(j1: U64, s1: X, s1_neg: Bool)
        j2    : U64  = s1.h.add(U64.shl(1, 50)).shr(51)
        hj    : X    = { h: j2.shl(51), m: 0, l: 0 }
        above : Bool = s1.h.ge(hj.h)
        s     : X    = above
            ? x_sub(s1, hj)
            : x_sub(hj, s1)
        i1 : S64 = neg
            ? U64.to<S64>(11).sub(j1.to<S64>())
            : U64.to<S64>(11).add(j1.to<S64>())
        i2 : S64 = s1_neg
            ? U64.to<S64>(32).sub(j2.to<S64>())
            : U64.to<S64>(32).add(j2.to<S64>())
        jump series(i1, i2, x_shl(s, 12), s1_neg.bitxor(above.bitnot()), 12,
            x_entry(WIDE_INV_FACT.to<@U64>(), 13))

    // acc = 1/n! + s acc from n = 12 down to the constant term, s scaled by 2^202 and acc by 2^190
    block series(i1: S64, i2: S64, s: X, s_neg: Bool, n: S64, acc: X)
        c    : X = x_entry(WIDE_INV_FACT.to<@U64>(), n.to<USize>())
        p    : X = x_mul_shift(acc, s, 202)
        next : X = s_neg
            ? x_sub(c, p)
            : x_add(c, p)
        done : Bool = n.eq(0)
        branch done
            ? combine(i1, i2, next)
            : series(i1, i2, s, s_neg, n.sub(1), next)

    block combine(i1: S64, i2: S64, sum: X)
        units : F64 = r.err.mul(f64_pow2(r.v.exp)).add(16.2).mul(MP_UP)
        es    : We  = { v: w_of_x(sum, 190, false), err: units }
        t1    : We  = we_entry(WIDE_EXP_HIGH.to<@U64>(), i1.to<USize>())
        t2    : We  = we_entry(WIDE_EXP_LOW.to<@U64>(), i2.to<USize>())
        e     : We  = we_mul(we_mul(t1, t2), es)
        return(e.ldexp(k))

/// e^x - 1: below 2^-24 its own series x + x^2/2 + ..., else e^x - 1 (the cancellation costs at most 24 bits).
/// :param x: The operand.
/// :returns: e^x - 1.
routine we_expm1(x: We) -> We
    block entry()
        small : Bool = x.v.exp.le(-24)
        branch small
            ? series(x, x, 2)
            : return(we_sub(we_exp(x), we_int(1)))

    block series(term: We, sum: We, i: U64)
        next : We   = we_div_u64(we_mul(term, x), i)
        done : Bool = we_is_negligible(next, sum)
        branch done
            ? return(we_plus_abs(sum, next.v.exp.add(1)))
            : series(next, we_add(sum, next), i.add(1))

/// ln(1 + t) for |t| < 1/32 by its series t - t^2/2 + t^3/3 ..., the rest after the last term below twice the next.
/// :param t: The argument, below 1/32 in magnitude.
/// :returns: ln(1 + t) for |t| < 1/32 by its series t - t^2/2 + t^3/3 ..., the rest after the last term below twice the next.
routine we_ln1p_series(t: We) -> We
    block entry()
        jump series(t, t, 2)

    // power = t^(i - 1)
    block series(power: We, sum: We, i: U64)
        next_power : We   = we_mul(power, t)
        term       : We   = we_div_u64(next_power, i)
        odd        : Bool = i.bitand(1).eq(1)
        signed     : We   = odd
            ? term
            : term.negate()
        done : Bool = we_is_negligible(term, sum)
        branch done
            ? return(we_plus_abs(sum, term.v.exp.add(1)))
            : series(next_power, we_add(sum, signed), i.add(1))

/// ln x for x > 0: x = m 2^E with m in [0.75, 1.5), ln x = E ln 2 + ln m (we_ln_reduced).
/// :param x: The operand.
/// :returns: ln x for x > 0.
routine we_ln(x: We) -> We
    shared top : F64  = x.v.magnitude().top_f64()
    shared low : Bool = top.lt(0.75)
    shared e   : S64  = x.v.exp.sub(low.to<S64>())

    block entry()
        lnm  : We = we_ln_reduced(x.ldexp(e.neg()))
        part : We = we_mul_u64(we_const(DEC_LN2), e.abs_diff(0)).with_sign(e.lt(0))
        branch e.eq(0)
            ? return(lnm)
            : return(we_add(part, lnm))

/// a + b for signed fixed-point numbers (no carry out of 192 bits).
/// :param a: The first term.
/// :param b: The second term.
/// :returns: The sum.
routine xs_add(a: XS, b: XS) -> XS
    block entry()
        branch a.neg.eq(b.neg)
            ? return({ neg: a.neg, mag: x_add(a.mag, b.mag) })
            : differ()

    block differ()
        a_big : Bool = x_compare(a.mag, b.mag).ge(0)
        branch a_big
            ? return({ neg: a.neg, mag: x_sub(a.mag, b.mag) })
            : return({ neg: b.neg, mag: x_sub(b.mag, a.mag) })

/// x × k for k < 2^64 as five limbs, exactly.
/// :param x: The number.
/// :param k: The multiplier.
/// :returns: The limbs.
#inline
routine x_mul_u64(x: X, k: U64) -> WLimbs
    block entry()
        x0 : U128 = x.l.mul_wide(k)
        x1 : U128 = w_fma(x.m, k, x0.shr(64).to_wrap<U64>(), 0)
        x2 : U128 = w_fma(x.h, k, x1.shr(64).to_wrap<U64>(), 0)
        return({ l4: 0, l3: x2.shr(64).to_wrap<U64>(), l2: x2.to_wrap<U64>(), l1: x1.to_wrap<U64>(),
            l0: x0.to_wrap<U64>() })

/// The bits at .. at + 191 of five limbs as a fixed-point number.
/// :param r: The limbs.
/// :param at: The lowest bit kept.
/// :returns: The bits.
#inline
routine x_of_limbs(r: WLimbs, at: S64) -> X
    block entry()
        return({ h: r.bits(at.add(128)), m: r.bits(at.add(64)), l: r.bits(at) })

/// ln m for m in [0.75, 1.5), in fixed point. With M = m 2^191 (its last bit cut), i = round(128 m) and r1 =
/// round(2^17 / i) / 2^10, t1 = m r1 - 1 is below 2^-7.39 and comes exactly from M r1; with j = round(2^14 t1) and r2 =
/// 1 - j 2^-14 + j^2 2^-28, t2 = (1 + t1) r2 - 1 = t1 + (r2 - 1) + t1 (r2 - 1) is below 2^-14.9 (each cut at
/// 2^-199). Then ln m = -ln r1 - ln r2 + ln(1 + t2), the logarithms of r1 and r2 from tables (2 units each) and
/// ln(1 + t2) = t2 P(t2) with P = Σ (-t2)^k / (k + 1) to k = 14 (the rest below 2^-208 relative) by Horner's scheme:
/// 8.3 units, its product 2.
///
/// The absolute error: M's cut moves m by 2^-191 (ln m by under 2^-190.6), the cuts of t1 and t2 by 2^-197, and m's
/// own bound (relative) moves ln m by m.err 2^-192: 3 + m.err units of 2^-192, added at the end.
/// :param m: The operand, in [0.75, 1.5).
/// :returns: ln m.
routine we_ln_reduced(m: We) -> We
    shared big : X   = x_of_w(m.v, 191)
    shared i   : U64 = big.h.add(U64.shl(1, 55)).shr(56)
    shared r1  : U64 = U64.add(131072, i.shr(1)).div(i)

    // t1 2^201 = M r1 - 2^201, kept at 2^199
    block entry()
        p     : WLimbs = x_mul_u64(big, r1)
        above : Bool   = p.l3.ge(U64.shl(1, 9))
        jump t1_from(p, above)

    block t1_from(p: WLimbs, above: Bool)
        two : WLimbs = { l4: 0, l3: U64.shl(1, 9), l2: 0, l1: 0, l0: 0 }
        d   : WLimbs = above
            ? w_limbs_sub(p, two)
            : w_limbs_sub(two, p)
        t1 : XS = { neg: above.bitnot(), mag: x_of_limbs(d, 2) }
        jump second(t1)

    // a = (r2 - 1) 2^28 = -j 2^14 + j^2, |a| < 2^21
    block second(t1: XS)
        jm : U64 = t1.mag.h.add(U64.shl(1, 56)).shr(57)
        js : S64 = t1.neg
            ? jm.to<S64>().neg()
            : jm.to<S64>()
        a    : S64 = js.mul(js).sub(js.mul(16384))
        am   : U64 = a.abs_diff(0)
        term : XS  = { neg: a.lt(0), mag: { h: am.shl(43), m: 0, l: 0 } }
        prod : XS  = { neg: t1.neg.bitxor(a.lt(0)), mag: x_of_limbs(x_mul_u64(t1.mag, am), 28) }
        t2   : XS  = xs_add(xs_add(t1, term), prod)
        jump series(js, t2)

    block series(js: S64, t2: XS)
        u   : X  = x_shl(t2.mag, 5)
        p   : X  = we_poly_signed(WIDE_INV_INT.to<@U64>(), u, 14, t2.neg)
        t2w : W  = w_of_x(t2.mag, 199, t2.neg)
        lt  : We = we_mul(we_exact(t2w), { v: w_of_x(p, 190, false), err: 8.3 })
        l1  : We = we_entry(WIDE_LN_R1.to<@U64>(), i.sub(96).to<USize>()).with_sign(r1.gt(1024))
        l2  : We = we_entry(WIDE_LN_R2.to<@U64>(), js.add(100).to<USize>()).with_sign(js.lt(0))
        sum : We = we_add(we_add(l1, l2), lt)
        jump finish(sum)

    block finish(sum: We)
        delta : F64 = m.err.add(3.0)
        return(we_widen_abs(sum, delta))

/// a - b for five-limb numbers, a >= b.
/// :param a: The minuend.
/// :param b: The subtrahend.
/// :returns: The difference.
routine w_limbs_sub(a: WLimbs, b: WLimbs) -> WLimbs
    block entry()
        d0 : U64 = a.l0.sub_wrap(b.l0)
        c0 : U64 = a.l0.lt(b.l0).to<U64>()
        d1 : U64 = a.l1.sub_wrap(b.l1).sub_wrap(c0)
        c1 : U64 = w_borrow(a.l1, b.l1, c0)
        d2 : U64 = a.l2.sub_wrap(b.l2).sub_wrap(c1)
        c2 : U64 = w_borrow(a.l2, b.l2, c1)
        d3 : U64 = a.l3.sub_wrap(b.l3).sub_wrap(c2)
        c3 : U64 = w_borrow(a.l3, b.l3, c2)
        d4 : U64 = a.l4.sub_wrap(b.l4).sub_wrap(c3)
        return({ l4: d4, l3: d3, l2: d2, l1: d1, l0: d0 })

/// Σ (-t)^k c_k for k = 0 .. top (or Σ |t|^k c_k when t is negative) by Horner's scheme in fixed point, u = |t|
/// scaled by 2^204, the coefficients and the sum by 2^190.
/// :param table: The coefficients c_0 .. c_top as fixed-point numbers of 2^-190.
/// :param u: |t|, scaled by 2^204.
/// :param top: The last index.
/// :param negative: Whether t is negative (all terms add).
/// :returns: The sum, scaled by 2^190.
routine we_poly_signed(table: @U64, u: X, top: USize, negative: Bool) -> X
    block entry()
        jump step(top, x_entry(table, top))

    block step(k: USize, acc: X)
        done : Bool = k.eq(0)
        branch done
            ? return(acc)
            : next(k.sub(1), acc)

    block next(k: USize, acc: X)
        c : X = x_entry(table, k)
        p : X = x_mul_shift(acc, u, 204)
        branch negative
            ? step(k, x_add(c, p))
            : step(k, x_sub(c, p))

/// ln(1 + t): its series below 2^-24, else ln of the sum (the cancellation costs at most 24 bits).
/// :param t: The argument.
/// :returns: ln(1 + t).
routine we_ln1p(t: We) -> We
    block entry()
        small : Bool = t.v.exp.le(-24)
        branch small
            ? return(we_ln1p_series(t))
            : return(we_ln(we_add(we_int(1), t)))

/// sin r and cos r for |r| below 1 by their Taylor series (alternating with shrinking terms, so the rest is below
/// the first term left out).
/// :param r: The argument.
/// :returns: sin r and cos r for |r| below 1 by their Taylor series (alternating with shrinking terms, so the rest is below the first term left out).
routine we_sincos_series(r: We) -> WePair
    shared r2  : We = we_mul(r, r)
    shared one : We = we_int(1)

    block entry()
        jump sine(r, r, 1)

    // term = r^(2i - 1) / (2i - 1)!, signs alternating
    block sine(term: We, sum: We, i: U64)
        div  : U64  = i.mul(2).mul(i.mul(2).add(1))
        next : We   = we_div_u64(we_mul(term, r2), div).negate()
        done : Bool = we_is_negligible(next, sum)
        branch done
            ? cosine(we_plus_abs(sum, next.v.exp), one, one, 1)
            : sine(next, we_add(sum, next), i.add(1))

    block cosine(s: We, term: We, sum: We, i: U64)
        div  : U64  = i.mul(2).sub(1).mul(i.mul(2))
        next : We   = we_div_u64(we_mul(term, r2), div).negate()
        done : Bool = we_is_negligible(next, sum)
        branch done
            ? return({ a: s, b: we_plus_abs(sum, next.v.exp) })
            : cosine(s, next, we_add(sum, next), i.add(1))

/// sin r and cos r for |r| <= 0.8: r = c + s with c = j/64 and |s| <= 1/128, exactly in fixed point, sin s = s P(s^2)
/// and cos s = Q(s^2) by Horner's scheme in fixed point, then sin r = sin c cos s + cos c sin s and cos r = cos c cos s
/// - sin c sin s with sin c and cos c from tables (no cancellation: c and s are within 1/128, and r <= pi/4). Past 0.8,
/// the Taylor series of r itself.
///
/// The bound: |r| 2^190 truncated to R is off by 2^-190 and r by r.err 2^-192 |r|; sin and cos follow that absolute
/// error at most, added at the end. P and Q (to u^10, u = s^2 <= 2^-14, the rest below u^11 / 21! < 2^-218) come
/// within 2.01 × 2^-190 of their values above 0.99997: 8.1 units. The tables add 2 units, each product 2.
/// :param r: The argument.
/// :returns: sin r and cos r.
routine we_sincos(r: We) -> WePair
    shared big : X = x_of_w(r.v, 190)

    block entry()
        wide : Bool = r.v.exp.gt(0)
        branch wide
            ? return(we_sincos_series(r))
            : split()

    // j = round(|r| 64) from R's bits above 2^184 (bit 56 of its top limb)
    block split()
        j   : U64  = big.h.add(U64.shl(1, 55)).shr(56)
        far : Bool = j.gt(51)
        when
            far     -> return(we_sincos_series(r))
            j.eq(0) -> small()
            else    -> reduce(j)

    // |r| < 1/128: r^2 from |r| 2^197 (below 2^190), its cut and r's own cut moving P and Q by under 2^-203; sin r
    // carries r's bound, cos r (1 - r^2/2 ...) at most that too
    block small()
        d      : X  = x_of_w(r.v, 197)
        u      : X  = x_mul_shift(d, d, 190)
        p      : X  = we_poly(WIDE_INV_FACT_ODD.to<@U64>(), u, 10)
        q      : X  = we_poly(WIDE_INV_FACT_EVEN.to<@U64>(), u, 10)
        sine   : We = we_mul(r, { v: w_of_x(p, 190, false), err: 8.3 })
        cosine : We = { v: w_of_x(q, 190, false), err: r.err.add(8.3).mul(MP_UP) }
        return({ a: sine, b: cosine })

    block reduce(j: U64)
        hj    : X    = { h: j.shl(56), m: 0, l: 0 }
        above : Bool = big.h.ge(hj.h)
        s     : X    = above
            ? x_sub(big, hj)
            : x_sub(hj, big)
        u     : X  = x_mul_shift(s, s, 176)
        p     : X  = we_poly(WIDE_INV_FACT_ODD.to<@U64>(), u, 10)
        q     : X  = we_poly(WIDE_INV_FACT_EVEN.to<@U64>(), u, 10)
        sw    : W  = w_of_x(s, 190, above.bitnot())
        sin_s : We = we_mul(we_exact(sw), { v: w_of_x(p, 190, false), err: 8.2 })
        cos_s : We = { v: w_of_x(q, 190, false), err: 8.2 }
        jump combine(j, sin_s, cos_s)

    block combine(j: U64, sin_s: We, cos_s: We)
        sc     : We  = we_entry(WIDE_SIN.to<@U64>(), j.to<USize>())
        cc     : We  = we_entry(WIDE_COS.to<@U64>(), j.to<USize>())
        sine   : We  = we_add(we_mul(sc, cos_s), we_mul(cc, sin_s))
        cosine : We  = we_sub(we_mul(cc, cos_s), we_mul(sc, sin_s))
        delta  : F64 = r.err.mul(f64_pow2(r.v.exp)).add(4.0)
        sr     : We  = we_widen_abs(sine, delta)
        jump signed(sr, we_widen_abs(cosine, delta))

    block signed(sr: We, cr: We)
        return({ a: sr.with_sign(sr.v.neg.bitxor(r.v.neg)), b: cr })

/// Σ (-1)^k c_k u^k for k = 0 .. top by Horner's scheme in fixed point: acc = c_k - u acc, with u scaled by 2^204 and
/// the coefficients and the sum by 2^190 (each c_k from the table, positive, decreasing, and u below 2^-12, so acc
/// stays near c_k and above 0). Each step cuts its product at 2^-190.
/// :param table: The coefficients c_0 .. c_top as fixed-point numbers of 2^-190.
/// :param u: The variable, scaled by 2^204.
/// :param top: The last index.
/// :returns: The sum, scaled by 2^190.
routine we_poly(table: @U64, u: X, top: USize) -> X
    block entry()
        jump step(top, x_entry(table, top))

    block step(k: USize, acc: X)
        done : Bool = k.eq(0)
        branch done
            ? return(acc)
            : next(k.sub(1), acc)

    block next(k: USize, acc: X)
        c : X = x_entry(table, k)
        jump step(k, x_sub(c, x_mul_shift(acc, u, 204)))

/// The bound of s widened by an absolute error of delta 2^-192 (relative to |s| >= t 2^(e - 1), t its top bits).
/// :param s: The value.
/// :param delta: The absolute error in units of 2^-192.
/// :returns: s with the wider bound.
routine we_widen_abs(s: We, delta: F64) -> We
    block entry()
        t : F64 = s.v.top_f64().abs()
        branch s.v.is_zero()
            ? return({ v: s.v, err: F64.from_bits(0x7FF0000000000000) })
            : return(s.widen(delta.div(t).mul(f64_pow2(s.v.exp.neg())).mul(MP_UP)))

/// atan x: past 1 in magnitude pi/2 - atan(1/|x|), else from the table: c = j/64 nearest |x|, d = (|x| - c) /
/// (1 + |x| c) with |d| <= 1/128, atan |x| = atan c + atan d, and atan d = d P(d^2) by Horner's scheme in fixed point
/// (to d^28 / 29, the rest below 2^-215 relative).
///
/// The bound: d carries its bound from the division; d^2 cut to 2^-204 moves P by under 2^-204 and d's own cut to
/// 2^-197 by under 2^-203; P (above 0.99999) comes within 2.01 × 2^-190, so 8.3 units with those. The table adds 2.
/// :param x: The operand.
/// :returns: atan x.
routine we_atan(x: We) -> We
    shared ax : We = x.magnitude()

    block entry()
        large : Bool = x.v.exp.ge(1).bitand(w_compare_magnitude(x.v, w_of_u128(1, 0)).gt(0))
        when
            x.v.is_zero() -> return(x)
            large         -> reciprocal()
            else          -> core()

    block reciprocal()
        inner   : We = we_atan(we_div(we_int(1), ax))
        half_pi : We = we_const(DEC_PI).ldexp(-1)
        r       : We = we_sub(half_pi, inner)
        return(r.with_sign(x.v.neg))

    // j = round(|x| 64)
    block core()
        big : X   = x_of_w(ax.v, 190)
        j   : U64 = big.h.add(U64.shl(1, 55)).shr(56)
        branch j.eq(0)
            ? series(j, ax)
            : divide(j)

    block divide(j: U64)
        c   : We = we_exact(w_of_u128(j.to<U128>(), -6))
        num : We = we_sub(ax, c)
        den : We = we_add(we_int(1), we_mul_u64(ax, j).ldexp(-6))
        jump series(j, we_div(num, den))

    block series(j: U64, d: We)
        dx : X  = x_of_w(d.v, 197)
        u  : X  = x_mul_shift(dx, dx, 190)
        p  : X  = we_poly(WIDE_INV_ODD.to<@U64>(), u, 14)
        ad : We = we_mul(d, { v: w_of_x(p, 190, false), err: 8.3 })
        t  : We = we_entry(WIDE_ATAN.to<@U64>(), j.to<USize>())
        r  : We = we_add(t, ad)
        return(r.with_sign(x.v.neg))

/// fn(x, y) at 192 bits (x, y finite, the special cases settled by the caller).
/// :param fn: Which function (a DEC_ code).
/// :param x: The operand.
/// :param y: The second argument (pow and atan2), else ignored.
/// :param bits: The precision the result needs, in bits.
/// :returns: fn(x, y) at 192 bits.
routine wide_eval(fn: U32, x: Dec, y: Dec, bits: S64) -> We
    block entry()
        when fn
            0    -> return(we_exp(we_of_dec(x)))
            1    -> return(we_expm1(we_of_dec(x)))
            2    -> return(we_exp(we_mul(we_of_dec(x), we_const(DEC_LN2))))
            3    -> return(we_exp(we_mul(we_of_dec(x), we_const(DEC_LN10))))
            4    -> return(wide_eval_ln(x))
            5    -> return(wide_eval_ln1p(x))
            6    -> return(we_mul(wide_eval_ln(x), we_entry(WIDE_CONST.to<@U64>(), 0)))
            7    -> return(we_mul(wide_eval_ln(x), we_entry(WIDE_CONST.to<@U64>(), 1)))
            8    -> return(wide_eval_asin(x))
            9    -> return(wide_eval_acos(x))
            10   -> return(wide_eval_atan(x))
            11   -> return(wide_eval_sinh(x))
            12   -> return(wide_eval_cosh(x))
            13   -> return(wide_eval_tanh(x))
            14   -> return(wide_eval_asinh(x))
            15   -> return(wide_eval_acosh(x))
            16   -> return(wide_eval_atanh(x))
            17   -> return(wide_eval_erf(x, false, bits))
            18   -> return(wide_eval_erf(x, true, bits))
            19   -> return(wide_eval_gamma(x, false, bits))
            20   -> return(wide_eval_gamma(x, true, bits))
            21   -> return(wide_eval_trig(x, 0))
            22   -> return(wide_eval_trig(x, 1))
            23   -> return(wide_eval_trig(x, 2))
            24   -> return(wide_eval_cbrt(x))
            25   -> return(wide_eval_pow(x, y))
            else -> return(wide_eval_atan2(x, y))

/// ln x of a finite x > 0: within 1/2 of 1 as ln(1 + t) with t = x - 1 exact in decimal.
/// :param x: The operand.
/// :returns: ln x of a finite x > 0.
routine wide_eval_ln(x: Dec) -> We
    block entry()
        near : Bool = dec_compare_abs(x, 5, -1).gt(0).bitand(dec_compare_abs(x, 15, -1).lt(0))
        branch near
            ? return(we_ln1p(we_of_dec(dec_plus_int(x, -1))))
            : return(we_ln(we_of_dec(x)))

/// ln(1 + x) of a finite x > -1: below -1/2 as ln of 1 + x exact in decimal.
/// :param x: The operand.
/// :returns: ln(1 + x) of a finite x > -1.
routine wide_eval_ln1p(x: Dec) -> We
    block entry()
        low : Bool = x.neg.bitand(dec_compare_abs(x, 5, -1).gt(0))
        branch low
            ? return(we_ln(we_of_dec(dec_plus_int(x, 1))))
            : return(we_ln1p(we_of_dec(x)))

/// 1 - |x| for |x| <= 1: exact in decimal from 1/2 on, else at 192 bits.
/// :param x: The operand.
/// :returns: 1 - |x| for |x| <= 1.
routine wide_one_minus_abs(x: Dec) -> We
    shared ax : Dec = dec_num(false, x.coeff, x.exp)

    block entry()
        high : Bool = dec_compare_abs(x, 5, -1).ge(0)
        branch high
            ? return(we_of_dec(dec_plus_int(ax, -1).negate()))
            : return(we_sub(we_int(1), we_of_dec(ax)))

/// asin x for |x| <= 1: atan(x / sqrt(1 - x^2)), 1 - x^2 = (1 - |x|)(1 + |x|) with 1 - |x| exact near 1; ±pi/2 at ±1.
/// :param x: The operand.
/// :returns: asin x for |x| <= 1.
routine wide_eval_asin(x: Dec) -> We
    shared omx : We = wide_one_minus_abs(x)

    block entry()
        branch omx.v.is_zero()
            ? return(we_const(DEC_PI).ldexp(-1).with_sign(x.neg))
            : general()

    block general()
        opx : We = we_sub(we_int(2), omx)
        s   : We = we_sqrt(we_mul(omx, opx))
        a   : We = we_atan(we_div(we_of_dec(x).magnitude(), s))
        return(a.with_sign(x.neg))

/// acos x for |x| <= 1: 2 atan(sqrt((1 - x) / (1 + x))), pi at -1.
/// :param x: The operand.
/// :returns: acos x for |x| <= 1.
routine wide_eval_acos(x: Dec) -> We
    shared omx : We = wide_one_minus_abs(x)

    block entry()
        minus_one : Bool = x.neg.bitand(omx.v.is_zero())
        branch minus_one
            ? return(we_const(DEC_PI))
            : general()

    // 1 - x and 1 + x: one of them is 1 - |x|, the other 2 - (1 - |x|)
    block general()
        other : We = we_sub(we_int(2), omx)
        num   : We = x.neg
            ? other
            : omx
        den : We = x.neg
            ? omx
            : other
        t : We = we_sqrt(we_div(num, den))
        return(we_atan(t).ldexp(1))

/// atan x, ±pi/2 for an infinity.
/// :param x: The operand.
/// :returns: atan x, ±pi/2 for an infinity.
routine wide_eval_atan(x: Dec) -> We
    block entry()
        branch x.is_inf()
            ? return(we_const(DEC_PI).ldexp(-1).with_sign(x.neg))
            : return(we_atan(we_of_dec(x)))

/// sinh x: below 2^-24 its series, else (e^|x| - e^-|x|) / 2 (the cancellation costs at most 24 bits).
/// :param x: The operand.
/// :returns: sinh x.
routine wide_eval_sinh(x: Dec) -> We
    shared xm : We = we_of_dec(x)
    shared x2 : We = we_mul(xm, xm)

    block entry()
        small : Bool = xm.v.exp.le(-24)
        branch small
            ? series(xm, xm, 2)
            : large()

    block series(term: We, sum: We, i: U64)
        next : We   = we_div_u64(we_mul(term, x2), i.mul(i.add(1)))
        done : Bool = we_is_negligible(next, sum)
        branch done
            ? return(we_plus_abs(sum, next.v.exp.add(1)))
            : series(next, we_add(sum, next), i.add(2))

    block large()
        e : We = we_exp(xm.magnitude())
        d : We = we_sub(e, we_div(we_int(1), e))
        return(d.ldexp(-1).with_sign(x.neg))

/// cosh x = (e^|x| + e^-|x|) / 2.
/// :param x: The operand.
/// :returns: cosh x = (e^|x| + e^-|x|) / 2.
routine wide_eval_cosh(x: Dec) -> We
    block entry()
        e : We = we_exp(we_of_dec(x).magnitude())
        s : We = we_add(e, we_div(we_int(1), e))
        return(s.ldexp(-1))

/// tanh x = u / (u + 2) with u = e^(2|x|) - 1, signed.
/// :param x: The operand.
/// :returns: tanh x = u / (u + 2) with u = e^(2|x|) - 1, signed.
routine wide_eval_tanh(x: Dec) -> We
    block entry()
        u : We = we_expm1(we_of_dec(x).magnitude().ldexp(1))
        t : We = we_div(u, we_add(u, we_int(2)))
        return(t.with_sign(x.neg))

/// asinh x = ln(|x| + sqrt(x^2 + 1)), below 1/2 as ln(1 + |x| + x^2 / (1 + sqrt(1 + x^2))), signed.
/// :param x: The operand.
/// :returns: asinh x = ln(|x| + sqrt(x^2 + 1)), below 1/2 as ln(1 + |x| + x^2 / (1 + sqrt(1 + x^2))), signed.
routine wide_eval_asinh(x: Dec) -> We
    shared ax  : We = we_of_dec(x).magnitude()
    shared one : We = we_int(1)
    shared x2  : We = we_mul(ax, ax)
    shared rt  : We = we_sqrt(we_add(x2, one))

    block entry()
        small : Bool = ax.v.exp.le(-1)
        branch small
            ? near()
            : far()

    block near()
        t : We = we_add(ax, we_div(x2, we_add(one, rt)))
        return(we_ln1p(t).with_sign(x.neg))

    block far()
        return(we_ln(we_add(ax, rt)).with_sign(x.neg))

/// acosh x = ln(1 + t + sqrt(t (t + 2))) with t = x - 1 (exact in decimal below 2).
/// :param x: The operand.
/// :returns: acosh x = ln(1 + t + sqrt(t (t + 2))) with t = x - 1 (exact in decimal below 2).
routine wide_eval_acosh(x: Dec) -> We
    block entry()
        near : Bool = dec_compare_abs(x, 2, 0).lt(0)
        branch near
            ? with_t(we_of_dec(dec_plus_int(x, -1)))
            : with_t(we_sub(we_of_dec(x), we_int(1)))

    block with_t(t: We)
        r : We = we_sqrt(we_mul(t, we_add(t, we_int(2))))
        return(we_ln1p(we_add(t, r)))

/// atanh x = ln(1 + 2|x| / (1 - |x|)) / 2, 1 - |x| exact near 1, signed.
/// :param x: The operand.
/// :returns: atanh x = ln(1 + 2|x| / (1 - |x|)) / 2, 1 - |x| exact near 1, signed.
routine wide_eval_atanh(x: Dec) -> We
    block entry()
        ax  : We = we_of_dec(x).magnitude()
        omx : We = wide_one_minus_abs(x)
        q   : We = we_div(ax.ldexp(1), omx)
        return(we_ln1p(q).ldexp(-1).with_sign(x.neg))

/// cbrt x = e^(ln|x| / 3), signed.
/// :param x: The operand.
/// :returns: cbrt x = e^(ln|x| / 3), signed.
routine wide_eval_cbrt(x: Dec) -> We
    block entry()
        l : We = we_div_u64(wide_eval_ln(dec_num(false, x.coeff, x.exp)), 3)
        return(we_exp(l).with_sign(x.neg))

/// erf |x| = 2/sqrt(pi) e^(-x^2) Σ x y^k / (1 3 5 ... (2k+1)) with y = 2x^2 (we_erf_series), or, where erfc x is
/// below 2^-(bits + 16) (2 x^2 log2(e) past bits + 16), 1 - erfc x from the asymptotic series.
/// :param ax: The magnitude of the argument.
/// :param bits: The precision the result needs, in bits.
/// :returns: erf |x|.
routine we_erf_positive(ax: We, bits: S64) -> We
    shared x2  : We  = we_mul(ax, ax)
    shared x2f : F64 = x2.v.to_f64()

    block entry()
        far : Bool = x2f.mul(2.8853900817779268).gt(bits.add(16).to<F64>())
        branch far
            ? return(we_sub(we_int(1), we_erfc_asymptotic(ax, bits)))
            : return(we_erf_series(ax, x2, x2.ldexp(1), bits))

/// The series of we_erf_positive on W values without a bound per step: term k is off by at most ax.err + k (y.err +
/// 4) units (each step one product and one division, 2 units each), and the sum of n positive terms by the largest
/// of those plus 2 units per addition: ax.err + n (y.err + 6). Once the ratio y / i is below 1/2 the rest is below
/// twice the next term.
/// :param ax: The magnitude of the argument.
/// :param x2: Its square.
/// :param y: 2 x^2.
/// :param bits: The precision the result needs, in bits.
/// :returns: erf |x|.
routine we_erf_series(ax: We, x2: We, y: We, bits: S64) -> We
    shared yf : F64 = y.v.to_f64()

    block entry()
        jump series(ax.v, ax.v, 3, 0)

    block series(term: W, sum: W, i: U64, n: U64)
        next  : W    = w_div_u64(w_mul(term, y.v), i)
        ratio : F64  = yf.div(i.add(2).to<F64>())
        small : Bool = next.is_zero().bitor(next.exp.lt(sum.exp.sub(bits).sub(8)))
        branch small.bitand(ratio.lt(0.5))
            ? scale(sum, next, n)
            : series(next, w_add(sum, next), i.add(2), n.add(1))

    block scale(sum: W, next: W, n: U64)
        nf  : F64 = n.to<F64>()
        err : F64 = ax.err.add(nf.mul(y.err.add(6.0))).mul(1.01)
        s   : We  = we_plus_abs({ v: sum, err: err }, next.exp.add(1))
        g   : We  = we_exp(x2.negate())
        c   : We  = we_const(DEC_TWO_OVER_SQRT_PI)
        return(we_mul(we_mul(s, g), c))

/// erfc x for x >= 1/2 by its asymptotic series e^(-x^2) / (x sqrt(pi)) Σ (-1)^k (2k - 1)!! / (2x^2)^k, cut at its
/// smallest term or where terms stop mattering. The rest is below the first term left out.
/// :param ax: The magnitude of the argument.
/// :param bits: The precision the result needs, in bits.
/// :returns: erfc x for x >= 1/2 by its asymptotic series e^(-x^2) / (x sqrt(pi)) Σ (-1)^k (2k - 1)!! / (2x^2)^k, cut at its smallest term or where terms stop mattering.
routine we_erfc_asymptotic(ax: We, bits: S64) -> We
    shared x2  : We = we_mul(ax, ax)
    shared inv : We = we_div(we_int(1), x2.ldexp(1))
    shared one : We = we_int(1)

    block entry()
        jump series(one, one, 1)

    // term = (2k - 1)!! / (2x^2)^k, the next one term × (2k + 1) / (2x^2)
    block series(term: We, sum: We, k: U64)
        next    : We   = we_mul(we_mul_u64(term, k.mul(2).sub(1)), inv)
        growing : Bool = w_compare_magnitude(next.v, term.v).ge(0)
        small   : Bool = we_is_below(next, sum, bits)
        odd     : Bool = k.bitand(1).eq(1)
        signed  : We   = odd
            ? next.negate()
            : next
        when
            growing -> scale(we_plus_abs(sum, term.v.exp))
            small   -> scale(we_plus_abs(sum, next.v.exp))
            else    -> series(next, we_add(sum, signed), k.add(1))

    block scale(sum: We)
        g : We = we_exp(x2.negate())
        c : We = we_const(DEC_TWO_OVER_SQRT_PI).ldexp(-1)
        d : We = we_div(we_mul(g, c), ax)
        return(we_mul(sum, d))

/// erf x (complement false) or erfc x: erfc of a negative x is 1 + erf|x|, below 1/2 it is 1 - erf x, above it
/// 1 - erf x at enough extra limbs for the cancellation (x^2 log2(e) bits), or the asymptotic series once that
/// series alone is accurate enough (or the extra limbs would run out).
/// :param x: The operand.
/// :param complement: Whether erfc is wanted rather than erf.
/// :param bits: The precision the result needs, in bits.
/// :returns: erf x (complement false) or erfc x.
routine wide_eval_erf(x: Dec, complement: Bool, bits: S64) -> We
    shared ax : We = we_of_dec(x).magnitude()

    block entry()
        small : Bool = ax.v.exp.le(-1)
        when
            complement.bitnot() -> return(we_erf_positive(ax, bits).with_sign(x.neg))
            x.neg               -> return(we_add(we_int(1), we_erf_positive(ax, bits)))
            small               -> return(we_sub(we_int(1), we_erf_positive(ax, bits.add(4))))
            else                -> tail()

    // 1 - erf x loses x^2 log2(e) bits and a few: at 192 bits while the rest still holds what the format needs,
    // the asymptotic series once that alone is accurate enough, else at more limbs
    block tail()
        xf     : F64   = ax.v.to_f64()
        lost   : F64   = xf.mul(xf).mul(1.4426950408889634).add(4.0)
        need   : F64   = bits.to<F64>()
        limbs  : U64   = lost.div(64.0).floor().to<U64>()
        extra  : USize = limbs.to<USize>().add(1)
        wide   : USize = extra.add(3)
        here   : Bool  = lost.add(need).add(8.0).le(192.0)
        enough : Bool  = lost.gt(need.add(16.0))
        fits   : Bool  = wide.le(MP_TOP)
        when
            here   -> direct(lost.to<S64>())
            enough -> return(we_erfc_asymptotic(ax, bits))
            fits   -> complement_at(wide)
            else   -> return(we_erfc_asymptotic(ax, bits))

    block direct(lost: S64)
        e : We = we_erf_positive(ax, bits.add(lost).add(8))
        return(we_sub(we_int(1), e))

    block complement_at(wide: USize)
        axw : Me = me_of_dec(x, wide).magnitude()
        e   : Me = me_sub(me_int(1, wide), me_erf_positive(axw, wide), wide)
        return(we_of_me(me_narrow(e, wide, 3)))

/// ln Γ(z) for z past the Stirling floor: (z - 1/2) ln z - z + ln(2 pi)/2 + (1/z) P(1/z^2), P(w) = Σ c_k w^k with
/// c_k = B_2(k+1) / ((2k + 2)(2k + 1)) (signs alternating), whose rest is below its first term left out (z real and
/// positive). How many terms (N + 1) is settled first from F64 estimates T_k = |c_k| w^k (with a margin), until one
/// falls below 2^-(bits + 8) of the sum; then Horner's scheme on W values without a bound per step. Its error is at
/// most (4N + 3) units of Σ T_k (two operations a step and the table's 3 units), w's error moves P by w.err Σ k T_k,
/// and P is at least T_0 - Σ_{k>0} T_k.
/// :param z: The argument.
/// :param bits: The precision the result needs, in bits.
/// :returns: ln Γ(z).
routine we_lngamma_stirling(z: We, bits: S64) -> We
    shared inv : We  = we_recip(z)
    shared w   : We  = we_mul(inv, inv)
    shared zf  : F64 = z.v.to_f64()
    shared wf  : F64 = w.v.to_f64().mul(1.01)

    block entry()
        half  : We  = we_exact(w_of_u128(1, -1))
        a     : We  = we_mul(we_sub(z, half), we_ln(z))
        b     : We  = we_sub(a, z)
        base  : We  = we_add(b, we_const(DEC_HALF_LN_2PI))
        scale : F64 = f64_pow2(bits.add(8).neg()).mul(zf)
        limit : F64 = base.v.to_f64().abs().mul(scale)
        c0    : F64 = we_const(DEC_STIRLING).v.to_f64().abs()
        jump count(base, limit, 1, wf, c0, 0.0)

    // T_k = |c_k| w^k (1.01): the terms 0 .. k - 1 are in when T_k falls below the limit
    block count(base: We, limit: F64, k: USize, power: F64, total: F64, weighted: F64)
        ck   : F64  = we_const(DEC_STIRLING.add(k)).v.to_f64().abs()
        tk   : F64  = ck.mul(power).mul(1.01)
        last : Bool = k.add(1).ge(DEC_STIRLING_TERMS)
        done : Bool = tk.lt(limit).bitor(last)
        branch done
            ? horner(base, k.sub(1), tk, total, weighted)
            : count(base, limit, k.add(1), power.mul(wf), total.add(tk),
                weighted.add(k.to<F64>().mul(tk)))

    block horner(base: We, top: USize, rest: F64, total: F64, weighted: F64)
        jump step(base, top, rest, total, weighted, top, wide_stirling_coefficient(top).v)

    block step(base: We, top: USize, rest: F64, total: F64, weighted: F64, k: USize, acc: W)
        branch k.eq(0)
            ? sum(base, top, rest, total, weighted, acc)
            : step(base, top, rest, total, weighted, k.sub(1),
                w_add(wide_stirling_coefficient(k.sub(1)).v, w_mul(w.v, acc)))

    block sum(base: We, top: USize, rest: F64, total: F64, weighted: F64, p: W)
        c0     : F64 = we_const(DEC_STIRLING).v.to_f64().abs()
        low    : F64 = c0.sub(total.sub(c0).mul(1.01))
        n      : F64 = top.to<F64>()
        steps  : F64 = n.mul(4.0).add(3.0)
        spread : F64 = steps.mul(total).add(weighted.mul(w.err))
        pe     : F64 = low.gt(0.0)
            ? spread.div(low).mul(1.02).add(2.0)
            : F64.from_bits(0x7FF0000000000000)
        s    : We  = we_mul(inv, { v: p, err: pe })
        r    : We  = we_add(base, s)
        tail : F64 = rest.div(zf).mul(1.02)
        hb   : U64 = tail.bits().shr(52)
        e    : S64 = hb.to<S64>().sub(1022)
        branch tail.eq(0.0)
            ? return(r)
            : return(we_plus_abs(r, e))

/// B_2(k+1) / ((2k + 2)(2k + 1)) with its sign.
/// :param k: Which coefficient, from 0.
/// :returns: B_2(k+1) / ((2k + 2)(2k + 1)) with its sign.
routine wide_stirling_coefficient(k: USize) -> We
    block entry()
        c   : We   = we_const(DEC_STIRLING.add(k))
        neg : Bool = k.bitand(1).eq(1)
        return(c.with_sign(neg))

/// Γ(x) (log false) or ln|Γ(x)| (log true) of a finite x that is not a pole: for x > 0 shifted up past the
/// Stirling floor, Γ(x) = Γ(x + N) / (x (x + 1) ... (x + N - 1)); for x < 0 by the reflection
/// Γ(x) = pi / (sin(pi x) Γ(1 - x)), sin(pi x) = (-1)^k sin(pi r) with r = x - k exact in decimal.
/// :param x: The operand.
/// :param log: Whether the logarithm is wanted.
/// :param bits: The precision the result needs, in bits.
/// :returns: Γ(x) (log false) or ln|Γ(x)| (log true) of a finite x that is not a pole.
routine wide_eval_gamma(x: Dec, log: Bool, bits: S64) -> We
    block entry()
        branch x.neg
            ? reflect()
            : return(wide_gamma_positive(we_of_dec(x), log, bits))

    block reflect()
        k     : Dec  = dec_round_int(x, 4, dec_format128())
        r     : Dec  = dec_add(x, k.negate(), dec_format128())
        odd   : Bool = dec_is_odd_integer(k)
        pi    : We   = we_const(DEC_PI)
        sinpi : We   = we_sin_of_pi_times(we_of_dec(r))
        omx   : We   = we_sub(we_int(1), we_of_dec(x))
        g     : We   = wide_gamma_positive(omx, log, bits)
        branch log
            ? log_reflect(pi, sinpi, g)
            : gamma_reflect(pi, sinpi, g, odd)

    block log_reflect(pi: We, sinpi: We, g: We)
        a : We = we_sub(we_ln(pi), we_ln(sinpi.magnitude()))
        return(we_sub(a, g))

    block gamma_reflect(pi: We, sinpi: We, g: We, odd: Bool)
        v : We = we_div(pi, we_mul(sinpi, g))
        branch odd
            ? return(v.negate())
            : return(v)

/// sin(pi r) for |r| <= 1/2: below 1/4 directly, else as cos(pi (1/2 - |r|)), signed (1/2 - |r| loses nothing:
/// both are within a factor of two).
/// :param r: The argument.
/// :returns: sin(pi r) for |r| <= 1/2.
routine we_sin_of_pi_times(r: We) -> We
    block entry()
        far : Bool = r.v.exp.ge(-1)
        branch far
            ? folded()
            : return(we_sincos(we_mul(r, we_const(DEC_PI))).a)

    block folded()
        s : We = we_sub(we_exact(w_of_u128(1, -1)), r.magnitude())
        c : We = we_sincos(we_mul(s, we_const(DEC_PI))).b
        return(c.with_sign(r.v.neg))

/// x reduced modulo pi/2: below pi/4 as it is; below 10^9 by k = round(|x| 2/pi) from F64 and r = |x| - k pi/2 at
/// 192 bits (the bound follows the cancellation; k from F64 may be one off, which leaves |r| a little past pi/4);
/// beyond that dec_reduce's multiprecision reduction, narrowed to 192 bits.
/// :param x: The operand.
/// :returns: x reduced modulo pi/2.
routine wide_reduce(x: Dec) -> WReduced
    block entry()
        small : Bool = dec_compare_abs(x, 785, -3).lt(0)
        top   : S64  = dec_digits(x.coeff).add(x.exp)
        when
            small     -> return({ k: 0, r: we_of_dec(x) })
            top.le(9) -> moderate()
            else      -> far()

    block moderate()
        ax      : We  = we_of_dec(x).magnitude()
        kf      : F64 = ax.v.to_f64().mul(0.6366197723675814)
        k       : U64 = kf.round().to<U64>()
        r       : We  = we_sub(ax, we_mul_u64(we_const(DEC_PI).ldexp(-1), k))
        quarter : U64 = k.bitand(3)
        turned  : U64 = U64.sub(4, quarter).bitand(3)
        branch x.neg
            ? return({ k: turned, r: r.negate() })
            : return({ k: quarter, r: r })

    block far()
        red : DecReduced = dec_reduce(x, 3)
        return({ k: red.k, r: we_of_me(red.r) })

/// Γ(z) or ln Γ(z) for z > 0.
/// :param z: The argument.
/// :param log: Whether the logarithm is wanted.
/// :param bits: The precision the result needs, in bits.
/// :returns: Γ(z) or ln Γ(z) for z > 0.
routine wide_gamma_positive(z: We, log: Bool, bits: S64) -> We
    shared lift  : F64 = bits.add(741).to<F64>()
    shared floor : F64 = lift.div(199.0).exp2()
    shared zf    : F64 = z.v.to_f64()

    block entry()
        short : Bool = zf.lt(floor)
        count : U64  = short
            ? dec_gamma_shift(floor, zf)
            : 0
        jump product(w_of_u128(1, 0), 0, count)

    // prod = z (z + 1) ... (z + i - 1) without a bound per step: each factor z + i is off by z.err + 2 units (one
    // sum), each product adds 2
    block product(prod: W, i: U64, count: U64)
        done : Bool = i.ge(count)
        branch done
            ? shifted(prod, count)
            : product(w_mul(prod, w_add(z.v, w_of_u128(i.to<U128>(), 0))), i.add(1), count)

    block shifted(prod: W, count: U64)
        n   : F64 = count.to<F64>()
        err : F64 = z.err.add(4.0).mul(n).mul(1.01)
        jump stirling({ v: prod, err: err }, we_add(z, we_of_u128(count.to<U128>())), count)

    block stirling(prod: We, shifted: We, count: U64)
        lg   : We   = we_lngamma_stirling(shifted, bits)
        none : Bool = count.eq(0)
        when
            log.bitand(none) -> return(lg)
            log              -> return(we_sub(lg, we_ln(prod)))
            none             -> return(we_exp(lg))
            else             -> return(we_div(we_exp(lg), prod))

/// sin (which 0), cos (1), or tan (2) of a finite x: reduced to r and a quarter turn k, then the series.
/// :param x: The operand.
/// :param which: 0 sine, 1 cosine, 2 tangent.
/// :returns: sin (which 0), cos (1), or tan (2) of a finite x.
routine wide_eval_trig(x: Dec, which: U64) -> We
    block entry()
        red : WReduced = wide_reduce(x)
        sc  : WePair   = we_sincos(red.r)
        s   : We       = wide_quadrant(red.k, sc)
        c   : We       = wide_quadrant(red.k.add(1), sc)
        when which
            0    -> return(s)
            1    -> return(c)
            else -> return(we_div(s, c))

/// sin(r + k pi/2) from sin r and cos r: sin r, cos r, -sin r, -cos r.
/// :param k: The quarter turns.
/// :param sc: Sine and cosine of the reduced argument.
/// :returns: sin(r + k pi/2) from sin r and cos r.
routine wide_quadrant(k: U64, sc: WePair) -> We
    block entry()
        q : U64 = k.bitand(3)
        when q
            0    -> return(sc.a)
            1    -> return(sc.b)
            2    -> return(sc.a.negate())
            else -> return(sc.b.negate())

/// |x|^y = e^(y ln|x|), negated for a negative x and an odd integer y (finite x and y, x nonzero, the result not
/// past the range: dec_pow settles those).
/// :param x: The base.
/// :param y: The exponent.
/// :returns: |x|^y = e^(y ln|x|), negated for a negative x and an odd integer y (finite x and y, x nonzero, the result not past the range.
routine wide_eval_pow(x: Dec, y: Dec) -> We
    block entry()
        l   : We   = wide_eval_ln(dec_num(false, x.coeff, x.exp))
        z   : We   = we_mul(we_of_dec(y), l)
        neg : Bool = x.neg.bitand(dec_is_odd_integer(y))
        return(we_exp(z).with_sign(neg))

/// The angle of (x, y) for finite nonzero x and y: atan(y/x), plus or minus pi for a negative x.
/// :param y: The ordinate.
/// :param x: The abscissa.
/// :returns: The angle of (x, y) for finite nonzero x and y.
routine wide_eval_atan2(y: Dec, x: Dec) -> We
    block entry()
        a : We = we_atan(we_div(we_of_dec(y), we_of_dec(x)))
        branch x.neg
            ? turn(a)
            : return(a)

    block turn(a: We)
        pi : We = we_const(DEC_PI).with_sign(y.neg)
        return(we_add(a, pi))

/// The decimal of format f that every value within y's bound rounds to (half to even), reduced, or not ok when the
/// band reaches a midpoint: y is scaled by a power of ten so that its integer part z has p digits (fewer at the bottom
/// of the range), and the bits of z's mantissa below the binary point decide. The band is at most err units of the
/// mantissa's last bit (|z| < 2^e, so err 2^-192 |z| < err 2^(e - 192)); it is taken twice over, plus 4.
/// :param y: The value with its bound.
/// :param f: The format the result rounds to.
/// :returns: The decimal, or not ok when the band reaches a midpoint.
routine wide_round(y: We, f: DecFormat) -> DecTry
    shared neg : Bool = y.v.neg
    shared ay  : We   = y.magnitude()
    shared p   : S64  = f.digits

    // log10 |y| within 0.03: e log10(2) + log10(t) for the top bits t in [1/2, 1), log10(t) within 0.03 of 0.6 (t - 1)
    // (a guess one off costs one more scaling in split)
    block entry()
        t  : F64 = ay.v.top_f64()
        lg : F64 = y.v.exp.to<F64>().mul(0.30102999566398120).add(t.sub(1.0).mul(0.6))
        a  : S64 = lg.floor().to<S64>()
        jump at(a.sub(p).add(1).max(f.qmin), 0)

    // the digits at exponent q: z = |y| 10^-q
    block at(q: S64, tries: S64)
        high : Bool = q.gt(f.qmax.add(2))
        branch high
            ? return({ ok: true, d: dec_inf(neg) })
            : scale(q, tries)

    // 10^-q up to 10^38 is an exact integer: one product
    block scale(q: S64, tries: S64)
        k      : S64  = q.neg()
        direct : Bool = k.ge(1).bitand(k.le(38))
        branch direct
            ? split(q, tries, we_mul(ay, we_of_u128(dec_p10_128(k))))
            : split(q, tries, we_scale10(ay, k))

    block split(q: S64, tries: S64, z: We)
        int  : U128 = w_floor_u128(z.v)
        big  : Bool = int.ge(dec_p10_128(p))
        tiny : Bool = int.lt(dec_p10_128(p.sub(1))).bitand(q.gt(f.qmin))
        last : Bool = tries.ge(3)
        when
            last.bitnot().bitand(big)  -> at(q.add(1), tries.add(1))
            last.bitnot().bitand(tiny) -> at(q.sub(1), tries.add(1))
            else                       -> decide(q, z, int)

    // s bits of the mantissa lie below the binary point: from 64 to 191 of them the fraction is those bits
    block decide(q: S64, z: We, int: U128)
        s    : S64  = U64.to<S64>(192).sub(z.v.exp)
        fast : Bool = s.ge(64).bitand(s.le(191))
        branch fast
            ? fraction(q, z, int, s.to<U64>())
            : general(q, z, int)

    block fraction(q: S64, z: We, int: U128, s: U64)
        frac  : X    = w_fraction(z.v, s)
        half  : X    = x_power(s.sub(1))
        above : Bool = x_compare(frac, half).ge(0)
        dist  : X    = above
            ? x_sub(frac, half)
            : x_sub(half, frac)
        band  : F64  = z.err.mul(2.0).add(4.0)
        clear : Bool = x_to_f64(dist).mul(0.999).gt(band)
        branch clear
            ? result(q, int.add(above.to<U128>()))
            : return({ ok: false, d: dec_nan() })

    // the fraction against 1/2 in W arithmetic, with the band |z| err 2^-192
    block general(q: S64, z: We, int: U128)
        frac  : W    = w_sub(z.v, w_of_u128(int, 0))
        half  : W    = w_of_u128(1, -1)
        d     : F64  = w_sub(frac, half).to_f64()
        zf    : F64  = z.v.to_f64()
        band  : F64  = zf.mul(z.relative()).mul(2.0)
        clear : Bool = d.abs().gt(band).bitand(band.lt(0.25))
        branch clear
            ? result(q, int.add(d.gt(0.0).to<U128>()))
            : return({ ok: false, d: dec_nan() })

    block result(q: S64, c: U128)
        carry : Bool = c.eq(dec_p10_128(p))
        cc    : U128 = carry
            ? dec_p10_128(p.sub(1))
            : c
        qq : S64 = q.add(carry.to<S64>())
        when
            cc.eq(0)      -> return({ ok: true, d: dec_num(neg, 0, f.qmin) })
            qq.gt(f.qmax) -> return({ ok: true, d: dec_inf(neg) })
            else          -> return({ ok: true, d: dec_num(neg, cc, qq).reduce(f) })

/// The low s bits of x's mantissa (64 <= s <= 191) as a fixed-point number.
/// :param x: The value.
/// :param s: How many bits.
/// :returns: The bits.
routine w_fraction(x: W, s: U64) -> X
    block entry()
        branch s.ge(128)
            ? return({ h: x.h.bitand(U64.shl(1, s.sub(128)).sub(1)), m: x.m, l: x.l })
            : return({ h: 0, m: x.m.bitand(U64.shl(1, s.sub(64)).sub(1)), l: x.l })

/// x as an F64 (rounded): h 2^128 + m 2^64 + l.
/// :param x: The number.
/// :returns: Its value.
routine x_to_f64(x: X) -> F64
    block entry()
        h : F64 = x.h.to<F64>().mul(f64_pow2(128))
        m : F64 = x.m.to<F64>().mul(f64_pow2(64))
        return(h.add(m).add(x.l.to<F64>()))

/// 2^k as a fixed-point number (k < 192).
/// :param k: The power.
/// :returns: 2^k.
routine x_power(k: U64) -> X
    block entry()
        when
            k.ge(128) -> return({ h: U64.shl(1, k.sub(128)), m: 0, l: 0 })
            k.ge(64)  -> return({ h: 0, m: U64.shl(1, k.sub(64)), l: 0 })
            else      -> return({ h: 0, m: 0, l: U64.shl(1, k) })

/// -1, 0, or 1 as a is below, equal to, or above b.
/// :param a: The first number.
/// :param b: The second number.
/// :returns: -1, 0, or 1.
routine x_compare(a: X, b: X) -> S32
    block entry()
        when
            a.h.ne(b.h) -> return(w_order(a.h.lt(b.h)))
            a.m.ne(b.m) -> return(w_order(a.m.lt(b.m)))
            a.l.ne(b.l) -> return(w_order(a.l.lt(b.l)))
            else        -> return(0)

/// floor(|x|) of a W below 2^128 (mp_floor_u128 at three limbs).
/// :param x: The operand.
/// :returns: floor(|x|).
routine w_floor_u128(x: W) -> U128
    block entry()
        when
            x.is_zero()   -> return(0)
            x.exp.le(0)   -> return(0)
            x.exp.gt(128) -> return(U128.MAX)
            else          -> gather(U64.to<S64>(192).sub(x.exp))

    // the integer part is the mantissa shifted right by `drop` bits
    block gather(drop: S64)
        src  : WLimbs = { l4: 0, l3: 0, l2: x.h, l1: x.m, l0: x.l }
        low  : U64    = src.bits(drop)
        high : U64    = src.bits(drop.add(64))
        v    : U128   = high.to<U128>().shl(64).bitor(low.to<U128>())
        keep : S64    = x.exp
        mask : U128   = keep.ge(128)
            ? U128.MAX
            : U128.shl(1, keep.max(0).to<U128>()).sub(1)
        return(v.bitand(mask))
