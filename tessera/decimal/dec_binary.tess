// Conversions between the decimal floats and the binary ones (F16, F32, F64, and F128), each rounded once, half to
// even, from the exact value: a binary float is m × 2^e, a decimal c × 10^q, and both sides are integers times a
// power of the other's radix, so the conversion works on big naturals (the standard library's BigNat) and nothing
// is approximated.

import Standard::Format

/// The bits of the binary float (16, 32, 64, or 128 bits wide, `which`) nearest to x: an infinity keeps its sign,
/// a NaN becomes the positive quiet NaN, and a finite value goes through the standard library's correctly rounded
/// decimal-to-binary conversion (the one its text parsing uses).
/// :param x: The operand.
/// :param which: The binary float's width in bits: 16, 32, 64, or 128.
/// :returns: The bits of the binary float (16, 32, 64, or 128 bits wide, `which`) nearest to x.
routine dec_to_binary(x: Dec, which: U32) -> U128
    shared mbits : S64  = dec_binary_mantissa(which)
    shared wide  : Bool = which.eq(128)
    shared emax  : U128 = U128.shl(1, dec_binary_exponent_bits(which)).sub(1)
    shared sign  : U128 = x.neg.to<U128>().shl(mbits.to<U128>().add(dec_binary_exponent_bits(which)))
    shared inf   : U128 = emax.shl(mbits.to<U128>())

    block entry()
        quiet : U128 = U128.shl(1, mbits.sub(1).to<U128>())
        when
            x.is_nan() -> return(inf.bitor(quiet))
            x.is_inf() -> return(sign.bitor(inf))
            wide       -> return(sign.bitor(dec_to_f128_magnitude(x)))
            else       -> return(sign.bitor(dec_to_narrow_magnitude(x, which)))

/// The stored mantissa bits of the binary float of `which` bits.
/// :param which: The binary float's width in bits.
/// :returns: The stored mantissa bits of the binary float of `which` bits.
routine dec_binary_mantissa(which: U32) -> S64
    block entry()
        when which
            16   -> return(10)
            32   -> return(23)
            64   -> return(52)
            else -> return(112)

/// The exponent field bits of the binary float of `which` bits.
/// :param which: The binary float's width in bits.
/// :returns: The exponent field bits of the binary float of `which` bits.
routine dec_binary_exponent_bits(which: U32) -> U128
    block entry()
        when which
            16   -> return(5)
            32   -> return(8)
            64   -> return(11)
            else -> return(15)

/// The parsed-number form decimal_to_bits takes: x's coefficient in digits, value = digits × 10^exponent.
/// :param x: The operand.
/// :returns: The parsed-number form decimal_to_bits takes.
routine dec_parts(x: Dec) -> DecimalParts
    block entry()
        return({ kind: DecimalKind.Finite, negative: x.neg, kept: dec_digits(x.coeff),
            exponent: x.exp, sticky: false })

/// |x| of a finite x as F128 bits without the sign.
/// :param x: The operand.
/// :returns: |x| of a finite x as F128 bits without the sign.
routine dec_to_f128_magnitude(x: Dec) -> U128
    shared digits : @BigNat<320> <- uninit

    block entry()
        digits.set(x.coeff)
        return(decimal_to_bits(digits, dec_parts(x), 112, 16383, 32767, 4933, -4966))

/// |x| of a finite x as the bits without the sign of the F16, F32, or F64 nearest it (`which`).
/// :param x: The operand.
/// :param which: The binary float's width in bits: 16, 32, or 64.
/// :returns: |x| of a finite x as the bits without the sign of the F16, F32, or F64 nearest it (`which`).
routine dec_to_narrow_magnitude(x: Dec, which: U32) -> U128
    shared digits : @BigNat<72> <- uninit

    block entry()
        digits.set(x.coeff)
        parts : DecimalParts = dec_parts(x)
        when which
            16   -> return(decimal_to_bits(digits, parts, 10, 15, 31, 310, -324))
            32   -> return(decimal_to_bits(digits, parts, 23, 127, 255, 310, -324))
            else -> return(decimal_to_bits(digits, parts, 52, 1023, 2047, 310, -324))

/// The F128 with these bits as a decimal of format f, rounded once and reduced (trailing zeros stripped): a NaN
/// becomes the positive quiet NaN, an infinity keeps its sign, a zero is ±0 with exponent 0. A narrower binary float
/// widens to F128 exactly first.
/// :param bits: The encoding.
/// :param f: The format the result rounds to.
/// :returns: The F128 with these bits as a decimal of format f, rounded once and reduced (trailing zeros stripped).
routine dec_from_binary(bits: U128, f: DecFormat) -> Dec
    shared neg      : Bool         = bits.shr(127).eq(1)
    shared biased   : S64          = bits.shr(112).bitand(0x7FFF).to<S64>()
    shared fraction : U128         = bits.bitand(U128.shl(1, 112).sub(1))
    shared big      : @BigNat<640> <- uninit
    shared divisor  : @BigNat<640> <- uninit
    shared scratch  : @BigNat<640> <- uninit

    block entry()
        top  : Bool = biased.eq(0x7FFF)
        nan  : Bool = top.bitand(fraction.ne(0))
        zero : Bool = biased.eq(0).bitand(fraction.eq(0))
        when
            nan  -> return(dec_nan())
            top  -> return(dec_inf(neg))
            zero -> return(dec_num(neg, 0, 0))
            else -> finite()

    // |x| = m 2^e: an integer m 2^e for e >= 0, else m 5^-e × 10^e
    block finite()
        subnormal : Bool = biased.eq(0)
        hidden    : U128 = subnormal
            ? 0
            : U128.shl(1, 112)
        e : S64 = biased.max(1).sub(16495)
        big.set(fraction.bitor(hidden))
        branch e.ge(0)
            ? scaled_up(e)
            : fives(e.neg(), e)

    block scaled_up(e: S64)
        big.shl(e.to<USize>())
        jump digits(0)

    // times 5^left, 27 fives (5^27 < 2^63) at a time
    block fives(left: S64, e: S64)
        done : Bool = left.eq(0)
        k    : S64  = left.min(27)
        branch done
            ? digits(e)
            : five(left, k, e)

    block five(left: S64, k: S64, e: S64)
        power : U64 = U64.pow(5, k.to<U32>())
        big.mul_add(power, 0)
        jump fives(left.sub(k), e)

    // value = big × 10^q: keep p + 2 or p + 3 digits, the rest as a sticky digit
    block digits(q: S64)
        width : S64 = big.bit_length().to<S64>()
        guess : S64 = width.mul(1233).shr(12).add(1)
        k     : S64 = guess.sub(f.digits).sub(2)
        branch k.le(0)
            ? exact(q)
            : divide(q, k)

    block exact(q: S64)
        low  : U128 = big.limbs.getitem(0).to<U128>()
        high : U128 = big.limbs.getitem(1).to<U128>()
        many : Bool = big.count.load().ge(2)
        top  : U128 = many
            ? high
            : 0
        some   : Bool = big.count.load().ge(1)
        bottom : U128 = some
            ? low
            : 0
        value : U128 = top.shl(64).bitor(bottom)
        return(dec_round_reduced(neg, value.to<U256>(), q, f))

    block divide(q: S64, k: S64)
        one : U64 = 1
        divisor.set(one)
        divisor.mul_pow10(k.to<USize>())
        quotient : U128 = big.div_small(divisor, scratch, 127)
        rest     : Bool = big.is_zero().bitnot()
        sticky   : U256 = rest.to<U64>().to<U256>()
        coeff    : U256 = quotient.to<U256>().mul(10).add(sticky)
        return(dec_round_reduced(neg, coeff, q.add(k).sub(1), f))

/// (-1)^neg × coeff × 10^exp rounded to f and then reduced: trailing zeros of the rounded coefficient stripped
/// whether the rounding was exact or not (RazorForge's form for a function result), as far as qmax allows.
/// :param neg: Whether the result is negative.
/// :param coeff: The coefficient.
/// :param exp: The exponent.
/// :param f: The format the result rounds to.
/// :returns: (-1)^neg × coeff × 10^exp rounded to f and then reduced.
routine dec_round_reduced(neg: Bool, coeff: U256, exp: S64, f: DecFormat) -> Dec
    block entry()
        r : Dec = dec_finish(neg, coeff, exp, exp, f)
        return(r.reduce(f))
