# The decimal transcendentals of D32, D64, and D128, correctly rounded, on one engine.
#
# D32 and D64 first try a binary float, B64 and B128 with a proven bound on the error (dec_trans_fast.te), which
# settles nearly every argument. Next, and first for D128, the function is evaluated once at 192 bits on a float of
# five words (dec_trans_wide.te), and only then in binary multiprecision (dec_mp.te), from 256 bits for D32 and
# D64 and 384 for D128. Each evaluation comes with a proven bound on its error. When every value within the bound
# rounds to the same decimal of the target width, that decimal is the correctly rounded result; otherwise the value
# sits too close to a rounding midpoint and the evaluation is repeated with twice the bits (Ziv's strategy), up to
# 1024. A function value of a decimal argument is transcendental, and so never exactly a midpoint, except where it
# is rational (2^n, 10^n, x^y): a band still straddling a midpoint at 1024 bits is taken to be on it, and rounds to
# even. The special values (NaN, infinities, zeros, poles, and the results whose size alone settles them) come
# first, the way RazorForge's engines gave them. Every result is reduced: the trailing zeros of the rounded
# coefficient are stripped, as RazorForge's engines did for every function value.

### The precision a computation goes up to: 1024 bits (dec_mp.te allows a few limbs more inside a function).
preset DEC_ZIV_TOP: U64 = 16

### Which function dec_ziv evaluates.
preset DEC_EXP: U32 = 0
preset DEC_EXPM1: U32 = 1
preset DEC_EXP2: U32 = 2
preset DEC_EXP10: U32 = 3
preset DEC_LOG: U32 = 4
preset DEC_LOG1P: U32 = 5
preset DEC_LOG2: U32 = 6
preset DEC_LOG10: U32 = 7
preset DEC_ASIN: U32 = 8
preset DEC_ACOS: U32 = 9
preset DEC_ATAN: U32 = 10
preset DEC_SINH: U32 = 11
preset DEC_COSH: U32 = 12
preset DEC_TANH: U32 = 13
preset DEC_ASINH: U32 = 14
preset DEC_ACOSH: U32 = 15
preset DEC_ATANH: U32 = 16
preset DEC_ERF: U32 = 17
preset DEC_ERFC: U32 = 18
preset DEC_TGAMMA: U32 = 19
preset DEC_LGAMMA: U32 = 20
preset DEC_SIN: U32 = 21
preset DEC_COS: U32 = 22
preset DEC_TAN: U32 = 23
preset DEC_CBRT: U32 = 24
preset DEC_POW: U32 = 25
preset DEC_ATAN2: U32 = 26

# ── constants, series ─────────────────────────────────────────────────────────────────────────────

### Entry i of DEC_CONSTANTS at n limbs: truncated (2 units) from a 1280-bit value that is itself within 2^-1280.
### :param i: Its index in DEC_CONSTANTS.
### :param n: The precision in limbs.
### :returns: Entry i of DEC_CONSTANTS at n limbs.
routine me_const(i: U64, n: U64) -> MpApprox
    table: @U64 = DEC_CONSTANTS.to[@U64]()
    exp: S64 = DEC_CONSTANT_EXP.getitem(i)
    v: Mp = mp_const(table, at: i * 20, exp, n)
    return me_of(v, err: 3.0)

### The bound of s widened by an absolute error below 2^e.
### :param s: The sum.
### :param e: The power of two that bounds the added error.
### :param n: The precision in limbs.
### :returns: The bound of s widened by an absolute error below 2^e.
routine me_plus_abs(s: MpApprox, e: S64, n: U64) -> MpApprox
    bits: S64 = n.to[S64]() * 64
    units: B64 = b64_pow2(e - s.v.exp + 1 + bits)
    if s.v.is_zero(n)
        return (v: s.v, err: B64.from_bits(0x7FF0000000000000))
    return s.widen(units)

### Whether a series term no longer matters: below 2^-(64n + 8) of the sum.
### :param term: The term.
### :param sum: The sum so far.
### :param n: The precision in limbs.
### :returns: Whether a series term no longer matters.
routine me_is_negligible(term: MpApprox, sum: MpApprox, n: U64) -> Bool
    bits: S64 = n.to[S64]() * 64 + 8
    tiny: Bool = term.v.exp < sum.v.exp - bits
    return term.v.is_zero(n) or tiny

### An exact small integer.
### :param k: The integer.
### :param n: The precision in limbs.
### :returns: An exact small integer.
routine me_int(k: S64, n: U64) -> MpApprox
    m: MpApprox = me_of_u128(v: k.abs_diff(0).to[U128](), n)
    return m.with_sign(k < 0)

### x at fewer limbs: the top `to` limbs of the `from`-limb value, the bound rescaled plus a truncation.
### :param x: The value.
### :param from: The limbs it has.
### :param to: The limbs it keeps.
### :returns: x at fewer limbs.
routine me_narrow(x: MpApprox, from: U64, to: U64) -> MpApprox
    local src: @Mp <- x.v
    local dst: @Mp <- Mp.zero()
    local skip: U64 = from - to

    each k in 0 til to
        word: U64 = src.m[k + skip]
        dst.m[k] = word
    x.v.neg.poke_into(dst.neg)
    x.v.exp.poke_into(dst.exp)
    scale: B64 = b64_pow2(skip.to[S64]() * -64)
    err: B64 = (x.err *! scale +! 2.0) *! MP_UP
    return (v: dst.peek(), err: err)

# ── exp, ln ───────────────────────────────────────────────────────────────────────────────────────

### e^x for |x| < 2^16: x = k ln 2 + r, then e^(r / 2^s) by its Taylor series and s squarings (each doubling the
### relative error, which the bounds follow), times 2^k.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: e^x for |x| < 2^16.
routine me_exp(x: MpApprox, n: U64) -> MpApprox
    local kf: B64 = x.v.to_b64(n) *! 1.4426950408889634
    local k: S64 = kf.round().to[S64]()
    local s: S64 = n.to[S64]() * 2 + 4
    local ln2k: MpApprox = me_mul_u64(a: me_const(i: DEC_LN2, n), k: k.abs_diff(0),
        n).with_sign(k < 0)
    local small: MpApprox = me_sub(a: x, b: ln2k, n).ldexp(k: -s, n)
    local one: MpApprox = me_int(k: 1, n)

    loop with term: MpApprox = small, sum: MpApprox = me_add(a: one, b: small, n), i: U64 = 2
        next2: MpApprox = me_div_u64(a: me_mul(a: term, b: small, n), k: i, n)
        if me_is_negligible(term: next2, sum, n)
            each j in 0 til s with e: MpApprox = me_plus_abs(s: sum, e: next2.v.exp + 1, n)
                continue with e: me_mul(a: e, b: e, n)
            then
                return e.ldexp(k, n)
        else
            continue with term: next2, sum: me_add(a: sum, b: next2, n), i: i + 1

### e^x - 1: below 1/16 its own series x + x^2/2 + ..., which keeps the relative accuracy near 0, else e^x - 1.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: e^x - 1.
routine me_expm1(x: MpApprox, n: U64) -> MpApprox
    if x.v.exp <= -4
        loop with term: MpApprox = x, sum: MpApprox = x, i: U64 = 2
            next2: MpApprox = me_div_u64(a: me_mul(a: term, b: x, n), k: i, n)
            if me_is_negligible(term: next2, sum, n)
                return me_plus_abs(s: sum, e: next2.v.exp + 1, n)
            continue with term: next2, sum: me_add(a: sum, b: next2, n), i: i + 1
    else
        return me_sub(a: me_exp(x, n), b: me_int(k: 1, n), n)

### ln(1 + t) for |t| < 1/32 by its series t - t^2/2 + t^3/3 ..., the rest after the last term below twice the next.
### :param t: The argument, below 1/32 in magnitude.
### :param n: The precision in limbs.
### :returns: ln(1 + t) for |t| < 1/32 by its series t - t^2/2 + t^3/3 ..., the rest after the last term below twice the next.
routine me_ln1p_series(t: MpApprox, n: U64) -> MpApprox
    # power = t^(i - 1)
    loop with power: MpApprox = t, sum: MpApprox = t, i: U64 = 2
        next_power2: MpApprox = me_mul(a: power, b: t, n)
        term2: MpApprox = me_div_u64(a: next_power2, k: i, n)
        odd2: Bool = i & 1 == 1
        signed2: MpApprox = when
            odd2 => term2
            else => term2.negate()
        if me_is_negligible(term: term2, sum, n)
            return me_plus_abs(s: sum, e: term2.v.exp + 1, n)
        continue with power: next_power2, sum: me_add(a: sum, b: signed2, n), i: i + 1

### ln x for x > 0: x = m 2^E with m in [0.75, 1.5), y0 the B64 logarithm of m, and ln m = y0 + ln(1 + t) with
### t = m e^-y0 - 1, which is below 2^-50, so its series ends after a few terms.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: ln x for x > 0.
routine me_ln(x: MpApprox, n: U64) -> MpApprox
    local top: B64 = x.v.magnitude().top_b64(n)
    local low: Bool = top < 0.75
    local e: S64 = x.v.exp - low.to[S64]()
    local m: MpApprox = x.ldexp(k: -e, n)
    local y0: B64 = m.v.to_b64(n).ln_unchecked()
    local y0m: MpApprox = me_exact(mp_of_b64(x: y0, n))
    local one: MpApprox = me_int(k: 1, n)

    scaled: MpApprox = me_mul(a: m, b: me_exp(x: y0m.negate(), n), n)
    t: MpApprox = me_sub(a: scaled, b: one, n)
    lnm: MpApprox = me_add(a: y0m, b: me_ln1p_series(t, n), n)
    if e == 0
        return lnm
    part: MpApprox = me_mul(a: me_const(i: DEC_LN2, n), b: me_int(k: e, n), n)
    return me_add(a: part, b: lnm, n)

### ln(1 + t): its series below 1/32, else ln of the sum.
### :param t: The argument.
### :param n: The precision in limbs.
### :returns: ln(1 + t).
routine me_ln1p(t: MpApprox, n: U64) -> MpApprox
    if t.v.exp <= -5
        return me_ln1p_series(t, n)
    return me_ln(x: me_add(a: me_int(k: 1, n), b: t, n), n)

# ── sin, cos, atan ────────────────────────────────────────────────────────────────────────────────

### Two values.
record MePair
    a: MpApprox
    b: MpApprox

### sin r and cos r for |r| below 1 by their Taylor series (alternating with shrinking terms, so the rest is below
### the first term left out).
### :param r: The argument.
### :param n: The precision in limbs.
### :returns: sin r and cos r for |r| below 1 by their Taylor series (alternating with shrinking terms, so the rest is below the first term left out).
routine me_sincos(r: MpApprox, n: U64) -> MePair
    local r2: MpApprox = me_mul(a: r, b: r, n)
    local one: MpApprox = me_int(k: 1, n)

    # term = r^(2i - 1) / (2i - 1)!, signs alternating
    loop with term: MpApprox = r, sum: MpApprox = r, i: U64 = 1
        div2: U64 = i * 2 * (i * 2 + 1)
        next2: MpApprox = me_div_u64(a: me_mul(a: term, b: r2, n), k: div2, n).negate()
        if me_is_negligible(term: next2, sum, n)
            s: MpApprox = me_plus_abs(s: sum, e: next2.v.exp, n)

            loop with term2: MpApprox = one, sum2: MpApprox = one, i2: U64 = 1
                div3: U64 = (i2 * 2 - 1) * (i2 * 2)
                next3: MpApprox = me_div_u64(a: me_mul(a: term2, b: r2, n), k: div3, n).negate()
                if me_is_negligible(term: next3, sum: sum2, n)
                    return (a: s, b: me_plus_abs(s: sum2, e: next3.v.exp, n))
                continue with term2: next3, sum2: me_add(a: sum2, b: next3, n), i2: i2 + 1
        else
            continue with term: next2, sum: me_add(a: sum, b: next2, n), i: i + 1

### atan d for |d| below 2^-8 by its series d - d^3/3 + ..., the rest below the first term left out.
### :param d: The argument, below 2^-8 in magnitude.
### :param n: The precision in limbs.
### :returns: atan d for |d| below 2^-8 by its series d - d^3/3 + ..., the rest below the first term left out.
routine me_atan_series(d: MpApprox, n: U64) -> MpApprox
    local d2: MpApprox = me_mul(a: d, b: d, n)

    # power = d^(i - 2)
    loop with power: MpApprox = d, sum: MpApprox = d, i: U64 = 3
        next_power2: MpApprox = me_mul(a: power, b: d2, n)
        term2: MpApprox = me_div_u64(a: next_power2, k: i, n)
        minus2: Bool = i & 3 == 3
        signed2: MpApprox = when
            minus2 => term2.negate()
            else => term2
        if me_is_negligible(term: term2, sum, n)
            return me_plus_abs(s: sum, e: term2.v.exp, n)
        continue with power: next_power2, sum: me_add(a: sum, b: signed2, n), i: i + 2

### atan x: below 2^-8 its series; above 1 in magnitude pi/2 - atan(1/x); else from y0, the B64 arctangent:
### tan(y0 - atan x) = (sin y0 - x cos y0) / (cos y0 + x sin y0) = d is below 2^-50, and atan x = y0 - atan d.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: atan x.
routine me_atan(x: MpApprox, n: U64) -> MpApprox
    small: Bool = x.v.exp <= -8
    when
        x.v.is_zero(n) => return x
        small => return me_atan_series(d: x, n)
        x.v.exp >= 1 and mp_compare_magnitude(a: x.v, b: mp_of_u128(v: 1, scale: 0, n), n) > 0 =>
            inner: MpApprox = me_atan(x: me_div(a: me_int(k: 1, n), b: x.magnitude(), n), n)
            half_pi: MpApprox = me_const(i: DEC_PI, n).ldexp(k: -1, n)
            r: MpApprox = me_sub(a: half_pi, b: inner, n)
            return r.with_sign(x.v.neg)
        else =>
            y0: B64 = x.v.to_b64(n).atan()
            y0m: MpApprox = me_exact(mp_of_b64(x: y0, n))
            sc: MePair = me_sincos(r: y0m, n)
            num: MpApprox = me_sub(a: sc.a, b: me_mul(a: x, b: sc.b, n), n)
            den: MpApprox = me_add(a: sc.b, b: me_mul(a: x, b: sc.a, n), n)
            d: MpApprox = me_div(a: num, b: den, n)
            return me_sub(a: y0m, b: me_atan_series(d, n), n)

# ── decimal helpers ───────────────────────────────────────────────────────────────────────────────

### x + k exactly, for a finite x with an exponent of at least -60 (else it returns x + k rounded far beyond any
### use); the coefficient as wide as it needs (it then fits 128 bits for every caller here, whose x is within a few
### units of k).
### :param x: The operand.
### :param k: The integer to add.
### :returns: x + k exactly, for a finite x with an exponent of at least -60 (else it returns x + k rounded far beyond any use); the coefficient as wide as it needs (it then fits 128 bits for every caller here, whose x is within a few units of k).
routine dec_plus_int(x: Dec, k: S64) -> Dec
    local e: S64 = x.exp.min(0)

    if e < -60 or x.exp > 38
        return x
    scale: U256 = dec_p10((-e).min(76))
    up: S64 = x.exp - e
    cx: U256 = x.coeff.to[U256]() * dec_p10(up.min(76))
    ck: U256 = k.abs_diff(0).to[U256]() * scale
    when
        x.neg == (k < 0) => return dec_num(neg: x.neg, coeff: (cx + ck).to_wrap[U128](), exp: e)
        cx >= ck => return dec_num(neg: x.neg, coeff: (cx - ck).to_wrap[U128](), exp: e)
        else => return dec_num(neg: k < 0, coeff: (ck - cx).to_wrap[U128](), exp: e)

### |x| compared with c × 10^q: -1, 0, or 1.
### :param x: The operand.
### :param c: The coefficient compared with.
### :param q: Its exponent.
### :returns: |x| compared with c × 10^q.
routine dec_compare_abs(x: Dec, c: U128, q: S64) -> S64
    if x.coeff == 0
        return -1
    return dec_compare_magnitude(ca: x.coeff, ea: x.exp, cb: c, eb: q)

### Whether a finite x is an integer.
### :param x: The operand.
### :returns: Whether a finite x is an integer.
routine dec_is_integer(x: Dec) -> Bool
    when
        x.coeff == 0 => return true
        x.exp >= 0 => return true
        x.exp < -38 => return false
        else =>
            q: U128 = dec_div_p10(x: x.coeff, k: -x.exp)
            return q * dec_p10_128(-x.exp) == x.coeff

### Whether a finite integer x is odd.
### :param x: The operand.
### :returns: Whether a finite integer x is odd.
routine dec_is_odd_integer(x: Dec) -> Bool
    when
        x.coeff == 0 => return false
        x.exp > 0 => return false
        x.exp < -38 => return false
        else =>
            q: U128 = dec_div_p10(x: x.coeff, k: -x.exp)
            return q & 1 == 1

# ── rounding to a decimal ─────────────────────────────────────────────────────────────────────────

### A rounding attempt: whether the band decided it, and the result.
record DecTry
    ok: Bool
    d: Dec

### The decimal of format f that every value within y's bound rounds to (half to even), reduced, or not ok when
### the band reaches a midpoint. A tie rule other than 0 settles a band on a midpoint: 1 takes it to be exactly
### there (half to even), 2 rounds the magnitude up, 3 down.
### The value is scaled by a power of ten so that its integer part has p digits (fewer at the bottom of the range)
### and the fraction decides.
### :param y: The value with its bound.
### :param f: The format the result rounds to.
### :param n: The precision in limbs.
### :param tie_rule: How a band on a midpoint is settled: 0 not at all, 1 half to even, 2 up, 3 down.
### :returns: The decimal of format f that every value within y's bound rounds to (half to even), reduced, or not ok when the band reaches a midpoint.
routine dec_round_me(y: MpApprox, f: DecFormat, n: U64, tie_rule: U8) -> DecTry
    local neg: Bool = y.v.neg
    local ay: MpApprox = y.magnitude()
    local p: S64 = f.digits

    top: B64 = ay.v.top_b64(n)
    lg: B64 = top.log10_unchecked() +! y.v.exp.to[B64]() *! 0.3010299956639812
    a: S64 = lg.floor().to[S64]()

    # the digits at exponent q: z = |y| 10^-q
    loop with q: S64 = (a - p + 1).max(f.qmin), tries: S64 = 0
        if q > f.qmax + 2
            return (ok: true, d: dec_inf(neg))
        z: MpApprox = me_scale10(x: ay, k: -q, n)
        int: U128 = mp_floor_u128(x: z.v, n)
        big: Bool = int >= dec_p10_128(p)
        tiny: Bool = int < dec_p10_128(p - 1) and q > f.qmin
        last: Bool = tries >= 3
        if not last and big
            continue with q: q + 1, tries: tries + 1
        if not last and tiny
            continue with q: q - 1, tries: tries + 1

        # the fraction against 1/2, with the band: |z| err 2^-64n
        frac: Mp = mp_sub(a: z.v, b: mp_of_u128(v: int, scale: 0, n), n)
        half: Mp = mp_of_u128(v: 1, scale: -1, n)
        d: B64 = mp_sub(a: frac, b: half, n).to_b64(n)
        zf: B64 = z.v.to_b64(n)
        band: B64 = zf *! z.relative(n) *! 2.0
        clear: Bool = d.abs() > band and band < 0.25
        up: Bool = d > 0.0
        c: U128 = when
            clear => int + up.to[U128]()
            tie_rule != 0 and not clear => int + dec_tie_step(tie_rule, int)
            else => return (ok: false, d: dec_nan())

        carry: Bool = c == dec_p10_128(p)
        cc: U128 = when
            carry => dec_p10_128(p - 1)
            else => c
        qq: S64 = q + carry.to[S64]()
        when
            cc == 0 => return (ok: true, d: dec_num(neg, coeff: 0, exp: f.qmin))
            qq > f.qmax => return (ok: true, d: dec_inf(neg))
            else => return (ok: true, d: dec_num(neg, coeff: cc, exp: qq).reduce(f))

### floor(|x|) of an Mp below 2^128.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: floor(|x|) of an Mp below 2^128.
routine mp_floor_u128(x: Mp, n: U64) -> U128
    local slot: @Mp <- x

    bits: S64 = n.to[S64]() * 64
    when
        x.is_zero(n) => return 0
        x.exp <= 0 => return 0
        x.exp > 128 => return U128.MAX
        else =>
            # the integer part is the mantissa shifted right by `drop` bits
            dropped: S64 = bits - x.exp
            buf: @Array[U64, 41] = slot.m.to[@U64]().to[@Array[U64, 41]]()
            low: U64 = mp_bits_at(buf, len: n, at: dropped)
            high: U64 = mp_bits_at(buf, len: n, at: dropped + 64)
            v: U128 = (high.to[U128]() << 64) | low.to[U128]()
            keep: S64 = x.exp
            mask: U128 = when
                keep >= 128 => U128.MAX
                else => U128.shift_left(1, keep.max(0).to[U128]()) - 1
            return v & mask

# ── Ziv ───────────────────────────────────────────────────────────────────────────────────────────

### fn(x, y) correctly rounded to f: evaluated at more and more bits until its band settles the rounding.
### :param fn: Which function (a DEC_ code).
### :param x: The operand.
### :param y: The second argument (pow and atan2), else ignored.
### :param f: The format the result rounds to.
### :returns: fn(x, y) correctly rounded to f.
routine dec_ziv(fn: U32, x: Dec, y: Dec, f: DecFormat) -> Dec
    fast: DecTry = dec_fast(fn, x, y, f)
    if fast.ok
        return fast.d
    # 192 bits on the W engine (dec_trans_wide.te), then the multiprecision loop from the next precision up
    w: DecTry = dec_wide(fn, x, y, f)
    if w.ok
        return w.d
    narrow: Bool = f.digits <= 16
    start: U64 = when
        narrow => 4
        else => 6

    loop with n: U64 = start
        v2: MpApprox = dec_eval(fn, x, y, n)
        top2: Bool = n >= DEC_ZIV_TOP
        rule2: U8 = when
            top2 => dec_tie_rule(fn, x)
            else => 0
        r2: DecTry = dec_round_me(y: v2, f, n, tie_rule: rule2)
        if r2.ok
            return r2.d
        continue with n: (n * 2).min(DEC_ZIV_TOP)

### fn(x, y) at n limbs (x, y finite, the special cases settled by the caller).
### :param fn: Which function (a DEC_ code).
### :param x: The operand.
### :param y: The second argument (pow and atan2), else ignored.
### :param n: The precision in limbs.
### :returns: fn(x, y) at n limbs (x, y finite, the special cases settled by the caller).
routine dec_eval(fn: U32, x: Dec, y: Dec, n: U64) -> MpApprox
    when fn
        0 => return me_exp(x: me_of_dec(x, n), n)
        1 => return me_expm1(x: me_of_dec(x, n), n)
        2 => return me_exp(x: me_mul(a: me_of_dec(x, n), b: me_const(i: DEC_LN2, n), n), n)
        3 => return me_exp(x: me_mul(a: me_of_dec(x, n), b: me_const(i: DEC_LN10, n), n), n)
        4 => return dec_eval_ln(x, n)
        5 => return dec_eval_ln1p(x, n)
        6 => return me_div(a: dec_eval_ln(x, n), b: me_const(i: DEC_LN2, n), n)
        7 => return me_div(a: dec_eval_ln(x, n), b: me_const(i: DEC_LN10, n), n)
        8 => return dec_eval_asin(x, n)
        9 => return dec_eval_acos(x, n)
        10 => return dec_eval_atan(x, n)
        11 => return dec_eval_sinh(x, n)
        12 => return dec_eval_cosh(x, n)
        13 => return dec_eval_tanh(x, n)
        14 => return dec_eval_asinh(x, n)
        15 => return dec_eval_acosh(x, n)
        16 => return dec_eval_atanh(x, n)
        17 => return dec_eval_erf(x, n, complement: false)
        18 => return dec_eval_erf(x, n, complement: true)
        19 => return dec_eval_gamma(x, n, log: false)
        20 => return dec_eval_gamma(x, n, log: true)
        21 => return dec_eval_trig(x, n, which: 0)
        22 => return dec_eval_trig(x, n, which: 1)
        23 => return dec_eval_trig(x, n, which: 2)
        24 => return dec_eval_cbrt(x, n)
        25 => return dec_eval_pow(x, y, n)
        else => return dec_eval_atan2(y: x, x: y, n)

# ── the evaluations ───────────────────────────────────────────────────────────────────────────────

### ln x of a finite x > 0: within 1/2 of 1 as ln(1 + t) with t = x - 1 exact in decimal.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: ln x of a finite x > 0.
routine dec_eval_ln(x: Dec, n: U64) -> MpApprox
    if dec_compare_abs(x, c: 5, q: -1) > 0 and dec_compare_abs(x, c: 15, q: -1) < 0
        return me_ln1p(t: me_of_dec(x: dec_plus_int(x, k: -1), n), n)
    return me_ln(x: me_of_dec(x, n), n)

### ln(1 + x) of a finite x > -1: below -1/2 as ln of 1 + x exact in decimal.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: ln(1 + x) of a finite x > -1.
routine dec_eval_ln1p(x: Dec, n: U64) -> MpApprox
    if x.neg and (dec_compare_abs(x, c: 5, q: -1) > 0)
        return me_ln(x: me_of_dec(x: dec_plus_int(x, k: 1), n), n)
    return me_ln1p(t: me_of_dec(x, n), n)

### 1 - |x| for |x| <= 1: exact in decimal from 1/2 on, else at n limbs.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: 1 - |x| for |x| <= 1.
routine dec_one_minus_abs(x: Dec, n: U64) -> MpApprox
    local ax: Dec = dec_num(neg: false, coeff: x.coeff, exp: x.exp)

    if dec_compare_abs(x, c: 5, q: -1) >= 0
        return me_of_dec(x: dec_plus_int(x: ax, k: -1).negate(), n)
    return me_sub(a: me_int(k: 1, n), b: me_of_dec(x: ax, n), n)

### asin x for |x| <= 1: atan(x / sqrt(1 - x^2)), 1 - x^2 = (1 - |x|)(1 + |x|) with 1 - |x| exact near 1; ±pi/2 at ±1.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: asin x for |x| <= 1.
routine dec_eval_asin(x: Dec, n: U64) -> MpApprox
    local omx: MpApprox = dec_one_minus_abs(x, n)

    if omx.v.is_zero(n)
        return me_const(i: DEC_PI, n).ldexp(k: -1, n).with_sign(x.neg)
    opx: MpApprox = me_sub(a: me_int(k: 2, n), b: omx, n)
    s: MpApprox = me_sqrt(a: me_mul(a: omx, b: opx, n), n)
    a: MpApprox = me_atan(x: me_div(a: me_of_dec(x, n).magnitude(), b: s, n), n)
    return a.with_sign(x.neg)

### acos x for |x| <= 1: 2 atan(sqrt((1 - x) / (1 + x))), pi at -1.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: acos x for |x| <= 1.
routine dec_eval_acos(x: Dec, n: U64) -> MpApprox
    local omx: MpApprox = dec_one_minus_abs(x, n)

    if x.neg and omx.v.is_zero(n)
        return me_const(i: DEC_PI, n)
    # 1 - x and 1 + x: one of them is 1 - |x|, the other 2 - (1 - |x|)
    other: MpApprox = me_sub(a: me_int(k: 2, n), b: omx, n)
    num: MpApprox = when
        x.neg => other
        else => omx
    den: MpApprox = when
        x.neg => omx
        else => other
    t: MpApprox = me_sqrt(a: me_div(a: num, b: den, n), n)
    return me_atan(x: t, n).ldexp(k: 1, n)

### atan x, ±pi/2 for an infinity.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: atan x, ±pi/2 for an infinity.
routine dec_eval_atan(x: Dec, n: U64) -> MpApprox
    if x.is_inf()
        return me_const(i: DEC_PI, n).ldexp(k: -1, n).with_sign(x.neg)
    return me_atan(x: me_of_dec(x, n), n)

### sinh x: below 1 its series (positive terms, relative accuracy), else (e^|x| - e^-|x|) / 2.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: sinh x.
routine dec_eval_sinh(x: Dec, n: U64) -> MpApprox
    local xm: MpApprox = me_of_dec(x, n)
    local x2: MpApprox = me_mul(a: xm, b: xm, n)

    if xm.v.exp <= 0
        loop with term: MpApprox = xm, sum: MpApprox = xm, i: U64 = 2
            next2: MpApprox = me_div_u64(a: me_mul(a: term, b: x2, n), k: i * (i + 1), n)
            if me_is_negligible(term: next2, sum, n)
                return me_plus_abs(s: sum, e: next2.v.exp + 1, n)
            continue with term: next2, sum: me_add(a: sum, b: next2, n), i: i + 2
    else
        e: MpApprox = me_exp(x: xm.magnitude(), n)
        d: MpApprox = me_sub(a: e, b: me_div(a: me_int(k: 1, n), b: e, n), n)
        return d.ldexp(k: -1, n).with_sign(x.neg)

### cosh x = (e^|x| + e^-|x|) / 2.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: cosh x = (e^|x| + e^-|x|) / 2.
routine dec_eval_cosh(x: Dec, n: U64) -> MpApprox
    e: MpApprox = me_exp(x: me_of_dec(x, n).magnitude(), n)
    s: MpApprox = me_add(a: e, b: me_div(a: me_int(k: 1, n), b: e, n), n)
    return s.ldexp(k: -1, n)

### tanh x = u / (u + 2) with u = e^(2|x|) - 1, signed.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: tanh x = u / (u + 2) with u = e^(2|x|) - 1, signed.
routine dec_eval_tanh(x: Dec, n: U64) -> MpApprox
    u: MpApprox = me_expm1(x: me_of_dec(x, n).magnitude().ldexp(k: 1, n), n)
    t: MpApprox = me_div(a: u, b: me_add(a: u, b: me_int(k: 2, n), n), n)
    return t.with_sign(x.neg)

### asinh x = ln(|x| + sqrt(x^2 + 1)), below 1/2 as ln(1 + |x| + x^2 / (1 + sqrt(1 + x^2))), signed.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: asinh x = ln(|x| + sqrt(x^2 + 1)), below 1/2 as ln(1 + |x| + x^2 / (1 + sqrt(1 + x^2))), signed.
routine dec_eval_asinh(x: Dec, n: U64) -> MpApprox
    local ax: MpApprox = me_of_dec(x, n).magnitude()
    local one: MpApprox = me_int(k: 1, n)
    local x2: MpApprox = me_mul(a: ax, b: ax, n)
    local rt: MpApprox = me_sqrt(a: me_add(a: x2, b: one, n), n)

    if ax.v.exp <= -1
        t: MpApprox = me_add(a: ax, b: me_div(a: x2, b: me_add(a: one, b: rt, n), n), n)
        return me_ln1p(t, n).with_sign(x.neg)
    return me_ln(x: me_add(a: ax, b: rt, n), n).with_sign(x.neg)

### acosh x = ln(1 + t + sqrt(t (t + 2))) with t = x - 1 (exact in decimal below 2).
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: acosh x = ln(1 + t + sqrt(t (t + 2))) with t = x - 1 (exact in decimal below 2).
routine dec_eval_acosh(x: Dec, n: U64) -> MpApprox
    near: Bool = dec_compare_abs(x, c: 2, q: 0) < 0
    t: MpApprox = when
        near => me_of_dec(x: dec_plus_int(x, k: -1), n)
        else => me_sub(a: me_of_dec(x, n), b: me_int(k: 1, n), n)
    r: MpApprox = me_sqrt(a: me_mul(a: t, b: me_add(a: t, b: me_int(k: 2, n), n), n), n)
    return me_ln1p(t: me_add(a: t, b: r, n), n)

### atanh x = ln(1 + 2|x| / (1 - |x|)) / 2, 1 - |x| exact near 1, signed.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: atanh x = ln(1 + 2|x| / (1 - |x|)) / 2, 1 - |x| exact near 1, signed.
routine dec_eval_atanh(x: Dec, n: U64) -> MpApprox
    ax: MpApprox = me_of_dec(x, n).magnitude()
    omx: MpApprox = dec_one_minus_abs(x, n)
    q: MpApprox = me_div(a: ax.ldexp(k: 1, n), b: omx, n)
    return me_ln1p(t: q, n).ldexp(k: -1, n).with_sign(x.neg)

### cbrt x = e^(ln|x| / 3), signed.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: cbrt x = e^(ln|x| / 3), signed.
routine dec_eval_cbrt(x: Dec, n: U64) -> MpApprox
    l: MpApprox = me_div_u64(a: dec_eval_ln(x: dec_num(neg: false, coeff: x.coeff, exp: x.exp), n),
        k: 3, n)
    return me_exp(x: l, n).with_sign(x.neg)

# ── erf, erfc ─────────────────────────────────────────────────────────────────────────────────────

### erf |x| = 2/sqrt(pi) e^(-x^2) Σ 2^k x^(2k+1) / (1 3 5 ... (2k+1)): positive terms, so no cancellation at any
### x. Once the term ratio 2x^2 / (2k + 3) is below 1/2 the rest is below the last term left out.
### :param ax: The magnitude of the argument.
### :param n: The precision in limbs.
### :returns: erf |x| = 2/sqrt(pi) e^(-x^2) Σ 2^k x^(2k+1) / (1 3 5 ... (2k+1)).
routine me_erf_positive(ax: MpApprox, n: U64) -> MpApprox
    local x2: MpApprox = me_mul(a: ax, b: ax, n)
    local two: MpApprox = x2.ldexp(k: 1, n)

    # the next term is term × 2x^2 / i
    loop with term: MpApprox = ax, sum: MpApprox = ax, i: U64 = 3
        next2: MpApprox = me_div_u64(a: me_mul(a: term, b: two, n), k: i, n)
        ratio2: B64 = two.v.to_b64(n) /! (i + 2).to[B64]()
        if me_is_negligible(term: next2, sum, n) and (ratio2 < 0.5)
            sum2: MpApprox = me_plus_abs(s: sum, e: next2.v.exp + 1, n)
            g: MpApprox = me_exp(x: x2.negate(), n)
            c: MpApprox = me_const(i: DEC_TWO_OVER_SQRT_PI, n)
            return me_mul(a: me_mul(a: sum2, b: g, n), b: c, n)
        continue with term: next2, sum: me_add(a: sum, b: next2, n), i: i + 2

### erfc x for x >= 1/2 by its asymptotic series e^(-x^2) / (x sqrt(pi)) Σ (-1)^k (2k - 1)!! / (2x^2)^k, cut at its
### smallest term or where terms stop mattering. The rest is below the first term left out.
### :param ax: The magnitude of the argument.
### :param n: The precision in limbs.
### :returns: erfc x for x >= 1/2 by its asymptotic series e^(-x^2) / (x sqrt(pi)) Σ (-1)^k (2k - 1)!! / (2x^2)^k, cut at its smallest term or where terms stop mattering.
routine me_erfc_asymptotic(ax: MpApprox, n: U64) -> MpApprox
    local x2: MpApprox = me_mul(a: ax, b: ax, n)
    local inv: MpApprox = me_div(a: me_int(k: 1, n), b: x2.ldexp(k: 1, n), n)
    local one: MpApprox = me_int(k: 1, n)

    # term = (2k - 1)!! / (2x^2)^k, the next one term × (2k + 1) / (2x^2)
    loop with term: MpApprox = one, sum: MpApprox = one, k: U64 = 1
        next: MpApprox = me_mul(a: me_mul_u64(a: term, k: k * 2 - 1, n), b: inv, n)
        growing: Bool = mp_compare_magnitude(a: next.v, b: term.v, n) >= 0
        small: Bool = me_is_negligible(term: next, sum, n)
        odd: Bool = k & 1 == 1
        signed: MpApprox = when
            odd => next.negate()
            else => next
        when
            growing =>
                sum2: MpApprox = me_plus_abs(s: sum, e: term.v.exp, n)
                g: MpApprox = me_exp(x: x2.negate(), n)
                c: MpApprox = me_const(i: DEC_TWO_OVER_SQRT_PI, n).ldexp(k: -1, n)
                d: MpApprox = me_div(a: me_mul(a: g, b: c, n), b: ax, n)
                return me_mul(a: sum2, b: d, n)
            small =>
                sum2: MpApprox = me_plus_abs(s: sum, e: next.v.exp, n)
                g: MpApprox = me_exp(x: x2.negate(), n)
                c: MpApprox = me_const(i: DEC_TWO_OVER_SQRT_PI, n).ldexp(k: -1, n)
                d: MpApprox = me_div(a: me_mul(a: g, b: c, n), b: ax, n)
                return me_mul(a: sum2, b: d, n)
            else => continue with term: next, sum: me_add(a: sum, b: signed, n), k: k + 1

### erf x (complement false) or erfc x: erfc of a negative x is 1 + erf|x|, below 1/2 it is 1 - erf x, above it
### 1 - erf x at enough extra limbs for the cancellation (x^2 log2(e) bits), or the asymptotic series once that
### series alone is accurate enough (or the extra limbs would run out).
### :param x: The operand.
### :param n: The precision in limbs.
### :param complement: Whether erfc is wanted rather than erf.
### :returns: erf x (complement false) or erfc x.
routine dec_eval_erf(x: Dec, n: U64, complement: Bool) -> MpApprox
    local ax: MpApprox = me_of_dec(x, n).magnitude()

    when
        not complement => return me_erf_positive(ax, n).with_sign(x.neg)
        x.neg => return me_add(a: me_int(k: 1, n), b: me_erf_positive(ax, n), n)
        ax.v.exp <= -1 => return me_sub(a: me_int(k: 1, n), b: me_erf_positive(ax, n), n)
        else =>
            xf: B64 = ax.v.to_b64(n)
            lost: B64 = xf *! xf *! 1.4426950408889634 +! 4.0
            limbs: U64 = (lost /! 64.0).floor().to[U64]()
            extra: U64 = limbs.to[U64]() + 1
            wide: U64 = n + extra
            enough: Bool = lost > n.to[B64]() *! 64.0 +! 16.0
            when
                enough => return me_erfc_asymptotic(ax, n)
                wide <= MP_TOP =>
                    axw: MpApprox = me_of_dec(x, n: wide).magnitude()
                    e: MpApprox = me_sub(a: me_int(k: 1, n: wide),
                        b: me_erf_positive(ax: axw, n: wide), n: wide)
                    return me_narrow(x: e, from: wide, to: n)
                else => return me_erfc_asymptotic(ax, n)

# ── gamma ─────────────────────────────────────────────────────────────────────────────────────────

### ln Γ(z) for z past dec_stirling_floor, by Stirling's series (z - 1/2) ln z - z + ln(2 pi)/2 +
### Σ B_2k / (2k (2k - 1) z^(2k - 1)), whose rest is below the first term left out (z real and positive).
### :param z: The argument.
### :param n: The precision in limbs.
### :returns: ln Γ(z) for z past dec_stirling_floor, by Stirling's series (z - 1/2) ln z - z + ln(2 pi)/2 + Σ B_2k / (2k (2k - 1) z^(2k - 1)), whose rest is below the first term left out (z real and positive).
routine me_lngamma_stirling(z: MpApprox, n: U64) -> MpApprox
    local inv: MpApprox = me_div(a: me_int(k: 1, n), b: z, n)
    local inv2: MpApprox = me_mul(a: inv, b: inv, n)

    half: MpApprox = me_of(v: mp_of_u128(v: 1, scale: -1, n), err: 0.0)
    a: MpApprox = me_mul(a: me_sub(a: z, b: half, n), b: me_ln(x: z, n), n)
    b: MpApprox = me_sub(a, b: z, n)

    # power = z^-(2k + 1)
    loop with sum: MpApprox = me_add(a: b, b: me_const(i: DEC_HALF_LN_2PI, n),
        n), power: MpApprox = inv, k: U64 = 0
        coefficient2: MpApprox = dec_stirling_coefficient(k, n)
        term2: MpApprox = me_mul(a: coefficient2, b: power, n)
        last2: Bool = k + 1 >= DEC_STIRLING_TERMS
        if me_is_negligible(term: term2, sum, n) or last2
            return me_plus_abs(s: sum, e: term2.v.exp + 1, n)
        continue with sum: me_add(a: sum, b: term2,
            n), power: me_mul(a: power, b: inv2, n), k: k + 1

### B_2(k+1) / ((2k + 2)(2k + 1)) with its sign.
### :param k: Which coefficient, from 0.
### :param n: The precision in limbs.
### :returns: B_2(k+1) / ((2k + 2)(2k + 1)) with its sign.
routine dec_stirling_coefficient(k: U64, n: U64) -> MpApprox
    c: MpApprox = me_const(i: DEC_STIRLING.add(k), n)
    neg: Bool = k & 1 == 1
    return c.with_sign(neg)

### Where Stirling's series with its 100 terms is accurate to 64n + 20 bits: its 100th term,
### B_200 / (200 199 z^199), is about 2^700.8 z^-199.
### :param n: The precision in limbs.
### :returns: Where Stirling's series with its 100 terms is accurate to 64n + 20 bits.
routine dec_stirling_floor(n: U64) -> B64
    bits: B64 = n.to[B64]() *! 64.0 +! 741.0
    return (bits /! 199.0).exp2_unchecked()

### Γ(x) (log false) or ln|Γ(x)| (log true) of a finite x that is not a pole: for x > 0 shifted up past the
### Stirling floor, Γ(x) = Γ(x + N) / (x (x + 1) ... (x + N - 1)); for x < 0 by the reflection
### Γ(x) = pi / (sin(pi x) Γ(1 - x)), sin(pi x) = (-1)^k sin(pi r) with r = x - k exact in decimal.
### :param x: The operand.
### :param n: The precision in limbs.
### :param log: Whether the logarithm is wanted.
### :returns: Γ(x) (log false) or ln|Γ(x)| (log true) of a finite x that is not a pole.
routine dec_eval_gamma(x: Dec, n: U64, log: Bool) -> MpApprox
    if x.neg
        k: Dec = dec_round_int(x, mode: 4, f: dec_format128())
        r: Dec = dec_add(a: x, b: k.negate(), f: dec_format128())
        odd: Bool = dec_is_odd_integer(k)
        pi: MpApprox = me_const(i: DEC_PI, n)
        sinpi: MpApprox = me_sin_of_pi_times(r: me_of_dec(x: r, n), n)
        omx: MpApprox = me_sub(a: me_int(k: 1, n), b: me_of_dec(x, n), n)
        g: MpApprox = dec_gamma_positive(z: omx, n, log)
        if log
            a: MpApprox = me_sub(a: me_ln(x: pi, n), b: me_ln(x: sinpi.magnitude(), n), n)
            return me_sub(a, b: g, n)
        v: MpApprox = me_div(a: pi, b: me_mul(a: sinpi, b: g, n), n)
        if odd
            return v.negate()
        return v
    return dec_gamma_positive(z: me_of_dec(x, n), n, log)

### sin(pi r) for |r| <= 1/2.
### :param r: The argument.
### :param n: The precision in limbs.
### :returns: sin(pi r) for |r| <= 1/2.
routine me_sin_of_pi_times(r: MpApprox, n: U64) -> MpApprox
    t: MpApprox = me_mul(a: r, b: me_const(i: DEC_PI, n), n)
    sc: MePair = me_sincos(r: t, n)
    return sc.a

### Γ(z) or ln Γ(z) for z > 0.
### :param z: The argument.
### :param n: The precision in limbs.
### :param log: Whether the logarithm is wanted.
### :returns: Γ(z) or ln Γ(z) for z > 0.
routine dec_gamma_positive(z: MpApprox, n: U64, log: Bool) -> MpApprox
    local floor: B64 = dec_stirling_floor(n)
    local zf: B64 = z.v.to_b64(n)

    short: Bool = zf < floor
    count: U64 = when
        short => dec_gamma_shift(floor, zf)
        else => 0

    # prod = z (z + 1) ... (z + i - 1)
    each i in 0 til count with prod: MpApprox = me_int(k: 1, n), at: MpApprox = z
        continue with prod: me_mul(a: prod, b: at, n), at: me_add(a: at, b: me_int(k: 1, n), n)
    then
        lg: MpApprox = me_lngamma_stirling(z: at, n)
        none: Bool = count == 0
        when
            log and none => return lg
            log => return me_sub(a: lg, b: me_ln(x: prod, n), n)
            none => return me_exp(x: lg, n)
            else => return me_div(a: me_exp(x: lg, n), b: prod, n)

# ── sin, cos, tan ─────────────────────────────────────────────────────────────────────────────────

### An argument reduced modulo pi/2: x = r + k pi/2 with |r| about pi/4 at most, k taken mod 4.
record DecReduced
    k: U64
    r: MpApprox

### sin (which 0), cos (1), or tan (2) of a finite x: reduced to r and a quarter turn k, then the series.
### :param x: The operand.
### :param n: The precision in limbs.
### :param which: 0 sine, 1 cosine, 2 tangent.
### :returns: sin (which 0), cos (1), or tan (2) of a finite x.
routine dec_eval_trig(x: Dec, n: U64, which: U64) -> MpApprox
    red: DecReduced = dec_reduce(x, n)
    sc: MePair = me_sincos(r: red.r, n)
    s: MpApprox = dec_quadrant(k: red.k, sc)
    c: MpApprox = dec_quadrant(k: red.k + 1, sc)
    when which
        0 => return s
        1 => return c
        else => return me_div(a: s, b: c, n)

### sin(r + k pi/2) from sin r and cos r: sin r, cos r, -sin r, -cos r.
### :param k: The quarter turns.
### :param sc: Sine and cosine of the reduced argument.
### :returns: sin(r + k pi/2) from sin r and cos r.
routine dec_quadrant(k: U64, sc: MePair) -> MpApprox
    q: U64 = k & 3
    when q
        0 => return sc.a
        1 => return sc.b
        2 => return sc.a.negate()
        else => return sc.b.negate()

### x reduced modulo pi/2: below pi/4 as it is; below 10^38 (2^127) at three limbs more; beyond that x is an
### integer and the reduction is Payne and Hanek's.
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: x reduced modulo pi/2.
routine dec_reduce(x: Dec, n: U64) -> DecReduced
    small: Bool = dec_compare_abs(x, c: 785, q: -3) < 0
    top: S64 = dec_digits(x.coeff) + x.exp
    when
        small => return (k: 0, r: me_of_dec(x, n))
        top <= 38 => return dec_reduce_moderate(x, n)
        else => return dec_reduce_payne_hanek(x, n)

### k = round(x 2/pi) and r = x - k pi/2 at n + 3 limbs, then narrowed: |x| < 2^127 leaves r at least 64n + 60
### good bits however close x is to a multiple of pi/2 (the error bound shows how many).
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: k = round(x 2/pi) and r = x - k pi/2 at n + 3 limbs, then narrowed.
routine dec_reduce_moderate(x: Dec, n: U64) -> DecReduced
    local w: U64 = n + 3

    xm: MpApprox = me_of_dec(x, n: w)
    half_pi: MpApprox = me_const(i: DEC_PI, n: w).ldexp(k: -1, n: w)
    q: MpApprox = me_div(a: xm, b: half_pi, n: w)
    qa: Mp = q.v.magnitude()
    whole: U128 = mp_floor_u128(x: qa, n: w)
    frac: Mp = mp_sub(a: qa, b: mp_of_u128(v: whole, scale: 0, n: w), n: w)
    up: Bool = mp_compare_magnitude(a: frac, b: mp_of_u128(v: 1, scale: -1, n: w), n: w) >= 0
    k: U128 = whole + up.to[U128]()
    km: MpApprox = me_exact(mp_of_u128(v: k, scale: 0, n: w)).with_sign(x.neg)
    r: MpApprox = me_sub(a: xm, b: me_mul(a: km, b: half_pi, n: w), n: w)
    quarter: U64 = (k & 3).to_wrap[U64]()
    turned: U64 = U64.sub(4, quarter) & 3
    kk: U64 = when
        x.neg => turned
        else => quarter
    return (k: kk, r: me_narrow(x: r, from: w, to: n))

### Payne and Hanek's reduction of a huge x = c 10^q (q >= 0) = M 2^q with M = c 5^q: x / (2 pi) = M Σ t_j
### 2^(q - j) over the bits t_j of 1/(2 pi), whose terms with j <= q are whole turns. The turn fraction f is
### (M W) mod 2^L / 2^L with W the bits q + 1 .. q + L of 1/(2 pi) (more bits above them only add whole turns), off
### by less than M 2^-L; with L at least the bits of M plus 64n + 128 that is below 2^-(64n + 128). Then k is the
### quarter turn nearest 4f and r = 2 pi (f - k/4).
### :param x: The operand.
### :param n: The precision in limbs.
### :returns: Payne and Hanek's reduction of a huge x = c 10^q (q >= 0) = M 2^q with M = c 5^q.
routine dec_reduce_payne_hanek(x: Dec, n: U64) -> DecReduced
    local big: @BigNat[800] <- .hollow()
    local window: @BigNat[800] <- .hollow()
    local product: @BigNat[800] <- .hollow()

    big.set(x.coeff)

    until left == 0 with left: S64 = x.exp
        k: S64 = left.min(27)
        big.mul_add(m: U64.pow(5, k.to[U64]()), addend: 0)
        continue with left: left - k

    # the window: words q / 64 .. (q + L - 1) / 64 of the table, the first one most significant
    q: S64 = x.exp
    size: S64 = big.bit_length().to[S64]()
    want: S64 = size + n.to[S64]() * 64 + 128
    first: U64 = q.div_trunc(64).to[U64]()
    end: S64 = q + want - 1
    last: U64 = end.div_trunc(64).to[U64]()
    zero: U64 = 0
    window.set(zero)

    each w in first to last
        window.shift_left(64)
        window.mul_add(m: 1, addend: DEC_INV_2PI.getitem(w))
    then
        # the fraction has 64 (last + 1) - q bits
        product.set_product(a: big, b: window)
        span: S64 = (last + 1).to[S64]() * 64
        frac_bits: S64 = span - x.exp

        f: Mp = dec_bignat_window(b: product, top: frac_bits, n)
        f4: Mp = f.ldexp(k: 2, n)
        whole: U128 = mp_floor_u128(x: f4, n)
        rest: Mp = mp_sub(a: f4, b: mp_of_u128(v: whole, scale: 0, n), n)
        up: Bool = mp_compare_magnitude(a: rest, b: mp_of_u128(v: 1, scale: -1, n), n) >= 0
        k: U128 = whole + up.to[U128]()
        d: Mp = mp_sub(a: f, b: mp_of_u128(v: k, scale: -2, n), n)
        dm: MpApprox = me_plus_abs(s: me_exact(d), e: n.to[S64]() * -64 - 120, n)
        two_pi: MpApprox = me_const(i: DEC_PI, n).ldexp(k: 1, n)
        r: MpApprox = me_mul(a: dm, b: two_pi, n)
        quart: U64 = (k & 3).to_wrap[U64]()
        turned: U64 = U64.sub(4, quart) & 3
        kk: U64 = when
            x.neg => turned
            else => quart
        rs: MpApprox = r.with_sign(r.v.neg != x.neg)
        return (k: kk, r: rs)

### The bits [top - 64(n + 1), top) of a big natural, as a value in [0, 1) at n limbs: those bits over 2^top.
### :param b: The big natural.
### :param top: The bit just above the window.
### :param n: The precision in limbs.
### :returns: The bits [top - 64(n + 1), top) of a big natural, as a value in [0, 1) at n limbs.
routine dec_bignat_window(b: @BigNat[800], top: S64, n: U64) -> Mp
    local buf: @Array[U64, 41] <- MP_ZERO_BUF.peek()
    local count: U64 = b.count.peek()

    each k in 0 to n
        # the bit offset of limb k of the window
        base: S64 = top - (n + 1).to[S64]() * 64
        at: S64 = base + k.to[S64]() * 64
        word: U64 = dec_bignat_bits(b, count, at)
        buf[k] = word
    scale: S64 = (n + 1).to[S64]() * -64
    return mp_pack(value: MpUnpacked(neg: false, limbs: buf, len: n + 1, scale: scale), n)

### The 64 bits of a big natural from bit `at` up (0 outside it).
### :param b: The big natural.
### :param count: How many limbs are in use.
### :param at: The bit position.
### :returns: The 64 bits of a big natural from bit `at` up (0 outside it).
routine dec_bignat_bits(b: @BigNat[800], count: U64, at: S64) -> U64
    local limb: S64 = at >> 6
    local off: U64 = (at & 63).to[U64]()

    low: U64 = dec_bignat_limb(b, count, i: limb)
    high: U64 = dec_bignat_limb(b, count, i: limb + 1)
    if off == 0
        return low
    return (low >> off) | (high << 64 - off)

### Limb i of a big natural (0 outside it).
### :param b: The big natural.
### :param count: How many limbs are in use.
### :param i: The index.
### :returns: Limb i of a big natural (0 outside it).
routine dec_bignat_limb(b: @BigNat[800], count: U64, i: S64) -> U64
    if i >= 0 and i < count.to[S64]()
        return b.limbs[i.to[U64]()]
    return 0

# ── pow, atan2 ────────────────────────────────────────────────────────────────────────────────────

### |x|^y = e^(y ln|x|), negated for a negative x and an odd integer y (finite x and y, x nonzero, the result not
### past the range: dec_pow settles those).
### :param x: The base.
### :param y: The exponent.
### :param n: The precision in limbs.
### :returns: |x|^y = e^(y ln|x|), negated for a negative x and an odd integer y (finite x and y, x nonzero, the result not past the range.
routine dec_eval_pow(x: Dec, y: Dec, n: U64) -> MpApprox
    l: MpApprox = dec_eval_ln(x: dec_num(neg: false, coeff: x.coeff, exp: x.exp), n)
    z: MpApprox = me_mul(a: me_of_dec(x: y, n), b: l, n)
    neg: Bool = x.neg and dec_is_odd_integer(y)
    return me_exp(x: z, n).with_sign(neg)

### The angle of (x, y) for finite nonzero x and y: atan(y/x), plus or minus pi for a negative x.
### :param y: The ordinate.
### :param x: The abscissa.
### :param n: The precision in limbs.
### :returns: The angle of (x, y) for finite nonzero x and y.
routine dec_eval_atan2(y: Dec, x: Dec, n: U64) -> MpApprox
    a: MpApprox = me_atan(x: me_div(a: me_of_dec(x: y, n), b: me_of_dec(x, n), n), n)
    if x.neg
        pi: MpApprox = me_const(i: DEC_PI, n).with_sign(y.neg)
        return me_add(a, b: pi, n)
    return a

# ── the special values ────────────────────────────────────────────────────────────────────────────

### fn(x) correctly rounded to f (fn one of the unary DEC_ codes): the special values first, as RazorForge's
### engines gave them, then dec_ziv.
### :param fn: Which function (a DEC_ code).
### :param x: The operand.
### :param f: The format the result rounds to.
### :returns: fn(x) correctly rounded to f (fn one of the unary DEC_ codes).
routine dec_unary(fn: U32, x: Dec, f: DecFormat) -> Dec
    local zero: Bool = x.is_zero()
    local is_inf: Bool = x.is_inf()
    local one: Dec = dec_num(neg: false, coeff: 1, exp: 0)

    when
        x.is_nan() => return dec_nan()
        fn <= 3 =>
            # exp, expm1, exp2, exp10: past the range an infinity, 0, or -1 for expm1
            limit: U128 = dec_exponential_limit(fn)
            far: Bool = is_inf or dec_compare_abs(x, c: limit, q: 0) > 0
            m1: Bool = fn == DEC_EXPM1
            when
                zero and m1 => return x.as_result()
                zero => return one
                far =>
                    when
                        not x.neg => return dec_inf(false)
                        m1 => return dec_num(neg: true, coeff: 1, exp: 0)
                        is_inf => return dec_num(neg: false, coeff: 0, exp: 0)
                        else => return dec_num(neg: false, coeff: 0, exp: f.qmin)
                m1 and x.neg and (dec_compare_abs(x, c: 100, q: 0) > 0) => return dec_num(neg: true,
                    coeff: 1, exp: 0)
                else => return dec_ziv(fn, x, y: x, f)
        fn <= 7 =>
            # log, log1p, log2, log10
            if fn == DEC_LOG1P
                below: Bool = x.neg and (dec_compare_abs(x, c: 1, q: 0) > 0)
                at_one: Bool = x.neg and (dec_compare_abs(x, c: 1, q: 0) == 0)
                when
                    below or (is_inf and x.neg) => return dec_nan()
                    at_one => return dec_inf(true)
                    zero or (is_inf and not x.neg) => return x.as_result()
                    else => return dec_ziv(fn, x, y: x, f)
            else
                negative: Bool = x.neg and not zero
                when
                    negative => return dec_nan()
                    zero => return dec_inf(true)
                    is_inf => return x.as_result()
                    not x.neg and (dec_compare_abs(x, c: 1, q: 0) == 0) => return dec_num(
                        neg: false, coeff: 0, exp: 0)
                    else => return dec_ziv(fn, x, y: x, f)
        fn <= 10 =>
            # asin, acos, atan
            outside: Bool = is_inf or dec_compare_abs(x, c: 1, q: 0) > 0
            unit: Bool = not x.neg and (dec_compare_abs(x, c: 1, q: 0) == 0)
            acos: Bool = fn == DEC_ACOS
            when
                fn == DEC_ATAN and zero => return x.as_result()
                fn == DEC_ATAN => return dec_ziv(fn, x, y: x, f)
                outside => return dec_nan()
                acos and unit => return dec_num(neg: false, coeff: 0, exp: 0)
                acos => return dec_ziv(fn, x, y: x, f)
                zero => return x.as_result()
                else => return dec_ziv(fn, x, y: x, f)
        fn <= 16 =>
            # sinh, cosh, tanh, asinh, acosh, atanh
            when fn
                11 =>
                    when
                        zero or is_inf => return x.as_result()
                        dec_compare_abs(x, c: 15000, q: 0) > 0 => return dec_inf(x.neg)
                        else => return dec_ziv(fn, x, y: x, f)
                12 =>
                    if is_inf or dec_compare_abs(x, c: 15000, q: 0) > 0
                        return dec_inf(false)
                    return dec_ziv(fn, x, y: x, f)
                13 =>
                    when
                        zero => return x.as_result()
                        is_inf or dec_compare_abs(x, c: 100,
                            q: 0) > 0 => return dec_num(neg: x.neg, coeff: 1, exp: 0)
                        else => return dec_ziv(fn, x, y: x, f)
                14 =>
                    if zero or is_inf
                        return x.as_result()
                    return dec_ziv(fn, x, y: x, f)
                15 =>
                    below: Bool = x.neg or (not is_inf and dec_compare_abs(x, c: 1, q: 0) < 0)
                    when
                        below => return dec_nan()
                        is_inf => return x.as_result()
                        dec_compare_abs(x, c: 1,
                            q: 0) == 0 => return dec_num(neg: false, coeff: 0, exp: 0)
                        else => return dec_ziv(fn, x, y: x, f)
                else =>
                    outside: Bool = is_inf or dec_compare_abs(x, c: 1, q: 0) > 0
                    when
                        outside => return dec_nan()
                        dec_compare_abs(x, c: 1, q: 0) == 0 => return dec_inf(x.neg)
                        zero => return x.as_result()
                        else => return dec_ziv(fn, x, y: x, f)
        fn <= 18 =>
            # erf, erfc
            beyond: Bool = is_inf or dec_compare_abs(x, c: 20, q: 0) > 0
            tail: Bool = is_inf or dec_compare_abs(x, c: 130, q: 0) > 0
            if fn == DEC_ERF
                when
                    zero => return x.as_result()
                    beyond => return dec_num(neg: x.neg, coeff: 1, exp: 0)
                    else => return dec_ziv(fn, x, y: x, f)
            else
                when
                    x.neg and beyond => return dec_num(neg: false, coeff: 2, exp: 0)
                    is_inf and not x.neg => return dec_num(neg: false, coeff: 0, exp: 0)
                    not x.neg and tail => return dec_num(neg: false, coeff: 0, exp: f.qmin)
                    else => return dec_ziv(fn, x, y: x, f)
        fn <= 20 =>
            # tgamma, lgamma
            tg: Bool = fn == DEC_TGAMMA
            pole: Bool = x.neg and dec_is_integer(x)
            when
                (is_inf and tg) and x.neg => return dec_nan()
                is_inf => return dec_inf(false)
                zero and tg => return dec_inf(x.neg)
                zero => return dec_inf(false)
                pole and tg => return dec_nan()
                pole => return dec_inf(false)
                tg =>
                    over: Bool = not x.neg and (dec_compare_abs(x, c: 3300, q: 0) > 0)
                    when
                        over => return dec_inf(false)
                        x.neg and (dec_compare_abs(x, c: 3300, q: 0) > 0) => return dec_gamma_underflow(
                            x, f)
                        else => return dec_ziv(fn, x, y: x, f)
                else =>
                    if not x.neg and (dec_compare_abs(x, c: 1, q: 0) == 0 or dec_compare_abs(x, c: 2, q: 0) == 0)
                        return dec_num(neg: false, coeff: 0, exp: 0)
                    return dec_ziv(fn, x, y: x, f)
        fn <= 23 =>
            # sin, cos, tan
            when
                is_inf => return dec_nan()
                zero and fn == DEC_COS => return one
                zero => return x.as_result()
                else => return dec_ziv(fn, x, y: x, f)
        else =>
            if zero or is_inf
                return x
            return dec_ziv(fn, x, y: x, f)

### Past this size exp (0), expm1 (1), exp2 (2), or exp10 (3) is settled by its sign alone.
### :param fn: The function: DEC_EXP, DEC_EXPM1, DEC_EXP2, or DEC_EXP10.
### :returns: Past this size exp (0), expm1 (1), exp2 (2), or exp10 (3) is settled by its sign alone.
routine dec_exponential_limit(fn: U32) -> U128
    when fn
        2 => return 22000
        3 => return 6300
        else => return 15000

### The zero Γ(x) underflows to for x below -3300 (at the format's smallest exponent), signed as sin(pi x): (-1)^k
### times the sign of x - k, k the integer nearest x.
### :param x: The operand.
### :param f: The format.
### :returns: The signed zero.
routine dec_gamma_underflow(x: Dec, f: DecFormat) -> Dec
    k: Dec = dec_round_int(x, mode: 3, f: dec_format128())
    rd: Dec = dec_add(a: x, b: k.negate(), f: dec_format128())
    odd: Bool = dec_is_odd_integer(k)
    return dec_num(neg: rd.neg != odd, coeff: 0, exp: f.qmin)

### x^y correctly rounded to f, with C99's special cases.
### :param x: The base.
### :param y: The exponent.
### :param f: The format the result rounds to.
### :returns: x^y correctly rounded to f, with C99's special cases.
routine dec_pow(x: Dec, y: Dec, f: DecFormat) -> Dec
    local xnan: Bool = x.is_nan()
    local ynan: Bool = y.is_nan()
    local xinf: Bool = x.is_inf()
    local yinf: Bool = y.is_inf()
    local xzero: Bool = x.is_zero()
    local yzero: Bool = y.is_zero()
    local yfin: Bool = y.is_finite()
    local yint: Bool = yfin and dec_is_integer(y)
    local yodd: Bool = yint and dec_is_odd_integer(y)
    local xfin: Bool = x.is_finite()
    local xone: Bool = xfin and not x.neg and (dec_compare_abs(x, c: 1, q: 0) == 0)
    local xmone: Bool = xfin and x.neg and (dec_compare_abs(x, c: 1, q: 0) == 0)
    local one: Dec = dec_num(neg: false, coeff: 1, exp: 0)

    when
        x.neg and not xnan and not xinf and not xzero and yfin and not yint => return dec_nan()
        xone or yzero => return one
        xnan or ynan => return dec_nan()
        xzero =>
            positive: Bool = not y.neg
            when
                positive and yodd => return x.as_result()
                positive => return dec_num(neg: false, coeff: 0, exp: 0)
                yodd => return dec_inf(x.neg)
                else => return dec_inf(false)
        yinf =>
            inside: Bool = xfin and dec_compare_abs(x, c: 1, q: 0) < 0
            when
                xmone => return one
                y.neg and inside => return dec_inf(false)
                y.neg => return dec_num(neg: false, coeff: 0, exp: 0)
                inside => return dec_num(neg: false, coeff: 0, exp: 0)
                else => return dec_inf(false)
        xinf =>
            when
                x.neg and y.neg and yodd => return dec_num(neg: true, coeff: 0, exp: 0)
                x.neg and y.neg => return dec_num(neg: false, coeff: 0, exp: 0)
                x.neg and yodd => return dec_inf(true)
                x.neg => return dec_inf(false)
                y.neg => return dec_num(neg: false, coeff: 0, exp: 0)
                else => return dec_inf(false)
        else =>
            # e^z with z = y ln|x|: far past the range the result is an infinity or a zero
            z: B64 = dec_pow_size(x, y)
            rneg: Bool = x.neg and yodd
            when
                z > 16000.0 => return dec_inf(rneg)
                z < -16000.0 => return dec_num(neg: rneg, coeff: 0, exp: f.qmin)
                else => return dec_ziv(fn: DEC_POW, x, y, f)

### y ln|x| in B64, for dec_pow's test against ±16000 (e^15000 is past every format's range both ways, so an error
### of far less than 1000 there is harmless): ln|x| within 1/2 of 1 is ln_1p of x - 1, exact in decimal (a relative
### error near 2^-52 however close x is to 1), elsewhere ln of the coefficient plus the exponent times ln 10 (|ln|x||
### at least 0.4, the error near 2^-40 at worst); y is its coefficient times a power of ten, infinite past B64's range,
### where the product is then an infinity of the right sign.
### :param x: The base (finite, nonzero, not ±1).
### :param y: The exponent (finite, nonzero).
### :returns: y ln|x| in B64.
routine dec_pow_size(x: Dec, y: Dec) -> B64
    local ax: Dec = dec_num(neg: false, coeff: x.coeff, exp: x.exp)

    near: Bool = dec_compare_abs(x, c: 5, q: -1) > 0 and dec_compare_abs(x, c: 15, q: -1) < 0
    l: B64 = when
        near =>
            t: Dec = dec_plus_int(x: ax, k: -1)
            tf: B64 = t.coeff.to[B64]() *! t.exp.to[B64]().exp10_unchecked()
            st: B64 = when
                t.neg => -tf
                else => tf
            becomes st.ln_1p_unchecked()
        else =>
            lc: B64 = ax.coeff.to[B64]().ln_unchecked()
            becomes lc +! x.exp.to[B64]() *! 2.302585092994046
    yf: B64 = y.coeff.to[B64]() *! y.exp.to[B64]().exp10_unchecked()
    sy: B64 = when
        y.neg => -yf
        else => yf
    return sy *! l

### atan2(y, x), the angle of (x, y) in (-pi, pi], correctly rounded to f, with C99's special cases.
### :param y: The ordinate.
### :param x: The abscissa.
### :param f: The format the result rounds to.
### :returns: atan2(y, x), the angle of (x, y) in (-pi, pi], correctly rounded to f, with C99's special cases.
routine dec_atan2(y: Dec, x: Dec, f: DecFormat) -> Dec
    when
        y.is_nan() or x.is_nan() => return dec_nan()
        y.is_zero() =>
            if x.neg
                return dec_signed_pi(neg: y.neg, which: 1, f)
            return dec_num(neg: y.neg, coeff: 0, exp: 0)
        x.is_zero() => return dec_ziv(fn: DEC_ATAN, x: dec_inf(y.neg), y: dec_inf(y.neg), f)
        y.is_inf() =>
            when
                x.is_inf() and x.neg => return dec_signed_pi(neg: y.neg, which: 3, f)
                x.is_inf() => return dec_signed_pi(neg: y.neg, which: 2, f)
                else => return dec_ziv(fn: DEC_ATAN, x: dec_inf(y.neg), y: dec_inf(y.neg), f)
        x.is_inf() =>
            if x.neg
                return dec_signed_pi(neg: y.neg, which: 1, f)
            return dec_num(neg: y.neg, coeff: 0, exp: 0)
        else => return dec_ziv(fn: DEC_ATAN2, x: y, y: x, f)

### pi (which 1), pi/4 (2), or 3 pi/4 (3), with a sign, rounded to f: the arctangent of an infinity, of 1, of -1,
### turned.
### :param neg: Whether the result is negative.
### :param which: 1 for pi, 2 for pi/4, 3 for 3 pi/4.
### :param f: The format the result rounds to.
### :returns: pi (which 1), pi/4 (2), or 3 pi/4 (3), with a sign, rounded to f.
routine dec_signed_pi(neg: Bool, which: U64, f: DecFormat) -> Dec
    unit: Dec = dec_num(neg, coeff: 1, exp: 0)
    when which
        1 => return dec_ziv(fn: DEC_ATAN2, x: dec_num(neg, coeff: 0, exp: 0),
            y: dec_num(neg: true, coeff: 1, exp: 0), f)
        2 => return dec_ziv(fn: DEC_ATAN, x: unit, y: unit, f)
        else => return dec_ziv(fn: DEC_ATAN2, x: unit, y: dec_num(neg: true, coeff: 1, exp: 0), f)

### The value as a function result: a zero reduced to exponent 0 (its sign kept), anything else as it is.
### :returns: The value as a function result.
routine Dec.as_result() -> Me
    if me.is_zero()
        return dec_num(neg: me.neg, coeff: 0, exp: 0)
    return me

### How far z must move up to reach the Stirling floor, as a whole number of steps.
### :param floor: The Stirling floor.
### :param zf: z as a B64.
### :returns: The steps.
routine dec_gamma_shift(floor: B64, zf: B64) -> U64
    gap: B64 = floor -! zf.min(floor)
    return gap.floor().to[U64]() + 1

### What the integer part N of a band on the midpoint N + 1/2 moves by under a tie rule (dec_round_me).
### :param tie_rule: 1 half to even, 2 up, 3 down.
### :param int: N.
### :returns: 1 to round up, 0 to round down.
routine dec_tie_step(tie_rule: U8, int: U128) -> U128
    when tie_rule
        2 => return 1
        3 => return 0
        else => return int & 1

### How fn settles a band that 1024 bits leave on a midpoint. A transcendental value of a decimal is never exactly a
### midpoint, but f(x) = x (1 + t) with t below 2^-1000 is that close to x, and x is a midpoint when its coefficient
### has one digit too many (a non-canonical encoding read at its face value): then the side is t's, whose sign each
### function knows (2 rounds the magnitude up, 3 down). Every other band on a midpoint is taken to be exactly on it
### (x^y and 2^x can be): 1, half to even.
### :param fn: Which function (a DEC_ code).
### :param x: The argument.
### :returns: The tie rule.
routine dec_tie_rule(fn: U32, x: Dec) -> U8
    local tiny: Bool = dec_digits(x.coeff) + x.exp < -150

    if tiny
        when fn
            8, 11, 16, 23 => return 2
            10, 13, 14, 21 => return 3
            1 =>
                # expm1 x = x + x^2/2 + ... lies above x, log1p x = x - x^2/2 + ... below it
                if not x.neg
                    return 2
                return 3
            5 =>
                if x.neg
                    return 2
                return 3
            else => return 1
    else
        return 1
