# A 192-bit binary float with a bound on its error (W, We), for the decimal transcendentals' fast multiprecision
# attempt (dec_trans_wide.te): the arithmetic of dec_mp.te at three limbs, written out limb by limb so that a
# value is five words instead of an array of twenty. Every operation truncates exactly as Mp's does at n = 3 (a
# product or sum taken exactly, or with what drops below one guard limb, then cut to 192 bits), so the error bounds
# of dec_mp.te (in units of 2^-192 of the value) carry over unchanged.

### The exponent of zero, far below every other.
preset W_ZERO_EXP: S64 = -1125899906842624

### A binary float of 192 bits: (-1)^neg × (h 2^128 + m 2^64 + l) × 2^(exp - 192), the top bit of h set, so
### 2^(exp - 1) <= |x| < 2^exp; zero has every limb 0 and the exponent W_ZERO_EXP.
record W
    neg: Bool
    exp: S64
    h: U64
    m: U64
    l: U64

### A W and a bound on its error: the value it stands for is within err × 2^-192 × |v| of v.
record We
    v: W
    err: B64

### Five limbs of an exact intermediate sum or product, least significant last.
record WLimbs
    l4: U64
    l3: U64
    l2: U64
    l1: U64
    l0: U64

# ── making one ────────────────────────────────────────────────────────────────────────────────────

### Zero.
### :returns: The zero W.
@inline
routine w_zero() -> W
    return (neg: false, exp: W_ZERO_EXP, h: 0, m: 0, l: 0)

### Whether the value is zero.
### :returns: Whether the value is zero.
@inline
routine W.is_zero() -> Bool
    return me.h == 0

### The value with its sign flipped.
### :returns: -me.
@inline
routine W.negate() -> Me
    return (neg: not me.neg, exp: me.exp, h: me.h, m: me.m, l: me.l)

### The value without its sign.
### :returns: |me|.
@inline
routine W.magnitude() -> Me
    return (neg: false, exp: me.exp, h: me.h, m: me.m, l: me.l)

### The value with a given sign.
### :param neg: Whether it is negative.
### :returns: The signed value.
@inline
routine W.with_sign(neg: Bool) -> Me
    return (neg: neg, exp: me.exp, h: me.h, m: me.m, l: me.l)

### me × 2^k (exact).
### :param k: The power of two.
### :returns: me × 2^k.
@inline
routine W.ldexp(k: S64) -> Me
    if me.is_zero()
        return me
    return (neg: me.neg, exp: me.exp + k, h: me.h, m: me.m, l: me.l)

### v × 2^scale exactly.
### :param v: The integer.
### :param scale: The power of two it is scaled by.
### :returns: v × 2^scale.
routine w_of_u128(v: U128, scale: S64) -> W
    if v == 0
        return w_zero()
    lz: U128 = v.leading_zeros()
    top: U128 = v << lz
    e: S64 = scale + 128 - lz.to[S64]()
    return (neg: false, exp: e, h: (top >> 64).to_wrap[U64](), m: top.to_wrap[U64](), l: 0)

### A B64 exactly (finite).
### :param x: The float.
### :returns: x as a W.
routine w_of_b64(x: B64) -> W
    local bits: U64 = x.bits()
    local biased: S64 = ((bits >> 52) & 0x7FF).to[S64]()

    frac: U64 = bits & 0xFFFFFFFFFFFFF
    hidden: U64 = when
        biased != 0 => 0x10000000000000
        else => 0
    e: S64 = biased.max(1) - 1075
    w: W = w_of_u128(v: (frac | hidden).to[U128](), scale: e)
    return w.with_sign(bits >> 63 == 1)

### A B128 exactly (finite).
### :param x: The float.
### :returns: x as a W.
routine w_of_b128(x: B128) -> W
    local bits: U128 = x.bits()
    local biased: S64 = ((bits >> 112) & 0x7FFF).to_wrap[S64]()

    frac: U128 = bits & U128.shift_left(1, 112) - 1
    hidden: U128 = when
        biased != 0 => U128.shift_left(1, 112)
        else => 0
    e: S64 = biased.max(1) - 16495
    w: W = w_of_u128(v: frac | hidden, scale: e)
    return w.with_sign(bits >> 127 == 1)

### The value as a B64 times 2^-exp, in [0.5, 1) (0 for zero), signed: the top 53 bits.
### :returns: The scaled top bits.
routine W.top_b64() -> B64
    frac: B64 = (me.h >> 11).to[B64]() *! b64_pow2(-53)
    if me.neg
        return -frac
    return frac

### The value as a B64 (0 or an infinity outside B64's range).
### :returns: The value as a B64.
routine W.to_b64() -> B64
    when
        me.is_zero() => return 0.0
        me.exp > 1023 =>
            if me.neg
                return B64.from_bits(0xFFF0000000000000)
            return B64.from_bits(0x7FF0000000000000)
        me.exp < -1000 => return 0.0
        else => return me.top_b64() *! b64_pow2(me.exp)

### The value rounded toward zero to a B128 (exponent within B128's normal range).
### :returns: The value as a B128.
routine W.to_b128() -> B128
    if me.is_zero()
        return B64.to[B128](0.0)
    # the top 113 bits: h's 64 and m's top 49
    mant: U128 = (me.h.to[U128]() << 49) | (me.m >> 15).to[U128]()
    frac: U128 = mant & U128.shift_left(1, 112) - 1
    biased: U128 = (me.exp + 16382).to[U128]()
    sign: U128 = me.neg.to[U128]() << 127
    return B128.from_bits(sign | (biased << 112) | frac)

# ── comparing ─────────────────────────────────────────────────────────────────────────────────────

### -1, 0, or 1 as |a| is below, equal to, or above |b|.
### :param a: The first operand.
### :param b: The second operand.
### :returns: -1, 0, or 1.
routine w_compare_magnitude(a: W, b: W) -> S32
    za: Bool = a.is_zero()
    zb: Bool = b.is_zero()
    when
        za and zb => return 0
        za => return -1
        zb => return 1
        a.exp < b.exp => return -1
        a.exp > b.exp => return 1
        a.h != b.h => return w_order(a.h < b.h)
        a.m != b.m => return w_order(a.m < b.m)
        a.l != b.l => return w_order(a.l < b.l)
        else => return 0

### The order of two limbs that differ: -1 when the first is below the second, else 1.
### :param less: Whether the first is below the second.
### :returns: -1 or 1.
@inline
routine w_order(less: Bool) -> S32
    if less
        return -1
    return 1

# ── packing ───────────────────────────────────────────────────────────────────────────────────────

### Limb i (0 the lowest) of a five-limb number, 0 outside it.
### :param i: The index.
### :returns: The limb.
@inline
routine WLimbs.limb(i: S64) -> U64
    when i
        0 => return me.l0
        1 => return me.l1
        2 => return me.l2
        3 => return me.l3
        4 => return me.l4
        else => return 0

### The 64 bits of a five-limb number starting at bit `at` (bits outside it read as 0).
### :param at: The lowest bit read.
### :returns: The 64 bits.
@inline
routine WLimbs.bits(at: S64) -> U64
    limb: S64 = at >> 6
    off: U64 = (at & 63).to[U64]()
    low: U64 = me.limb(limb)
    high: U64 = me.limb(limb + 1)
    return (low >> off) | (high << U64.sub(64, off))

### The five-limb number r × 2^scale as a W, its sign neg, truncated toward zero (what mp_pack gives).
### :param neg: The sign.
### :param r: The limbs.
### :param scale: The power of two the limbs are scaled by.
### :returns: The W.
routine w_pack(neg: Bool, r: WLimbs, scale: S64) -> W
    values: (S64, U64) = when
        r.l4 != 0 => (4, r.l4)
        r.l3 != 0 => (3, r.l3)
        r.l2 != 0 => (2, r.l2)
        r.l1 != 0 => (1, r.l1)
        r.l0 != 0 => (0, r.l0)
        else => return w_zero()
    t, limb = values
    bitlen: S64 = t * 64 + 64 - limb.leading_zeros().to[S64]()
    low: S64 = bitlen - 192
    h: U64 = r.bits(low + 128)
    m: U64 = r.bits(low + 64)
    l: U64 = r.bits(low)
    return (neg: neg, exp: scale + bitlen, h: h, m: m, l: l)

# ── arithmetic ────────────────────────────────────────────────────────────────────────────────────

### x y + p + q, below 2^128 for limbs x, y, p, q.
### :param x: A factor.
### :param y: A factor.
### :param p: An addend.
### :param q: An addend.
### :returns: The sum.
@inline
routine w_fma(x: U64, y: U64, p: U64, q: U64) -> U128
    t: U128 = x.mul_wide(y) +% p.to[U128]()
    return t +% q.to[U128]()

### a × b truncated to 192 bits: the six-limb product exactly, then its top three limbs after normalizing (both
### mantissas have their top bit set, so the product's top limb has bit 63 or bit 62 set).
### :param a: The first operand.
### :param b: The second operand.
### :returns: a × b.
routine w_mul(a: W, b: W) -> W
    if a.is_zero() or b.is_zero()
        return w_zero()
    # row by row: r_i accumulates column i
    x0: U128 = a.l.mul_wide(b.l)
    x1: U128 = w_fma(x: a.l, y: b.m, p: (x0 >> 64).to_wrap[U64](), q: 0)
    x2: U128 = w_fma(x: a.l, y: b.h, p: (x1 >> 64).to_wrap[U64](), q: 0)
    y1: U128 = w_fma(x: a.m, y: b.l, p: x1.to_wrap[U64](), q: 0)
    y2: U128 = w_fma(x: a.m, y: b.m, p: x2.to_wrap[U64](), q: (y1 >> 64).to_wrap[U64]())
    y3: U128 = w_fma(x: a.m, y: b.h, p: (x2 >> 64).to_wrap[U64](), q: (y2 >> 64).to_wrap[U64]())
    z2: U128 = w_fma(x: a.h, y: b.l, p: y2.to_wrap[U64](), q: 0)
    z3: U128 = w_fma(x: a.h, y: b.m, p: y3.to_wrap[U64](), q: (z2 >> 64).to_wrap[U64]())
    z4: U128 = w_fma(x: a.h, y: b.h, p: (y3 >> 64).to_wrap[U64](), q: (z3 >> 64).to_wrap[U64]())
    r5: U64 = (z4 >> 64).to_wrap[U64]()
    r4: U64 = z4.to_wrap[U64]()
    r3: U64 = z3.to_wrap[U64]()
    r2: U64 = z2.to_wrap[U64]()
    e: S64 = a.exp + b.exp
    neg: Bool = a.neg != b.neg
    if r5 >> 63 == 1
        return (neg: neg, exp: e, h: r5, m: r4, l: r3)
    h: U64 = (r5 << 1) | (r4 >> 63)
    m: U64 = (r4 << 1) | (r3 >> 63)
    l: U64 = (r3 << 1) | (r2 >> 63)
    return (neg: neg, exp: e - 1, h: h, m: m, l: l)

### a × k for a nonzero k: four limbs exactly, then packed.
### :param a: The operand.
### :param k: The multiplier.
### :returns: a × k.
routine w_mul_u64(a: W, k: U64) -> W
    if a.is_zero()
        return a
    x0: U128 = a.l.mul_wide(k)
    x1: U128 = w_fma(x: a.m, y: k, p: (x0 >> 64).to_wrap[U64](), q: 0)
    x2: U128 = w_fma(x: a.h, y: k, p: (x1 >> 64).to_wrap[U64](), q: 0)
    r: WLimbs = (l4: 0, l3: (x2 >> 64).to_wrap[U64](), l2: x2.to_wrap[U64](), l1: x1.to_wrap[U64](), l0: x0.to_wrap[U64]())
    return w_pack(neg: a.neg, r, scale: a.exp - 192)

### a / k for a nonzero k: the quotient of a's mantissa × 2^64 by k (four limbs), packed. The dividend is shifted with
### the divisor until the divisor's top bit is set, so each limb is one 2-by-1 division.
### :param a: The operand.
### :param k: The divisor.
### :returns: a / k.
routine w_div_u64(a: W, k: U64) -> W
    local shift: U64 = k.leading_zeros().to[U64]()
    local back: U64 = U64.sub(64, shift)
    local d: U64 = k << shift
    local v: U64 = div_2by1_prepare(d)

    if a.is_zero()
        return a
    # the shifted dividend's limbs, top first: h >> (64 - shift), then each limb's low part with the next one's top
    u3: U64 = (a.h << shift) | (a.m >> back)
    u2: U64 = (a.m << shift) | (a.l >> back)
    u1: U64 = a.l << shift
    q3: Div2By1 = div_2by1(u1: a.h >> back, u0: u3, d, v)
    q2: Div2By1 = div_2by1(u1: q3.remainder, u0: u2, d, v)
    q1: Div2By1 = div_2by1(u1: q2.remainder, u0: u1, d, v)
    q0: Div2By1 = div_2by1(u1: q1.remainder, u0: 0, d, v)
    r: WLimbs = (l4: 0, l3: q3.quotient, l2: q2.quotient, l1: q1.quotient, l0: q0.quotient)
    return w_pack(neg: a.neg, r, scale: a.exp - 256)

### The magnitude of x aligned d bits below a guard limb: x's mantissa × 2^64 shifted right by d, as four limbs
### (bits below them dropped).
### :param x: The operand.
### :param d: The shift (0 or more).
### :returns: The limbs, the lowest in l0 (l4 is 0).
routine w_align(x: W, d: S64) -> WLimbs
    src: WLimbs = (l4: 0, l3: x.h, l2: x.m, l1: x.l, l0: 0)
    a3: U64 = src.bits(d + 192)
    a2: U64 = src.bits(d + 128)
    a1: U64 = src.bits(d + 64)
    a0: U64 = src.bits(d)
    return (l4: 0, l3: a3, l2: a2, l1: a1, l0: a0)

### a + b (signed), truncated: aligned under one guard limb, so what drops off the smaller one lies below the guard
### (mp_add at three limbs).
### :param a: The first operand.
### :param b: The second operand.
### :returns: a + b.
routine w_add(a: W, b: W) -> W
    when
        a.is_zero() => return b
        b.is_zero() => return a
        else =>
            a_big: Bool = w_compare_magnitude(a, b) >= 0
            big: W = when
                a_big => a
                else => b
            small: W = when
                a_big => b
                else => a
            s: WLimbs = w_align(x: small, d: big.exp - small.exp)
            if big.neg == small.neg
                x1: U128 = big.l.to[U128]() +% s.l1.to[U128]()
                x2: U128 = w_fma(x: big.m, y: 1, p: s.l2, q: (x1 >> 64).to_wrap[U64]())
                x3: U128 = w_fma(x: big.h, y: 1, p: s.l3, q: (x2 >> 64).to_wrap[U64]())
                r: WLimbs = (l4: (x3 >> 64).to_wrap[U64](), l3: x3.to_wrap[U64](), l2: x2.to_wrap[U64](), l1: x1.to_wrap[U64](), l0: s.l0)
                return w_pack(neg: big.neg, r, scale: big.exp - 256)
            # big's guard limb is 0, so limb 0 of the difference is -s0 with a borrow when s0 is not 0
            d0: U64 = U64.sub_wrap(0, s.l0)
            b0: U64 = (s.l0 != 0).to[U64]()
            d1: U64 = big.l -% s.l1 -% b0
            b1: U64 = w_borrow(x: big.l, y: s.l1, borrow: b0)
            d2: U64 = big.m -% s.l2 -% b1
            b2: U64 = w_borrow(x: big.m, y: s.l2, borrow: b1)
            d3: U64 = big.h -% s.l3 -% b2
            r: WLimbs = (l4: 0, l3: d3, l2: d2, l1: d1, l0: d0)
            return w_pack(neg: big.neg, r, scale: big.exp - 256)

### Whether x - y - borrow needs a borrow from the next limb.
### :param x: The minuend limb.
### :param y: The subtrahend limb.
### :param borrow: The incoming borrow (0 or 1).
### :returns: 1 when it borrows.
@inline
routine w_borrow(x: U64, y: U64, borrow: U64) -> U64
    under: Bool = x < y or (x == y and borrow == 1)
    return under.to[U64]()

### a - b.
### :param a: The minuend.
### :param b: The subtrahend.
### :returns: a - b.
@inline
routine w_sub(a: W, b: W) -> W
    return w_add(a, b: b.negate())

# ── values with error bounds ──────────────────────────────────────────────────────────────────────

### An exact value (its bound 0).
### :param v: The value.
### :returns: The value with a zero bound.
@inline
routine we_exact(v: W) -> We
    return (v: v, err: 0.0)

### The value with its sign flipped (the bound unchanged).
### :returns: -me.
@inline
routine We.negate() -> Me
    return (v: me.v.negate(), err: me.err)

### The value without its sign (the bound unchanged).
### :returns: |me|.
@inline
routine We.magnitude() -> Me
    return (v: me.v.with_sign(false), err: me.err)

### The magnitude with a given sign (the bound unchanged).
### :param neg: Whether it is negative.
### :returns: The signed value.
@inline
routine We.with_sign(neg: Bool) -> Me
    return (v: me.v.with_sign(neg), err: me.err)

### me × 2^k (exact, the bound unchanged).
### :param k: The power of two.
### :returns: The scaled value.
@inline
routine We.ldexp(k: S64) -> Me
    return (v: me.v.ldexp(k), err: me.err)

### The bound widened by more units.
### :param more: The units to add.
### :returns: The bound widened by more units.
@inline
routine We.widen(more: B64) -> Me
    return (v: me.v, err: (me.err +! more) *! MP_UP)

### The relative error as a B64 (not in units): err × 2^-192, applied in two halves.
### :returns: The relative error.
routine We.relative() -> B64
    unit: B64 = b64_pow2(-96)
    return me.err *! unit *! unit

### a × b: the relative errors add (with their product) and the truncation adds 2.
### :param a: The first operand.
### :param b: The second operand.
### :returns: a × b.
routine we_mul(a: We, b: We) -> We
    v: W = w_mul(a: a.v, b: b.v)
    unit: B64 = b64_pow2(-192)
    cross: B64 = a.err *! b.err *! unit
    err: B64 = a.err +! b.err +! cross +! 2.0
    return (v: v, err: err *! MP_UP)

### a × k for a small exact k.
### :param a: The first operand.
### :param k: The multiplier (nonzero).
### :returns: a × k.
routine we_mul_u64(a: We, k: U64) -> We
    return (v: w_mul_u64(a: a.v, k), err: (a.err +! 2.0) *! MP_UP)

### a / k for a small exact k.
### :param a: The first operand.
### :param k: The divisor (nonzero).
### :returns: a / k.
routine we_div_u64(a: We, k: U64) -> We
    return (v: w_div_u64(a: a.v, k), err: (a.err +! 2.0) *! MP_UP)

### a + b: each operand's absolute error over the result's magnitude, what the alignment drops below the guard limb,
### and the truncation (me_add at three limbs).
### :param a: The first operand.
### :param b: The second operand.
### :returns: a + b.
routine we_add(a: We, b: We) -> We
    v: W = w_add(a: a.v, b: b.v)
    za: Bool = a.v.is_zero()
    zb: Bool = b.v.is_zero()
    zr: Bool = v.is_zero()
    when
        za => return b
        zb => return a
        zr and (a.err == 0.0 and b.err == 0.0 and a.v.exp == b.v.exp) => return (v: v, err: 0.0)
        zr => return (v: v, err: B64.from_bits(0x7FF0000000000000))
        else =>
            # each operand's error scaled by |operand| / |result|, bounded from the top 53 bits: |x| <= (t_x + 2^-53) 2^e_x
            # and |r| >= t_r 2^e_r, with t the top bits as a B64 in [1/2, 1)
            er: S64 = v.exp
            big: S64 = a.v.exp.max(b.v.exp)
            rt: B64 = v.top_b64().abs()
            from_a: B64 = a.err *! we_ratio(x: a.v, rt, er)
            from_b: B64 = b.err *! we_ratio(x: b.v, rt, er)
            dropped: B64 = b64_pow2(big - er - 63)
            err: B64 = from_a +! from_b +! dropped +! 2.0
            return (v: v, err: err *! MP_UP)

### An upper bound of |x| / |r| for a nonzero r whose top bits are rt (in [1/2, 1)) and exponent er.
### :param x: The operand.
### :param rt: |r|'s top 53 bits as a B64.
### :param er: r's exponent.
### :returns: The bound.
routine we_ratio(x: W, rt: B64, er: S64) -> B64
    xt: B64 = x.top_b64().abs() +! b64_pow2(-53)
    return xt /! rt *! b64_pow2(x.exp - er) *! MP_UP

### a - b.
### :param a: The minuend.
### :param b: The subtrahend.
### :returns: The difference with its bound.
@inline
routine we_sub(a: We, b: We) -> We
    return we_add(a, b: b.negate())

### 1 / b for a nonzero b, by two Newton steps y + y (1 - b y) from a B64 start (50 bits, doubled twice past 200):
### within 16 units, plus b's own error (me_recip at three limbs).
### :param b: The divisor.
### :returns: 1 / b.
routine we_recip(b: We) -> We
    local one: W = w_of_u128(v: 1, scale: 0)
    local seed: B64 = 1.0 /! b.v.top_b64()

    # a zero divisor gives an unbounded result, which no rounding accepts
    if b.v.is_zero()
        return (v: one, err: B64.from_bits(0x7FF0000000000000))

    while k < 2 with y: W = w_of_b64(seed).ldexp(-b.v.exp), k: S64 = 0
        t: W = w_sub(a: one, b: w_mul(a: b.v, b: y))
        continue with y: w_add(a: y, b: w_mul(a: y, b: t)), k: k + 1
    then
        return (v: y, err: (b.err *! 1.001 +! 16.0) *! MP_UP)

### a / b.
### :param a: The dividend.
### :param b: The divisor.
### :returns: a / b.
routine we_div(a: We, b: We) -> We
    return we_mul(a, b: we_recip(b))

### sqrt(a) for a >= 0: z = 1/sqrt(a) by two Newton steps z + z (1 - a z^2) / 2 from a B64 start, then a z; a's
### error enters halved (me_sqrt at three limbs).
### :param a: The operand.
### :returns: sqrt(a).
routine we_sqrt(a: We) -> We
    local one: W = w_of_u128(v: 1, scale: 0)
    local half: S64 = a.v.exp >> 1

    if a.v.is_zero()
        return a
    t: B64 = a.v.top_b64() *! b64_pow2(a.v.exp - half * 2)
    seed: B64 = 1.0 /! t.sqrt_unchecked()

    while k < 2 with z: W = w_of_b64(seed).ldexp(-half), k: S64 = 0
        t2: W = w_sub(a: one, b: w_mul(a: a.v, b: w_mul(a: z, b: z)))
        dz: W = w_mul(a: z, b: t2).ldexp(-1)
        continue with z: w_add(a: z, b: dz), k: k + 1
    then
        return (v: w_mul(a: a.v, b: z), err: (a.err *! 0.5001 +! 24.0) *! MP_UP)

### An exact integer.
### :param v: The integer.
### :returns: It as a We.
routine we_of_u128(v: U128) -> We
    return we_exact(w_of_u128(v, scale: 0))

### An exact small integer, signed.
### :param k: The integer.
### :returns: It as a We.
routine we_int(k: S64) -> We
    m: We = we_of_u128(k.abs_diff(0).to[U128]())
    return m.with_sign(k < 0)

### Entry i of DEC_CONSTANTS at three limbs: its top limbs, within 3 units.
### :param i: Its index in DEC_CONSTANTS.
### :returns: The constant.
routine we_const(i: U64) -> We
    local at: U64 = i * 20 + 17

    l: U64 = DEC_CONSTANTS.getitem(at)
    m: U64 = DEC_CONSTANTS.getitem(at + 1)
    h: U64 = DEC_CONSTANTS.getitem(at + 2)
    e: S64 = DEC_CONSTANT_EXP.getitem(i)
    return (v: (neg: false, exp: e, h: h, m: m, l: l), err: 3.0)

### 10^k for k >= 0, by squaring (me_pow10 at three limbs).
### :param k: The power.
### :returns: 10^k.
routine we_pow10(k: S64) -> We
    local ten: We = we_of_u128(10)

    if k <= 38
        return we_of_u128(dec_p10_128(k))
    while true with result: We = we_of_u128(1), base: We = ten, left: S64 = k
        done: Bool = left == 0
        when
            done => return result
            left & 1 == 1 => continue with result: we_mul(a: result,
                b: base), base: we_mul(a: base, b: base), left: left >> 1
            else => continue with result: result, base: we_mul(a: base,
                b: base), left: left >> 1

### x × 10^k: within 380 places by 10^19 at a time, past that by the power of ten itself (me_scale10 at three limbs).
### :param x: The operand.
### :param k: The power of ten.
### :returns: x × 10^k.
routine we_scale10(x: We, k: S64) -> We
    near: Bool = k.abs() <= 380
    when
        k == 0 => return x
        near and k > 0 =>
            while left != 0 with v: We = x, left: S64 = k
                step: S64 = left.min(19)
                continue with v: we_mul_u64(a: v, k: dec_p10_64(step)), left: left - step
            then
                return v
        near =>
            while left != 0 with v: We = x, left: S64 = -k
                step: S64 = left.min(19)
                continue with v: we_div_u64(a: v, k: dec_p10_64(step)), left: left - step
            then
                return v
        k > 0 => return we_mul(a: x, b: we_pow10(k))
        else => return we_div(a: x, b: we_pow10(-k))

### The decimal x (finite) as a We.
### :param x: The operand.
### :returns: x.
routine we_of_dec(x: Dec) -> We
    if x.coeff == 0
        return we_exact(w_zero())
    r: We = we_scale10(x: we_of_u128(x.coeff), k: x.exp)
    return r.with_sign(x.neg)

### An MpApprox of three limbs as a We (the same value and bound).
### :param x: The value.
### :returns: It as a We.
routine we_of_me(x: MpApprox) -> We
    local s: @Mp <- x.v

    if x.v.is_zero(3)
        return (v: w_zero(), err: x.err)
    l: U64 = s.m[0]
    m: U64 = s.m[1]
    h: U64 = s.m[2]
    return (v: (neg: x.v.neg, exp: x.v.exp, h: h, m: m, l: l), err: x.err)

### A We as an MpApprox of three limbs (the same value and bound).
### :param x: The value.
### :returns: It as an MpApprox.
routine me_of_we(x: We) -> MpApprox
    local r: @Mp <- Mp.zero()

    if x.v.is_zero()
        return (v: r.peek(), err: x.err)
    r.m[0] = x.v.l
    r.m[1] = x.v.m
    r.m[2] = x.v.h
    x.v.neg.poke_into(r.neg)
    x.v.exp.poke_into(r.exp)
    return (v: r.peek(), err: x.err)

### The bound of s widened by an absolute error below 2^e (me_plus_abs at three limbs).
### :param s: The sum.
### :param e: The power of two that bounds the added error.
### :returns: s with the wider bound.
routine we_plus_abs(s: We, e: S64) -> We
    units: B64 = b64_pow2(e - s.v.exp + 1 + 192)
    if s.v.is_zero()
        return (v: s.v, err: B64.from_bits(0x7FF0000000000000))
    return s.widen(units)

### Whether a series term no longer matters: below 2^-200 of the sum (me_is_negligible at three limbs).
### :param term: The term.
### :param sum: The sum so far.
### :returns: Whether it is negligible.
routine we_is_negligible(term: We, sum: We) -> Bool
    tiny: Bool = term.v.exp < sum.v.exp - 200
    return term.v.is_zero() or tiny

# ── fixed point ───────────────────────────────────────────────────────────────────────────────────

### A fixed-point number of 192 bits: (h 2^128 + m 2^64 + l) × 2^-scale, the scale fixed by its use. Polynomials run
### in it: a product is cut at one fixed bit, a sum is exact, and the error of a whole evaluation is a few units of
### its last bit.
record X
    h: U64
    m: U64
    l: U64

### Six limbs of a fixed-point product, least significant last.
record XLimbs
    l5: U64
    l4: U64
    l3: U64
    l2: U64
    l1: U64
    l0: U64

### Limb i (0 the lowest) of a six-limb number, 0 outside it.
### :param i: The index.
### :returns: The limb.
@inline
routine XLimbs.limb(i: S64) -> U64
    when i
        0 => return me.l0
        1 => return me.l1
        2 => return me.l2
        3 => return me.l3
        4 => return me.l4
        5 => return me.l5
        else => return 0

### The 64 bits of a six-limb number starting at bit `at` (bits outside it read as 0).
### :param at: The lowest bit read.
### :returns: The 64 bits.
@inline
routine XLimbs.bits(at: S64) -> U64
    limb: S64 = at >> 6
    off: U64 = (at & 63).to[U64]()
    low: U64 = me.limb(limb)
    high: U64 = me.limb(limb + 1)
    return (low >> off) | (high << U64.sub(64, off))

### |r| × 2^scale as a fixed-point number, truncated (the caller keeps it below 2^192).
### :param r: The value.
### :param scale: The power of two it is multiplied by.
### :returns: The fixed-point number.
routine x_of_w(r: W, scale: S64) -> X
    shift: S64 = r.exp - 192 + scale
    src: WLimbs = (l4: 0, l3: 0, l2: r.h, l1: r.m, l0: r.l)
    h: U64 = src.bits(U64.to[S64](128) - shift)
    m: U64 = src.bits(U64.to[S64](64) - shift)
    l: U64 = src.bits(-shift)
    return (h: h, m: m, l: l)

### x × 2^-scale as a W (exact).
### :param x: The fixed-point number.
### :param scale: Its scale.
### :param neg: The sign.
### :returns: The W.
routine w_of_x(x: X, scale: S64, neg: Bool) -> W
    r: WLimbs = (l4: 0, l3: 0, l2: x.h, l1: x.m, l0: x.l)
    return w_pack(neg, r, scale: -scale)

### a + b (no carry out of 192 bits).
### :param a: The first term.
### :param b: The second term.
### :returns: The sum.
@inline
routine x_add(a: X, b: X) -> X
    x1: U128 = a.l.to[U128]() +% b.l.to[U128]()
    x2: U128 = w_fma(x: a.m, y: 1, p: b.m, q: (x1 >> 64).to_wrap[U64]())
    h: U64 = a.h +% b.h +% (x2 >> 64).to_wrap[U64]()
    return (h: h, m: x2.to_wrap[U64](), l: x1.to_wrap[U64]())

### a - b for a >= b.
### :param a: The minuend.
### :param b: The subtrahend.
### :returns: The difference.
@inline
routine x_sub(a: X, b: X) -> X
    l: U64 = a.l -% b.l
    b0: U64 = (a.l < b.l).to[U64]()
    m: U64 = a.m -% b.m -% b0
    b1: U64 = w_borrow(x: a.m, y: b.m, borrow: b0)
    h: U64 = a.h -% b.h -% b1
    return (h: h, m: m, l: l)

### The bits shift .. shift + 191 of a × b: the six-limb product exactly, then cut (truncated toward zero).
### :param a: The first factor.
### :param b: The second factor.
### :param shift: The lowest bit kept.
### :returns: The product.
@inline
routine x_mul_shift(a: X, b: X, shift: S64) -> X
    x0: U128 = a.l.mul_wide(b.l)
    x1: U128 = w_fma(x: a.l, y: b.m, p: (x0 >> 64).to_wrap[U64](), q: 0)
    x2: U128 = w_fma(x: a.l, y: b.h, p: (x1 >> 64).to_wrap[U64](), q: 0)
    y1: U128 = w_fma(x: a.m, y: b.l, p: x1.to_wrap[U64](), q: 0)
    y2: U128 = w_fma(x: a.m, y: b.m, p: x2.to_wrap[U64](), q: (y1 >> 64).to_wrap[U64]())
    y3: U128 = w_fma(x: a.m, y: b.h, p: (x2 >> 64).to_wrap[U64](), q: (y2 >> 64).to_wrap[U64]())
    z2: U128 = w_fma(x: a.h, y: b.l, p: y2.to_wrap[U64](), q: 0)
    z3: U128 = w_fma(x: a.h, y: b.m, p: y3.to_wrap[U64](), q: (z2 >> 64).to_wrap[U64]())
    z4: U128 = w_fma(x: a.h, y: b.h, p: (y3 >> 64).to_wrap[U64](), q: (z3 >> 64).to_wrap[U64]())
    r: XLimbs = (l5: (z4 >> 64).to_wrap[U64](), l4: z4.to_wrap[U64](), l3: z3.to_wrap[U64](), l2: z2.to_wrap[U64](), l1: y1.to_wrap[U64](), l0: x0.to_wrap[U64]())
    return (h: r.bits(shift + 128), m: r.bits(shift + 64), l: r.bits(shift))

### x × 2^k for 0 <= k < 64 (the caller keeps it below 2^192).
### :param x: The number.
### :param k: The shift.
### :returns: The shifted number.
@inline
routine x_shl(x: X, k: U64) -> X
    back: U64 = U64.sub(64, k)
    h: U64 = (x.h << k) | (x.m >> back)
    m: U64 = (x.m << k) | (x.l >> back)
    return (h: h, m: m, l: x.l << k)

### Entry i of a table of fixed-point numbers (three words each: h, m, l).
### :param table: The table.
### :param i: The index.
### :returns: The number.
@inline
routine x_entry(table: @U64, i: U64) -> X
    at: U64 = i * 3
    h: U64 = table.stride(at).peek()
    m: U64 = table.stride(at + 1).peek()
    l: U64 = table.stride(at + 2).peek()
    return (h: h, m: m, l: l)

### Entry i of a table of positive W values (four words each: h, m, l, and the exponent's bits), truncated from the
### true value: within 2 units.
### :param table: The table.
### :param i: The index.
### :returns: The value with its bound.
@inline
routine we_entry(table: @U64, i: U64) -> We
    at: U64 = i * 4
    h: U64 = table.stride(at).peek()
    m: U64 = table.stride(at + 1).peek()
    l: U64 = table.stride(at + 2).peek()
    e: S64 = table.stride(at + 3).peek().to_wrap[S64]()
    return (v: (neg: false, exp: e, h: h, m: m, l: l), err: 2.0)

### Whether a series term no longer matters at a precision of bits: below 2^-(bits + 8) of the sum.
### :param term: The term.
### :param sum: The sum so far.
### :param bits: The precision wanted.
### :returns: Whether it is negligible.
routine we_is_below(term: We, sum: We, bits: S64) -> Bool
    tiny: Bool = term.v.exp < sum.v.exp - bits - 8
    return term.v.is_zero() or tiny
