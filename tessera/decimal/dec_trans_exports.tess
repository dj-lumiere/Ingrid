    block entry()
        r : Dec = dec_unary(DEC_CBRT, dec_halves(x_low, x_high), dec_format128())
        return(r.words())

/// x^y, correctly rounded to 34 digits and reduced (C99's special cases).
/// :param x_low: The low 64 bits of x.
/// :param x_high: The high 64 bits of x.
/// :param y_low: The low 64 bits of y.
/// :param y_high: The high 64 bits of y.
/// :returns: x^y, correctly rounded to 34 digits and reduced (C99's special cases).
#export("ingrid_d128_pow")
routine ingrid_d128_pow(x_low: U64, x_high: U64, y_low: U64, y_high: U64) -> Words
    block entry()
        r : Dec = dec_pow(dec_halves(x_low, x_high), dec_halves(y_low, y_high), dec_format128())
        return(r.words())

/// The angle of (x, y) in (-pi, pi], correctly rounded to 34 digits and reduced.
/// :param y_low: The low 64 bits of y.
/// :param y_high: The high 64 bits of y.
/// :param x_low: The low 64 bits of x.
/// :param x_high: The high 64 bits of x.
/// :returns: The angle of (x, y) in (-pi, pi], correctly rounded to 34 digits and reduced.
#export("ingrid_d128_atan2")
routine ingrid_d128_atan2(y_low: U64, y_high: U64, x_low: U64, x_high: U64) -> Words
    block entry()
        r : Dec = dec_atan2(dec_halves(y_low, y_high), dec_halves(x_low, x_high), dec_format128())
        return(r.words())
