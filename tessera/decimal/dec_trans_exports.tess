        r : Dec = dec_unary(DEC_COS, dec_from32(x), dec_format32())
        return(r.to32())

/// The tangent, correctly rounded to 7 digits and reduced.
/// :param x: The operand.
/// :returns: The tangent, correctly rounded to 7 digits and reduced.
#export("ingrid_d32_tan")
routine ingrid_d32_tan(x: U32) -> U32
    block entry()
        r : Dec = dec_unary(DEC_TAN, dec_from32(x), dec_format32())
        return(r.to32())

/// The cube root, correctly rounded to 7 digits and reduced.
