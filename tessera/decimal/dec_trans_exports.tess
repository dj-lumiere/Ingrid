// ── D128: the transcendentals ──────────────────────────────────────────────────────────────────────────

/// e^x, correctly rounded to 34 digits and reduced.
/// :param x_low: The low 64 bits of x.
/// :param x_high: The high 64 bits of x.
/// :returns: e^x, correctly rounded to 34 digits and reduced.
#export("ingrid_d128_exp")
routine ingrid_d128_exp(x_low: U64, x_high: U64) -> Words
    block entry()
        r : Dec = dec_unary(DEC_EXP, dec_halves(x_low, x_high), dec_format128())
        return(r.words())

/// e^x - 1, correctly rounded to 34 digits and reduced.
/// :param x_low: The low 64 bits of x.
/// :param x_high: The high 64 bits of x.
/// :returns: e^x - 1, correctly rounded to 34 digits and reduced.
#export("ingrid_d128_expm1")
routine ingrid_d128_expm1(x_low: U64, x_high: U64) -> Words
    block entry()
        r : Dec = dec_unary(DEC_EXPM1, dec_halves(x_low, x_high), dec_format128())
        return(r.words())

/// 2^x, correctly rounded to 34 digits and reduced.
/// :param x_low: The low 64 bits of x.
/// :param x_high: The high 64 bits of x.
/// :returns: 2^x, correctly rounded to 34 digits and reduced.
#export("ingrid_d128_exp2")
routine ingrid_d128_exp2(x_low: U64, x_high: U64) -> Words
    block entry()
        r : Dec = dec_unary(DEC_EXP2, dec_halves(x_low, x_high), dec_format128())
        return(r.words())

/// 10^x, correctly rounded to 34 digits and reduced.
/// :param x_low: The low 64 bits of x.
/// :param x_high: The high 64 bits of x.
/// :returns: 10^x, correctly rounded to 34 digits and reduced.
#export("ingrid_d128_exp10")
routine ingrid_d128_exp10(x_low: U64, x_high: U64) -> Words
    block entry()
        r : Dec = dec_unary(DEC_EXP10, dec_halves(x_low, x_high), dec_format128())
        return(r.words())

/// The natural logarithm (NaN below 0, -infinity at 0), correctly rounded to 34 digits and reduced.
/// :param x_low: The low 64 bits of x.
/// :param x_high: The high 64 bits of x.
/// :returns: The natural logarithm (NaN below 0, -infinity at 0), correctly rounded to 34 digits and reduced.
#export("ingrid_d128_log")
routine ingrid_d128_log(x_low: U64, x_high: U64) -> Words
    block entry()
        r : Dec = dec_unary(DEC_LOG, dec_halves(x_low, x_high), dec_format128())
        return(r.words())

/// ln(1 + x), correctly rounded to 34 digits and reduced.
/// :param x_low: The low 64 bits of x.
/// :param x_high: The high 64 bits of x.
/// :returns: ln(1 + x), correctly rounded to 34 digits and reduced.
#export("ingrid_d128_log1p")
routine ingrid_d128_log1p(x_low: U64, x_high: U64) -> Words
    block entry()
        r : Dec = dec_unary(DEC_LOG1P, dec_halves(x_low, x_high), dec_format128())
        return(r.words())

/// The base-2 logarithm, correctly rounded to 34 digits and reduced.
/// :param x_low: The low 64 bits of x.
/// :param x_high: The high 64 bits of x.
/// :returns: The base-2 logarithm, correctly rounded to 34 digits and reduced.
#export("ingrid_d128_log2")
routine ingrid_d128_log2(x_low: U64, x_high: U64) -> Words
    block entry()
        r : Dec = dec_unary(DEC_LOG2, dec_halves(x_low, x_high), dec_format128())
        return(r.words())

