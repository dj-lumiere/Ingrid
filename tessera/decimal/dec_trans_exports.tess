// The decimal transcendentals RazorForge and Suflae call (dec_trans.tess), for D32, D64, and D128, each correctly
// rounded to its width and reduced. The C ABI is dec_exports.tess's: a D32 as a U32, a D64 as a U64, a D128 in as
// its low and high 64 bits and back in Words.

// ── D32: the transcendentals ───────────────────────────────────────────────────────────────────────────

/// e^x, correctly rounded to 7 digits and reduced.
/// :param x: The operand.
/// :returns: e^x, correctly rounded to 7 digits and reduced.
#export("ingrid_d32_exp")
routine ingrid_d32_exp(x: U32) -> U32
    block entry()
        r : Dec = dec_unary(DEC_EXP, dec_from32(x), dec_format32())
        return(r.to32())

/// e^x - 1, correctly rounded to 7 digits and reduced.
/// :param x: The operand.
/// :returns: e^x - 1, correctly rounded to 7 digits and reduced.
#export("ingrid_d32_expm1")
routine ingrid_d32_expm1(x: U32) -> U32
    block entry()
        r : Dec = dec_unary(DEC_EXPM1, dec_from32(x), dec_format32())
        return(r.to32())

/// 2^x, correctly rounded to 7 digits and reduced.
/// :param x: The operand.
/// :returns: 2^x, correctly rounded to 7 digits and reduced.
#export("ingrid_d32_exp2")
routine ingrid_d32_exp2(x: U32) -> U32
    block entry()
        r : Dec = dec_unary(DEC_EXP2, dec_from32(x), dec_format32())
        return(r.to32())

/// 10^x, correctly rounded to 7 digits and reduced.
/// :param x: The operand.
