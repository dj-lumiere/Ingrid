#export("ingrid_d32_exp10")
routine ingrid_d32_exp10(x: U32) -> U32
    block entry()
        r : Dec = dec_unary(DEC_EXP10, dec_from32(x), dec_format32())
        return(r.to32())

/// The natural logarithm (NaN below 0, -infinity at 0), correctly rounded to 7 digits and reduced.
/// :param x: The operand.
/// :returns: The natural logarithm (NaN below 0, -infinity at 0), correctly rounded to 7 digits and reduced.
#export("ingrid_d32_log")
routine ingrid_d32_log(x: U32) -> U32
    block entry()
        r : Dec = dec_unary(DEC_LOG, dec_from32(x), dec_format32())
        return(r.to32())

