/// The cube root, correctly rounded to 34 digits and reduced.
/// :param x_low: The low 64 bits of x.
/// :param x_high: The high 64 bits of x.
/// :returns: The cube root, correctly rounded to 34 digits and reduced.
#export("ingrid_d128_cbrt")
