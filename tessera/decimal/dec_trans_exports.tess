        return(r.to32())

/// x^y, correctly rounded to 7 digits and reduced (C99's special cases).
/// :param x: The base.
/// :param y: The exponent.
/// :returns: x^y, correctly rounded to 7 digits and reduced (C99's special cases).
#export("ingrid_d32_pow")
routine ingrid_d32_pow(x: U32, y: U32) -> U32
    block entry()
        r : Dec = dec_pow(dec_from32(x), dec_from32(y), dec_format32())
        return(r.to32())

/// The angle of (x, y) in (-pi, pi], correctly rounded to 7 digits and reduced.
/// :param y: The ordinate.
/// :param x: The abscissa.
/// :returns: The angle of (x, y) in (-pi, pi], correctly rounded to 7 digits and reduced.
#export("ingrid_d32_atan2")
routine ingrid_d32_atan2(y: U32, x: U32) -> U32
    block entry()
        r : Dec = dec_atan2(dec_from32(y), dec_from32(x), dec_format32())
        return(r.to32())

