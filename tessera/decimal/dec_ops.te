# The decimal operations past + - * /, on the engine of dec_core.te: the fused multiply-add, the square root,
# hypot, rounding to an integer, quantize, the remainders, the exponent operations, and the DPD interchange
# encoding. Each takes the format it rounds to, so one routine serves D32, D64, and D128 and rounds once.

module Ingrid/Decimal

# ── fused multiply-add ────────────────────────────────────────────────────────────────────────────

### a × b + c exactly up to a sticky digit, as (neg, coefficient, exponent, preferred exponent) for one rounding,
### the preferred exponent the smaller of the product's and c's: the addend with the larger exponent is scaled up to
### the other's while it stays within 75 digits; past that it is scaled to 75 digits and the other one floored to
### that exponent, what drops becoming a sticky digit appended below (a subtraction then takes one unit off first,
### the true value lying strictly between).
### :param a: The first operand.
### :param b: The second operand.
### :param c: The third operand.
### :returns: a × b + c exactly up to a sticky digit, as (neg, coefficient, exponent, preferred exponent) for one rounding, the preferred exponent the smaller of the product's and c's.
secret routine dec_mul_add_exact(a: Dec, b: Dec, c: Dec) -> DecExact
    pneg: Bool = a.neg != b.neg
    pc: U256 = a.coeff.mul_wide(b.coeff)
    pe: S64 = a.exp + b.exp
    cc: U256 = c.coeff.to[U256]()
    c_high: Bool = c.exp > pe
    h: DecExact = when

        c_high => DecExact(neg: c.neg, coeff: cc, exp: c.exp, pref: 0)
        else => DecExact(neg: pneg, coeff: pc, exp: pe, pref: 0)
    l: DecExact = when
        c_high => DecExact(neg: pneg, coeff: pc, exp: pe, pref: 0)
        else => DecExact(neg: c.neg, coeff: cc, exp: c.exp, pref: 0)

    when
        pc == 0 and cc == 0 =>
            # (+0) + (+0) and (-0) + (-0) keep their sign, mixed signs give +0
            e: S64 = pe.min(c.exp)
            return (neg: pneg and c.neg, coeff: 0, exp: e, pref: e)
        cc == 0 => return (neg: pneg, coeff: pc, exp: pe, pref: pe)
        pc == 0 => return (neg: c.neg, coeff: cc, exp: c.exp, pref: c.exp)
        else =>
            # h: the addend with the larger exponent, l: the other
            shift: S64 = h.exp - l.exp
            hd: S64 = dec_digits256(h.coeff)
            fits: Bool = hd + shift <= 75
            values2: (U256, U256, Bool, S64) = when
                fits => (h.coeff * dec_p10(shift), l.coeff, false, l.exp)
                else =>
                    k: S64 = 75 - hd
                    high: U256 = h.coeff * dec_p10(k)
                    dropped: S64 = shift - k
                    if dropped > 76
                        becomes (high, 0, l.coeff != 0, h.exp - k)
                    else
                        q: U256 = dec_div_p10_256(x: l.coeff, k: dropped)
                        becomes (high, q, q *% dec_p10(dropped) != l.coeff, h.exp - k)
            hc, lc, sticky, e = values2
            same: Bool = h.neg == l.neg
            down: Bool = hc >= lc
            values3: (U256, Bool, S64, Bool) = when
                same => (hc + lc, h.neg, l.exp, false)
                down => (hc - lc, h.neg, l.exp, true)
                else => (lc - hc, l.neg, l.exp, true)
            r, neg, pref, minus = values3
            when
                r == 0 and not sticky => return (neg: false, coeff: 0, exp: e, pref: pref)
                sticky =>
                    less: U256 = when
                        minus => r -% 1
                        else => r
                    return (neg: neg, coeff: less * 10 + 1, exp: e - 1, pref: pref)
                else => return (neg: neg, coeff: r, exp: e, pref: pref)

### a × b + c rounded once to f. An infinity or a NaN gives what IEEE 754 says: a NaN in, or an infinity times zero,
### or infinities of opposite sign meeting, gives a NaN.
### :param a: The first operand.
### :param b: The second operand.
### :param c: The third operand.
### :param f: The format the result rounds to.
### :returns: a × b + c rounded once to f.
secret routine dec_mul_add(a: Dec, b: Dec, c: Dec, f: DecFormat) -> Dec
    pneg: Bool = a.neg != b.neg

    is_nan: Bool = a.is_nan() or b.is_nan() or c.is_nan()
    when
        is_nan => return dec_nan()
        a.is_inf() or b.is_inf() =>
            times_zero: Bool = a.is_zero() or b.is_zero()
            when
                times_zero => return dec_nan()
                c.is_inf() and c.neg != pneg => return dec_nan()
                else => return dec_inf(pneg)
        c.is_inf() => return dec_inf(c.neg)
        else =>
            s: DecExact = dec_mul_add_exact(a, b, c)
            return dec_finish(value: s, f)

# ── square root, hypot ────────────────────────────────────────────────────────────────────────────

### A part of a sum: a value and whether something nonzero was cut off below it.
secret record DecTerm
    value: U256
    sticky: Bool

### sqrt(c × 10^q) of a finite positive x, correctly rounded to f's p digits and reduced: C = c × 10^t with q - t
### even and 2p - 1 or 2p digits has an integer square root s of p digits, and the root lies above s + 1/2 exactly
### when C - s^2 > s (it is never exactly halfway: (s + 1/2)^2 is not an integer).
### :param x: The operand.
### :param f: The format the result rounds to.
### :returns: sqrt(c × 10^q) of a finite positive x, correctly rounded to f's p digits and reduced.
secret routine dec_sqrt_positive(x: Dec, f: DecFormat) -> Dec
    p: S64 = f.digits

    t0: S64 = p * 2 - 1 - dec_digits(x.coeff)
    odd: Bool = x.exp - t0 & 1 == 1
    t: S64 = t0 + odd.to[S64]()
    cc: U256 = x.coeff.to[U256]() * dec_p10(t)
    s: U256 = cc.isqrt()
    up: Bool = cc - s * s > s

    # rounding up 99...9 gives 10^p
    s2: U256 = s + up.to[U64]().to[U256]()
    carry: Bool = s2 == dec_p10(p)
    root: U256 = when
        carry => dec_p10(p - 1)
        else => s2
    return dec_finish(
        value: DecExact(neg: false, coeff: root, exp: (x.exp - t >> 1) + carry.to[S64](), pref: f.qmax),
        f)

### The square root rounded to f: a NaN or a negative nonzero value gives a NaN, a zero or +infinity is itself.
### :param x: The operand.
### :param f: The format the result rounds to.
### :returns: The square root rounded to f.
secret routine dec_sqrt(x: Dec, f: DecFormat) -> Dec
    when
        x.is_nan() => return dec_nan()
        x.neg and not x.is_zero() => return dec_nan()
        x.is_inf() => return x
        x.is_zero() => return x
        else => return dec_sqrt_positive(x, f)

### sqrt(x^2 + y^2 + z^2) of finite values rounded to f and reduced (like every function result): the squares
### c^2 10^(2q) scaled to a common even exponent B where the largest has 2p + 2 or 2p + 3 digits (the smaller ones
### floored, a sticky digit for what drops), the integer square root s of their sum (its remainder into the sticky
### digit), and s × 10 + sticky, whose rounding to p digits is the correct one.
### :param x: The operand.
### :param y: The second operand.
### :param z: The third value.
### :param f: The format the result rounds to.
### :returns: sqrt(x^2 + y^2 + z^2) of finite values rounded to f and reduced (like every function result).
secret routine dec_hypot_finite(x: Dec, y: Dec, z: Dec, f: DecFormat) -> Dec
    lead: S64 = f.digits * 2 + 2

    tx: S64 = dec_square_top(x)
    ty: S64 = dec_square_top(y)
    tz: S64 = dec_square_top(z)
    top: S64 = tx.max(ty).max(tz)
    if top == S64.MIN
        return dec_num(neg: false, coeff: 0, exp: 0)
    b0: S64 = top - lead
    b: S64 = b0 - (b0 & 1)
    sx: DecTerm = dec_scaled_square(v: x, b)
    sy: DecTerm = dec_scaled_square(v: y, b)
    sz: DecTerm = dec_scaled_square(v: z, b)
    all: U256 = sx.value + sy.value + sz.value
    s: U256 = all.isqrt()
    rest: Bool = s * s != all
    st: Bool = sx.sticky or sy.sticky or sz.sticky or rest
    coef: U256 = s * 10 + st.to[U64]().to[U256]()
    r: Dec = dec_finish(value: DecExact(neg: false, coeff: coef, exp: (b >> 1) - 1, pref: f.qmax),
        f)
    return r.reduce(f)

### The decimal exponent of the top digit of c^2 10^(2q) plus one (its digits plus 2q), S64.MIN for a zero.
### :param v: The value.
### :returns: The decimal exponent of the top digit of c^2 10^(2q) plus one (its digits plus 2q), S64.MIN for a zero.
secret routine dec_square_top(v: Dec) -> S64
    if v.coeff == 0
        return S64.MIN
    sq: U256 = v.coeff.mul_wide(v.coeff)
    return dec_digits256(sq) + v.exp * 2

### c^2 10^(2q - b), floored, and whether the floor dropped anything.
### :param v: The value.
### :param b: The second operand.
### :returns: c^2 10^(2q - b), floored, and whether the floor dropped anything.
secret routine dec_scaled_square(v: Dec, b: S64) -> DecTerm
    sq: U256 = v.coeff.mul_wide(v.coeff)

    shift: S64 = v.exp * 2 - b
    when
        v.coeff == 0 => return (value: 0, sticky: false)
        shift >= 0 => return (value: sq * dec_p10(shift), sticky: false)
        shift >= -76 =>
            k: S64 = -shift
            q: U256 = dec_div_p10_256(x: sq, k)
            return (value: q, sticky: q *% dec_p10(k) != sq)
        else => return (value: 0, sticky: true)

### hypot of up to three values rounded to f: an infinity gives +infinity (before a NaN), a NaN a NaN.
### :param x: The operand.
### :param y: The second operand.
### :param z: The third value (0 for the two-argument hypot).
### :param f: The format the result rounds to.
### :returns: hypot of up to three values rounded to f.
secret routine dec_hypot(x: Dec, y: Dec, z: Dec, f: DecFormat) -> Dec
    is_inf: Bool = x.is_inf() or y.is_inf() or z.is_inf()
    when
        is_inf => return dec_inf(false)
        x.is_nan() or y.is_nan() or z.is_nan() => return dec_nan()
        else => return dec_hypot_finite(x, y, z, f)

# ── rounding to an integer, quantize ──────────────────────────────────────────────────────────────

### What dropping a value's fraction cut off, as the rounding modes read it.
secret record DecDroppedFraction
    ### Whether there was a fraction at all.
    rest: Bool
    ### Whether rounding to nearest with ties away moves the magnitude up.
    nearest: Bool
    ### Whether rounding to nearest with ties to even moves the magnitude up.
    even: Bool
    ### Whether rounding half up (a tie toward +infinity) moves the magnitude up.
    half_up: Bool

### Whether x comes back from round-to-integral unchanged: a special, a zero, or a value without a fraction.
### :param x: The operand.
### :returns: Whether x comes back from round-to-integral unchanged.
secret routine dec_is_integral_as_is(x: Dec) -> Bool
    special: Bool = not x.is_finite()
    return special or x.coeff == 0 or x.exp >= 0

### x rounded to an integral value with exponent 0, for an x with a fraction (dec_is_integral_as_is false). mode: 0
### toward zero, 1 down, 2 up, 3 nearest with ties away from zero, 4 nearest with ties to even, 5 half up (floor(x +
### 0.5), whose zero is +0, so -0.5 gives 0).
### :param x: The operand.
### :param mode: The rounding: 0 toward zero, 1 down, 2 up, 3 nearest with ties away, 4 nearest with ties to even, 5
###     half up.
### :param f: The format the result rounds to.
### :returns: x rounded to an integral value with exponent 0, for an x with a fraction (dec_is_integral_as_is false).
secret routine dec_round_int(x: Dec, mode: U32, f: DecFormat) -> Dec
    dropped: S64 = -x.exp

    within: Bool = dropped <= f.digits
    values2: (U128, Bool, Bool, Bool) = when
        within =>
            unit: U128 = dec_p10_128(dropped)
            q: U128 = dec_div_p10(x: x.coeff, k: dropped)
            r: U128 = x.coeff - q *% unit
            twice: U128 = r << 1
            becomes (q, r != 0, twice == unit, twice > unit)
        else => (0, true, false, false)
    q, rest, half, above = values2
    odd: Bool = q & 1 == 1
    near: Bool = above or half
    even: Bool = above or (half and odd)
    half_up: Bool = above or (half and not x.neg)
    cut: DecDroppedFraction = (rest: rest, nearest: near, even: even, half_up: half_up)
    up: Bool = dec_is_rounded_up(mode, neg: x.neg, cut)
    coeff: U128 = q + up.to[U128]()
    # half up is floor(x + 0.5), and a floor that lands on zero is +0
    neg: Bool = x.neg and (mode != 5 or coeff != 0)
    return dec_num(neg, coeff, exp: 0)

### Whether rounding to an integer in `mode` (see dec_round_int) moves the magnitude up.
### :param mode: The rounding: 0 toward zero, 1 down, 2 up, 3 nearest with ties away, 4 nearest with ties to even, 5
###     half up.
### :param neg: Whether the value is negative.
### :param cut: What dropping the fraction cut off.
### :returns: Whether rounding to an integer in `mode` (see dec_round_int) moves the magnitude up.
secret routine dec_is_rounded_up(mode: U32, neg: Bool, cut: DecDroppedFraction) -> Bool
    when mode
        1 => return neg and cut.rest
        2 => return not neg and cut.rest
        3 => return cut.nearest
        4 => return cut.even
        5 => return cut.half_up
        else => return false

### Whether quantize returns a unchanged: neither is a NaN, and both are infinities or their exponents match.
### :param a: The first operand.
### :param b: The second operand.
### :returns: Whether quantize returns a unchanged.
secret routine dec_is_quantize_identity(a: Dec, b: Dec) -> Bool
    is_nan: Bool = a.is_nan() or b.is_nan()
    both: Bool = a.is_inf() and b.is_inf()
    same: Bool = a.is_finite() and b.is_finite() and a.exp == b.exp
    return not is_nan and (both or same)

### a with b's exponent (when dec_is_quantize_identity is false): digits dropped round half to even, and a result that
### needs more than p digits, a NaN, or an infinity with a number gives a NaN.
### :param a: The first operand.
### :param b: The second operand.
### :param f: The format the result rounds to.
### :returns: a with b's exponent (when dec_is_quantize_identity is false).
secret routine dec_quantize(a: Dec, b: Dec, f: DecFormat) -> Dec
    target: S64 = b.exp

    when
        not (a.is_finite() and b.is_finite()) => return dec_nan()
        a.exp > target =>
            shift: S64 = a.exp - target
            when
                a.coeff == 0 => return dec_num(neg: a.neg, coeff: 0, exp: target)
                dec_digits(a.coeff) + shift > f.digits => return dec_nan()
                else => return dec_num(neg: a.neg, coeff: a.coeff * dec_p10_128(shift), exp: target)
        else =>
            dropped: S64 = target - a.exp
            if dropped > f.digits
                return dec_num(neg: a.neg, coeff: 0, exp: target)
            unit: U128 = dec_p10_128(dropped)
            q: U128 = dec_div_p10(x: a.coeff, k: dropped)
            r: U128 = a.coeff - q *% unit
            twice: U128 = r << 1
            odd: Bool = q & 1 == 1
            up: Bool = twice > unit or (twice == unit and odd)
            return dec_num(neg: a.neg, coeff: q + up.to[U128](), exp: target)

# ── remainders ────────────────────────────────────────────────────────────────────────────────────

### The exact remainder of x = cx 10^ex by y = cy 10^ey (cy nonzero) at exponent e = min(ex, ey): fmod (near false)
### is |x| mod |y| with x's sign, the IEEE remainder (near true) is x - n y with n the nearest integer (ties to
### even), whose magnitude is r and whose sign is x's flipped when flip. With X and Y the coefficients aligned to e,
### X mod M is taken for M = Y (M = 2Y for the remainder, so whether the quotient is odd is known at a tie): X =
### cx 10^d reduces as (r 10^k) mod M up to 38 digits at a time, and for ex < ey the aligned Y exceeds X once
### d > 38. The result is never longer than cx or cy, so it is exact.
### :param x: The operand.
### :param y: The second operand.
### :param near: Whether it is the IEEE remainder (nearest quotient) rather than fmod (truncated).
### :returns: The exact remainder of x = cx 10^ex by y = cy 10^ey (cy nonzero) at exponent e = min(ex, ey).
secret routine dec_remainder(x: Dec, y: Dec, near: Bool) -> Dec
    mul: U256 = (near.to[U64]() + 1).to[U256]()

    # the remainder r, the aligned Y, and the exponent e they are at
    settled: (U256, U256, S64) = when
        x.exp >= y.exp =>
            # r = X mod M, d digits of X still to bring in
            m: U256 = y.coeff.to[U256]() * mul
            until d <= 0 with r: U256 = x.coeff.to[U256]() % m, d: S64 = x.exp - y.exp
                k: S64 = d.min(38)
                continue with r: r * dec_p10(k) % m, d: d - k
            then
                becomes (r, y.coeff.to[U256](), y.exp)
        else =>
            d: S64 = y.exp - x.exp
            if d > 38
                return dec_num(neg: x.neg, coeff: x.coeff, exp: x.exp)
            yy: U256 = y.coeff.to[U256]() * dec_p10(d)
            m: U256 = yy * mul
            xx: U256 = x.coeff.to[U256]()
            r: U256 = when
                xx >= m => xx % m
                else => xx
            becomes (r, yy, x.exp)
    r, yy, e = settled
    if not near
        return dec_num(neg: x.neg, coeff: r.to[U128](), exp: e)

    # r is X mod 2Y: past Y the quotient is odd
    odd: Bool = r >= yy
    rr: U256 = when
        odd => r -% yy
        else => r
    twice: U256 = rr << 1
    if twice > yy or (twice == yy and odd)
        return dec_num(neg: not x.neg, coeff: (yy - rr).to[U128](), exp: e)
    return dec_num(neg: x.neg, coeff: rr.to[U128](), exp: e)

### Whether fmod or the remainder of x by y is a NaN: a NaN in, an infinite x, or a zero y.
### :param x: The operand.
### :param y: The second operand.
### :returns: Whether fmod or the remainder of x by y is a NaN.
secret routine dec_is_mod_invalid(x: Dec, y: Dec) -> Bool
    is_nan: Bool = x.is_nan() or y.is_nan()
    hard: Bool = x.is_inf() or y.is_zero()
    return is_nan or hard

### Whether fmod or the remainder returns x unchanged: an infinite y.
### :param x: The operand.
### :param y: The second operand.
### :returns: Whether fmod or the remainder returns x unchanged.
secret routine dec_is_mod_identity(x: Dec, y: Dec) -> Bool
    return not dec_is_mod_invalid(x, y) and y.is_inf()

### fmod (near false) or the IEEE remainder (near true) of x by y, when dec_is_mod_identity is false.
### :param x: The operand.
### :param y: The second operand.
### :param near: Whether it is the IEEE remainder (nearest quotient) rather than fmod (truncated).
### :returns: fmod (near false) or the IEEE remainder (near true) of x by y, when dec_is_mod_identity is false.
secret routine dec_mod(x: Dec, y: Dec, near: Bool) -> Dec
    if dec_is_mod_invalid(x, y)
        return dec_nan()
    return dec_remainder(x, y, near)

# ── exponent operations ───────────────────────────────────────────────────────────────────────────

### The simplest member of x's cohort (trailing zeros stripped): a zero becomes 0 with exponent 0, a special stays.
### :param x: The operand.
### :param f: The format the result rounds to.
### :returns: The simplest member of x's cohort (trailing zeros stripped).
secret routine dec_normalize(x: Dec, f: DecFormat) -> Dec
    when
        not x.is_finite() => return x
        x.coeff == 0 => return dec_num(neg: x.neg, coeff: 0, exp: 0)
        else => return x.reduce(f)

### x × 10^n by its exponent alone: above the range an infinity, below it a zero with exponent 0. A special or a zero
### stays.
### :param x: The operand.
### :param n: The power of ten.
### :param f: The format the result rounds to.
### :returns: x × 10^n by its exponent alone.
secret routine dec_scaleb(x: Dec, n: S64, f: DecFormat) -> Dec
    e: S64 = x.exp + n
    when
        not x.is_finite() => return x
        x.coeff == 0 => return x
        e > f.qmax => return dec_inf(x.neg)
        e < f.qmin => return dec_num(neg: x.neg, coeff: 0, exp: 0)
        else => return dec_num(neg: x.neg, coeff: x.coeff, exp: e)

### The exponent e with 10^e <= |x| < 10^(e + 1), as a decimal: NaN for a NaN, +infinity for an infinity,
### -infinity for a zero.
### :param x: The operand.
### :param f: The format the result rounds to.
### :returns: The exponent e with 10^e <= |x| < 10^(e + 1), as a decimal.
secret routine dec_logb(x: Dec, f: DecFormat) -> Dec
    when
        x.is_nan() => return dec_nan()
        x.is_inf() => return dec_inf(false)
        x.coeff == 0 => return dec_inf(true)
        else =>
            e: S64 = x.exp + dec_digits(x.coeff) - 1
            return dec_from_s64(n: e, f)

### An integer as a decimal with exponent 0, rounded to f.
### :param n: The integer.
### :param f: The format the result rounds to.
### :returns: An integer as a decimal with exponent 0, rounded to f.
secret routine dec_from_s64(n: S64, f: DecFormat) -> Dec
    magnitude: U256 = n.abs_diff(0).to[U256]()
    return dec_finish(value: DecExact(neg: n < 0, coeff: magnitude, exp: 0, pref: 0), f)

# ── DPD ───────────────────────────────────────────────────────────────────────────────────────────

### The bits of the exponent continuation field of a DPD decimal of `width` bits.
### :param width: The width in bits: 32, 64, or 128.
### :returns: The bits of the exponent continuation field of a DPD decimal of `width` bits.
secret routine dec_dpd_continuation(width: U32) -> U128
    when width
        32 => return 6
        64 => return 8
        else => return 12

### The exponent bias of the decimal format of `width` bits.
### :param width: The width in bits: 32, 64, or 128.
### :returns: The exponent bias of the decimal format of `width` bits.
secret routine dec_bias(width: U32) -> S64
    when width
        32 => return 101
        64 => return 398
        else => return 6176

### The DPD interchange form of the decimal of `width` bits (32, 64, or 128) whose BID form decodes to x: the sign, a
### 5-bit combination field (the exponent's top two bits and the leading digit, 8 and 9 folded in as 11 0 and 11 1;
### 11110 an infinity, 11111 a NaN with the signaling bit after it), the rest of the biased exponent (6, 8, or 12
### bits), and the trailing digits three to a 10-bit declet (Cowlishaw's encoding). As RazorForge's engine did, the
### leading digit is the coefficient over 10^(p - 1), whatever it is.
### :param x: The operand.
### :param width: The width in bits: 32, 64, or 128.
### :returns: The DPD interchange form of the decimal of `width` bits (32, 64, or 128) whose BID form decodes to x.
secret routine dec_to_dpd(x: Dec, width: U32) -> U128
    top: U128 = width.to[U128]()
    sign: U128 = x.neg.to[U128]() << top - 1
    cont: U128 = dec_dpd_continuation(width)
    declets: U128 = (top - cont - 6) // 10

    kind: U8 = x.kind
    when kind
        0 =>
            bias: S64 = dec_bias(width)
            # the declets, lowest first
            e: U128 = (x.exp + bias).to_wrap[U128]()
            each i in 0 til declets with c: U128 = x.coeff, field: U128 = 0
                group: U128 = c % 1000
                code: U128 = DEC_BIN_TO_DPD.getitem(group.to[U64]()).to[U128]()
                continue with c: c // 1000, field: field | (code << i * 10)
            then
                ehi: U128 = e >> cont
                elo: U128 = e & U128.shift_left(1, cont) - 1
                small: Bool = c < 8
                combo: U128 = when
                    small => (ehi << 3) | c
                    else => (ehi << 1) | c -% 8 | 0x18
                mask: U128 = U128.MAX >> 128 - top
                word: U128 = sign | (combo << top - 6) | (elo << top - 6 - cont) | field
                return word & mask
        1 => return sign | U128.shift_left(0x1E, top - 6)
        2 => return sign | U128.shift_left(0x1F, top - 6)
        else => return sign | U128.shift_left(0x3F, top - 7)

### The decimal whose DPD interchange form of `width` bits is `bits` (decoded as dec_to_dpd encodes).
### :param bits: The encoding.
### :param width: The width in bits: 32, 64, or 128.
### :returns: The decimal whose DPD interchange form of `width` bits is `bits` (decoded as dec_to_dpd encodes).
secret routine dec_from_dpd(bits: U128, width: U32) -> Dec
    top: U128 = width.to[U128]()
    neg: Bool = (bits >> top - 1) & 1 == 1
    cont: U128 = dec_dpd_continuation(width)
    declets: U128 = (top - cont - 6) // 10
    combo: U128 = (bits >> top - 6) & 0x1F

    signaling: Bool = (bits >> top - 7) & 1 == 1
    kind: U8 = when
        signaling => DEC_SNAN
        else => DEC_QNAN
    when
        combo == 0x1E => return dec_inf(neg)
        combo == 0x1F => return (neg: neg, kind: kind, exp: 0, coeff: 0)
        combo < 0x18 =>
            elo: U128 = (bits >> top - 6 - cont) & U128.shift_left(1, cont) - 1
            e: U128 = ((combo >> 3) << cont) | elo
            bias: S64 = dec_bias(width)
            # the declets, highest first
            exp: S64 = e.to[S64]() - bias
            until left == 0 with left: U128 = declets, c: U128 = combo & 7
                i: U128 = left - 1
                code: U128 = (bits >> i * 10) & 0x3FF
                group: U128 = DEC_DPD_TO_BIN.getitem(code.to[U64]()).to[U128]()
                continue with left: i, c: c * 1000 + group
            then
                return dec_num(neg, coeff: c, exp)
        else =>
            elo: U128 = (bits >> top - 6 - cont) & U128.shift_left(1, cont) - 1
            e: U128 = (((combo >> 1) & 3) << cont) | elo
            bias: S64 = dec_bias(width)
            exp: S64 = e.to[S64]() - bias
            until left == 0 with left: U128 = declets, c: U128 = (combo & 1) + 8
                i: U128 = left - 1
                code: U128 = (bits >> i * 10) & 0x3FF
                group: U128 = DEC_DPD_TO_BIN.getitem(code.to[U64]()).to[U128]()
                continue with left: i, c: c * 1000 + group
            then
                return dec_num(neg, coeff: c, exp)

### d rounded once to f and reduced (a special passes through).
### :param d: The decimal.
### :param f: The format the result rounds to.
### :returns: d rounded once to f and reduced (a special passes through).
secret routine dec_reduced(d: Dec, f: DecFormat) -> Dec
    if d.is_finite()
        return dec_round_reduced(neg: d.neg, coeff: d.coeff.to[U256](), exp: d.exp, f)
    return d
