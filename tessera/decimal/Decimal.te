routine S64.to[Decimal]() -> Decimal
    return Decimal.of(dec_of_integer(neg: me < 0, magnitude: me.abs_diff(0).to[U256](),
        f: decimal_format()))

### `me` as a Decimal, rounded to 34 digits (a tie as {Decimal} rounds one) when it has more.
### :returns: The decimal.
routine S128.to[Decimal]() -> Decimal
    return Decimal.of(dec_of_integer(neg: me < 0, magnitude: me.abs_diff(0).to[U256](),
