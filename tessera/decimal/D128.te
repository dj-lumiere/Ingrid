# D128: IEEE 754 decimal128 in the BID encoding, 34 significant digits, exponents -6176 to 6111. Every
# operation rounds once to 34 digits, a tie to the even one. The operators crash on a result that is an infinity
# or a NaN (`NumericOverflowError`, `NumericDomainError`, `DivisionByZeroError` for a nonzero value over zero), and
# the `_unchecked` routines give the raw IEEE 754 result.

module Ingrid/Decimal

### An IEEE 754 decimal128: 34 significant decimal digits and a power of ten. Values are exact in decimal (`0.1` is
### one tenth), and a value keeps its exponent (`1.0` and `1.00` are equal, and their text differs).
record D128
obeys Equatable[D128], Comparable[D128]
obeys Addable[D128], Subtractable[D128], Multiplicable[D128], Divisible[D128], Negatable[D128], UncheckedArithmetic[D128]
obeys Representable[D128], Diagnosable[D128], FixedRepresentable[D128], Parsable[D128]
    ### The BID encoding.
    secret encoding: U128

# -- bits ----------------------------------------------------------------------

### The D128 whose BID encoding is `bits`.
### :param bits: The encoding.
### :returns: The decimal.
@inline
common routine D128.from_bits(bits: U128) -> Me
    return Me(encoding: bits)

### The BID encoding of `me`.
### :returns: The encoding.
@inline
routine D128.bits() -> U128
    return me.encoding

### `me` taken apart for the engine.
### :returns: The fields.
@inline
secret routine D128.dec() -> Dec
    return dec_from128(me.encoding)

### The D128 of the engine's value `d`, already rounded to 34 digits.
### :param d: The value.
### :returns: The decimal.
@inline
secret common routine D128.of(d: Dec) -> Me
    return Me(encoding: d.to128())

### Zero, at exponent 0.
### :returns: `0`.
common routine D128.zero() -> Me
    return Me.of(dec_num(neg: false, coeff: 0, exp: 0))

### An infinity.
### :param negative: Whether it is the negative one.
### :returns: `inf` or `-inf`.
common routine D128.infinity(negative: Bool) -> Me
    return Me.of(dec_inf(neg: negative))

### A quiet NaN.
### :returns: `NaN`.
common routine D128.quiet_nan() -> Me
    return Me.of(dec_nan())

# -- classification ------------------------------------------------------------

### Whether `me` is neither an infinity nor a NaN.
### :returns: `true` for a finite value.
routine D128.is_finite() -> Bool
    return me.dec().is_finite()

### Whether `me` is an infinity.
### :returns: `true` for `inf` and `-inf`.
routine D128.is_infinite() -> Bool
    return me.dec().is_inf()

### Whether `me` is a NaN, quiet or signaling.
### :returns: `true` for a NaN.
routine D128.is_nan() -> Bool
    return me.dec().is_nan()

### Whether `me` is a signaling NaN.
### :returns: `true` for a signaling NaN.
routine D128.is_signaling() -> Bool
    return me.dec().kind == DEC_SNAN

### Whether `me` is zero, of either sign and any exponent.
### :returns: `true` for a zero.
routine D128.is_zero() -> Bool
    return me.dec().is_zero()

### Whether the sign of `me` is negative (a negative zero, `-inf`, and a NaN with the sign set included).
### :returns: `true` when the sign bit is set.
routine D128.is_sign_negative() -> Bool
    return me.dec().neg

# -- arithmetic ----------------------------------------------------------------

### `me` when it is finite: the last step of a checked operation.
### :returns: `me`.
### :throws: Crashes with `NumericDomainError` when `me` is a NaN and with `NumericOverflowError` when it is an
###     infinity.
@track_caller
secret routine D128.require_finite() -> Me
    if me.is_finite()
        return me
    if me.is_nan()
        crash_numeric_domain()
    crash(name: "NumericOverflowError",
        message: "The result is out of D128's range: it would be infinite.")

### `me + other`, rounded to 34 digits. {D128.add_unchecked} gives the raw IEEE 754 result.
### :param other: The other operand.
### :returns: The sum.
### :throws: Crashes with `NumericOverflowError` when the sum is infinite and with `NumericDomainError` when it is a
###     NaN.
@track_caller
routine D128.add(other: Me) -> Me
    return me.add_unchecked(other).require_finite()

### `me - other`, rounded to 34 digits. {D128.sub_unchecked} gives the raw IEEE 754 result.
### :param other: The other operand.
### :returns: The difference.
### :throws: Crashes with `NumericOverflowError` when the difference is infinite and with `NumericDomainError` when it
###     is a NaN.
@track_caller
routine D128.sub(other: Me) -> Me
    return me.sub_unchecked(other).require_finite()

### `me * other`, rounded to 34 digits. {D128.mul_unchecked} gives the raw IEEE 754 result.
### :param other: The other factor.
### :returns: The product.
### :throws: Crashes with `NumericOverflowError` when the product is infinite and with `NumericDomainError` when it is
###     a NaN.
@track_caller
routine D128.mul(other: Me) -> Me
    return me.mul_unchecked(other).require_finite()

### `me / other`, rounded to 34 digits. {D128.truediv_unchecked} gives the raw IEEE 754 result.
### :param other: The divisor.
### :returns: The quotient.
### :throws: Crashes with `DivisionByZeroError` when `other` is zero and `me` is not, with `NumericOverflowError` when
###     the quotient is infinite, and with `NumericDomainError` when it is a NaN (`0 / 0` among them).
@track_caller
routine D128.truediv(other: Me) -> Me
    r: Me = me.truediv_unchecked(other)
    if not r.is_finite() and other.is_zero() and not me.is_zero() and me.is_finite()
        crash_division_by_zero()
    return r.require_finite()

### `me + other`, rounded to 34 digits, an infinity or a NaN passed on as IEEE 754 says.
### :param other: The other operand.
### :returns: The sum.
routine D128.add_unchecked(other: Me) -> Me
    return Me.of(dec_add(a: me.dec(), b: other.dec(), f: dec_format128()))

### `me - other`, rounded to 34 digits, an infinity or a NaN passed on as IEEE 754 says.
### :param other: The other operand.
### :returns: The difference.
routine D128.sub_unchecked(other: Me) -> Me
    return Me.of(dec_add(a: me.dec(), b: other.dec().negate(), f: dec_format128()))

### `me * other`, rounded to 34 digits, an infinity or a NaN passed on as IEEE 754 says.
### :param other: The other factor.
### :returns: The product.
routine D128.mul_unchecked(other: Me) -> Me
    return Me.of(dec_mul(a: me.dec(), b: other.dec(), f: dec_format128()))

### `me / other`, rounded to 34 digits: a nonzero value over zero is an infinity, `0 / 0` a NaN.
### :param other: The divisor.
### :returns: The quotient.
routine D128.truediv_unchecked(other: Me) -> Me
    return Me.of(dec_div(a: me.dec(), b: other.dec(), f: dec_format128()))

### `-me`: the sign turned over, nothing rounded.
### :returns: The negated value.
routine D128.neg() -> Me
    return Me.of(me.dec().negate())

### `me` with its sign cleared.
### :returns: The absolute value.
routine D128.abs() -> Me
    d: Dec = me.dec()
    if d.neg
        return Me.of(d.negate())
    return me

### The square root of `me`, rounded to 34 digits.
### :returns: The square root.
### :throws: Crashes with `NumericDomainError` when `me` is below zero or a NaN, and with `NumericOverflowError` when
###     it is `inf`.
@track_caller
routine D128.sqrt() -> Me
    return me.sqrt_unchecked().require_finite()

### The square root of `me`, rounded to 34 digits: a NaN for a value below zero.
### :returns: The square root.
routine D128.sqrt_unchecked() -> Me
    return Me.of(dec_sqrt(x: me.dec(), f: dec_format128()))

### `me` rounded to an integral value toward zero.
### :returns: The integral value.
routine D128.trunc() -> Me
    return Me.of(dec_integral(d: me.dec(), mode: 0, f: dec_format128()))

### `me` rounded down to an integral value.
### :returns: The integral value.
routine D128.floor() -> Me
    return Me.of(dec_integral(d: me.dec(), mode: 1, f: dec_format128()))

### `me` rounded up to an integral value.
### :returns: The integral value.
routine D128.ceil() -> Me
    return Me.of(dec_integral(d: me.dec(), mode: 2, f: dec_format128()))

### `me` rounded to the nearest integral value, a tie away from zero.
### :returns: The integral value.
routine D128.round() -> Me
    return Me.of(dec_integral(d: me.dec(), mode: 3, f: dec_format128()))

### `me` rounded to the nearest integral value, a tie to the even one.
### :returns: The integral value.
routine D128.round_ties_even() -> Me
    return Me.of(dec_integral(d: me.dec(), mode: 4, f: dec_format128()))

# -- comparison ----------------------------------------------------------------

### Whether `me` and `other` are the same number: a NaN equals nothing, `+0` equals `-0`, and `1.0` equals `1.00`.
### :param other: The value to compare with.
### :returns: `true` when they are equal.
routine D128.eq(other: Me) -> Bool
    return dec_order(a: me.dec(), b: other.dec()) == 0

### Three-way comparison for the `Comparable` conformance.
### :param other: The value to compare with.
### :returns: -1 when `me < other`, 1 when `me > other`, and 0 otherwise, a comparison with a NaN included.
routine D128.compare(other: Me) -> S32
    order: S64 = dec_order(a: me.dec(), b: other.dec())
    if order == -1
        return -1
    if order == 1
        return 1
    return 0

### `me < other`, false when either is a NaN.
### :param other: The value to compare with.
### :returns: Whether `me` is smaller.
routine D128.lt(other: Me) -> Bool
    return dec_order(a: me.dec(), b: other.dec()) == -1

### `me <= other`, false when either is a NaN.
### :param other: The value to compare with.
### :returns: Whether `me` is smaller or equal.
routine D128.le(other: Me) -> Bool
    order: S64 = dec_order(a: me.dec(), b: other.dec())
    return order == -1 or order == 0

### `me > other`, false when either is a NaN.
### :param other: The value to compare with.
### :returns: Whether `me` is larger.
routine D128.gt(other: Me) -> Bool
    return dec_order(a: me.dec(), b: other.dec()) == 1

### `me >= other`, false when either is a NaN.
### :param other: The value to compare with.
### :returns: Whether `me` is larger or equal.
routine D128.ge(other: Me) -> Bool
    order: S64 = dec_order(a: me.dec(), b: other.dec())
    return order == 1 or order == 0

### The smaller of `me` and `other`, the other one when one is a NaN.
### :param other: The value to compare with.
### :returns: The smaller value.
routine D128.min(other: Me) -> Me
    if me.is_nan()
        return other
    if other.is_nan() or me <= other
        return me
    return other

### The larger of `me` and `other`, the other one when one is a NaN.
### :param other: The value to compare with.
### :returns: The larger value.
routine D128.max(other: Me) -> Me
    if me.is_nan()
        return other
    if other.is_nan() or me >= other
        return me
    return other

### `me` held between `lo` and `hi`.
### :param lo: The lower bound.
### :param hi: The upper bound.
### :returns: `lo` below it, `hi` above it, else `me`.
routine D128.clamp(lo: Me, hi: Me) -> Me
    return me.max(lo).min(hi)

# -- text ----------------------------------------------------------------------

### Writes `me` the way decimal text is read back: positional when the exponent is at most 0 and the value is not
### below 1e-6 (`1.50`, `0.001`, `100`), `d.dddE+x` otherwise (`1E+3`, `1.5E-7`), every digit of the coefficient
### kept. The specials are `inf`, `-inf`, `NaN`, and `sNaN`.
### :typeparam T: The type of the Writer that receives the text.
### :param out: The Writer the text is written to.
routine D128.represent_into[T](out: @T) -> None
needs T: typename, Writer[T]
    write_decimal_text(out, fields: dec_fields(me.dec()), style: 0, places: 0)
    return

### Writes `D128(` and `me`'s text and `)`.
### :typeparam T: The type of the Writer that receives the text.
### :param out: The Writer the text is written to.
routine D128.diagnose_into[T](out: @T) -> None
needs T: typename, Writer[T]
    write_decimal_text(out, fields: dec_fields(me.dec()), style: 3, places: 128)
    return

### Writes `me` with exactly `digits` digits after the point, rounded from its exact value, a tie to the even one,
### the integer part written in full.
### :typeparam T: The type of the Writer that receives the text.
### :param out: The Writer the text is written to.
### :param digits: The digits after the point.
routine D128.represent_fixed_into[T](out: @T, digits: U64) -> None
needs T: typename, Writer[T]
    write_decimal_text(out, fields: dec_fields(me.dec()), style: 2, places: digits)
    return

### The text as a D128, rounded once to 34 digits (a tie to the even one), at the exponent the text writes. Accepts
### an optional sign, digits with an optional point and an `e` or `E` exponent, and `inf`, `infinity`, or `nan` in any
### letter case.
### :returns: The decimal.
### :throws: Throws `EmptyTextError` for an empty text or a sign alone and `InvalidValueError` for any other text that
###     is not a number.
failable routine @[Byte].to[D128]() -> D128
    if dec_text_is_empty(me)
        throw EmptyTextError(text: me, target: "D128")
    scanned: DecScanned = dec_scan(chars: DecBytes(text: me))
    if scanned.bad
        throw InvalidValueError(text: me, target: "D128")
    return D128.of(dec_from_scan(scanned, f: dec_format128()))

# -- integers ------------------------------------------------------------------

### `me` as a D128, rounded to the nearest D128 (a tie to the even one) when it has more digits than D128 holds.
### :returns: The decimal.
routine S8.to[D128]() -> D128
    return D128.of(dec_of_integer(neg: me < 0, magnitude: me.abs_diff(0).to[U256](),
        f: dec_format128()))

### `me` as a D128, rounded to the nearest D128 (a tie to the even one) when it has more digits than D128 holds.
### :returns: The decimal.
routine S16.to[D128]() -> D128
    return D128.of(dec_of_integer(neg: me < 0, magnitude: me.abs_diff(0).to[U256](),
        f: dec_format128()))

### `me` as a D128, rounded to the nearest D128 (a tie to the even one) when it has more digits than D128 holds.
### :returns: The decimal.
routine S32.to[D128]() -> D128
    return D128.of(dec_of_integer(neg: me < 0, magnitude: me.abs_diff(0).to[U256](),
        f: dec_format128()))

### `me` as a D128, rounded to the nearest D128 (a tie to the even one) when it has more digits than D128 holds.
### :returns: The decimal.
routine S64.to[D128]() -> D128
    return D128.of(dec_of_integer(neg: me < 0, magnitude: me.abs_diff(0).to[U256](),
        f: dec_format128()))

### `me` as a D128, rounded to the nearest D128 (a tie to the even one) when it has more digits than D128 holds.
### :returns: The decimal.
routine S128.to[D128]() -> D128
    return D128.of(dec_of_integer(neg: me < 0, magnitude: me.abs_diff(0).to[U256](),
        f: dec_format128()))

### `me` as a D128, rounded to the nearest D128 (a tie to the even one) when it has more digits than D128 holds.
### :returns: The decimal.
routine S256.to[D128]() -> D128
    return D128.of(dec_of_integer(neg: me < 0, magnitude: me.abs_diff(0), f: dec_format128()))

### `me` as a D128, rounded to the nearest D128 (a tie to the even one) when it has more digits than D128 holds.
### :returns: The decimal.
routine U8.to[D128]() -> D128
    return D128.of(dec_of_integer(neg: false, magnitude: me.to[U256](), f: dec_format128()))

### `me` as a D128, rounded to the nearest D128 (a tie to the even one) when it has more digits than D128 holds.
### :returns: The decimal.
routine U16.to[D128]() -> D128
    return D128.of(dec_of_integer(neg: false, magnitude: me.to[U256](), f: dec_format128()))

### `me` as a D128, rounded to the nearest D128 (a tie to the even one) when it has more digits than D128 holds.
### :returns: The decimal.
routine U32.to[D128]() -> D128
    return D128.of(dec_of_integer(neg: false, magnitude: me.to[U256](), f: dec_format128()))

### `me` as a D128, rounded to the nearest D128 (a tie to the even one) when it has more digits than D128 holds.
### :returns: The decimal.
routine U64.to[D128]() -> D128
    return D128.of(dec_of_integer(neg: false, magnitude: me.to[U256](), f: dec_format128()))

### `me` as a D128, rounded to the nearest D128 (a tie to the even one) when it has more digits than D128 holds.
### :returns: The decimal.
routine U128.to[D128]() -> D128
    return D128.of(dec_of_integer(neg: false, magnitude: me.to[U256](), f: dec_format128()))

### `me` as a D128, rounded to the nearest D128 (a tie to the even one) when it has more digits than D128 holds.
### :returns: The decimal.
routine U256.to[D128]() -> D128
    return D128.of(dec_of_integer(neg: false, magnitude: me, f: dec_format128()))

### The integer part of `me`, toward zero, as an S8.
### :returns: The integer.
### :throws: Throws `IntegerOverflowError` when `me` is an infinity or a NaN, or its integer part doesn't fit S8.
failable routine D128.to[S8]() -> S8
    part: DecInt = when check dec_int_part(me.dec())
        is DecInt as p => p
    return when check part.to_s256().to[S8]()
        is S8 as v => v

