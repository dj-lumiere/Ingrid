# -- the other widths ------------------------------------------------------------

### `me` as a D32, rounded once to 7 digits, trailing zeros stripped as far as the exponent allows.
### :returns: The decimal.
### :throws: Throws `NumericOverflowError` when a finite `me` rounds to an infinity. {D128.to_unchecked[D32]} gives
###     the infinity.
failable routine D128.to[D32]() -> D32
    r: D32 = me.to_unchecked[D32]()
    if me.is_finite() and not r.is_finite()
        throw NumericOverflowError()
    return r

### `me` as a D32, rounded once to 7 digits, trailing zeros stripped as far as the exponent allows: a finite value past the range is an infinity.
### :returns: The decimal.
routine D128.to_unchecked[D32]() -> D32
    return D32.of(dec_reduced(d: me.dec(), f: dec_format32()))

### `me` as a D64, rounded once to 16 digits, its exponent kept when the digits allow.
### :returns: The decimal.
### :throws: Throws `NumericOverflowError` when a finite `me` rounds to an infinity. {D128.to_unchecked[D64]} gives
###     the infinity.
failable routine D128.to[D64]() -> D64
    r: D64 = me.to_unchecked[D64]()
    if me.is_finite() and not r.is_finite()
        throw NumericOverflowError()
    return r

### `me` as a D64, rounded once to 16 digits, its exponent kept when the digits allow: a finite value past the range is an infinity.
### :returns: The decimal.
routine D128.to_unchecked[D64]() -> D64
    return D64.of(me.dec().narrow(dec_format64()))
