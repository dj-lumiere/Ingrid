// race!: waits until the first of a set of agents (coroutines and threaded tasks, in List order) finishes.
//
// The pool's workers drive the coroutine competitors. The racer only waits. Inside a coroutine it parks, registered
// as the awaiter of every coroutine competitor and as the race waiter of every task, and re-polls when woken. On a
// plain thread it waits on the pool's block_cond. The first to finish is the smallest completion stamp among the
// finished ones, not the lowest index, so a late scan that finds several finished still picks the right one.

module Ingrid/Runtime

/// rf_race: competitors and their kinds (0 a coroutine, 1 a threaded task).
record Race
    handles: @Addr
    kinds: @U8
    count: SSize
    cap: SSize

/// Makes a `Race` from its fields.
/// :param handles: Its `handles`.
/// :param kinds: Its `kinds`.
/// :param count: Its `count`.
/// :param cap: Its `cap`.
/// :returns: The new value.
routine Race.construct(handles: @Addr, kinds: @U8, count: SSize, cap: SSize) -> Me
    return Me(handles, kinds, count, cap)

/// Releases nothing: a `Race` holds no memory of its own.
routine Race.destruct(me: @Me) -> Void
    return

/// Starts an empty set of race competitors.
/// :returns: The new set, freed with {rf_race_end}.
/// :throws: Crashes with `OutOfMemoryError` when the allocation fails.
@export("rf_race_begin")
routine rf_race_begin() -> @Race
    r: @Race = zeroed[Race](count: 1, what: "Failed to allocate race competitor set")
    return r

/// Appends a competitor, doubling the storage (from 4) when it is full. A null `me` does nothing.
/// :param handle: The competitor's coroutine or task.
/// :param kind: 0 for a coroutine, 1 for a threaded task.
/// :throws: Crashes with `OutOfMemoryError` when the storage can't grow.
routine Race.add_last(me: @Me, handle: Addr, kind: U8) -> Void
    if me.is_null()
        return
    n: SSize = me.count.peek()
    if n == me.cap.peek()
        cap: SSize = when
            n == 0 => 4
            else => n * 2
        handles: Addr = c_realloc(me.handles.peek(), cap.to[USize]() * sizeof[Addr]())
        kinds: Addr = c_realloc(me.kinds.peek(), cap.to[USize]())
        if handles.is_null() or kinds.is_null()
            rf_throw(error_type: "OutOfMemoryError", message: "Failed to grow race competitor set")
        me.handles.poke(handles.to[@Addr]())
        me.kinds.poke(kinds.to[@U8]())
        me.cap.poke(cap)
    handle_slot: @Addr = me.handles.peek().stride(n)
    handle_slot.poke(handle)
    kind_slot: @U8 = me.kinds.peek().stride(n)
    kind_slot.poke(kind)
    me.count.poke(n + 1)
    return

/// Adds a coroutine competitor to the race.
/// :param r: The race.
/// :param c: The coroutine.
/// :throws: Crashes with `OutOfMemoryError` when the set can't grow.
@export("rf_race_add_coro")
routine rf_race_add_coro(r: @Race, c: @Coro) -> Void
    r.add_last(handle: c, kind: 0)
    return

/// Adds a threaded-task competitor to the race.
/// :param r: The race.
/// :param t: The task.
/// :throws: Crashes with `OutOfMemoryError` when the set can't grow.
@export("rf_race_add_task")
routine rf_race_add_task(r: @Race, t: @Task) -> Void
    r.add_last(handle: t, kind: 1)
    return

/// The handle of competitor `i`, unchecked.
/// :param i: The competitor's index.
/// :returns: Its coroutine or task.
routine Race.handle(me: @Me, i: SSize) -> Addr
    slot: @Addr = me.handles.peek().stride(i)
    return slot.peek()

/// Whether competitor `i` is a threaded task, unchecked.
/// :param i: The competitor's index.
/// :returns: True for a task, false for a coroutine.
routine Race.is_task(me: @Me, i: SSize) -> Bool
    slot: @U8 = me.kinds.peek().stride(i)
    return slot.peek() == 1

/// Every threaded task competitor wakes s (and coro, if a coroutine races) when it completes, or is told no longer
/// to. Each keeps a cross-thread wake promised meanwhile.
/// :param s: The scheduler to wake.
/// :param coro: The racing coroutine, or null for a plain thread.
/// :param on: True to register (and arm a cross-thread wake), false to unregister (and disarm it).
routine Race.register(me: @Me, s: @Sched, coro: @Coro, on: Bool) -> Void
    each i in 0 til me.count.peek()
        if not me.is_task(i)
            continue
        else
            task: @Task = me.handle(i).to[@Task]()
            if on
                rf_task_race_register(task, s, coro)
                rf_sched_arm_cross_waker(s)
                continue
            else
                rf_task_race_register(task, s: null, coro: null)
                rf_sched_disarm_cross_waker(s)
                continue
    then
        return

/// Sets the awaiter of every coroutine competitor to `awaiter`, or clears it on those whose awaiter is still
/// `awaiter`.
/// :param awaiter: The racing coroutine.
/// :param set: True to set, false to clear.
routine Race.await_coros(me: @Me, awaiter: @Coro, set: Bool) -> Void
    each i in 0 til me.count.peek()
        if me.is_task(i) or me.handle(i).is_null()
            continue
        else
            c: @Coro = me.handle(i).to[@Coro]()
            if set
                c.awaiter.poke(awaiter)
                continue
            else if not c.awaiter.peek().ptr_eq(awaiter)
                continue
            else
                c.awaiter.poke(null)
                continue
    then
        return

/// The index of the first competitor to finish (the smallest completion stamp among the finished ones), or -1 while
/// none has.
/// :returns: The winner's index, or -1.
routine Race.winner(me: @Me) -> SSize
    each i in 0 til me.count.peek() with best: SSize = -1, best_seq: U64 = U64.MAX
        seq: U64 = when
            me.is_task(i) =>
                t: @Task = me.handle(i).to[@Task]()
                if rf_task_status_get(t) == TASK_COMPLETED
                    becomes rf_task_completion_seq(t)
                else
                    continue with best: best, best_seq: best_seq
            else =>
                c: @Coro = me.handle(i).to[@Coro]()
                if c.is_null()
                    continue with best: best, best_seq: best_seq
                else if is_finished(c)
                    becomes c.completion_seq.peek_atomic()
                else
                    continue with best: best, best_seq: best_seq
        if best < 0 or seq < best_seq
            continue with best: i, best_seq: seq
        else
            continue with best: best, best_seq: best_seq
    then
        return best

/// Waits until one competitor finishes: its index in List order, or -1 for an empty set.
/// :param r: The race, or null.
/// :returns: The winner's index, or -1 when `r` is null or empty.
@export("rf_race_wait")
routine rf_race_wait(r: @Race) -> SSize
    if r.is_null()
        return -1
    if r.count.peek() == 0
        return -1
    return wait_for_winner(r)

/// rf_race_wait on a set with competitors: registers as their waiter under the scheduler's lock, waits for a
/// winner, and gives the lock and the registration back in finish.
/// :param r: The race, with at least one competitor.
/// :returns: The winner's index.
private routine wait_for_winner(r: @Race) -> SSize
    local s: @Sched = rf_sched_thread_default()
    local this_coro: @Coro = current_coro()

    r.register(s, coro: this_coro, on: true)
    s.lock.lock()
    next_waiters: SSize = s.waiters.peek() + 1
    next_waiters.poke_into(s.waiters)
    if this_coro.is_null()
        jump poll()
    r.await_coros(awaiter: this_coro, set: true)
    jump poll()

    block poll()
        winner: SSize = r.winner()
        if winner >= 0
            jump over(winner)
        if this_coro.is_null()
            jump blocking()
        // A completion racing this park finds the racer RUNNING and makes it NOTIFIED: no wake is lost.
        s.lock.unlock()
        rf_sched_park_external()
        s.lock.lock()
        jump poll()

    block blocking()
        s.block_wait()
        jump poll()

    block over(winner: SSize)
        if not this_coro.is_null()
            jump clear(winner)
        jump finish(winner)

    block clear(winner: SSize)
        r.await_coros(awaiter: this_coro, set: false)
        jump finish(winner)

    block finish(winner: SSize)
        remaining_waiters: SSize = s.waiters.peek() - 1
        remaining_waiters.poke_into(s.waiters)
        s.lock.unlock()
        r.register(s, coro: null, on: false)
        return winner

/// Frees the set, not the competitors (their Agents still own them). A null `r` does nothing.
/// :param r: The race to free.
@export("rf_race_end")
routine rf_race_end(r: @Race) -> Void
    if r.is_null()
        return
    c_free(r.handles.peek())
    c_free(r.kinds.peek())
    c_free(r)
    return
