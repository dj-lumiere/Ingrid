// files.tess on Linux and macOS: POSIX calls.

module Ingrid::Runtime

import Standard::Os

#[external("c"), symbol("stat"), target(os: not "windows")]
routine c_stat(path: @Byte, buf: @Byte) -> CInt

#[external("c"), symbol("lstat"), target(os: not "windows")]
routine c_lstat(path: @Byte, buf: @Byte) -> CInt

#[external("c"), symbol("fstat"), target(os: not "windows")]
routine c_fstat(fd: CInt, buf: @Byte) -> CInt

#[external("c"), symbol("mkdir"), target(os: not "windows")]
routine c_mkdir(path: @Byte, mode: U32) -> CInt

#[external("c"), symbol("rmdir"), target(os: not "windows")]
routine c_rmdir(path: @Byte) -> CInt

#[external("c"), symbol("unlink"), target(os: not "windows")]
routine c_unlink(path: @Byte) -> CInt

#[external("c"), symbol("rename"), target(os: not "windows")]
routine c_rename(from: @Byte, to: @Byte) -> CInt

#[external("c"), symbol("opendir"), target(os: not "windows")]
routine c_opendir(path: @Byte) -> Addr

#[external("c"), symbol("readdir"), target(os: not "windows")]
routine c_readdir(dir: Addr) -> @Byte

#[external("c"), symbol("closedir"), target(os: not "windows")]
routine c_closedir(dir: Addr) -> CInt

#[external("c"), symbol("getcwd"), target(os: not "windows")]
routine c_getcwd(buf: @Byte, size: USize) -> @Byte

#[external("c"), symbol("utimes"), target(os: not "windows")]
routine c_utimes(path: @Byte, times: Addr) -> CInt

#[external("c"), symbol("realpath"), target(os: not "windows")]
routine c_realpath(path: @Byte, resolved: Addr) -> @Byte

#[external("c"), symbol("access"), target(os: not "windows")]
routine c_access(path: @Byte, mode: CInt) -> CInt

#[external("c"), symbol("chmod"), target(os: not "windows")]
routine c_chmod(path: @Byte, mode: U32) -> CInt

#[external("c"), symbol("ftruncate"), target(os: not "windows")]
routine c_ftruncate(fd: CInt, size: S64) -> CInt

#[external("c"), symbol("mmap"), target(os: not "windows")]
routine c_mmap(addr: Addr, length: USize, prot: CInt, flags: CInt, fd: CInt, offset: S64) -> Addr

#[external("c"), symbol("munmap"), target(os: not "windows")]
routine c_munmap(addr: Addr, length: USize) -> CInt

#[external("c"), symbol("msync"), target(os: not "windows")]
routine c_msync(addr: Addr, length: USize, flags: CInt) -> CInt

#[external("c"), symbol("madvise"), target(os: not "windows")]
routine c_madvise(addr: Addr, length: USize, advice: CInt) -> CInt

#[external("c"), symbol("sysconf"), target(os: not "windows")]
routine c_sysconf_posix(name: CInt) -> CLong

preset S_IFMT:   U32 = 0o170000
preset S_IFDIR:  U32 = 0o040000
preset S_IFREG:  U32 = 0o100000
preset S_IWUSR:  U32 = 0o200
preset S_IWGRP:  U32 = 0o020
preset S_IWOTH:  U32 = 0o002

preset PROT_READ:      CInt = 1
preset PROT_WRITE:     CInt = 2
preset MAP_SHARED:     CInt = 1
preset MAP_PRIVATE:    CInt = 2
preset MADV_SEQUENTIAL: CInt = 2
preset MADV_WILLNEED:  CInt = 3
preset O_RDONLY:       CInt = 0
preset O_WRONLY:       CInt = 1
preset O_RDWR:         CInt = 2
preset EEXIST:         CInt = 17
preset ERANGE:         CInt = 34

#target(os: "linux")
routine o_creat() -> CInt
    block entry():
        return(0x40)

#target(os: "macos")
routine o_creat() -> CInt
    block entry():
        return(0x200)

#target(os: "linux")
routine ms_sync() -> CInt
    block entry():
        return(4)

#target(os: "macos")
routine ms_sync() -> CInt
    block entry():
        return(0x10)

#target(os: "linux")
routine sc_page_size() -> CInt
    block entry():
        return(30)

#target(os: "macos")
routine sc_page_size() -> CInt
    block entry():
        return(29)

#target(os: "linux")
routine sc_phys_pages() -> CInt
    block entry():
        return(85)

#target(os: "macos")
routine sc_phys_pages() -> CInt
    block entry():
        return(200)

/// Where struct dirent's d_name is.
#target(os: "linux")
routine dirent_name() -> USize
    block entry():
        return(19)

#target(os: "macos")
routine dirent_name() -> USize
    block entry():
        return(21)

// -- struct stat ---------------------------------------------------------------------

/// What this runtime reads of a struct stat.
record StatInfo
    mode  : U32
    size  : S64
    mtime : S64
    ctime : S64

/// struct stat's mode, size, and modification and status-change seconds. glibc x86-64.
#target(os: "linux", arch: "x86_64")
routine read_stat(buf: @Byte) -> StatInfo
    block entry():
        info : StatInfo = StatInfo { mode: buf.stride(24).to<@U32>().load(), size: buf.stride(48).to<@S64>().load(),
                mtime: buf.stride(88).to<@S64>().load(), ctime: buf.stride(104).to<@S64>().load() }
        return(info)

/// The generic layout (aarch64, riscv64).
#target(os: "linux", arch: not "x86_64")
routine read_stat(buf: @Byte) -> StatInfo
    block entry():
        info : StatInfo = StatInfo { mode: buf.stride(16).to<@U32>().load(), size: buf.stride(48).to<@S64>().load(),
                mtime: buf.stride(88).to<@S64>().load(), ctime: buf.stride(104).to<@S64>().load() }
        return(info)

/// macOS (64-bit inodes): a 16-bit mode.
#target(os: "macos")
routine read_stat(buf: @Byte) -> StatInfo
    block entry():
        info : StatInfo = StatInfo { mode: buf.stride(4).to<@U16>().load().to<U32>(),
                size: buf.stride(96).to<@S64>().load(), mtime: buf.stride(48).to<@S64>().load(),
                ctime: buf.stride(64).to<@S64>().load() }
        return(info)

/// stat (or lstat) of the NUL-terminated path into info: whether it worked.
#target(os: not "windows")
routine stat_of(cpath: @Byte, follow: Bool, info: @StatInfo) -> Bool
    block entry():
        claim buf : @Array<U64, 32> <- uninit
        branch follow
            ? continue
            : link(buf.to<@Byte>())
        jump got(buf.to<@Byte>(), c_stat(cpath, buf.to<@Byte>()))

    block link(buf: @Byte):
        jump got(buf, c_lstat(cpath, buf))

    block got(buf: @Byte, rc: CInt):
        branch rc.eq(0)
            ? continue
            : return(false)
        info.store(read_stat(buf))
        return(true)

/// stat of a counted path: whether it worked.
#target(os: not "windows")
routine stat_path(path: @Byte, len: S32, info: @StatInfo) -> Bool
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(false)
            : continue
        ok : Bool = stat_of(cpath, true, info)
        c_free(cpath)
        return(ok)

#target(os: not "windows")
routine kind(mode: U32, k: U32) -> Bool
    block entry():
        return(mode.bitand(S_IFMT).eq(k))

// -- existence and kind ----------------------------------------------------------------

#[export("rf_fs_exists"), target(os: not "windows")]
routine rf_fs_exists(path: @Byte, len: S32) -> Bool
    block entry():
        claim info : @StatInfo <- uninit
        return(stat_path(path, len, info))

#[export("rf_fs_is_file"), target(os: not "windows")]
routine rf_fs_is_file(path: @Byte, len: S32) -> Bool
    block entry():
        claim info : @StatInfo <- uninit
        branch stat_path(path, len, info)
            ? return(kind(info.mode.load(), S_IFREG))
            : return(false)

#[export("rf_fs_is_directory"), target(os: not "windows")]
routine rf_fs_is_directory(path: @Byte, len: S32) -> Bool
    block entry():
        claim info : @StatInfo <- uninit
        branch stat_path(path, len, info)
            ? return(kind(info.mode.load(), S_IFDIR))
            : return(false)

/// access(2) with mode on a counted path.
#target(os: not "windows")
routine can(path: @Byte, len: S32, mode: CInt) -> Bool
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(false)
            : continue
        ok : Bool = c_access(cpath, mode).eq(0)
        c_free(cpath)
        return(ok)

#[export("rf_fs_can_read"), target(os: not "windows")]
routine rf_fs_can_read(path: @Byte, len: S32) -> Bool
    block entry():
        // R_OK
        return(can(path, len, 4))

#[export("rf_fs_can_write"), target(os: not "windows")]
routine rf_fs_can_write(path: @Byte, len: S32) -> Bool
    block entry():
        // W_OK
        return(can(path, len, 2))

#[export("rf_fs_can_execute"), target(os: not "windows")]
routine rf_fs_can_execute(path: @Byte, len: S32) -> Bool
    block entry():
        // X_OK
        return(can(path, len, 1))

/// Read-only takes every write bit away; writable gives the owner's back.
#[export("rf_fs_set_readonly"), target(os: not "windows")]
routine rf_fs_set_readonly(path: @Byte, len: S32, readonly: Bool) -> S32
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(-1)
            : continue
        claim info : @StatInfo <- uninit
        branch stat_of(cpath, true, info)
            ? continue
            : done(cpath, false)
        mode : U32 = info.mode.load()
        set  : U32 = readonly ? mode.bitand(S_IWUSR.bitor(S_IWGRP).bitor(S_IWOTH).bitnot()) : mode.bitor(S_IWUSR)
        jump done(cpath, c_chmod(cpath, set.bitand(0o7777)).eq(0))

    block done(cpath: @Byte, ok: Bool):
        c_free(cpath)
        branch ok
            ? return(0)
            : return(-1)

// -- directories ---------------------------------------------------------------------

#[export("rf_fs_create_dir"), target(os: not "windows")]
routine rf_fs_create_dir(path: @Byte, len: S32) -> S32
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(-1)
            : continue
        ok : Bool = c_mkdir(cpath, 0o755).eq(0)
        c_free(cpath)
        branch ok
            ? return(0)
            : return(-1)

/// Like mkdir -p: each component in turn, then the whole; it already existing is fine.
#[export("rf_fs_create_dir_all"), target(os: not "windows")]
routine rf_fs_create_dir_all(path: @Byte, len: S32) -> S32
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(-1)
            : continue
        branch is_sep(cpath.load())
            ? scan(cpath, 1)
            : scan(cpath, 0)

    block scan(cpath: @Byte, i: USize):
        c : Byte = cpath.stride(i).load()
        branch c.eq(0x00)
            ? last(cpath)
            : continue
        branch is_sep(c)
            ? make(cpath, i, c)
            : scan(cpath, i.add(1))

    block make(cpath: @Byte, i: USize, c: Byte):
        cpath.stride(i).store(0x00)
        c_mkdir(cpath, 0o755)
        cpath.stride(i).store(c)
        jump scan(cpath, i.add(1))

    block last(cpath: @Byte):
        ok : Bool = c_mkdir(cpath, 0o755).eq(0)
        branch ok
            ? done(cpath, true)
            : done(cpath, errno().eq(EEXIST))

    block done(cpath: @Byte, ok: Bool):
        c_free(cpath)
        branch ok
            ? return(0)
            : return(-1)

#[export("rf_fs_remove"), target(os: not "windows")]
routine rf_fs_remove(path: @Byte, len: S32) -> S32
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(-1)
            : continue
        claim info : @StatInfo <- uninit
        branch stat_of(cpath, true, info)
            ? continue
            : done(cpath, false)
        branch kind(info.mode.load(), S_IFDIR)
            ? done(cpath, c_rmdir(cpath).eq(0))
            : done(cpath, c_unlink(cpath).eq(0))

    block done(cpath: @Byte, ok: Bool):
        c_free(cpath)
        branch ok
            ? return(0)
            : return(-1)

/// A directory and everything in it (a link is removed, not followed), or a file.
#[export("rf_fs_remove_all"), target(os: not "windows")]
routine rf_fs_remove_all(path: @Byte, len: S32) -> S32
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(-1)
            : continue
        claim info : @StatInfo <- uninit
        branch stat_of(cpath, false, info)
            ? continue
            : done(cpath, false)
        branch kind(info.mode.load(), S_IFDIR)
            ? continue
            : done(cpath, c_unlink(cpath).eq(0))
        dir : Addr = c_opendir(cpath)
        branch dir.is_null()
            ? done(cpath, false)
            : next(cpath, dir)

    block next(cpath: @Byte, dir: Addr):
        entry : @Byte = c_readdir(dir)
        branch entry.is_null()
            ? finish(cpath, dir)
            : continue
        name : @Byte = entry.stride(dirent_name())
        branch is_dot_entry(name)
            ? next(cpath, dir)
            : continue
        child : @Byte = rf_fs_join_child(cpath, name, b'/')
        branch child.is_null()
            ? next(cpath, dir)
            : continue
        rf_fs_remove_all(child, c_strlen(child).to<S32>())
        c_free(child)
        jump next(cpath, dir)

    block finish(cpath: @Byte, dir: Addr):
        c_closedir(dir)
        jump done(cpath, c_rmdir(cpath).eq(0))

    block done(cpath: @Byte, ok: Bool):
        c_free(cpath)
        branch ok
            ? return(0)
            : return(-1)

/// The entries; typed stats each one for its kind and modification time, as readdir gives neither portably.
#target(os: not "windows")
routine list_directory(path: @Byte, len: S32, typed: Bool) -> @Byte
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(no_result())
            : continue
        claim out : @Listing <- Listing { buf: null, len: 0, cap: 0 }
        branch out.start()
            ? continue
            : fail(cpath, out)
        dir : Addr = c_opendir(cpath)
        branch dir.is_null()
            ? fail(cpath, out)
            : next(cpath, out, dir)

    block next(cpath: @Byte, out: @Listing, dir: Addr):
        entry : @Byte = c_readdir(dir)
        branch entry.is_null()
            ? finish(cpath, out, dir)
            : continue
        name : @Byte = entry.stride(dirent_name())
        branch is_dot_entry(name)
            ? next(cpath, out, dir)
            : continue
        branch typed
            ? stat_entry(cpath, out, dir, name)
            : add(cpath, out, dir, name, false, 0)

    block stat_entry(cpath: @Byte, out: @Listing, dir: Addr, name: @Byte):
        full : @Byte = rf_fs_join_child(cpath, name, b'/')
        branch full.is_null()
            ? add(cpath, out, dir, name, false, 0)
            : continue
        claim info : @StatInfo <- StatInfo { mode: 0, size: 0, mtime: 0, ctime: 0 }
        stat_of(full, true, info)
        c_free(full)
        jump add(cpath, out, dir, name, kind(info.mode.load(), S_IFDIR), info.mtime.load())

    block add(cpath: @Byte, out: @Listing, dir: Addr, name: @Byte, is_dir: Bool, mtime: S64):
        branch out.entry(name, typed, is_dir, mtime)
            ? next(cpath, out, dir)
            : broke(cpath, out, dir)

    block finish(cpath: @Byte, out: @Listing, dir: Addr):
        c_closedir(dir)
        c_free(cpath)
        return(out.finish())

    block broke(cpath: @Byte, out: @Listing, dir: Addr):
        c_closedir(dir)
        jump fail(cpath, out)

    block fail(cpath: @Byte, out: @Listing):
        c_free(cpath)
        c_free(out.buf.load())
        return(no_result())

#[export("rf_fs_list_dir"), target(os: not "windows")]
routine rf_fs_list_dir(path: @Byte, len: S32) -> @Byte
    block entry():
        return(list_directory(path, len, false))

#[export("rf_fs_list_dir_typed"), target(os: not "windows")]
routine rf_fs_list_dir_typed(path: @Byte, len: S32) -> @Byte
    block entry():
        return(list_directory(path, len, true))

// -- copy and move ---------------------------------------------------------------------

/// Copies the bytes of from into to (made or truncated): whether both opened.
#target(os: not "windows")
routine copy_file(from: @Byte, to: @Byte) -> Bool
    block entry():
        fin : Addr = c_fopen(from, "rb")
        branch fin.is_null()
            ? return(false)
            : continue
        fout : Addr = c_fopen(to, "wb")
        branch fout.is_null()
            ? closed(fin)
            : continue
        claim buf : @Array<Byte, 8192> <- uninit
        jump chunk(fin, fout, buf.to<@Byte>())

    block chunk(fin: Addr, fout: Addr, buf: @Byte):
        n : USize = c_fread(buf, 1, 8192, fin)
        branch n.gt(0)
            ? continue
            : done(fin, fout)
        c_fwrite(buf, 1, n, fout)
        jump chunk(fin, fout, buf)

    block done(fin: Addr, fout: Addr):
        c_fclose(fin)
        c_fclose(fout)
        return(true)

    block closed(fin: Addr):
        c_fclose(fin)
        return(false)

#[export("rf_fs_copy"), target(os: not "windows")]
routine rf_fs_copy(src: @Byte, src_len: S32, dst: @Byte, dst_len: S32) -> S32
    block entry():
        a : @Byte = strdupn(src, src_len)
        b : @Byte = strdupn(dst, dst_len)
        branch a.is_not_null().bitand(b.is_not_null())
            ? continue
            : done(a, b, false)
        jump done(a, b, copy_file(a, b))

    block done(a: @Byte, b: @Byte, ok: Bool):
        c_free(a)
        c_free(b)
        branch ok
            ? return(0)
            : return(-1)

/// rename, or across filesystems a copy and an unlink.
#target(os: not "windows")
routine move_file(a: @Byte, b: @Byte) -> Bool
    block entry():
        branch c_rename(a, b).eq(0)
            ? return(true)
            : continue
        branch copy_file(a, b)
            ? continue
            : return(false)
        c_unlink(a)
        return(true)

#[export("rf_fs_move"), target(os: not "windows")]
routine rf_fs_move(src: @Byte, src_len: S32, dst: @Byte, dst_len: S32) -> S32
    block entry():
        a : @Byte = strdupn(src, src_len)
        b : @Byte = strdupn(dst, dst_len)
        branch a.is_not_null().bitand(b.is_not_null())
            ? continue
            : done(a, b, false)
        jump done(a, b, move_file(a, b))

    block done(a: @Byte, b: @Byte, ok: Bool):
        c_free(a)
        c_free(b)
        branch ok
            ? return(0)
            : return(-1)

/// 0 moved, 1 the destination exists (nothing moved), -1 an error. POSIX's rename replaces, so the destination is
/// looked at first.
#[export("rf_fs_move_no_replace"), target(os: not "windows")]
routine rf_fs_move_no_replace(src: @Byte, src_len: S32, dst: @Byte, dst_len: S32) -> S32
    block entry():
        a : @Byte = strdupn(src, src_len)
        b : @Byte = strdupn(dst, dst_len)
        branch a.is_not_null().bitand(b.is_not_null())
            ? continue
            : done(a, b, -1)
        claim info : @StatInfo <- uninit
        branch stat_of(b, true, info)
            ? done(a, b, 1)
            : continue
        branch move_file(a, b)
            ? done(a, b, 0)
            : done(a, b, -1)

    block done(a: @Byte, b: @Byte, code: S32):
        c_free(a)
        c_free(b)
        return(code)

// -- metadata --------------------------------------------------------------------------

/// POSIX has no portable creation time: the status-change time stands in.
#[export("rf_fs_metadata"), target(os: not "windows")]
routine rf_fs_metadata(path: @Byte, len: S32) -> S32
    block entry():
        claim info : @StatInfo <- uninit
        branch stat_path(path, len, info)
            ? continue
            : return(-1)
        i : StatInfo = info.load()
        META_SIZE.store(i.size)
        META_MODIFIED.store(i.mtime)
        META_CREATED.store(i.ctime)
        META_IS_DIRECTORY.store(kind(i.mode, S_IFDIR))
        META_READONLY.store(i.mode.bitand(S_IWUSR).eq(0))
        return(0)

#[export("rf_fs_file_size"), target(os: not "windows")]
routine rf_fs_file_size(path: @Byte, len: S32) -> S64
    block entry():
        claim info : @StatInfo <- uninit
        branch stat_path(path, len, info)
            ? return(info.size.load())
            : return(-1)

// -- the working directory and standard directories ------------------------------------

#[export("rf_fs_current_dir"), target(os: not "windows")]
routine rf_fs_current_dir() -> @Byte
    block entry():
        jump attempt(256)

    block attempt(cap: USize):
        buf : Addr = c_malloc(cap)
        branch buf.is_null()
            ? return(no_result())
            : continue
        branch c_getcwd(buf.to<@Byte>(), cap).is_not_null()
            ? return(result(buf.to<@Byte>(), c_strlen(buf.to<@Byte>())))
            : continue
        c_free(buf)
        branch errno().eq(ERANGE)
            ? attempt(cap.mul(2))
            : return(no_result())

#[export("rf_fs_set_current_dir"), target(os: not "windows")]
routine rf_fs_set_current_dir(path: @Byte, len: S32) -> S32
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(-1)
            : continue
        ok : Bool = c_chdir(cpath).eq(0)
        c_free(cpath)
        branch ok
            ? return(0)
            : return(-1)

/// TMPDIR, or /tmp.
#[export("rf_fs_temp_dir"), target(os: not "windows")]
routine rf_fs_temp_dir() -> @Byte
    block entry():
        t : @Byte = c_getenv("TMPDIR")
        branch nonempty(t)
            ? return(dup_result(t))
            : continue
        claim fixed : @Array<Byte, 5> <- { 0x2F, 0x74, 0x6D, 0x70, 0x00 }
        return(dup_result(fixed.to<@Byte>()))

/// Makes the file if it is missing, and sets its access and modification times to now.
#[export("rf_fs_touch"), target(os: not "windows")]
routine rf_fs_touch(path: @Byte, len: S32) -> S32
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(-1)
            : continue
        fd : CInt = c_open_mode(cpath, O_WRONLY.bitor(o_creat()), 0o644)
        branch fd.lt(0)
            ? done(cpath, false)
            : continue
        c_close(fd)
        jump done(cpath, c_utimes(cpath, null).eq(0))

    block done(cpath: @Byte, ok: Bool):
        c_free(cpath)
        branch ok
            ? return(0)
            : return(-1)

#[external("c"), symbol("open"), variadic, target(os: not "windows")]
routine c_open_mode(path: @Byte, flags: CInt, mode: CInt) -> CInt

#[external("c"), symbol("open"), variadic, target(os: not "windows")]
routine c_open_path(path: @Byte, flags: CInt) -> CInt

/// realpath; for a path that doesn't exist, the working directory and the path joined.
#[export("rf_fs_absolute_path"), target(os: not "windows")]
routine rf_fs_absolute_path(path: @Byte, len: S32) -> @Byte
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(no_result())
            : continue
        resolved : @Byte = c_realpath(cpath, null)
        branch resolved.is_null()
            ? compose(cpath)
            : continue
        c_free(cpath)
        return(result(resolved, c_strlen(resolved)))

    block compose(cpath: @Byte):
        claim cwd : @Array<Byte, 4096> <- uninit
        branch c_getcwd(cwd.to<@Byte>(), 4096).is_null()
            ? failed(cpath)
            : continue
        joined : @Byte = rf_fs_join_child(cwd.to<@Byte>(), cpath, b'/')
        c_free(cpath)
        branch joined.is_null()
            ? return(no_result())
            : return(result(joined, c_strlen(joined)))

    block failed(cpath: @Byte):
        c_free(cpath)
        return(no_result())

#[export("rf_fs_canonical_path"), target(os: not "windows")]
routine rf_fs_canonical_path(path: @Byte, len: S32) -> @Byte
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(no_result())
            : continue
        resolved : @Byte = c_realpath(cpath, null)
        c_free(cpath)
        branch resolved.is_null()
            ? return(no_result())
            : return(result(resolved, c_strlen(resolved)))

// -- memory-mapped files ---------------------------------------------------------------

/// Half the physical memory (see the Windows side), or 0.
#target(os: not "windows")
routine prefault_budget() -> U64
    block entry():
        pages : CLong = c_sysconf_posix(sc_phys_pages())
        size  : CLong = c_sysconf_posix(sc_page_size())
        branch pages.le(0).bitor(size.le(0))
            ? return(0)
            : return(pages.to<U64>().mul(size.to<U64>()).div(2))

#target(os: not "windows")
routine map_failed(p: Addr) -> Bool
    block entry():
        return(ptrtoint<Addr, U64>(p).eq(U64.MAX))

/// A whole file mapped (see the Windows side). Read-only views get a sequential hint and, within the prefault
/// budget, a request to read ahead.
#target(os: not "windows")
routine map_whole(path: @Byte, len: S32, write: Bool) -> @Byte
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(no_result())
            : continue
        fd : CInt = c_open_path(cpath, write ? O_RDWR : O_RDONLY)
        c_free(cpath)
        branch fd.lt(0)
            ? return(no_result())
            : continue
        claim buf : @Array<U64, 32> <- uninit
        branch c_fstat(fd, buf.to<@Byte>()).eq(0)
            ? continue
            : closed(fd)
        size : USize = read_stat(buf.to<@Byte>()).size.to<USize>()
        branch size.eq(0)
            ? empty(fd)
            : continue
        prot  : CInt = write ? PROT_READ.bitor(PROT_WRITE) : PROT_READ
        flags : CInt = write ? MAP_SHARED : MAP_PRIVATE
        p : Addr = c_mmap(null, size, prot, flags, fd, 0)
        c_close(fd)
        branch map_failed(p)
            ? return(no_result())
            : continue
        branch write
            ? mapped(p, size)
            : continue
        branch size.to<U64>().le(prefault_budget())
            ? continue
            : sequential(p, size)
        c_madvise(p, size, MADV_WILLNEED)
        jump sequential(p, size)

    block sequential(p: Addr, size: USize):
        c_madvise(p, size, MADV_SEQUENTIAL)
        jump mapped(p, size)

    block mapped(p: Addr, size: USize):
        return(result(p.to<@Byte>(), size))

    block closed(fd: CInt):
        c_close(fd)
        return(no_result())

    block empty(fd: CInt):
        c_close(fd)
        RESULT_LEN.store(0)
        return(empty_map())

/// A window of a file (see the Windows side), aligned down to the page size.
#target(os: not "windows")
routine map_window(path: @Byte, len: S32, offset: USize, length: USize, write: Bool) -> @Byte
    block entry():
        MAP_DELTA.store(0)
        ps      : CLong = c_sysconf_posix(sc_page_size())
        page    : USize = ps.gt(0) ? ps.to_clamp<USize>() : 4096
        aligned : USize = offset.sub(offset.mod(page))
        delta   : USize = offset.sub(aligned)
        cpath   : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(no_result())
            : continue
        fd : CInt = c_open_path(cpath, write ? O_RDWR : O_RDONLY)
        c_free(cpath)
        branch fd.lt(0)
            ? return(no_result())
            : continue
        claim buf : @Array<U64, 32> <- uninit
        branch c_fstat(fd, buf.to<@Byte>()).eq(0)
            ? continue
            : closed(fd)
        filesize : USize = read_stat(buf.to<@Byte>()).size.to<USize>()
        branch offset.ge(filesize)
            ? empty(fd)
            : continue
        want : USize = length.min(filesize.sub(offset))
        branch want.eq(0)
            ? empty(fd)
            : continue
        maplen : USize = want.add(delta)
        prot   : CInt  = write ? PROT_READ.bitor(PROT_WRITE) : PROT_READ
        flags  : CInt  = write ? MAP_SHARED : MAP_PRIVATE
        p : Addr = c_mmap(null, maplen, prot, flags, fd, aligned.to<S64>())
        c_close(fd)
        branch map_failed(p)
            ? return(no_result())
            : continue
        branch write
            ? done(p, want, delta)
            : hint(p, maplen, want, delta)

    block hint(p: Addr, maplen: USize, want: USize, delta: USize):
        c_madvise(p, maplen, MADV_SEQUENTIAL)
        jump done(p, want, delta)

    block done(p: Addr, want: USize, delta: USize):
        MAP_DELTA.store(delta)
        return(result(p.to<@Byte>(), want))

    block closed(fd: CInt):
        c_close(fd)
        return(no_result())

    block empty(fd: CInt):
        c_close(fd)
        RESULT_LEN.store(0)
        return(empty_map())

#[export("rf_file_map_path"), target(os: not "windows")]
routine rf_file_map_path(path: @Byte, path_len: S32) -> @Byte
    block entry():
        return(map_whole(path, path_len, false))

#[export("rf_file_map_path_rw"), target(os: not "windows")]
routine rf_file_map_path_rw(path: @Byte, path_len: S32) -> @Byte
    block entry():
        return(map_whole(path, path_len, true))

#[export("rf_file_map_path_range"), target(os: not "windows")]
routine rf_file_map_path_range(path: @Byte, path_len: S32, offset: USize, length: USize) -> @Byte
    block entry():
        return(map_window(path, path_len, offset, length, false))

#[export("rf_file_map_path_range_rw"), target(os: not "windows")]
routine rf_file_map_path_range_rw(path: @Byte, path_len: S32, offset: USize, length: USize) -> @Byte
    block entry():
        return(map_window(path, path_len, offset, length, true))

/// Writes dirty pages back, then unmaps. A null view or length 0 (the empty marker) does nothing.
#[export("rf_file_unmap"), target(os: not "windows")]
routine rf_file_unmap(ptr: @Byte, len: USize) -> Void
    block entry():
        branch ptr.is_null().bitor(len.eq(0))
            ? return()
            : continue
        c_msync(ptr, len, ms_sync())
        c_munmap(ptr, len)
        return()

#[export("rf_file_map_flush"), target(os: not "windows")]
routine rf_file_map_flush(ptr: @Byte, len: USize) -> Void
    block entry():
        branch ptr.is_null().bitor(len.eq(0))
            ? return()
            : continue
        c_msync(ptr, len, ms_sync())
        return()

#[export("rf_fs_set_size"), target(os: not "windows")]
routine rf_fs_set_size(path: @Byte, path_len: S32, size: USize) -> S32
    block entry():
        cpath : @Byte = strdupn(path, path_len)
        branch cpath.is_null()
            ? return(-1)
            : continue
        fd : CInt = c_open_mode(cpath, O_WRONLY.bitor(o_creat()), 0o644)
        c_free(cpath)
        branch fd.lt(0)
            ? return(-1)
            : continue
        ok : Bool = c_ftruncate(fd, size.to<S64>()).eq(0)
        c_close(fd)
        branch ok
            ? return(0)
            : return(-1)
