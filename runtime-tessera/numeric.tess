# Small things the standard library binds: the platform libm's exact float operations (remainder, fdim, nextafter,
# scalbn, ilogb, and the B64 cbrt that seeds B128's Newton step), a cryptographically random word (from Tessera's
# entropy_key), the wall-clock time, and two helpers the FFI tests call with a struct holding a callback.

module Ingrid/Runtime

import Standard/Os

# -- libm ----------------------------------------------------------------------------

### libm's `remainderf`: `x - n * y` with `n` the integer nearest `x / y` (ties to even).
### :param x: The dividend.
### :param y: The divisor.
### :returns: The IEEE remainder.
@external("c")
@symbol("remainderf")
routine c_remainderf(x: B32, y: B32) -> B32

### libm's `fdimf`: the positive difference of `x` and `y`.
### :param x: The first value.
### :param y: The second value.
### :returns: `x - y` when `x > y`, else +0.
@external("c")
@symbol("fdimf")
routine c_fdimf(x: B32, y: B32) -> B32

### libm's `nextafterf`: the next representable B32 after `x` in the direction of `y`.
### :param x: The starting value.
### :param y: The direction.
### :returns: The neighbor of `x` toward `y`, or `y` when the two are equal.
@external("c")
@symbol("nextafterf")
routine c_nextafterf(x: B32, y: B32) -> B32

### libm's `scalbnf`: `x` times 2 to the `n`.
### :param x: The value to scale.
### :param n: The power of two.
### :returns: `x * 2^n`, correctly rounded.
@external("c")
@symbol("scalbnf")
routine c_scalbnf(x: B32, n: CInt) -> B32

### libm's `ilogbf`: the unbiased binary exponent of `x`.
### :param x: The value.
### :returns: The exponent, or the C library's FP_ILOGB0 / FP_ILOGBNAN / INT_MAX for zero, NaN, and infinity.
@external("c")
@symbol("ilogbf")
routine c_ilogbf(x: B32) -> CInt

### libm's `cbrt`: the cube root of `x`.
### :param x: The value.
### :returns: The real cube root.
@external("c")
@symbol("cbrt")
routine c_cbrt(x: B64) -> B64

### libm's `remainder`: `x - n * y` with `n` the integer nearest `x / y` (ties to even).
### :param x: The dividend.
### :param y: The divisor.
### :returns: The IEEE remainder.
@external("c")
@symbol("remainder")
routine c_remainder(x: B64, y: B64) -> B64

### libm's `fdim`: the positive difference of `x` and `y`.
### :param x: The first value.
### :param y: The second value.
### :returns: `x - y` when `x > y`, else +0.
@external("c")
@symbol("fdim")
routine c_fdim(x: B64, y: B64) -> B64

### libm's `nextafter`: the next representable B64 after `x` in the direction of `y`.
### :param x: The starting value.
### :param y: The direction.
### :returns: The neighbor of `x` toward `y`, or `y` when the two are equal.
@external("c")
@symbol("nextafter")
routine c_nextafter(x: B64, y: B64) -> B64

### libm's `scalbn`: `x` times 2 to the `n`.
### :param x: The value to scale.
### :param n: The power of two.
### :returns: `x * 2^n`, correctly rounded.
@external("c")
@symbol("scalbn")
routine c_scalbn(x: B64, n: CInt) -> B64

### libm's `ilogb`: the unbiased binary exponent of `x`.
### :param x: The value.
### :returns: The exponent, or the C library's FP_ILOGB0 / FP_ILOGBNAN / INT_MAX for zero, NaN, and infinity.
@external("c")
@symbol("ilogb")
routine c_ilogb(x: B64) -> CInt

### The IEEE remainder of `x` by `y`, from libm.
### :param x: The dividend.
### :param y: The divisor.
### :returns: `x - n * y` with `n` the integer nearest `x / y`.
@export("rf_b32_remainder")
routine rf_b32_remainder(x: B32, y: B32) -> B32
    return c_remainderf(x, y)

### The positive difference of `x` and `y`, from libm.
### :param x: The first value.
### :param y: The second value.
### :returns: `x - y` when `x > y`, else +0.
@export("rf_b32_fdim")
routine rf_b32_fdim(x: B32, y: B32) -> B32
    return c_fdimf(x, y)

### The next representable B32 after `x` toward `y`, from libm.
### :param x: The starting value.
### :param y: The direction.
### :returns: The neighbor of `x` toward `y`, or `y` when the two are equal.
@export("rf_b32_nextafter")
routine rf_b32_nextafter(x: B32, y: B32) -> B32
    return c_nextafterf(x, y)

### `x` times 2 to the `n`, from libm. An exponent beyond what C's int holds overflows or underflows the same either
### way, so it is clamped.
### :param x: The value to scale.
### :param n: The power of two.
### :returns: `x * 2^n`, correctly rounded.
@export("rf_b32_scalbn")
routine rf_b32_scalbn(x: B32, n: S64) -> B32
    return c_scalbnf(x, n.to_clamp[CInt]())

### The unbiased binary exponent of `x`, from libm.
### :param x: The value.
### :returns: The exponent, or the C library's special values for zero, NaN, and infinity, widened to S64.
@export("rf_b32_ilogb")
routine rf_b32_ilogb(x: B32) -> S64
    return c_ilogbf(x).to[S64]()

### The cube root of `x`, from libm (the seed of B128's Newton step).
### :param x: The value.
### :returns: The real cube root.
@export("rf_b64_cbrt")
routine rf_b64_cbrt(x: B64) -> B64
    return c_cbrt(x)

### The IEEE remainder of `x` by `y`, from libm.
### :param x: The dividend.
### :param y: The divisor.
### :returns: `x - n * y` with `n` the integer nearest `x / y`.
@export("rf_b64_remainder")
routine rf_b64_remainder(x: B64, y: B64) -> B64
    return c_remainder(x, y)

### The positive difference of `x` and `y`, from libm.
### :param x: The first value.
### :param y: The second value.
### :returns: `x - y` when `x > y`, else +0.
@export("rf_b64_fdim")
routine rf_b64_fdim(x: B64, y: B64) -> B64
    return c_fdim(x, y)

### The next representable B64 after `x` toward `y`, from libm.
### :param x: The starting value.
### :param y: The direction.
### :returns: The neighbor of `x` toward `y`, or `y` when the two are equal.
@export("rf_b64_nextafter")
routine rf_b64_nextafter(x: B64, y: B64) -> B64
    return c_nextafter(x, y)

### `x` times 2 to the `n`, from libm. An exponent beyond what C's int holds is clamped, which overflows or underflows
### the same way.
### :param x: The value to scale.
### :param n: The power of two.
### :returns: `x * 2^n`, correctly rounded.
@export("rf_b64_scalbn")
routine rf_b64_scalbn(x: B64, n: S64) -> B64
    return c_scalbn(x, n.to_clamp[CInt]())

### The unbiased binary exponent of `x`, from libm.
### :param x: The value.
### :returns: The exponent, or the C library's special values for zero, NaN, and infinity, widened to S64.
@export("rf_b64_ilogb")
routine rf_b64_ilogb(x: B64) -> S64
    return c_ilogb(x).to[S64]()

# -- a random word -------------------------------------------------------------------

### 64 cryptographically random bits from the operating system, from the source Tessera's hash key comes from
### (`entropy_key()`: getrandom on Linux, arc4random_buf on macOS, ProcessPrng on Windows), drawn anew on every call.
### :returns: The random word.
### :throws: Crashes with `InvalidValueError` when the operating system gives no random bytes (getrandom failing on
###     Linux, no ProcessPrng before Windows 10), instead of handing back a word that isn't random.
@export("rf_random_u64")
routine rf_random_u64() -> U64
    key: SipKey = entropy_key()
    return key.k0

# -- the wall clock ------------------------------------------------------------------

### The time between 1601-01-01 (a FILETIME's start) and the Unix epoch, in 100 ns ticks.
preset EPOCH_TICKS: U64 = 116444736000000000

### rf_Moment: seconds since the Unix epoch and the nanoseconds after them.
record Moment
    seconds: S64
    nanoseconds: U32

record FileTime
    low: U32
    high: U32

### Windows' `GetSystemTimePreciseAsFileTime`: the current UTC time in 100 ns ticks since 1601-01-01.
### :param time: Where the time goes.
@external("c")
@symbol("GetSystemTimePreciseAsFileTime")
@callconv("stdcall")
@target(os: "windows")
routine c_get_system_time_precise_as_file_time(time: @FileTime) -> None

### The Moment a FILETIME stands for. A time before 1970 has negative seconds and nanoseconds counted forward from
### them, in [0, 10^9), as POSIX's timespec has.
### :param file_time: 100 ns ticks since 1601-01-01 (Windows keeps them below 2^63).
### :returns: The seconds since the Unix epoch and the nanoseconds after them.
routine moment_from_file_time(file_time: U64) -> Moment
    ticks: S64 = file_time.to_wrap[S64]() - EPOCH_TICKS.to[S64]()
    seconds: S64 = ticks.div(10000000)
    sub_second_ticks: S64 = ticks.mod(10000000)
    return Moment(seconds: seconds, nanoseconds: (sub_second_ticks * 100).to[U32]())

### The current wall-clock time, from the system's precise FILETIME.
### :returns: The seconds since the Unix epoch and the nanoseconds after them, negative seconds before 1970.
@export("rf_moment_now")
@target(os: "windows")
routine rf_moment_now() -> Moment
    local ft: @FileTime <- FileTime(low: 0, high: 0)
    c_get_system_time_precise_as_file_time(ft)
    high_part: U64 = ft.high.peek().to[U64]()
    file_time: U64 = (high_part << 32) | ft.low.peek().to[U64]()
    return moment_from_file_time(file_time)

### POSIX `clock_gettime`: the time of `clock`.
### :param clock: The clock id.
### :param out: Where the time goes.
### :returns: 0 on success, -1 on error.
@external("c")
@symbol("clock_gettime")
@target(os: not "windows")
routine c_clock_gettime_real(clock: CInt, out: @Timespec) -> CInt

### The current wall-clock time, from `CLOCK_REALTIME`.
### :returns: The seconds since the Unix epoch and the nanoseconds after them.
@export("rf_moment_now")
@target(os: not "windows")
routine rf_moment_now() -> Moment
    local ts: @Timespec <- Timespec(sec: 0, nsec: 0)
    # CLOCK_REALTIME
    c_clock_gettime_real(0, ts)
    now: Moment = Moment(seconds: ts.sec.peek().to[S64](), nanoseconds: ts.nsec.peek().to_wrap[U32]())
    return now

# -- FFI test helpers ----------------------------------------------------------------
#
# A C API that keeps a callback and its userdata in a struct and calls cb(arg, ud): RazorForge's routine value is
# the pair { fn, bound }, which lays out as that struct, so a record with a Routine field goes to such an API as it
# is. These two exist only for the tests that check it.

record CallbackInfo
    cb: Callable[(S32, Addr), S32]
    ud: Addr

### Makes a `CallbackInfo` from its fields.
### :param cb: Its `cb`.
### :param ud: Its `ud`.
### :returns: The new value.
routine CallbackInfo.construct(cb: Callable[(S32, Addr), S32], ud: Addr) -> Me
    return Me(cb, ud)

### Releases nothing: a `CallbackInfo` holds no memory of its own.
routine CallbackInfo.destruct(me: @Me) -> None
    return

### Calls the callback in `info` with `arg` and the userdata in `info`, for the FFI tests.
### :param info: The callback and its userdata.
### :param arg: The first argument of the callback.
### :returns: What the callback returns.
@export("rf_test_invoke_cbinfo")
routine rf_test_invoke_cbinfo(info: @CallbackInfo, arg: S32) -> S32
    cb: Callable[(S32, Addr), S32] = info.cb.peek()
    return cb.call(arg, info.ud.peek())

### Calls the callback in `info` with `arg` and the userdata in `info`, for the FFI tests. The struct is passed by
### value.
### :param info: The callback and its userdata.
### :param arg: The first argument of the callback.
### :returns: What the callback returns.
@export("rf_test_invoke_cbinfo_byval")
routine rf_test_invoke_cbinfo_byval(info: CallbackInfo, arg: S32) -> S32
    cb: Callable[(S32, Addr), S32] = info.cb
    return cb.call(arg, info.ud)
