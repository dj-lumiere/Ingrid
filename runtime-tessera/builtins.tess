# What the in-process JIT resolves from this library that a native build gets from compiler-rt: emulated thread-local
# storage (__emutls_get_address). The JIT looks it up in this library's exports. (The B16 and BF16 conversions come
# from Tessera's standard library, which exports them on Windows.) 128-bit division isn't here: the standard
# libraries divide U128 and S128 on U64 limbs, so no LLVM 128-bit divide (and no __udivti3) is left to resolve, and
# a native build that still has one gets compiler-rt's.

module Ingrid/Runtime

import Standard/Os

# -- emulated thread-local storage ---------------------------------------------------
#
# LLVM's JIT lowers thread_local globals to the emulated-TLS ABI, which calls __emutls_get_address with the
# variable's control block. A native build gets it from compiler-rt. The JIT gets this one, compiler-rt's accessor
# redone, with this library's own (real) thread-locals for each thread's objects.

@threadlocal
global EMUTLS: @@EmutlsArray
global EMUTLS_LOCK: @ExclusiveLock
global EMUTLS_NEXT: @USize

### compiler-rt's control block: the object's size and alignment, its 1-based slot (0 until first use), and its
### initial value or null for zeros.
record EmutlsControl
    size: USize
    align: USize
    index: USize
    value: Addr

### One thread's objects, by slot.
record EmutlsArray
    size: USize
    data: @Addr

### Makes a `EmutlsControl` from its fields.
### :param size: Its `size`.
### :param align: Its `align`.
### :param index: Its `index`.
### :param value: Its `value`.
### :returns: The new value.
routine EmutlsControl.construct(size: USize, align: USize, index: USize, value: Addr) -> Me
    return Me(size, align, index, value)

### Releases nothing: a `EmutlsControl` holds no memory of its own.
routine EmutlsControl.destruct(me: @Me) -> None
    return

### Makes a `EmutlsArray` from its fields.
### :param size: Its `size`.
### :param data: Its `data`.
### :returns: The new value.
routine EmutlsArray.construct(size: USize, data: @Addr) -> Me
    return Me(size, data)

### Releases nothing: a `EmutlsArray` holds no memory of its own.
routine EmutlsArray.destruct(me: @Me) -> None
    return

### The C runtime's `_aligned_malloc` on Windows: `size` bytes aligned to `align`.
### :param size: The size in bytes.
### :param align: The alignment, a power of two.
### :returns: The block, or null when the allocation fails.
@external("c")
@symbol("_aligned_malloc")
@target(os: "windows")
routine c_aligned_malloc(size: USize, align: USize) -> Addr

### POSIX `posix_memalign`: allocates `size` bytes aligned to `align` and stores the block in `out`.
### :param out: Where the block's address goes.
### :param align: The alignment, a power of two and a multiple of the pointer size.
### :param size: The size in bytes.
### :returns: 0 on success, an error number otherwise.
@external("c")
@symbol("posix_memalign")
@target(os: not "windows")
routine c_posix_memalign(out: @Addr, align: USize, size: USize) -> CInt

### C's `memset`: fills `n` bytes at `dst` with the low byte of `value`.
### :param dst: The memory to fill.
### :param value: The byte value to fill with.
### :param n: The number of bytes.
### :returns: `dst`.
@external("c")
@symbol("memset")
routine c_memset(dst: Addr, value: CInt, n: USize) -> Addr

### Allocates `size` bytes aligned to `align`, raised to at least the pointer size, through `_aligned_malloc`.
### :param size: The size in bytes.
### :param align: The wanted alignment.
### :returns: The block, or null when the allocation fails.
@target(os: "windows")
routine aligned_alloc(size: USize, align: USize) -> Addr
    return c_aligned_malloc(size, align.max(sizeof[Addr]()))

### Allocates `size` bytes aligned to `align`, raised to at least the pointer size, through `posix_memalign`.
### :param size: The size in bytes.
### :param align: The wanted alignment.
### :returns: The block, or null when the allocation fails.
@target(os: not "windows")
routine aligned_alloc(size: USize, align: USize) -> Addr
    local p: @Addr <- null
    if c_posix_memalign(p, align.max(sizeof[Addr]()), size) == 0
        return p.peek()
    else
        return null

### This thread's object for `control`, made (from its initial value, or zeroed) on the thread's first use. The
### first use of `control` on any thread gives it the next free slot.
### :param control: The thread-local variable's control block.
### :returns: The calling thread's copy of the variable.
### :throws: Crashes with `OutOfMemoryError` when the thread's slot table, its growth, or the object can't be
###     allocated.
@export("__emutls_get_address")
routine emutls_get_address(control: @EmutlsControl) -> Addr
    index: USize = control.index.peek_atomic()
    if index == 0
        jump assign()
    else
        jump array(index)

    block assign()
        EMUTLS_LOCK.lock()
        current: USize = control.index.peek()
        if not (current == 0)
            jump assigned(current)
        next: USize = EMUTLS_NEXT.peek() + 1
        EMUTLS_NEXT.poke(next)
        control.index.poke_atomic(next)
        jump assigned(next)

    block assigned(index: USize)
        EMUTLS_LOCK.unlock()
        jump array(index)

    block array(index: USize)
        arr: @EmutlsArray = EMUTLS.peek()
        if arr.is_null()
            jump fresh(index)
        else
            jump sized(arr, index)

    block fresh(index: USize)
        made: @EmutlsArray = zeroed[EmutlsArray](count: 1, what: "Failed to allocate thread-local storage")
        EMUTLS.poke(made)
        jump sized(made, index)

    block sized(arr: @EmutlsArray, index: USize)
        have: USize = arr.size.peek()
        if not (have < index)
            jump object(arr, index)
        grown: Addr = c_realloc(arr.data.peek(), index * sizeof[Addr]())
        if grown.is_null()
            rf_throw(error_type: "OutOfMemoryError", message: "Failed to grow thread-local storage")
        c_memset(grown.to[@Byte]().stride(have * sizeof[Addr]()), 0, (index - have) * sizeof[Addr]())
        arr.data.poke(grown.to[@Addr]())
        arr.size.poke(index)
        jump object(arr, index)

    block object(arr: @EmutlsArray, index: USize)
        slot: @Addr = arr.data.peek().stride(index - 1)
        obj: Addr = slot.peek()
        if obj.is_null()
            jump make(slot)
        else
            return obj

    block make(slot: @Addr)
        size: USize = control.size.peek()
        made: Addr = aligned_alloc(size, align: control.align.peek())
        if made.is_null()
            rf_throw(error_type: "OutOfMemoryError", message: "Failed to allocate a thread-local variable")
        init: Addr = control.value.peek()
        if init.is_null()
            jump zero(slot, made, size)
        c_memcpy(made, init, size)
        slot.poke(made)
        return made

    block zero(slot: @Addr, made: Addr, size: USize)
        c_memset(made, 0, size)
        slot.poke(made)
        return made
