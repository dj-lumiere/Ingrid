# The older context entry points, and waitfor on a plain thread.

module Ingrid/Runtime

import Hosted

record ContextRuntime
    reserved: U64

### The name of the context-switch backend. Coroutines switch through Fiber's switch_stack, on every
### operating system.
### :returns: `"tessera"`.
@export("rf_context_backend_name")
routine rf_context_backend_name() -> CStrView
    return "tessera"

### Whether the context-switch backend is available.
### :returns: Always 1 (available).
@export("rf_context_backend_state")
routine rf_context_backend_state() -> CInt
    return 1

### Creates the placeholder runtime object the older context entry points pass around.
### :returns: A zeroed `ContextRuntime`.
### :throws: Crashes with `OutOfMemoryError` when the allocation fails.
@export("rf_context_runtime_create")
routine rf_context_runtime_create() -> @ContextRuntime
    return zeroed[ContextRuntime](count: 1, what: "Failed to allocate context runtime")

### Frees a runtime object from {rf_context_runtime_create}.
### :param runtime: The runtime object to free.
@export("rf_context_runtime_destroy")
routine rf_context_runtime_destroy(runtime: @ContextRuntime) -> None
    c_free(runtime)
    return

### Runs the routine to completion on the calling thread (coroutines go through rf_coro_create / rf_sched_spawn).
### :param runtime: The runtime object, unused.
### :param entry: The routine to run.
### :param userdata: The argument passed to `entry`.
### :param stack_size: The requested stack size, unused.
### :returns: 1 when `entry` ran, 0 when `entry` is null.
@export("rf_context_runtime_spawn")
routine rf_context_runtime_spawn(runtime: @ContextRuntime, entry: Callable[(Addr,), None],
    userdata: Addr, stack_size: U64) -> CInt
    if entry.addr().is_hollow()
        return 0
    entry.call(userdata)
    return 1

### The word a thread's `waitfor` waits on: the cancel flag of the threaded task it runs, or `otherwise` on a plain
### thread.
### :param otherwise: The word for a plain thread.
### :returns: The word.
routine cancel_word(otherwise: @U32) -> @U32
    task: @Task = current_task()
    if task.is_hollow()
        return otherwise
    return task.cancel_requested

### Blocks the calling thread for `duration_seconds` plus `duration_nanoseconds`, on the monotonic clock. A negative
### `duration_seconds` returns at once, and so does a threaded task that is asked to stop while it waits.
### :param duration_seconds: The whole seconds to wait.
### :param duration_nanoseconds: The extra nanoseconds to wait.
@export("rf_waitfor_duration")
routine rf_waitfor_duration(duration_seconds: S64, duration_nanoseconds: U32) -> None
    never: &U32 <- 0

    if duration_seconds < 0
        return
    span: Duration = Duration.from_parts(seconds: duration_seconds,
        nanoseconds: duration_nanoseconds)
    deadline: Duration = Clock.monotonic() +^ span

    # A threaded task waits on its own cancel flag, so a cancel ends the wait early. A plain thread waits on a word
    # nothing changes.
    word: @U32 = cancel_word(otherwise: never)
    loop
        now2: Duration = Clock.monotonic()
        if now2 >= deadline or word.peek_unbroken() != 0
            return
        wait_on_for(at: word, expected: 0, timeout: deadline - now2)
