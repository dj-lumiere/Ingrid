// Files and the filesystem for RazorForge and Suflae: open / read / write / close by handle, memory-mapped views, and
// the filesystem operations (existence, directories, copy, move, remove, listing, metadata, paths, permissions).
//
// The OS work is Tessera's Standard::Os. This file is the rf_* boundary over it. A routine that returns bytes returns
// a malloc'd, NUL-terminated buffer (the caller frees it with rf_invalidate) and its length through
// rf_get_result_len, as RazorForge takes no out parameter here. Paths come as a pointer and a byte count, UTF-8.

module Ingrid::Runtime

import Standard::Alloc
import Standard::Os

global RESULT_LEN: @USize

/// From a sub-range mapping's base (alignment-rounded) to the offset asked for: the caller adds it to reach the
/// requested byte and gives base and delta + length back at unmap. 0 for a whole-file mapping.
global MAP_DELTA: @USize

/// The length of the last buffer a routine here returned.
#export("rf_get_result_len")
routine rf_get_result_len() -> U64
    block entry()
        return(RESULT_LEN.load().to<U64>())

#export("rf_file_map_delta")
routine rf_file_map_delta() -> U64
    block entry()
        return(MAP_DELTA.load().to<U64>())

/// A valid empty mapping (an empty file, or a range at or past the end): not null, never read (its length is 0).
routine empty_map() -> @Byte
    block entry()
        return(inttoptr<USize, @Byte>(1))

/// A failure: no buffer, length 0.
routine no_result() -> @Byte
    block entry()
        RESULT_LEN.store(0)
        return(null)

routine result(buf: @Byte, len: USize) -> @Byte
    block entry()
        RESULT_LEN.store(len)
        return(buf)

/// len bytes at s, copied into a malloc'd, NUL-terminated buffer, as the result.
routine bytes_result(s: @Byte, len: USize) -> @Byte
    block entry()
        buf : Addr = c_malloc(len.add(1))
        branch buf.is_null()
            ? return(no_result())
            : continue
        c_memcpy(buf, s, len)
        terminator : @Byte = buf.to<@Byte>().stride(len)
        terminator.store(0x00)
        return(result(buf.to<@Byte>(), len))

/// Text from the malloc heap (read_all and the like with heap()) made NUL-terminated in place, as the result.
routine owned_result(r: Result<Bytes, FsError>) -> @Byte
    block entry()
        when r
            .Success(text) -> terminate(text)
            .Failure       -> return(no_result())

    block terminate(text: Bytes)
        n   : USize = text.count()
        buf : Addr  = c_realloc(text.data, n.add(1))
        branch buf.is_null()
            ? lost(text)
            : continue
        terminator : @Byte = buf.to<@Byte>().stride(n)
        terminator.store(0x00)
        return(result(buf.to<@Byte>(), n))

    block lost(text: Bytes)
        c_free(text.data)
        return(no_result())

/// A Directory's path from the malloc heap (Directory.current and the like with heap()), as the result.
routine path_result(r: Result<Directory, FsError>) -> @Byte
    block entry()
        when r
            .Success(d)     -> return(owned_result(.Success(d.path)))
            .Failure(error) -> return(owned_result(.Failure(error)))

/// A File's path from the malloc heap (absolute, canonical with heap()), as the result.
routine file_path_result(r: Result<File, FsError>) -> @Byte
    block entry()
        when r
            .Success(f)     -> return(owned_result(.Success(f.path)))
            .Failure(error) -> return(owned_result(.Failure(error)))

/// The malloc heap as an Allocator, so what Standard::Os hands back is freed by rf_invalidate.
routine heap() -> Allocator
    block entry()
        return(make_c_heap_allocator())

/// A counted path as Bytes.
routine path_of(path: @Byte, len: S32) -> Bytes
    block entry()
        return(Bytes.from_ptr(path, len.max(0).to<USize>()))

/// 0 for a success, -1 for a failure.
routine status(r: Result<Unit, FsError>) -> S32
    block entry()
        branch r.is_success()
            ? return(0)
            : return(-1)

/// Whole seconds from nanoseconds since 1970.
routine seconds(ns: S64) -> S64
    block entry()
        return(ns.div(1000000000))

// -- a growing NUL-terminated buffer, for results -------------------------------------

record ResultBuffer
    buf : @Byte
    len : USize
    cap : USize

routine ResultBuffer.start(self: @Self, cap: USize) -> Bool
    block entry()
        buf : Addr = c_malloc(cap.max(16))
        self.buf.store(buf.to<@Byte>())
        self.len.store(0)
        self.cap.store(cap.max(16))
        return(buf.is_not_null())

/// Room for n more bytes and the NUL: false if the buffer can't grow.
routine ResultBuffer.room(self: @Self, n: USize) -> Bool
    block entry()
        filled      : USize = self.len.load().add(n)
        need        : USize = filled.add(1)
        current_cap : USize = self.cap.load()
        branch need.gt(current_cap)
            ? grow(current_cap.mul(2).max(need))
            : return(true)

    block grow(cap: USize)
        bigger : Addr = c_realloc(self.buf.load(), cap)
        branch bigger.is_null()
            ? return(false)
            : continue
        self.buf.store(bigger.to<@Byte>())
        self.cap.store(cap)
        return(true)

routine ResultBuffer.put(self: @Self, data: @Byte, n: USize) -> Void
    block entry()
        c_memcpy(self.buf.load().stride(self.len.load()), data, n)
        next_len : USize = self.len.load().add(n)
        next_len.store_into(self.len)
        return()

routine ResultBuffer.byte(self: @Self, b: Byte) -> Void
    block entry()
        slot : @Byte = self.buf.load().stride(self.len.load())
        slot.store(b)
        next_len : USize = self.len.load().add(1)
        next_len.store_into(self.len)
        return()

routine ResultBuffer.finish(self: @Self) -> @Byte
    block entry()
        n          : USize = self.len.load()
        terminator : @Byte = self.buf.load().stride(n)
        terminator.store(0x00)
        return(result(self.buf.load(), n))

routine ResultBuffer.fail(self: @Self) -> @Byte
    block entry()
        c_free(self.buf.load())
        return(no_result())

// -- files by handle -----------------------------------------------------------------

/// The open files by handle.
global FILE_TABLE: @Array<OpenFile, 256>

preset MAX_OPEN_FILES: USize = 256
preset FILE_BUFFER:    USize = 8192

/// An open file: a reader's read-ahead, or a writer's bytes not written yet, in buffer[start, end).
record OpenFile
    file   : FileHandle
    used   : Bool
    writer : Bool
    eof    : Bool
    buffer : @Byte
    start  : USize
    end    : USize

/// The open file for a handle, or null.
routine open_file(fd: S32) -> @OpenFile
    block entry()
        branch fd.lt(0).bitor(fd.ge(256))
            ? return(null)
            : continue
        of : @OpenFile = FILE_TABLE.to<@OpenFile>().stride(fd.to<USize>())
        branch of.used.load()
            ? return(of)
            : return(null)

/// mode: 0 read, 1 write, 2 append. A handle, or -1.
#export("rf_file_open")
routine rf_file_open(path: @Byte, path_len: S32, mode: S32) -> S32
    block entry()
        p : Bytes = path_of(path, path_len)
        when mode
            0    -> opened(File.at(p).open_read_result(), false)
            1    -> opened(File.at(p).open_write_result(), true)
            2    -> opened(File.at(p).open_append_result(), true)
            else -> return(-1)

    block opened(r: Result<FileHandle, FsError>, writer: Bool)
        when r
            .Success(f) -> buffered(f, writer)
            .Failure    -> return(-1)

    block buffered(f: FileHandle, writer: Bool)
        buffer : Addr = c_malloc(FILE_BUFFER)
        branch buffer.is_null()
            ? full(f, buffer)
            : slot(f, writer, buffer.to<@Byte>(), 0)

    block slot(f: FileHandle, writer: Bool, buffer: @Byte, i: USize)
        branch i.eq(MAX_OPEN_FILES)
            ? full(f, buffer)
            : continue
        place : @OpenFile = FILE_TABLE.to<@OpenFile>().stride(i)
        branch place.used.load()
            ? slot(f, writer, buffer, i.add(1))
            : continue
        place.store(OpenFile { file: f, used: true, writer: writer, eof: false, buffer: buffer,
            start: 0, end: 0 })
        return(i.to<S32>())

    block full(opened: FileHandle, buffer: Addr)
        c_free(buffer)
        claim f : @FileHandle <- opened
        f.close()
        return(-1)

/// Writes a writer's pending bytes: whether they all went.
routine OpenFile.drain(self: @Self) -> Bool
    block entry()
        n : USize = self.end.load()
        branch self.writer.load().bitand(n.gt(0))
            ? continue
            : return(true)
        self.end.store(0)
        wrote : Result<Unit, FsError> = self.file.write_all_result(self.buffer.load(), n)
        return(wrote.is_success())

/// Reads the next chunk into a reader's buffer: false at the end of the file (or on a failure, which reads as the
/// end).
routine OpenFile.refill(self: @Self) -> Bool
    block entry()
        got : Result<USize, FsError> = self.file.read_bytes_result(self.buffer.load(), FILE_BUFFER)
        when got
            .Success(n) -> filled(n)
            .Failure    -> filled(0)

    block filled(n: USize)
        self.start.store(0)
        self.end.store(n)
        branch n.eq(0)
            ? ended()
            : return(true)

    block ended()
        self.eof.store(true)
        return(false)

#export("rf_file_close")
routine rf_file_close(fd: S32) -> Void
    block entry()
        of : @OpenFile = open_file(fd)
        branch of.is_null()
            ? return()
            : continue
        of.drain()
        of.file.close()
        c_free(of.buffer.load())
        of.used.store(false)
        return()

/// The rest of the file from where the reader is.
#export("rf_file_read_all")
routine rf_file_read_all(fd: S32) -> @Byte
    block entry()
        of : @OpenFile = open_file(fd)
        branch of.is_null()
            ? return(no_result())
            : continue
        claim out : @ResultBuffer <- ResultBuffer { buf: null, len: 0, cap: 0 }
        branch out.start(FILE_BUFFER)
            ? continue
            : return(out.fail())
        jump drain(of, out)

    // What the reader holds, then the rest straight into the result.
    block drain(of: @OpenFile, out: @ResultBuffer)
        held : USize = of.end.load().sub(of.start.load())
        branch out.room(held)
            ? continue
            : return(out.fail())
        out.put(of.buffer.load().stride(of.start.load()), held)
        of.start.store(of.end.load())
        jump more(of, out)

    block more(of: @OpenFile, out: @ResultBuffer)
        branch out.room(FILE_BUFFER)
            ? continue
            : return(out.fail())
        at  : @Byte                  = out.buf.load().stride(out.len.load())
        got : Result<USize, FsError> = of.file.read_bytes_result(at, FILE_BUFFER)
        when got
            .Success(n) -> read(of, out, n)
            .Failure    -> read(of, out, 0)

    block read(of: @OpenFile, out: @ResultBuffer, n: USize)
        branch n.eq(0)
            ? done(of, out)
            : continue
        next_len : USize = out.len.load().add(n)
        next_len.store_into(out.len)
        jump more(of, out)

    block done(of: @OpenFile, out: @ResultBuffer)
        of.eof.store(true)
        return(out.finish())

/// One line, without its '\n' (and any '\r').
#export("rf_file_read_line")
routine rf_file_read_line(fd: S32) -> @Byte
    block entry()
        of : @OpenFile = open_file(fd)
        branch of.is_null()
            ? return(no_result())
            : continue
        claim out : @ResultBuffer <- ResultBuffer { buf: null, len: 0, cap: 0 }
        branch out.start(256)
            ? next(of, out)
            : return(out.fail())

    block next(of: @OpenFile, out: @ResultBuffer)
        branch of.start.load().lt(of.end.load())
            ? byte(of, out)
            : continue
        branch of.refill()
            ? byte(of, out)
            : return(out.finish())

    block byte(of: @OpenFile, out: @ResultBuffer)
        at     : USize = of.start.load()
        cursor : @Byte = of.buffer.load().stride(at)
        c      : Byte  = cursor.load()
        of.start.store(at.add(1))
        when
            c.eq(b'\n') -> return(out.finish())
            c.eq(b'\r') -> next(of, out)
            else        -> keep(of, out, c)

    block keep(of: @OpenFile, out: @ResultBuffer, c: Byte)
        branch out.room(1)
            ? continue
            : return(out.fail())
        out.byte(c)
        jump next(of, out)

/// Up to count bytes: fewer only at the end of the file.
#export("rf_file_read_bytes")
routine rf_file_read_bytes(fd: S32, count: USize) -> @Byte
    block entry()
        of : @OpenFile = open_file(fd)
        branch of.is_null()
            ? return(no_result())
            : continue
        claim out : @ResultBuffer <- ResultBuffer { buf: null, len: 0, cap: 0 }
        branch out.start(count.add(1))
            ? next(of, out)
            : return(out.fail())

    block next(of: @OpenFile, out: @ResultBuffer)
        wanted : USize = count.sub(out.len.load())
        branch wanted.eq(0)
            ? return(out.finish())
            : continue
        branch of.start.load().lt(of.end.load())
            ? take(of, out, wanted)
            : continue
        branch of.refill()
            ? take(of, out, wanted)
            : return(out.finish())

    block take(of: @OpenFile, out: @ResultBuffer, wanted: USize)
        buffered : USize = of.end.load().sub(of.start.load())
        n        : USize = buffered.min(wanted)
        out.put(of.buffer.load().stride(of.start.load()), n)
        next_start : USize = of.start.load().add(n)
        next_start.store_into(of.start)
        jump next(of, out)

/// The bytes written (all of them, or 0 on a failure).
#export("rf_file_write")
routine rf_file_write(fd: S32, ptr: @Byte, len: USize) -> USize
    block entry()
        of : @OpenFile = open_file(fd)
        branch of.is_null()
            ? return(0)
            : continue
        needed : USize = of.end.load().add(len)
        branch needed.gt(FILE_BUFFER)
            ? continue
            : keep(of)
        branch of.drain()
            ? continue
            : return(0)
        branch len.ge(FILE_BUFFER)
            ? direct(of)
            : keep(of)

    block direct(of: @OpenFile)
        wrote : Result<Unit, FsError> = of.file.write_all_result(ptr, len)
        branch wrote.is_success()
            ? return(len)
            : return(0)

    block keep(of: @OpenFile)
        c_memcpy(of.buffer.load().stride(of.end.load()), ptr, len)
        next_end : USize = of.end.load().add(len)
        next_end.store_into(of.end)
        return(len)

#export("rf_file_flush")
routine rf_file_flush(fd: S32) -> Void
    block entry()
        of : @OpenFile = open_file(fd)
        branch of.is_null()
            ? return()
            : continue
        of.drain()
        return()

/// Whether a read has reached the end of the file and nothing it read is left.
#export("rf_file_is_eof")
routine rf_file_is_eof(fd: S32) -> Bool
    block entry()
        of : @OpenFile = open_file(fd)
        branch of.is_null()
            ? return(true)
            : return(of.eof.load().bitand(of.start.load().ge(of.end.load())))

// -- whole files, for the I/O threads (io.tess) ---------------------------------------

/// The NUL-terminated path's whole file, malloc'd and NUL-terminated, into data: its length, or -1. (The I/O threads
/// call it at once, so the length comes back here, not through RESULT_LEN.)
routine read_whole_file(cpath: @Byte, data: @@Byte) -> S64
    block entry()
        claim alloc : @Allocator <- heap()
        r : Result<Bytes, FsError> = File.at(cpath.to<CStr>().to<Bytes>()).read_all_result(alloc)
        when r
            .Success(text) -> terminate(text)
            .Failure       -> return(-1)

    block terminate(text: Bytes)
        n   : USize = text.count
        buf : Addr  = c_realloc(text.data, n.add(1))
        branch buf.is_null()
            ? lost(text)
            : continue
        terminator : @Byte = buf.to<@Byte>().stride(n)
        terminator.store(0x00)
        data.store(buf.to<@Byte>())
        return(n.to<S64>())

    block lost(text: Bytes)
        c_free(text.data)
        return(-1)

/// len bytes of data as the NUL-terminated path's whole file: len, or -1.
routine write_whole_file(cpath: @Byte, data: @Byte, len: S64) -> S64
    block entry()
        r : Result<Unit, FsError> = File.at(cpath.to<CStr>().to<Bytes>()).write_all_result(Bytes.from_ptr(
            data, len.max(0).to<USize>()))
        branch r.is_success()
            ? return(len.max(0))
            : return(-1)

// -- paths (no OS calls) -------------------------------------------------------------

/// a + "/" + b (no separator added after one already there): RazorForge joins with '/' on every OS.
#export("rf_fs_join_path")
routine rf_fs_join_path(a: @Byte, a_len: S32, b: @Byte, b_len: S32) -> @Byte
    block entry()
        first  : Bytes = path_of(a, a_len)
        second : Bytes = path_of(b, b_len)
        claim out : @ResultBuffer <- ResultBuffer { buf: null, len: 0, cap: 0 }
        joined_count : USize = first.count().add(second.count())
        branch out.start(joined_count.add(2))
            ? continue
            : return(out.fail())
        out.put(first.data, first.count())
        branch first.is_empty()
            ? tail(out, second)
            : continue
        branch is_separator(first.byte_at(first.count().sub(1)).bits())
            ? tail(out, second)
            : continue
        out.byte(b'/')
        jump tail(out, second)

    block tail(out: @ResultBuffer, second: Bytes)
        out.put(second.data, second.count())
        return(out.finish())

/// The parent directory: "/a/b/c" gives "/a/b", "a/b" gives "a", "file.txt" gives "", and "/" stays the root.
#export("rf_fs_parent_path")
routine rf_fs_parent_path(path: @Byte, len: S32) -> @Byte
    block entry()
        p : Bytes = parent_path(path_of(path, len))
        return(bytes_result(p.data, p.count()))

/// The last component: "/a/b/file.txt" gives "file.txt".
#export("rf_fs_file_name")
routine rf_fs_file_name(path: @Byte, len: S32) -> @Byte
    block entry()
        n : Bytes = file_name(path_of(path, len))
        return(bytes_result(n.data, n.count()))

/// The name without its extension: "file.txt" gives "file", "archive.tar.gz" gives "archive.tar".
#export("rf_fs_file_stem")
routine rf_fs_file_stem(path: @Byte, len: S32) -> @Byte
    block entry()
        s : Bytes = file_stem(path_of(path, len))
        return(bytes_result(s.data, s.count()))

/// The extension without its dot: "file.txt" gives "txt", "file" gives "".
#export("rf_fs_extension")
routine rf_fs_extension(path: @Byte, len: S32) -> @Byte
    block entry()
        e : Bytes = file_extension(path_of(path, len))
        return(bytes_result(e.data, e.count()))

// -- existence, kind, permissions ------------------------------------------------------

#export("rf_fs_exists")
routine rf_fs_exists(path: @Byte, len: S32) -> Bool
    block entry()
        return(File.at(path_of(path, len)).exists())

#export("rf_fs_is_file")
routine rf_fs_is_file(path: @Byte, len: S32) -> Bool
    block entry()
        return(File.at(path_of(path, len)).is_file())

#export("rf_fs_is_directory")
routine rf_fs_is_directory(path: @Byte, len: S32) -> Bool
    block entry()
        return(Directory.at(path_of(path, len)).exists())

#export("rf_fs_can_read")
routine rf_fs_can_read(path: @Byte, len: S32) -> Bool
    block entry()
        return(File.at(path_of(path, len)).can(Access.Read))

#export("rf_fs_can_write")
routine rf_fs_can_write(path: @Byte, len: S32) -> Bool
    block entry()
        return(File.at(path_of(path, len)).can(Access.Write))

#export("rf_fs_can_execute")
routine rf_fs_can_execute(path: @Byte, len: S32) -> Bool
    block entry()
        return(File.at(path_of(path, len)).can(Access.Execute))

#export("rf_fs_set_readonly")
routine rf_fs_set_readonly(path: @Byte, len: S32, readonly: Bool) -> S32
    block entry()
        return(status(File.at(path_of(path, len)).set_readonly_result(readonly)))

// -- directories, copy, move, remove ---------------------------------------------------

#export("rf_fs_create_dir")
routine rf_fs_create_dir(path: @Byte, len: S32) -> S32
    block entry()
        return(status(Directory.at(path_of(path, len)).create_result()))

/// Like mkdir -p: it already existing is fine.
#export("rf_fs_create_dir_all")
routine rf_fs_create_dir_all(path: @Byte, len: S32) -> S32
    block entry()
        return(status(Directory.at(path_of(path, len)).create_all_result()))

/// A file, or an empty directory.
#export("rf_fs_remove")
routine rf_fs_remove(path: @Byte, len: S32) -> S32
    block entry()
        p : Bytes                     = path_of(path, len)
        m : Result<Metadata, FsError> = File.at(p).link_metadata_result()
        when m
            .Success(info) -> kind(p, info.kind)
            .Failure       -> return(-1)

    block kind(p: Bytes, k: FileKind)
        branch k.eq(FileKind.Directory)
            ? return(status(Directory.at(p).delete_result()))
            : return(status(File.at(p).delete_result()))

/// A directory and everything in it (a link is removed, not followed), or a file.
#export("rf_fs_remove_all")
routine rf_fs_remove_all(path: @Byte, len: S32) -> S32
    block entry()
        claim alloc : @Allocator <- heap()
        return(status(Directory.at(path_of(path, len)).delete_all_result(alloc)))

#export("rf_fs_copy")
routine rf_fs_copy(src: @Byte, src_len: S32, dst: @Byte, dst_len: S32) -> S32
    block entry()
        copied : Result<U64, FsError> = File.at(path_of(src,
            src_len)).copy_to_result(File.at(path_of(dst, dst_len)))
        branch copied.is_success()
            ? return(0)
            : return(-1)

/// A rename between filesystems, as a copy and a removal.
routine move_across(a: Bytes, b: Bytes) -> S32
    block entry()
        copied : Result<U64, FsError> = File.at(a).copy_to_result(File.at(b))
        branch copied.is_success()
            ? return(status(File.at(a).delete_result()))
            : return(-1)

/// Renames, replacing what is there. Between filesystems it is a copy and a removal.
#export("rf_fs_move")
routine rf_fs_move(src: @Byte, src_len: S32, dst: @Byte, dst_len: S32) -> S32
    block entry()
        a : Bytes                 = path_of(src, src_len)
        b : Bytes                 = path_of(dst, dst_len)
        r : Result<Unit, FsError> = File.at(a).move_to_result(File.at(b))
        when r
            .Success        -> return(0)
            .Failure(error) -> failed(a, b, error)

    block failed(a: Bytes, b: Bytes, error: FsError)
        branch error.eq(FsError.CrossDevice)
            ? return(move_across(a, b))
            : return(-1)

/// 0 moved, 1 the destination exists (nothing moved), -1 an error.
#export("rf_fs_move_no_replace")
routine rf_fs_move_no_replace(src: @Byte, src_len: S32, dst: @Byte, dst_len: S32) -> S32
    block entry()
        a : Bytes                 = path_of(src, src_len)
        b : Bytes                 = path_of(dst, dst_len)
        r : Result<Unit, FsError> = File.at(a).move_to_if_absent_result(File.at(b))
        when r
            .Success        -> return(0)
            .Failure(error) -> failed(a, b, error)

    block failed(a: Bytes, b: Bytes, error: FsError)
        when
            error.eq(FsError.AlreadyExists) -> return(1)
            error.eq(FsError.CrossDevice)   -> across(a, b)
            else                            -> return(-1)

    block across(a: Bytes, b: Bytes)
        branch File.at(b).exists()
            ? return(1)
            : return(move_across(a, b))

// -- listings --------------------------------------------------------------------------

/// v in decimal into out: the digit count.
routine decimal(v: U64, out: @Byte) -> USize
    block entry()
        claim rev : @Array<Byte, 24> <- uninit
        jump digit(v, rev.to<@Byte>(), 0)

    block digit(remaining: U64, rev: @Byte, n: USize)
        digit_value : U8 = remaining.mod(10).to<U8>()
        rev.stride(n).store(digit_value.add(48).bits())
        rest : U64 = remaining.div(10)
        branch rest.eq(0)
            ? copy(rev, n.add(1), 0)
            : digit(rest, rev, n.add(1))

    block copy(rev: @Byte, n: USize, i: USize)
        branch i.eq(n)
            ? return(n)
            : continue
        out.stride(i).store(rev.stride(n.sub(1).sub(i)).load())
        jump copy(rev, n, i.add(1))

/// One entry: the name, or for the typed listing `<d|f><mtime> <name>` (mtime in Unix seconds, at least 0), with
/// '\n' before every entry but the first.
routine ResultBuffer.entry(self: @Self, name: Bytes, typed: Bool, is_dir: Bool, mtime: S64) -> Bool
    block entry()
        claim digits : @Array<Byte, 24> <- uninit
        branch typed
            ? stamp(digits.to<@Byte>())
            : stamped(digits.to<@Byte>(), 0)

    block stamp(digits: @Byte)
        jump stamped(digits, decimal(mtime.max(0).to<U64>(), digits))

    block stamped(digits: @Byte, dl: USize)
        sep : USize = self.len.load().gt(0)
            ? 1
            : 0
        kind : USize = typed
            ? dl.add(2)
            : 0
        branch self.room(sep.add(kind).add(name.count()))
            ? continue
            : return(false)
        branch sep.eq(1)
            ? newline(digits, dl)
            : body(digits, dl)

    block newline(digits: @Byte, dl: USize)
        self.byte(b'\n')
        jump body(digits, dl)

    block body(digits: @Byte, dl: USize)
        branch typed
            ? continue
            : named()
        self.byte(is_dir ? b'd' : b'f')
        self.put(digits, dl)
        self.byte(b' ')
        jump named()

    block named()
        self.put(name.data, name.count())
        return(true)

/// The entries, with each one's kind and modification time when typed (a link followed where the OS tells).
routine list_directory(path: @Byte, len: S32, typed: Bool) -> @Byte
    block entry()
        claim out : @ResultBuffer <- ResultBuffer { buf: null, len: 0, cap: 0 }
        branch out.start(256)
            ? continue
            : return(out.fail())
        claim iter : @DirIter <- uninit
        opened : Result<Unit, FsError> = iter.open_result(Directory.at(path_of(path, len)))
        branch opened.is_success()
            ? next(out, iter)
            : return(out.fail())

    block next(out: @ResultBuffer, iter: @DirIter)
        e : Option<DirEntry> = iter.next()
        when e
            .Present(d) -> one(out, iter, d)
            .Absent     -> finish(out, iter)

    block one(out: @ResultBuffer, iter: @DirIter, d: DirEntry)
        branch typed
            ? continue
            : add(out, iter, d, false, 0)
        m : Result<Metadata, FsError> = iter.entry_metadata_result()
        when m
            .Success(info) -> add(out, iter, d, info.kind.eq(FileKind.Directory),
                seconds(info.modified_ns))
            .Failure       -> add(out, iter, d, d.kind.eq(FileKind.Directory), 0)

    block add(out: @ResultBuffer, iter: @DirIter, d: DirEntry, is_dir: Bool, mtime: S64)
        branch out.entry(d.name, typed, is_dir, mtime)
            ? next(out, iter)
            : broke(out, iter)

    block finish(out: @ResultBuffer, iter: @DirIter)
        iter.close()
        return(out.finish())

    block broke(out: @ResultBuffer, iter: @DirIter)
        iter.close()
        return(out.fail())

/// The entries' names, '\n' between them ("." and ".." left out).
#export("rf_fs_list_dir")
routine rf_fs_list_dir(path: @Byte, len: S32) -> @Byte
    block entry()
        return(list_directory(path, len, false))

/// `<d|f><mtime> <name>` per entry.
#export("rf_fs_list_dir_typed")
routine rf_fs_list_dir_typed(path: @Byte, len: S32) -> @Byte
    block entry()
        return(list_directory(path, len, true))

// -- metadata (cached by rf_fs_metadata, read by the accessors) ----------------------

global META_SIZE: @S64
global META_MODIFIED: @S64
global META_CREATED: @S64
global META_IS_DIRECTORY: @Bool
global META_READONLY: @Bool

#export("rf_fs_meta_size")
routine rf_fs_meta_size() -> S64
    block entry()
        return(META_SIZE.load())

#export("rf_fs_meta_modified")
routine rf_fs_meta_modified() -> S64
    block entry()
        return(META_MODIFIED.load())

#export("rf_fs_meta_created")
routine rf_fs_meta_created() -> S64
    block entry()
        return(META_CREATED.load())

#export("rf_fs_meta_is_directory")
routine rf_fs_meta_is_directory() -> Bool
    block entry()
        return(META_IS_DIRECTORY.load())

#export("rf_fs_meta_readonly")
routine rf_fs_meta_readonly() -> Bool
    block entry()
        return(META_READONLY.load())

/// Where the filesystem doesn't record a creation time, the modification time stands in.
#export("rf_fs_metadata")
routine rf_fs_metadata(path: @Byte, len: S32) -> S32
    block entry()
        m : Result<Metadata, FsError> = File.at(path_of(path, len)).metadata_result()
        when m
            .Success(info) -> cache(info)
            .Failure       -> return(-1)

    block cache(info: Metadata)
        META_SIZE.store(info.size.to_wrap<S64>())
        META_MODIFIED.store(seconds(info.modified_ns))
        META_CREATED.store(seconds(info.created_ns.unwrap_or(info.modified_ns)))
        META_IS_DIRECTORY.store(info.kind.eq(FileKind.Directory))
        META_READONLY.store(info.readonly)
        return(0)

#export("rf_fs_file_size")
routine rf_fs_file_size(path: @Byte, len: S32) -> S64
    block entry()
        m : Result<Metadata, FsError> = File.at(path_of(path, len)).metadata_result()
        when m
            .Success(info) -> return(info.size.to_wrap<S64>())
            .Failure       -> return(-1)

// -- the working directory and well-known directories -------------------------------------

#export("rf_fs_current_dir")
routine rf_fs_current_dir() -> @Byte
    block entry()
        claim alloc : @Allocator <- heap()
        return(path_result(Directory.current_result(alloc)))

#export("rf_fs_set_current_dir")
routine rf_fs_set_current_dir(path: @Byte, len: S32) -> S32
    block entry()
        return(status(Directory.at(path_of(path, len)).set_current_result()))

#export("rf_fs_temp_dir")
routine rf_fs_temp_dir() -> @Byte
    block entry()
        claim alloc : @Allocator <- heap()
        return(path_result(Directory.temp_result(alloc)))

/// The user's home directory, or null when it can't be told.
#export("rf_fs_home_dir")
routine rf_fs_home_dir() -> @Byte
    block entry()
        claim alloc : @Allocator <- heap()
        return(path_result(Directory.home_result(alloc)))

/// Makes the file if it is missing, and sets its modification time to now.
#export("rf_fs_touch")
routine rf_fs_touch(path: @Byte, len: S32) -> S32
    block entry()
        return(status(File.at(path_of(path, len)).touch_result()))

/// The absolute path by the text alone (links kept).
#export("rf_fs_absolute_path")
routine rf_fs_absolute_path(path: @Byte, len: S32) -> @Byte
    block entry()
        claim alloc : @Allocator <- heap()
        return(file_path_result(File.at(path_of(path, len)).absolute_result(alloc)))

/// The path with links, ".", and ".." resolved. It must exist.
#export("rf_fs_canonical_path")
routine rf_fs_canonical_path(path: @Byte, len: S32) -> @Byte
    block entry()
        claim alloc : @Allocator <- heap()
        return(file_path_result(File.at(path_of(path, len)).canonical_result(alloc)))

/// Makes the file exactly size bytes, creating, extending (zeros) or truncating it: 0, or -1.
#export("rf_fs_set_size")
routine rf_fs_set_size(path: @Byte, path_len: S32, size: USize) -> S32
    block entry()
        p : Bytes                       = path_of(path, path_len)
        r : Result<FileHandle, FsError> = File.at(p).open_read_write_result()
        when r
            .Success(f)     -> sized(f)
            .Failure(error) -> missing(p, error)

    block missing(p: Bytes, error: FsError)
        branch error.eq(FsError.NotFound)
            ? continue
            : return(-1)
        made : Result<FileHandle, FsError> = File.at(p).create_new_result()
        when made
            .Success(f) -> sized(f)
            .Failure    -> return(-1)

    block sized(opened: FileHandle)
        claim f : @FileHandle <- opened
        set : Result<Unit, FsError> = f.set_size_result(size.to<U64>())
        f.close()
        return(status(set))

// -- memory-mapped files -----------------------------------------------------------------

/// A read-only view is read front to back, and within half the physical memory is read in at once: a bigger one
/// would evict the pages it just read, so it pages in on demand.
routine advise(m: Mapping) -> Void
    block entry()
        m.advise_sequential()
        mapped : U64 = m.count().to<U64>()
        branch mapped.le(physical_memory().div(2))
            ? continue
            : return()
        m.prefetch()
        return()

/// A whole file mapped: the view (its length as the result), the empty-map marker for an empty file, or null.
routine map_whole(path: @Byte, len: S32, write: Bool) -> @Byte
    block entry()
        MAP_DELTA.store(0)
        r : Result<Mapping, FsError> = File.at(path_of(path, len)).map_result(write, 0, USize.MAX)
        when r
            .Success(m) -> mapped(m)
            .Failure    -> return(no_result())

    block mapped(m: Mapping)
        branch m.count().eq(0)
            ? empty()
            : continue
        branch write
            ? continue
            : hint(m)
        return(result(m.data(), m.count()))

    block hint(m: Mapping)
        advise(m)
        return(result(m.data(), m.count()))

    block empty()
        RESULT_LEN.store(0)
        return(empty_map())

/// A window [offset, offset + length) of a file, clamped to its end and aligned down for the OS: the base
/// (MAP_DELTA from it to offset, the clamped length as the result), the empty-map marker for an empty window, or
/// null.
routine map_window(path: @Byte, len: S32, offset: USize, count: USize, write: Bool) -> @Byte
    block entry()
        MAP_DELTA.store(0)
        r : Result<Mapping, FsError> = File.at(path_of(path,
            len)).map_result(write, offset.to<U64>(), count)
        when r
            .Success(m) -> mapped(m)
            .Failure    -> return(no_result())

    block mapped(m: Mapping)
        branch m.count().eq(0)
            ? empty()
            : continue
        branch write
            ? continue
            : hint(m)
        MAP_DELTA.store(m.delta)
        return(result(m.base.to<@Byte>(), m.count()))

    block hint(m: Mapping)
        m.advise_sequential()
        MAP_DELTA.store(m.delta)
        return(result(m.base.to<@Byte>(), m.count()))

    block empty()
        RESULT_LEN.store(0)
        return(empty_map())

#export("rf_file_map_path")
routine rf_file_map_path(path: @Byte, path_len: S32) -> @Byte
    block entry()
        return(map_whole(path, path_len, false))

#export("rf_file_map_path_rw")
routine rf_file_map_path_rw(path: @Byte, path_len: S32) -> @Byte
    block entry()
        return(map_whole(path, path_len, true))

#export("rf_file_map_path_range")
routine rf_file_map_path_range(path: @Byte, path_len: S32, offset: USize, count: USize) -> @Byte
    block entry()
        return(map_window(path, path_len, offset, count, false))

#export("rf_file_map_path_range_rw")
routine rf_file_map_path_range_rw(path: @Byte, path_len: S32, offset: USize, count: USize) -> @Byte
    block entry()
        return(map_window(path, path_len, offset, count, true))

/// Writes dirty pages back, then unmaps: ptr is the base, len the delta and the length. A null view or length 0
/// (the empty marker) does nothing.
#export("rf_file_unmap")
routine rf_file_unmap(ptr: @Byte, len: USize) -> Void
    block entry()
        branch ptr.is_null().bitor(len.eq(0))
            ? return()
            : continue
        m : Mapping = Mapping { base: ptr, delta: 0, count: len }
        m.unmap()
        return()

#export("rf_file_map_flush")
routine rf_file_map_flush(ptr: @Byte, len: USize) -> Void
    block entry()
        branch ptr.is_null().bitor(len.eq(0))
            ? return()
            : continue
        m : Mapping = Mapping { base: ptr, delta: 0, count: len }
        m.flush_result()
        return()
