// The coroutine stack and context switch of Ingrid's runtime library (native/runtime/coro_runtime.c), compiled
// into the runtime DLL: Tessera's switch_stack and stack allocator under C names, the same on every operating
// system.

import Standard::Alloc
import Standard::Fiber
import Standard::Os

/// Reserves a coroutine stack of size bytes: its bottom, or null when the space can't be reserved. The pages are
/// committed as the stack grows into them, with a no-access page at the bottom.
#export("ingrid_coro_stack_alloc")
routine coro_stack_alloc(size: USize) -> Addr
    block entry():
        stacks : Allocator                    = make_stack_allocator()
        alloc  : Callable<(Addr, USize), Addr> = stacks.alloc_fn
        stack  : Addr                         = alloc.call(stacks.state, size)
        return(stack)

/// Frees a stack from ingrid_coro_stack_alloc.
#export("ingrid_coro_stack_free")
routine coro_stack_free(stack: Addr) -> Void
    block entry():
        stacks : Allocator                  = make_stack_allocator()
        free   : Callable<(Addr, Addr), Void> = stacks.free_fn
        free.call(stacks.state, stack)
        return()

/// Lays out a new stack of size bytes at stack whose first switch returns into entry: the stack pointer to switch
/// to.
#export("ingrid_coro_stack_init")
routine coro_stack_init(stack: Addr, size: USize, entry: Addr) -> Addr
    block entry():
        sp : Addr = initial_stack(stack, size, entry)
        return(sp)

/// Saves the registers the calling convention keeps on the current stack, stores its stack pointer through from,
/// and goes on on the stack to points into, returning when something switches back.
#export("ingrid_coro_switch")
routine coro_switch(from: @Addr, to: Addr) -> Void
    block entry():
        switch_stack(from, to)
        return()
