# RazorForge's result tasks: the completion (a value, an error, cancelled, or timed out) of a coroutine or of a
# routine on a thread of its own (`threaded`), and the bridge that lets a coroutine wait for a threaded task by
# parking instead of blocking its worker.
#
# A threaded task is freed by the last of two parties: its thread (as its final act) and the one consuming
# retrieve! (rf_task_release, after reading the value or giving up at a deadline). A detached task (`execute()`)
# has no consumer, so its thread, or for a coroutine task its completion, frees it.

module Ingrid/Runtime

import Standard/Os

global NEXT_TASK_ID: @U64 <- 1

### Agents made and not finished yet (coroutines and threads), from creation to completion or to being freed
### unfinished. A thread waiting on a channel when none is left knows that no one else can ever wake it.
global LIVE_TASKS: @U64

### The threaded task running on this thread, or null.
@threadlocal
global CURRENT_TASK: @@Task

# rf_task_kind, rf_task_status, rf_task_completion_kind (razorforge_runtime.h).
preset TASK_SUSPENDED: U32 = 0
preset TASK_THREADED:  U32 = 1
preset TASK_NEW:       U32 = 0
preset TASK_READY:     U32 = 1
preset TASK_RUNNING:   U32 = 2
preset TASK_PARKED:    U32 = 3
preset TASK_COMPLETED: U32 = 4
preset COMPLETION_PENDING:   U32 = 0
preset COMPLETION_VALUE:     U32 = 1
preset COMPLETION_ERROR:     U32 = 2
preset COMPLETION_CANCELLED: U32 = 3
preset COMPLETION_TIMEOUT:   U32 = 4

record TaskNode
    next: @TaskNode
    task: @Task

### rf_task.
record Task
    kind: U32
    status: U32  # read across threads
    completion_seq: U64  # in completion order, U64.MAX until it completes
    completion: U32
    value_payload: Addr
    error_payload: Addr
    cancel_requested: U32
    result_consumed: Bool
    detached: Bool
    worker_exited: Bool  # the thread's final act ran (threaded)
    consumer_released: Bool  # the consuming retrieve! is done with it (threaded)
    reaped: Bool  # one of the two freed it
    done: U32  # 1 once completed: a thread waiting in rf_task_wait waits on it
    execution_backend: Addr
    wait_backend: Addr
    dependents_head: @TaskNode
    dependents_tail: @TaskNode
    prerequisite_count: U32
    prerequisites_remaining: U32
    task_id: U64
    coro_lock: ExclusiveAccess  # the fields below, and the reap flags
    coro_sched: @Sched  # the scheduler of a coroutine waiting for it
    coro_waiter: @Coro
    race_sched: @Sched  # the scheduler of a race! over a set that has it
    race_waiter: @Coro  # that race!'s coroutine, or null for a thread racer
    counted: U32  # 1 while it counts in LIVE_TASKS

### What a task's thread starts with, freed by the thread.
record ThreadedStart
    task: @Task
    entry: Callable[(Addr,), None]
    userdata: Addr

### Makes a `TaskNode` from its fields.
### :param next: Its `next`.
### :param task: Its `task`.
### :returns: The new value.
common routine TaskNode.construct(next: @Me, task: @Task) -> Me
    return Me(next, task)

### Releases nothing: a `TaskNode` holds no memory of its own.
routine @TaskNode.destruct() -> None
    return

### Makes a `Task` from its fields.
### :param kind: Its `kind`.
### :param status: Its `status`.
### :param completion_seq: Its `completion_seq`.
### :param completion: Its `completion`.
### :param value_payload: Its `value_payload`.
### :param error_payload: Its `error_payload`.
### :param cancel_requested: Its `cancel_requested`.
### :param result_consumed: Its `result_consumed`.
### :param detached: Its `detached`.
### :param worker_exited: Its `worker_exited`.
### :param consumer_released: Its `consumer_released`.
### :param reaped: Its `reaped`.
### :param done: Its `done`.
### :param execution_backend: Its `execution_backend`.
### :param wait_backend: Its `wait_backend`.
### :param dependents_head: Its `dependents_head`.
### :param dependents_tail: Its `dependents_tail`.
### :param prerequisite_count: Its `prerequisite_count`.
### :param prerequisites_remaining: Its `prerequisites_remaining`.
### :param task_id: Its `task_id`.
### :param coro_lock: Its `coro_lock`.
### :param coro_sched: Its `coro_sched`.
### :param coro_waiter: Its `coro_waiter`.
### :param race_sched: Its `race_sched`.
### :param race_waiter: Its `race_waiter`.
### :param counted: Its `counted`.
### :returns: The new value.
common routine Task.construct(kind: U32, status: U32, completion_seq: U64, completion: U32,
    value_payload: Addr, error_payload: Addr, cancel_requested: U32, result_consumed: Bool,
    detached: Bool, worker_exited: Bool, consumer_released: Bool, reaped: Bool, done: U32,
    execution_backend: Addr, wait_backend: Addr, dependents_head: @TaskNode,
    dependents_tail: @TaskNode, prerequisite_count: U32, prerequisites_remaining: U32, task_id: U64,
    coro_lock: ExclusiveAccess, coro_sched: @Sched, coro_waiter: @Coro, race_sched: @Sched,
    race_waiter: @Coro, counted: U32) -> Me
    return Me(kind, status, completion_seq, completion, value_payload, error_payload,
        cancel_requested, result_consumed, detached, worker_exited, consumer_released, reaped, done,
        execution_backend, wait_backend, dependents_head, dependents_tail, prerequisite_count,
        prerequisites_remaining, task_id, coro_lock, coro_sched, coro_waiter, race_sched,
        race_waiter, counted)

### Releases nothing: a `Task` holds no memory of its own.
routine @Task.destruct() -> None
    return

### Makes a `ThreadedStart` from its fields.
### :param task: Its `task`.
### :param entry: Its `entry`.
### :param userdata: Its `userdata`.
### :returns: The new value.
common routine ThreadedStart.construct(task: @Task, entry: Callable[(Addr,), None], userdata: Addr) -> Me
    return Me(task, entry, userdata)

### Releases nothing: a `ThreadedStart` holds no memory of its own.
routine @ThreadedStart.destruct() -> None
    return

### The threaded task running on this thread.
### :returns: The task, or null outside a threaded task's thread.
@noinline
routine current_task() -> @Task
    t: @Task = CURRENT_TASK.peek()
    return t

### Whether the task has completed: its status is `TASK_COMPLETED` and its completion is in.
### :returns: True once completed.
routine @Task.is_completed() -> Bool
    done: Bool = me.status.peek_atomic() == TASK_COMPLETED
    return done and me.completion.peek() != COMPLETION_PENDING

### Stamps the completion order once, before the status says COMPLETED, so a racer that sees COMPLETED sees the
### stamp.
routine @Task.stamp() -> None
    if not (me.completion_seq.peek_atomic() == U64.MAX)
        return
    me.completion_seq.poke_atomic(next_completion_seq())
    return

### The completion is in: a coroutine waiting for it is woken, a race! over it re-polls, and a thread waiting in
### rf_task_wait returns.
routine @Task.signal_completion() -> None
    me.coro_lock.lock()
    sched: @Sched = me.coro_sched.peek()
    waiter: @Coro = me.coro_waiter.peek()
    race_sched: @Sched = me.race_sched.peek()
    race_waiter: @Coro = me.race_waiter.peek()
    me.coro_sched.poke(.hollow())
    me.coro_waiter.poke(.hollow())
    me.coro_lock.unlock()
    if not sched.is_hollow()
        # the waiter's promise of a wake from this thread is kept
        rf_sched_disarm_cross_waker(sched)
        if not waiter.is_hollow()
            rf_sched_wake(s: sched, c: waiter)

    # Left registered, so a later spurious wake is harmless, and race! clears it when it is over.
    if not race_sched.is_hollow()
        if race_waiter.is_hollow()
            rf_sched_signal(race_sched)
        else
            rf_sched_wake(s: race_sched, c: race_waiter)
    me.done.poke_atomic(1)
    wake_all(me.done)
    return

### Registers (s not null) or clears the scheduler of a race! over a set that has this task, and its coroutine
### (null for a thread racer). A null `task` does nothing.
### :param task: The task.
### :param s: The race's scheduler, or null to clear.
### :param coro: The race's coroutine, or null.
@export("rf_task_race_register")
routine rf_task_race_register(task: @Task, s: @Sched, coro: @Coro) -> None
    if task.is_hollow()
        return
    task.coro_lock.lock()
    task.race_sched.poke(s)
    task.race_waiter.poke(coro)
    task.coro_lock.unlock()
    return

### The running coroutine waits for task: 1 if it is complete already (read it, don't park), 0 if registered (park
### with rf_sched_park_external, and the completion wakes it). Outside a scheduler-driven coroutine 1, so the caller
### waits blocking.
### :param task: The task, or null.
### :returns: 1 when it is complete (or `task` is null, or outside a coroutine), 0 when registered.
@export("rf_task_await_coro")
routine rf_task_await_coro(task: @Task) -> U32
    if task.is_hollow()
        return 1
    sched: @Sched = rf_sched_current()
    this_coro: @Coro = current_coro()
    if sched.is_hollow() or this_coro.is_hollow()
        return 1
    return task.register_waiter(sched, waiter: this_coro)

### rf_task_await_coro bounded by timeout_ns: 1 completed, 0 timed out, 2 not in a scheduler-driven coroutine (the
### caller waits blocking with the deadline). On a timeout the registration is taken back, so a later completion
### doesn't wake a coroutine that has moved on.
### :param task: The task, or null.
### :param timeout_ns: The longest wait, in nanoseconds.
### :returns: 1 completed (or `task` is null), 0 timed out, 2 not in a scheduler-driven coroutine.
@export("rf_task_await_coro_deadline")
routine rf_task_await_coro_deadline(task: @Task, timeout_ns: U64) -> U32
    if task.is_hollow()
        return 1
    sched: @Sched = rf_sched_current()
    this_coro: @Coro = current_coro()
    if sched.is_hollow() or this_coro.is_hollow()
        return 2

    deadline: Duration = Clock.monotonic() +^ of_ns(timeout_ns)

    while task.register_waiter(sched, waiter: this_coro) != 1
        now: Duration = Clock.monotonic()
        if now >= deadline
            return task.withdraw_waiter(sched, waiter: this_coro)
        rf_sched_park_deadline(ns_of(deadline - now))
    then
        return 1

### Registers waiter to be woken when the task completes, under the task's lock: 1 if it is complete already (read
### it, don't park), 0 once registered. The first registration promises a wake from another thread
### (signal_completion keeps it), armed after the lock is given back.
### :param sched: The waiter's scheduler.
### :param waiter: The coroutine to wake.
### :returns: 1 when complete already, 0 once registered.
routine @Task.register_waiter(sched: @Sched, waiter: @Coro) -> U32
    me.coro_lock.lock()
    values2: (U32, Bool) = when
        me.is_completed() => (1, false)
        else =>
            arm: Bool = me.coro_sched.peek().is_hollow()
            me.coro_sched.poke(sched)
            me.coro_waiter.poke(waiter)
            becomes (0, arm)
    complete, arm = values2
    me.coro_lock.unlock()
    if not arm
        return complete
    rf_sched_arm_cross_waker(sched)
    return complete

### The deadline passed: 1 for a value that just came in, else 0 with waiter's registration taken back (and its
### promised wake withdrawn after the lock is given back).
### :param sched: The waiter's scheduler.
### :param waiter: The coroutine that gives up.
### :returns: 1 when the task completed meanwhile, else 0.
routine @Task.withdraw_waiter(sched: @Sched, waiter: @Coro) -> U32
    me.coro_lock.lock()
    values2: (U32, Bool) = when
        me.is_completed() => (1, false)
        else =>
            mine: Bool = me.coro_waiter.peek() === waiter
            disarm: Bool = mine and me.coro_sched.peek().is_not_hollow()
            if not mine
                becomes (0, disarm)
            else
                me.coro_sched.poke(.hollow())
                me.coro_waiter.poke(.hollow())
                becomes (0, disarm)
    complete, disarm = values2
    me.coro_lock.unlock()
    if not disarm
        return complete
    rf_sched_disarm_cross_waker(sched)
    return complete

### The name of a task kind.
### :param kind: A `TASK_SUSPENDED` / `TASK_THREADED` value.
### :returns: `suspended`, `threaded`, or `unknown`.
@export("rf_task_kind_name")
routine rf_task_kind_name(kind: U32) -> CStrView
    when
        kind == TASK_SUSPENDED => return "suspended"
        kind == TASK_THREADED => return "threaded"
        else => return "unknown"

### The name of a task status.
### :param status: A `TASK_` status value.
### :returns: `new`, `ready`, `running`, `parked`, `completed`, or `unknown`.
@export("rf_task_status_name")
routine rf_task_status_name(status: U32) -> CStrView
    when
        status == TASK_NEW => return "new"
        status == TASK_READY => return "ready"
        status == TASK_RUNNING => return "running"
        status == TASK_PARKED => return "parked"
        status == TASK_COMPLETED => return "completed"
        else => return "unknown"

### The name of a completion kind.
### :param kind: A `COMPLETION_` value.
### :returns: `pending`, `value`, `error`, `cancelled`, `timeout`, or `unknown`.
@export("rf_task_completion_name")
routine rf_task_completion_name(kind: U32) -> CStrView
    when
        kind == COMPLETION_PENDING => return "pending"
        kind == COMPLETION_VALUE => return "value"
        kind == COMPLETION_ERROR => return "error"
        kind == COMPLETION_CANCELLED => return "cancelled"
        kind == COMPLETION_TIMEOUT => return "timeout"
        else => return "unknown"

### Creates a new task with the next task id.
### :param kind: `TASK_SUSPENDED` (a coroutine) or `TASK_THREADED`.
### :returns: The task, `TASK_NEW` and pending.
### :throws: Crashes with `OutOfMemoryError` when the allocation fails.
@export("rf_task_create")
routine rf_task_create(kind: U32) -> @Task
    task: @Task = zeroed[Task](count: 1, what: "Failed to allocate task")
    task.kind.poke(kind)
    task.completion_seq.poke(U64.MAX)
    task.task_id.poke(NEXT_TASK_ID.atomic_fetch_add(1))
    task.counted.poke(1)
    LIVE_TASKS.atomic_fetch_add(1)
    return task

### Takes the task out of LIVE_TASKS, once: at its completion, or when it is freed without having completed.
routine @Task.uncount() -> None
    was: U32 = me.counted.atomic_swap(0)
    if not (was == 1)
        return
    LIVE_TASKS.atomic_fetch_sub(1)
    return

### Frees the task with a result nobody took (a deadline give-up, a race! loser) and the dependents list. The error
### payload is not freed.
routine @Task.free() -> None
    me.uncount()
    payload: Addr = me.value_payload.peek()
    node: @TaskNode = when
        payload.is_hollow() => me.dependents_head.peek()
        else =>
            c_free(payload)
            me.value_payload.poke(.hollow())
            becomes me.dependents_head.peek()

    until node2.is_hollow() with node2: @TaskNode = node
        next: @TaskNode = node2.next.peek()
        c_free(node2)
        continue with node2: next
    c_free(me)
    return

### Frees a task at once, with its untaken result and dependents list. A null `task` does nothing.
### :param task: The task.
@export("rf_task_destroy")
routine rf_task_destroy(task: @Task) -> None
    if task.is_hollow()
        return
    task.free()
    return

### The consuming retrieve! is done with the task (called once): it is freed now if its thread has exited, else by
### its thread. A coroutine task has no thread and is freed at once. A null `task` does nothing.
### :param task: The task.
@export("rf_task_release")
routine rf_task_release(task: @Task) -> None
    if task.is_hollow()
        return
    if not (task.kind.peek() == TASK_THREADED)
        task.free()
        return
    task.coro_lock.lock()
    task.consumer_released.poke(true)
    reap: Bool = task.worker_exited.peek() and not task.reaped.peek()
    reap2: Bool = when
        not reap => false
        else =>
            task.reaped.poke(true)
            becomes true
    task.coro_lock.unlock()
    if reap2
        task.free()
        return
    return

### A task's id.
### :param task: The task, or null.
### :returns: The id, 0 for a null `task`.
@export("rf_task_id")
routine rf_task_id(task: @Task) -> U64
    if task.is_hollow()
        return 0
    return task.task_id.peek()

### A task's kind.
### :param task: The task, or null.
### :returns: `TASK_SUSPENDED` or `TASK_THREADED`, `TASK_SUSPENDED` for a null `task`.
@export("rf_task_kind_get")
routine rf_task_kind_get(task: @Task) -> U32
    if task.is_hollow()
        return TASK_SUSPENDED
    return task.kind.peek()

### A task's status.
### :param task: The task, or null.
### :returns: A `TASK_` status, `TASK_COMPLETED` for a null `task`.
@export("rf_task_status_get")
routine rf_task_status_get(task: @Task) -> U32
    if task.is_hollow()
        return TASK_COMPLETED
    return task.status.peek_atomic()

### A task's completion stamp.
### :param task: The task, or null.
### :returns: The stamp, or `U64.MAX` before it completes or for a null `task`.
@export("rf_task_completion_seq")
routine rf_task_completion_seq(task: @Task) -> U64
    if task.is_hollow()
        return U64.MAX
    return task.completion_seq.peek_atomic()

### How a task completed.
### :param task: The task, or null.
### :returns: A `COMPLETION_` value, `COMPLETION_ERROR` for a null `task`.
@export("rf_task_completion_kind_get")
routine rf_task_completion_kind_get(task: @Task) -> U32
    if task.is_hollow()
        return COMPLETION_ERROR
    return task.completion.peek()

### Hands the boxed result to the caller, who frees it: the task no longer owns it.
### :param task: The task, or null.
### :returns: The result box, or null.
@export("rf_task_result_payload")
routine rf_task_result_payload(task: @Task) -> Addr
    if task.is_hollow()
        return .hollow()
    payload: Addr = task.value_payload.peek()
    task.value_payload.poke(.hollow())
    return payload

### A task's error payload, still the task's.
### :param task: The task, or null.
### :returns: The error payload, or null.
@export("rf_task_error_payload")
routine rf_task_error_payload(task: @Task) -> Addr
    if task.is_hollow()
        return .hollow()
    return task.error_payload.peek()

### Waits (blocking the thread) until a threaded task completes: how it completed. A coroutine task isn't waited for.
### :param task: The task, or null.
### :returns: A `COMPLETION_` value, `COMPLETION_ERROR` for a null `task`.
@export("rf_task_wait")
routine rf_task_wait(task: @Task) -> U32
    if task.is_hollow()
        return COMPLETION_ERROR
    if task.kind.peek() == TASK_THREADED
        until task.is_completed()
            if here_has_live()
                # This thread's start_here() jobs go on while it waits for the thread.
                if run_here_ready()
                    continue
                wait_on_for(at: task.done, expected: 0, timeout: HERE_POLL)
                continue
            wait_on(at: task.done, expected: 0)
            continue
        then
            return task.completion.peek()
    else
        return task.completion.peek()

### rf_task_wait for at most timeout_seconds and timeout_nanoseconds: COMPLETION_TIMEOUT if it didn't complete.
### :param task: The task, or null.
### :param timeout_seconds: The whole seconds to wait, a negative value counting as 0.
### :param timeout_nanoseconds: The extra nanoseconds to wait.
### :returns: A `COMPLETION_` value, `COMPLETION_ERROR` for a null `task`.
@export("rf_task_wait_within")
routine rf_task_wait_within(task: @Task, timeout_seconds: S64, timeout_nanoseconds: U32) -> U32
    if task.is_hollow()
        return COMPLETION_ERROR
    if task.is_completed() or task.kind.peek() != TASK_THREADED
        return task.completion.peek()
    timeout: Duration = Duration.from_parts(seconds: timeout_seconds,
        nanoseconds: timeout_nanoseconds).max(0s)
    deadline: Duration = Clock.monotonic() +^ timeout

    until task.is_completed()
        now: Duration = Clock.monotonic()
        if now >= deadline
            return COMPLETION_TIMEOUT
        wait_on_for(at: task.done, expected: 0, timeout: deadline - now)
    then
        return task.completion.peek()

### A threaded task's thread: frees its start data, runs the routine as the current task, then, as its final act,
### frees the task when the consumer is done with it or it is detached (with a detached task's result box).
### :param start: The task, its routine, and the routine's argument.
routine threaded_task_main(start: @ThreadedStart) -> None
    rf_thread_stack_guarantee()
    task: @Task = start.task.peek()
    body: Callable[(Addr,), None] = start.entry.peek()
    userdata: Addr = start.userdata.peek()
    c_free(start)
    task.status.poke_atomic(TASK_RUNNING)
    CURRENT_TASK.poke(task)
    body.call(userdata)
    CURRENT_TASK.poke(.hollow())

    # The thread's final act, after the completion (and its wakes) are over: it frees the task if the consumer
    # is already done with it, or if it is detached, which has no consumer.
    task.coro_lock.lock()
    task.worker_exited.poke(true)
    owner: Bool = task.consumer_released.peek() or task.detached.peek()
    reap: Bool = owner and not task.reaped.peek()
    values2: (Bool, Addr) = when
        not reap => (false, .hollow())
        else =>
            task.reaped.poke(true)
            box: Addr = when
                task.detached.peek() => task.value_payload.peek()
                else => .hollow()
            if box.is_hollow()
                becomes (true, .hollow())
            else
                task.value_payload.poke(.hollow())
                becomes (true, box)
    reap2, box = values2
    task.coro_lock.unlock()
    if not box.is_hollow()
        rf_invalidate(box)
    if not reap2
        return
    task.free()
    return

### Starts a threaded task's routine on a thread of its own: 1, or 0 for a task that can't. A task already started
### isn't started again (the first verb that runs it starts it).
### :param task: The threaded task.
### :param entry: The routine to run, given `userdata`. It finds its task through `userdata`.
### :param userdata: The routine's argument.
### :returns: 1 when started (or already started without an error), 0 for a null, non-threaded, or failed task.
### :throws: Crashes with `OutOfMemoryError` when the start data can't be allocated, and with `TaskSpawnError` when
###     the thread can't be started.
@export("rf_task_spawn_threaded")
routine rf_task_spawn_threaded(task: @Task, entry: Callable[(Addr,), None], userdata: Addr) -> CInt
    if task.is_hollow() or entry.addr().is_hollow()
        return 0
    if not (task.kind.peek() == TASK_THREADED)
        return 0
    if not (task.status.peek_atomic() == TASK_NEW)
        if task.completion.peek() == COMPLETION_ERROR
            return 0
        return 1
    start: @ThreadedStart = zeroed[ThreadedStart](count: 1,
        what: "Failed to allocate thread start data")
    start.poke(ThreadedStart(task: task, entry: entry, userdata: userdata))
    task.status.poke_atomic(TASK_READY)
    DEFAULT_THREADS.launch_unwatched(entry: threaded_task_main.to[Callable](), arg: start)
    return 1

### Marks a task `TASK_READY`. A null `task` does nothing.
### :param task: The task.
@export("rf_task_mark_ready")
routine rf_task_mark_ready(task: @Task) -> None
    if task.is_hollow()
        return
    task.status.poke_atomic(TASK_READY)
    return

### Marks a task `TASK_RUNNING`. A null `task` does nothing.
### :param task: The task.
@export("rf_task_mark_running")
routine rf_task_mark_running(task: @Task) -> None
    if task.is_hollow()
        return
    task.status.poke_atomic(TASK_RUNNING)
    return

### Marks a task `TASK_PARKED`. A null `task` does nothing.
### :param task: The task.
@export("rf_task_mark_parked")
routine rf_task_mark_parked(task: @Task) -> None
    if task.is_hollow()
        return
    task.status.poke_atomic(TASK_PARKED)
    return

### Completes the task with how and the payloads, stamped first, then wakes its waiters.
### :param how: A `COMPLETION_` value.
### :param value: The result box, or null.
### :param error: The error payload, or null.
routine @Task.complete(how: U32, value: Addr, error: Addr) -> None
    me.uncount()
    me.stamp()
    me.completion.poke(how)
    me.value_payload.poke(value)
    me.error_payload.poke(error)
    me.status.poke_atomic(TASK_COMPLETED)
    me.signal_completion()
    return

### A detached coroutine task (execute()) has no consumer: its result box and the task are freed here. A detached
### threaded task is freed by its thread instead, which still touches it after this. Otherwise the task completes
### with the value. A null `task` does nothing.
### :param task: The task.
### :param result_payload: The result box, or null.
@export("rf_task_complete_value")
routine rf_task_complete_value(task: @Task, result_payload: Addr) -> None
    if task.is_hollow()
        return
    if task.detached.peek() and (task.kind.peek() == TASK_SUSPENDED)
        if not result_payload.is_hollow()
            rf_invalidate(result_payload)
            task.free()
            return
        task.free()
        return
    task.complete(how: COMPLETION_VALUE, value: result_payload, error: .hollow())
    return

### execute(): the task frees itself when it completes. A threaded task's thread is already running, so this agrees
### with its final act under the lock: if it already exited, the task is freed here. A null `task` does nothing.
### :param task: The task.
@export("rf_task_set_detached")
routine rf_task_set_detached(task: @Task) -> None
    if task.is_hollow()
        return
    task.coro_lock.lock()
    task.detached.poke(true)
    threaded: Bool = task.kind.peek() == TASK_THREADED
    exited: Bool = threaded and task.worker_exited.peek()
    if not (exited and not task.reaped.peek())
        task.coro_lock.unlock()
        return
    task.reaped.poke(true)
    task.coro_lock.unlock()
    payload: Addr = task.value_payload.peek()
    task.value_payload.poke(.hollow())
    if not payload.is_hollow()
        rf_invalidate(payload)
    task.free()
    return

### Whether a task is detached.
### :param task: The task, or null.
### :returns: 1 when detached, else 0 (0 for a null `task`).
@export("rf_task_is_detached")
routine rf_task_is_detached(task: @Task) -> U8
    if task.is_hollow()
        return 0
    if task.detached.peek()
        return 1
    return 0

### Completes a task with an error and wakes its waiters. A null `task` does nothing.
### :param task: The task.
### :param error_payload: The error payload.
@export("rf_task_complete_error")
routine rf_task_complete_error(task: @Task, error_payload: Addr) -> None
    if task.is_hollow()
        return
    task.complete(how: COMPLETION_ERROR, value: .hollow(), error: error_payload)
    return

### Completes a task as cancelled and wakes its waiters. A null `task` does nothing.
### :param task: The task.
@export("rf_task_complete_cancelled")
routine rf_task_complete_cancelled(task: @Task) -> None
    if task.is_hollow()
        return
    task.complete(how: COMPLETION_CANCELLED, value: .hollow(), error: .hollow())
    return

### Completes a task as timed out and wakes its waiters. A null `task` does nothing.
### :param task: The task.
@export("rf_task_complete_timeout")
routine rf_task_complete_timeout(task: @Task) -> None
    if task.is_hollow()
        return
    task.complete(how: COMPLETION_TIMEOUT, value: .hollow(), error: .hollow())
    return

### Asks a task to stop: a flag its routine reads with rf_cancel_requested. Its thread, when it waits in `waitfor`,
### wakes now. A null `task` does nothing.
### :param task: The task.
@export("rf_task_request_cancel")
routine rf_task_request_cancel(task: @Task) -> None
    if task.is_hollow()
        return
    task.cancel_requested.poke_atomic(1)
    wake_all(at: task.cancel_requested)
    return

### Whether a task was asked to stop.
### :param task: The task, or null.
### :returns: True when cancellation was requested, false for a null `task`.
@export("rf_task_is_cancel_requested")
routine rf_task_is_cancel_requested(task: @Task) -> Bool
    if task.is_hollow()
        return false
    return task.cancel_requested.peek_atomic() == 1

### Whether the agent running on this thread (a coroutine, or a threaded task's thread) has been asked to stop.
### :returns: 1 when asked, else 0 (0 on a plain thread).
@export("rf_cancel_requested")
routine rf_cancel_requested() -> U32
    this_coro: @Coro = current_coro()
    if this_coro.is_hollow()
        task: @Task = current_task()
        if task.is_hollow()
            return 0
        return task.cancel_requested.peek_atomic()
    return rf_coro_is_cancel_requested(this_coro)

### Records that a task's result was taken. A null `task` does nothing.
### :param task: The task.
@export("rf_task_mark_result_consumed")
routine rf_task_mark_result_consumed(task: @Task) -> None
    if task.is_hollow()
        return
    task.result_consumed.poke(true)
    return

### Whether a task's result was taken.
### :param task: The task, or null.
### :returns: True when taken, false for a null `task`.
@export("rf_task_is_result_consumed")
routine rf_task_is_result_consumed(task: @Task) -> Bool
    if task.is_hollow()
        return false
    return task.result_consumed.peek()

### Stores an execution backend pointer on a task. A null `task` does nothing.
### :param task: The task.
### :param backend: The backend pointer.
@export("rf_task_attach_execution_backend")
routine rf_task_attach_execution_backend(task: @Task, backend: Addr) -> None
    if task.is_hollow()
        return
    task.execution_backend.poke(backend)
    return

### A task's execution backend pointer.
### :param task: The task, or null.
### :returns: The pointer, or null.
@export("rf_task_execution_backend")
routine rf_task_execution_backend(task: @Task) -> Addr
    if task.is_hollow()
        return .hollow()
    return task.execution_backend.peek()

### Stores a wait backend pointer on a task. A null `task` does nothing.
### :param task: The task.
### :param backend: The backend pointer.
@export("rf_task_attach_wait_backend")
routine rf_task_attach_wait_backend(task: @Task, backend: Addr) -> None
    if task.is_hollow()
        return
    task.wait_backend.poke(backend)
    return

### A task's wait backend pointer.
### :param task: The task, or null.
### :returns: The pointer, or null.
@export("rf_task_wait_backend")
routine rf_task_wait_backend(task: @Task) -> Addr
    if task.is_hollow()
        return .hollow()
    return task.wait_backend.peek()

### Adds one prerequisite to a task's count and to those remaining. A null `task` does nothing.
### :param task: The task.
@export("rf_task_add_prerequisite")
routine rf_task_add_prerequisite(task: @Task) -> None
    if task.is_hollow()
        return
    next_prerequisite_count: U32 = task.prerequisite_count.peek() + 1
    next_prerequisite_count.poke_into(task.prerequisite_count)
    next_prerequisites_remaining: U32 = task.prerequisites_remaining.peek() + 1
    next_prerequisites_remaining.poke_into(task.prerequisites_remaining)
    return

### Appends `dependent` to the task's dependents list. A null `task` or `dependent` does nothing.
### :param task: The task.
### :param dependent: The task that waits for it.
### :throws: Crashes with `OutOfMemoryError` when the list node can't be allocated.
@export("rf_task_add_dependent")
routine rf_task_add_dependent(task: @Task, dependent: @Task) -> None
    if task.is_hollow() or dependent.is_hollow()
        return
    node: @TaskNode = zeroed[TaskNode](count: 1, what: "Failed to allocate task queue node")
    node.task.poke(dependent)
    tail: @TaskNode = task.dependents_tail.peek()
    if tail.is_hollow()
        task.dependents_head.poke(node)
        task.dependents_tail.poke(node)
        return
    tail.next.poke(node)
    task.dependents_tail.poke(node)
    return

### A task's prerequisite count.
### :param task: The task, or null.
### :returns: The count, 0 for a null `task`.
@export("rf_task_prerequisite_count")
routine rf_task_prerequisite_count(task: @Task) -> U32
    if task.is_hollow()
        return 0
    return task.prerequisite_count.peek()

### A task's prerequisites not finished yet.
### :param task: The task, or null.
### :returns: The count, 0 for a null `task`.
@export("rf_task_prerequisites_remaining")
routine rf_task_prerequisites_remaining(task: @Task) -> U32
    if task.is_hollow()
        return 0
    return task.prerequisites_remaining.peek()

### One prerequisite finished: true once none remain (the task is ready, and a `TASK_NEW` one is marked
### `TASK_READY`). A failed one cancels the task.
### :param task: The task, or null.
### :param success: Whether the prerequisite succeeded.
### :returns: True once none remain, false otherwise, after a failure, or for a null `task`.
@export("rf_task_prerequisite_complete")
routine rf_task_prerequisite_complete(task: @Task, success: Bool) -> Bool
    if task.is_hollow()
        return false
    if not success
        task.stamp()
        task.completion.poke(COMPLETION_CANCELLED)
        task.status.poke_atomic(TASK_COMPLETED)
        task.signal_completion()
        return false
    remaining: U32 = task.prerequisites_remaining.peek()
    left: U32 = remaining -^ 1
    task.prerequisites_remaining.poke(left)
    if not (left == 0)
        return false
    if not (task.status.peek_atomic() == TASK_NEW)
        return true
    task.status.poke_atomic(TASK_READY)
    return true
