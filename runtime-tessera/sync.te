# What the rest of Ingrid's runtime code shares: the C library and runtime routines it calls, the clock, the
# identity of the calling thread, and the crash handler of the Tessera code in this library. Threads wait on
# Standard/Os's ExclusiveLock and SignalCaster.
#
# The runtime library is shared (razorforge_runtime.dll / .so / .dylib), and this code is compiled into it, so a
# routine RazorForge calls is exported under its C name (#export), and calls into the rest of the library (the crash
# report) go through the C library.

module Ingrid/Runtime

import Standard/Format
import Standard/Os

# -- the C library -------------------------------------------------------------------

### C's `calloc`: allocates `count` zeroed objects of `size` bytes each.
### :param count: The number of objects.
### :param size: The size of one object in bytes.
### :returns: The zeroed block, or null when the allocation fails.
@external("c")
@symbol("calloc")
routine c_calloc(count: CSize, size: CSize) -> Addr

### C's `realloc`: resizes the block at `ptr` to `size` bytes, keeping its contents up to the smaller size.
### :param ptr: The block to resize, or null to allocate a new one.
### :param size: The new size in bytes.
### :returns: The resized block (possibly moved), or null when the allocation fails.
@external("c")
@symbol("realloc")
routine c_realloc(ptr: Addr, size: CSize) -> Addr

### C's `malloc`: allocates `size` uninitialized bytes.
### :param size: The size in bytes.
### :returns: The block, or null when the allocation fails.
@external("c")
@symbol("malloc")
routine c_malloc(size: CSize) -> Addr

### C's `free`: gives back a block from the C heap.
### :param ptr: The block to free, or null to do nothing.
@external("c")
@symbol("free")
routine c_free(ptr: Addr) -> None

### C's `getenv`: the value of an environment variable.
### :param name: The variable's name.
### :returns: The NUL-terminated value, or null when the variable is unset.
@external("c")
@symbol("getenv")
routine c_getenv(name: CStrView) -> @Byte

# -- the rest of the runtime library -------------------------------------------------

### Frees a block from rf_allocate_dynamic (Ingrid/tessera/memory.te, in the program): a result box. A C heap block,
### so free reclaims it here too.
### :param ptr: The block to free.
@expensive("frees heap memory")
routine rf_invalidate(ptr: Addr) -> None
    c_free(ptr)
    return

### Allocates `count` zeroed `T`s from the C heap.
### :typeparam T: The element type.
### :param count: The number of elements.
### :param what: The message of the error raised when the allocation fails.
### :returns: The first of the zeroed elements.
### :throws: Crashes with `OutOfMemoryError` (message `what`) when `calloc` fails.
routine zeroed[T](count: U64, what: CStrView) -> @T
needs T: typename
    p: Addr = c_calloc(count.to[CSize](), sizeof[T]().to[CSize]())
    if p.is_hollow()
        rf_throw(error_type: "OutOfMemoryError", message: what)
    else
        return p.to[@T]()

# -- the clock and the calling thread ------------------------------------------------

### The monotonic nanosecond clock the scheduler's timers use, for the timed-await bridge.
### :returns: The current monotonic time in nanoseconds.
@export("rf_monotonic_now_ns")
routine rf_monotonic_now_ns() -> U64
    return monotonic_now().nanoseconds()

### Win32's `GetCurrentThreadId`: the calling thread's identifier.
### :returns: The thread identifier.
@external("c")
@symbol("GetCurrentThreadId")
@callconv("stdcall")
@target(os: "windows")
routine c_get_current_thread_id() -> U32

### POSIX `pthread_self`: the calling thread's handle.
### :returns: The thread handle.
@external("c")
@symbol("pthread_self")
@target(os: not "windows")
routine c_pthread_self() -> Addr

### A stable identifier of the calling OS thread: only equality across calls on one thread matters (a lock policy
### detecting a re-entrant claim).
### :returns: The Win32 thread identifier, widened to U64.
@export("rf_current_thread_id")
@target(os: "windows")
routine rf_current_thread_id() -> U64
    return c_get_current_thread_id().to[U64]()

### A stable identifier of the calling OS thread: only equality across calls on one thread matters (a lock policy
### detecting a re-entrant claim).
### :returns: The `pthread_self` handle as a U64.
@export("rf_current_thread_id")
@target(os: not "windows")
routine rf_current_thread_id() -> U64
    return ptrtoint[Addr, U64](c_pthread_self())

### The environment variable name as a positive integer, or 0 when it is unset, empty, not a number, or not
### positive. Only the leading decimal digits count, and a value too large saturates at U64's maximum.
### :param name: The variable's name.
### :returns: The parsed value, or 0.
routine env_positive(name: CStrView) -> U64
    local text: @Byte = c_getenv(name)
    local value: @U64 <- 0

    if text.is_hollow()
        return 0
    else
        while true with i: U64 = 0
            digit_byte2: Byte = text.stride(i).peek()
            c2: U8 = digit_byte2.to[U8]()
            if c2 >= 48 and c2 <= 57
                next: U64 = value.peek() *^ 10 +^ (c2 - 48).to[U64]()
                next.poke_into(value)
                continue with i: i + 1
            else
                return value.peek()

# -- the crash handler of this library's Tessera code --------------------------------

### A crash in this library's Tessera code (a broken stdlib contract) is a RazorForge runtime error, with the same
### crash report and exit status as any other: the crash's name is the error type. The name is cut to 127 bytes and
### the message (with its place) to 1023.
### :param name: The kind of failure, which becomes the error type.
### :param message: What happened.
### :param place: Where the crash was raised, or null for no place.
@export("tessera_crash_handler")
@noreturn
routine runtime_crash_handler(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    local kind: @Array[Byte, 128] <- .hollow()
    local kind_ptr: @Byte = kind.to[@Byte]()
    local buffer: @Array[Byte, 1024] <- .hollow()
    local out: @SliceWriter <- .hollow()
    local kind_out: @SliceWriter <- SliceWriter.construct(data: kind.to[@Byte](), capacity: 127)

    write_str(out: kind_out, text: name)
    kind_text: @[Byte] = kind_out.getview()
    kind_ptr.stride(kind_text.count).poke(0x00)
    out.poke(SliceWriter.construct(data: buffer.to[@Byte](), capacity: 1023))
    write_str(out, text: message)
    if not place.is_hollow()
        out.write(" (at {place.file.peek()}:{place.line.peek()}:{place.column.peek()})")

    # The name and the text both end in a NUL for rf_throw.
    text: @[Byte] = out.getview()
    text_ptr: @Byte = buffer.to[@Byte]()
    text_ptr.stride(text.count).poke(0x00)
    rf_throw(error_type: kind_ptr.to[CStrView](), message: text_ptr.to[CStrView]())
