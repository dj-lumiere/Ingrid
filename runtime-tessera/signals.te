# The current process's events for RazorForge's and Suflae's CpuEventManager: when_interrupted (Ctrl+C, SIGINT) and
# when_terminated (SIGTERM, the console closing). Not a child's signal (rf_proc_term_signal) and not SignalCaster.
#
# Each kind has one handler slot. Putting a handler in a slot takes the event over from the system, and hands back the
# handler that held it before. Putting null in it gives the event back to the system. A handler runs outside signal
# context: on POSIX the signal handler only writes one byte to a pipe (the self-pipe trick, async-signal-safe) and a
# thread of its own reads it and runs the handler. On Windows the console calls its handler on a thread it starts, one
# event at a time, so an interrupt is handed to a thread of the runtime's own: the console's next event comes at once.
#
# When a when_terminated handler returns, the process ends with ProcessManager.exit_process and the status
# rf_set_exit_code stored last. When a when_interrupted handler returns, the program goes on. An event of a kind whose
# handler is still running takes the system's action: a second Ctrl+C ends a program whose handler is stuck.
#
# A handler is a box holding a RazorForge routine value's two words: the function and what it captured. The function
# is called with the captures when there are any. A box that left its slot may still be running on the handler's
# thread, so boxes are never freed.

module Ingrid/Runtime

import Standard/Os

### The box in the interrupt slot, null for none.
global INTERRUPT_HOLDER: @Addr
### The box in the terminate slot, null for none.
global TERMINATE_HOLDER: @Addr
### 1 from when an interrupt is taken until its handler returns.
global INTERRUPT_RUNNING: @U32
### 1 from when a termination request is taken until the process ends.
global TERMINATE_RUNNING: @U32

### 1 from when the console handler hands an interrupt to the dispatch thread until the thread takes it (Windows).
global INTERRUPT_PENDING: @U32

### Guards the one-time setup.
global SIGNALS_LOCK: @ExclusiveAccess
global SIGNALS_INSTALLED: @Bool

preset SIG_INTERRUPT: S32 = 0
preset SIG_TERMINATE: S32 = 1

### The slot of one kind.
### :param which: `SIG_TERMINATE` for the terminate slot, anything else for the interrupt slot.
### :returns: The slot.
routine holder_of(which: S32) -> @Addr
    slot: @Addr = when
        which == SIG_TERMINATE => TERMINATE_HOLDER
        else => INTERRUPT_HOLDER
    return slot

### The running mark of one kind.
### :param which: `SIG_TERMINATE` for the terminate mark, anything else for the interrupt mark.
### :returns: The mark.
routine running_of(which: S32) -> @U32
    mark: @U32 = when
        which == SIG_TERMINATE => TERMINATE_RUNNING
        else => INTERRUPT_RUNNING
    return mark

### Calls one handler. Its box holds a routine value's two words: the function, then what it captured (null for a
### named routine). A function with captures takes them after its own arguments.
### :param box: The handler's box.
routine invoke(box: Addr) -> None
    fn: Addr = box.to[@Addr]().peek()
    bound: Addr = box.to[@Addr]().stride(1).peek()
    local slot: @Addr <- fn
    if bound.is_hollow()
        bare: Callable[(), None] = slot.to[@Callable[(), None]]().peek()
        bare.call()
        return
    captured: Callable[(Addr,), None] = slot.to[@Callable[(Addr,), None]]().peek()
    captured.call(bound)
    return

### Runs the handler of an event that was taken, outside signal context. A request to end then ends the process.
### :param which: `SIG_TERMINATE` or `SIG_INTERRUPT`.
### :returns: False when no handler holds the slot now, so the system's action is due.
routine run_handler(which: S32) -> Bool
    box: Addr = holder_of(which).peek_atomic()
    if box.is_hollow()
        return false
    invoke(box)
    if which == SIG_TERMINATE
        ProcessManager.exit_process(exit_code())
    running_of(which).poke_atomic(0)
    return true

### Puts a handler in one kind's slot, and on the first handler installs the event dispatch.
### :param which: The kind: 1 for terminate, anything else for interrupt.
### :param handler_box: The routine value's box, or null to give the event back to the system.
### :returns: The box that held the slot before, null for none.
### :throws: Crashes with `TaskSpawnError` when the dispatch thread can't be started.
@export("rf_cpu_event_replace")
routine rf_cpu_event_replace(which: S32, handler_box: Addr) -> Addr
    kind: S32 = when
        which == SIG_TERMINATE => SIG_TERMINATE
        else => SIG_INTERRUPT
    SIGNALS_LOCK.lock()
    before: Addr = holder_of(kind).atomic_swap(handler_box)
    if not handler_box.is_hollow() and not SIGNALS_INSTALLED.peek()
        install_signal_dispatch()
    listen(kind, on: not handler_box.is_hollow())
    SIGNALS_LOCK.unlock()
    return before

# -- Windows: the console's control handler ------------------------------------------

### Win32's STATUS_CONTROL_C_EXIT, 0xC000013A: the status a process ends with when nothing handles Ctrl+C.
@target(os: "windows")
preset CONTROL_C_EXIT: S32 = -1073741510

### Win32's `SetConsoleCtrlHandler`: adds or removes a console control handler.
### :param handler: The handler.
### :param add: Nonzero to add, 0 to remove.
### :returns: Nonzero on success.
@external("c")
@symbol("SetConsoleCtrlHandler")
@callconv("stdcall")
@target(os: "windows")
routine c_set_console_ctrl_handler(handler: Callable[@callconv("stdcall"), (U32,), CInt],
    add: CInt) -> CInt

### On a thread the console starts, outside any signal context: takes the event for the handler of its kind. A
### request to end runs its handler here (the process ends after it). An interrupt goes to the dispatch thread, and
### this returns at once: the console hands its handlers one event at a time, so an interrupt handler run here would
### hold back the next interrupt until it returned. Returning 0 lets the system act, which ends the process: when no
### handler holds the slot, or when the kind's handler is still running.
### :param ctrl_type: The console event: Ctrl+C and Ctrl+Break interrupt, close, logoff, and shutdown terminate.
### :returns: 1 when a handler took the event, 0 to let the system act.
@target(os: "windows")
@callconv("stdcall")
routine console_ctrl_handler(ctrl_type: U32) -> CInt
    # CTRL_C_EVENT 0, CTRL_BREAK_EVENT 1. CTRL_CLOSE_EVENT 2, CTRL_LOGOFF_EVENT 5, CTRL_SHUTDOWN_EVENT 6
    if ctrl_type > 6 or ctrl_type == 3 or ctrl_type == 4
        return 0
    which: S32 = when
        ctrl_type <= 1 => SIG_INTERRUPT
        else => SIG_TERMINATE
    if holder_of(which).peek_atomic().is_hollow()
        return 0
    if running_of(which).atomic_swap(1) == 1
        return 0
    if which == SIG_INTERRUPT
        INTERRUPT_PENDING.poke_atomic(1)
        wake_one(INTERRUPT_PENDING)
        return 1
    if run_handler(which)
        return 1
    running_of(which).poke_atomic(0)
    return 0

### The dispatch thread: runs the interrupt handler for each interrupt the console handler hands it. When the slot has
### emptied since the interrupt came, the process ends as the system would end it.
### :param pending: INTERRUPT_PENDING.
@target(os: "windows")
routine interrupt_dispatch_main(pending: @U32) -> None
    rf_thread_stack_guarantee()

    while true
        if pending.atomic_swap(0) == 0
            wait_on(at: pending, expected: 0)
            continue
        if not run_handler(SIG_INTERRUPT)
            ProcessManager.exit_process(CONTROL_C_EXIT)
        continue

### Starts the dispatch thread and installs the console control handler. Called with the lock held.
### :throws: Crashes with `TaskSpawnError` when the dispatch thread can't be started.
@target(os: "windows")
routine install_signal_dispatch() -> None
    DEFAULT_THREADS.launch_unwatched(entry: interrupt_dispatch_main.to[Callable](),
        arg: INTERRUPT_PENDING)
    c_set_console_ctrl_handler(console_ctrl_handler.to[Callable](), 1)
    SIGNALS_INSTALLED.poke(true)
    return

### Nothing to do on Windows: the console handler stays installed and lets the system act for a slot with no handler.
### :param which: The kind.
### :param on: Whether a handler holds its slot.
@target(os: "windows")
routine listen(which: S32, on: Bool) -> None
    return

# -- POSIX: the self-pipe ------------------------------------------------------------

### [0] read by the dispatch thread, [1] written by the signal handler.
global SELF_PIPE: @Array[CInt, 2] <- [-1, -1]

preset SIGINT:  CInt = 2
preset SIGTERM: CInt = 15

### struct sigaction, for a plain handler with SA_RESTART. Linux: handler, mask (128 bytes), flags, restorer.
### macOS: handler, mask (4 bytes), flags.
@target(os: "linux")
record SigAction
    handler: Callable[(CInt,), None]
    mask: Array[U64, 16]
    flags: CInt
    restorer: Addr

@target(os: "macos")
record SigAction
    handler: Callable[(CInt,), None]
    mask: U32
    flags: CInt

### Makes a `SigAction` from its fields.
### :param handler: Its `handler`.
### :param mask: Its `mask`.
### :param flags: Its `flags`.
### :param restorer: Its `restorer`.
### :returns: The new value.
@target(os: "linux")
common routine SigAction.construct(handler: Callable[(CInt,), None], mask: Array[U64, 16],
    flags: CInt, restorer: Addr) -> Me
    return Me(handler, mask, flags, restorer)

### Releases nothing: a `SigAction` holds no memory of its own.
@target(os: "linux")
routine @SigAction.destruct() -> None
    return

### Makes a `SigAction` from its fields.
### :param handler: Its `handler`.
### :param mask: Its `mask`.
### :param flags: Its `flags`.
### :returns: The new value.
@target(os: "macos")
common routine SigAction.construct(handler: Callable[(CInt,), None], mask: U32, flags: CInt) -> Me
    return Me(handler, mask, flags)

### Releases nothing: a `SigAction` holds no memory of its own.
@target(os: "macos")
routine @SigAction.destruct() -> None
    return

### POSIX `sigaction`: sets the action for a signal.
### :param signo: The signal.
### :param action: The new action.
### :param old: Where the previous action goes, or null.
### :returns: 0 on success, -1 on error.
@external("c")
@symbol("sigaction")
@target(os: not "windows")
routine c_sigaction(signo: CInt, action: @SigAction, old: Addr) -> CInt

### POSIX `sigemptyset`: clears a signal set.
### :param set: The set to clear.
### :returns: 0 on success, -1 on error.
@external("c")
@symbol("sigemptyset")
@target(os: not "windows")
routine c_sigemptyset(set: Addr) -> CInt

### C's `raise`: sends a signal to the calling thread.
### :param signo: The signal.
### :returns: 0 on success.
@external("c")
@symbol("raise")
@target(os: not "windows")
secret routine c_raise_signal(signo: CInt) -> CInt

### Linux's `SA_RESTART` flag.
### :returns: `0x10000000`.
@target(os: "linux")
routine sa_restart() -> CInt
    return 0x10000000

### macOS's `SA_RESTART` flag.
### :returns: 2.
@target(os: "macos")
routine sa_restart() -> CInt
    return 2

### POSIX `pipe`: makes a pipe, its read end in `fds[0]` and its write end in `fds[1]`.
### :param fds: Where the two descriptors go.
### :returns: 0 on success, -1 on error.
@external("c")
@symbol("pipe")
@target(os: not "windows")
secret routine c_pipe(fds: @CInt) -> CInt

### glibc's `__errno_location`: the calling thread's errno.
### :returns: The address of errno.
@external("c")
@symbol("__errno_location")
@target(os: "linux")
secret routine c_errno_place() -> @CInt

### macOS's `__error`: the calling thread's errno.
### :returns: The address of errno.
@external("c")
@symbol("__error")
@target(os: "macos")
secret routine c_errno_place() -> @CInt

### The calling thread's errno.
### :returns: The current errno value.
@target(os: not "windows")
secret routine errno() -> CInt
    return c_errno_place().peek()

### The signal of a kind.
### :param which: `SIG_TERMINATE` or `SIG_INTERRUPT`.
### :returns: SIGTERM or SIGINT.
@target(os: not "windows")
routine signal_of(which: S32) -> CInt
    signo: CInt = when
        which == SIG_TERMINATE => SIGTERM
        else => SIGINT
    return signo

### Points a signal at posix_signal_handler, or back at the system's action. Async-signal-safe.
### :param signo: The signal.
### :param on: True for posix_signal_handler, false for the system's action.
@target(os: not "windows")
routine set_signal_action(signo: CInt, on: Bool) -> None
    local sa: @SigAction <- .hollow()

    c_memset(sa, 0, sizeof[SigAction]().to[CSize]())
    c_sigemptyset(sa.mask)
    if on
        sa.handler.poke(posix_signal_handler.to[Callable]())
        sa.flags.poke(sa_restart())
    c_sigaction(signo, sa, .hollow())
    return

### Lets the system act on a signal: puts its action back and sends the signal again, which ends the process. Inside
### the signal's own handler the signal waits until the handler returns. Async-signal-safe.
### :param signo: The signal.
@target(os: not "windows")
routine system_action(signo: CInt) -> None
    set_signal_action(signo, on: false)
    c_raise_signal(signo)
    return

### Points the kind's signal at posix_signal_handler while a handler holds its slot, else back at the system's action.
### Called with the lock held.
### :param which: The kind.
### :param on: Whether a handler holds its slot.
@target(os: not "windows")
routine listen(which: S32, on: Bool) -> None
    if SIGNALS_INSTALLED.peek()
        set_signal_action(signal_of(which), on)
    return

### Async-signal-safe: takes the event and writes its which-code byte to the self-pipe, retrying on EINTR. An event
### of a kind whose handler is still running takes the system's action instead.
### :param signo: The signal that came: SIGTERM writes 1, anything else 0.
@target(os: not "windows")
routine posix_signal_handler(signo: CInt) -> None
    local code: U8 = when

        signo == SIGTERM => 1
        else => 0
    local byte: @U8 <- code

    which: S32 = when
        signo == SIGTERM => SIG_TERMINATE
        else => SIG_INTERRUPT
    if running_of(which).atomic_swap(1) == 1
        system_action(signo)
        return
    while c_write(SELF_PIPE.to[@CInt]().stride(1).peek(), byte.to[@Byte](), 1) < 0 and errno() == 4
        pass
    then
        return

### Reads which-codes from the pipe and runs each one's handler. When the slot has emptied since the event came, the
### system acts on it.
### :param pipe: The self-pipe (SELF_PIPE), read from its first end.
@target(os: not "windows")
routine signal_dispatch_main(pipe: @Array[CInt, 2]) -> None
    local code: @U8 <- 0

    rf_thread_stack_guarantee()

    while true
        rc2: S64 = c_read(pipe[0], code.to[@Byte](), 1).to[S64]()
        if rc2 == 1
            which: S32 = code.peek().to[S32]()
            if not run_handler(which)
                system_action(signal_of(which))
            continue
        if rc2 < 0 and errno() == 4
            continue
        return

### Makes the self-pipe and starts the dispatch thread. Called with the lock held. If the pipe can't be made, nothing
### is installed, the signals keep the system's action, and a later handler tries again.
### :throws: Crashes with `TaskSpawnError` when the dispatch thread can't be started.
@target(os: not "windows")
routine install_signal_dispatch() -> None
    fds: @CInt = SELF_PIPE.to[@CInt]()
    if c_pipe(fds) != 0
        return
    DEFAULT_THREADS.launch_unwatched(entry: signal_dispatch_main.to[Callable](), arg: SELF_PIPE)
    SIGNALS_INSTALLED.poke(true)
    if not INTERRUPT_HOLDER.peek_atomic().is_hollow()
        set_signal_action(SIGINT, on: true)
    if not TERMINATE_HOLDER.peek_atomic().is_hollow()
        set_signal_action(SIGTERM, on: true)
    return
