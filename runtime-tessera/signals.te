# The current process's signals for the stdlib's Signals module: when_interrupted (Ctrl-C, SIGINT) and
# when_terminated (SIGTERM, the console closing). Not a child's signal (rf_proc_term_signal) and not SignalCaster.
#
# Registering a handler takes over the signal: the process no longer ends on it by itself, the RazorForge handlers
# decide. They run outside signal context: on POSIX the signal handler only writes one byte to a pipe (the
# self-pipe trick, async-signal-safe) and a thread of its own reads it and runs the handlers. On Windows the
# console already calls its handler on a thread of its own.
#
# A handler is a box holding a RazorForge routine value's two words: the function and what it captured. The function
# is called with the context first for a context handler (the raw pointer of a Roamed or Guarded handle), then the
# captures when there are any. Registration lasts the process's life, so the boxes are never freed.

module Ingrid/Runtime

import Standard/Os

global INTERRUPT_HANDLERS: @HandlerList
global TERMINATE_HANDLERS: @HandlerList
### Guards the lists and the one-time setup.
global SIGNALS_LOCK: @ExclusiveLock
global SIGNALS_INSTALLED: @Bool

preset SIG_INTERRUPT: S32 = 0
preset SIG_TERMINATE: S32 = 1

record HandlerEntry
    box: Addr
    ctx: Addr
    has_ctx: Bool

record HandlerList
    items: @HandlerEntry
    count: U64
    cap: U64

### Makes a `HandlerEntry` from its fields.
### :param box: Its `box`.
### :param ctx: Its `ctx`.
### :param has_ctx: Its `has_ctx`.
### :returns: The new value.
common routine HandlerEntry.construct(box: Addr, ctx: Addr, has_ctx: Bool) -> Me
    return Me(box, ctx, has_ctx)

### Releases nothing: a `HandlerEntry` holds no memory of its own.
routine @HandlerEntry.destruct() -> None
    return

### Makes a `HandlerList` from its fields.
### :param items: Its `items`.
### :param count: Its `count`.
### :param cap: Its `cap`.
### :returns: The new value.
common routine HandlerList.construct(items: @HandlerEntry, count: U64, cap: U64) -> Me
    return Me(items, count, cap)

### Releases nothing: a `HandlerList` holds no memory of its own.
routine @HandlerList.destruct() -> None
    return

### Calls one handler. Its box holds a routine value's two words: the function, then what it captured (null for a
### named routine). A function with captures takes them after its own arguments, so a context handler is called with
### the context and then the captures. A null box does nothing.
### :param e: The handler.
routine invoke(e: HandlerEntry) -> None
    if e.box.is_hollow()
        return
    fn: Addr = e.box.to[@Addr]().peek()
    bound: Addr = e.box.to[@Addr]().stride(1).peek()
    local slot: @Addr <- fn
    if e.has_ctx
        if bound.is_hollow()
            with_ctx: Callable[(Addr,), None] = slot.to[@Callable[(Addr,), None]]().peek()
            with_ctx.call(e.ctx)
            return
        with_both: Callable[(Addr, Addr), None] = slot.to[@Callable[(Addr, Addr), None]]().peek()
        with_both.call(e.ctx, bound)
        return
    if bound.is_hollow()
        bare: Callable[(), None] = slot.to[@Callable[(), None]]().peek()
        bare.call()
        return
    captured: Callable[(Addr,), None] = slot.to[@Callable[(Addr,), None]]().peek()
    captured.call(bound)
    return

### Runs every handler of a list, from a copy taken under the lock (a handler may register more). When the copy
### can't be allocated, no handler runs.
### :param list: The handlers to run.
routine dispatch(list: @HandlerList) -> None
    SIGNALS_LOCK.lock()
    n: U64 = list.count.peek()
    if not (n == 0)
        bytes: U64 = n * sizeof[HandlerEntry]()
        snapshot: Addr = c_malloc(bytes.to[CSize]())
        if not snapshot.is_hollow()
            c_memcpy(snapshot, list.items.peek(), bytes.to[CSize]())
            SIGNALS_LOCK.unlock()

            snapshot2: @HandlerEntry = snapshot.to[@HandlerEntry]()

            each i in 0 til n
                invoke(snapshot2.stride(i).peek())
            then
                c_free(snapshot2)
                return
    SIGNALS_LOCK.unlock()
    return

### Runs the handlers of one signal.
### :param which: `SIG_TERMINATE` for the terminate handlers, anything else for the interrupt handlers.
routine dispatch_which(which: S32) -> None
    list: @HandlerList = when
        which == SIG_TERMINATE => TERMINATE_HANDLERS
        else => INTERRUPT_HANDLERS
    dispatch(list)
    return

### Appends a handler, doubling the storage (from 4) when it is full. When the storage can't grow, the handler is
### dropped.
### :param entry: The handler to add.
routine @HandlerList.append(entry: HandlerEntry) -> None
    local n: U64 = me.count.peek()

    if n == me.cap.peek()
        cap: U64 = me.cap.peek()
        ncap: U64 = when
            cap == 0 => 4
            else => cap * 2
        grown: Addr = c_realloc(me.items.peek(), (ncap * sizeof[HandlerEntry]()).to[CSize]())
        # out of memory: the registration is dropped, as registration is best-effort
        if grown.is_hollow()
            return
        me.items.poke(grown.to[@HandlerEntry]())
        me.cap.poke(ncap)
    slot: @HandlerEntry = me.items.peek().stride(n)
    slot.poke(entry)
    me.count.poke(n + 1)
    return

### Adds a handler to one signal's list under the lock, and installs the signal dispatch on the first registration.
### :param which: `SIG_TERMINATE` for the terminate list, anything else for the interrupt list.
### :param entry: The handler to add.
### :throws: Crashes with `TaskSpawnError` on POSIX when the dispatch thread can't be started.
routine register_entry(which: S32, entry: HandlerEntry) -> None
    SIGNALS_LOCK.lock()
    list: @HandlerList = when
        which == SIG_TERMINATE => TERMINATE_HANDLERS
        else => INTERRUPT_HANDLERS
    list.append(entry)
    if not SIGNALS_INSTALLED.peek()
        install_signal_dispatch()
    SIGNALS_LOCK.unlock()
    return

### A Routine[(), None] handler for which: 0 interrupt (SIGINT, Ctrl-C), 1 terminate (SIGTERM, the console closing).
### :param which: The signal: 1 for terminate, anything else for interrupt.
### :param handler_box: The Routine value's closure box.
### :throws: Crashes with `TaskSpawnError` on POSIX when the dispatch thread can't be started.
@export("rf_signal_register")
routine rf_signal_register(which: S32, handler_box: Addr) -> None
    register_entry(which, entry: HandlerEntry(box: handler_box, ctx: .hollow(), has_ctx: false))
    return

### A Routine[(Ctx,), None] handler, called with context each time the signal comes.
### :param which: The signal: 1 for terminate, anything else for interrupt.
### :param handler_box: The Routine value's closure box.
### :param context: The raw pointer passed to the handler.
### :throws: Crashes with `TaskSpawnError` on POSIX when the dispatch thread can't be started.
@export("rf_signal_register_ctx")
routine rf_signal_register_ctx(which: S32, handler_box: Addr, context: Addr) -> None
    register_entry(which, entry: HandlerEntry(box: handler_box, ctx: context, has_ctx: true))
    return

# -- Windows: the console's control handler ------------------------------------------

### Win32's `SetConsoleCtrlHandler`: adds or removes a console control handler.
### :param handler: The handler.
### :param add: Nonzero to add, 0 to remove.
### :returns: Nonzero on success.
@external("c")
@symbol("SetConsoleCtrlHandler")
@callconv("stdcall")
@target(os: "windows")
routine c_set_console_ctrl_handler(handler: Callable[@callconv("stdcall"), (U32,), CInt],
    add: CInt) -> CInt

### On a thread the console starts, outside any signal context: runs the handlers, and TRUE keeps the default
### (the end of the process) from happening.
### :param ctrl_type: The console event: Ctrl-C and Ctrl-Break interrupt, close, logoff, and shutdown terminate.
### :returns: 1 when handlers ran, 0 for any other event (the default applies).
@target(os: "windows")
@callconv("stdcall")
routine console_ctrl_handler(ctrl_type: U32) -> CInt
    # CTRL_C_EVENT 0, CTRL_BREAK_EVENT 1. CTRL_CLOSE_EVENT 2, CTRL_LOGOFF_EVENT 5, CTRL_SHUTDOWN_EVENT 6
    when
        ctrl_type <= 1 =>
            dispatch_which(SIG_INTERRUPT)
            return 1
        ctrl_type == 2 or ctrl_type == 5 or ctrl_type == 6 =>
            dispatch_which(SIG_TERMINATE)
            return 1
        else => return 0

### Installs the console control handler. Called with the lock held.
@target(os: "windows")
routine install_signal_dispatch() -> None
    c_set_console_ctrl_handler(console_ctrl_handler.to[Callable](), 1)
    SIGNALS_INSTALLED.poke(true)
    return

# -- POSIX: the self-pipe ------------------------------------------------------------

### [0] read by the dispatch thread, [1] written by the signal handler.
global SELF_PIPE: @Array[CInt, 2] <- [-1, -1]

preset SIGINT:  CInt = 2
preset SIGTERM: CInt = 15

### struct sigaction, for a plain handler with SA_RESTART. Linux: handler, mask (128 bytes), flags, restorer.
### macOS: handler, mask (4 bytes), flags.
@target(os: "linux")
record SigAction
    handler: Callable[(CInt,), None]
    mask: Array[U64, 16]
    flags: CInt
    restorer: Addr

@target(os: "macos")
record SigAction
    handler: Callable[(CInt,), None]
    mask: U32
    flags: CInt

### Makes a `SigAction` from its fields.
### :param handler: Its `handler`.
### :param mask: Its `mask`.
### :param flags: Its `flags`.
### :param restorer: Its `restorer`.
### :returns: The new value.
@target(os: "linux")
common routine SigAction.construct(handler: Callable[(CInt,), None], mask: Array[U64, 16], flags: CInt,
    restorer: Addr) -> Me
    return Me(handler, mask, flags, restorer)

### Releases nothing: a `SigAction` holds no memory of its own.
@target(os: "linux")
routine @SigAction.destruct() -> None
    return

### Makes a `SigAction` from its fields.
### :param handler: Its `handler`.
### :param mask: Its `mask`.
### :param flags: Its `flags`.
### :returns: The new value.
@target(os: "macos")
common routine SigAction.construct(handler: Callable[(CInt,), None], mask: U32, flags: CInt) -> Me
    return Me(handler, mask, flags)

### Releases nothing: a `SigAction` holds no memory of its own.
@target(os: "macos")
routine @SigAction.destruct() -> None
    return

### POSIX `sigaction`: sets the action for a signal.
### :param signo: The signal.
### :param action: The new action.
### :param old: Where the previous action goes, or null.
### :returns: 0 on success, -1 on error.
@external("c")
@symbol("sigaction")
@target(os: not "windows")
routine c_sigaction(signo: CInt, action: @SigAction, old: Addr) -> CInt

### POSIX `sigemptyset`: clears a signal set.
### :param set: The set to clear.
### :returns: 0 on success, -1 on error.
@external("c")
@symbol("sigemptyset")
@target(os: not "windows")
routine c_sigemptyset(set: Addr) -> CInt

### Linux's `SA_RESTART` flag.
### :returns: `0x10000000`.
@target(os: "linux")
routine sa_restart() -> CInt
    return 0x10000000

### macOS's `SA_RESTART` flag.
### :returns: 2.
@target(os: "macos")
routine sa_restart() -> CInt
    return 2

### POSIX `pipe`: makes a pipe, its read end in `fds[0]` and its write end in `fds[1]`.
### :param fds: Where the two descriptors go.
### :returns: 0 on success, -1 on error.
@external("c")
@symbol("pipe")
@target(os: not "windows")
secret routine c_pipe(fds: @CInt) -> CInt

### glibc's `__errno_location`: the calling thread's errno.
### :returns: The address of errno.
@external("c")
@symbol("__errno_location")
@target(os: "linux")
secret routine c_errno_place() -> @CInt

### macOS's `__error`: the calling thread's errno.
### :returns: The address of errno.
@external("c")
@symbol("__error")
@target(os: "macos")
secret routine c_errno_place() -> @CInt

### The calling thread's errno.
### :returns: The current errno value.
@target(os: not "windows")
secret routine errno() -> CInt
    return c_errno_place().peek()

### Async-signal-safe: writes the which-code byte to the self-pipe, retrying on EINTR, and returns.
### :param signo: The signal that came: SIGTERM writes 1, anything else 0.
@target(os: not "windows")
routine posix_signal_handler(signo: CInt) -> None
    local code: U8 = when

        signo == SIGTERM => 1
        else => 0
    local byte: @U8 <- code

    while c_write(SELF_PIPE.to[@CInt]().stride(1).peek(), byte.to[@Byte](), 1) < 0 and errno() == 4
        pass
    then
        return

### Reads which-codes from the pipe and runs the handlers.
### :param pipe: The self-pipe (SELF_PIPE), read from its first end.
@target(os: not "windows")
routine signal_dispatch_main(pipe: @Array[CInt, 2]) -> None
    local code: @U8 <- 0

    rf_thread_stack_guarantee()

    while true
        rc2: S64 = c_read(pipe[0], code.to[@Byte](), 1).to[S64]()
        if rc2 == 1
            dispatch_which(code.peek().to[S32]())
            continue
        if rc2 < 0 and errno() == 4
            continue
        return

### Makes the self-pipe, starts the dispatch thread, and sets the handler for SIGINT and SIGTERM. Called with the lock
### held. If the pipe can't be made, nothing is installed and a later registration tries again.
### :throws: Crashes with `TaskSpawnError` when the dispatch thread can't be started.
@target(os: not "windows")
routine install_signal_dispatch() -> None
    fds: @CInt = SELF_PIPE.to[@CInt]()
    if c_pipe(fds) != 0
        return
    DEFAULT_THREADS.launch_unwatched(entry: signal_dispatch_main.to[Callable](), arg: SELF_PIPE)
    local sa: @SigAction <- .hollow()
    c_memset(sa, 0, sizeof[SigAction]().to[CSize]())
    sa.handler.poke(posix_signal_handler.to[Callable]())
    c_sigemptyset(sa.mask)
    sa.flags.poke(sa_restart())
    c_sigaction(SIGINT, sa, .hollow())
    c_sigaction(SIGTERM, sa, .hollow())
    SIGNALS_INSTALLED.poke(true)
    return
