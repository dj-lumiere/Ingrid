// The console for RazorForge and Suflae (show, alert, ask), the OS side of the crash report (writing to stderr,
// flushing, exiting with the crash status), process start-up, and C-string helpers, over Tessera's Standard::Os In,
// Out, and Err.
//
// What is RazorForge's here is the policy. Standard output is buffered, and flushed after every show when it is an
// interactive terminal, so prompts and progress appear at once. On a pipe or a file it goes out a bufferful at a time
// (a write per show costs a system call and a reader's round trip per print). Buffered output still arrives: at exit
// (registered with atexit at start-up), before every ask, on rf_console_flush, and before a crash report.
// RF_FLUSH_STDOUT=1 flushes after every show on a pipe too, so a test harness keeps what was written before a hang or
// a crash. alert writes to stderr in magenta. ask_line skips empty lines.

module Ingrid::Runtime

import Standard::Alloc
import Standard::Os

/// C's `strcpy`: copies the NUL-terminated string at `src`, terminator included, to `dest`.
/// :param dest: Where the copy goes, large enough for it.
/// :param src: The string to copy.
/// :returns: `dest`.
#[external("c"), symbol("strcpy")]
routine c_strcpy(dest: @Byte, src: @Byte) -> @Byte

/// C's `strcmp`: compares two NUL-terminated strings byte by byte.
/// :param a: The first string.
/// :param b: The second string.
/// :returns: Negative, zero, or positive as `a` sorts before, equal to, or after `b`.
#[external("c"), symbol("strcmp")]
routine c_strcmp(a: @Byte, b: @Byte) -> CInt

/// C's `atexit`: registers a routine to run at normal process exit.
/// :param at_exit: The routine to run.
/// :returns: 0 on success.
#[external("c"), symbol("atexit")]
routine c_atexit(at_exit: Callable<(), Void>) -> CInt

// -- standard output -----------------------------------------------------------------

global STDOUT: @OutputBuffer

/// Whether standard output is flushed after every show (an interactive terminal, or RF_FLUSH_STDOUT=1): -1 until
/// asked.
global STDOUT_INTERACTIVE: @CInt <- -1

preset OUTPUT_BUFFER: USize = 8192

/// What show has written and Out hasn't been given yet, behind a lock (shows come from every thread).
record OutputBuffer
    lock  : Mutex
    bytes : Array<Byte, OUTPUT_BUFFER>
    count : USize

/// Whether standard output is flushed after every show: true when RF_FLUSH_STDOUT starts with `1` or stdout is a
/// terminal. The answer is worked out once and cached.
/// :returns: True when every show is flushed.
routine is_stdout_interactive() -> Bool
    block entry()
        cached : CInt = STDOUT_INTERACTIVE.load()
        branch cached.ge(0)
            ? return(cached.eq(1))
            : continue
        force : @Byte = c_getenv("RF_FLUSH_STDOUT")
        branch force.is_null()
            ? terminal()
            : continue
        branch force.load().eq(b'1')
            ? decide(true)
            : terminal()

    block terminal()
        jump decide(Out.is_terminal())

    block decide(interactive: Bool)
        STDOUT_INTERACTIVE.store(interactive ? 1 : 0)
        return(interactive)

/// Gives Out what the buffer holds and empties it. The caller holds the lock.
routine OutputBuffer.drain(self: @Self) -> Void
    block entry()
        n : USize = self.count.load()
        branch n.eq(0)
            ? return()
            : continue
        Out.write_all_result(self.bytes.to<@Byte>(), n)
        self.count.store(0)
        return()

/// Writes `count` bytes to standard output through the shared buffer. When they don't fit, the buffer is drained
/// first, and bytes that fill a whole buffer go straight out. On an interactive stdout the buffer is drained after
/// every show.
/// :param ptr: The bytes to write.
/// :param count: The number of bytes.
#export("rf_console_show")
routine rf_console_show(ptr: @Byte, count: USize) -> Void
    shared out : @OutputBuffer = STDOUT

    block entry()
        out.lock.lock()
        needed : USize = out.count.load().add(count)
        branch needed.gt(OUTPUT_BUFFER)
            ? continue
            : keep()
        out.drain()
        // What doesn't fit an empty buffer goes straight out.
        branch count.ge(OUTPUT_BUFFER)
            ? direct()
            : keep()

    block direct()
        Out.write_all_result(ptr, count)
        jump done()

    block keep()
        out.bytes.to<@Byte>().stride(out.count.load()).copy(ptr, count)
        next_count : USize = out.count.load().add(count)
        next_count.store_into(out.count)
        jump done()

    block done()
        branch is_stdout_interactive()
            ? continue
            : unlock()
        out.drain()
        jump unlock()

    block unlock()
        out.lock.unlock()
        return()

/// Gives standard output everything buffered so far.
#export("rf_console_flush")
routine rf_console_flush() -> Void
    block entry()
        out : @OutputBuffer = STDOUT
        out.lock.lock()
        out.drain()
        out.lock.unlock()
        return()

/// Writes `count` bytes on stderr, in magenta. Standard output is flushed first, so the two read in the order they
/// were written.
/// :param ptr: The bytes to write.
/// :param count: The number of bytes.
#export("rf_console_alert")
routine rf_console_alert(ptr: @Byte, count: USize) -> Void
    block entry()
        rf_console_flush()
        on  : Bytes = "\x1B[95m"
        off : Bytes = "\x1B[0m"
        Err.write_all_result(on.data, on.count())
        Err.write_all_result(ptr, count)
        Err.write_all_result(off.data, off.count())
        return()

// -- standard input ------------------------------------------------------------------

/// `text` from the malloc heap as a NUL-terminated string the caller frees, or null. The block is grown by one byte
/// for the terminator, and freed when that fails.
/// :param text: The text, allocated with C's heap. It is taken over.
/// :returns: The NUL-terminated string, or null when the reallocation fails.
routine terminated_text(text: Bytes) -> @Byte
    block entry()
        n   : USize = text.count
        buf : Addr  = c_realloc(text.data, n.add(1))
        branch buf.is_null()
            ? lost()
            : continue
        terminator : @Byte = buf.to<@Byte>().stride(n)
        terminator.store(0x00)
        return(buf.to<@Byte>())

    block lost()
        c_free(text.data)
        return(null)

/// {terminated_text} of the text when there is one.
/// :param text: The text read, or absent at the end of the input.
/// :returns: The NUL-terminated string, or null when `text` is absent or the reallocation fails.
routine terminated_option(text: Option<Bytes>) -> @Byte
    block entry()
        when text
            .Present(t) -> return(terminated_text(t))
            .Absent     -> return(null)

/// The next non-empty line from stdin, without its end, or null at the end of the input. Standard output is flushed
/// first.
/// :returns: The line as a NUL-terminated string the caller frees, or null.
#export("rf_console_ask_line")
routine rf_console_ask_line() -> @Byte
    shared alloc : @Allocator <- uninit

    block entry()
        rf_console_flush()
        alloc.store(heap())
        jump next()

    block next()
        line : Option<Bytes> = In.read_line_checked(alloc)
        when line
            .Present(t) -> continue
            .Absent     -> return(null)
        branch t.count.eq(0)
            ? skip(t)
            : return(terminated_text(t))

    block skip(t: Bytes)
        c_free(t.data)
        jump next()

/// The next word from stdin, or null at the end of the input. Standard output is flushed first.
/// :returns: The word as a NUL-terminated string the caller frees, or null.
#export("rf_console_ask_word")
routine rf_console_ask_word() -> @Byte
    block entry()
        rf_console_flush()
        claim alloc : @Allocator <- heap()
        return(terminated_option(In.read_word_checked(alloc)))

/// Up to `count` bytes from stdin, NUL-terminated. Standard output is flushed first.
/// :param count: The most bytes to read.
/// :returns: The bytes as a NUL-terminated string the caller frees, or null when the reallocation fails.
#export("rf_console_ask_bytes")
routine rf_console_ask_bytes(count: USize) -> @Byte
    block entry()
        rf_console_flush()
        claim alloc : @Allocator <- heap()
        return(terminated_text(In.read_count(count, alloc)))

/// The rest of stdin, NUL-terminated. Standard output is flushed first.
/// :returns: The bytes as a NUL-terminated string the caller frees, or null when the reallocation fails.
#export("rf_console_ask_all")
routine rf_console_ask_all() -> @Byte
    block entry()
        rf_console_flush()
        claim alloc : @Allocator <- heap()
        return(terminated_text(In.read_all(alloc)))

// -- the crash report's OS side ------------------------------------------------------

/// Bytes on stderr as they are, with no color or newline. A null `ptr` or a `count` of 0 writes nothing.
/// :param ptr: The bytes to write.
/// :param count: The number of bytes.
#export("rf_console_error")
routine rf_console_error(ptr: @Byte, count: USize) -> Void
    block entry()
        branch ptr.is_null().bitor(count.eq(0))
            ? return()
            : continue
        Err.write_all_result(ptr, count)
        return()

/// Flushes stdout, so a program's output appears before the crash report that follows it.
#export("rf_flush_output")
routine rf_flush_output() -> Void
    block entry()
        rf_console_flush()
        return()

/// Ends the program with the crash status, after the report.
#[export("rf_crash_exit"), noreturn]
routine rf_crash_exit() -> Void
    block entry()
        rf_console_flush()
        exit(CRASH_STATUS)

// -- start-up ------------------------------------------------------------------------

/// Process start-up: the I/O threads start on the main thread, standard output's buffer is flushed at exit, and
/// stderr takes ANSI colors (on Windows a console needs asking).
#export("rf_runtime_init")
routine rf_runtime_init() -> Void
    block entry()
        rf_io_runtime_init()
        c_atexit(rf_console_flush.to<Callable>())
        Err.enable_colors()
        return()

/// Sets the exit status the program ends with when its `start` returns: RazorForge's and Suflae's `set_exit_code`.
/// The last store wins (Standard::Os keeps it in one atomic value).
/// :param code: The exit status, 0 for success.
#export("rf_set_exit_code")
routine rf_set_exit_code(code: S32) -> Void
    block entry()
        set_exit_code(code)
        return()

/// The exit status the program ends with when its `start` returns: what `rf_set_exit_code` stored last, 0 when
/// nothing did. The builder's `main` returns it after `start`.
/// :returns: The status.
#export("rf_exit_code")
routine rf_exit_code() -> S32
    block entry()
        return(exit_code())

// -- C strings -----------------------------------------------------------------------

/// The length of a NUL-terminated string.
/// :param cstr: The string.
/// :returns: The number of bytes before the terminator.
#export("rf_cstr_count")
routine rf_cstr_count(cstr: @Byte) -> USize
    block entry()
        return(c_strlen(cstr))

/// Copies the NUL-terminated string at `src`, terminator included, to `dest`.
/// :param dest: Where the copy goes, large enough for it.
/// :param src: The string to copy.
/// :returns: `dest`.
#export("rf_cstr_copy")
routine rf_cstr_copy(dest: @Byte, src: @Byte) -> @Byte
    block entry()
        return(c_strcpy(dest, src))

/// Compares two NUL-terminated strings byte by byte.
/// :param a: The first string.
/// :param b: The second string.
/// :returns: Negative, zero, or positive as `a` sorts before, equal to, or after `b`.
#export("rf_cstr_compare")
routine rf_cstr_compare(a: @Byte, b: @Byte) -> S32
    block entry()
        return(c_strcmp(a, b))
