#[external("c"), symbol("MultiByteToWideChar"), callconv("stdcall"), target(os: "windows")]
routine c_multi_byte_to_wide_char(code_page: U32, flags: U32, s: @Byte, n: CInt, w: @U16, wn: CInt) -> CInt

#[external("c"), symbol("wcslen"), target(os: "windows")]
routine c_wcslen(s: @U16) -> USize

#[external("c"), symbol("_wcsicmp"), target(os: "windows")]
routine c_wcsicmp(a: @U16, b: @U16) -> CInt

#[external("c"), symbol("__p__environ"), target(os: "windows")]
routine c_p_environ() -> @@@Byte

/// SECURITY_ATTRIBUTES.
record SecurityAttributes
    length         : U32
    descriptor     : Addr
    inherit_handle : CInt

/// STARTUPINFOW.
record StartupInfo
    cb             : U32
    reserved       : Addr
    desktop        : Addr
    title          : Addr
    x              : U32
    y              : U32
    x_size         : U32
    y_size         : U32
    x_count_chars  : U32
    y_count_chars  : U32
    fill_attribute : U32
    flags          : U32
    show_window    : U16
    cb_reserved2   : U16
    reserved2      : Addr
    std_input      : Addr
    std_output     : Addr
    std_error      : Addr

/// PROCESS_INFORMATION.
record ProcessInformation
    process    : Addr
    thread     : Addr
    process_id : U32
    thread_id  : U32

#[external("c"), symbol("CreateFileW"), callconv("stdcall"), target(os: "windows")]
routine c_create_file(name: @U16, access: U32, share: U32, security: @SecurityAttributes, disposition: U32,
        flags: U32, template: Addr) -> Addr

#[external("c"), symbol("CreatePipe"), callconv("stdcall"), target(os: "windows")]
routine c_create_pipe(read: @Addr, write: @Addr, security: @SecurityAttributes, size: U32) -> CInt

#[external("c"), symbol("SetHandleInformation"), callconv("stdcall"), target(os: "windows")]
routine c_set_handle_information(handle: Addr, mask: U32, flags: U32) -> CInt

#[external("c"), symbol("CreateProcessW"), callconv("stdcall"), target(os: "windows")]
routine c_create_process(application: Addr, command_line: @U16, process_attrs: Addr, thread_attrs: Addr,
        inherit: CInt, flags: U32, environment: Addr, directory: @U16, startup: @StartupInfo,
        info: @ProcessInformation) -> CInt

#[external("c"), symbol("ReadFile"), callconv("stdcall"), target(os: "windows")]
routine c_read_file(handle: Addr, buffer: @Byte, size: U32, read: @U32, overlapped: Addr) -> CInt

#[external("c"), symbol("WaitForSingleObject"), callconv("stdcall"), target(os: "windows")]
routine c_wait_for_single_object(handle: Addr, millis: U32) -> U32

#[external("c"), symbol("GetExitCodeProcess"), callconv("stdcall"), target(os: "windows")]
routine c_get_exit_code_process(process: Addr, code: @U32) -> CInt

#[external("c"), symbol("CloseHandle"), callconv("stdcall"), target(os: "windows")]
routine c_close_handle(handle: Addr) -> CInt

#target(os: "windows")
routine parent_environment() -> @@Byte
    block entry():
        return(c_p_environ().load())

/// UTF-8 to a malloc'd UTF-16 string, or null (for null too).
#target(os: "windows")
routine wide(s: @Byte) -> @U16
    block entry():
        branch s.is_null()
            ? return(null)
            : continue
        // CP_UTF8
        n : CInt = c_multi_byte_to_wide_char(65001, 0, s, -1, null, 0)
        branch n.le(0)
            ? return(null)
            : continue
        w : Addr = c_malloc(n.to<USize>().mul(2))
        branch w.is_null()
            ? return(null)
            : continue
        c_multi_byte_to_wide_char(65001, 0, s, -1, w.to<@U16>(), n)
        return(w.to<@U16>())

/// Whether one of the len units at s is a or b or c.
#target(os: "windows")
routine has_any(s: @U16, len: USize, a: U16, b: U16, c: U16) -> Bool
    block entry():
        jump look(0)

    block look(i: USize):
        branch i.eq(len)
            ? return(false)
            : continue
        u : U16 = s.stride(i).load()
        branch u.eq(a).bitor(u.eq(b)).bitor(u.eq(c))
            ? return(true)
            : look(i.add(1))

/// Appends one argument to a command line as CommandLineToArgvW reads it back, quoted only when it has to be
/// (empty, or holding a space, a tab or a quote), as libuv's quote_cmd_arg does. target has room for 2 * len + 3
/// units. The end.
#target(os: "windows")
routine quote_arg(source: @U16, target: @U16) -> @U16
    block entry():
        len : USize = c_wcslen(source)
        branch len.eq(0)
            ? empty()
            : continue
        // ' ', '\t', '"'
        branch has_any(source, len, 32, 9, 34)
            ? continue
            : plain(len)
        // '"', '\\'
        branch has_any(source, len, 34, 92, 34)
            ? escaped(len)
            : quoted(len)

    block empty():
        target.store(34)
        target.stride(1).store(34)
        return(target.stride(2))

    block plain(len: USize):
        c_memcpy(target, source, len.mul(2))
        return(target.stride(len))

    block quoted(len: USize):
        target.store(34)
        c_memcpy(target.stride(1), source, len.mul(2))
        target.stride(len.add(1)).store(34)
        return(target.stride(len.add(2)))

    // Backslashes before a quote or before the closing quote are doubled, and a quote is escaped: built backwards,
    // then reversed.
    block escaped(len: USize):
        target.store(34)
        start : @U16 = target.stride(1)
        jump back(len, start, start, true)

    block back(i: USize, start: @U16, at: @U16, quote_hit: Bool):
        branch i.eq(0)
            ? reverse(start, at, start, at.stride(-1))
            : continue
        u : U16 = source.stride(i.sub(1)).load()
        at.store(u)
        branch quote_hit.bitand(u.eq(92))
            ? doubled(i, start, at)
            : continue
        branch u.eq(34)
            ? quote(i, start, at)
            : back(i.sub(1), start, at.stride(1), false)

    block doubled(i: USize, start: @U16, at: @U16):
        at.stride(1).store(92)
        jump back(i.sub(1), start, at.stride(2), true)

    block quote(i: USize, start: @U16, at: @U16):
        at.stride(1).store(92)
        jump back(i.sub(1), start, at.stride(2), true)

    block reverse(start: @U16, end: @U16, a: @U16, b: @U16):
        branch ptrtoint<@U16, U64>(a).lt(ptrtoint<@U16, U64>(b))
            ? continue
            : close(end)
        t : U16 = a.load()
        a.store(b.load())
        b.store(t)
        jump reverse(start, end, a.stride(1), b.stride(-1))

    block close(end: @U16):
        end.store(34)
        return(end.stride(1))

/// The whole command line, each argument quoted as needed and separated by spaces: malloc'd, or null.
#target(os: "windows")
routine command_line(argv: @@Byte) -> @U16
    block entry():
        jump size(0, 1)

    block size(i: USize, cap: USize):
        arg : @Byte = argv.stride(i).load()
        branch arg.is_null()
            ? allocate(cap)
            : size(i.add(1), cap.add(c_strlen(arg).mul(2)).add(4))

    block allocate(cap: USize):
        line : Addr = c_malloc(cap.mul(2))
        branch line.is_null()
            ? return(null)
            : append(line.to<@U16>(), line.to<@U16>(), 0)

    block append(line: @U16, pos: @U16, i: USize):
        arg : @Byte = argv.stride(i).load()
        branch arg.is_null()
            ? finish(line, pos)
            : continue
        w : @U16 = wide(arg)
        branch w.is_null()
            ? fail(line)
            : continue
        branch i.gt(0)
            ? space(line, pos, i, w)
            : quote(line, pos, i, w)

    block space(line: @U16, pos: @U16, i: USize, w: @U16):
        pos.store(32)
        jump quote(line, pos.stride(1), i, w)

    block quote(line: @U16, pos: @U16, i: USize, w: @U16):
        end : @U16 = quote_arg(w, pos)
        c_free(w)
        jump append(line, end, i.add(1))

    block fail(line: @U16):
        c_free(line)
        return(null)

    block finish(line: @U16, pos: @U16):
        pos.store(0)
        return(line)

/// A Unicode environment block ("K=V\0...\0\0"), sorted as Windows expects: malloc'd, or null (for null too).
#target(os: "windows")
routine env_block(envp: @@Byte) -> @U16
    block entry():
        branch envp.is_null()
            ? return(null)
            : count(0)

    block count(n: USize):
        branch envp.stride(n).load().is_null()
            ? continue
            : count(n.add(1))
        wides : @@U16 = zeroed<@U16>(n.add(1), "Failed to allocate the environment block")
        jump widen(n, wides, 0, 1)

    block widen(n: USize, wides: @@U16, i: USize, total: USize):
        branch i.eq(n)
            ? sort(n, wides, total, 1)
            : continue
        w : @U16 = wide(envp.stride(i).load())
        branch w.is_null()
            ? fail(n, wides)
            : continue
        wides.stride(i).store(w)
        jump widen(n, wides, i.add(1), total.add(c_wcslen(w)).add(1))

    // Insertion sort, case-insensitive.
    block sort(n: USize, wides: @@U16, total: USize, i: USize):
        branch i.ge(n)
            ? build(n, wides, total)
            : sink(n, wides, total, i, i)

    block sink(n: USize, wides: @@U16, total: USize, i: USize, j: USize):
        branch j.eq(0)
            ? sort(n, wides, total, i.add(1))
            : continue
        a : @U16 = wides.stride(j.sub(1)).load()
        b : @U16 = wides.stride(j).load()
        branch c_wcsicmp(a, b).gt(0)
            ? continue
            : sort(n, wides, total, i.add(1))
        wides.stride(j.sub(1)).store(b)
        wides.stride(j).store(a)
        jump sink(n, wides, total, i, j.sub(1))

    block build(n: USize, wides: @@U16, total: USize):
        memory : Addr = c_malloc(total.mul(2))
        jump place(n, wides, memory.to<@U16>(), memory.to<@U16>(), 0)

    block place(n: USize, wides: @@U16, memory: @U16, pos: @U16, i: USize):
        branch i.eq(n)
            ? finish(wides, memory, pos)
            : continue
        w : @U16 = wides.stride(i).load()
        branch memory.is_null()
            ? skip(n, wides, memory, pos, i, w)
            : continue
        len : USize = c_wcslen(w).add(1)
        c_memcpy(pos, w, len.mul(2))
        c_free(w)
        jump place(n, wides, memory, pos.stride(len), i.add(1))

    block skip(n: USize, wides: @@U16, memory: @U16, pos: @U16, i: USize, w: @U16):
        c_free(w)
        jump place(n, wides, memory, pos, i.add(1))

    block finish(wides: @@U16, memory: @U16, pos: @U16):
        c_free(wides)
        branch memory.is_null()
            ? return(null)
            : continue
        pos.store(0)
        return(memory)

    block fail(n: USize, wides: @@U16):
        jump free_wides(wides, 0)

    block free_wides(wides: @@U16, i: USize):
        w : @U16 = wides.stride(i).load()
        branch w.is_null()
            ? freed(wides)
            : continue
        c_free(w)
        jump free_wides(wides, i.add(1))

    block freed(wides: @@U16):
        c_free(wides)
        return(null)

/// Reads a pipe to its end into a buffer.
record PipeReader
    pipe : Addr
    buf  : @@Byte
    len  : @USize
    cap  : @USize

#target(os: "windows")
routine read_pipe(raw: Addr) -> Void
    block entry():
        r : @PipeReader = raw.to<@PipeReader>()
        claim chunk : @Array<Byte, 4096> <- uninit
        claim n     : @U32               <- 0
        jump next(r, chunk.to<@Byte>(), n)

    block next(r: @PipeReader, chunk: @Byte, n: @U32):
        ok : Bool = c_read_file(r.pipe.load(), chunk, 4096, n, null).ne(0)
        branch ok.bitand(n.load().gt(0))
            ? continue
            : return()
        buf_append(r.buf.load(), r.len.load(), r.cap.load(), chunk, n.load().to<USize>())
        jump next(r, chunk, n)

#target(os: "windows")
routine proc_run_blocking(st: @ProcState) -> Void
    block entry():
        st.exit_status.store(-1)
        st.term_signal.store(0)
        line : @U16 = command_line(st.argv.load())
        cwd_utf8 : @Byte = st.cwd.load()
        cwd  : @U16 = wide(cwd_utf8)
        envp : @@Byte = st.envp.load()
        env  : @U16 = env_block(envp)
        claim sa : @SecurityAttributes <- SecurityAttributes { length: sizeof<SecurityAttributes>().to<U32>(),
                descriptor: null, inherit_handle: 1 }
        claim out_r : @Addr <- null
        claim out_w : @Addr <- null
        claim err_r : @Addr <- null
        claim err_w : @Addr <- null
        // GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, OPEN_EXISTING
        claim nul_name : @Array<U16, 4> <- { 78, 85, 76, 0 }
        nul : Addr = c_create_file(nul_name.to<@U16>(), 0x80000000, 3, sa, 3, 0, null)
        nul_ok   : Bool = ptrtoint<Addr, U64>(nul).ne(U64.MAX)
        args_ok  : Bool = line.is_not_null().bitand(nul_ok)
        dir_ok   : Bool = cwd_utf8.is_null().bitor(cwd.is_not_null())
        env_ok   : Bool = envp.is_null().bitor(env.is_not_null())
        ready    : Bool = args_ok.bitand(dir_ok).bitand(env_ok)
        branch ready
            ? continue
            : spawn(st, line, cwd, env, nul, nul_ok, out_r, out_w, err_r, err_w, false)
        pipes : Bool = c_create_pipe(out_r, out_w, sa, 0).ne(0).bitand(c_create_pipe(err_r, err_w, sa, 0).ne(0))
        branch pipes
            ? continue
            : spawn(st, line, cwd, env, nul, nul_ok, out_r, out_w, err_r, err_w, false)
        // the parent's ends stay out of the child (HANDLE_FLAG_INHERIT)
        c_set_handle_information(out_r.load(), 1, 0)
        c_set_handle_information(err_r.load(), 1, 0)
        jump spawn(st, line, cwd, env, nul, nul_ok, out_r, out_w, err_r, err_w, true)

    block spawn(st: @ProcState, line: @U16, cwd: @U16, env: @U16, nul: Addr, nul_ok: Bool, out_r: @Addr,
            out_w: @Addr, err_r: @Addr, err_w: @Addr, ok: Bool):
        claim pi : @ProcessInformation <- ProcessInformation { process: null, thread: null, process_id: 0,
                thread_id: 0 }
        branch ok
            ? continue
            : created(st, line, cwd, env, nul, nul_ok, out_r, out_w, err_r, err_w, pi, false)
        // STARTF_USESTDHANDLES
        claim si : @StartupInfo <- StartupInfo { cb: sizeof<StartupInfo>().to<U32>(), reserved: null, desktop: null,
                title: null, x: 0, y: 0, x_size: 0, y_size: 0, x_count_chars: 0, y_count_chars: 0,
                fill_attribute: 0, flags: 0x100, show_window: 0, cb_reserved2: 0, reserved2: null, std_input: nul,
                std_output: out_w.load(), std_error: err_w.load() }
        // CREATE_UNICODE_ENVIRONMENT
        made : Bool = c_create_process(null, line, null, null, 1, 0x400, env, cwd, si, pi).ne(0)
        jump created(st, line, cwd, env, nul, nul_ok, out_r, out_w, err_r, err_w, pi, made)

    // The child's ends close here, so the pipes end when the child exits.
    block created(st: @ProcState, line: @U16, cwd: @U16, env: @U16, nul: Addr, nul_ok: Bool, out_r: @Addr,
            out_w: @Addr, err_r: @Addr, err_w: @Addr, pi: @ProcessInformation, made: Bool):
        close_handle(out_w.load())
        close_handle(err_w.load())
        branch nul_ok
            ? continue
            : collect(st, line, cwd, env, out_r, err_r, pi, made)
        c_close_handle(nul)
        jump collect(st, line, cwd, env, out_r, err_r, pi, made)

    block collect(st: @ProcState, line: @U16, cwd: @U16, env: @U16, out_r: @Addr, err_r: @Addr,
            pi: @ProcessInformation, made: Bool):
        branch made
            ? continue
            : failed(st, line, cwd, env, out_r, err_r)
        claim err_reader : @PipeReader <- PipeReader { pipe: err_r.load(), buf: st.err_buf, len: st.err_len,
                cap: st.err_cap }
        claim out_reader : @PipeReader <- PipeReader { pipe: out_r.load(), buf: st.out_buf, len: st.out_len,
                cap: st.out_cap }
        helper : Thread = Thread.spawn(read_pipe.to<Callable>(), err_reader, runtime_heap())
        read_pipe(out_reader)
        helper.join()
        // INFINITE
        c_wait_for_single_object(pi.process.load(), U32.MAX)
        claim code : @U32 <- 0
        c_get_exit_code_process(pi.process.load(), code)
        st.exit_status.store(code.load().to<S64>())
        c_close_handle(pi.thread.load())
        c_close_handle(pi.process.load())
        jump cleanup(line, cwd, env, out_r, err_r)

    block failed(st: @ProcState, line: @U16, cwd: @U16, env: @U16, out_r: @Addr, err_r: @Addr):
        st.spawn_err.store(1)
        jump cleanup(line, cwd, env, out_r, err_r)

    block cleanup(line: @U16, cwd: @U16, env: @U16, out_r: @Addr, err_r: @Addr):
        close_handle(out_r.load())
        close_handle(err_r.load())
        c_free(line)
        c_free(cwd)
        c_free(env)
        return()

#target(os: "windows")
routine close_handle(handle: Addr) -> Void
    block entry():
        branch handle.is_null()
            ? return()
            : continue
        c_close_handle(handle)
        return()
