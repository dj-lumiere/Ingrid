// Blocking work without blocking the scheduler: reading or writing a whole file, and running a subprocess.
//
// IO_THREADS threads, started once at runtime init, take requests from a queue. A scheduler-driven coroutine
// submits one and parks; the I/O thread that finishes it wakes the coroutine, whose worker goes on with other
// coroutines meanwhile. Outside a coroutine the work runs on the calling thread. The same on every operating system:
// the work itself is the plain blocking call, on a thread of its own.
//
// A subprocess's stdin is the null device, and its stdout and stderr are pipes the parent reads to the end, both
// at once (a child filling one while the other is drained can't deadlock), before waiting for it. The command is
// looked up on PATH as a shell would (execvp, CreateProcessW).

module Ingrid::Runtime

import Standard::Alloc
import Standard::Os

preset IO_THREADS: USize = 4

preset IO_READ_FILE:   U32 = 0
preset IO_WRITE_FILE:  U32 = 1
preset IO_RUN_PROCESS: U32 = 2

// -- the C library -------------------------------------------------------------------

#[external("c"), symbol("fopen")]
routine c_fopen(path: @Byte, mode: CStr) -> Addr

#[external("c"), symbol("fseek")]
routine c_fseek(f: Addr, offset: CLong, whence: CInt) -> CInt

#[external("c"), symbol("ftell")]
routine c_ftell(f: Addr) -> CLong

#[external("c"), symbol("rewind")]
routine c_rewind(f: Addr) -> Void

#[external("c"), symbol("fread")]
routine c_fread(buf: @Byte, size: USize, count: USize, f: Addr) -> USize

#[external("c"), symbol("fwrite")]
routine c_fwrite(buf: @Byte, size: USize, count: USize, f: Addr) -> USize

#[external("c"), symbol("fflush")]
routine c_fflush(f: Addr) -> CInt

#[external("c"), symbol("fclose")]
routine c_fclose(f: Addr) -> CInt

#[external("c"), symbol("memcpy")]
routine c_memcpy(dst: Addr, src: Addr, n: USize) -> Addr

#[external("c"), symbol("strlen")]
routine c_strlen(s: @Byte) -> USize

/// n, or for n < 0 the length of s before its NUL.
routine length_of(s: @Byte, n: S32) -> USize
    block entry():
        branch n.lt(0)
            ? return(c_strlen(s))
            : return(n.to<USize>())

/// A NUL-terminated copy of n bytes of s (all of it before its NUL for n < 0), or null.
routine strdupn(s: @Byte, n: S32) -> @Byte
    block entry():
        len : USize = length_of(s, n)
        d   : Addr  = c_malloc(len.add(1))
        branch d.is_null()
            ? return(null)
            : continue
        c_memcpy(d, s, len)
        d.to<@Byte>().stride(len).store(0x00)
        return(d.to<@Byte>())

// -- requests and the I/O threads ----------------------------------------------------

record IoReq
    kind     : U32
    sched    : @Sched  // the parked coroutine's scheduler
    coro     : @Coro
    qnext    : @IoReq
    path     : @Byte  // a NUL-terminated copy
    data     : @Byte  // read: the contents (the caller frees them); write: a copy of the payload
    data_len : S64
    result   : S64  // bytes read or written, negative on an error
    proc     : @ProcState

global IO_LOCK: @Mutex
global IO_WORK: @Cond
global IO_HEAD: @@IoReq
global IO_TAIL: @@IoReq
/// 1 once the I/O threads run; until then the work runs inline.
global IO_OK: @U32

/// The length of the last read, set just before rf_io_read_file_all returns and read right after.
#threadlocal
global IO_LAST_LEN: @U64

#export("rf_io_get_result_len")
routine rf_io_get_result_len() -> U64
    block entry():
        return(IO_LAST_LEN.load())

routine io_do_work(req: @IoReq) -> Void
    block entry():
        kind : U32 = req.kind.load()
        when:
            kind.eq(IO_READ_FILE)  -> read()
            kind.eq(IO_WRITE_FILE) -> write()
            else                   -> process()

    block read():
        f : Addr = c_fopen(req.path.load(), "rb")
        branch f.is_null()
            ? return()
            : continue
        // SEEK_END
        branch c_fseek(f, 0, 2).ne(0)
            ? fail(f)
            : continue
        size : CLong = c_ftell(f)
        branch size.lt(0)
            ? fail(f)
            : continue
        c_rewind(f)
        n   : USize = size.to<USize>()
        buf : Addr  = c_malloc(n.add(1))
        branch buf.is_null()
            ? fail(f)
            : continue
        got : USize = c_fread(buf.to<@Byte>(), 1, n, f)
        c_fclose(f)
        buf.to<@Byte>().stride(got).store(0x00)
        req.data.store(buf.to<@Byte>())
        req.result.store(got.to<S64>())
        return()

    block fail(f: Addr):
        c_fclose(f)
        return()

    block write():
        f : Addr = c_fopen(req.path.load(), "wb")
        branch f.is_null()
            ? return()
            : continue
        len     : S64   = req.data_len.load()
        n       : USize = len.gt(0) ? c_fwrite(req.data.load(), 1, len.to<USize>(), f) : 0
        flushed : Bool  = c_fflush(f).eq(0)
        c_fclose(f)
        whole   : Bool  = flushed.bitand(n.to<S64>().eq(len))
        req.result.store(whole ? n.to<S64>() : -1)
        return()

    block process():
        proc_run_blocking(req.proc.load())
        return()

/// An I/O thread: takes requests in order, runs each, and wakes its coroutine (which then reads the results).
routine io_thread_main(raw: Addr) -> Void
    block entry():
        IO_LOCK.lock()
        jump look()

    block look():
        req : @IoReq = IO_HEAD.load()
        branch req.is_null()
            ? sleep()
            : continue
        next : @IoReq = req.qnext.load()
        IO_HEAD.store(next)
        branch next.is_null()
            ? continue
            : run(req)
        IO_TAIL.store(null)
        jump run(req)

    block sleep():
        IO_WORK.wait(IO_LOCK)
        jump look()

    block run(req: @IoReq):
        IO_LOCK.unlock()
        io_do_work(req)
        rf_sched_wake(req.sched.load(), req.coro.load())
        jump entry()

/// Starts the I/O threads at process startup (rf_runtime_init, on the main thread), so a later coroutine call is
/// only a submit and a park.
#export("rf_io_runtime_init")
routine rf_io_runtime_init() -> Void
    block entry():
        branch IO_OK.load().eq(1)
            ? return()
            : continue
        jump start(0)

    block start(i: USize):
        branch i.eq(IO_THREADS)
            ? continue
            : one(i)
        IO_OK.store(1)
        return()

    block one(i: USize):
        Thread.spawn(io_thread_main.to<Callable>(), null, runtime_heap()).detach()
        jump start(i.add(1))

routine io_submit(req: @IoReq) -> Void
    block entry():
        IO_LOCK.lock()
        req.qnext.store(null)
        tail : @IoReq = IO_TAIL.load()
        branch tail.is_null()
            ? first()
            : continue
        tail.qnext.store(req)
        jump queued()

    block first():
        IO_HEAD.store(req)
        jump queued()

    block queued():
        IO_TAIL.store(req)
        IO_WORK.signal()
        IO_LOCK.unlock()
        return()

/// Runs a request to completion: inside a scheduler-driven coroutine on an I/O thread while the coroutine is
/// parked, else here. The one park pairs with the I/O thread's one wake, which may come first.
routine io_run(req: @IoReq) -> Void
    block entry():
        branch IO_OK.load().eq(1)
            ? continue
            : inline()
        sched : @Sched = rf_sched_current()
        self  : @Coro  = current_coro()
        branch sched.is_null().bitor(self.is_null())
            ? inline()
            : continue
        req.sched.store(sched)
        req.coro.store(self)
        rf_sched_arm_cross_waker(sched)
        io_submit(req)
        rf_sched_park_external()
        rf_sched_disarm_cross_waker(sched)
        return()

    block inline():
        io_do_work(req)
        return()

routine io_req_new(kind: U32, path: @Byte, path_len: S32) -> @IoReq
    block entry():
        req : @IoReq = zeroed<IoReq>(1, "Failed to allocate async I/O request")
        req.kind.store(kind)
        req.result.store(-1)
        copy : @Byte = strdupn(path, path_len)
        branch copy.is_null()
            ? rf_throw("OutOfMemoryError", "Failed to allocate async I/O path")
            : continue
        req.path.store(copy)
        return(req)

/// Reads a whole file: a malloc'd, NUL-terminated buffer (the caller frees it) with its length from
/// rf_io_get_result_len, or null (length 0) on an error.
#export("rf_io_read_file_all")
routine rf_io_read_file_all(path: @Byte, path_len: S32) -> @Byte
    block entry():
        req : @IoReq = io_req_new(IO_READ_FILE, path, path_len)
        io_run(req)
        data   : @Byte = req.data.load()
        result : S64   = req.result.load()
        c_free(req.path.load())
        c_free(req)
        branch result.lt(0)
            ? failed()
            : continue
        IO_LAST_LEN.store(result.to<U64>())
        return(data)

    block failed():
        IO_LAST_LEN.store(0)
        return(null)

/// Writes data_len bytes of data to the file (truncating it): the bytes written, or -1. The payload is copied, so
/// the caller's buffer needn't outlive the call.
#export("rf_io_write_file_all")
routine rf_io_write_file_all(path: @Byte, path_len: S32, data: @Byte, data_len: S64) -> S64
    block entry():
        req : @IoReq = io_req_new(IO_WRITE_FILE, path, path_len)
        len : S64    = data_len.max(0)
        req.data_len.store(len)
        branch len.gt(0)
            ? copy(req, len)
            : run(req)

    block copy(req: @IoReq, len: S64):
        buf : Addr = c_malloc(len.to<USize>())
        branch buf.is_null()
            ? rf_throw("OutOfMemoryError", "Failed to allocate async I/O write buffer")
            : continue
        c_memcpy(buf, data, len.to<USize>())
        req.data.store(buf.to<@Byte>())
        jump run(req)

    block run(req: @IoReq):
        io_run(req)
        result : S64 = req.result.load()
        c_free(req.data.load())
        c_free(req.path.load())
        c_free(req)
        return(result)

// -- blocking-call stubs kept for the old async API ----------------------------------

record AsyncRuntime
    should_stop : Bool

#export("rf_async_backend_name")
routine rf_async_backend_name() -> CStr
    block entry():
        return("threads")

#export("rf_async_backend_state")
routine rf_async_backend_state() -> CInt
    block entry():
        return(1)

#export("rf_async_runtime_create")
routine rf_async_runtime_create() -> @AsyncRuntime
    block entry():
        return(zeroed<AsyncRuntime>(1, "Failed to allocate async runtime"))

#export("rf_async_runtime_destroy")
routine rf_async_runtime_destroy(runtime: @AsyncRuntime) -> Void
    block entry():
        c_free(runtime)
        return()

#export("rf_async_runtime_run_once")
routine rf_async_runtime_run_once(runtime: @AsyncRuntime) -> CInt
    block entry():
        branch runtime.is_null()
            ? return(0)
            : continue
        branch runtime.should_stop.load()
            ? return(0)
            : return(1)

#export("rf_async_runtime_run_default")
routine rf_async_runtime_run_default(runtime: @AsyncRuntime) -> CInt
    block entry():
        branch runtime.is_null()
            ? return(0)
            : return(1)

#export("rf_async_runtime_stop")
routine rf_async_runtime_stop(runtime: @AsyncRuntime) -> Void
    block entry():
        branch runtime.is_null()
            ? return()
            : continue
        runtime.should_stop.store(true)
        return()

// -- subprocesses --------------------------------------------------------------------

record ProcState
    argv        : @@Byte  // owned, null-terminated
    cwd         : @Byte  // owned, or null to inherit
    envp        : @@Byte  // owned, null-terminated "KEY=VALUE", or null to inherit
    exit_status : S64
    term_signal : CInt  // the signal that killed the child, or 0
    spawn_err   : CInt  // not 0 when the child couldn't start
    out_buf     : @Byte
    out_len     : USize
    out_cap     : USize
    err_buf     : @Byte
    err_len     : USize
    err_cap     : USize

/// Appends n bytes to a malloc'd, NUL-terminated buffer, growing it. On an allocation failure the bytes are dropped.
routine buf_append(buf: @@Byte, len: @USize, cap: @USize, data: @Byte, n: USize) -> Void
    block entry():
        need : USize = len.load().add(n).add(1)
        branch need.gt(cap.load())
            ? grow(need, cap.load().eq(0) ? 256 : cap.load())
            : put()

    block grow(need: USize, ncap: USize):
        branch need.gt(ncap)
            ? grow(need, ncap.mul(2))
            : continue
        nb : Addr = c_realloc(buf.load(), ncap)
        branch nb.is_null()
            ? return()
            : continue
        buf.store(nb.to<@Byte>())
        cap.store(ncap)
        jump put()

    block put():
        at : @Byte = buf.load().stride(len.load())
        c_memcpy(at, data, n)
        l : USize = len.load().add(n)
        len.store(l)
        buf.load().stride(l).store(0x00)
        return()

/// The captured result of the last subprocess, set just before rf_proc_run returns and read right after.
#threadlocal
global PROC_SIGNAL: @CInt
#threadlocal
global PROC_OUT: @@Byte
#threadlocal
global PROC_OUT_LEN: @U64
#threadlocal
global PROC_ERR: @@Byte
#threadlocal
global PROC_ERR_LEN: @U64

#export("rf_proc_term_signal")
routine rf_proc_term_signal() -> S32
    block entry():
        return(PROC_SIGNAL.load())

#export("rf_proc_output")
routine rf_proc_output() -> @Byte
    block entry():
        return(PROC_OUT.load())

#export("rf_proc_output_len")
routine rf_proc_output_len() -> U64
    block entry():
        return(PROC_OUT_LEN.load())

#export("rf_proc_errors")
routine rf_proc_errors() -> @Byte
    block entry():
        return(PROC_ERR.load())

#export("rf_proc_errors_len")
routine rf_proc_errors_len() -> U64
    block entry():
        return(PROC_ERR_LEN.load())

routine proc_state_new() -> @ProcState
    block entry():
        st : @ProcState = zeroed<ProcState>(1, "Failed to allocate subprocess state")
        st.exit_status.store(-1)
        return(st)

/// Frees a null-terminated array of malloc'd strings.
routine free_strings(list: @@Byte) -> Void
    block entry():
        branch list.is_null()
            ? return()
            : next(0)

    block next(i: USize):
        s : @Byte = list.stride(i).load()
        branch s.is_null()
            ? done()
            : continue
        c_free(s)
        jump next(i.add(1))

    block done():
        c_free(list)
        return()

/// The captured streams go to the caller (through the thread-locals), not freed here.
routine proc_state_free(st: @ProcState) -> Void
    block entry():
        free_strings(st.argv.load())
        free_strings(st.envp.load())
        c_free(st.cwd.load())
        c_free(st)
        return()

/// Runs a prepared state, parking a scheduler-driven coroutine meanwhile, publishes the captured streams and the
/// status, frees the state, and returns the exit code (-1 if the child couldn't start).
routine proc_exec(st: @ProcState) -> S64
    block entry():
        req : @IoReq = zeroed<IoReq>(1, "Failed to allocate subprocess request")
        req.kind.store(IO_RUN_PROCESS)
        req.proc.store(st)
        io_run(req)
        PROC_SIGNAL.store(st.term_signal.load())
        PROC_OUT.store(st.out_buf.load())
        PROC_OUT_LEN.store(st.out_len.load().to<U64>())
        PROC_ERR.store(st.err_buf.load())
        PROC_ERR_LEN.store(st.err_len.load().to<U64>())
        code : S64 = st.spawn_err.load().ne(0) ? -1 : st.exit_status.load()
        proc_state_free(st)
        c_free(req)
        return(code)

/// Runs command through the platform shell (cmd /c, sh -c): pipes and globs, at the cost of shell quoting.
#export("rf_proc_run")
routine rf_proc_run(command: @Byte, command_len: S32) -> S64
    block entry():
        st   : @ProcState = proc_state_new()
        argv : @@Byte     = zeroed<@Byte>(4, "Failed to allocate subprocess argv")
        argv.store(strdupn(shell_path().data, -1))
        argv.stride(1).store(strdupn(shell_flag().data, -1))
        argv.stride(2).store(strdupn(command, command_len))
        st.argv.store(argv)
        return(proc_exec(st))

#target(os: "windows")
routine shell_path() -> CStr
    block entry():
        return("cmd.exe")

#target(os: "windows")
routine shell_flag() -> CStr
    block entry():
        return("/c")

#target(os: not "windows")
routine shell_path() -> CStr
    block entry():
        return("/bin/sh")

#target(os: not "windows")
routine shell_flag() -> CStr
    block entry():
        return("-c")

/// rf_proc_builder: an executable and its argument vector, run with no shell.
record ProcBuilder
    argv       : @@Byte
    argv_count : USize
    argv_cap   : USize
    cwd        : @Byte
    envv       : @@Byte  // "KEY=VALUE" overrides, env_count of them
    env_count  : USize
    env_cap    : USize

#export("rf_proc_begin")
routine rf_proc_begin(file: @Byte, file_len: S32) -> @ProcBuilder
    block entry():
        b : @ProcBuilder = zeroed<ProcBuilder>(1, "Failed to allocate subprocess builder")
        b.argv_cap.store(4)
        argv : @@Byte = zeroed<@Byte>(4, "Failed to allocate subprocess argv")
        argv.store(strdupn(file, file_len))
        b.argv.store(argv)
        b.argv_count.store(1)
        return(b)

#export("rf_proc_add_arg")
routine rf_proc_add_arg(b: @ProcBuilder, arg: @Byte, arg_len: S32) -> Void
    block entry():
        branch b.is_null()
            ? return()
            : continue
        // room for the new argument and the null after it
        branch b.argv_count.load().add(2).gt(b.argv_cap.load())
            ? continue
            : put()
        ncap : USize = b.argv_cap.load().mul(2)
        na   : Addr  = c_realloc(b.argv.load(), ncap.mul(sizeof<Addr>()))
        branch na.is_null()
            ? return()
            : continue
        b.argv.store(na.to<@@Byte>())
        b.argv_cap.store(ncap)
        jump put()

    block put():
        n : USize = b.argv_count.load()
        b.argv.load().stride(n).store(strdupn(arg, arg_len))
        b.argv_count.store(n.add(1))
        b.argv.load().stride(n.add(1)).store(null)
        return()

/// An empty directory inherits the parent's.
#export("rf_proc_set_cwd")
routine rf_proc_set_cwd(b: @ProcBuilder, cwd: @Byte, cwd_len: S32) -> Void
    block entry():
        branch b.is_null()
            ? return()
            : continue
        c_free(b.cwd.load())
        b.cwd.store(null)
        len : USize = length_of(cwd, cwd_len)
        branch len.gt(0)
            ? continue
            : return()
        b.cwd.store(strdupn(cwd, len.to<S32>()))
        return()

/// An environment override, merged into the parent's environment at launch (PATH and the rest stay).
#export("rf_proc_add_env")
routine rf_proc_add_env(b: @ProcBuilder, key: @Byte, key_len: S32, val: @Byte, val_len: S32) -> Void
    block entry():
        branch b.is_null()
            ? return()
            : continue
        branch b.env_count.load().add(1).gt(b.env_cap.load())
            ? continue
            : put()
        cap  : USize = b.env_cap.load()
        ncap : USize = cap.eq(0) ? 4 : cap.mul(2)
        ne   : Addr  = c_realloc(b.envv.load(), ncap.mul(sizeof<Addr>()))
        branch ne.is_null()
            ? return()
            : continue
        b.envv.store(ne.to<@@Byte>())
        b.env_cap.store(ncap)
        jump put()

    block put():
        kl    : USize = length_of(key, key_len)
        vl    : USize = length_of(val, val_len)
        entry : Addr  = c_malloc(kl.add(vl).add(2))
        branch entry.is_null()
            ? return()
            : continue
        e : @Byte = entry.to<@Byte>()
        c_memcpy(e, key, kl)
        e.stride(kl).store(b'=')
        c_memcpy(e.stride(kl.add(1)), val, vl)
        e.stride(kl.add(vl).add(1)).store(0x00)
        n : USize = b.env_count.load()
        b.envv.load().stride(n).store(e)
        b.env_count.store(n.add(1))
        return()

/// The length of a "KEY=VALUE" entry's key.
routine key_length(entry: @Byte) -> USize
    block entry():
        jump scan(0)

    block scan(i: USize):
        c : Byte = entry.stride(i).load()
        branch c.eq(0x00).bitor(c.eq(b'='))
            ? return(i)
            : scan(i.add(1))

routine same_key(a: @Byte, b: @Byte) -> Bool
    block entry():
        n : USize = key_length(a)
        branch n.eq(key_length(b))
            ? compare(n, 0)
            : return(false)

    block compare(n: USize, i: USize):
        branch i.eq(n)
            ? return(true)
            : continue
        branch a.stride(i).load().eq(b.stride(i).load())
            ? compare(n, i.add(1))
            : return(false)

/// The parent's environment with the overrides applied (one replaces a parent entry with its key, or is added):
/// null-terminated, the overrides moved in and the parent's entries copied. Null without overrides (inherit).
routine merge_env(overrides: @@Byte, n: USize) -> @@Byte
    block entry():
        branch n.eq(0)
            ? return(null)
            : continue
        parent : @@Byte = parent_environment()
        jump count(parent, 0)

    block count(parent: @@Byte, pc: USize):
        branch parent.is_null()
            ? counted(parent, pc)
            : continue
        branch parent.stride(pc).load().is_not_null()
            ? count(parent, pc.add(1))
            : counted(parent, pc)

    block counted(parent: @@Byte, pc: USize):
        env : @@Byte = zeroed<@Byte>(pc.add(n).add(1), "Failed to allocate subprocess environment")
        jump copy(parent, pc, env, 0, 0)

    block copy(parent: @@Byte, pc: USize, env: @@Byte, i: USize, k: USize):
        branch i.eq(pc)
            ? moves(env, k, 0)
            : continue
        entry : @Byte = parent.stride(i).load()
        jump overridden(parent, pc, env, i, k, entry, 0)

    block overridden(parent: @@Byte, pc: USize, env: @@Byte, i: USize, k: USize, entry: @Byte, j: USize):
        branch j.eq(n)
            ? keep(parent, pc, env, i, k, entry)
            : continue
        branch same_key(overrides.stride(j).load(), entry)
            ? copy(parent, pc, env, i.add(1), k)
            : overridden(parent, pc, env, i, k, entry, j.add(1))

    block keep(parent: @@Byte, pc: USize, env: @@Byte, i: USize, k: USize, entry: @Byte):
        env.stride(k).store(strdupn(entry, -1))
        jump copy(parent, pc, env, i.add(1), k.add(1))

    block moves(env: @@Byte, k: USize, j: USize):
        branch j.eq(n)
            ? return(env)
            : continue
        env.stride(k).store(overrides.stride(j).load())
        jump moves(env, k.add(1), j.add(1))

#export("rf_proc_run_built")
routine rf_proc_run_built(b: @ProcBuilder) -> S64
    block entry():
        branch b.is_null()
            ? return(-1)
            : continue
        st : @ProcState = proc_state_new()
        st.argv.store(b.argv.load())
        st.cwd.store(b.cwd.load())
        st.envp.store(merge_env(b.envv.load(), b.env_count.load()))
        // the override strings moved into envp; only their array is freed
        c_free(b.envv.load())
        c_free(b)
        return(proc_exec(st))

// -- subprocesses on POSIX -----------------------------------------------------------

#[external("c"), symbol("pipe"), target(os: not "windows")]
routine c_pipe(fds: @CInt) -> CInt

#[external("c"), symbol("fcntl"), variadic, target(os: not "windows")]
routine c_fcntl(fd: CInt, cmd: CInt) -> CInt

#[external("c"), symbol("open"), variadic, target(os: not "windows")]
routine c_open(path: CStr, flags: CInt) -> CInt

#[external("c"), symbol("fork"), target(os: not "windows")]
routine c_fork() -> CInt

#[external("c"), symbol("dup2"), target(os: not "windows")]
routine c_dup2(from: CInt, to: CInt) -> CInt

#[external("c"), symbol("chdir"), target(os: not "windows")]
routine c_chdir(path: @Byte) -> CInt

#[external("c"), symbol("write"), target(os: not "windows")]
routine c_write_fd(fd: CInt, buf: Addr, count: USize) -> SSize

#[external("c"), symbol("read"), target(os: not "windows")]
routine c_read_fd(fd: CInt, buf: Addr, count: USize) -> SSize

#[external("c"), symbol("close"), target(os: not "windows")]
routine c_close(fd: CInt) -> CInt

#[external("c"), symbol("_exit"), noreturn, target(os: not "windows")]
routine c_exit_now(status: CInt) -> Void

#[external("c"), symbol("execvp"), target(os: not "windows")]
routine c_execvp(file: @Byte, argv: @@Byte) -> CInt

#[external("c"), symbol("waitpid"), target(os: not "windows")]
routine c_waitpid(pid: CInt, status: @CInt, options: CInt) -> CInt

/// struct pollfd.
record PollFd
    fd      : CInt
    events  : S16
    revents : S16

// nfds_t: unsigned long, the pointer width on Linux
#[external("c"), symbol("poll"), target(os: "linux")]
routine c_poll(fds: @PollFd, count: USize, timeout: CInt) -> CInt

#[external("c"), symbol("poll"), target(os: "macos")]
routine c_poll(fds: @PollFd, count: U32, timeout: CInt) -> CInt

#[external("c"), symbol("__errno_location"), target(os: "linux")]
routine c_errno_place() -> @CInt

#[external("c"), symbol("__error"), target(os: "macos")]
routine c_errno_place() -> @CInt

#[external("c"), symbol("environ"), target(os: "linux")]
global ENVIRON: @@@Byte

#[external("c"), symbol("_NSGetEnviron"), target(os: "macos")]
routine c_ns_get_environ() -> @@@Byte

/// Where the process environment pointer (C's environ) lives: the C variable on Linux, and through _NSGetEnviron on
/// macOS (as a dylib must).
#target(os: "linux")
routine environ_place() -> @@@Byte
    block entry():
        return(ENVIRON)

#target(os: "macos")
routine environ_place() -> @@@Byte
    block entry():
        return(c_ns_get_environ())

#target(os: not "windows")
routine parent_environment() -> @@Byte
    block entry():
        place : @@@Byte = environ_place()
        branch place.is_null()
            ? return(null)
            : return(place.load())

#target(os: "linux")
routine o_cloexec() -> CInt
    block entry():
        return(0x80000)

#target(os: "macos")
routine o_cloexec() -> CInt
    block entry():
        return(0x1000000)

#target(os: "linux")
routine e_again() -> CInt
    block entry():
        return(11)

#target(os: "macos")
routine e_again() -> CInt
    block entry():
        return(35)

#target(os: "linux")
routine poll_fds(fds: @PollFd) -> CInt
    block entry():
        return(c_poll(fds, 2, -1))

#target(os: "macos")
routine poll_fds(fds: @PollFd) -> CInt
    block entry():
        return(c_poll(fds, 2, -1))

#target(os: not "windows")
routine errno() -> CInt
    block entry():
        return(c_errno_place().load())

/// A pipe with close-on-exec on both ends: 0, or -1.
#target(os: not "windows")
routine cloexec_pipe(fds: @CInt) -> CInt
    block entry():
        branch c_pipe(fds).ne(0)
            ? return(-1)
            : continue
        // F_SETFD, FD_CLOEXEC
        c_fcntl(fds.load(), 2, 1)
        c_fcntl(fds.stride(1).load(), 2, 1)
        return(0)

/// The child after fork: only async-signal-safe calls until exec. dup2 clears close-on-exec on the copies. If the
/// directory change or the exec fails, errno goes to the parent through report.
#[noreturn, target(os: not "windows")]
routine proc_child(st: @ProcState, nul: CInt, out_w: CInt, err_w: CInt, report: CInt) -> Void
    block entry():
        branch nul.ge(0)
            ? continue
            : streams()
        c_dup2(nul, 0)
        jump streams()

    block streams():
        c_dup2(out_w, 1)
        c_dup2(err_w, 2)
        cwd : @Byte = st.cwd.load()
        branch cwd.is_null()
            ? environment()
            : continue
        branch c_chdir(cwd).eq(0)
            ? environment()
            : failed()

    block environment():
        envp : @@Byte = st.envp.load()
        branch envp.is_null()
            ? exec()
            : continue
        environ_place().store(envp)
        jump exec()

    block exec():
        argv : @@Byte = st.argv.load()
        c_execvp(argv.load(), argv)
        jump failed()

    block failed():
        claim e : @CInt <- errno()
        c_write_fd(report, e, 4)
        c_exit_now(127)

#target(os: not "windows")
routine proc_run_blocking(st: @ProcState) -> Void
    block entry():
        st.exit_status.store(-1)
        st.term_signal.store(0)
        claim out_p  : @Array<CInt, 2> <- { -1, -1 }
        claim err_p  : @Array<CInt, 2> <- { -1, -1 }
        claim exec_p : @Array<CInt, 2> <- { -1, -1 }
        branch cloexec_pipe(out_p.to<@CInt>()).ne(0)
            ? spawn_failed()
            : continue
        branch cloexec_pipe(err_p.to<@CInt>()).ne(0)
            ? close1(out_p.to<@CInt>())
            : continue
        branch cloexec_pipe(exec_p.to<@CInt>()).ne(0)
            ? close2(out_p.to<@CInt>(), err_p.to<@CInt>())
            : continue
        nul : CInt = c_open("/dev/null", o_cloexec())
        pid : CInt = c_fork()
        branch pid.eq(0)
            ? proc_child(st, nul, out_p.to<@CInt>().stride(1).load(), err_p.to<@CInt>().stride(1).load(),
                    exec_p.to<@CInt>().stride(1).load())
            : continue
        c_close(out_p.to<@CInt>().stride(1).load())
        c_close(err_p.to<@CInt>().stride(1).load())
        c_close(exec_p.to<@CInt>().stride(1).load())
        branch nul.ge(0)
            ? continue
            : forked(pid, out_p.to<@CInt>().load(), err_p.to<@CInt>().load(), exec_p.to<@CInt>().load())
        c_close(nul)
        jump forked(pid, out_p.to<@CInt>().load(), err_p.to<@CInt>().load(), exec_p.to<@CInt>().load())

    block close1(out_p: @CInt):
        c_close(out_p.load())
        c_close(out_p.stride(1).load())
        jump spawn_failed()

    block close2(out_p: @CInt, err_p: @CInt):
        c_close(out_p.load())
        c_close(out_p.stride(1).load())
        c_close(err_p.load())
        c_close(err_p.stride(1).load())
        jump spawn_failed()

    block spawn_failed():
        st.spawn_err.store(1)
        return()

    block forked(pid: CInt, out_r: CInt, err_r: CInt, exec_r: CInt):
        branch pid.lt(0)
            ? fork_failed(out_r, err_r, exec_r)
            : continue
        claim exec_errno : @CInt <- 0
        jump report(pid, out_r, err_r, exec_r, exec_errno)

    block fork_failed(out_r: CInt, err_r: CInt, exec_r: CInt):
        c_close(out_r)
        c_close(err_r)
        c_close(exec_r)
        jump spawn_failed()

    block report(pid: CInt, out_r: CInt, err_r: CInt, exec_r: CInt, exec_errno: @CInt):
        got : SSize = c_read_fd(exec_r, exec_errno, 4)
        branch got.lt(0).bitand(errno().eq(4))
            ? report(pid, out_r, err_r, exec_r, exec_errno)
            : continue
        c_close(exec_r)
        // POLLIN
        claim fds   : @Array<PollFd, 2> <- { PollFd { fd: out_r, events: 1, revents: 0 },
                PollFd { fd: err_r, events: 1, revents: 0 } }
        claim chunk : @Array<Byte, 4096> <- uninit
        jump drain(pid, got, exec_errno, fds.to<@PollFd>(), chunk.to<@Byte>(), 2)

    // Both pipes to their end, whichever has data.
    block drain(pid: CInt, got: SSize, exec_errno: @CInt, fds: @PollFd, chunk: @Byte, open: S32):
        branch open.gt(0)
            ? continue
            : reap(pid, got, exec_errno, fds)
        branch poll_fds(fds).lt(0)
            ? interrupted(pid, got, exec_errno, fds, chunk, open)
            : stream(pid, got, exec_errno, fds, chunk, open, 0)

    block interrupted(pid: CInt, got: SSize, exec_errno: @CInt, fds: @PollFd, chunk: @Byte, open: S32):
        branch errno().eq(4)
            ? drain(pid, got, exec_errno, fds, chunk, open)
            : reap(pid, got, exec_errno, fds)

    block stream(pid: CInt, got: SSize, exec_errno: @CInt, fds: @PollFd, chunk: @Byte, open: S32, i: USize):
        branch i.eq(2)
            ? drain(pid, got, exec_errno, fds, chunk, open)
            : continue
        p  : @PollFd = fds.stride(i)
        fd : CInt    = p.fd.load()
        branch fd.lt(0).bitor(p.revents.load().eq(0))
            ? stream(pid, got, exec_errno, fds, chunk, open, i.add(1))
            : continue
        n : SSize = c_read_fd(fd, chunk, 4096)
        branch n.gt(0)
            ? append(pid, got, exec_errno, fds, chunk, open, i, n)
            : continue
        e     : CInt = errno()
        ended : Bool = n.eq(0).bitor(e.ne(4).bitand(e.ne(e_again())))
        branch ended
            ? continue
            : stream(pid, got, exec_errno, fds, chunk, open, i.add(1))
        c_close(fd)
        p.fd.store(-1)
        jump stream(pid, got, exec_errno, fds, chunk, open.sub(1), i.add(1))

    block append(pid: CInt, got: SSize, exec_errno: @CInt, fds: @PollFd, chunk: @Byte, open: S32, i: USize,
            n: SSize):
        branch i.eq(0)
            ? out(pid, got, exec_errno, fds, chunk, open, i, n)
            : continue
        buf_append(st.err_buf, st.err_len, st.err_cap, chunk, n.to<USize>())
        jump stream(pid, got, exec_errno, fds, chunk, open, i.add(1))

    block out(pid: CInt, got: SSize, exec_errno: @CInt, fds: @PollFd, chunk: @Byte, open: S32, i: USize,
            n: SSize):
        buf_append(st.out_buf, st.out_len, st.out_cap, chunk, n.to<USize>())
        jump stream(pid, got, exec_errno, fds, chunk, open, i.add(1))

    block reap(pid: CInt, got: SSize, exec_errno: @CInt, fds: @PollFd):
        jump close_left(pid, got, exec_errno, fds, 0)

    block close_left(pid: CInt, got: SSize, exec_errno: @CInt, fds: @PollFd, i: USize):
        branch i.eq(2)
            ? wait(pid, got, exec_errno)
            : continue
        fd : CInt = fds.stride(i).fd.load()
        branch fd.ge(0)
            ? continue
            : close_left(pid, got, exec_errno, fds, i.add(1))
        c_close(fd)
        jump close_left(pid, got, exec_errno, fds, i.add(1))

    block wait(pid: CInt, got: SSize, exec_errno: @CInt):
        claim status : @CInt <- 0
        jump waiting(pid, got, exec_errno, status)

    block waiting(pid: CInt, got: SSize, exec_errno: @CInt, status: @CInt):
        branch c_waitpid(pid, status, 0).lt(0).bitand(errno().eq(4))
            ? waiting(pid, got, exec_errno, status)
            : continue
        // the exec failed: the child reported its errno
        branch got.gt(0)
            ? exec_failed(exec_errno)
            : continue
        s       : CInt = status.load()
        low     : CInt = s.bitand(0x7F)
        branch low.eq(0)
            ? exited(s)
            : continue
        branch low.ne(0x7F)
            ? signaled(low)
            : return()

    block exec_failed(exec_errno: @CInt):
        e : CInt = exec_errno.load()
        st.spawn_err.store(e.ne(0) ? e : 1)
        return()

    block exited(s: CInt):
        st.exit_status.store(s.shr(8).bitand(0xFF).to<S64>())
        return()

    block signaled(low: CInt):
        st.exit_status.store(0)
        st.term_signal.store(low)
        return()

