# RazorForge's SignalCaster: a monitor (a lock and a wait set). A waiter takes the lock, checks its condition, and
# waits while it doesn't hold: wait releases the lock, suspends, and takes it again when woken. The lock and the
# waiting of plain threads are Hosted's exclusive access and SignalCaster. What is RazorForge's own is here: the handle count
# the agents sharing one SignalCaster hold, and the coroutines a wait parks on the RazorForge scheduler (a cast on any
# thread wakes them, before any thread).

module Ingrid/Runtime

import Hosted

### rf_signal.
record Monitor
    guard: U8  # the byte whose exclusive access is the monitor's, which guards the caller's condition
    cond: SignalCaster  # plain threads wait here
    waiters: @ChannelWaiter  # parked coroutines
    refcount: U32

### Creates a SignalCaster monitor with one handle.
### :returns: The new monitor.
### :throws: Crashes with `OutOfMemoryError` when the allocation fails.
@export("rf_signal_create")
routine rf_signal_create() -> @Monitor
    sig: @Monitor = zeroed[Monitor](count: 1, what: "failed to allocate SignalCaster")
    sig.refcount.poke(1)
    return sig

### Adds a handle to the monitor, under its lock. A null `sig` does nothing.
### :param sig: The monitor.
@export("rf_signal_add_ref")
routine rf_signal_add_ref(sig: @Monitor) -> None
    if sig.is_hollow()
        return
    held: Authorized[U8] <- sig.guard.get_exclusive_access()
    next_refcount: U32 = sig.refcount.peek() + 1
    next_refcount.poke_into(sig.refcount)
    drop held
    return

### Drops a handle. The monitor is freed with the last. A null `sig` does nothing.
### :param sig: The monitor.
@export("rf_signal_drop")
routine rf_signal_drop(sig: @Monitor) -> None
    if sig.is_hollow()
        return
    held: Authorized[U8] <- sig.guard.get_exclusive_access()
    refs: U32 = sig.refcount.peek()
    left: U32 = refs -^ 1
    sig.refcount.poke(left)
    drop held
    if not (left == 0)
        return
    c_free(sig)
    return

### Takes the monitor lock. A null `sig` does nothing.
### :param sig: The monitor.
@export("rf_signal_lock")
routine rf_signal_lock(sig: @Monitor) -> None
    if sig.is_hollow()
        return
    AccessManager.take_exclusive(at: sig.guard, size: 1)
    return

### Releases the monitor lock. A null `sig` does nothing.
### :param sig: The monitor.
@export("rf_signal_unlock")
routine rf_signal_unlock(sig: @Monitor) -> None
    if sig.is_hollow()
        return
    AccessManager.give_back(at: sig.guard)
    return

### Waits for a cast, holding the monitor lock: releases it, suspends, and takes it again. A coroutine parks on the
### scheduler, a plain thread waits on the condition. A null `sig` returns at once.
### :param sig: The monitor, its lock held by the caller.
@export("rf_signal_wait")
routine rf_signal_wait(sig: @Monitor) -> None
    if sig.is_hollow()
        return
    sched: @Sched = rf_sched_current()
    coro: @Coro = current_coro()
    if sched.is_hollow() or coro.is_hollow()
        # The node is on the heap while the wait list holds it, so nothing of this routine's frame outlives it.
        # a cast may come from another thread: not a deadlock meanwhile
        sig.cond.wait(Authorized[U8](at: sig.guard))
        return
    node: @ChannelWaiter = zeroed[ChannelWaiter](count: 1,
        what: "Failed to allocate a monitor waiter")
    node.poke(ChannelWaiter(sched: sched, coro: coro, next: sig.waiters.peek()))
    sig.waiters.poke(node)
    AccessManager.give_back(at: sig.guard)
    rf_sched_arm_cross_waker(sched)
    rf_sched_park_external()
    rf_sched_disarm_cross_waker(sched)
    AccessManager.take_exclusive(at: sig.guard, size: 1)
    unlink(list: sig.waiters, node)
    c_free(node)
    return

### rf_signal_wait for at most timeout_ns: 1 if woken before the deadline (check the condition again), 0 if it
### passed. A null `sig` returns 0 at once.
### :param sig: The monitor, its lock held by the caller.
### :param timeout_ns: The longest wait, in nanoseconds.
### :returns: 1 when woken before the deadline, 0 when it passed.
@export("rf_signal_wait_deadline")
routine rf_signal_wait_deadline(sig: @Monitor, timeout_ns: U64) -> U32
    if sig.is_hollow()
        return 0
    deadline: Duration = Clock.monotonic() +^ Duration.from_nanoseconds(timeout_ns.to_clamp[S64]())
    sched: @Sched = rf_sched_current()
    coro: @Coro = current_coro()
    if sched.is_hollow() or coro.is_hollow()
        # The node is on the heap while the wait list holds it, so nothing of this routine's frame outlives it.
        in_time: Bool = sig.cond.wait_until(access: Authorized[U8](at: sig.guard), deadline)
        return in_time.to[U32]()
    node: @ChannelWaiter = zeroed[ChannelWaiter](count: 1,
        what: "Failed to allocate a monitor waiter")
    node.poke(ChannelWaiter(sched: sched, coro: coro, next: sig.waiters.peek()))
    sig.waiters.poke(node)
    AccessManager.give_back(at: sig.guard)
    rf_sched_park_deadline(timeout_ns)
    AccessManager.take_exclusive(at: sig.guard, size: 1)
    unlink(list: sig.waiters, node)
    c_free(node)
    if Clock.monotonic() >= deadline
        return 0
    return 1

### Wakes one waiter: a parked coroutine if there is one, else a thread. A null `sig` does nothing.
### :param sig: The monitor.
@export("rf_signal_cast_one")
routine rf_signal_cast_one(sig: @Monitor) -> None
    if sig.is_hollow()
        return
    sig.cast_one()
    return

### rf_signal_cast_one on a monitor that is there, under its lock.
routine @Monitor.cast_one() -> None
    held: Authorized[U8] <- me.guard.get_exclusive_access()
    w: @ChannelWaiter = me.waiters.peek()
    if w.is_hollow()
        me.cond.cast_one()
    else
        rf_sched_wake(s: w.sched.peek(), c: w.coro.peek())
    drop held
    return

### Wakes every waiter: each parked coroutine and every waiting thread. A null `sig` does nothing.
### :param sig: The monitor.
@export("rf_signal_cast_all")
routine rf_signal_cast_all(sig: @Monitor) -> None
    if sig.is_hollow()
        return
    held: Authorized[U8] <- sig.guard.get_exclusive_access()

    until w.is_hollow() with w: @ChannelWaiter = sig.waiters.peek()
        rf_sched_wake(s: w.sched.peek(), c: w.coro.peek())
        continue with w: w.next.peek()
    sig.cond.cast_all()
    drop held
    return
