// RazorForge's stackful coroutine: create / resume / yield / delete, the cancellation shadow stack, and
// abandonment. The stack and the context switch are Standard::Fiber's (switch_stack, initial_stack, and the stack
// allocator: pages reserved, committed as the stack grows, a no-access page at the bottom), the same on every
// operating system.
//
// rf_coro_resume switches into a coroutine and returns when it parks (rf_coro_yield and the scheduler's park
// primitives) or finishes, with its status. The coroutine running on a thread is a thread-local, read again after
// every switch, since a parked coroutine may go on on another thread.

module Ingrid::Runtime

import Standard::Alloc
import Standard::Fiber
import Standard::Os

/// The coroutine running on this thread, or null.
#threadlocal
global CURRENT_CORO: @@Coro

/// The order in which coroutines and threaded tasks finish, shared by both so race! compares them directly.
/// Starts at 1, so 0 is never a stamp and U64.MAX always means "not yet".
global COMPLETION_SEQ: @U64 <- 1

// rf_coro_status (razorforge_runtime.h).
preset CORO_NEW:       U32 = 0
preset CORO_RUNNING:   U32 = 1
preset CORO_PARKED:    U32 = 2
preset CORO_COMPLETED: U32 = 3
preset CORO_CANCELLED: U32 = 4

/// A coroutine's stack reserve when the caller gives 0: reserved, not committed, so a parked shallow coroutine
/// costs about the pages it has touched.
preset DEFAULT_STACK: USize = 1048576

/// rf_cancel_frame: one live owned value of a coroutine, in a node that lives in the scope owning the value.
record CancelFrame
    value_ptr  : Addr
    destroy_fn : Callable<(Addr,), Void>
    prev       : @CancelFrame

/// rf_coro.
record Coro
    entry            : Callable<(Addr,), Void>
    userdata         : Addr
    status           : U32  // a CORO_ value; read across threads
    cf_top           : @CancelFrame  // the cancellation shadow stack's top
    sched_next       : @Coro  // the injector's link
    wake_ns          : U64  // the deadline it is parked until
    timer_idx        : SSize  // its slot in the scheduler's timer heap, or -1
    sched_state      : U32  // a SCHED_ value (sched.tess)
    park_intent      : U32  // a PARK_ value, recorded by a park and applied by the worker
    counted_done     : Bool  // its completion has been taken off the scheduler's live count
    owner_released   : Bool  // its Agent let go while a worker held it: the worker frees it
    cancel_requested : U32
    initial_spawned  : Bool  // spawned once: a second spawn does nothing
    detached         : Bool  // execute(): the worker that completes it frees it
    awaiter          : @Coro  // a coroutine waiting for this one to finish
    completion_seq   : U64  // when it finished, in completion order (race! picks the first); U64.MAX until then
    stack            : Addr  // the bottom of its stack
    sp               : Addr  // its stack pointer while it isn't running
    resumer_sp       : Addr  // the resumer's stack pointer while it runs: where a yield goes back to

/// The coroutine running on this thread. Read again at every call: after a switch the thread may be another one.
/// :returns: The running coroutine, or null on a plain thread.
#noinline
routine current_coro() -> @Coro
    block entry()
        c : @Coro = CURRENT_CORO.load()
        return(c)

/// Takes the next completion stamp, shared by coroutines and threaded tasks.
/// :returns: The stamp, starting at 1.
routine next_completion_seq() -> U64
    block entry()
        seq : U64 = COMPLETION_SEQ.atomic_fetch_add(1)
        return(seq)

/// A new coroutine's first frame: runs its routine, marks it completed, and goes back to its resumer for the last
/// time.
#noreturn
routine coro_trampoline() -> Void
    block entry()
        self : @Coro                   = current_coro()
        body : Callable<(Addr,), Void> = self.entry.load()
        body.call(self.userdata.load())
        self.completion_seq.atomic_store(next_completion_seq())
        self.status.atomic_store(CORO_COMPLETED)
        switch_stack(self.sp, self.resumer_sp.load())
        unreachable

/// Reserves a coroutine stack from Standard::Fiber's stack allocator.
/// :param size: The stack's reserve in bytes.
/// :returns: The stack's bottom, or null when it can't be reserved.
routine stack_alloc(size: USize) -> Addr
    block entry()
        stacks : Allocator                     = make_stack_allocator()
        alloc  : Callable<(Addr, USize), Addr> = stacks.alloc_fn
        stack  : Addr                          = alloc.call(stacks.state, size)
        return(stack)

/// Gives a coroutine stack back to Standard::Fiber's stack allocator.
/// :param stack: The stack's bottom, from {stack_alloc}.
routine stack_free(stack: Addr) -> Void
    block entry()
        stacks : Allocator                    = make_stack_allocator()
        free   : Callable<(Addr, Addr), Void> = stacks.free_fn
        free.call(stacks.state, stack)
        return()

/// A coroutine whose body is entry(userdata), on a stack of stack_size bytes (0: DEFAULT_STACK). It starts when it
/// is first resumed. Null for a null entry.
/// :param entry: The coroutine's body.
/// :param userdata: The argument passed to `entry`.
/// :param stack_size: The stack's reserve in bytes, or 0 for `DEFAULT_STACK`.
/// :returns: The new coroutine, or null when `entry` is null.
/// :throws: Crashes with `OutOfMemoryError` when the control block or the stack can't be allocated.
#export("rf_coro_create")
routine rf_coro_create(entry: Callable<(Addr,), Void>, userdata: Addr, stack_size: USize) -> @Coro
    block entry()
        branch entry.addr().is_null()
            ? return(null)
            : continue
        coro : @Coro = zeroed<Coro>(1, "Failed to allocate coroutine control block")
        coro.entry.store(entry)
        coro.userdata.store(userdata)
        coro.timer_idx.store(-1)
        coro.completion_seq.store(U64.MAX)
        reserve : USize = stack_size.eq(0)
            ? DEFAULT_STACK
            : stack_size
        stack : Addr = stack_alloc(reserve)
        branch stack.is_null()
            ? no_stack(coro)
            : continue
        coro.stack.store(stack)
        coro.sp.store(initial_stack(stack.to<@Byte>(), reserve, coro_trampoline.addr()))
        return(coro)

    block no_stack(coro: @Coro)
        c_free(coro)
        rf_throw("OutOfMemoryError",
            "Failed to reserve coroutine stack (out of address space or commit limit)")

/// Switches into `coro` until it parks or finishes. A null or completed `coro` isn't switched into.
/// :param coro: The coroutine to run.
/// :returns: Its status then (`CORO_PARKED` or `CORO_COMPLETED`), `CORO_COMPLETED` for a null `coro`.
#export("rf_coro_resume")
routine rf_coro_resume(coro: @Coro) -> U32
    block entry()
        branch coro.is_null()
            ? return(CORO_COMPLETED)
            : continue
        branch coro.status.atomic_load().eq(CORO_COMPLETED)
            ? return(CORO_COMPLETED)
            : continue
        prev : @Coro = current_coro()
        CURRENT_CORO.store(coro)
        coro.status.atomic_store(CORO_RUNNING)
        switch_stack(coro.resumer_sp, coro.sp.load())
        CURRENT_CORO.store(prev)
        return(coro.status.atomic_load())

/// The running coroutine goes back to its resumer, parked. Whoever parks it says when it runs again.
routine coro_switch_out() -> Void
    block entry()
        self : @Coro = current_coro()
        branch self.is_null()
            ? return()
            : continue
        self.status.atomic_store(CORO_PARKED)
        switch_stack(self.sp, self.resumer_sp.load())
        return()

/// A coroutine's status, a `CORO_` value.
/// :param coro: The coroutine, or null.
/// :returns: Its status, `CORO_COMPLETED` for a null `coro`.
#export("rf_coro_status_get")
routine rf_coro_status_get(coro: @Coro) -> U32
    block entry()
        branch coro.is_null()
            ? return(CORO_COMPLETED)
            : return(coro.status.atomic_load())

/// The coroutine running on this thread, or null.
/// :returns: The running coroutine, or null on a plain thread.
#export("rf_coro_current")
routine rf_coro_current() -> @Coro
    block entry()
        return(current_coro())

/// The current logical task, for Roamed's task-keyed lock: the coroutine (the same across worker migration) or,
/// outside one, the OS thread. Only equality matters.
/// :returns: The coroutine's address, or the OS thread's identifier outside a coroutine.
#export("rf_current_task_id")
routine rf_current_task_id() -> U64
    block entry()
        self : @Coro = current_coro()
        branch self.is_null()
            ? return(rf_current_thread_id())
            : return(ptrtoint<Addr, U64>(self))

/// Asks a coroutine to stop: a flag it reads at a suspend point or with rf_cancel_requested. Nothing is freed. A
/// null `coro` does nothing.
/// :param coro: The coroutine.
#export("rf_coro_request_cancel")
routine rf_coro_request_cancel(coro: @Coro) -> Void
    block entry()
        branch coro.is_null()
            ? return()
            : continue
        coro.cancel_requested.atomic_store(1)
        return()

/// Whether a coroutine was asked to stop.
/// :param coro: The coroutine, or null.
/// :returns: 1 when cancellation was requested, else 0 (0 for a null `coro`).
#export("rf_coro_is_cancel_requested")
routine rf_coro_is_cancel_requested(coro: @Coro) -> U32
    block entry()
        branch coro.is_null()
            ? return(0)
            : return(coro.cancel_requested.atomic_load())

/// Frees a coroutine and its stack. Not one that runs, nor a parked one with live values (rf_coro_abandon). A null
/// `coro` does nothing.
/// :param coro: The coroutine to free.
#export("rf_coro_delete")
routine rf_coro_delete(coro: @Coro) -> Void
    block entry()
        branch coro.is_null()
            ? return()
            : continue
        stack : Addr = coro.stack.load()
        branch stack.is_null()
            ? free()
            : continue
        stack_free(stack)
        jump free()

    block free()
        c_free(coro)
        return()

/// execute(): the worker that completes the coroutine frees it. Set before it is spawned, so before any worker
/// can reach its completion. A null `coro` does nothing.
/// :param coro: The coroutine.
#export("rf_coro_set_detached")
routine rf_coro_set_detached(coro: @Coro) -> Void
    block entry()
        branch coro.is_null()
            ? return()
            : continue
        coro.detached.store(true)
        return()

/// An owned value was constructed: frame (a node in the owning scope) becomes the running coroutine's top. Outside a
/// coroutine nothing is tracked.
/// :param frame: The node, in the scope owning the value.
/// :param value_ptr: The value.
/// :param destroy_fn: What destroys the value if the coroutine is abandoned.
#export("rf_coro_cf_push")
routine rf_coro_cf_push(frame: @CancelFrame, value_ptr: Addr,
    destroy_fn: Callable<(Addr,), Void>) -> Void
    block entry()
        self : @Coro = current_coro()
        branch frame.is_null().bitor(self.is_null())
            ? return()
            : continue
        frame.value_ptr.store(value_ptr)
        frame.destroy_fn.store(destroy_fn)
        frame.prev.store(self.cf_top.load())
        self.cf_top.store(frame)
        return()

/// The value's own destroy ran: frame (the top) is unlinked without firing. An unbalanced pop leaves the stack as
/// it is. Outside a coroutine, or for a null `frame` (which push never linked), nothing happens.
/// :param frame: The node pushed for the value.
#export("rf_coro_cf_pop")
routine rf_coro_cf_pop(frame: @CancelFrame) -> Void
    block entry()
        self : @Coro = current_coro()
        branch frame.is_null().bitor(self.is_null())
            ? return()
            : continue
        branch self.cf_top.load().ptr_eq(frame)
            ? continue
            : return()
        self.cf_top.store(frame.prev.load())
        return()

/// A parked or never-started coroutine is abandoned: each live value's destroy runs once, top to bottom (reverse
/// construction order), then the coroutine and its stack are freed. A completed one is just freed. An abandoned one
/// is marked `CORO_CANCELLED` and given a completion stamp if it had none. A null `coro` does nothing.
/// :param coro: The coroutine to abandon.
#export("rf_coro_abandon")
routine rf_coro_abandon(coro: @Coro) -> Void
    block entry()
        branch coro.is_null()
            ? return()
            : continue
        branch coro.status.atomic_load().eq(CORO_COMPLETED)
            ? free()
            : continue
        // Stamped like a completion, so a cancelled coroutine that finished first still wins a race!.
        branch coro.completion_seq.atomic_load().eq(U64.MAX)
            ? stamp()
            : cancel()

    block stamp()
        coro.completion_seq.atomic_store(next_completion_seq())
        jump cancel()

    block cancel()
        coro.status.atomic_store(CORO_CANCELLED)
        jump frame(coro.cf_top.load())

    block frame(f: @CancelFrame)
        branch f.is_null()
            ? done()
            : continue
        prev    : @CancelFrame            = f.prev.load()
        destroy : Callable<(Addr,), Void> = f.destroy_fn.load()
        branch destroy.addr().is_null()
            ? frame(prev)
            : continue
        destroy.call(f.value_ptr.load())
        jump frame(prev)

    block done()
        coro.cf_top.store(null)
        jump free()

    block free()
        rf_coro_delete(coro)
        return()
