// What the rest of Ingrid's runtime code shares: the C library and runtime routines it calls, the clock, the
// identity of the calling thread, and the crash handler of the Tessera code in this library. Threads wait on
// Standard::Os's Mutex and Condition.
//
// The runtime library is shared (razorforge_runtime.dll / .so / .dylib), and this code is compiled into it, so a
// routine RazorForge calls is exported under its C name (#export), and calls into the rest of the library (the crash
// report) go through the C library.

module Ingrid::Runtime

import Standard::Format
import Standard::Os

// -- the C library -------------------------------------------------------------------

#[external("c"), symbol("calloc")]
routine c_calloc(count: USize, size: USize) -> Addr

#[external("c"), symbol("realloc")]
routine c_realloc(ptr: Addr, size: USize) -> Addr

#[external("c"), symbol("malloc")]
routine c_malloc(size: USize) -> Addr

#[external("c"), symbol("free")]
routine c_free(ptr: Addr) -> Void

#[external("c"), symbol("getenv")]
routine c_getenv(name: CStr) -> @Byte

// -- the rest of the runtime library -------------------------------------------------

/// Frees a block from rf_allocate_dynamic (Ingrid/tessera/memory.tess, in the program): a result box. A C heap block,
/// so free reclaims it here too.
routine rf_invalidate(ptr: Addr) -> Void
    block entry()
        c_free(ptr)
        return()

/// count zeroed Ts, or the runtime's out-of-memory error naming what.
routine zeroed<T>(count: USize, what: CStr) -> @T
require T: typename
    block entry()
        p : Addr = c_calloc(count, sizeof<T>())
        branch p.is_null()
            ? rf_throw("OutOfMemoryError", what)
            : return(p.to<@T>())

// -- the clock and the calling thread ------------------------------------------------

/// The monotonic nanosecond clock the scheduler's timers use, for the timed-await bridge.
#export("rf_monotonic_now_ns")
routine rf_monotonic_now_ns() -> U64
    block entry()
        return(monotonic_ns())

#[external("c"), symbol("GetCurrentThreadId"), callconv("stdcall"), target(os: "windows")]
routine c_get_current_thread_id() -> U32

#[external("c"), symbol("pthread_self"), target(os: not "windows")]
routine c_pthread_self() -> Addr

/// A stable identifier of the calling OS thread: only equality across calls on one thread matters (a lock policy
/// detecting a re-entrant claim).
#[export("rf_current_thread_id"), target(os: "windows")]
routine rf_current_thread_id() -> U64
    block entry()
        return(c_get_current_thread_id().to<U64>())

#[export("rf_current_thread_id"), target(os: not "windows")]
routine rf_current_thread_id() -> U64
    block entry()
        return(ptrtoint<Addr, U64>(c_pthread_self()))

/// The environment variable name as a positive integer, or 0 when it is unset, empty, not a number, or not
/// positive.
routine env_positive(name: CStr) -> U64
    shared text  : @Byte = c_getenv(name)
    shared value : @U64  <- 0

    block entry()
        unset : Bool = text.is_null()
        branch unset
            ? return(0)
            : digit(0)

    block digit(i: USize)
        digit_byte : Byte = text.stride(i).load()
        c          : U8   = digit_byte.to<U8>()
        more       : Bool = c.ge(48).bitand(c.le(57))
        branch more
            ? add(i, c)
            : return(value.load())

    block add(i: USize, c: U8)
        next : U64 = value.load().mul_clamp(10).add_clamp(c.sub(48).to<U64>())
        next.store_into(value)
        jump digit(i.add(1))

// -- the crash handler of this library's Tessera code --------------------------------

/// A crash in this library's Tessera code (a broken stdlib contract) is a RazorForge runtime error, with the same
/// crash report and exit status as any other: the crash's name is the error type.
#[export("tessera_crash_handler"), noreturn]
routine runtime_crash_handler(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    shared kind     : @Array<Byte, 128>  <- uninit
    shared kind_ptr : @Byte              = kind.to<@Byte>()
    shared buffer   : @Array<Byte, 1024> <- uninit
    shared out      : @SliceWriter       <- uninit

    block entry()
        claim kind_out : @SliceWriter <- SliceWriter.construct(kind.to<@Byte>(), 127)
        write_str(kind_out, name)
        kind_text : Bytes = kind_out.load().to<Bytes>()
        kind_ptr.stride(kind_text.count).store(0x00)
        out.store(SliceWriter.construct(buffer.to<@Byte>(), 1023))
        write_str(out, message)
        nowhere : Bool = place.is_null()
        branch nowhere
            ? finish()
            : continue
        out.write(" (at {place.file.load()}:{place.line.load()}:{place.column.load()})")
        jump finish()

    // The name and the text both end in a NUL for rf_throw.
    block finish()
        text     : Bytes = out.load().to<Bytes>()
        text_ptr : @Byte = buffer.to<@Byte>()
        text_ptr.stride(text.count).store(0x00)
        rf_throw(kind_ptr.to<CStr>(), text_ptr.to<CStr>())
