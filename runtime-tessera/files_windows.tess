// files.tess on Windows: the Win32 ANSI calls.

module Ingrid::Runtime

import Standard::Os

preset GENERIC_READ:              U32 = 0x80000000
preset GENERIC_WRITE:             U32 = 0x40000000
preset FILE_SHARE_READ:           U32 = 1
preset FILE_SHARE_WRITE:          U32 = 2
preset OPEN_EXISTING:             U32 = 3
preset OPEN_ALWAYS:               U32 = 4
preset FILE_FLAG_SEQUENTIAL_SCAN: U32 = 0x08000000
preset FILE_ATTRIBUTE_NORMAL:     U32 = 0x80
preset FILE_ATTRIBUTE_DIRECTORY:  U32 = 0x10
preset FILE_ATTRIBUTE_READONLY:   U32 = 1
preset INVALID_FILE_ATTRIBUTES:   U32 = 0xFFFFFFFF
preset PAGE_READONLY:             U32 = 2
preset PAGE_READWRITE:            U32 = 4
preset FILE_MAP_WRITE:            U32 = 2
preset FILE_MAP_READ:             U32 = 4
preset FILE_WRITE_ATTRIBUTES:     U32 = 0x100
preset ERROR_FILE_EXISTS:         U32 = 80
preset ERROR_ALREADY_EXISTS:      U32 = 183
preset MAX_PATH:                  U32 = 260

/// WIN32_FIND_DATAA: the attributes, the times (the last write at 20), and the name at 44.
preset FIND_DATA_SIZE:  USize = 320
preset FIND_WRITE_TIME: USize = 20
preset FIND_NAME:       USize = 44

record AttributeData
    attributes  : U32
    created     : FileTime
    accessed    : FileTime
    written     : FileTime
    size_high   : U32
    size_low    : U32

#[external("c"), symbol("GetFileAttributesA"), callconv("stdcall"), target(os: "windows")]
routine c_get_file_attributes(path: @Byte) -> U32

#[external("c"), symbol("GetFileAttributesExA"), callconv("stdcall"), target(os: "windows")]
routine c_get_file_attributes_ex(path: @Byte, level: CInt, data: @AttributeData) -> CInt

#[external("c"), symbol("SetFileAttributesA"), callconv("stdcall"), target(os: "windows")]
routine c_set_file_attributes(path: @Byte, attributes: U32) -> CInt

#[external("c"), symbol("CreateDirectoryA"), callconv("stdcall"), target(os: "windows")]
routine c_create_directory(path: @Byte, security: Addr) -> CInt

#[external("c"), symbol("RemoveDirectoryA"), callconv("stdcall"), target(os: "windows")]
routine c_remove_directory(path: @Byte) -> CInt

#[external("c"), symbol("DeleteFileA"), callconv("stdcall"), target(os: "windows")]
routine c_delete_file(path: @Byte) -> CInt

#[external("c"), symbol("CopyFileA"), callconv("stdcall"), target(os: "windows")]
routine c_copy_file(from: @Byte, to: @Byte, fail_if_exists: CInt) -> CInt

#[external("c"), symbol("MoveFileExA"), callconv("stdcall"), target(os: "windows")]
routine c_move_file_ex(from: @Byte, to: @Byte, flags: U32) -> CInt

#[external("c"), symbol("GetLastError"), callconv("stdcall"), target(os: "windows")]
routine c_get_last_error() -> U32

#[external("c"), symbol("FindFirstFileA"), callconv("stdcall"), target(os: "windows")]
routine c_find_first_file(pattern: @Byte, data: @Byte) -> Addr

#[external("c"), symbol("FindNextFileA"), callconv("stdcall"), target(os: "windows")]
routine c_find_next_file(find: Addr, data: @Byte) -> CInt

#[external("c"), symbol("FindClose"), callconv("stdcall"), target(os: "windows")]
routine c_find_close(find: Addr) -> CInt

#[external("c"), symbol("GetCurrentDirectoryA"), callconv("stdcall"), target(os: "windows")]
routine c_get_current_directory(size: U32, buf: @Byte) -> U32

#[external("c"), symbol("SetCurrentDirectoryA"), callconv("stdcall"), target(os: "windows")]
routine c_set_current_directory(path: @Byte) -> CInt

#[external("c"), symbol("GetTempPathA"), callconv("stdcall"), target(os: "windows")]
routine c_get_temp_path(size: U32, buf: @Byte) -> U32

#[external("c"), symbol("GetFullPathNameA"), callconv("stdcall"), target(os: "windows")]
routine c_get_full_path_name(path: @Byte, size: U32, buf: @Byte, part: Addr) -> U32

#[external("c"), symbol("CreateFileA"), callconv("stdcall"), target(os: "windows")]
routine c_create_file_a(name: @Byte, access: U32, share: U32, security: Addr, disposition: U32, flags: U32,
        template: Addr) -> Addr

#[external("c"), symbol("GetFileSizeEx"), callconv("stdcall"), target(os: "windows")]
routine c_get_file_size_ex(file: Addr, size: @S64) -> CInt

#[external("c"), symbol("SetFilePointerEx"), callconv("stdcall"), target(os: "windows")]
routine c_set_file_pointer_ex(file: Addr, distance: S64, new_position: Addr, method: U32) -> CInt

#[external("c"), symbol("SetEndOfFile"), callconv("stdcall"), target(os: "windows")]
routine c_set_end_of_file(file: Addr) -> CInt

#[external("c"), symbol("GetSystemTimeAsFileTime"), callconv("stdcall"), target(os: "windows")]
routine c_get_system_time_as_file_time(time: @FileTime) -> Void

#[external("c"), symbol("SetFileTime"), callconv("stdcall"), target(os: "windows")]
routine c_set_file_time(file: Addr, created: Addr, accessed: Addr, written: @FileTime) -> CInt

#[external("c"), symbol("CreateFileMappingA"), callconv("stdcall"), target(os: "windows")]
routine c_create_file_mapping(file: Addr, security: Addr, protect: U32, size_high: U32, size_low: U32,
        name: Addr) -> Addr

#[external("c"), symbol("MapViewOfFile"), callconv("stdcall"), target(os: "windows")]
routine c_map_view_of_file(mapping: Addr, access: U32, offset_high: U32, offset_low: U32, size: USize) -> Addr

#[external("c"), symbol("UnmapViewOfFile"), callconv("stdcall"), target(os: "windows")]
routine c_unmap_view_of_file(view: Addr) -> CInt

#[external("c"), symbol("FlushViewOfFile"), callconv("stdcall"), target(os: "windows")]
routine c_flush_view_of_file(view: Addr, size: USize) -> CInt

/// MEMORYSTATUSEX: its length first, the total physical memory at 8.
record MemoryStatus
    length        : U32
    load          : U32
    total_phys    : U64
    avail_phys    : U64
    total_file    : U64
    avail_file    : U64
    total_virtual : U64
    avail_virtual : U64
    avail_extended: U64

#[external("c"), symbol("GlobalMemoryStatusEx"), callconv("stdcall"), target(os: "windows")]
routine c_global_memory_status_ex(status: @MemoryStatus) -> CInt

record MemoryRange
    address : Addr
    size    : USize

#[external("c"), symbol("PrefetchVirtualMemory"), callconv("stdcall"), target(os: "windows")]
routine c_prefetch_virtual_memory(process: Addr, count: USize, ranges: @MemoryRange, flags: U32) -> CInt

/// SYSTEM_INFO: the allocation granularity is at 4 × 4 + 3 × pointer + 2 × 4.
record SystemInfo
    architecture   : U16
    reserved       : U16
    page_size      : U32
    min_address    : Addr
    max_address    : Addr
    processor_mask : USize
    processors     : U32
    processor_type : U32
    granularity    : U32
    level          : U16
    revision       : U16

#[external("c"), symbol("GetSystemInfo"), callconv("stdcall"), target(os: "windows")]
routine c_get_system_info(info: @SystemInfo) -> Void

#[external("c"), symbol("_stricmp"), target(os: "windows")]
routine c_stricmp(a: @Byte, b: CStr) -> CInt

#[external("c"), symbol("strrchr"), target(os: "windows")]
routine c_strrchr(s: @Byte, c: CInt) -> @Byte

#target(os: "windows")
routine invalid_handle(h: Addr) -> Bool
    block entry():
        return(ptrtoint<Addr, U64>(h).eq(U64.MAX))

/// The attributes of path, or INVALID_FILE_ATTRIBUTES; path is freed.
#target(os: "windows")
routine attributes_of(path: @Byte, len: S32) -> U32
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(INVALID_FILE_ATTRIBUTES)
            : continue
        attr : U32 = c_get_file_attributes(cpath)
        c_free(cpath)
        return(attr)

#target(os: "windows")
routine has(attr: U32, flag: U32) -> Bool
    block entry():
        return(attr.bitand(flag).ne(0))

#target(os: "windows")
routine ticks_to_unix(t: FileTime) -> S64
    block entry():
        ticks : U64 = t.high.to<U64>().shl(32).bitor(t.low.to<U64>())
        // seconds between 1601-01-01 and 1970-01-01
        return(ticks.div(10000000).to<S64>().sub(11644473600))

// -- existence and kind ----------------------------------------------------------------

#[export("rf_fs_exists"), target(os: "windows")]
routine rf_fs_exists(path: @Byte, len: S32) -> Bool
    block entry():
        return(attributes_of(path, len).ne(INVALID_FILE_ATTRIBUTES))

#[export("rf_fs_is_file"), target(os: "windows")]
routine rf_fs_is_file(path: @Byte, len: S32) -> Bool
    block entry():
        attr : U32 = attributes_of(path, len)
        return(attr.ne(INVALID_FILE_ATTRIBUTES).bitand(has(attr, FILE_ATTRIBUTE_DIRECTORY).bitnot()))

#[export("rf_fs_is_directory"), target(os: "windows")]
routine rf_fs_is_directory(path: @Byte, len: S32) -> Bool
    block entry():
        attr : U32 = attributes_of(path, len)
        return(attr.ne(INVALID_FILE_ATTRIBUTES).bitand(has(attr, FILE_ATTRIBUTE_DIRECTORY)))

#[export("rf_fs_can_read"), target(os: "windows")]
routine rf_fs_can_read(path: @Byte, len: S32) -> Bool
    block entry():
        return(attributes_of(path, len).ne(INVALID_FILE_ATTRIBUTES))

#[export("rf_fs_can_write"), target(os: "windows")]
routine rf_fs_can_write(path: @Byte, len: S32) -> Bool
    block entry():
        attr : U32 = attributes_of(path, len)
        return(attr.ne(INVALID_FILE_ATTRIBUTES).bitand(has(attr, FILE_ATTRIBUTE_READONLY).bitnot()))

/// A file whose extension is .exe, .cmd, .bat or .com.
#[export("rf_fs_can_execute"), target(os: "windows")]
routine rf_fs_can_execute(path: @Byte, len: S32) -> Bool
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(false)
            : continue
        attr : U32 = c_get_file_attributes(cpath)
        branch attr.eq(INVALID_FILE_ATTRIBUTES).bitor(has(attr, FILE_ATTRIBUTE_DIRECTORY))
            ? no(cpath)
            : continue
        ext : @Byte = c_strrchr(cpath, 46)
        branch ext.is_null()
            ? no(cpath)
            : continue
        program : Bool = c_stricmp(ext, ".exe").eq(0).bitor(c_stricmp(ext, ".com").eq(0))
        script  : Bool = c_stricmp(ext, ".cmd").eq(0).bitor(c_stricmp(ext, ".bat").eq(0))
        known   : Bool = program.bitor(script)
        c_free(cpath)
        return(known)

    block no(cpath: @Byte):
        c_free(cpath)
        return(false)

#[export("rf_fs_set_readonly"), target(os: "windows")]
routine rf_fs_set_readonly(path: @Byte, len: S32, readonly: Bool) -> S32
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(-1)
            : continue
        attr : U32 = c_get_file_attributes(cpath)
        branch attr.eq(INVALID_FILE_ATTRIBUTES)
            ? done(cpath, false)
            : continue
        set : U32 = readonly ? attr.bitor(FILE_ATTRIBUTE_READONLY) : attr.bitand(FILE_ATTRIBUTE_READONLY.bitnot())
        jump done(cpath, c_set_file_attributes(cpath, set).ne(0))

    block done(cpath: @Byte, ok: Bool):
        c_free(cpath)
        branch ok
            ? return(0)
            : return(-1)

// -- directories ---------------------------------------------------------------------

#[export("rf_fs_create_dir"), target(os: "windows")]
routine rf_fs_create_dir(path: @Byte, len: S32) -> S32
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(-1)
            : continue
        ok : Bool = c_create_directory(cpath, null).ne(0)
        c_free(cpath)
        branch ok
            ? return(0)
            : return(-1)

/// Like mkdir -p: each component in turn, then the whole; it already existing is fine.
#[export("rf_fs_create_dir_all"), target(os: "windows")]
routine rf_fs_create_dir_all(path: @Byte, len: S32) -> S32
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(-1)
            : continue
        // a drive letter, then a leading separator, are skipped
        branch cpath.load().eq(0x00)
            ? lead(cpath, 0)
            : continue
        branch cpath.stride(1).load().eq(b':')
            ? lead(cpath, 2)
            : lead(cpath, 0)

    block lead(cpath: @Byte, drive: USize):
        branch is_sep(cpath.stride(drive).load())
            ? scan(cpath, drive.add(1))
            : scan(cpath, drive)

    block scan(cpath: @Byte, i: USize):
        c : Byte = cpath.stride(i).load()
        branch c.eq(0x00)
            ? last(cpath)
            : continue
        branch is_sep(c)
            ? make(cpath, i, c)
            : scan(cpath, i.add(1))

    block make(cpath: @Byte, i: USize, c: Byte):
        cpath.stride(i).store(0x00)
        c_create_directory(cpath, null)
        cpath.stride(i).store(c)
        jump scan(cpath, i.add(1))

    block last(cpath: @Byte):
        ok  : Bool = c_create_directory(cpath, null).ne(0)
        err : U32  = c_get_last_error()
        c_free(cpath)
        branch ok.bitor(err.eq(ERROR_ALREADY_EXISTS))
            ? return(0)
            : return(-1)

#[export("rf_fs_remove"), target(os: "windows")]
routine rf_fs_remove(path: @Byte, len: S32) -> S32
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(-1)
            : continue
        attr : U32 = c_get_file_attributes(cpath)
        branch attr.eq(INVALID_FILE_ATTRIBUTES)
            ? done(cpath, false)
            : continue
        branch has(attr, FILE_ATTRIBUTE_DIRECTORY)
            ? done(cpath, c_remove_directory(cpath).ne(0))
            : done(cpath, c_delete_file(cpath).ne(0))

    block done(cpath: @Byte, ok: Bool):
        c_free(cpath)
        branch ok
            ? return(0)
            : return(-1)

/// path + "\*" for FindFirstFileA, or null.
#target(os: "windows")
routine find_pattern(cpath: @Byte) -> @Byte
    block entry():
        n : USize = c_strlen(cpath)
        p : Addr  = c_malloc(n.add(3))
        branch p.is_null()
            ? return(null)
            : continue
        c_memcpy(p, cpath, n)
        p.to<@Byte>().stride(n).store(b'\\')
        p.to<@Byte>().stride(n.add(1)).store(b'*')
        p.to<@Byte>().stride(n.add(2)).store(0x00)
        return(p.to<@Byte>())

/// A directory and everything in it, or a file.
#[export("rf_fs_remove_all"), target(os: "windows")]
routine rf_fs_remove_all(path: @Byte, len: S32) -> S32
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(-1)
            : continue
        attr : U32 = c_get_file_attributes(cpath)
        branch attr.eq(INVALID_FILE_ATTRIBUTES)
            ? done(cpath, false)
            : continue
        branch has(attr, FILE_ATTRIBUTE_DIRECTORY)
            ? continue
            : done(cpath, c_delete_file(cpath).ne(0))
        pattern : @Byte = find_pattern(cpath)
        branch pattern.is_null()
            ? done(cpath, false)
            : continue
        claim data : @Array<Byte, 320> <- uninit
        find : Addr = c_find_first_file(pattern, data.to<@Byte>())
        c_free(pattern)
        branch invalid_handle(find)
            ? remove(cpath)
            : entry_(cpath, find, data.to<@Byte>())

    block entry_(cpath: @Byte, find: Addr, data: @Byte):
        name : @Byte = data.stride(FIND_NAME)
        branch is_dot_entry(name)
            ? next(cpath, find, data)
            : continue
        child : @Byte = rf_fs_join_child(cpath, name, b'\\')
        branch child.is_null()
            ? next(cpath, find, data)
            : continue
        rf_fs_remove_all(child, c_strlen(child).to<S32>())
        c_free(child)
        jump next(cpath, find, data)

    block next(cpath: @Byte, find: Addr, data: @Byte):
        branch c_find_next_file(find, data).ne(0)
            ? entry_(cpath, find, data)
            : continue
        c_find_close(find)
        jump remove(cpath)

    block remove(cpath: @Byte):
        jump done(cpath, c_remove_directory(cpath).ne(0))

    block done(cpath: @Byte, ok: Bool):
        c_free(cpath)
        branch ok
            ? return(0)
            : return(-1)

/// dir + sep + name, malloc'd, or null.
routine rf_fs_join_child(dir: @Byte, name: @Byte, sep: Byte) -> @Byte
    block entry():
        dl : USize = c_strlen(dir)
        nl : USize = c_strlen(name)
        p  : Addr  = c_malloc(dl.add(nl).add(2))
        branch p.is_null()
            ? return(null)
            : continue
        out : @Byte = p.to<@Byte>()
        c_memcpy(out, dir, dl)
        out.stride(dl).store(sep)
        c_memcpy(out.stride(dl.add(1)), name, nl)
        out.stride(dl.add(nl).add(1)).store(0x00)
        return(out)

#target(os: "windows")
routine list_directory(path: @Byte, len: S32, typed: Bool) -> @Byte
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(no_result())
            : continue
        claim out : @Listing <- Listing { buf: null, len: 0, cap: 0 }
        branch out.start()
            ? continue
            : fail(cpath, out)
        pattern : @Byte = find_pattern(cpath)
        branch pattern.is_null()
            ? fail(cpath, out)
            : continue
        claim data : @Array<Byte, 320> <- uninit
        find : Addr = c_find_first_file(pattern, data.to<@Byte>())
        c_free(pattern)
        branch invalid_handle(find)
            ? fail(cpath, out)
            : one(cpath, out, find, data.to<@Byte>())

    block one(cpath: @Byte, out: @Listing, find: Addr, data: @Byte):
        name : @Byte = data.stride(FIND_NAME)
        branch is_dot_entry(name)
            ? next(cpath, out, find, data)
            : continue
        attr   : U32      = data.to<@U32>().load()
        mtime  : S64      = ticks_to_unix(data.stride(FIND_WRITE_TIME).to<@FileTime>().load())
        branch out.entry(name, typed, has(attr, FILE_ATTRIBUTE_DIRECTORY), mtime)
            ? next(cpath, out, find, data)
            : broke(cpath, out, find)

    block next(cpath: @Byte, out: @Listing, find: Addr, data: @Byte):
        branch c_find_next_file(find, data).ne(0)
            ? one(cpath, out, find, data)
            : continue
        c_find_close(find)
        c_free(cpath)
        return(out.finish())

    block broke(cpath: @Byte, out: @Listing, find: Addr):
        c_find_close(find)
        jump fail(cpath, out)

    block fail(cpath: @Byte, out: @Listing):
        c_free(cpath)
        c_free(out.buf.load())
        return(no_result())

/// The entries' names, '\n' between them ("." and ".." left out).
#[export("rf_fs_list_dir"), target(os: "windows")]
routine rf_fs_list_dir(path: @Byte, len: S32) -> @Byte
    block entry():
        return(list_directory(path, len, false))

/// `<d|f><mtime> <name>` per entry, the kind and modification time from the listing itself.
#[export("rf_fs_list_dir_typed"), target(os: "windows")]
routine rf_fs_list_dir_typed(path: @Byte, len: S32) -> @Byte
    block entry():
        return(list_directory(path, len, true))

// -- copy and move ---------------------------------------------------------------------

#[export("rf_fs_copy"), target(os: "windows")]
routine rf_fs_copy(src: @Byte, src_len: S32, dst: @Byte, dst_len: S32) -> S32
    block entry():
        a : @Byte = strdupn(src, src_len)
        b : @Byte = strdupn(dst, dst_len)
        ok : Bool = a.is_not_null().bitand(b.is_not_null())
        branch ok
            ? continue
            : done(a, b, false)
        jump done(a, b, c_copy_file(a, b, 0).ne(0))

    block done(a: @Byte, b: @Byte, ok: Bool):
        c_free(a)
        c_free(b)
        branch ok
            ? return(0)
            : return(-1)

#[export("rf_fs_move"), target(os: "windows")]
routine rf_fs_move(src: @Byte, src_len: S32, dst: @Byte, dst_len: S32) -> S32
    block entry():
        a : @Byte = strdupn(src, src_len)
        b : @Byte = strdupn(dst, dst_len)
        branch a.is_not_null().bitand(b.is_not_null())
            ? continue
            : done(a, b, false)
        // MOVEFILE_REPLACE_EXISTING
        jump done(a, b, c_move_file_ex(a, b, 1).ne(0))

    block done(a: @Byte, b: @Byte, ok: Bool):
        c_free(a)
        c_free(b)
        branch ok
            ? return(0)
            : return(-1)

/// 0 moved, 1 the destination exists (nothing moved), -1 an error.
#[export("rf_fs_move_no_replace"), target(os: "windows")]
routine rf_fs_move_no_replace(src: @Byte, src_len: S32, dst: @Byte, dst_len: S32) -> S32
    block entry():
        a : @Byte = strdupn(src, src_len)
        b : @Byte = strdupn(dst, dst_len)
        branch a.is_not_null().bitand(b.is_not_null())
            ? continue
            : done(a, b, -1)
        branch c_move_file_ex(a, b, 0).ne(0)
            ? done(a, b, 0)
            : continue
        err : U32 = c_get_last_error()
        branch err.eq(ERROR_ALREADY_EXISTS).bitor(err.eq(ERROR_FILE_EXISTS))
            ? done(a, b, 1)
            : done(a, b, -1)

    block done(a: @Byte, b: @Byte, code: S32):
        c_free(a)
        c_free(b)
        return(code)

// -- metadata --------------------------------------------------------------------------

#target(os: "windows")
routine attribute_data(path: @Byte, len: S32, data: @AttributeData) -> Bool
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(false)
            : continue
        // GetFileExInfoStandard
        ok : Bool = c_get_file_attributes_ex(cpath, 0, data).ne(0)
        c_free(cpath)
        return(ok)

#[export("rf_fs_metadata"), target(os: "windows")]
routine rf_fs_metadata(path: @Byte, len: S32) -> S32
    block entry():
        claim data : @AttributeData <- uninit
        branch attribute_data(path, len, data)
            ? continue
            : return(-1)
        d : AttributeData = data.load()
        META_SIZE.store(d.size_high.to<U64>().shl(32).bitor(d.size_low.to<U64>()).to<S64>())
        META_MODIFIED.store(ticks_to_unix(d.written))
        META_CREATED.store(ticks_to_unix(d.created))
        META_IS_DIRECTORY.store(has(d.attributes, FILE_ATTRIBUTE_DIRECTORY))
        META_READONLY.store(has(d.attributes, FILE_ATTRIBUTE_READONLY))
        return(0)

#[export("rf_fs_file_size"), target(os: "windows")]
routine rf_fs_file_size(path: @Byte, len: S32) -> S64
    block entry():
        claim data : @AttributeData <- uninit
        branch attribute_data(path, len, data)
            ? continue
            : return(-1)
        d : AttributeData = data.load()
        return(d.size_high.to<U64>().shl(32).bitor(d.size_low.to<U64>()).to<S64>())

// -- the working directory and standard directories ------------------------------------

#[export("rf_fs_current_dir"), target(os: "windows")]
routine rf_fs_current_dir() -> @Byte
    block entry():
        need : U32 = c_get_current_directory(0, null)
        branch need.eq(0)
            ? return(no_result())
            : continue
        buf : Addr = c_malloc(need.to<USize>())
        branch buf.is_null()
            ? return(no_result())
            : continue
        got : U32 = c_get_current_directory(need, buf.to<@Byte>())
        branch got.eq(0).bitor(got.ge(need))
            ? failed(buf)
            : return(result(buf.to<@Byte>(), got.to<USize>()))

    block failed(buf: Addr):
        c_free(buf)
        return(no_result())

#[export("rf_fs_set_current_dir"), target(os: "windows")]
routine rf_fs_set_current_dir(path: @Byte, len: S32) -> S32
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(-1)
            : continue
        ok : Bool = c_set_current_directory(cpath).ne(0)
        c_free(cpath)
        branch ok
            ? return(0)
            : return(-1)

/// The temporary directory, without its trailing separator; C:\Windows\Temp when it can't be told.
#[export("rf_fs_temp_dir"), target(os: "windows")]
routine rf_fs_temp_dir() -> @Byte
    block entry():
        claim buf : @Array<Byte, 261> <- uninit
        got : U32 = c_get_temp_path(261, buf.to<@Byte>())
        branch got.eq(0).bitor(got.gt(MAX_PATH))
            ? fallback()
            : continue
        last : USize = got.sub(1).to<USize>()
        branch is_sep(buf.to<@Byte>().stride(last).load())
            ? continue
            : done(buf.to<@Byte>())
        buf.to<@Byte>().stride(last).store(0x00)
        jump done(buf.to<@Byte>())

    block done(path: @Byte):
        return(dup_result(path))

    block fallback():
        claim fixed : @Array<Byte, 16> <- { 0x43, 0x3A, 0x5C, 0x57, 0x69, 0x6E, 0x64, 0x6F, 0x77, 0x73, 0x5C, 0x54, 0x65,
                0x6D, 0x70, 0x00 }
        return(dup_result(fixed.to<@Byte>()))

/// Makes the file if it is missing, and sets its modification time to now.
#[export("rf_fs_touch"), target(os: "windows")]
routine rf_fs_touch(path: @Byte, len: S32) -> S32
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(-1)
            : continue
        h : Addr = c_create_file_a(cpath, FILE_WRITE_ATTRIBUTES, FILE_SHARE_READ.bitor(FILE_SHARE_WRITE), null,
                OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, null)
        c_free(cpath)
        branch invalid_handle(h)
            ? return(-1)
            : continue
        claim now : @FileTime <- FileTime { low: 0, high: 0 }
        c_get_system_time_as_file_time(now)
        ok : Bool = c_set_file_time(h, null, null, now).ne(0)
        c_close_handle(h)
        branch ok
            ? return(0)
            : return(-1)

/// The full path, or null; with must_exist, null when nothing is there.
#target(os: "windows")
routine full_path(path: @Byte, len: S32, must_exist: Bool) -> @Byte
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(no_result())
            : continue
        claim resolved : @Array<Byte, 260> <- uninit
        got : U32 = c_get_full_path_name(cpath, MAX_PATH, resolved.to<@Byte>(), null)
        c_free(cpath)
        branch got.eq(0).bitor(got.ge(MAX_PATH))
            ? return(no_result())
            : continue
        branch must_exist
            ? continue
            : return(dup_result(resolved.to<@Byte>()))
        branch c_get_file_attributes(resolved.to<@Byte>()).eq(INVALID_FILE_ATTRIBUTES)
            ? return(no_result())
            : return(dup_result(resolved.to<@Byte>()))

#[export("rf_fs_absolute_path"), target(os: "windows")]
routine rf_fs_absolute_path(path: @Byte, len: S32) -> @Byte
    block entry():
        return(full_path(path, len, false))

#[export("rf_fs_canonical_path"), target(os: "windows")]
routine rf_fs_canonical_path(path: @Byte, len: S32) -> @Byte
    block entry():
        return(full_path(path, len, true))

// -- memory-mapped files ---------------------------------------------------------------

/// Half the physical memory: a mapping up to this size is prefetched whole; a bigger one would evict the pages it
/// just read, so it pages in on demand. 0 when it can't be told (no prefetch).
#target(os: "windows")
routine prefault_budget() -> U64
    block entry():
        claim ms : @MemoryStatus <- uninit
        ms.length.store(sizeof<MemoryStatus>().to<U32>())
        branch c_global_memory_status_ex(ms).ne(0)
            ? return(ms.total_phys.load().div(2))
            : return(0)

/// Opens path with access and share, or an invalid handle.
#target(os: "windows")
routine open_for_map(path: @Byte, len: S32, write: Bool) -> Addr
    block entry():
        cpath : @Byte = strdupn(path, len)
        branch cpath.is_null()
            ? return(inttoptr<U64, Addr>(U64.MAX))
            : continue
        access : U32  = write ? GENERIC_READ.bitor(GENERIC_WRITE) : GENERIC_READ
        share  : U32  = write ? FILE_SHARE_READ.bitor(FILE_SHARE_WRITE) : FILE_SHARE_READ
        flags  : U32  = write ? FILE_ATTRIBUTE_NORMAL : FILE_FLAG_SEQUENTIAL_SCAN
        h      : Addr = c_create_file_a(cpath, access, share, null, OPEN_EXISTING, flags, null)
        c_free(cpath)
        return(h)

/// Maps [offset, offset + length) of the open file (length 0: all of it) and closes the file: the view, or null.
#target(os: "windows")
routine map_view(h: Addr, write: Bool, aligned: U64, length: USize) -> Addr
    block entry():
        protect : U32  = write ? PAGE_READWRITE : PAGE_READONLY
        mapping : Addr = c_create_file_mapping(h, null, protect, 0, 0, null)
        branch mapping.is_null()
            ? failed(h)
            : continue
        access : U32  = write ? FILE_MAP_WRITE : FILE_MAP_READ
        view   : Addr = c_map_view_of_file(mapping, access, aligned.shr(32).to_wrap<U32>(),
                aligned.to_wrap<U32>(), length)
        c_close_handle(mapping)
        c_close_handle(h)
        return(view)

    block failed(h: Addr):
        c_close_handle(h)
        return(null)

/// A whole file mapped: the view (its length as the result), the empty-map marker for an empty file, or null.
#target(os: "windows")
routine map_whole(path: @Byte, len: S32, write: Bool) -> @Byte
    block entry():
        h : Addr = open_for_map(path, len, write)
        branch invalid_handle(h)
            ? return(no_result())
            : continue
        claim size : @S64 <- 0
        branch c_get_file_size_ex(h, size).ne(0)
            ? continue
            : closed(h)
        n : U64 = size.load().to<U64>()
        branch n.eq(0)
            ? empty(h)
            : continue
        view : Addr = map_view(h, write, 0, 0)
        branch view.is_null()
            ? return(no_result())
            : continue
        branch write.bitor(n.gt(prefault_budget()))
            ? mapped(view, n)
            : continue
        claim range : @MemoryRange <- MemoryRange { address: view, size: n.to<USize>() }
        c_prefetch_virtual_memory(c_get_current_process(), 1, range, 0)
        jump mapped(view, n)

    block mapped(view: Addr, n: U64):
        return(result(view.to<@Byte>(), n.to<USize>()))

    block closed(h: Addr):
        c_close_handle(h)
        return(no_result())

    block empty(h: Addr):
        c_close_handle(h)
        RESULT_LEN.store(0)
        return(empty_map())

/// A window [offset, offset + length) of a file, clamped to its end and aligned down to the allocation
/// granularity: the base (MAP_DELTA from it to offset, the clamped length as the result), the empty-map marker for
/// an empty window, or null.
#target(os: "windows")
routine map_window(path: @Byte, len: S32, offset: USize, length: USize, write: Bool) -> @Byte
    block entry():
        MAP_DELTA.store(0)
        claim info : @SystemInfo <- uninit
        c_get_system_info(info)
        gran    : USize = info.granularity.load().to<USize>()
        aligned : USize = offset.sub(offset.mod(gran))
        delta   : USize = offset.sub(aligned)
        h       : Addr  = open_for_map(path, len, write)
        branch invalid_handle(h)
            ? return(no_result())
            : continue
        claim size : @S64 <- 0
        branch c_get_file_size_ex(h, size).ne(0)
            ? continue
            : closed(h)
        filesize : USize = size.load().to<USize>()
        branch offset.ge(filesize)
            ? empty(h)
            : continue
        want : USize = length.min(filesize.sub(offset))
        branch want.eq(0)
            ? empty(h)
            : continue
        view : Addr = map_view(h, write, aligned.to<U64>(), want.add(delta))
        branch view.is_null()
            ? return(no_result())
            : continue
        MAP_DELTA.store(delta)
        return(result(view.to<@Byte>(), want))

    block closed(h: Addr):
        c_close_handle(h)
        return(no_result())

    block empty(h: Addr):
        c_close_handle(h)
        RESULT_LEN.store(0)
        return(empty_map())

#[export("rf_file_map_path"), target(os: "windows")]
routine rf_file_map_path(path: @Byte, path_len: S32) -> @Byte
    block entry():
        return(map_whole(path, path_len, false))

#[export("rf_file_map_path_rw"), target(os: "windows")]
routine rf_file_map_path_rw(path: @Byte, path_len: S32) -> @Byte
    block entry():
        return(map_whole(path, path_len, true))

#[export("rf_file_map_path_range"), target(os: "windows")]
routine rf_file_map_path_range(path: @Byte, path_len: S32, offset: USize, length: USize) -> @Byte
    block entry():
        return(map_window(path, path_len, offset, length, false))

#[export("rf_file_map_path_range_rw"), target(os: "windows")]
routine rf_file_map_path_range_rw(path: @Byte, path_len: S32, offset: USize, length: USize) -> @Byte
    block entry():
        return(map_window(path, path_len, offset, length, true))

/// Writes dirty pages back, then releases the view. A null view or length 0 (the empty marker) does nothing.
#[export("rf_file_unmap"), target(os: "windows")]
routine rf_file_unmap(ptr: @Byte, len: USize) -> Void
    block entry():
        branch ptr.is_null().bitor(len.eq(0))
            ? return()
            : continue
        c_flush_view_of_file(ptr, 0)
        c_unmap_view_of_file(ptr)
        return()

#[export("rf_file_map_flush"), target(os: "windows")]
routine rf_file_map_flush(ptr: @Byte, len: USize) -> Void
    block entry():
        branch ptr.is_null().bitor(len.eq(0))
            ? return()
            : continue
        c_flush_view_of_file(ptr, 0)
        return()

/// Makes the file exactly size bytes, creating, extending (zeros) or truncating it: 0, or -1.
#[export("rf_fs_set_size"), target(os: "windows")]
routine rf_fs_set_size(path: @Byte, path_len: S32, size: USize) -> S32
    block entry():
        cpath : @Byte = strdupn(path, path_len)
        branch cpath.is_null()
            ? return(-1)
            : continue
        h : Addr = c_create_file_a(cpath, GENERIC_WRITE, FILE_SHARE_READ, null, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL,
                null)
        c_free(cpath)
        branch invalid_handle(h)
            ? return(-1)
            : continue
        // FILE_BEGIN; the end is set only where the pointer went
        branch c_set_file_pointer_ex(h, size.to<S64>(), null, 0).ne(0)
            ? continue
            : done(h, false)
        jump done(h, c_set_end_of_file(h).ne(0))

    block done(h: Addr, ok: Bool):
        c_close_handle(h)
        branch ok
            ? return(0)
            : return(-1)
