// RazorForge's coroutine scheduler: one process-wide pool of worker threads (one per processor, or RF_WORKERS)
// that resume ready coroutines, fire timers, and wait when idle.
//
// Each worker has a deque of its own: it pushes and pops at the bottom (the freshest coroutine runs next) and other
// workers steal from the top. A coroutine made ready off the pool (the main thread, a threaded task, an I/O thread)
// goes in the shared injector instead. A deque lock is taken only with the scheduler lock held or with no lock, and
// never two deque locks at once.
//
// A coroutine's sched_state is the park/wake state machine that keeps a wake racing a park from resuming it twice:
//   IDLE      parked (on a timer or waiting for a wake) or new, in no queue, not running
//   QUEUED    in a deque or the injector
//   RUNNING   a worker took it and runs it
//   NOTIFIED  a wake came while it ran: its worker queues it again when it parks, whatever it parked for
//   DONE      completed, and a stray wake is dropped
// A park primitive running inside the coroutine only records its intent and switches out. The worker applies it
// afterwards, under the scheduler lock, where a NOTIFIED wins.
//
// The run loop also tells a deadlock from a wait: with every worker idle, live coroutines, nobody blocked on one
// of them in retrieve!/race!, and no wake promised from another thread, nothing can ever run again, and after a
// short grace that confirms it the program stops with a DeadlockError.

module Ingrid/Runtime

import Standard/Alloc
import Standard/Fiber
import Standard/Os

/// The scheduler driving this thread, or null.
@threadlocal
global CURRENT_SCHED: @@Sched
/// This thread's pool worker index, or -1.
@threadlocal
global WORKER_ID: @SSize <- -1
/// This worker's xorshift state for picking a steal victim.
@threadlocal
global STEAL_RNG: @U32

/// This thread's start_here() scheduler, made on first use and driven by this thread whenever it waits.
@threadlocal
global HERE_SCHED: @@Sched

/// The process pool: 0 none, 1 being made, 2 made.
global POOL_STATE: @U32
global POOL: @@Sched

preset SCHED_IDLE:     U32 = 0
preset SCHED_QUEUED:   U32 = 1
preset SCHED_RUNNING:  U32 = 2
preset SCHED_NOTIFIED: U32 = 3
preset SCHED_DONE:     U32 = 4
preset PARK_NONE:     U32 = 0
preset PARK_TIMER:    U32 = 1  // into the timer heap at wake_ns
preset PARK_EXTERNAL: U32 = 2  // in no list: only a wake queues it
preset PARK_YIELD:    U32 = 3  // queued again at once, behind the others

/// The all-idle condition must hold this many times in a row, each after a grace wait, before it is a deadlock.
preset DEADLOCK_CONFIRMS: U64 = 3

preset DEADLOCK_GRACE_NS: U64 = 2000000
preset WORKERS_MAX: U64 = 4096

/// A worker's run deque: a ring of coroutines, its capacity a power of two.
record Deque
    buf: @@Coro
    cap: USize
    bottom: USize  // the next free slot at the owner's end
    top: USize  // the oldest coroutine, at the thieves' end
    lock: ExclusiveLock

/// rf_sched.
record Sched
    injector_head: @Coro
    injector_tail: @Coro
    timer_heap: @@Coro  // a min-heap by wake_ns
    timer_count: SSize
    timer_cap: SSize
    live: SSize  // spawned and not completed
    cross_wakers: SSize  // wakes another thread has promised
    waiters: SSize  // retrieve!/race! callers blocked on a coroutine
    workers_total: SSize
    workers_idle: SSize
    deadlock_confirm: U64
    deques: @Deque  // one per pool worker, or null for a scheduler driven directly
    lock: ExclusiveLock
    cond: SignalCaster  // idle workers wait here
    block_cond: SignalCaster  // top-level retrieve!/race! callers wait here

/// Makes a `Deque` from its fields.
/// :param buf: Its `buf`.
/// :param cap: Its `cap`.
/// :param bottom: Its `bottom`.
/// :param top: Its `top`.
/// :param lock: Its `lock`.
/// :returns: The new value.
routine Deque.construct(buf: @@Coro, cap: USize, bottom: USize, top: USize,
    lock: ExclusiveLock) -> Me
    return Me(buf, cap, bottom, top, lock)

/// Releases nothing: a `Deque` holds no memory of its own.
routine Deque.destruct(me: @Me) -> None
    return

/// Makes a `Sched` from its fields.
/// :param injector_head: Its `injector_head`.
/// :param injector_tail: Its `injector_tail`.
/// :param timer_heap: Its `timer_heap`.
/// :param timer_count: Its `timer_count`.
/// :param timer_cap: Its `timer_cap`.
/// :param live: Its `live`.
/// :param cross_wakers: Its `cross_wakers`.
/// :param waiters: Its `waiters`.
/// :param workers_total: Its `workers_total`.
/// :param workers_idle: Its `workers_idle`.
/// :param deadlock_confirm: Its `deadlock_confirm`.
/// :param deques: Its `deques`.
/// :param lock: Its `lock`.
/// :param cond: Its `cond`.
/// :param block_cond: Its `block_cond`.
/// :returns: The new value.
routine Sched.construct(injector_head: @Coro, injector_tail: @Coro, timer_heap: @@Coro,
    timer_count: SSize, timer_cap: SSize, live: SSize, cross_wakers: SSize, waiters: SSize,
    workers_total: SSize, workers_idle: SSize, deadlock_confirm: U64, deques: @Deque,
    lock: ExclusiveLock, cond: SignalCaster, block_cond: SignalCaster) -> Me
    return Me(injector_head, injector_tail, timer_heap, timer_count, timer_cap, live, cross_wakers, waiters, workers_total, workers_idle, deadlock_confirm, deques, lock, cond, block_cond)

/// Releases nothing: a `Sched` holds no memory of its own.
routine Sched.destruct(me: @Me) -> None
    return

/// The scheduler driving this thread.
/// :returns: The scheduler, or null.
@noinline
routine current_sched() -> @Sched
    s: @Sched = CURRENT_SCHED.peek()
    return s

/// This thread's pool worker index.
/// :returns: The index, or -1 off the pool.
@noinline
routine worker_id() -> SSize
    id: SSize = WORKER_ID.peek()
    return id

// -- deques --------------------------------------------------------------------------

/// Makes an empty deque with room for 64 coroutines.
/// :throws: Crashes with `OutOfMemoryError` when the ring can't be allocated.
routine Deque.init(me: @Me) -> None
    me.cap.poke(64)
    me.buf.poke(zeroed[@Coro](count: 64, what: "Failed to allocate worker run deque"))
    me.bottom.poke(0)
    me.top.poke(0)
    me.lock.poke(ExclusiveLock.construct())
    return

/// The ring slot for position `i`, wrapped by the capacity.
/// :param i: The position.
/// :returns: The slot.
routine Deque.slot(me: @Me, i: USize) -> @@Coro
    mask: USize = me.cap.peek() - 1
    return me.buf.peek().stride(i & mask)

/// Pushes `c` at the owner's end. Grows the ring (twice the capacity) when it is full.
/// :param c: The coroutine.
/// :throws: Crashes with `OutOfMemoryError` when the ring can't grow.
routine Deque.push_bottom(me: @Me, c: @Coro) -> None
    me.lock.lock()
    used: USize = me.bottom.peek() - me.top.peek()
    if used == me.cap.peek()
        jump grow()
    else
        jump put()

    block grow()
        n: USize = me.cap.peek()
        jump copy(n, zeroed[@Coro](count: n * 2, what: "Failed to grow worker run deque"), 0)

    block copy(n: USize, nb: @@Coro, i: USize)
        if i == n
            jump install(n, nb)
        nb.stride(i).poke(me.slot(me.top.peek() + i).peek())
        jump copy(n, nb, i + 1)

    block install(n: USize, nb: @@Coro)
        c_free(me.buf.peek())
        me.buf.poke(nb)
        me.cap.poke(n * 2)
        me.top.poke(0)
        me.bottom.poke(n)
        jump put()

    block put()
        me.slot(me.bottom.peek()).poke(c)
        next_bottom: USize = me.bottom.peek() + 1
        next_bottom.poke_into(me.bottom)
        me.lock.unlock()
        return

/// Pops at the owner's end: the coroutine pushed last, or null.
/// :returns: The coroutine, or null when the deque is empty.
routine Deque.pop_bottom(me: @Me) -> @Coro
    me.lock.lock()
    empty: Bool = me.bottom.peek() == me.top.peek()
    taken: @Coro = when
        empty => null
        else =>
            b: USize = me.bottom.peek() - 1
            me.bottom.poke(b)
            slot: @@Coro = me.slot(b)
            c: @Coro = slot.peek()
            slot.poke(null)
            becomes c
    me.lock.unlock()
    return taken

/// Takes from the thieves' end: the oldest coroutine, or null.
/// :returns: The coroutine, or null when the deque is empty.
routine Deque.steal_top(me: @Me) -> @Coro
    me.lock.lock()
    empty: Bool = me.bottom.peek() == me.top.peek()
    taken: @Coro = when
        empty => null
        else =>
            t: USize = me.top.peek()
            slot: @@Coro = me.slot(t)
            c: @Coro = slot.peek()
            slot.poke(null)
            me.top.poke(t + 1)
            becomes c
    me.lock.unlock()
    return taken

/// Takes c out if it is there, closing the gap: whether it was.
/// :param c: The coroutine.
/// :returns: True when it was in the deque.
routine Deque.remove(me: @Me, c: @Coro) -> Bool
    me.lock.lock()
    jump look(me.bottom.peek() - me.top.peek(), 0)

    block look(n: USize, i: USize)
        if i == n
            jump finish(false)
        top: USize = me.top.peek()
        occupant: @Coro = me.slot(top + i).peek()
        if occupant.ptr_eq(c)
            jump shift(n, i)
        else
            jump look(n, i + 1)

    block shift(n: USize, j: USize)
        top: USize = me.top.peek()
        if j + 1 >= n
            jump dropped()
        me.slot(top + j).poke(me.slot(top + j + 1).peek())
        jump shift(n, j + 1)

    block dropped()
        b: USize = me.bottom.peek() - 1
        me.bottom.poke(b)
        me.slot(b).poke(null)
        jump finish(true)

    block finish(found: Bool)
        me.lock.unlock()
        return found

// -- the injector and the ready routing (callers hold the scheduler lock) ------------

/// Appends `c`, now QUEUED, to the injector. The caller holds the scheduler lock.
/// :param c: The coroutine.
routine Sched.push_injector(me: @Me, c: @Coro) -> None
    c.sched_next.poke(null)
    c.sched_state.poke_atomic(SCHED_QUEUED)
    tail: @Coro = me.injector_tail.peek()
    if tail.is_null()
        me.injector_head.poke(c)
        me.injector_tail.poke(c)
        return
    else
        tail.sched_next.poke(c)
        me.injector_tail.poke(c)
        return

/// The injector's head, now RUNNING, or null. The caller holds the scheduler lock.
/// :returns: The coroutine, or null when the injector is empty.
routine Sched.pop_injector(me: @Me) -> @Coro
    local c: @Coro = me.injector_head.peek()

    if c.is_null()
        return null
    next: @Coro = c.sched_next.peek()
    me.injector_head.poke(next)
    if next.is_null()
        me.injector_tail.poke(null)
    c.sched_next.poke(null)
    c.sched_state.poke_atomic(SCHED_RUNNING)
    return c

/// A runnable coroutine goes, QUEUED, to this worker's deque if a pool worker made it ready, else to the injector.
/// :param c: The coroutine.
/// :throws: Crashes with `OutOfMemoryError` when the worker's deque can't grow.
routine Sched.enqueue_ready(me: @Me, c: @Coro) -> None
    local id: SSize = worker_id()
    local deques: @Deque = me.deques.peek()

    if id >= 0 and deques.is_not_null()
        c.sched_state.poke_atomic(SCHED_QUEUED)
        deques.stride(id).push_bottom(c)
        return
    else
        me.push_injector(c)
        return

// -- the timer heap (callers hold the scheduler lock) --------------------------------

/// The coroutine at position `i` of the timer heap.
/// :param i: The position.
/// :returns: The coroutine.
routine Sched.timer_at(me: @Me, i: SSize) -> @Coro
    slot: @@Coro = me.timer_heap.peek().stride(i)
    return slot.peek()

/// Puts `c` at position `i` of the timer heap and records the position in it.
/// :param i: The position.
/// :param c: The coroutine.
routine Sched.timer_put(me: @Me, i: SSize, c: @Coro) -> None
    slot: @@Coro = me.timer_heap.peek().stride(i)
    slot.poke(c)
    c.timer_idx.poke(i)
    return

/// Swaps two positions of the timer heap.
/// :param i: The first position.
/// :param j: The second position.
routine Sched.timer_swap(me: @Me, i: SSize, j: SSize) -> None
    a: @Coro = me.timer_at(i)
    b: @Coro = me.timer_at(j)
    me.timer_put(i, c: b)
    me.timer_put(i: j, c: a)
    return

/// Moves the coroutine at `i` up the timer heap while it wakes earlier than its parent.
/// :param i: The position.
routine Sched.timer_sift_up(me: @Me, i: SSize) -> None
    if i <= 0
        return
    parent: SSize = (i - 1) / 2
    parent_wake: U64 = me.timer_at(parent).wake_ns.peek()
    if parent_wake <= me.timer_at(i).wake_ns.peek()
        return
    me.timer_swap(i, j: parent)
    me.timer_sift_up(parent)
    return

/// Moves the coroutine at `i` down the timer heap while a child wakes earlier.
/// :param i: The position.
routine Sched.timer_sift_down(me: @Me, i: SSize) -> None
    local n: SSize = me.timer_count.peek()
    local l: SSize = i * 2 + 1
    local r: SSize = l + 1

    m: SSize = when
        not (l < n) => i
        else =>
            left_wake: U64 = me.timer_at(l).wake_ns.peek()
            if left_wake < me.timer_at(i).wake_ns.peek()
                becomes l
            else
                becomes i
    m2: SSize = when
        not (r < n) => m
        else =>
            right_wake: U64 = me.timer_at(r).wake_ns.peek()
            if right_wake < me.timer_at(m).wake_ns.peek()
                becomes r
            else
                becomes m
    if m2 == i
        return
    me.timer_swap(i, j: m2)
    me.timer_sift_down(m2)
    return

/// Adds `c` to the timer heap by its `wake_ns`, doubling the heap (from 16) when it is full.
/// :param c: The coroutine.
/// :throws: Crashes with `OutOfMemoryError` when the heap can't grow.
routine Sched.insert_timer(me: @Me, c: @Coro) -> None
    if me.timer_count.peek() == me.timer_cap.peek()
        cap: SSize = me.timer_cap.peek()
        ncap: SSize = when
            cap == 0 => 16
            else => cap * 2
        heap: Addr = c_realloc(me.timer_heap.peek(), ncap.to[USize]() * sizeof[@Coro]())
        if heap.is_null()
            rf_throw(error_type: "OutOfMemoryError", message: "Failed to grow scheduler timer heap")
        me.timer_heap.poke(heap.to[@@Coro]())
        me.timer_cap.poke(ncap)
    i: SSize = me.timer_count.peek()
    me.timer_count.poke(i + 1)
    me.timer_put(i, c)
    me.timer_sift_up(i)
    return

/// The earliest coroutine, taken off the heap, or null.
/// :returns: The coroutine, or null when no timer is pending.
routine Sched.timer_pop_min(me: @Me) -> @Coro
    if me.timer_count.peek() == 0
        return null
    top: @Coro = me.timer_at(0)
    top.timer_idx.poke(-1)
    last: SSize = me.timer_count.peek() - 1
    me.timer_count.poke(last)
    if last > 0
        me.timer_put(i: 0, c: me.timer_at(last))
        vacated: @@Coro = me.timer_heap.peek().stride(last)
        vacated.poke(null)
        me.timer_sift_down(0)
        return top
    else
        me.timer_heap.peek().poke(null)
        return top

/// Takes c off the heap if it is on it: a deadline park woken by something other than its timer.
/// :param c: The coroutine.
routine Sched.unlink_timer(me: @Me, c: @Coro) -> None
    i: SSize = c.timer_idx.peek()
    if i < 0 or i >= me.timer_count.peek()
        return
    if not me.timer_at(i).ptr_eq(c)
        return
    c.timer_idx.poke(-1)
    last: SSize = me.timer_count.peek() - 1
    me.timer_count.poke(last)
    if i == last
        vacated: @@Coro = me.timer_heap.peek().stride(last)
        vacated.poke(null)
        return
    else
        moved: @Coro = me.timer_at(last)
        me.timer_put(i, c: moved)
        vacated: @@Coro = me.timer_heap.peek().stride(last)
        vacated.poke(null)
        me.timer_sift_up(i)
        if not (moved.timer_idx.peek() == i)
            return
        me.timer_sift_down(i)
        return

// -- making a coroutine ready ---------------------------------------------------------

/// Every wake goes through here, under the scheduler lock: IDLE is queued (off the timers first), RUNNING becomes
/// NOTIFIED, and QUEUED, NOTIFIED and DONE stay as they are. A null `me` or `c` does nothing.
/// :param c: The coroutine to wake.
/// :throws: Crashes with `OutOfMemoryError` when the worker's deque can't grow.
routine Sched.make_ready(me: @Me, c: @Coro) -> None
    if me.is_null() or c.is_null()
        return
    state: U32 = c.sched_state.peek_atomic()
    when
        state == SCHED_IDLE =>
            me.unlink_timer(c)
            me.enqueue_ready(c)
            me.deadlock_confirm.poke(0)
            return
        state == SCHED_RUNNING =>
            c.sched_state.poke_atomic(SCHED_NOTIFIED)
            me.deadlock_confirm.poke(0)
            return
        else => return

/// Creates a scheduler driven directly (no pool deques), with one worker.
/// :returns: The new scheduler.
/// :throws: Crashes with `OutOfMemoryError` when the allocation fails.
@export("rf_sched_create")
routine rf_sched_create() -> @Sched
    s: @Sched = zeroed[Sched](count: 1, what: "Failed to allocate coroutine scheduler")
    s.workers_total.poke(1)
    return s

/// Frees a scheduler and its timer heap. A null `s` does nothing.
/// :param s: The scheduler.
@export("rf_sched_destroy")
routine rf_sched_destroy(s: @Sched) -> None
    if s.is_null()
        return
    c_free(s.timer_heap.peek())
    c_free(s)
    return

/// Queues a new coroutine. A second spawn of the same one does nothing (a set race!/gather launched may be
/// retrieved after). A null `s` or `c` does nothing.
/// :param s: The scheduler.
/// :param c: The coroutine.
@export("rf_sched_spawn")
routine rf_sched_spawn(s: @Sched, c: @Coro) -> None
    if s.is_null() or c.is_null()
        return
    s.spawn(c)
    return

/// rf_sched_spawn on a scheduler and a coroutine that are both there, under the scheduler's lock.
/// :param c: The coroutine.
routine Sched.spawn(me: @Me, c: @Coro) -> None
    me.lock.lock()
    if not c.initial_spawned.peek()
        c.initial_spawned.poke(true)
        c.home.poke(me)
        me.enqueue_ready(c)
        next_live: SSize = me.live.peek() + 1
        next_live.poke_into(me.live)
        me.cond.cast_one()
    me.lock.unlock()
    return

/// Parks the running coroutine until delay_ns from now. The worker puts it on the timer heap once it is off its
/// stack. Outside a scheduler-driven coroutine it does nothing.
/// :param delay_ns: How long to park, in nanoseconds.
@export("rf_sched_park_timer")
routine rf_sched_park_timer(delay_ns: U64) -> None
    this_coro: @Coro = current_coro()
    if current_sched().is_null() or this_coro.is_null()
        return
    this_coro.wake_ns.poke(monotonic_ns() +^ delay_ns)
    this_coro.park_intent.poke(PARK_TIMER)
    coro_switch_out()
    return

/// rf_sched_park_timer that a wake can also end first: a wake on an IDLE coroutine takes it off the timer heap.
/// :param delay_ns: The longest park, in nanoseconds.
@export("rf_sched_park_deadline")
routine rf_sched_park_deadline(delay_ns: U64) -> None
    rf_sched_park_timer(delay_ns)
    return

/// Parks the running coroutine until rf_sched_wake. A wake that comes first finds it RUNNING and isn't lost.
@export("rf_sched_park_external")
routine rf_sched_park_external() -> None
    this_coro: @Coro = current_coro()
    if current_sched().is_null() or this_coro.is_null()
        return
    this_coro.park_intent.poke(PARK_EXTERNAL)
    coro_switch_out()
    return

/// Lets the other ready coroutines run first, then goes on. Outside a scheduler it switches back to the resumer.
@export("rf_coro_yield")
routine rf_coro_yield() -> None
    this_coro: @Coro = current_coro()
    if this_coro.is_null()
        return
    if not current_sched().is_null()
        this_coro.park_intent.poke(PARK_YIELD)
    coro_switch_out()
    return

/// Makes a parked coroutine runnable, from any thread, and wakes an idle worker when it was parked. A null `s` or `c`
/// does nothing.
/// :param s: The coroutine's scheduler.
/// :param c: The coroutine.
@export("rf_sched_wake")
routine rf_sched_wake(s: @Sched, c: @Coro) -> None
    if s.is_null() or c.is_null()
        return
    s.lock.lock()
    before: U32 = c.sched_state.peek_atomic()
    s.make_ready(c)
    if before == SCHED_IDLE
        s.cond.cast_one()
    s.lock.unlock()
    return

/// A wake another thread has promised (a threaded task, an I/O call, a cast, a race! competitor): while one is
/// outstanding, all-parked isn't a deadlock. A null `s` does nothing.
/// :param s: The scheduler.
@export("rf_sched_arm_cross_waker")
routine rf_sched_arm_cross_waker(s: @Sched) -> None
    if s.is_null()
        return
    s.lock.lock()
    next_cross_wakers: SSize = s.cross_wakers.peek() + 1
    next_cross_wakers.poke_into(s.cross_wakers)
    s.lock.unlock()
    return

/// Withdraws one wake another thread had promised, never below 0. A null `s` does nothing.
/// :param s: The scheduler.
@export("rf_sched_disarm_cross_waker")
routine rf_sched_disarm_cross_waker(s: @Sched) -> None
    if s.is_null()
        return
    s.lock.lock()
    n: SSize = s.cross_wakers.peek()
    if n > 0
        s.cross_wakers.poke(n - 1)
    s.lock.unlock()
    return

// -- the workers ---------------------------------------------------------------------

/// The next number of this worker's xorshift generator, seeded from its index on first use.
/// :returns: A nonzero pseudo-random number.
@noinline
routine steal_rand() -> U32
    x: U32 = STEAL_RNG.peek()
    none: Bool = x == 0
    x2: U32 = when
        none =>
            worker_ordinal: SSize = worker_id() + 1
            s: U32 = worker_ordinal.to_wrap[U32]() *% 2654435761
            if s == 0
                becomes 0x9E3779B9
            else
                becomes s
        else => x
    a: U32 = x2 ^ (x2 << 13)
    b: U32 = a ^ (a >> 17)
    c: U32 = b ^ (b << 5)
    STEAL_RNG.poke(c)
    return c

/// A coroutine stolen from another worker's deque (now RUNNING), or null. The victims are tried in turn from a
/// random one.
/// :returns: The coroutine, or null when there is nothing to steal.
routine Sched.try_steal(me: @Me) -> @Coro
    local n: SSize = me.workers_total.peek()

    if me.deques.peek().is_null() or n <= 1
        return null

    r: U32 = steal_rand()

    each i in 0 til n
        offset: U64 = r.to[U64]() + i.to[U64]()
        v: SSize = (offset % n.to[U64]()).to[SSize]()
        if v == worker_id()
            continue
        else
            victim: @Deque = me.deques.peek().stride(v)
            c: @Coro = victim.steal_top()
            if c.is_null()
                continue
            else
                c.sched_state.poke_atomic(SCHED_RUNNING)
                return c
    then
        return null

/// Runs a coroutine this worker took (RUNNING), with no lock held, then applies how it stopped.
/// :param c: The coroutine.
/// :throws: Crashes with `OutOfMemoryError` when a deque or the timer heap can't grow.
routine Sched.run_coro(me: @Me, c: @Coro) -> None
    st: U32 = rf_coro_resume(c)
    if st == CORO_COMPLETED
        me.lock.lock()
        c.sched_state.poke_atomic(SCHED_DONE)
        if not c.counted_done.peek()
            c.counted_done.poke(true)
            remaining_live: SSize = me.live.peek() - 1
            remaining_live.poke_into(me.live)
        // Whoever waits for this coroutine goes on. A top-level waiter re-checks on block_cond. A waiter spawned on
        // another scheduler is woken there, after this lock is released, so it never moves to this scheduler.
        w: @Coro = c.awaiter.peek()
        away: @Coro = when
            w.is_null() => null
            else =>
                c.awaiter.poke(null)
                home: @Me = w.home.peek()
                if not (home.is_null() | home.ptr_eq(me))
                    becomes w
                else
                    me.make_ready(w)
                    becomes null
        free_now: Bool = c.owner_released.peek() | c.detached.peek()
        me.cond.cast_one()
        me.block_cond.cast_all()
        me.lock.unlock()
        if not away.is_null()
            rf_sched_wake(s: away.home.peek(), c: away)
        if not free_now
            return
        rf_coro_delete(c)
        return
    else
        // A NOTIFIED wake or a yield goes back on this worker's own deque without the scheduler lock: make_ready
        // leaves a NOTIFIED or QUEUED coroutine alone, and a yielding one is nobody's awaiter.
        intent: U32 = c.park_intent.peek()
        c.park_intent.poke(PARK_NONE)
        notified: Bool = c.sched_state.peek_atomic() == SCHED_NOTIFIED
        id: SSize = worker_id()
        deques: @Deque = me.deques.peek()
        has_deque: Bool = id >= 0 and deques.is_not_null()
        if has_deque and (notified or intent == PARK_YIELD)
            c.sched_state.poke_atomic(SCHED_QUEUED)
            deques.stride(id).push_bottom(c)
            return
        else
            me.lock.lock()
            when
                c.sched_state.peek_atomic() == SCHED_NOTIFIED =>
                    me.enqueue_ready(c)
                    me.lock.unlock()
                    return
                intent == PARK_TIMER =>
                    me.insert_timer(c)
                    c.sched_state.poke_atomic(SCHED_IDLE)
                    me.lock.unlock()
                    return
                intent == PARK_YIELD =>
                    me.enqueue_ready(c)
                    me.lock.unlock()
                    return
                else =>
                    c.sched_state.poke_atomic(SCHED_IDLE)
                    me.lock.unlock()
                    return

    block unlock()
        me.lock.unlock()
        return

/// One runnable coroutine (now RUNNING), or null: this worker's deque, then the injector, then a steal.
/// :returns: The coroutine, or null.
routine Sched.claim_work(me: @Me) -> @Coro
    id: SSize = worker_id()
    deques: @Deque = me.deques.peek()
    if id >= 0 and deques.is_not_null()
        c: @Coro = deques.stride(id).pop_bottom()
        if not c.is_null()
            c.sched_state.poke_atomic(SCHED_RUNNING)
            return c
    me.lock.lock()
    c: @Coro = me.pop_injector()
    me.lock.unlock()
    if c.is_null()
        return me.try_steal()
    else
        return c

/// Runs one ready coroutine (true), or waits until something may be ready (false). Called with no lock held. Due
/// timers are moved to the injector while waiting.
/// :returns: True when a coroutine ran.
/// :throws: Crashes with `DeadlockError` when every worker is idle, coroutines are awaited, and no wake can come,
///     confirmed `DEADLOCK_CONFIRMS` times in a row.
routine Sched.step(me: @Me) -> Bool
    local c: @Coro = me.claim_work()

    if c.is_null()
        // Every source again under the lock: an enqueue signals the cond under the same lock, so none is lost.
        me.lock.lock()
        id: SSize = worker_id()
        deques: @Deque = me.deques.peek()
        if id >= 0 and deques.is_not_null()
            mine: @Coro = deques.stride(id).pop_bottom()
            if not mine.is_null()
                mine.sched_state.poke_atomic(SCHED_RUNNING)
                me.lock.unlock()
                me.run_coro(mine)
                return true
        found_coro: @Coro = me.pop_injector()
        if found_coro.is_null()
            found_coro2: @Coro = me.try_steal()
            if found_coro2.is_null()
                if me.timer_count.peek() > 0
                    // A timer pending is progress waiting to happen, never a deadlock: wait out the earliest one.
                    now: U64 = monotonic_ns()
                    deadline: U64 = me.timer_at(0).wake_ns.peek()
                    if deadline > now
                        more_idle: SSize = me.workers_idle.peek() + 1
                        more_idle.poke_into(me.workers_idle)
                        me.cond.wait_until(mutex: me.lock, deadline_ns: deadline)
                        fewer_idle: SSize = me.workers_idle.peek() - 1
                        fewer_idle.poke_into(me.workers_idle)

                    now2: U64 = monotonic_ns()

                    while me.timer_count.peek() > 0
                        earliest_wake: U64 = me.timer_at(0).wake_ns.peek()
                        if not (earliest_wake <= now2)
                            // Nothing ready, no timer: only a wake from another thread can help. Without one promised, with someone
                            // waiting for a coroutine and every other worker idle, it is a deadlock once it persists.
                            me.lock.unlock()
                            return false
                        else
                            me.push_injector(me.timer_pop_min())
                            continue
                    then
                        me.lock.unlock()
                        return false
                else
                    has_live: Bool = me.live.peek() > 0
                    pending: Bool = has_live and me.cross_wakers.peek() == 0
                    awaited: Bool = me.waiters.peek() > 0
                    idle_with_me: SSize = me.workers_idle.peek() + 1
                    last: Bool = idle_with_me == me.workers_total.peek()
                    if pending and awaited and last
                        confirm: U64 = me.deadlock_confirm.peek() + 1
                        me.deadlock_confirm.poke(confirm)
                        if confirm >= DEADLOCK_CONFIRMS
                            me.lock.unlock()
                            rf_throw(error_type: "DeadlockError", message: "all coroutines are parked and none is runnable — no send, receive, or wake can ever make progress (deadlock). If coroutines communicate (a channel, a SignalCaster), they must all be LAUNCHED before you wait on one: retrieving a consumer before its producer is started parks it forever. Start background feeders with `.start_now()` and await the rest with `.retrieve()`/`.gather()`.")
                        else
                            more_idle: SSize = me.workers_idle.peek() + 1
                            more_idle.poke_into(me.workers_idle)
                            me.cond.wait_for(mutex: me.lock, timeout_ns: DEADLOCK_GRACE_NS)
                            fewer_idle: SSize = me.workers_idle.peek() - 1
                            fewer_idle.poke_into(me.workers_idle)
                            me.lock.unlock()
                            return false
                    else
                        more_idle: SSize = me.workers_idle.peek() + 1
                        more_idle.poke_into(me.workers_idle)
                        me.cond.wait(me.lock)
                        fewer_idle: SSize = me.workers_idle.peek() - 1
                        fewer_idle.poke_into(me.workers_idle)
                        me.lock.unlock()
                        return false
            else
                me.lock.unlock()
                me.run_coro(found_coro2)
                return true
        else
            me.lock.unlock()
            me.run_coro(found_coro)
            return true
    else
        me.run_coro(c)
        return true

/// Drives every spawned coroutine to completion on this thread. A null `s` does nothing.
/// :param s: The scheduler.
/// :throws: Crashes with `DeadlockError` when no coroutine can ever run again.
@export("rf_sched_run")
routine rf_sched_run(s: @Sched) -> None
    if s.is_null()
        return
    prev: @Sched = current_sched()
    CURRENT_SCHED.poke(s)

    while true
        s.lock.lock()
        done2: Bool = s.live.peek() <= 0
        s.lock.unlock()
        if done2
            CURRENT_SCHED.poke(prev)
            return
        else
            s.step()
            continue

/// Whether a coroutine has completed or been cancelled.
/// :param c: The coroutine.
/// :returns: True when it is over.
routine is_finished(c: @Coro) -> Bool
    st: U32 = c.status.peek_atomic()
    return st == CORO_COMPLETED or st == CORO_CANCELLED

/// Drives the scheduler on this thread until target finishes, leaving the others parked. A null `s` or `target`
/// does nothing.
/// :param s: The scheduler.
/// :param target: The coroutine to wait for.
/// :throws: Crashes with `DeadlockError` when no coroutine can ever run again.
@export("rf_sched_run_until")
routine rf_sched_run_until(s: @Sched, target: @Coro) -> None
    if s.is_null() or target.is_null()
        return
    prev: @Sched = current_sched()
    CURRENT_SCHED.poke(s)

    until is_finished(target)
        s.step()
    then
        CURRENT_SCHED.poke(prev)
        return

/// Wakes a scheduler's waiters with no coroutine in particular: a top-level race! re-polls. From any thread. A null
/// `s` does nothing.
/// :param s: The scheduler.
@export("rf_sched_signal")
routine rf_sched_signal(s: @Sched) -> None
    if s.is_null()
        return
    s.lock.lock()
    s.block_cond.cast_all()
    s.cond.cast_one()
    s.lock.unlock()
    return

/// Whether the caller runs in a scheduler-driven coroutine, where a park suspends.
/// :returns: 1 inside one, else 0.
@export("rf_in_coroutine")
routine rf_in_coroutine() -> U32
    has_sched: Bool = current_sched().is_not_null()
    if has_sched and current_coro().is_not_null()
        return 1
    else
        return 0

/// The scheduler driving this thread.
/// :returns: The scheduler, or null.
@export("rf_sched_current")
routine rf_sched_current() -> @Sched
    return current_sched()

// -- the process pool ----------------------------------------------------------------

/// How long a plain thread that waits on something else sleeps between turns of its start_here() jobs.
preset HERE_POLL_NS: U64 = 1000000

/// A worker's start: its scheduler and index, freed by the worker.
record WorkerStart
    sched: @Sched
    index: SSize

/// Makes a `WorkerStart` from its fields.
/// :param sched: Its `sched`.
/// :param index: Its `index`.
/// :returns: The new value.
routine WorkerStart.construct(sched: @Sched, index: SSize) -> Me
    return Me(sched, index)

/// Releases nothing: a `WorkerStart` holds no memory of its own.
routine WorkerStart.destruct(me: @Me) -> None
    return

/// A pool worker's thread: takes its index and scheduler, frees its start, and steps the scheduler forever.
/// :param start: The worker's scheduler and index.
/// :throws: Crashes with `DeadlockError` when no coroutine can ever run again.
routine worker_main(start: @WorkerStart) -> None
    rf_thread_stack_guarantee()
    s: @Sched = start.sched.peek()
    WORKER_ID.poke(start.index.peek())
    c_free(start)
    CURRENT_SCHED.poke(s)

    while true
        s.step()

/// RF_WORKERS if it is a positive integer (at most WORKERS_MAX), else one per processor.
/// :returns: The number of pool workers.
routine pool_worker_count() -> SSize
    env: U64 = env_positive("RF_WORKERS")
    if env == 0
        return cpu_count().to[SSize]()
    else
        return env.min(WORKERS_MAX).to[SSize]()

/// Makes the process pool's scheduler with a deque per worker, and starts the workers.
/// :returns: The pool's scheduler.
/// :throws: Crashes with `OutOfMemoryError` when an allocation fails, and with `TaskSpawnError` when a worker can't
///     be started.
routine pool_start() -> @Sched
    local s: @Sched = rf_sched_create()
    local n: SSize = pool_worker_count()

    s.workers_total.poke(n)
    deques: @Deque = zeroed[Deque](count: n.to[USize](), what: "Failed to allocate worker run deques")
    s.deques.poke(deques)

    each i in 0 til n
        deques.stride(i).init()

    // Daemon threads: never joined, and the OS reaps them at exit.
    each i in 0 til n
        start: @WorkerStart = zeroed[WorkerStart](count: 1, what: "Failed to allocate pool worker startup argument")
        start.poke(WorkerStart(sched: s, index: i))
        DEFAULT_THREADS.launch_unwatched(entry: worker_main.to[Callable](), arg: start)
    then
        return s

/// The process pool, made (and its workers started) on first use, once even when several threads ask at once.
/// :returns: The pool's scheduler.
/// :throws: Crashes with `OutOfMemoryError` or `TaskSpawnError` when the pool can't be made.
@export("rf_sched_thread_default")
routine rf_sched_thread_default() -> @Sched
    if POOL_STATE.peek_atomic() == 2
        return POOL.peek_atomic()
    local seen: @U32 <- 0
    if POOL_STATE.atomic_compare_exchange_raw(expected: 0, new: 1, previous: seen)
        POOL.poke_atomic(pool_start())
        POOL_STATE.poke_atomic(2)
        wake_all(POOL_STATE)
        return POOL.peek_atomic()
    else
        while POOL_STATE.peek_atomic() != 2
            wait_on(at: POOL_STATE, expected: 1)
        then
            return POOL.peek_atomic()

/// The scheduler start_here() runs a job on: this thread's own, made on first use. A job started with start_now()
/// can move between threads, so it has no thread of its own to run a job beside.
/// :returns: The scheduler, or null inside a start_now() job.
/// :throws: Crashes with `OutOfMemoryError` when the scheduler can't be allocated.
@export("rf_sched_here")
routine rf_sched_here() -> @Sched
    s: @Sched = HERE_SCHED.peek()
    if not s.is_null()
        return s
    if not current_coro().is_null()
        return null
    made: @Sched = rf_sched_create()
    HERE_SCHED.poke(made)
    return made

/// Whether this thread has start_here() jobs that have not finished.
/// :returns: True when some are live.
routine here_has_live() -> Bool
    here: @Sched = HERE_SCHED.peek()
    if here.is_null()
        return false
    here.lock.lock()
    live: Bool = here.live.peek() > 0
    here.lock.unlock()
    return live

/// Runs one of this thread's start_here() jobs that is ready now, after moving its due timers, without waiting:
/// what a plain thread does between polls while it waits on something else (a pool job, a thread, a race).
/// :returns: True when a job ran.
/// :throws: Crashes with `OutOfMemoryError` when a deque or the timer heap can't grow.
routine run_here_ready() -> Bool
    local here: @Sched = HERE_SCHED.peek()

    if here.is_null()
        return false
    here.lock.lock()

    now: U64 = monotonic_ns()

    while here.timer_count.peek() > 0
        earliest_wake: U64 = here.timer_at(0).wake_ns.peek()
        if not (earliest_wake <= now)
            break
        else
            here.push_injector(here.timer_pop_min())
            continue
    c: @Coro = here.pop_injector()
    here.lock.unlock()
    if c.is_null()
        return false
    prev: @Sched = current_sched()
    CURRENT_SCHED.poke(here)
    here.run_coro(c)
    CURRENT_SCHED.poke(prev)
    return true

/// Waits on a pool's block_cond with its lock held. With start_here() jobs live on this thread, it runs one that is
/// ready, or sleeps at most HERE_POLL_NS, so those jobs go on while this thread waits on something else.
routine Sched.block_wait(me: @Me) -> None
    if not here_has_live()
        me.block_cond.wait(me.lock)
        return
    else
        me.lock.unlock()
        ran: Bool = run_here_ready()
        me.lock.lock()
        if ran
            return
        me.block_cond.wait_for(mutex: me.lock, timeout_ns: HERE_POLL_NS)
        return

/// Spawns a new coroutine onto the process pool (start_now()).
/// :param c: The coroutine.
/// :throws: Crashes with `OutOfMemoryError` or `TaskSpawnError` when the pool can't be made.
@export("rf_sched_spawn_default")
routine rf_sched_spawn_default(c: @Coro) -> None
    rf_sched_spawn(s: rf_sched_thread_default(), c)
    return

/// retrieve!: waits for target to finish, on the scheduler it was spawned on. Inside a coroutine it parks (that
/// scheduler drives target and wakes it). On a plain thread it blocks on block_cond, or, when target is a
/// start_here() job, drives this thread's scheduler until target finishes, running its other jobs meanwhile. A null
/// `target` returns at once.
/// :param target: The coroutine to wait for.
/// :throws: Crashes with `OutOfMemoryError` or `TaskSpawnError` when the pool can't be made.
@export("rf_sched_run_until_default")
routine rf_sched_run_until_default(target: @Coro) -> None
    if target.is_null()
        return
    home: @Sched = target.home.peek()
    s: @Sched = when
        home.is_null() => rf_sched_thread_default()
        else => home
    this_coro: @Coro = current_coro()
    s.lock.lock()
    next_waiters: SSize = s.waiters.peek() + 1
    next_waiters.poke_into(s.waiters)
    if this_coro.is_null()
        // A coroutine of another scheduler (a start_here() job) waits on the pool: the pool's completion wakes it, so
        // its own scheduler is promised a wake from another thread while it is parked.

        until is_finished(target)
            if s.deques.peek().is_null()
                // A directly driven scheduler has no worker of its own: the waiting thread is its worker.
                s.lock.unlock()
                rf_sched_run_until(s, target)
                s.lock.lock()
                remaining_waiters: SSize = s.waiters.peek() - 1
                remaining_waiters.poke_into(s.waiters)
                s.lock.unlock()
                return
            else
                s.block_wait()
                continue
        then
            remaining_waiters: SSize = s.waiters.peek() - 1
            remaining_waiters.poke_into(s.waiters)
            s.lock.unlock()
            return
    else
        until is_finished(target)
            target.awaiter.poke(this_coro)
            s.lock.unlock()
            home2: @Sched = this_coro.home.peek()
            if home2.is_not_null() & ~home2.ptr_eq(s)
                rf_sched_arm_cross_waker(home2)
                rf_sched_park_external()
                rf_sched_disarm_cross_waker(home2)
                s.lock.lock()
            else
                rf_sched_park_external()
                s.lock.lock()
        then
            target.awaiter.poke(null)
            remaining_waiters: SSize = s.waiters.peek() - 1
            remaining_waiters.poke_into(s.waiters)
            s.lock.unlock()
            return

/// Takes c out of the injector, the timers, or a deque, and off the live count: whether it was in one. The caller
/// holds the lock.
/// :param c: The coroutine.
/// :returns: True when it was queued or on a timer.
routine Sched.remove_locked(me: @Me, c: @Coro) -> Bool
    jump scan(null, me.injector_head.peek())

    block scan(prev: @Coro, at: @Coro)
        if at.is_null()
            jump timers()
        if at.ptr_eq(c)
            jump unlink(prev)
        else
            jump scan(at, at.sched_next.peek())

    block unlink(prev: @Coro)
        next: @Coro = c.sched_next.peek()
        if prev.is_null()
            jump head(next)
        else
            jump middle(prev, next)

    block head(next: @Coro)
        me.injector_head.poke(next)
        jump tail(null)

    block middle(prev: @Coro, next: @Coro)
        prev.sched_next.poke(next)
        jump tail(prev)

    block tail(prev: @Coro)
        if not me.injector_tail.peek().ptr_eq(c)
            jump unlinked()
        me.injector_tail.poke(prev)
        jump unlinked()

    block unlinked()
        c.sched_next.poke(null)
        c.sched_state.poke_atomic(SCHED_IDLE)
        jump found()

    block timers()
        if not (c.timer_idx.peek() >= 0)
            jump deques()
        before: SSize = me.timer_count.peek()
        me.unlink_timer(c)
        if me.timer_count.peek() < before
            jump found()
        else
            jump deques()

    block deques()
        d: @Deque = me.deques.peek()
        if d.is_null()
            return false
        else
            jump deque(d, 0)

    block deque(d: @Deque, i: SSize)
        if i == me.workers_total.peek()
            return false
        if not d.stride(i).remove(c)
            jump deque(d, i + 1)
        c.sched_state.poke_atomic(SCHED_IDLE)
        jump found()

    block found()
        remaining_live: SSize = me.live.peek() - 1
        remaining_live.poke_into(me.live)
        return true

/// Takes c off the scheduler it was spawned on (the process pool when it was never spawned) before rf_coro_abandon
/// frees a coroutine spawned and never retrieved.
/// :param c: The coroutine.
/// :returns: 1 when it was queued or on a timer, 0 otherwise or with no scheduler.
@export("rf_sched_unschedule_default")
routine rf_sched_unschedule_default(c: @Coro) -> U32
    if c.is_null()
        return 0
    s: @Sched = home_of(c)
    if s.is_null()
        return 0
    s.lock.lock()
    found: Bool = s.remove_locked(c)
    s.lock.unlock()
    if found
        return 1
    else
        return 0

/// An Agent's destroy: 1 if the caller frees c now, 0 if a worker holds it (RUNNING, or QUEUED and mid-pop) and
/// frees it itself when it completes. Decided under the lock together with the removal.
/// :param c: The coroutine.
/// :returns: 1 when the caller frees it (always with no pool), 0 when a worker does (or for a null `c`).
@export("rf_sched_dispose_default")
routine rf_sched_dispose_default(c: @Coro) -> U32
    if c.is_null()
        return 0
    s: @Sched = home_of(c)
    if s.is_null()
        return 1
    return s.dispose(c)

/// The scheduler a coroutine was spawned on, or the process pool (null when there is none) when it never was.
/// :param c: The coroutine.
/// :returns: The scheduler, or null.
routine home_of(c: @Coro) -> @Sched
    home: @Sched = c.home.peek()
    if home.is_null()
        return POOL.peek_atomic()
    else
        return home

/// rf_sched_dispose_default on the pool: under the lock, takes c out of the queues, or leaves it to the worker that
/// holds it.
/// :param c: The coroutine.
/// :returns: 1 when the caller frees it, 0 when the worker does.
routine Sched.dispose(me: @Me, c: @Coro) -> U32
    me.lock.lock()
    found: Bool = me.remove_locked(c)
    st: U32 = c.sched_state.peek_atomic()
    held: Bool = not found and (st == SCHED_RUNNING or st == SCHED_QUEUED)
    caller_frees: U32 = when
        held =>
            c.owner_released.poke(true)
            becomes 0
        else => 1
    me.lock.unlock()
    return caller_frees

/// The number of pool workers (making the pool): coroutines can move between threads only when it is more than 1.
/// :returns: The worker count.
/// :throws: Crashes with `OutOfMemoryError` or `TaskSpawnError` when the pool can't be made.
@export("rf_sched_worker_count")
routine rf_sched_worker_count() -> U64
    s: @Sched = rf_sched_thread_default()
    return s.workers_total.peek().to[U64]()
