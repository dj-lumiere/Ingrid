// The cycle collector while other threads work: four worker threads each make two-entity cycles and let go of them,
// and share and release a private entity between rounds, while the main thread runs pass after pass. Every cycle
// must be freed exactly once, and no worker may touch an entity a pass is tracing (a pass stops the world through
// each thread's slot).
//
// roam.tess calls two routines of the RazorForge runtime library and deadlock.tess a third, defined here so the
// program links: the current task, the scheduler's yield, and the crash exit.

import Standard/Alloc
import Standard/Format
import Standard/Os

/// How many entities the collector has freed.
global FREED: @U64
/// How many workers have finished.
global DONE: @U64

preset WORKERS: U64 = 4
preset ROUNDS: U64 = 20000

/// An entity: the header of the entity its one Roamed field holds (null for none).
record Node
    child: Addr

/// Makes a `Node` from its fields.
/// :param child: Its `child`.
/// :returns: The new value.
routine Node.construct(child: Addr) -> Me
    return(Me(child))

/// Releases nothing: a `Node` holds no memory of its own.
routine Node.destruct(me: @Me) -> Void
    return()

#export("rf_current_task_id")
routine stub_current_task_id() -> U64
    return(1)

#export("rf_coro_yield")
routine stub_coro_yield() -> Void
    return()

#[export("rf_crash_exit"), noreturn]
routine stub_crash_exit() -> Void
    exit(82)

/// The entity type's trace routine: hands the collector the header its Roamed field holds.
/// :param entity: The node.
routine trace_node(entity: Addr) -> Void
    node: @Node = entity.to[@Node]()
    child: Addr = node.child.peek()
    branch child.to[@Byte]().is_null()
        ? return()
        : continue
    visit_child(child)
    return()

/// The entity type's collector free routine: counts the node and frees it.
/// :param entity: The node.
routine free_node(entity: Addr) -> Void
    before: U64 = FREED.atomic_fetch_add(1)
    claim alloc: @MemoryManager <- make_c_heap_memory()
    deallocate(data: entity.to[@Node](), alloc)
    return()

/// The entity type's destroy routine, for the last strong release: frees the node without counting it.
/// :param entity: The node.
routine drop_node(entity: Addr) -> Void
    claim alloc: @MemoryManager <- make_c_heap_memory()
    deallocate(data: entity.to[@Node](), alloc)
    return()

/// A new local entity with one strong handle.
/// :returns: Its header.
routine new_entity() -> @RoamHeader
    claim alloc: @MemoryManager <- make_c_heap_memory()
    node: @Node = allocate[Node](count: 1, alloc)
    header: @RoamHeader = allocate[RoamHeader](count: 1, alloc)
    node.child.poke(null)
    header.poke(RoamHeader(count: 1, weak: 0, dead: 0, escaped: 0, data: node, locked: 0,
        holder_task: 0, depth: 0, state: 0, buffered: false, trace_hook: trace_node.addr(),
        free_hook: free_node.addr(), drop_hook: drop_node.addr(), shape_users: 0))
    return(header)

/// Stores `target` in `owner`'s Roamed field, which holds one more strong handle to it.
/// :param owner: The entity whose field is set.
/// :param target: The entity it points at.
routine link(owner: @RoamHeader, target: @RoamHeader) -> Void
    node: @Node = owner.data.peek().to[@Node]()
    roam_hold(target)
    node.child.poke(target)
    return()

/// A worker: ROUNDS times, makes a cycle of two and lets go of it, then shares and releases its private entity.
/// :param unused: Nothing.
routine worker(unused: @U64) -> Void
    mine: @RoamHeader = new_entity()
    jump round(0, mine)

    block round(i: U64, mine: @RoamHeader)
        branch i.lt(ROUNDS)
            ? one(i, mine)
            : finish(mine)

    block one(i: U64, mine: @RoamHeader)
        a: @RoamHeader = new_entity()
        b: @RoamHeader = new_entity()
        link(owner: a, target: b)
        link(owner: b, target: a)
        roam_unhold(b)
        roam_unhold(a)
        roam_hold(mine)
        roam_unhold(mine)
        jump round(i.add(1), mine)

    block finish(mine: @RoamHeader)
        roam_unhold(mine)
        before: U64 = DONE.atomic_fetch_add(1)
        return()

/// Starts `left` more workers, runs passes until they have all finished, and waits for them.
/// :param left: How many workers are still to start.
routine run_workers(left: U64) -> Void
    branch left.eq(0)
        ? collect_while_working()
        : spawn()

    block spawn()
        claim alloc: @MemoryManager <- make_c_heap_memory()
        claim unused: @U64 <- 0
        thread: Thread = Thread.spawn(entry: worker.to[Callable](), arg: unused, alloc)
        run_workers(left.sub(1))
        thread.join()
        return()

    block collect_while_working()
        freed: U64 = collect()
        done: Bool = DONE.peek_atomic().eq(WORKERS)
        branch done
            ? return()
            : collect_while_working()

/// Runs passes until one frees nothing.
routine collect_the_rest() -> Void
    jump pass()

    block pass()
        freed: U64 = collect()
        branch freed.eq(0)
            ? return()
            : pass()

routine start() -> Void
    run_workers(WORKERS)
    collect_the_rest()
    freed: U64 = FREED.peek_atomic()
    expected: U64 = WORKERS.mul(ROUNDS).mul(2)
    all: Bool = freed.eq(expected)
    left: U64 = ROOTS.count.peek()
    Out.write("every cycle freed once: {all}, candidates left {left}\n")
    return()
