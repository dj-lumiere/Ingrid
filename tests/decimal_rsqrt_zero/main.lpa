# Decimal.rsqrt of zero crashes with NumericDomainError, the crash Decimal.sqrt gives below zero: a Decimal has no
# infinity, so 1 / sqrt(0) has no Decimal result. D64 rsqrt_unchecked of the same zero gives inf. The program's own
# crash handler writes the crash's name and message to standard output and exits with status 82.

import Hosted
import Ingrid/Decimal

@untraced
routine report(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}")
    ProcessManager.exit_process(82)

routine start() -> None
    Crash.report_with(report.to[Callable]())
    four: Decimal = "4".to[Decimal]()
    zero64: D64 = "0".to[D64]()
    Console.show("{four.rsqrt()} {zero64.rsqrt_unchecked()}")
    zero: Decimal = "0".to[Decimal]()
    r: Decimal = zero.rsqrt()
    Console.show("not reached {r}")
    return
