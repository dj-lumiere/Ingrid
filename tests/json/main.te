# JSON string escaping through Ingrid's exports (tessera/json.te), on text held as code points the way RazorForge's
# Text keeps it. The expected output is what RazorForge's JSON encoder printed for the same strings
# (Tessera/scratch/random-json/json_escape.rf) with its own escaper, before it moved here: every code point from 0 to
# 0x2FF between `a` and `z`, a few awkward ones, the empty text, and the length of a 20000-character string.

import Hosted

### Quotes `count` code points from `chars` and writes the result as UTF-8.
routine quote(chars: @U32, count: U64) -> None
    quoted: &Items[U32, 256] <- .hollow()
    utf8: &Items[Byte, 4] <- .hollow()
    needed: U64 = json_quoted_count_utf32(chars, count)
    written: U64 = json_quote_utf32(chars, count, out: quoted.getview().to[@U32](), out_count: 256)

    if needed == written
        for i in 0 til written
            c: Char = quoted[i.to[U64]()].to[Char]()
            width: U64 = utf8_encode_into(char: c, out: utf8.getview().to[@Byte]())
            Console.output().write_bytes(data: utf8.getview().to[@Byte](), count: width)
        Console.show("")
        return
    else
        throw LogicBreachedError()

### Quotes `a`, `c`, `z`.
routine between(c: U32) -> None
    chars: &Items[U32, 3] <- [0x61, c, 0x7A]

    quote(chars: chars.getview().to[@U32](), count: 3)
    return

routine start() -> None
    long: &Items[U32, 20000] <- .hollow()

    until c >= 0x300 with c: U32 = 0
        Console.show("{c}: ", end: "")
        between(c)
        continue with c: c + 1
    between(0xD7FF)
    between(0xE000)
    between(0xFFFD)
    between(0xFFFF)
    between(0x1F600)
    between(0x10FFFF)
    between(0x2028)
    between(0x2029)
    none: &U32 <- 0
    quote(chars: none, count: 0)

    until i >= 20000 with i: U32 = 0
        long[i.to[U64]()] = i % 0x90
        continue with i: i + 1
    count: U64 = json_quoted_count_utf32(chars: long.getview().to[@U32](), count: 20000)
    Console.show("long count: {count}")
    return
