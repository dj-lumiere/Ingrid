# Solving diag(0.5, 0.5) x = (3e38, -3e38) divides 3e38 by 0.5, which is past the largest B32 and crashes with
# RazorForge's NumericOverflowError, as RazorForge's checked B32 `/` does (matrix.te and finite.te). The program's
# own crash handler writes the crash's name and message to standard output and exits with status 82, RazorForge's
# crash status.

import Hosted

@untraced
routine report(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}")
    ProcessManager.exit_process(82)

routine start() -> None
    Crash.report_with(report.to[Callable]())
    Console.show("before")
    r: MatrixResult = m2_solve(m00: 0.5, m01: 0.0, m10: 0.0, m11: 0.5,
        b0: B32.from_bits(0x7F61B1E6), b1: B32.from_bits(0xFF61B1E6))
    Console.show("not reached {r.singular}")
    return
