// The quaternion routines of Ingrid/tessera/quaternion.tess and the matrix routines of matrix.tess through their
// exports, as RazorForge calls them: Q128 and Q256 products, quotients, norms, rotations, interpolation, the
// axis-angle, Euler, and from-to conversions, the rotation of a matrix, and Matrix4R4C's determinant, inverse, and
// rotation matrix. Each line is the results' bits in decimal. The expected output is RazorForge's own Q128.rf,
// Q256.rf, and Matrix4R4C.rf before their bodies moved here, so these lines lock the port to the same bits.

import Standard/Format
import Standard/Os

/// Writes four B32s handed back in the low halves of Words.
routine show_b32_words(label: Bytes, w: Words) -> Void
    block entry()
        a: U32 = w.w0.to_wrap[U32]()
        b: U32 = w.w1.to_wrap[U32]()
        c: U32 = w.w2.to_wrap[U32]()
        d: U32 = w.w3.to_wrap[U32]()
        Out.write("{label} {a} {b} {c} {d}\n")
        return()

/// Writes four B64s handed back in Words.
routine show_b64_words(label: Bytes, w: Words) -> Void
    block entry()
        Out.write("{label} {w.w0} {w.w1} {w.w2} {w.w3}\n")
        return()

/// Writes three B32s and a B64 handed back in Words (Q256's axis and angle).
routine show_axis_b64(label: Bytes, w: Words) -> Void
    block entry()
        a: U32 = w.w0.to_wrap[U32]()
        b: U32 = w.w1.to_wrap[U32]()
        c: U32 = w.w2.to_wrap[U32]()
        Out.write("{label} {a} {b} {c} {w.w3}\n")
        return()

/// Writes a B32's bits.
routine show_b32(label: Bytes, v: B32) -> Void
    block entry()
        Out.write("{label} {v.bits()}\n")
        return()

/// Writes a B64's bits.
routine show_b64(label: Bytes, v: B64) -> Void
    block entry()
        Out.write("{label} {v.bits()}\n")
        return()

/// Writes a Bool.
routine show_bool(label: Bytes, v: Bool) -> Void
    block entry()
        Out.write("{label} {v}\n")
        return()

/// Writes a matrix's elements' bits, column after column.
routine show_matrix(label: Bytes, m: Matrix4) -> Void
    block entry()
        Out.write("{label} {m.m00.bits()} {m.m10.bits()} {m.m20.bits()} {m.m30.bits()}")
        Out.write(" {m.m01.bits()} {m.m11.bits()} {m.m21.bits()} {m.m31.bits()}")
        Out.write(" {m.m02.bits()} {m.m12.bits()} {m.m22.bits()} {m.m32.bits()}")
        Out.write(" {m.m03.bits()} {m.m13.bits()} {m.m23.bits()} {m.m33.bits()}\n")
        return()

/// The unit quaternion of (w, x, y, z), through q128_normalize, as four B32s.
routine q128_unit(w: B32, x: B32, y: B32, z: B32) -> (B32, B32, B32, B32)
    block entry()
        u: Words = q128_normalize(w, x, y, z)
        uw: B32 = B32.from_bits(u.w0.to_wrap[U32]())
        ux: B32 = B32.from_bits(u.w1.to_wrap[U32]())
        uy: B32 = B32.from_bits(u.w2.to_wrap[U32]())
        uz: B32 = B32.from_bits(u.w3.to_wrap[U32]())
        return((uw, ux, uy, uz))

/// q128_angle of the unit quaternion of (w, x, y, z).
routine unit_q128_angle(w: B32, x: B32, y: B32, z: B32) -> B32
    block entry()
        uw, ux, uy, uz = q128_unit(w, x, y, z)
        return(q128_angle(uw, ux, uy, uz))

/// q128_to_axis_angle of the unit quaternion of (w, x, y, z).
routine unit_q128_to_axis_angle(w: B32, x: B32, y: B32, z: B32) -> Words
    block entry()
        uw, ux, uy, uz = q128_unit(w, x, y, z)
        return(q128_to_axis_angle(uw, ux, uy, uz))

/// q128_to_euler of the unit quaternion of (w, x, y, z).
routine unit_q128_to_euler(w: B32, x: B32, y: B32, z: B32) -> Words
    block entry()
        uw, ux, uy, uz = q128_unit(w, x, y, z)
        return(q128_to_euler(uw, ux, uy, uz))

/// q128_rotate by the unit quaternion of (w, x, y, z).
routine unit_q128_rotate(w: B32, x: B32, y: B32, z: B32, vx: B32, vy: B32, vz: B32) -> Words
    block entry()
        uw, ux, uy, uz = q128_unit(w, x, y, z)
        return(q128_rotate(uw, ux, uy, uz, vx, vy, vz))

/// q128_slerp between the unit quaternions of the two.
routine unit_q128_slerp(w: B32, x: B32, y: B32, z: B32, a: B32, b: B32, c: B32, d: B32,
    t: B32) -> Words
    block entry()
        uw, ux, uy, uz = q128_unit(w, x, y, z)
        pw, px, py, pz = q128_unit(a, b, c, d)
        return(q128_slerp(uw, ux, uy, uz, pw, px, py, pz, t))

/// q128_nlerp between the unit quaternions of the two.
routine unit_q128_nlerp(w: B32, x: B32, y: B32, z: B32, a: B32, b: B32, c: B32, d: B32,
    t: B32) -> Words
    block entry()
        uw, ux, uy, uz = q128_unit(w, x, y, z)
        pw, px, py, pz = q128_unit(a, b, c, d)
        return(q128_nlerp(uw, ux, uy, uz, pw, px, py, pz, t))

/// q128_from_matrix of the rotation matrix of the unit Q128 of (w, x, y, z).
routine unit_q128_from_matrix(w: B32, x: B32, y: B32, z: B32) -> Words
    block entry()
        uw, ux, uy, uz = q128_unit(w, x, y, z)
        m: Matrix4 = m4_from_quaternion(uw, ux, uy, uz)
        return(q128_from_matrix(m.m00, m.m01, m.m02, m.m10, m.m11, m.m12, m.m20, m.m21, m.m22))

/// The unit quaternion of (w, x, y, z), through q256_normalize, as four B64s.
routine q256_unit(w: B64, x: B64, y: B64, z: B64) -> (B64, B64, B64, B64)
    block entry()
        u: Words = q256_normalize(w, x, y, z)
        uw: B64 = B64.from_bits(u.w0)
        ux: B64 = B64.from_bits(u.w1)
        uy: B64 = B64.from_bits(u.w2)
        uz: B64 = B64.from_bits(u.w3)
        return((uw, ux, uy, uz))

/// q256_angle of the unit quaternion of (w, x, y, z).
routine unit_q256_angle(w: B64, x: B64, y: B64, z: B64) -> B64
    block entry()
        uw, ux, uy, uz = q256_unit(w, x, y, z)
        return(q256_angle(uw, ux, uy, uz))

/// q256_to_axis_angle of the unit quaternion of (w, x, y, z).
routine unit_q256_to_axis_angle(w: B64, x: B64, y: B64, z: B64) -> Words
    block entry()
        uw, ux, uy, uz = q256_unit(w, x, y, z)
        return(q256_to_axis_angle(uw, ux, uy, uz))

/// q256_to_euler of the unit quaternion of (w, x, y, z).
routine unit_q256_to_euler(w: B64, x: B64, y: B64, z: B64) -> Words
    block entry()
        uw, ux, uy, uz = q256_unit(w, x, y, z)
        return(q256_to_euler(uw, ux, uy, uz))

/// q256_rotate by the unit quaternion of (w, x, y, z).
routine unit_q256_rotate(w: B64, x: B64, y: B64, z: B64, vx: B32, vy: B32, vz: B32) -> Words
    block entry()
        uw, ux, uy, uz = q256_unit(w, x, y, z)
        return(q256_rotate(uw, ux, uy, uz, vx, vy, vz))

/// q256_slerp between the unit quaternions of the two.
routine unit_q256_slerp(w: B64, x: B64, y: B64, z: B64, a: B64, b: B64, c: B64, d: B64,
    t: B64) -> Words
    block entry()
        uw, ux, uy, uz = q256_unit(w, x, y, z)
        pw, px, py, pz = q256_unit(a, b, c, d)
        return(q256_slerp(uw, ux, uy, uz, pw, px, py, pz, t))

/// q256_nlerp between the unit quaternions of the two.
routine unit_q256_nlerp(w: B64, x: B64, y: B64, z: B64, a: B64, b: B64, c: B64, d: B64,
    t: B64) -> Words
    block entry()
        uw, ux, uy, uz = q256_unit(w, x, y, z)
        pw, px, py, pz = q256_unit(a, b, c, d)
        return(q256_nlerp(uw, ux, uy, uz, pw, px, py, pz, t))

/// q256_from_matrix of the rotation matrix of the unit Q128 of (w, x, y, z).
routine unit_q256_from_matrix(w: B32, x: B32, y: B32, z: B32) -> Words
    block entry()
        uw, ux, uy, uz = q128_unit(w, x, y, z)
        m: Matrix4 = m4_from_quaternion(uw, ux, uy, uz)
        return(q256_from_matrix(m.m00, m.m01, m.m02, m.m10, m.m11, m.m12, m.m20, m.m21, m.m22))

/// m4_from_quaternion of the unit quaternion of (w, x, y, z).
routine unit_m4_from_quaternion(w: B32, x: B32, y: B32, z: B32) -> Matrix4
    block entry()
        uw, ux, uy, uz = q128_unit(w, x, y, z)
        return(m4_from_quaternion(uw, ux, uy, uz))

routine check_0() -> Void
    block entry()
        show_b32("q128 norm 0",
            q128_norm(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000)))
        show_b32("q128 abs 0",
            q128_abs(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000)))
        show_b32_words("q128 normalize 0",
            q128_normalize(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000)))
        show_b32_words("q128 reciprocal 0",
            q128_reciprocal(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000)))
        show_bool("q128 is_unit 0",
            q128_is_unit(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000)))
        show_b32_words("q128 mul 0 0",
            q128_mul(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000)))
        show_b32_words("q128 div 0 0",
            q128_div(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000)))
        show_b32("q128 dot 0 0",
            q128_dot(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000)))
        show_b32_words("q128 mul 0 1",
            q128_mul(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000)))
        show_b32_words("q128 div 0 1",
            q128_div(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000)))
        show_b32("q128 dot 0 1",
            q128_dot(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000)))
        show_b32_words("q128 mul 0 2",
            q128_mul(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3F800000)))
        show_b32_words("q128 div 0 2",
            q128_div(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3F800000)))
        show_b32("q128 dot 0 2",
            q128_dot(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3F800000)))
        show_b32_words("q128 mul 0 3",
            q128_mul(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3DCCCCCD), B32.from_bits(0xBF333333), B32.from_bits(0x40000000), B32.from_bits(0x3F000000)))
        show_b32_words("q128 div 0 3",
            q128_div(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3DCCCCCD), B32.from_bits(0xBF333333), B32.from_bits(0x40000000), B32.from_bits(0x3F000000)))
        show_b32("q128 dot 0 3",
            q128_dot(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3DCCCCCD), B32.from_bits(0xBF333333), B32.from_bits(0x40000000), B32.from_bits(0x3F000000)))
        show_b32_words("q128 mul 0 4",
            q128_mul(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0xBF800000), B32.from_bits(0x80000000), B32.from_bits(0x00000000), B32.from_bits(0x80000000)))
        show_b32_words("q128 div 0 4",
            q128_div(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0xBF800000), B32.from_bits(0x80000000), B32.from_bits(0x00000000), B32.from_bits(0x80000000)))
        show_b32("q128 dot 0 4",
            q128_dot(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0xBF800000), B32.from_bits(0x80000000), B32.from_bits(0x00000000), B32.from_bits(0x80000000)))
        show_b32_words("q128 mul 0 5",
            q128_mul(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3A83126F), B32.from_bits(0x40400000), B32.from_bits(0xBE800000), B32.from_bits(0x40F00000)))
        show_b32_words("q128 div 0 5",
            q128_div(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3A83126F), B32.from_bits(0x40400000), B32.from_bits(0xBE800000), B32.from_bits(0x40F00000)))
        show_b32("q128 dot 0 5",
            q128_dot(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3A83126F), B32.from_bits(0x40400000), B32.from_bits(0xBE800000), B32.from_bits(0x40F00000)))
        show_b32_words("q128 mul 0 6",
            q128_mul(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3F7FF972), B32.from_bits(0x3C23D70A), B32.from_bits(0x00000000), B32.from_bits(0x00000000)))
        show_b32_words("q128 div 0 6",
            q128_div(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3F7FF972), B32.from_bits(0x3C23D70A), B32.from_bits(0x00000000), B32.from_bits(0x00000000)))
        show_b32("q128 dot 0 6",
            q128_dot(B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3F7FF972), B32.from_bits(0x3C23D70A), B32.from_bits(0x00000000), B32.from_bits(0x00000000)))
        show_b32("q128 norm 1",
            q128_norm(B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000)))
        show_b32("q128 abs 1",
            q128_abs(B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000)))
        show_b32_words("q128 normalize 1",
            q128_normalize(B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000)))
        show_b32_words("q128 reciprocal 1",
            q128_reciprocal(B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000)))
        show_bool("q128 is_unit 1",
            q128_is_unit(B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000)))
        show_b32_words("q128 mul 1 0",
            q128_mul(B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000)))
        show_b32_words("q128 div 1 0",
            q128_div(B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000)))
        show_b32("q128 dot 1 0",
            q128_dot(B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F800000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000)))
        show_b32_words("q128 mul 1 1",
            q128_mul(B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000)))
        show_b32_words("q128 div 1 1",
            q128_div(B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000)))
        show_b32("q128 dot 1 1",
            q128_dot(B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000)))
        show_b32_words("q128 mul 1 2",
            q128_mul(B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3F800000)))
        show_b32_words("q128 div 1 2",
            q128_div(B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3F800000)))
        show_b32("q128 dot 1 2",
            q128_dot(B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x00000000), B32.from_bits(0x3F800000)))
        show_b32_words("q128 mul 1 3",
            q128_mul(B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3F000000), B32.from_bits(0xBF000000), B32.from_bits(0x3DCCCCCD), B32.from_bits(0xBF333333), B32.from_bits(0x40000000), B32.from_bits(0x3F000000)))
        show_b32_words("q128 div 1 3",
