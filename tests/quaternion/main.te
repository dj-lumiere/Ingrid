# The quaternion routines of Ingrid/tessera/quaternion.te and the matrix routines of matrix.te through their
# exports, as RazorForge calls them: Q128 and Q256 products, quotients, norms, rotations, interpolation, the
# axis-angle, Euler, and from-to conversions, the rotation of a matrix, and Matrix4R4C's determinant, inverse, and
# rotation matrix. Each line is the results' bits in decimal. The expected output is RazorForge's own Q128.rf,
# Q256.rf, and Matrix4R4C.rf before their bodies moved here, so these lines lock the port to the same bits.

import Standard/Format
import Standard/Os

### A Q128's four parts.
record Quat32
    w: B32
    x: B32
    y: B32
    z: B32

### A Q256's four parts.
record Quat64
    w: B64
    x: B64
    y: B64
    z: B64

### A vector's three parts.
record Vec32
    x: B32
    y: B32
    z: B32

### Writes four B32s handed back in the low halves of Words.
routine show_b32_words(label: Span[Byte], w: Words) -> None
    a: U32 = w.w0.to_wrap[U32]()
    b: U32 = w.w1.to_wrap[U32]()
    c: U32 = w.w2.to_wrap[U32]()
    d: U32 = w.w3.to_wrap[U32]()
    Out.write("{label} {a} {b} {c} {d}\n")
    return

### Writes four B64s handed back in Words.
routine show_b64_words(label: Span[Byte], w: Words) -> None
    Out.write("{label} {w.w0} {w.w1} {w.w2} {w.w3}\n")
    return

### Writes three B32s and a B64 handed back in Words (Q256's axis and angle).
routine show_axis_b64(label: Span[Byte], w: Words) -> None
    a: U32 = w.w0.to_wrap[U32]()
    b: U32 = w.w1.to_wrap[U32]()
    c: U32 = w.w2.to_wrap[U32]()
    Out.write("{label} {a} {b} {c} {w.w3}\n")
    return

### Writes a B32's bits.
routine show_b32(label: Span[Byte], v: B32) -> None
    Out.write("{label} {v.bits()}\n")
    return

### Writes a B64's bits.
routine show_b64(label: Span[Byte], v: B64) -> None
    Out.write("{label} {v.bits()}\n")
    return

### Writes a Bool.
routine show_bool(label: Span[Byte], v: Bool) -> None
    Out.write("{label} {v}\n")
    return

### Writes a matrix's elements' bits, column after column.
routine show_matrix(label: Span[Byte], m: Matrix4) -> None
    Out.write("{label} {m.m00.bits()} {m.m10.bits()} {m.m20.bits()} {m.m30.bits()}")
    Out.write(" {m.m01.bits()} {m.m11.bits()} {m.m21.bits()} {m.m31.bits()}")
    Out.write(" {m.m02.bits()} {m.m12.bits()} {m.m22.bits()} {m.m32.bits()}")
    Out.write(" {m.m03.bits()} {m.m13.bits()} {m.m23.bits()} {m.m33.bits()}\n")
    return

### The unit quaternion of q, through q128_normalize.
routine q128_unit(q: Quat32) -> Quat32
    u: Words = q128_normalize(w: q.w, x: q.x, y: q.y, z: q.z)
    uw: B32 = B32.from_bits(u.w0.to_wrap[U32]())
    ux: B32 = B32.from_bits(u.w1.to_wrap[U32]())
    uy: B32 = B32.from_bits(u.w2.to_wrap[U32]())
    uz: B32 = B32.from_bits(u.w3.to_wrap[U32]())
    return Quat32(w: uw, x: ux, y: uy, z: uz)

### q128_angle of the unit quaternion of q.
routine unit_q128_angle(q: Quat32) -> B32
    u: Quat32 = q128_unit(q)
    return q128_angle(w: u.w, x: u.x, y: u.y, z: u.z)

### q128_to_axis_angle of the unit quaternion of q.
routine unit_q128_to_axis_angle(q: Quat32) -> Words
    u: Quat32 = q128_unit(q)
    return q128_to_axis_angle(w: u.w, x: u.x, y: u.y, z: u.z)

### q128_to_euler of the unit quaternion of q.
routine unit_q128_to_euler(q: Quat32) -> Words
    u: Quat32 = q128_unit(q)
    return q128_to_euler(w: u.w, x: u.x, y: u.y, z: u.z)

### q128_rotate of v by the unit quaternion of q.
routine unit_q128_rotate(q: Quat32, v: Vec32) -> Words
    u: Quat32 = q128_unit(q)
    return q128_rotate(w: u.w, x: u.x, y: u.y, z: u.z, vx: v.x, vy: v.y, vz: v.z)

### q128_slerp between the unit quaternions of q and other.
routine unit_q128_slerp(q: Quat32, other: Quat32, t: B32) -> Words
    u: Quat32 = q128_unit(q)
    p: Quat32 = q128_unit(other)
    return q128_slerp(w: u.w, x: u.x, y: u.y, z: u.z, other_w: p.w, other_x: p.x, other_y: p.y,
        other_z: p.z, t)

### q128_nlerp between the unit quaternions of q and other.
routine unit_q128_nlerp(q: Quat32, other: Quat32, t: B32) -> Words
    u: Quat32 = q128_unit(q)
    p: Quat32 = q128_unit(other)
    return q128_nlerp(w: u.w, x: u.x, y: u.y, z: u.z, other_w: p.w, other_x: p.x, other_y: p.y,
        other_z: p.z, t)

### q128_from_matrix of the rotation matrix of the unit Q128 of q.
routine unit_q128_from_matrix(q: Quat32) -> Words
    u: Quat32 = q128_unit(q)
    m: Matrix4 = m4_from_quaternion(w: u.w, x: u.x, y: u.y, z: u.z)
    return q128_from_matrix(m00: m.m00, m01: m.m01, m02: m.m02, m10: m.m10, m11: m.m11, m12: m.m12,
        m20: m.m20, m21: m.m21, m22: m.m22)

### The unit quaternion of q, through q256_normalize.
routine q256_unit(q: Quat64) -> Quat64
    u: Words = q256_normalize(w: q.w, x: q.x, y: q.y, z: q.z)
    uw: B64 = B64.from_bits(u.w0)
    ux: B64 = B64.from_bits(u.w1)
    uy: B64 = B64.from_bits(u.w2)
    uz: B64 = B64.from_bits(u.w3)
    return Quat64(w: uw, x: ux, y: uy, z: uz)

### q256_angle of the unit quaternion of q.
routine unit_q256_angle(q: Quat64) -> B64
    u: Quat64 = q256_unit(q)
    return q256_angle(w: u.w, x: u.x, y: u.y, z: u.z)

### q256_to_axis_angle of the unit quaternion of q.
routine unit_q256_to_axis_angle(q: Quat64) -> Words
    u: Quat64 = q256_unit(q)
    return q256_to_axis_angle(w: u.w, x: u.x, y: u.y, z: u.z)

### q256_to_euler of the unit quaternion of q.
routine unit_q256_to_euler(q: Quat64) -> Words
    u: Quat64 = q256_unit(q)
    return q256_to_euler(w: u.w, x: u.x, y: u.y, z: u.z)

### q256_rotate of v by the unit quaternion of q.
routine unit_q256_rotate(q: Quat64, v: Vec32) -> Words
    u: Quat64 = q256_unit(q)
    return q256_rotate(w: u.w, x: u.x, y: u.y, z: u.z, vx: v.x, vy: v.y, vz: v.z)

### q256_slerp between the unit quaternions of q and other.
routine unit_q256_slerp(q: Quat64, other: Quat64, t: B64) -> Words
    u: Quat64 = q256_unit(q)
    p: Quat64 = q256_unit(other)
    return q256_slerp(w: u.w, x: u.x, y: u.y, z: u.z, other_w: p.w, other_x: p.x, other_y: p.y,
        other_z: p.z, t)

### q256_nlerp between the unit quaternions of q and other.
routine unit_q256_nlerp(q: Quat64, other: Quat64, t: B64) -> Words
    u: Quat64 = q256_unit(q)
    p: Quat64 = q256_unit(other)
    return q256_nlerp(w: u.w, x: u.x, y: u.y, z: u.z, other_w: p.w, other_x: p.x, other_y: p.y,
        other_z: p.z, t)

### q256_from_matrix of the rotation matrix of the unit Q128 of q.
routine unit_q256_from_matrix(q: Quat32) -> Words
    u: Quat32 = q128_unit(q)
    m: Matrix4 = m4_from_quaternion(w: u.w, x: u.x, y: u.y, z: u.z)
    return q256_from_matrix(m00: m.m00, m01: m.m01, m02: m.m02, m10: m.m10, m11: m.m11, m12: m.m12,
        m20: m.m20, m21: m.m21, m22: m.m22)

### m4_from_quaternion of the unit quaternion of q.
routine unit_m4_from_quaternion(q: Quat32) -> Matrix4
    u: Quat32 = q128_unit(q)
    return m4_from_quaternion(w: u.w, x: u.x, y: u.y, z: u.z)

routine check_0() -> None
    show_b32(label: "q128 norm 0",
        v: q128_norm(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000)))
    show_b32(label: "q128 abs 0",
        v: q128_abs(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000)))
    show_b32_words(label: "q128 normalize 0",
        w: q128_normalize(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000)))
    show_b32_words(label: "q128 reciprocal 0",
        w: q128_reciprocal(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000)))
    show_bool(label: "q128 is_unit 0",
        v: q128_is_unit(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000)))
    show_b32_words(label: "q128 mul 0 0",
        w: q128_mul(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x3F800000), other_x: B32.from_bits(0x00000000), other_y: B32.from_bits(0x00000000), other_z: B32.from_bits(0x00000000)))
    show_b32_words(label: "q128 div 0 0",
        w: q128_div(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x3F800000), other_x: B32.from_bits(0x00000000), other_y: B32.from_bits(0x00000000), other_z: B32.from_bits(0x00000000)))
    show_b32(label: "q128 dot 0 0",
        v: q128_dot(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x3F800000), other_x: B32.from_bits(0x00000000), other_y: B32.from_bits(0x00000000), other_z: B32.from_bits(0x00000000)))
    show_b32_words(label: "q128 mul 0 1",
        w: q128_mul(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x3F000000), other_x: B32.from_bits(0xBF000000), other_y: B32.from_bits(0x3F000000), other_z: B32.from_bits(0xBF000000)))
    show_b32_words(label: "q128 div 0 1",
        w: q128_div(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x3F000000), other_x: B32.from_bits(0xBF000000), other_y: B32.from_bits(0x3F000000), other_z: B32.from_bits(0xBF000000)))
    show_b32(label: "q128 dot 0 1",
        v: q128_dot(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x3F000000), other_x: B32.from_bits(0xBF000000), other_y: B32.from_bits(0x3F000000), other_z: B32.from_bits(0xBF000000)))
    show_b32_words(label: "q128 mul 0 2",
        w: q128_mul(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x00000000), other_x: B32.from_bits(0x00000000), other_y: B32.from_bits(0x00000000), other_z: B32.from_bits(0x3F800000)))
    show_b32_words(label: "q128 div 0 2",
        w: q128_div(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x00000000), other_x: B32.from_bits(0x00000000), other_y: B32.from_bits(0x00000000), other_z: B32.from_bits(0x3F800000)))
    show_b32(label: "q128 dot 0 2",
        v: q128_dot(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x00000000), other_x: B32.from_bits(0x00000000), other_y: B32.from_bits(0x00000000), other_z: B32.from_bits(0x3F800000)))
    show_b32_words(label: "q128 mul 0 3",
        w: q128_mul(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x3DCCCCCD), other_x: B32.from_bits(0xBF333333), other_y: B32.from_bits(0x40000000), other_z: B32.from_bits(0x3F000000)))
    show_b32_words(label: "q128 div 0 3",
        w: q128_div(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x3DCCCCCD), other_x: B32.from_bits(0xBF333333), other_y: B32.from_bits(0x40000000), other_z: B32.from_bits(0x3F000000)))
    show_b32(label: "q128 dot 0 3",
        v: q128_dot(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x3DCCCCCD), other_x: B32.from_bits(0xBF333333), other_y: B32.from_bits(0x40000000), other_z: B32.from_bits(0x3F000000)))
    show_b32_words(label: "q128 mul 0 4",
        w: q128_mul(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0xBF800000), other_x: B32.from_bits(0x80000000), other_y: B32.from_bits(0x00000000), other_z: B32.from_bits(0x80000000)))
    show_b32_words(label: "q128 div 0 4",
        w: q128_div(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0xBF800000), other_x: B32.from_bits(0x80000000), other_y: B32.from_bits(0x00000000), other_z: B32.from_bits(0x80000000)))
    show_b32(label: "q128 dot 0 4",
        v: q128_dot(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0xBF800000), other_x: B32.from_bits(0x80000000), other_y: B32.from_bits(0x00000000), other_z: B32.from_bits(0x80000000)))
    show_b32_words(label: "q128 mul 0 5",
        w: q128_mul(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x3A83126F), other_x: B32.from_bits(0x40400000), other_y: B32.from_bits(0xBE800000), other_z: B32.from_bits(0x40F00000)))
    show_b32_words(label: "q128 div 0 5",
        w: q128_div(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x3A83126F), other_x: B32.from_bits(0x40400000), other_y: B32.from_bits(0xBE800000), other_z: B32.from_bits(0x40F00000)))
    show_b32(label: "q128 dot 0 5",
        v: q128_dot(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x3A83126F), other_x: B32.from_bits(0x40400000), other_y: B32.from_bits(0xBE800000), other_z: B32.from_bits(0x40F00000)))
    show_b32_words(label: "q128 mul 0 6",
        w: q128_mul(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x3F7FF972), other_x: B32.from_bits(0x3C23D70A), other_y: B32.from_bits(0x00000000), other_z: B32.from_bits(0x00000000)))
    show_b32_words(label: "q128 div 0 6",
        w: q128_div(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x3F7FF972), other_x: B32.from_bits(0x3C23D70A), other_y: B32.from_bits(0x00000000), other_z: B32.from_bits(0x00000000)))
    show_b32(label: "q128 dot 0 6",
        v: q128_dot(w: B32.from_bits(0x3F800000), x: B32.from_bits(0x00000000), y: B32.from_bits(0x00000000), z: B32.from_bits(0x00000000), other_w: B32.from_bits(0x3F7FF972), other_x: B32.from_bits(0x3C23D70A), other_y: B32.from_bits(0x00000000), other_z: B32.from_bits(0x00000000)))
    show_b32(label: "q128 norm 1",
        v: q128_norm(w: B32.from_bits(0x3F000000), x: B32.from_bits(0xBF000000), y: B32.from_bits(0x3F000000), z: B32.from_bits(0xBF000000)))
    show_b32(label: "q128 abs 1",
        v: q128_abs(w: B32.from_bits(0x3F000000), x: B32.from_bits(0xBF000000), y: B32.from_bits(0x3F000000), z: B32.from_bits(0xBF000000)))
    show_b32_words(label: "q128 normalize 1",
        w: q128_normalize(w: B32.from_bits(0x3F000000), x: B32.from_bits(0xBF000000), y: B32.from_bits(0x3F000000), z: B32.from_bits(0xBF000000)))
    show_b32_words(label: "q128 reciprocal 1",
        w: q128_reciprocal(w: B32.from_bits(0x3F000000), x: B32.from_bits(0xBF000000), y: B32.from_bits(0x3F000000), z: B32.from_bits(0xBF000000)))
    show_bool(label: "q128 is_unit 1",
        v: q128_is_unit(w: B32.from_bits(0x3F000000), x: B32.from_bits(0xBF000000), y: B32.from_bits(0x3F000000), z: B32.from_bits(0xBF000000)))
    show_b32_words(label: "q128 mul 1 0",
        w: q128_mul(w: B32.from_bits(0x3F000000), x: B32.from_bits(0xBF000000), y: B32.from_bits(0x3F000000), z: B32.from_bits(0xBF000000), other_w: B32.from_bits(0x3F800000), other_x: B32.from_bits(0x00000000), other_y: B32.from_bits(0x00000000), other_z: B32.from_bits(0x00000000)))
    show_b32_words(label: "q128 div 1 0",
        w: q128_div(w: B32.from_bits(0x3F000000), x: B32.from_bits(0xBF000000), y: B32.from_bits(0x3F000000), z: B32.from_bits(0xBF000000), other_w: B32.from_bits(0x3F800000), other_x: B32.from_bits(0x00000000), other_y: B32.from_bits(0x00000000), other_z: B32.from_bits(0x00000000)))
    show_b32(label: "q128 dot 1 0",
        v: q128_dot(w: B32.from_bits(0x3F000000), x: B32.from_bits(0xBF000000), y: B32.from_bits(0x3F000000), z: B32.from_bits(0xBF000000), other_w: B32.from_bits(0x3F800000), other_x: B32.from_bits(0x00000000), other_y: B32.from_bits(0x00000000), other_z: B32.from_bits(0x00000000)))
    show_b32_words(label: "q128 mul 1 1",
        w: q128_mul(w: B32.from_bits(0x3F000000), x: B32.from_bits(0xBF000000), y: B32.from_bits(0x3F000000), z: B32.from_bits(0xBF000000), other_w: B32.from_bits(0x3F000000), other_x: B32.from_bits(0xBF000000), other_y: B32.from_bits(0x3F000000), other_z: B32.from_bits(0xBF000000)))
    show_b32_words(label: "q128 div 1 1",
        w: q128_div(w: B32.from_bits(0x3F000000), x: B32.from_bits(0xBF000000), y: B32.from_bits(0x3F000000), z: B32.from_bits(0xBF000000), other_w: B32.from_bits(0x3F000000), other_x: B32.from_bits(0xBF000000), other_y: B32.from_bits(0x3F000000), other_z: B32.from_bits(0xBF000000)))
