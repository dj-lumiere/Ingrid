# RazorForge coroutines (coro.te) without running one: the test makes a coroutine control block the running one
# and works its cancellation shadow stack. Two frames push and pop in order, an unbalanced pop leaves the stack as
# it is, and a pop of a null frame (which push never links) on the empty stack does nothing. It used to read the
# null frame's link, since the empty stack's top is null too.

module Ingrid/Runtime

import Standard/Format
import Standard/Os

# -- what coro.te calls in the rest of the runtime library -------------------------

### The scheduler a coroutine was spawned on (sched.te): only named here, through the control block's `home`.
record Sched
    id: U64

@external("c")
@symbol("calloc")
routine c_calloc(count: USize, size: USize) -> Addr

@external("c")
@symbol("free")
routine c_free(ptr: Addr) -> None

### count zeroed Ts.
routine zeroed[T](count: USize, what: CStr) -> @T
needs T: typename
    p: Addr = c_calloc(count, sizeof[T]())
    return p.to[@T]()

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

@noreturn
routine rf_throw(error_type: CStr, message: CStr) -> None
    Out.write("rf_throw\n")
    exit(1)

routine rf_current_thread_id() -> U64
    return 1

# -- the shadow stack ----------------------------------------------------------------

### The depth of the running coroutine's shadow stack.
routine depth(coro: @Coro) -> USize
    local found: @USize <- 0

    until f.is_null() with f: @CancelFrame = coro.cf_top.peek()
        (found.peek() + 1).poke_into(found)
        continue with f: f.prev.peek()
    then
        return found.peek()

### Destroys nothing: the frames' values are never abandoned here.
routine keep(value: Addr) -> None
    return

routine start() -> None
    local coro: @Coro = zeroed[Coro](count: 1, what: "coroutine")
    local first: @CancelFrame <- .hollow()
    local second: @CancelFrame <- .hollow()

    CURRENT_CORO.poke(coro)
    rf_coro_cf_pop(null)
    Out.write("pop of null on the empty stack: depth {depth(coro)}\n")
    rf_coro_cf_push(frame: first, value_ptr: null, destroy_fn: keep.to[Callable]())
    rf_coro_cf_push(frame: second, value_ptr: null, destroy_fn: keep.to[Callable]())
    Out.write("after two pushes: depth {depth(coro)}\n")
    rf_coro_cf_pop(first)
    Out.write("after an unbalanced pop: depth {depth(coro)}\n")
    rf_coro_cf_pop(null)
    Out.write("after a pop of null: depth {depth(coro)}\n")
    rf_coro_cf_pop(second)
    rf_coro_cf_pop(first)
    Out.write("after both pops: depth {depth(coro)}\n")
    rf_coro_cf_pop(null)
    Out.write("pop of null on the empty stack again: depth {depth(coro)}\n")
    CURRENT_CORO.poke(null)
    c_free(coro)
    return
