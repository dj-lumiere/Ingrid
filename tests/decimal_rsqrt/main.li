# 1 / sqrt of D32, D64, D128, and Decimal, rounded once to 7, 16, and 34 digits. Each width has a value whose
# reciprocal square root is exactly halfway between two neighbours: 1 / sqrt(0.04194304) is 4.8828125 (5^11 / 10^7),
# 1 / sqrt(0.0281474976710656) is 5.9604644775390625 (5^24 / 10^16), and 1 / sqrt(0.316912650057057350374175801344)
# is 1.7763568394002504646778106689453125 (5^49 / 10^34). D32, D64, and D128 round such a tie to the even
# neighbour, Decimal half up. The other lines are exact powers, the ends of each range (subnormals included), odd
# and even exponents, values next to 1, and the special values of the unchecked forms. decimal_rsqrt.expected holds
# the results, checked against Python's decimal module at 200 digits.

import Hosted
import Ingrid/Decimal

### Shows 1 / sqrt of a D32 read from text.
### :param text: The argument.
routine show32(text: @[Byte]) -> None
    x: D32 = text.to[D32]()
    Console.show("d32 {text} {x.rsqrt_unchecked()}")
    return

### Shows 1 / sqrt of a D64 read from text.
### :param text: The argument.
routine show64(text: @[Byte]) -> None
    x: D64 = text.to[D64]()
    Console.show("d64 {text} {x.rsqrt_unchecked()}")
    return

### Shows 1 / sqrt of a D128 read from text.
### :param text: The argument.
routine show128(text: @[Byte]) -> None
    x: D128 = text.to[D128]()
    Console.show("d128 {text} {x.rsqrt_unchecked()}")
    return

### Shows 1 / sqrt of a Decimal read from text.
### :param text: The argument.
routine show_decimal(text: @[Byte]) -> None
    x: Decimal = text.to[Decimal]()
    Console.show("decimal {text} {x.rsqrt()}")
    return

### Prints the reciprocal square roots.
routine start() -> None
    show32("0.04194304")
    show32("4")
    show32("0.25")
    show32("100")
    show32("1000")
    show32("2")
    show32("3")
    show32("10")
    show32("0.1")
    show32("0.9999999")
    show32("1.000001")
    show32("1E-101")
    show32("9.999999E96")
    show32("1.234567E-95")
    show32("7654321")
    show32("0")
    show32("-0")
    show32("-1")
    show32("Infinity")
    show32("-Infinity")
    show32("NaN")
    show64("0.0281474976710656")
    show64("2")
    show64("3")
    show64("0.01")
    show64("1E-398")
    show64("9.999999999999999E384")
    show64("0.9999999999999999")
    show64("1.000000000000001")
    show64("123456789012345.6")
    show64("0")
    show64("-2")
    show128("0.316912650057057350374175801344")
    show128("2")
    show128("3")
    show128("1E-6176")
    show128("9.999999999999999999999999999999999E6144")
    show128("0.9999999999999999999999999999999999")
    show128("1.000000000000000000000000000000001")
    show128("1234567890123456789012345678901234")
    show128("16")
    show128("-0")
    show_decimal("0.316912650057057350374175801344")
    show_decimal("0.04194304")
    show_decimal("2")
    show_decimal("3")
    show_decimal("0.0001")
    show_decimal("1234567890123456789012345678901234")
    show_decimal("0.9999999999999999999999999999999999")
    return
