// The binary-float exports (Ingrid/tessera/binfloat.tess) on a few exact inputs each: every RazorForge library
// function of B16, B32, B64, and B128 as Ingrid hands it over. The B128 ones take each argument as its low and high
// 64 bits and hand the result back in Words, so this checks that wiring along with the argument order of pow,
// atan2, hypot, and fma. binfloat.expected holds the correctly rounded results (to nearest, ties to even), computed
// with mpmath at 800 bits.

import Standard::Format
import Standard::Os

/// Writes the label and the result's bits in hex.
routine show_f16(label: Bytes, r: F16) -> Void
    block entry()
        hex : Hex<U16> = Hex<U16> { value: r.bits() }
        Out.write("{label} -> ")
        represent_with_into(Out.writer(), hex, FormatSpec.zero_padded(4))
        Out.write("\n")
        return()

/// Writes the label and the result's bits in hex.
routine show_f32(label: Bytes, r: F32) -> Void
    block entry()
        hex : Hex<U32> = Hex<U32> { value: r.bits() }
        Out.write("{label} -> ")
        represent_with_into(Out.writer(), hex, FormatSpec.zero_padded(8))
        Out.write("\n")
        return()

/// Writes the label and the result's bits in hex.
routine show_f64(label: Bytes, r: F64) -> Void
    block entry()
        hex : Hex<U64> = Hex<U64> { value: r.bits() }
        Out.write("{label} -> ")
        represent_with_into(Out.writer(), hex, FormatSpec.zero_padded(16))
        Out.write("\n")
        return()

/// Writes two 64-bit words as one 128-bit hex number, high word first.
routine write_f128(low: U64, high: U64) -> Void
    block entry()
        high_hex : Hex<U64> = Hex<U64> { value: high }
        low_hex  : Hex<U64> = Hex<U64> { value: low }
        represent_with_into(Out.writer(), high_hex, FormatSpec.zero_padded(16))
        represent_with_into(Out.writer(), low_hex, FormatSpec.zero_padded(16))
        return()

/// Writes the label and the F128 an export hands back in w0 (low) and w1 (high).
routine show_f128(label: Bytes, w: Words) -> Void
    block entry()
        Out.write("{label} -> ")
        write_f128(w.w0, w.w1)
        Out.write("\n")
        return()

/// Writes the label and the two F128s an export hands back: w0 and w1, then w2 and w3.
routine show_pair(label: Bytes, w: Words) -> Void
    block entry()
        Out.write("{label} -> ")
        write_f128(w.w0, w.w1)
        Out.write(" ")
        write_f128(w.w2, w.w3)
        Out.write("\n")
        return()

routine main() -> S32
    block entry()
        show_f16("b16 exp 3800", b16_exp(F16.from_bits(0x3800)))
        show_f16("b16 exp ba00", b16_exp(F16.from_bits(0xBA00)))
        show_f16("b16 exp 3e00", b16_exp(F16.from_bits(0x3E00)))
