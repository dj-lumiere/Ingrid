# The binary-float exports (Ingrid/tessera/binfloat.te) on a few exact inputs each: every RazorForge library
# function of B16, B32, B64, and B128 as Ingrid hands it over. The B128 ones take each argument as its low and high
# 64 bits and hand the result back in Words, so this checks that wiring along with the argument order of pow,
# atan2, hypot, and fma. binfloat.expected holds the correctly rounded results (to nearest, ties to even), computed
# with mpmath at 800 bits.

import Standard/Format
import Standard/Os

### Writes the label and the result's bits in hex.
routine show_b16(label: @[Byte], r: B16) -> None
    hex: Hex[U16] = Hex[U16](value: r.bits())
    Console.show("{label} -> ", end: "")
    represent_with_into(out: Console.output(), value: hex, spec: FormatSpec.zero_padded(4))
    Console.show("")
    return

### Writes the label and the result's bits in hex.
routine show_b32(label: @[Byte], r: B32) -> None
    hex: Hex[U32] = Hex[U32](value: r.bits())
    Console.show("{label} -> ", end: "")
    represent_with_into(out: Console.output(), value: hex, spec: FormatSpec.zero_padded(8))
    Console.show("")
    return

### Writes the label and the result's bits in hex.
routine show_b64(label: @[Byte], r: B64) -> None
    hex: Hex[U64] = Hex[U64](value: r.bits())
    Console.show("{label} -> ", end: "")
    represent_with_into(out: Console.output(), value: hex, spec: FormatSpec.zero_padded(16))
    Console.show("")
    return

### Writes two 64-bit words as one 128-bit hex number, high word first.
routine write_b128(low: U64, high: U64) -> None
    high_hex: Hex[U64] = Hex[U64](value: high)
    low_hex: Hex[U64] = Hex[U64](value: low)
    represent_with_into(out: Console.output(), value: high_hex, spec: FormatSpec.zero_padded(16))
    represent_with_into(out: Console.output(), value: low_hex, spec: FormatSpec.zero_padded(16))
    return

### Writes the label and the B128 an export hands back in w0 (low) and w1 (high).
routine show_b128(label: @[Byte], w: Words) -> None
    Console.show("{label} -> ", end: "")
    write_b128(low: w.w0, high: w.w1)
    Console.show("")
    return

### Writes the label and the two B128s an export hands back: w0 and w1, then w2 and w3.
routine show_pair(label: @[Byte], w: Words) -> None
    Console.show("{label} -> ", end: "")
    write_b128(low: w.w0, high: w.w1)
    Console.show(" ", end: "")
    write_b128(low: w.w2, high: w.w3)
    Console.show("")
    return

routine start() -> None
    show_b16(label: "b16 exp 3800", r: b16_exp(B16.from_bits(0x3800)))
    show_b16(label: "b16 exp ba00", r: b16_exp(B16.from_bits(0xBA00)))
