// splitmix64 as a generator: the state steps by the golden gamma, and each output is Ingrid's mixer of the state
// before the step (the mixer adds the gamma itself). From seed 0 the first output is the well-known
// 0xe220a8397b1dcdaf. The rest are checked against a Python model.

import Standard::Format
import Standard::Os

preset GAMMA: U64 = 0x9E3779B97F4A7C15

/// Writes a U64 as 16 lowercase hex digits.
routine write_word(value: U64) -> Void
    block entry()
        hex : Hex<U64> = Hex<U64> { value: value }
        represent_with_into(Out.shared(), hex, FormatSpec.zero_padded(16))
        return()

/// Writes the first `count` outputs of the generator seeded with `seed`.
routine run_sequence(seed: U64, count: U64) -> Void
    block entry()
        jump step(seed, 0)

    block step(state: U64, i: U64)
        branch i.ge(count)
            ? return()
            : continue
        Out.write("seed ")
        write_word(seed)
        Out.write(" #{i}: ")
        write_word(splitmix64(state))
        Out.write("\n")
        jump step(state.add_wrap(GAMMA), i.add(1))

routine main() -> S32
    block entry()
        run_sequence(0, 5)
        run_sequence(0x123456789ABCDEF0, 5)
        Out.write("mix ")
        write_word(U64.MAX)
        Out.write(": ")
        write_word(splitmix64(U64.MAX))
        Out.write("\n")
        return(0)
