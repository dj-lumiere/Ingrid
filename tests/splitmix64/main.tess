// splitmix64 as a generator: the state steps by the golden gamma, and each output is Ingrid's mixer of the state
// before the step (the mixer adds the gamma itself). From seed 0 the first output is the well-known
// 0xe220a8397b1dcdaf. The rest are checked against a Python model.

import Standard/Format
import Standard/Os

preset GAMMA: U64 = 0x9E3779B97F4A7C15

/// Writes a U64 as 16 lowercase hex digits.
routine write_word(value: U64) -> None
    hex: Hex[U64] = Hex[U64](value: value)
    represent_with_into(out: Out.writer(), value: hex, spec: FormatSpec.zero_padded(16))
    return

/// Writes the first `count` outputs of the generator seeded with `seed`.
routine run_sequence(seed: U64, count: U64) -> None
    local state: @U64 <- seed

    each i in 0 til count
        Out.write("seed ")
        write_word(seed)
        Out.write(" #{i}: ")
        write_word(splitmix64(state.peek()))
        Out.write("\n")
        (state.peek() +% GAMMA).poke_into(state)
    then
        return

routine start() -> None
    run_sequence(seed: 0, count: 5)
    run_sequence(seed: 0x123456789ABCDEF0, count: 5)
    Out.write("mix ")
    write_word(U64.MAX)
    Out.write(": ")
    write_word(splitmix64(U64.MAX))
    Out.write("\n")
    return
