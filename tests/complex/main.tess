// The complex routines of Ingrid/tessera/complex.tess through their exports, as RazorForge calls them, for C64,
// C128, and C256: every function on parts that cross both branch cuts and both signed zeros, products, quotients,
// and powers, integer powers (negative ones go through the reciprocal), and polar construction. Each line is the
// result's bits in decimal, the real part first. The expected output is RazorForge's own C64.rf, C128.rf, and
// C256.rf before their bodies moved here (B128.log_unchecked(+0) corrected to -infinity), so these lines lock the
// port to the same bits.

import Standard::Format
import Standard::Os

/// Writes a C64 result: the real part's bits, then the imaginary part's.
routine show_c64(label: Bytes, bits: U64) -> Void
    block entry()
        re : U32 = bits.to_wrap<U32>()
        im : U32 = bits.shr(32).to_wrap<U32>()
        Out.write("{label} {re} {im}\n")
        return()

/// Writes a C128 result.
routine show_c128(label: Bytes, w: Words) -> Void
    block entry()
        Out.write("{label} {w.w0} {w.w1}\n")
        return()

/// Writes a C256 result.
routine show_c256(label: Bytes, z: C256) -> Void
    block entry()
        re : U128 = z.real.bits()
        im : U128 = z.imag.bits()
        Out.write("{label} {re} {im}\n")
        return()

/// Writes an F32 result's bits.
routine show_f32(label: Bytes, v: F32) -> Void
    block entry()
        Out.write("{label} {v.bits()}\n")
        return()

/// Writes an F64 result's bits.
routine show_f64(label: Bytes, v: F64) -> Void
    block entry()
        Out.write("{label} {v.bits()}\n")
        return()

/// Writes the bits of an F128 handed back in Words.
routine show_f128_words(label: Bytes, w: Words) -> Void
    block entry()
        bits : U128 = f128_from_halves(w.w0, w.w1).bits()
        Out.write("{label} {bits}\n")
        return()

