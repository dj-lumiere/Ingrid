# The complex routines of Ingrid/tessera/complex.te through their exports, as RazorForge calls them, for C64,
# C128, and C256: every function on parts that cross both branch cuts and both signed zeros, products, quotients,
# and powers, integer powers (negative ones go through the reciprocal), and polar construction. Each line is the
# result's bits in decimal, the real part first. The products, quotients, reciprocals, squared moduli, and moduli are
# rounded once and were checked bit for bit against exact rational arithmetic, and the elementary functions against a
# high-precision reference on their principal branches (within 5 units in the last place of the larger part, signed
# zeros as C99's Annex G gives them), with RazorForge's scripts/gen_complex_crosscheck.py.

import Hosted
import Ingrid/Abi

### Writes a C64 result: the real part's bits, then the imaginary part's.
routine show_c64(label: @[Byte], bits: U64) -> None
    re: U32 = bits.to_wrap[U32]()
    im: U32 = (bits >> 32).to_wrap[U32]()
    Console.show("{label} {re} {im}")
    return

### Writes a C128 result.
routine show_c128(label: @[Byte], w: Words) -> None
    Console.show("{label} {w.w0} {w.w1}")
    return

### Writes a C256 result.
routine show_c256(label: @[Byte], z: C256) -> None
    re: U128 = z.real.bits()
    im: U128 = z.imag.bits()
    Console.show("{label} {re} {im}")
    return

### Writes a B32 result's bits.
routine show_b32(label: @[Byte], v: B32) -> None
    Console.show("{label} {v.bits()}")
    return

### Writes a B64 result's bits.
routine show_b64(label: @[Byte], v: B64) -> None
    Console.show("{label} {v.bits()}")
    return

### Writes the bits of a B128 handed back in Words.
routine show_b128_words(label: @[Byte], w: Words) -> None
    bits: U128 = b128_from_halves(low: w.w0, high: w.w1).bits()
    Console.show("{label} {bits}")
    return

