# The reciprocal of 0 + 0i is 1 / 0, which crashes with RazorForge's DivisionByZeroError, as real 1 / 0 does
# (complex.te and finite.te). The program's own crash handler writes the crash's name and message to standard
# output and exits with status 82, RazorForge's crash status.

import Standard/Format
import Standard/Os

@export("tessera_crash_handler")
@noreturn
routine report(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    Console.show("{name}: {message}")
    ProcessManager.exit_process(82)

routine start() -> None
    Console.show("before")
    inverse: Words = c128_reciprocal(real: 0.0, imag: 0.0)
    Console.show("not reached {inverse.w0}")
    return
