# Revare files (files.lpa) hand a result back as a block that holds its own byte count and mapping delta. Two threads
# interleave here, step by step: each makes a result with a delta, the other makes its own in between, and each still
# reads its own length and delta from its own block. A length or delta kept in a global (per thread or not) would be
# the other one's after a fiber moves between threads.

module Ingrid/Runtime

import Hosted

### The step the two threads have reached: each waits for its turn.
global STEP: &U32

# -- what files.lpa calls in the rest of the runtime library ------------------------

@external("c")
@symbol("free")
routine c_free(ptr: Addr) -> None

@external("c")
@symbol("malloc")
routine c_malloc(size: CSize) -> Addr

@external("c")
@symbol("realloc")
routine c_realloc(ptr: Addr, size: CSize) -> Addr

@external("c")
@symbol("memcpy")
routine c_memcpy(dst: Addr, src: Addr, n: CSize) -> Addr

# -- the two threads -----------------------------------------------------------------

### Spins until STEP is `step`.
routine wait_for_step(step: U32) -> None
    until STEP.peek_unbroken() == step
        nothing
    then
        return

### Word `index` of a result block.
### :param blk: The block.
### :param index: The word.
### :returns: Its value.
routine word_of(blk: @Byte, index: U64) -> U64
    return blk.to[@U64]().stride(index).peek_unaligned()

### The second thread: makes its result and delta between the first thread's call and its read.
routine second(unused: @U32) -> None
    wait_for_step(1)
    buf: @Byte = bytes_result(s: "nine byte", len: 9).unwrap()
    put_word(buf.to[Addr](), 2, 900)
    c_free(buf)
    STEP.poke_unbroken(2)
    return

routine start() -> None
    unused: &U32 <- 0

    other: Thread[None] <- get_thread[None]()
    work_other: Work[None] = second.to[Work](unused: unused)
    other.put_work(work_other)
    buf: @Byte = bytes_result(s: "five!", len: 5).unwrap()
    put_word(buf.to[Addr](), 2, 500)
    STEP.poke_unbroken(1)
    wait_for_step(2)
    len: U64 = word_of(buf, 1)
    delta: U64 = word_of(buf, 2)
    other.retrieve()
    drop other
    c_free(buf)
    Console.show("this thread's result length: {len}, mapping delta: {delta}")
    return
