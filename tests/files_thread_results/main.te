# RazorForge files (files.te) hand a result's length back through rf_get_result_len and a mapping's delta through
# rf_file_map_delta, read right after the call that set them. Two threads interleave here, step by step: each makes
# a result (and records a delta), the other makes its own in between, and each still reads its own length and delta.
# With one process-wide length and delta, the first thread read the second one's.

module Ingrid/Runtime

import Hosted

### The step the two threads have reached: each waits for its turn.
global STEP: &U32

# -- what files.te calls in the rest of the runtime library ------------------------

@external("c")
@symbol("free")
routine c_free(ptr: Addr) -> None

@external("c")
@symbol("malloc")
routine c_malloc(size: CSize) -> Addr

@external("c")
@symbol("realloc")
routine c_realloc(ptr: Addr, size: CSize) -> Addr

@external("c")
@symbol("memcpy")
routine c_memcpy(dst: Addr, src: Addr, n: CSize) -> Addr

# -- the two threads -----------------------------------------------------------------

### Spins until STEP is `step`.
routine wait_for_step(step: U32) -> None
    until STEP.peek_unbroken() == step
        nothing
    then
        return

### The second thread: makes its result and delta between the first thread's call and its read.
routine second(unused: @U32) -> None
    wait_for_step(1)
    buf: @Byte = bytes_result(s: "nine byte", len: 9)
    MAP_DELTA.poke(900)
    c_free(buf)
    STEP.poke_unbroken(2)
    return

routine start() -> None
    unused: &U32 <- 0

    other: Thread[None] <- get_thread[None]()
    work_other: Work[None] = second.to[Work](unused: unused)
    other.put_work(work_other)
    buf: @Byte = bytes_result(s: "five!", len: 5)
    MAP_DELTA.poke(500)
    STEP.poke_unbroken(1)
    wait_for_step(2)
    len: U64 = rf_get_result_len()
    delta: U64 = rf_file_map_delta()
    other.retrieve()
    drop other
    c_free(buf)
    Console.show("this thread's result length: {len}, mapping delta: {delta}")
    return
