@external("c")
@symbol("ingrid_integer_pow")
routine c_integer_pow(a_neg: U64, a_len: U64, a_tab: @U64, e: U64, out: @U64, out_cap: U64,
    scratch: @U64, scratch_cap: U64) -> Words

### ingrid_integer_sqrtrem.
### :param a_len: a's limbs.
### :param a_tab: a's first limb.
### :param s_out: The root's buffer.
### :param s_cap: Its limbs.
### :param r_out: The remainder's buffer.
### :param r_cap: Its limbs.
### :param scratch: The scratch.
### :param scratch_cap: Its limbs.
### :returns: The status, the root's length, and the remainder's length.
@external("c")
@symbol("ingrid_integer_sqrtrem")
routine c_integer_sqrtrem(a_len: U64, a_tab: @U64, s_out: @U64, s_cap: U64, r_out: @U64, r_cap: U64,
    scratch: @U64, scratch_cap: U64) -> Words

### ingrid_integer_gcd.
### :param a_len: a's limbs.
### :param a_tab: a's first limb.
### :param b_len: b's limbs.
### :param b_tab: b's first limb.
### :param out: The result buffer.
### :param out_cap: Its limbs.
### :param scratch: The scratch.
### :param scratch_cap: Its limbs.
### :returns: The status and the result's length.
@external("c")
@symbol("ingrid_integer_gcd")
routine c_integer_gcd(a_len: U64, a_tab: @U64, b_len: U64, b_tab: @U64, out: @U64, out_cap: U64,
    scratch: @U64, scratch_cap: U64) -> Words

### ingrid_integer_lcm.
### :param a_len: a's limbs.
### :param a_tab: a's first limb.
### :param b_len: b's limbs.
### :param b_tab: b's first limb.
### :param out: The result buffer.
### :param out_cap: Its limbs.
### :param scratch: The scratch.
### :param scratch_cap: Its limbs.
### :returns: The status and the result's length.
@external("c")
@symbol("ingrid_integer_lcm")
routine c_integer_lcm(a_len: U64, a_tab: @U64, b_len: U64, b_tab: @U64, out: @U64, out_cap: U64,
    scratch: @U64, scratch_cap: U64) -> Words

### ingrid_integer_compare.
### :param a_neg: 1 when a is negative.
### :param a_len: a's limbs.
### :param a_tab: a's first limb.
### :param b_neg: 1 when b is negative.
### :param b_len: b's limbs.
### :param b_tab: b's first limb.
### :returns: -1, 0 or 1.
@external("c")
@symbol("ingrid_integer_compare")
routine c_integer_compare(a_neg: U64, a_len: U64, a_tab: @U64, b_neg: U64, b_len: U64,
    b_tab: @U64) -> S64

### ingrid_integer_to_text.
### :param a_neg: 1 when a is negative.
### :param a_len: a's limbs.
### :param a_tab: a's first limb.
### :param radix: The radix.
### :param out: The characters.
### :param out_cap: Their room.
### :param scratch: The scratch.
### :param scratch_cap: Its limbs.
### :returns: The status and the character count.
@external("c")
@symbol("ingrid_integer_to_text")
routine c_integer_to_text(a_neg: U64, a_len: U64, a_tab: @U64, radix: U64, out: @U32, out_cap: U64,
    scratch: @U64, scratch_cap: U64) -> Words

### ingrid_integer_parse.
### :param chars: The characters.
### :param count: How many.
### :param radix: The radix.
### :param out: The result buffer.
### :param out_cap: Its limbs.
### :param scratch: The scratch.
### :param scratch_cap: Its limbs.
### :returns: The status, the value's length and sign, and 1 when the text is an integer.
@external("c")
@symbol("ingrid_integer_parse")
routine c_integer_parse(chars: @U32, count: U64, radix: U64, out: @U64, out_cap: U64, scratch: @U64,
    scratch_cap: U64) -> Words

### The next word of the generator, as RazorForge's C/ingrid_splitmix64 steps it.
### :returns: The next word.
routine draw() -> U64
    next: U64 = splitmix64(STATE.peek())
    next.poke_into(STATE)
    return next

### A random limb: zero, all ones, one bit, or random bits, as the kind drawn first says.
### :returns: The limb.
routine draw_limb() -> U64
    kind: U64 = draw() & 7
    value: U64 = draw()

    when kind
        0 => return 0
        1 => return 0xFFFFFFFFFFFFFFFF
        2 => return U64.shift_left(1, value & 63)
        else => return value

### Fills `count` random limbs at `tab`.
### :param tab: The first limb.
### :param count: How many.
routine fill_limbs(tab: @U64, count: U64) -> None
    each i in 0 til count
        tab.stride(i.to[U64]()).poke(draw_limb())
    then
        return

### A random integer at `tab`: 0 to 9 limbs, or 0 to 159 one time in eight, the top one nonzero, with a random sign.
### :param tab: Where its limbs go.
### :returns: Its length and sign word (1 when negative).
routine draw_integer(tab: @U64) -> (U64, U64)
    wide: Bool = draw() % 8 == 0
    len: U64 = when
        wide => draw() % 160
        else => draw() % 10
    fill_limbs(tab, count: len)
    if not (len == 0)
        top: @U64 = tab.stride((len - 1).to[U64]())
        if top.peek() == 0
            (draw() | 1).poke_into(top)
    neg: U64 = draw() & 1
    return (len, neg)

### A mix of `count` limbs at `tab`.
### :param tab: The first limb.
### :param count: How many.
### :returns: The mix.
routine mix(tab: @U64, count: U64) -> U64
    h: &U64 <- 0x243F6A8885A308D3

    each i in 0 til count
        limb: U64 = tab.stride(i.to[U64]()).peek()
        mixed: U64 = (h.load() ^ limb) *% 0x100000001B3
        (mixed ^ (mixed >> 29)).poke_into(h)
    then
        return h.load()

### A mix of `count` code points at `chars`.
### :param chars: The first.
### :param count: How many.
### :returns: The mix.
routine mix_text(chars: @U32, count: U64) -> U64
    h: &U64 <- 0x243F6A8885A308D3

    each i in 0 til count
        point: U64 = chars.stride(i.to[U64]()).peek().to[U64]()
        mixed: U64 = (h.load() ^ point) *% 0x100000001B3
        (mixed ^ (mixed >> 29)).poke_into(h)
    then
        return h.load()

### Prints an integer result: ` label status/sign/length:mix`.
### :param label: What it is.
### :param words: What the call returned.
### :param tab: Its limbs.
routine show_integer(label: @[Byte], words: Words, tab: @U64) -> None
    h: U64 = mix(tab, count: words.w1)
    Console.show(" {label} {words.w0}/{words.w2}/{words.w1}:{h}", end: "")
    return

### One pair of integers through every Int export.
### :param i: The pair's number.
routine integer_pair(i: U64) -> None
    a: (U64, U64) = draw_integer(A.getview().to[@U64]())
    b: (U64, U64) = draw_integer(B.getview().to[@U64]())
    a_tab: @U64 = A.getview().to[@U64]()
    b_tab: @U64 = B.getview().to[@U64]()
    out: @U64 = OUT.getview().to[@U64]()
    out2: @U64 = OUT2.getview().to[@U64]()
    room: @U64 = SCRATCH.getview().to[@U64]()
    text: @U32 = TEXT.getview().to[@U32]()
    shift: U64 = draw() % 200
    expo: U64 = draw() % 20
    radixes: Items[U64, 5] = [2, 10, 16, 36, 64]
    radix: U64 = radixes[(i % 5).to[U64]()]

    ha: U64 = mix(tab: a_tab, count: a.item0)
    hb: U64 = mix(tab: b_tab, count: b.item0)
    Console.show("int {i} a {a.item1}/{a.item0}:{ha} b {b.item1}/{b.item0}:{hb}")
    sum: Words = c_integer_add(a.item1, a.item0, a_tab, b.item1, b.item0, b_tab, out, OUT_ROOM)
    show_integer(label: "add", words: sum, tab: out)
    product: Words = c_integer_mul(a.item1, a.item0, a_tab, b.item1, b.item0, b_tab, out, OUT_ROOM,
        room, SCRATCH_ROOM)
    show_integer(label: "mul", words: product, tab: out)
    Console.show("")
    if not (b.item0 == 0)
        qr: Words = c_integer_divmod(a.item1, a.item0, a_tab, b.item1, b.item0, b_tab, out,
            OUT_ROOM, out2, OUT_ROOM, room, SCRATCH_ROOM)
        hq: U64 = mix(tab: out, count: qr.w1)
        hr: U64 = mix(tab: out2, count: qr.w3)
        Console.show(" divmod {qr.w0}/{qr.w2}/{qr.w1}:{hq} {qr.w3}:{hr}")
    left: Words = c_integer_shift_left(a.item1, a.item0, a_tab, shift, out, OUT_ROOM)
    show_integer(label: "shl", words: left, tab: out)
    right: Words = c_integer_shift_right(a.item1, a.item0, a_tab, shift, out, OUT_ROOM)
    show_integer(label: "shr", words: right, tab: out)
    both: Words = c_integer_and(a.item1, a.item0, a_tab, b.item1, b.item0, b_tab, out, OUT_ROOM)
    show_integer(label: "and", words: both, tab: out)
    either: Words = c_integer_or(a.item1, a.item0, a_tab, b.item1, b.item0, b_tab, out, OUT_ROOM)
    show_integer(label: "or", words: either, tab: out)
    one: Words = c_integer_xor(a.item1, a.item0, a_tab, b.item1, b.item0, b_tab, out, OUT_ROOM)
    show_integer(label: "xor", words: one, tab: out)
    order: S64 = c_integer_compare(a.item1, a.item0, a_tab, b.item1, b.item0, b_tab)
    Console.show(" cmp {order}")
    divisor: Words = c_integer_gcd(a.item0, a_tab, b.item0, b_tab, out, OUT_ROOM, room,
        SCRATCH_ROOM)
    show_integer(label: "gcd", words: divisor, tab: out)
    multiple: Words = c_integer_lcm(a.item0, a_tab, b.item0, b_tab, out, OUT_ROOM, room,
        SCRATCH_ROOM)
    show_integer(label: "lcm", words: multiple, tab: out)
    root: Words = c_integer_sqrtrem(a.item0, a_tab, out, OUT_ROOM, out2, OUT_ROOM, room,
        SCRATCH_ROOM)
    hs: U64 = mix(tab: out, count: root.w1)
    hm: U64 = mix(tab: out2, count: root.w3)
    Console.show(" sqrtrem {root.w0}/{root.w1}:{hs} {root.w3}:{hm}")
    if not (a.item0 > 2)
        power: Words = c_integer_pow(a.item1, a.item0, a_tab, expo, out, OUT_ROOM, room,
            SCRATCH_ROOM)
        show_integer(label: "pow", words: power, tab: out)
        Console.show("")
    written: Words = c_integer_to_text(a.item1, a.item0, a_tab, radix, text, TEXT_ROOM, room,
        SCRATCH_ROOM)
    ht: U64 = mix_text(chars: text, count: written.w1)
    back: Words = c_integer_parse(text, written.w1, radix, out, OUT_ROOM, room, SCRATCH_ROOM)
    Console.show(" text {radix} {written.w0}/{written.w1}:{ht} parse {back.w3}", end: "")
    show_integer(label: "=", words: back, tab: out)
    Console.show("")
    return

### The call protocol: a call with too little scratch, or too small a result buffer, says what it needs, and the
### retry with that much gives the same result.
routine protocol() -> None
    a_tab: @U64 = A.getview().to[@U64]()
    b_tab: @U64 = B.getview().to[@U64]()
    out: @U64 = OUT.getview().to[@U64]()
    room: @U64 = SCRATCH.getview().to[@U64]()

    fill_limbs(tab: a_tab, count: 150)
    fill_limbs(tab: b_tab, count: 140)
    a_tab.stride(149).poke(1)
    b_tab.stride(139).poke(1)
    size: U64 = c_integer_mul_scratch_size(150, 140)
    empty: Words = c_integer_mul(0, 150, a_tab, 1, 140, b_tab, out, OUT_ROOM, room, 0)
    Console.show(
        "protocol mul scratch 0: status {empty.w0}, needs some {empty.w1.gt(0)}, the size covers it ",
        end: "")
    Console.show("{size.ge(empty.w1)}")
    retry: Words = c_integer_mul(0, 150, a_tab, 1, 140, b_tab, out, OUT_ROOM, room, empty.w1)
    Console.show("protocol mul retry with what it needed: status {retry.w0}")
    short: Words = c_integer_mul(0, 150, a_tab, 1, 140, b_tab, out, 10, room, SCRATCH_ROOM)
    Console.show("protocol mul out 10: status {short.w0}, needs {short.w1}")
    fit: Words = c_integer_mul(0, 150, a_tab, 1, 140, b_tab, out, short.w1, room, SCRATCH_ROOM)
    show_integer(label: "protocol mul out fits:", words: fit, tab: out)
    Console.show("")
    return

### Runs every integer pair, then the call protocol.
routine start() -> None
    each i in 0 til INTEGERS
        integer_pair(i)
    `protocol`()
    return
