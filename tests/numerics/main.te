# Int (Ingrid/tessera/generated/numerics.te, written from RazorForge's engine) through the C ABI, as
# RazorForge calls it. numerics.expected holds what this engine computed when it moved here, after RazorForge
# programs gave the same results bit for bit with the engine running in RazorForge and running here. The
# operands come from splitmix64: integers of 0 to 159 limbs (zero, all-ones and one-bit limbs among random ones, either
# sign). Each result prints as its status, sign, length and a mix of its limbs. Last, the call protocol: a call with
# too little scratch or too small a result buffer says what it needs, and retrying with that gives the same result.

import Hosted
import Ingrid/Abi

global STATE: &U64 <- 0x0123456789ABCDEF
### The limbs of the first operand.
global A: &Items[U64, 256]
### The limbs of the second operand.
global B: &Items[U64, 256]
### A result's limbs.
global OUT: &Items[U64, 4096]
### A second result's limbs (a remainder).
global OUT2: &Items[U64, 4096]
### The scratch every call gets.
global SCRATCH: &Items[U64, 1048576]
### Text, one code point per element.
global TEXT: &Items[U32, 16384]

preset SCRATCH_ROOM: U64 = 1048576
preset OUT_ROOM: U64 = 4096
preset TEXT_ROOM: U64 = 16384
preset INTEGERS: U64 = 48
preset ONE: U64 = 1

# The engine's failure messages allocate through memory.te, whose OutOfMemoryError goes to the runtime library's
# __rf_throw. This program defines it: it writes the error to standard output and exits with status 82, as the
# runtime's crash does.
@export("__rf_throw")
@noreturn
routine stub_rf_throw(error_type: CStrView, message: CStrView) -> None
    kind: @[Byte] = error_type.getview()
    text: @[Byte] = message.getview()
    Console.show("{kind}: {text}")
    ProcessManager.exit_process(82)

### ingrid_integer_add.
### :param a_neg: 1 when a is negative.
### :param a_len: a's limbs.
### :param a_tab: a's first limb.
### :param b_neg: 1 when b is negative.
### :param b_len: b's limbs.
### :param b_tab: b's first limb.
### :param out: The result buffer.
### :param out_cap: Its limbs.
### :returns: The status and the result's length and sign.
@external("c")
@symbol("ingrid_integer_add")
routine c_integer_add(a_neg: U64, a_len: U64, a_tab: @U64, b_neg: U64, b_len: U64, b_tab: @U64,
    out: @U64, out_cap: U64) -> Words

### ingrid_integer_mul.
### :param a_neg: 1 when a is negative.
### :param a_len: a's limbs.
### :param a_tab: a's first limb.
### :param b_neg: 1 when b is negative.
### :param b_len: b's limbs.
### :param b_tab: b's first limb.
### :param out: The result buffer.
### :param out_cap: Its limbs.
### :param scratch: The scratch.
### :param scratch_cap: Its limbs.
### :returns: The status and the result's length and sign.
@external("c")
@symbol("ingrid_integer_mul")
routine c_integer_mul(a_neg: U64, a_len: U64, a_tab: @U64, b_neg: U64, b_len: U64, b_tab: @U64,
    out: @U64, out_cap: U64, scratch: @U64, scratch_cap: U64) -> Words

### ingrid_integer_mul_scratch_size.
### :param a_len: a's limbs.
### :param b_len: b's limbs.
### :returns: The scratch the product takes.
@external("c")
@symbol("ingrid_integer_mul_scratch_size")
routine c_integer_mul_scratch_size(a_len: U64, b_len: U64) -> U64

### ingrid_integer_divmod.
### :param a_neg: 1 when a is negative.
### :param a_len: a's limbs.
### :param a_tab: a's first limb.
### :param b_neg: 1 when b is negative.
### :param b_len: b's limbs.
### :param b_tab: b's first limb.
### :param q_out: The quotient's buffer.
### :param q_cap: Its limbs.
### :param r_out: The remainder's buffer.
### :param r_cap: Its limbs.
### :param scratch: The scratch.
### :param scratch_cap: Its limbs.
### :returns: The status, the quotient's length and sign, and the remainder's length.
@external("c")
@symbol("ingrid_integer_divmod")
routine c_integer_divmod(a_neg: U64, a_len: U64, a_tab: @U64, b_neg: U64, b_len: U64, b_tab: @U64,
    q_out: @U64, q_cap: U64, r_out: @U64, r_cap: U64, scratch: @U64, scratch_cap: U64) -> Words

### ingrid_integer_shift_left.
### :param a_neg: 1 when a is negative.
### :param a_len: a's limbs.
### :param a_tab: a's first limb.
### :param bits: The shift.
### :param out: The result buffer.
### :param out_cap: Its limbs.
### :returns: The status and the result's length and sign.
@external("c")
@symbol("ingrid_integer_shift_left")
routine c_integer_shift_left(a_neg: U64, a_len: U64, a_tab: @U64, bits: U64, out: @U64,
    out_cap: U64) -> Words

