#[external("c"), symbol("ingrid_integer_or")]
routine c_integer_or(a_neg: U64, a_len: U64, a_tab: @U64, b_neg: U64, b_len: U64, b_tab: @U64,
    out: @U64, out_cap: U64) -> Words

/// ingrid_integer_xor.
