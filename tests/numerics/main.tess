#[external("c"), symbol("ingrid_real_compare")]
routine c_real_compare(a_sign: U64, a_expn: S64, a_len: U64, a_tab: @U64, b_sign: U64, b_expn: S64,
    b_len: U64, b_tab: @U64) -> S64

