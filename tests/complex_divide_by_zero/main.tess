// Dividing a nonzero C128 by 0 + 0i crashes with NumericDomainError, as RazorForge's own C128 division did before
// it moved here: the textbook formula divides (ac + bd) = 0 by the squared modulus 0, which is 0 / 0, and RazorForge's
// checked B64 `/` calls that a domain error (complex.tess and finite.tess). The crash handler writes the crash's name
// to standard output and exits with status 82, RazorForge's crash status.

import Standard::Format
import Standard::Os

#[export("tessera_crash_handler"), noreturn]
routine report(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        Out.write("{name}: {message}\n")
        exit(82)

routine main() -> S32
    block entry()
        Out.write("before\n")
        q : Words = c128_div(1.0, 1.0, 0.0, 0.0)
        Out.write("not reached {q.w0}\n")
        return(0)
