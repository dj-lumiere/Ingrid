# Dividing a nonzero C128 by 0 + 0i crashes with DivisionByZeroError, as a nonzero real over zero does: the
# division checks for the zero divisor before the textbook formula, which would divide (ac + bd) = 0 by the
# squared modulus 0 (complex.tess and finite.tess). The crash handler writes the crash's name to standard output
# and exits with status 82, RazorForge's crash status.

import Standard/Format
import Standard/Os

@export("tessera_crash_handler")
@noreturn
routine report(name: Span[Byte], message: Span[Byte], place: @SourceLocation) -> None
    Out.write("{name}: {message}\n")
    exit(82)

routine start() -> None
    Out.write("before\n")
    q: Words = c128_div(real: 1.0, imag: 1.0, other_real: 0.0, other_imag: 0.0)
    Out.write("not reached {q.w0}\n")
    return
