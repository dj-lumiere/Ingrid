# Dividing a nonzero C128 by 0 + 0i crashes with DivisionByZeroError, as a nonzero real over zero does: the
# division checks for the zero divisor before the textbook formula, which would divide (ac + bd) = 0 by the
# squared modulus 0 (complex.te and finite.te). The crash handler writes the crash's name to standard output
# and exits with status 82, RazorForge's crash status.

import Standard/Os

@untraced
routine report(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}")
    ProcessManager.exit_process(82)

routine start() -> None
    Crash.report_with(report.to[Callable]())
    Console.show("before")
    q: Words = c128_div(real: 1.0, imag: 1.0, other_real: 0.0, other_imag: 0.0)
    Console.show("not reached {q.w0}")
    return
