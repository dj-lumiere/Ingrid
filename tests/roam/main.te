# The Roamed entity runtime on one thread, through its exported routines on headers laid out as RoamHeader: strong
# and weak counts and the teardown they trigger, the candidate report to the cycle collector, promotion of a graph to
# escaped, and the task-keyed lock (re-entry, release, and a contended entry that yields until the holder lets go).
#
# The runtime calls routines of the RazorForge runtime library, which this program defines itself: the current
# agent's id (always 7 here), the scheduler's yield, which counts its calls and, the first time, releases the lock
# that the contended entry waits on, as the holding agent would, and the AccessManager's record of a wait (nothing
# to record here).

import Standard/Os

### The header the contended lock entry waits on, released by the first yield.
global CONTENDED: @@RoamHeader <- .hollow()
### How many times the runtime yielded.
global YIELDS: @U64

### An entity: an id, and the header of the entity its one Roamed field holds (null for none).
record Node
    id: U64
    child: Addr

### Makes a `Node` from its fields.
### :param id: Its `id`.
### :param child: Its `child`.
### :returns: The new value.
common routine Node.construct(id: U64, child: Addr) -> Me
    return Me(id, child)

### Releases nothing: a `Node` holds no memory of its own.
routine @Node.destruct() -> None
    return

@export("rf_access_flow_id")
routine stub_current_task_id() -> U64
    return 7

@export("rf_coro_yield")
routine stub_coro_yield() -> None
    yields: U64 = YIELDS.peek() + 1
    yields.poke_into(YIELDS)
    waited: @RoamHeader = CONTENDED.peek()
    if waited.is_hollow()
        return
    waited.holder_task.poke_atomic(0)
    waited.locked.poke_atomic(0)
    CONTENDED.poke(.hollow())
    return

@export("rf_access_wait_begin")
routine stub_access_wait_begin(lock: Addr, holder: @U64) -> None
    return

@export("rf_access_wait_end")
routine stub_access_wait_end() -> None
    return

### The entity type's destroy routine: reports which entity went and frees it.
routine drop_node(subject: Addr) -> None
    node: @Node = subject.to[@Node]()
    id: U64 = node.id.peek()
    Console.show("  destroyed node {id}")
    local alloc: @MemoryManager <- C_HEAP.peek()
    deallocate(data: node, alloc)
    return

### The entity type's trace routine: hands the collector the header its Roamed field holds.
routine trace_node(subject: Addr) -> None
    node: @Node = subject.to[@Node]()
    child: Addr = node.child.peek()
    if child.to[@Byte]().is_hollow()
        return
    visit_child(child)
    return

### A new entity with one strong handle, from the C heap as the runtime frees it. A cyclic type has a trace routine.
routine new_entity(id: U64, child: Addr, cyclic: Bool) -> @RoamHeader
    local alloc: @MemoryManager <- C_HEAP.peek()

    node: @Node = allocate[Node](count: 1, alloc)
    header: @RoamHeader = allocate[RoamHeader](count: 1, alloc)
    id.poke_into(node.id)
    child.poke_into(node.child)
    trace: Addr = when
        cyclic => trace_node.addr()
        else => .hollow()
    header.poke(RoamHeader(count: 1, weak: 0, dead: 0, escaped: 0, data: node, locked: 0,
        holder_task: 0, depth: 0, state: 0, buffered: false, trace_hook: trace,
        free_hook: .hollow(), drop_hook: drop_node.addr(), shape_users: 0))
    return header

routine show_counts(label: @[Byte], header: @RoamHeader) -> None
    strong: U64 = roam_strong_count(header)
    weak: U64 = header.weak.peek()
    destroyed: Bool = roam_is_destroyed(header)
    Console.show("{label}: strong {strong}, weak {weak}, destroyed {destroyed}")
    return

routine show_lock(label: @[Byte], header: @RoamHeader) -> None
    locked: U8 = header.locked.peek()
    holder: U64 = header.holder_task.peek()
    depth: U64 = header.depth.peek()
    Console.show("{label}: locked {locked}, holder {holder}, depth {depth}")
    return

### hold and unhold on a local entity, the last unhold destroying it while a weak observer keeps the header.
routine counts() -> None
    Console.show("counts")
    a: @RoamHeader = new_entity(id: 1, child: .hollow(), cyclic: false)
    show_counts(label: "new", header: a)
    roam_hold(a)
    roam_hold(a)
    show_counts(label: "held twice", header: a)
    roam_unhold(a)
    show_counts(label: "released once", header: a)
    roam_observe(a)
    show_counts(label: "observed", header: a)
    roam_unhold(a)
    roam_unhold(a)
    show_counts(label: "released", header: a)
    roam_unobserve(a)
    Console.show("observer gone, header freed")
    b: @RoamHeader = new_entity(id: 2, child: .hollow(), cyclic: false)
    roam_unhold(b)
    Console.show("no observer, header freed with the entity")
    return

### A release that leaves a cyclic entity alive reports it to the collector once. An acyclic one is never reported.
routine candidates() -> None
    Console.show("candidates")
    acyclic: @RoamHeader = new_entity(id: 3, child: .hollow(), cyclic: false)
    cyclic: @RoamHeader = new_entity(id: 4, child: .hollow(), cyclic: true)
    roam_hold(acyclic)
    roam_unhold(acyclic)
    roam_hold(cyclic)
    roam_hold(cyclic)
    roam_unhold(cyclic)
    roam_unhold(cyclic)
    acyclic_buffered: Bool = acyclic.buffered.peek()
    cyclic_buffered: Bool = cyclic.buffered.peek()
    state: S32 = cyclic.state.peek()
    Console.show("acyclic buffered {acyclic_buffered}, cyclic buffered {cyclic_buffered}, state {state}")
    # The last release takes it out of the candidate buffer before freeing it.
    roam_unhold(cyclic)
    roam_unhold(acyclic)
    roots: U64 = ROOTS.count.peek()
    Console.show("candidates left: {roots}")
    return

### Promotion escapes the entity and everything it reaches. Counting goes atomic, and a second promotion stops at once.
routine promotion() -> None
    Console.show("promotion")
    leaf: @RoamHeader = new_entity(id: 6, child: .hollow(), cyclic: true)
    parent: @RoamHeader = new_entity(id: 5, child: leaf, cyclic: true)
    before: Bool = roam_is_escaped(parent)
    roam_promote(parent)
    roam_promote(parent)
    parent_escaped: Bool = roam_is_escaped(parent)
    leaf_escaped: Bool = roam_is_escaped(leaf)
    Console.show("escaped before {before}, parent {parent_escaped}, leaf {leaf_escaped}")
    roam_hold(parent)
    show_counts(label: "escaped, held", header: parent)
    roam_unhold(parent)
    show_counts(label: "escaped, released", header: parent)
    roam_unhold(leaf)
    roam_unhold(parent)
    return

### The lock does nothing on a local entity. On an escaped one it is reentrant for its task, and a contended entry
### yields until the holder releases it.
routine locking() -> None
    Console.show("lock")
    subject: @RoamHeader = new_entity(id: 7, child: .hollow(), cyclic: false)
    roam_lock_enter(subject)
    show_lock(label: "local entered", header: subject)
    roam_lock_exit(subject)
    roam_unhold(subject)
    promoted: @RoamHeader = new_entity(id: 8, child: .hollow(), cyclic: false)
    roam_promote(promoted)
    roam_lock_enter(promoted)
    show_lock(label: "entered", header: promoted)
    roam_lock_enter(promoted)
    show_lock(label: "re-entered", header: promoted)
    roam_lock_exit(promoted)
    show_lock(label: "left once", header: promoted)
    roam_lock_exit(promoted)
    show_lock(label: "left", header: promoted)
    promoted.locked.poke_atomic(1)
    promoted.holder_task.poke_atomic(9)
    1.poke_into(promoted.depth)
    CONTENDED.poke(promoted)
    roam_lock_enter(promoted)
    yields: U64 = YIELDS.peek()
    Console.show("yields: {yields}")
    show_lock(label: "taken after the holder left", header: promoted)
    roam_lock_exit(promoted)
    show_lock(label: "left", header: promoted)
    roam_unhold(promoted)
    return

routine start() -> None
    counts()
    candidates()
    promotion()
    locking()
    return
