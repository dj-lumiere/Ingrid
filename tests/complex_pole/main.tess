// The arctangent at i divides 2i by 0 + 0i (its denominator i - z is zero), a pole, which crashes with
// RazorForge's DivisionByZeroError, as a nonzero real over zero does (complex.tess and finite.tess). The program's
// own crash handler writes the crash's name and message to standard output and exits with status 82, RazorForge's
// crash status.

import Standard/Format
import Standard/Os

#[export("tessera_crash_handler"), noreturn]
routine report(name: Span[Byte], message: Span[Byte], place: @SourceLocation) -> Void
    Out.write("{name}: {message}\n")
    exit(82)

routine start() -> Void
    Out.write("before\n")
    angle: Words = c128_atan(real: 0.0, imag: 1.0)
    Out.write("not reached {angle.w0}\n")
    return()
