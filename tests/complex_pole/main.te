# The arctangent at i divides 2i by 0 + 0i (its denominator i - z is zero), a pole, which crashes with
# RazorForge's DivisionByZeroError, as a nonzero real over zero does (complex.te and finite.te). The program's
# own crash handler writes the crash's name and message to standard output and exits with status 82, RazorForge's
# crash status.

import Ingrid/Abi
import Hosted

@untraced
routine report(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}")
    ProcessManager.exit_process(82)

routine start() -> None
    Crash.report_with(report.to[Callable]())
    Console.show("before")
    angle: Words = c128_atan(real: 0.0, imag: 1.0)
    Console.show("not reached {angle.w0}")
    return
