# Decimal.rsqrt below zero crashes with NumericDomainError, as Decimal.sqrt does. The program's own crash handler
# writes the crash's name and message to standard output and exits with status 82.

import Hosted
import Ingrid/Decimal

@untraced
routine report(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}")
    ProcessManager.exit_process(82)

routine start() -> None
    Crash.report_with(report.to[Callable]())
    x: Decimal = "-0.25".to[Decimal]()
    Console.show("{x.abs().rsqrt()}")
    r: Decimal = x.rsqrt()
    Console.show("not reached {r}")
    return
