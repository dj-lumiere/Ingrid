// The runtime library's clock and random word (numeric.tess). A Windows FILETIME becomes seconds since 1970 and the
// nanoseconds after them, before 1970 too: negative seconds with the nanoseconds counted forward, as POSIX has them.
// It used to crash with IntegerOverflowError there. rf_random_u64 draws from Tessera's entropy_key, fresh bits on
// every call, and rf_moment_now on this machine is after 2020.

module Ingrid::Runtime

import Standard::Format
import Standard::Os

/// Writes the Moment a FILETIME stands for.
routine show(label: Bytes, file_time: U64) -> Void
    block entry()
        m : Moment = moment_from_file_time(file_time)
        Out.write("{label}: {m.seconds} s + {m.nanoseconds} ns\n")
        return()

routine start() -> Void
    block entry()
        show("the epoch", EPOCH_TICKS)
        show("1.2345678 s after it", EPOCH_TICKS.add(12345678))
        show("100 ns before it", EPOCH_TICKS.sub(1))
        show("1.5 s before it", EPOCH_TICKS.sub(15000000))
        show("1601-01-01", 0)
        a : U64 = rf_random_u64()
        b : U64 = rf_random_u64()
        Out.write("two random words differ: {a.ne(b)}\n")
        now : Moment = rf_moment_now()
        Out.write("now is after 2020: {now.seconds.gt(1577836800)}\n")
        return()
