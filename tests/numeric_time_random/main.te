# The runtime library's clock and random word (numeric.te). rf_moment_now is Clock.now(), after 2020 on this machine,
# and rf_random_u64 draws from Tessera's entropy_key, fresh bits on every call.

module Ingrid/Runtime

import Standard/Format
import Standard/Os

routine start() -> None
    a: U64 = rf_random_u64()
    b: U64 = rf_random_u64()
    Console.show("two random words differ: {a.ne(b)}")
    now: Moment = rf_moment_now()
    Console.show("now is after 2020: {now.timestamp().gt(1577836800)}")
    Console.show("nanoseconds below a second: {now.subsecond_nanoseconds().lt(1000000000)}")
    return
