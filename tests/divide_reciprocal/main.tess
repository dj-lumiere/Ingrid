// rf_reciprocal_word off x86-64 (there it is 0, the divide being hardware): the Möller–Granlund reciprocal of a
// normalized d, floor((2^128 - 1) / d) - 2^64, checked against big-integer results from a Python model, from the
// smallest normalized divisor to the largest and across a 32-bit limb boundary.

import Standard::Format
import Standard::Os

/// Writes a U64 as 16 lowercase hex digits.
routine write_word(value: U64) -> Void
    block entry()
        hex : Hex<U64> = Hex<U64> { value: value }
        represent_with(Out.shared(), hex, FormatSpec.zero_padded(16))
        return()

routine check_reciprocal(d: U64) -> Void
    block entry()
        Out.write("reciprocal ")
        write_word(d)
        Out.write(": ")
        write_word(rf_reciprocal_word(d))
        Out.write("\n")
        return()

routine main() -> S32
    block entry()
        check_reciprocal(0x8000000000000000)
        check_reciprocal(0x8000000000000001)
        check_reciprocal(U64.MAX)
        check_reciprocal(0xFFFFFFFFFFFFFFFE)
        check_reciprocal(0xC000000000000000)
        check_reciprocal(0x8000000100000000)
        check_reciprocal(0xF000000000000000)
        check_reciprocal(0xFFFFFFFF00000000)
        check_reciprocal(0x9E3779B97F4A7C15)
        return(0)
