# Decimal's powers and square root on results of 35 digits that sit exactly halfway between two Decimals: each rounds
# half up, toward positive infinity, where D128 would take the even one. (-1.5)^29 is
# -127834.03948858939111232757568359375 and goes to ...7, 1.5^29 to ...8, 2^-50 (8.8817841970012523233890533447265625E-16)
# to ...3, 2.25^14.5 is 1.5^29 again, and 1.00000000000000005^2 is 1.0000000000000001000000000000000025, whose
# 35th digit is the 5, so ...3.

import Hosted
import Ingrid/Decimal

### Prints the powers and square roots.
routine start() -> None
    m: Decimal = "-1.5".to[Decimal]()
    e: Decimal = "29".to[Decimal]()
    two: Decimal = "2".to[Decimal]()
    ne: Decimal = "-50".to[Decimal]()
    a: Decimal = "2.25".to[Decimal]()
    y: Decimal = "14.5".to[Decimal]()
    p: Decimal = "1.00000000000000005".to[Decimal]()
    Console.show("{m.powf(exponent: e)} {m.powi(29)} {two.powf(exponent: ne)} {a.powf(exponent: y)} {p.powi(2)}")
    nine: Decimal = "9".to[Decimal]()
    Console.show("{nine.sqrt()} {two.sqrt()}")
    return
