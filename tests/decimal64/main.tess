// D64 arithmetic (Ingrid/tessera/decimal/) against RazorForge's own engine before the move: each line is two
// operands and their sum, difference, product, quotient (as BID bits), and their order, which decimal64.expected
// holds as RazorForge computed them before the arithmetic moved here. The operands come from splitmix64: raw bits
// (every encoding, canonical or not), finite values near exponent 0 and anywhere in range with 0 to 16 digits,
// zeros with any exponent, infinities, and quiet and signaling NaNs. Five lines differ from RazorForge's results,
// where RazorForge was wrong: zero plus a 17-digit (non-canonical) coefficient came back unrounded.

import Standard::Format
import Standard::Os

global STATE: @U64 <- 0x0123456789ABCDEF

preset PAIRS: U64 = 1500

/// 10 to the power n.
/// :param n: The power.
/// :returns: 10^n.
routine pow10(n: U64) -> U64
    shared power : @U64 <- 1

    block entry()
        jump step(0)

    block step(i: U64)
        branch i.ge(n)
            ? return(power.load())
            : continue
        power.load().mul(10).store_into(power)
        jump step(i.add(1))

/// An operand from two random words: raw bits, a finite value near exponent 0 or anywhere in range, or a special.
/// :param r: A random word.
/// :param s: A random word.
/// :returns: The operand's bits.
routine operand(r: U64, s: U64) -> U64
    shared sign   : U64 = r.shr(40).bitand(1).shl(63)
    shared spread : U64 = r.shr(16)
    shared kind   : U64 = r.mod(4)

    block entry()
        when kind
            0    -> return(s)
            3    -> special()
            else -> finite()

    block special()
        which : U64 = r.shr(24).mod(4)
        when which
            0    -> zero()
            1    -> return(sign.bitor(0x7800000000000000))
            2    -> return(0x7C00000000000000)
            else -> return(0x7E00000000000000)

    block zero()
        biased : U64 = spread.mod(768)
        return(sign.bitor(biased.shl(53)))

    block finite()
        digits : U64  = r.shr(8).mod(17)
        coeff  : U64  = s.mod(pow10(digits)).bitand(0x1FFFFFFFFFFFFF)
        near   : Bool = kind.eq(1)
        biased : U64  = near
            ? spread.mod(41).add(378)
            : spread.mod(768)
        return(sign.bitor(biased.shl(53)).bitor(coeff))

/// The next word of the generator, as RazorForge's C::ingrid_splitmix64 steps it.
/// :returns: The next word.
routine draw() -> U64
    block entry()
        next : U64 = splitmix64(STATE.load())
        next.store_into(STATE)
        return(next)

/// Prints the lines.
/// :returns: 0.
routine main() -> S32
    block entry()
        jump pair(0)

    block pair(i: U64)
        branch i.ge(PAIRS)
            ? return(0)
            : continue
        r1 : U64 = draw()
        s1 : U64 = draw()
        r2 : U64 = draw()
        s2 : U64 = draw()
        a  : U64 = operand(r1, s1)
        b  : U64 = operand(r2, s2)
        Out.write("{a} {b} {ingrid_d64_add(a, b)} {ingrid_d64_sub(a, b)} {ingrid_d64_mul(a, b)} ")
        Out.write("{ingrid_d64_div(a, b)} {ingrid_d64_order(a, b)}\n")
        jump pair(i.add(1))
