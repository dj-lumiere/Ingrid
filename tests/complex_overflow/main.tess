// A C128 product whose real part overflows crashes with RazorForge's NumericOverflowError, as RazorForge's checked
// B64 `*` does (complex.tess and finite.tess). The program's own crash handler writes the crash's name and message to
// standard output and exits with status 82, RazorForge's crash status.

import Standard::Format
import Standard::Os

#[export("tessera_crash_handler"), noreturn]
routine report(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        Out.write("{name}: {message}\n")
        exit(82)

routine start() -> Void
    block entry()
        Out.write("before\n")
        big     : F64   = F64.from_bits(0x6974E718D7D7625A)
        product : Words = c128_mul(big, 1.0, big, 0.0)
        Out.write("not reached {product.w0}\n")
        return()
