# A C128 product whose real part overflows crashes with RazorForge's NumericOverflowError, as RazorForge's checked
# B64 `*` does (complex.te and finite.te). The program's own crash handler writes the crash's name and message to
# standard output and exits with status 82, RazorForge's crash status.

import Standard/Format
import Standard/Os

@export("tessera_crash_handler")
@noreturn
routine report(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    Out.write("{name}: {message}\n")
    exit(82)

routine start() -> None
    Out.write("before\n")
    big: B64 = B64.from_bits(0x6974E718D7D7625A)
    product: Words = c128_mul(real: big, imag: 1.0, other_real: big, other_imag: 0.0)
    Out.write("not reached {product.w0}\n")
    return
