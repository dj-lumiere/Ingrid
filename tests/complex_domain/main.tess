// Dividing 0 + 0i by 0 + 0i is 0 / 0, which crashes with RazorForge's NumericDomainError, as real 0 / 0 does
// (complex.tess and finite.tess). The program's own crash handler writes the crash's name and message to standard
// output and exits with status 82, RazorForge's crash status.

import Standard::Format
import Standard::Os

#[export("tessera_crash_handler"), noreturn]
routine report(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    block entry()
        Out.write("{name}: {message}\n")
        exit(82)

routine start() -> Void
    block entry()
        Out.write("before\n")
        q : Words = c128_div(0.0, 0.0, 0.0, 0.0)
        Out.write("not reached {q.w0}\n")
        return()
