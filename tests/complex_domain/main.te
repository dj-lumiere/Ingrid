# Dividing 0 + 0i by 0 + 0i is 0 / 0, which crashes with RazorForge's NumericDomainError, as real 0 / 0 does
# (complex.te and finite.te). The program's own crash handler writes the crash's name and message to standard
# output and exits with status 82, RazorForge's crash status.

import Ingrid/Abi
import Standard/Hosted

@untraced
routine report(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}")
    ProcessManager.exit_process(82)

routine start() -> None
    Crash.report_with(report.to[Callable]())
    Console.show("before")
    q: Words = c128_div(real: 0.0, imag: 0.0, other_real: 0.0, other_imag: 0.0)
    Console.show("not reached {q.w0}")
    return
