# RazorForge's Random streams through Ingrid's xoshiro256** exports (tessera/random.te): six seeds, each draw kind a
# million times, folded into FNV-style checksums. The expected output is what RazorForge printed for the same program
# (Tessera/scratch/random-json/random_streams.rf) with its own xoshiro256** bodies, before they moved here: `range`
# is RazorForge's `low +% draw % span` and `chance(p)` its `next_b64() < p`.

import Ingrid/Abi
import Standard/Os

preset FNV_START: U64 = 14695981039346656037
preset FNV_PRIME: U64 = 1099511628211
preset DRAWS:     U64 = 1000000

### One draw: the state's output, and the state steps.
routine draw(state: @Words) -> U64
    s: Words = state.peek()
    result: U64 = xoshiro256ss_output(s0: s.w0, s1: s.w1, s2: s.w2, s3: s.w3)
    xoshiro256ss_step(s0: s.w0, s1: s.w1, s2: s.w2, s3: s.w3).poke_into(state)
    return result

### Folds a value into a running checksum.
@inline
routine fold(h: U64, v: U64) -> U64
    return (h ^ v) *% FNV_PRIME

### The checksum of a million 64-bit draws.
routine fold_u64(state: @Words) -> U64
    h: &U64 <- FNV_START

    each i in 0 til DRAWS
        fold(h: h.load(), v: draw(state)).poke_into(h)
    then
        return h.load()

### The checksum of a million 32-bit draws (the high half of a draw, widened back).
routine fold_u32(state: @Words) -> U64
    h: &U64 <- FNV_START

    each i in 0 til DRAWS
        fold(h: h.load(), v: draw(state) >> 32).poke_into(h)
    then
        return h.load()

### The checksum of the bits of a million [0, 1) draws.
routine fold_b64(state: @Words) -> U64
    h: &U64 <- FNV_START

    each i in 0 til DRAWS
        unit: B64 = random_unit_b64(draw(state))
        fold(h: h.load(), v: unit.bits()).poke_into(h)
    then
        return h.load()

### RazorForge's range draw: low plus a draw modulo the wrapped span.
routine range(state: @Words, low: U64, high: U64) -> U64
    span: U64 = high -% low
    return low +% draw(state) % span

### The checksum of a million pairs of range draws, [10, 1000) and a span that wraps past U64.MAX.
routine fold_range(state: @Words) -> U64
    h: &U64 <- FNV_START

    each i in 0 til DRAWS
        first: U64 = fold(h: h.load(), v: range(state, low: 10, high: 1000))
        second: U64 = fold(h: first, v: range(state, low: 18446744073709551000, high: 5))
        second.poke_into(h)
    then
        return h.load()

### How many of a million chance(0.3) trials succeed.
routine count_chance(state: @Words) -> U64
    heads: &U64 <- 0

    each i in 0 til DRAWS
        unit: B64 = random_unit_b64(draw(state))
        hit: Bool = unit < 0.3
        (heads.load() + hit.to[U64]()).poke_into(heads)
    then
        return heads.load()

### The checksum of a million rounds of the splitmix64 chain, each fed the last one's output.
routine fold_splitmix(seed: U64) -> U64
    each i in 0 til DRAWS with acc: U64 = seed, h: U64 = FNV_START
        next: U64 = splitmix64(acc)
        continue with acc: next, h: fold(h, v: next)
    then
        return h

### Writes every line random_streams.rf writes for one seed.
routine stream(seed: U64) -> None
    state: &Words <- xoshiro256ss_seed(seed)

    until i >= 5 with i: U64 = 0
        Console.show("seed {seed} u64 #{i}: {draw(state)}")
        continue with i: i + 1
    Console.show("seed {seed} u64 x1e6: {fold_u64(state)}")
    Console.show("seed {seed} u32 x1e6: {fold_u32(state)}")
    Console.show("seed {seed} b64 x1e6: {fold_b64(state)}")
    Console.show("seed {seed} range x2e6: {fold_range(state)}")
    Console.show("seed {seed} chance(0.3) x1e6: {count_chance(state)}")
    Console.show("seed {seed} splitmix chain x1e6: {fold_splitmix(seed)}")
    return

routine start() -> None
    stream(0)
    stream(1)
    stream(42)
    stream(12345)
    stream(1311768467463790320)
    stream(18446744073709551615)
    return
