# Int (Ingrid/tessera/integer/) through the C ABI on large and edge operands, as RazorForge calls it. The cases:
# equal sizes and mixed sizes around the multiply and divide switch points (100 limbs for the transform, 2300 for
# Newton division), operands of special limb patterns (all ones, a single bit, a top limb of 1 or all ones, a zero
# low half, zero, one), both signs, every export, text in radixes 2, 10, 16 and 36 and back, fixed strings for the
# reader, shifts around the limb edges, powers, and the scratch and result size limits of every call. Each case prints
# one digest of everything it computed: the statuses, signs, lengths and mixes of the limbs. numerics_wide.expected
# holds what the engine computed when it was still written in RazorForge (all 11952 results of a verbose run were
# identical), which the hand-written Tessera engine reproduces bit for bit. Setting VERBOSE prints every result on a
# line of its own, to find where two engines differ.

import Hosted
import Ingrid/Abi

global STATE: &U64 <- 0x0123456789ABCDEF
### The limbs of the first operand.
global A: &Items[U64, 8192]
### The limbs of the second operand.
global B: &Items[U64, 8192]
### A result's limbs.
global OUT: &Items[U64, 20480]
### A second result's limbs (a remainder).
global OUT2: &Items[U64, 20480]
### The scratch every call gets.
global SCRATCH: &Items[U64, 4194304]
### Text, one code point per element.
global TEXT: &Items[U32, 524288]
### Everything one case folds into: the digest printed at its end.
global DIGEST: &U64 <- 0

preset SCRATCH_ROOM: U64 = 4194304
preset OUT_ROOM: U64 = 20480
preset TEXT_ROOM: U64 = 524288

### Whether every result prints on a line of its own (to find where two engines differ) instead of one digest per case.
preset VERBOSE: Bool = false

### One case: two operands, drawn by kind, and which signs they have.
record Case
    ### The first operand's limbs (ignored for kinds 8 and 9).
    a_len: U64
    ### How the first operand's limbs are drawn (see `fill_operand`).
    a_kind: U64
    ### The second operand's limbs.
    b_len: U64
    ### How the second operand's limbs are drawn.
    b_kind: U64
    ### Bit 0: the first is negative. Bit 1: the second is negative.
    signs: U64

# The engine's failure messages allocate through memory.te, whose OutOfMemoryError goes to the runtime library's
# __rf_throw. This program defines it: it writes the error to standard output and exits with status 82, as the
# runtime's crash does.
@export("__rf_throw")
@noreturn
routine stub_rf_throw(error_type: CStrView, message: CStrView) -> None
    kind: @[Byte] = error_type.getview()
    text: @[Byte] = message.getview()
    Console.show("{kind}: {text}")
    ProcessManager.exit_process(82)

### ingrid_integer_add.
### :param a_neg: 1 when a is negative.
### :param a_len: a's limbs.
### :param a_tab: a's first limb.
### :param b_neg: 1 when b is negative.
### :param b_len: b's limbs.
### :param b_tab: b's first limb.
### :param out: The result buffer.
### :param out_cap: Its limbs.
### :returns: The status and the result's length and sign.
@external("c")
@symbol("ingrid_integer_add")
routine c_integer_add(a_neg: U64, a_len: U64, a_tab: @U64, b_neg: U64, b_len: U64, b_tab: @U64,
    out: @U64, out_cap: U64) -> Words

