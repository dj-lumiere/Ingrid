@external("c")
@symbol("ingrid_integer_gcd_scratch_size")
routine c_integer_gcd_scratch_size(a_len: U64, b_len: U64) -> U64

### ingrid_integer_text_capacity.
### :param a_len: a's limbs.
### :param radix: The radix.
### :returns: The characters.
@external("c")
@symbol("ingrid_integer_text_capacity")
routine c_integer_text_capacity(a_len: U64, radix: U64) -> U64

