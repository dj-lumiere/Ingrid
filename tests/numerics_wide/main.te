### :param a_neg: 1 when a is negative.
### :param a_len: a's limbs.
### :param a_tab: a's first limb.
### :param b_neg: 1 when b is negative.
### :param b_len: b's limbs.
### :param b_tab: b's first limb.
### :param out: The result buffer.
### :param out_cap: Its limbs.
### :param scratch: The scratch.
### :param scratch_cap: Its limbs.
### :returns: The status and the result's length and sign.
@external("c")
@symbol("ingrid_integer_mul")
routine c_integer_mul(a_neg: U64, a_len: U64, a_tab: @U64, b_neg: U64, b_len: U64, b_tab: @U64,
    out: @U64, out_cap: U64, scratch: @U64, scratch_cap: U64) -> Words

