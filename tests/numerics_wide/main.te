@external("c")
@symbol("ingrid_integer_compare")
routine c_integer_compare(a_neg: U64, a_len: U64, a_tab: @U64, b_neg: U64, b_len: U64,
    b_tab: @U64) -> S64

### ingrid_integer_to_text.
### :param a_neg: 1 when a is negative.
### :param a_len: a's limbs.
### :param a_tab: a's first limb.
### :param radix: The radix.
### :param out: The characters.
### :param out_cap: Their room.
### :param scratch: The scratch.
### :param scratch_cap: Its limbs.
### :returns: The status and the character count.
@external("c")
@symbol("ingrid_integer_to_text")
routine c_integer_to_text(a_neg: U64, a_len: U64, a_tab: @U64, radix: U64, out: @U32, out_cap: U64,
    scratch: @U64, scratch_cap: U64) -> Words

### ingrid_integer_parse.
### :param chars: The characters.
### :param count: How many.
### :param radix: The radix.
### :param out: The result buffer.
### :param out_cap: Its limbs.
### :param scratch: The scratch.
### :param scratch_cap: Its limbs.
### :returns: The status, the value's length and sign, and 1 when the text is an integer.
@external("c")
@symbol("ingrid_integer_parse")
routine c_integer_parse(chars: @U32, count: U64, radix: U64, out: @U64, out_cap: U64, scratch: @U64,
    scratch_cap: U64) -> Words

### The next word of the generator, as RazorForge's C/ingrid_splitmix64 steps it.
### :returns: The next word.
routine draw() -> U64
    next: U64 = splitmix64(STATE.load())
    next.poke_into(STATE)
    return next

### A random limb: zero, all ones, one bit, or random bits, as the kind drawn first says.
### :returns: The limb.
routine draw_limb() -> U64
    kind: U64 = draw() & 7
    value: U64 = draw()

    when kind
        0 => return 0
        1 => return 0xFFFFFFFFFFFFFFFF
        2 => return U64.shift_left(1, value & 63)
        else => return value

### Writes an operand of `len` limbs at `tab`, by kind: 0 limbs with zero, all-ones and one-bit limbs among random
### ones, 1 purely random, 2 all ones, 3 a single bit in the top limb, 4 a top limb of 1, 5 a top limb of all ones,
### 6 a top limb with only its top bit, 7 zero low half, 8 the value 0, 9 the value 1. The top limb is never zero.
### :param tab: Where the limbs go.
### :param len: How many limbs.
### :param kind: The kind.
### :returns: The limbs written.
routine fill_operand(tab: @U64, len: U64, kind: U64) -> U64
    if kind == 8 or len == 0
        return 0
    if kind == 9
        1.poke_into(tab)
        return 1
    for i in 0 til len
        value: U64 = when
            kind == 1 => draw()
            kind == 2 => U64.MAX
            kind == 3 => 0
            kind == 7 and i < len // 2 => 0
            else => draw_limb()
        value.poke_into(tab.stride(i))
    top: @U64 = tab.stride(len - 1)
    wanted: U64 = when
        kind == 3 => U64.shift_left(1, draw() & 63)
        kind == 4 => 1
        kind == 5 => U64.MAX
        kind == 6 => 0x8000000000000000
        else => top.peek()
    wanted.max(1).poke_into(top)
    return len

### A mix of `count` limbs at `tab`.
### :param tab: The first limb.
### :param count: How many.
### :returns: The mix.
routine mix(tab: @U64, count: U64) -> U64
    h: &U64 <- 0x243F6A8885A308D3

    for i in 0 til count
        limb: U64 = tab.stride(i).peek()
        mixed: U64 = (h.load() ^ limb) *% 0x100000001B3
        (mixed ^ (mixed >> 29)).poke_into(h)
    then
        return h.load()

### A mix of `count` code points at `chars`.
### :param chars: The first.
### :param count: How many.
### :returns: The mix.
routine mix_text(chars: @U32, count: U64) -> U64
    h: &U64 <- 0x243F6A8885A308D3

    for i in 0 til count
        point: U64 = chars.stride(i).peek().to[U64]()
        mixed: U64 = (h.load() ^ point) *% 0x100000001B3
        (mixed ^ (mixed >> 29)).poke_into(h)
    then
        return h.load()

### Folds a word into the case's digest.
### :param v: The word.
routine fold(v: U64) -> None
    mixed: U64 = (DIGEST.load() ^ v) *% 0x100000001B3
    (mixed ^ (mixed >> 29)).poke_into(DIGEST)
    return

### Notes an integer result: its status, sign, length and a mix of its limbs go into the digest, and on its own line when
### VERBOSE.
### :param label: What it is.
### :param words: What the call returned.
### :param tab: Its limbs.
routine note(label: @[Byte], words: Words, tab: @U64) -> None
    h: U64 = when
        words.w0 == 0 => mix(tab, count: words.w1)
        else => 0
    fold(words.w0)
    fold(words.w1)
    fold(words.w2)
    fold(words.w3)
    fold(h)
    if VERBOSE
        Console.show(" {label} {words.w0}/{words.w2}/{words.w1}/{words.w3}:{h}")
    return

### Notes a status and the lengths a two-result call returned, with the mixes of both results.
### :param label: What it is.
### :param words: What the call returned.
### :param first: The first result's limbs.
### :param second: The second result's limbs.
routine note_pair(label: @[Byte], words: Words, first: @U64, second: @U64) -> None
    h1: U64 = when
        words.w0 == 0 => mix(tab: first, count: words.w1)
        else => 0
    h2: U64 = when
        words.w0 == 0 => mix(tab: second, count: words.w3)
        else => 0
    fold(words.w0)
    fold(words.w1)
    fold(words.w2)
    fold(words.w3)
    fold(h1)
    fold(h2)
    if VERBOSE
        Console.show(" {label} {words.w0}/{words.w1}/{words.w2}/{words.w3}:{h1} {h2}")
    return

### Every Int export on one case.
### :param c: The case.
### :param number: Its number.
routine run_case(c: Case, number: U64) -> None
    a_tab: @U64 = A.getview().to[@U64]()
    b_tab: @U64 = B.getview().to[@U64]()
    out: @U64 = OUT.getview().to[@U64]()
    out2: @U64 = OUT2.getview().to[@U64]()
    room: @U64 = SCRATCH.getview().to[@U64]()
    text: @U32 = TEXT.getview().to[@U32]()
    a_len: U64 = fill_operand(tab: a_tab, len: c.a_len, kind: c.a_kind)
    b_len: U64 = fill_operand(tab: b_tab, len: c.b_len, kind: c.b_kind)
    a_neg: U64 = when
        a_len == 0 => 0
        else => c.signs & 1
    b_neg: U64 = when
        b_len == 0 => 0
        else => (c.signs >> 1) & 1
    shift: U64 = draw() % (64 * a_len + 130)
    DIGEST.store(0x9E3779B97F4A7C15)
    fold(mix(tab: a_tab, count: a_len))
    fold(mix(tab: b_tab, count: b_len))
    if VERBOSE
        Console.show("case {number} a {a_neg}/{a_len} b {b_neg}/{b_len} shift {shift}")

    note(label: "add",
        words: c_integer_add(a_neg, a_len, a_tab, b_neg, b_len, b_tab, out, OUT_ROOM), tab: out)
    note(label: "mul",
        words: c_integer_mul(a_neg, a_len, a_tab, b_neg, b_len, b_tab, out, OUT_ROOM, room, SCRATCH_ROOM),
        tab: out)
    if b_len != 0
        qr: Words = c_integer_divmod(a_neg, a_len, a_tab, b_neg, b_len, b_tab, out, OUT_ROOM, out2,
            OUT_ROOM, room, SCRATCH_ROOM)
        note_pair(label: "divmod", words: qr, first: out, second: out2)
    note(label: "shl", words: c_integer_shift_left(a_neg, a_len, a_tab, shift, out, OUT_ROOM),
        tab: out)
    note(label: "shr", words: c_integer_shift_right(a_neg, a_len, a_tab, shift, out, OUT_ROOM),
        tab: out)
    note(label: "and",
        words: c_integer_and(a_neg, a_len, a_tab, b_neg, b_len, b_tab, out, OUT_ROOM), tab: out)
    note(label: "or", words: c_integer_or(a_neg, a_len, a_tab, b_neg, b_len, b_tab, out, OUT_ROOM),
        tab: out)
    note(label: "xor",
        words: c_integer_xor(a_neg, a_len, a_tab, b_neg, b_len, b_tab, out, OUT_ROOM), tab: out)
    order: S64 = c_integer_compare(a_neg, a_len, a_tab, b_neg, b_len, b_tab)
    fold(order.to_wrap[U64]())
    if a_len.max(b_len) <= 500 or a_len.min(b_len) <= 3
        note(label: "gcd",
            words: c_integer_gcd(a_len, a_tab, b_len, b_tab, out, OUT_ROOM, room, SCRATCH_ROOM),
            tab: out)
        note(label: "lcm",
            words: c_integer_lcm(a_len, a_tab, b_len, b_tab, out, OUT_ROOM, room, SCRATCH_ROOM),
            tab: out)
    root: Words = c_integer_sqrtrem(a_len, a_tab, out, OUT_ROOM, out2, OUT_ROOM, room, SCRATCH_ROOM)
    note_pair(label: "sqrtrem", words: root, first: out, second: out2)
    if a_len <= 2
        expo: U64 = draw() % 200
        note(label: "pow",
            words: c_integer_pow(a_neg, a_len, a_tab, expo, out, OUT_ROOM, room, SCRATCH_ROOM),
            tab: out)
    if a_len <= 500
        text_series(a_neg, a_len, a_tab)
    if VERBOSE
        Console.show("digest {DIGEST.load()}")
    Console.show("case {number} {c.a_len}/{c.a_kind} {c.b_len}/{c.b_kind} signs {c.signs}: {DIGEST.load()}")
    return

### Writes an integer in each of four radixes and reads each back.
### :param a_neg: 1 when negative.
### :param a_len: The limbs.
### :param a_tab: The first limb.
routine text_series(a_neg: U64, a_len: U64, a_tab: @U64) -> None
    out: @U64 = OUT.getview().to[@U64]()
    room: @U64 = SCRATCH.getview().to[@U64]()
    text: @U32 = TEXT.getview().to[@U32]()
    radixes: Items[U64, 4] = [2, 10, 16, 36]

    for r: U64 in 0 til 4
        radix: U64 = radixes[r]
        written: Words = c_integer_to_text(a_neg, a_len, a_tab, radix, text, TEXT_ROOM, room,
            SCRATCH_ROOM)
        fold(written.w0)
        fold(written.w1)
        fold(mix_text(chars: text, count: written.w1))
        back: Words = c_integer_parse(text, written.w1, radix, out, OUT_ROOM, room, SCRATCH_ROOM)
        note(label: "parse", words: back, tab: out)
    return

### One large integer in radix 10 and 16 and back, which the per-case series leaves out for its cost.
### :param len: The limbs.
### :param kind: The kind.
routine text_big(len: U64, kind: U64) -> None
    a_tab: @U64 = A.getview().to[@U64]()
    out: @U64 = OUT.getview().to[@U64]()
    room: @U64 = SCRATCH.getview().to[@U64]()
    text: @U32 = TEXT.getview().to[@U32]()
    radixes: Items[U64, 2] = [10, 16]
    n: U64 = fill_operand(tab: a_tab, len, kind)
    DIGEST.store(0x1234)

    for r: U64 in 0 til 2
        radix: U64 = radixes[r]
        written: Words = c_integer_to_text(r, n, a_tab, radix, text, TEXT_ROOM, room, SCRATCH_ROOM)
        fold(written.w0)
        fold(written.w1)
        fold(mix_text(chars: text, count: written.w1))
        back: Words = c_integer_parse(text, written.w1, radix, out, OUT_ROOM, room, SCRATCH_ROOM)
        note(label: "parse", words: back, tab: out)
    Console.show("text {len}/{kind}: {DIGEST.load()}")
    return

### Writes the code points of `s` at `text`.
### :param s: The ASCII bytes.
### :returns: How many.
routine put_text(s: @[Byte]) -> U64
    text: @U32 = TEXT.getview().to[@U32]()

    for i in 0 til s.count()
        s.getitem(i)
            .to[U8]()
            .to[U32]()
            .poke_into(text.stride(i))
    then
        return s.count()

### Reads fixed strings in several radixes: signs, empty text, digits outside the radix, trailing line ends and junk.
routine parse_series() -> None
    out: @U64 = OUT.getview().to[@U64]()
    room: @U64 = SCRATCH.getview().to[@U64]()
    text: @U32 = TEXT.getview().to[@U32]()
    radixes: Items[U64, 8] = [2, 3, 10, 16, 36, 64, 1, 65]
    strings: Items[@[Byte], 26] = ["", "-", "0", "-0", "123", "-123", "00012", "ff", "FF", "zz",
        "Zz", "12\n", "12\r\n", "12 ", "12x", "+5", "9223372036854775808",
        "340282366920938463463374607431768211456", "-18446744073709551616", "1/", "+/", "abc",
        "0101", "--5", "5-", "z/"]
    DIGEST.store(0x5678)

    for s: U64 in 0 til 26
        count: U64 = put_text(s: strings[s])
        for r: U64 in 0 til 8
            back: Words = c_integer_parse(text, count, radixes[r], out, OUT_ROOM, room,
                SCRATCH_ROOM)
            note(label: "parse", words: back, tab: out)
    Console.show("parse series: {DIGEST.load()}")
    return

### The scratch protocol and the output buffer limits of every call with a scratch buffer: at several scratch sizes and
### result sizes, the status and what the call says it needs.
### :param a_len: The first operand's limbs.
### :param b_len: The second operand's limbs.
routine protocol_series(a_len: U64, b_len: U64) -> None
    a_tab: @U64 = A.getview().to[@U64]()
    b_tab: @U64 = B.getview().to[@U64]()
    out: @U64 = OUT.getview().to[@U64]()
    out2: @U64 = OUT2.getview().to[@U64]()
    room: @U64 = SCRATCH.getview().to[@U64]()
    text: @U32 = TEXT.getview().to[@U32]()
    n: U64 = fill_operand(tab: a_tab, len: a_len, kind: 0)
    m: U64 = fill_operand(tab: b_tab, len: b_len, kind: 0)
    DIGEST.store(0x9ABC)
    mul_size: U64 = c_integer_mul_scratch_size(n, m)
    div_size: U64 = c_integer_divmod_scratch_size(n, m)
    sqrt_size: U64 = c_integer_sqrt_scratch_size(n)
    gcd_size: U64 = c_integer_gcd_scratch_size(n, m)
    pow_size: U64 = c_integer_pow_scratch_size(n, 64 * n, 9)
    fold(mul_size)
    fold(div_size)
    fold(sqrt_size)
    fold(gcd_size)
    fold(pow_size)
    fold(c_integer_text_capacity(n, 10))
    fold(c_integer_text_capacity(n, 2))
    fold(c_integer_text_capacity(0, 16))

    for k: U64 in 0 til 7
        caps: Items[U64, 7] = [0, 1, 7, 1, 1, 1, 1]
        # the scratch given: nothing, a little, a third, a half, one less than the bound, the bound, twice the bound
        mul_cap: U64 = when k
            3 => mul_size // 3
            4 => mul_size // 2
            5 => mul_size - 1
            6 => mul_size
            else => caps[k]
        div_cap: U64 = when k
            3 => div_size // 3
            4 => div_size // 2
            5 => div_size - 1
            6 => div_size
            else => caps[k]
        gcd_cap: U64 = when k
            3 => gcd_size // 3
            4 => gcd_size // 2
            5 => gcd_size - 1
            6 => gcd_size
            else => caps[k]
        sqrt_cap: U64 = when k
            3 => sqrt_size // 3
            4 => sqrt_size // 2
            5 => sqrt_size - 1
            6 => sqrt_size
            else => caps[k]
        note(label: "mul",
            words: c_integer_mul(0, n, a_tab, 1, m, b_tab, out, OUT_ROOM, room, mul_cap), tab: out)
        note_pair(label: "divmod",
            words: c_integer_divmod(1, n, a_tab, 0, m, b_tab, out, OUT_ROOM, out2, OUT_ROOM, room, div_cap),
            first: out, second: out2)
        note(label: "gcd", words: c_integer_gcd(n, a_tab, m, b_tab, out, OUT_ROOM, room, gcd_cap),
            tab: out)
        note(label: "lcm", words: c_integer_lcm(n, a_tab, m, b_tab, out, OUT_ROOM, room, gcd_cap),
            tab: out)
        note(label: "sqrt", words: c_integer_sqrt(n, a_tab, out, OUT_ROOM, room, sqrt_cap),
            tab: out)
        note_pair(label: "sqrtrem",
            words: c_integer_sqrtrem(n, a_tab, out, OUT_ROOM, out2, OUT_ROOM, room, sqrt_cap),
            first: out, second: out2)
        note(label: "pow",
            words: c_integer_pow(0, n, a_tab, 9, out, OUT_ROOM, room, pow_size // (7 - k)),
            tab: out)
        fold(c_integer_to_text(0, n, a_tab, 10, text, TEXT_ROOM, room, k).w0)
        fold(c_integer_to_text(0, n, a_tab, 10, text, TEXT_ROOM, room, k).w1)
        note(label: "parse", words: c_integer_parse(text, k, 10, out, OUT_ROOM, room, k), tab: out)
    for cap: U64 in 0 til 5
        small: U64 = when cap
            0 => 0
            1 => 1
            2 => n // 2
            3 => n + m - 1
            else => n + m
        note(label: "add", words: c_integer_add(0, n, a_tab, 1, m, b_tab, out, small), tab: out)
        note(label: "mul",
            words: c_integer_mul(0, n, a_tab, 1, m, b_tab, out, small, room, SCRATCH_ROOM),
            tab: out)
        note_pair(label: "divmod",
            words: c_integer_divmod(0, n, a_tab, 0, m, b_tab, out, small, out2, small, room, SCRATCH_ROOM),
            first: out, second: out2)
        note(label: "shl", words: c_integer_shift_left(0, n, a_tab, 70, out, small), tab: out)
        note(label: "shr", words: c_integer_shift_right(1, n, a_tab, 70, out, small), tab: out)
        note(label: "and", words: c_integer_and(1, n, a_tab, 1, m, b_tab, out, small), tab: out)
        note(label: "sqrt", words: c_integer_sqrt(n, a_tab, out, small, room, SCRATCH_ROOM),
            tab: out)
        note(label: "gcd", words: c_integer_gcd(n, a_tab, m, b_tab, out, small, room, SCRATCH_ROOM),
            tab: out)
        fold(c_integer_to_text(0, n, a_tab, 16, text, small, room, SCRATCH_ROOM).w0)
    Console.show("protocol {a_len}/{b_len}: {DIGEST.load()}")
    return

### Shifts by the edges of a limb and a multiple of it, both signs, of a value with low limbs zero and without.
routine shift_series() -> None
    a_tab: @U64 = A.getview().to[@U64]()
    out: @U64 = OUT.getview().to[@U64]()
    shifts: Items[U64, 14] = [0, 1, 63, 64, 65, 127, 128, 129, 191, 192, 193, 400, 100000,
        4294967296]

    for kind: U64 in 0 til 4
        kinds: Items[U64, 4] = [0, 7, 3, 2]
        n: U64 = fill_operand(tab: a_tab, len: 5, kind: kinds[kind])
        DIGEST.store(0x5EED)
        for neg: U64 in 0 til 2
            for s: U64 in 0 til 14
                note(label: "shl",
                    words: c_integer_shift_left(neg, n, a_tab, shifts[s], out, OUT_ROOM), tab: out)
                note(label: "shr",
                    words: c_integer_shift_right(neg, n, a_tab, shifts[s], out, OUT_ROOM), tab: out)
        Console.show("shifts kind {kinds[kind]}: {DIGEST.load()}")
    return

### Raising small bases to many exponents.
routine power_series() -> None
    a_tab: @U64 = A.getview().to[@U64]()
    out: @U64 = OUT.getview().to[@U64]()
    room: @U64 = SCRATCH.getview().to[@U64]()
    expos: Items[U64, 11] = [0, 1, 2, 3, 63, 64, 65, 100, 333, 1000, 2500]

    for len: U64 in 0 til 3
        n: U64 = fill_operand(tab: a_tab, len: len, kind: 1)
        DIGEST.store(0x90D)
        for neg: U64 in 0 til 2
            for e: U64 in 0 til 11
                note(label: "pow",
                    words: c_integer_pow(neg, n, a_tab, expos[e], out, OUT_ROOM, room, SCRATCH_ROOM),
                    tab: out)
        Console.show("powers {len}: {DIGEST.load()}")
    return

### Runs the cases.
routine start() -> None
    sizes: Items[U64, 12] = [1, 2, 3, 50, 99, 100, 101, 500, 2000, 2300, 2500, 5000]
    mixed: Items[U64, 66] = [5000, 1, 5000, 2, 5000, 3, 5000, 99, 5000, 100, 5000, 2300, 5000, 2500,
        5000, 4999, 2500, 2300, 2500, 2299, 2300, 2299, 2000, 2300, 101, 50, 500, 2, 100, 99, 1,
        5000, 3, 5000, 2, 2500, 99, 5000, 300, 100, 2700, 2300, 4600, 2300, 4601, 2300, 4599, 2300,
        4600, 2301, 6000, 2300, 2301, 2300, 2299, 2299, 2400, 2400, 7000, 3, 150, 100, 101, 100, 99,
        101]
    number: &U64 <- 0

    for si: U64 in 0 til 12
        size: U64 = sizes[si]
        combos: U64 = when
            size <= 500 => 4
            else => 2
        for combo in 0 til combos
            run_case(c: (a_len: size, a_kind: 0, b_len: size, b_kind: 0, signs: combo),
                number: number.load())
            number.store(number.load() + 1)
    for pair: U64 in 0 til 33
        run_case(
            c: (a_len: mixed[2 * pair], a_kind: 0, b_len: mixed[2 * pair + 1], b_kind: 0, signs: pair % 4),
            number: number.load())
        number.store(number.load() + 1)
    for pair: U64 in 0 til 33
        run_case(
            c: (a_len: mixed[2 * pair], a_kind: 4, b_len: mixed[2 * pair + 1], b_kind: 4 + pair % 3, signs: (pair + 1) % 4),
            number: number.load())
        number.store(number.load() + 1)
    smalls: Items[U64, 8] = [3, 2, 4, 4, 1, 1, 2, 5]
    for ka: U64 in 0 til 10
        for kb: U64 in 0 til 10
            for sp: U64 in 0 til 4
                run_case(
                    c: (a_len: smalls[2 * sp], a_kind: ka, b_len: smalls[2 * sp + 1], b_kind: kb, signs: (ka + kb + sp) % 4),
                    number: number.load())
                number.store(number.load() + 1)
    mediums: Items[U64, 10] = [50, 50, 101, 100, 200, 99, 100, 101, 600, 300]
    for mp: U64 in 0 til 5
        for ka: U64 in 0 til 8
            run_case(
                c: (a_len: mediums[2 * mp], a_kind: ka, b_len: mediums[2 * mp + 1], b_kind: ka, signs: ka % 4),
                number: number.load())
            number.store(number.load() + 1)
            run_case(
                c: (a_len: mediums[2 * mp], a_kind: ka, b_len: mediums[2 * mp + 1], b_kind: (ka * 3 + 1) % 8, signs: (ka + 1) % 4),
                number: number.load())
            number.store(number.load() + 1)
    bigs: Items[U64, 14] = [2500, 2300, 4600, 2300, 4599, 2300, 5000, 2500, 3000, 2400, 2301, 2300,
        2300, 2300]
    for bp: U64 in 0 til 7
        for ka: U64 in 0 til 7
            run_case(
                c: (a_len: bigs[2 * bp], a_kind: ka, b_len: bigs[2 * bp + 1], b_kind: (ka + 4) % 7, signs: (bp + ka) % 4),
                number: number.load())
            number.store(number.load() + 1)
    parse_series()
    shift_series()
    power_series()
    text_big(5000, 0)
    text_big(2500, 2)
    text_big(800, 5)
    protocol_series(150, 140)
    protocol_series(3, 2)
    protocol_series(2400, 120)
    protocol_series(5, 4800)
    protocol_series(100, 100)
    return
