# The heap calls every Revare and Mielia program makes (memory.lpa): zeroed and uninitialized allocation,
# reallocation (keeping the contents, and to 0 bytes as a free), overlapping copies, fills, the no-op cases (a hollow
# address or no bytes), the scratch region's nested marks, and last an allocation that can't succeed, which is an
# OutOfMemoryError through the runtime's __ig_throw.
#
# __ig_throw is the Revare runtime library's. This program defines it: it writes the error to standard output and
# exits with status 82, as the runtime's crash does.

import Hosted

@export("__ig_throw")
@noreturn
routine stub_ig_throw(error_type: CStrView, message: CStrView) -> None
    kind: @[Byte] = error_type.getview()
    text: @[Byte] = message.getview()
    Console.show("{kind}: {text}")
    ProcessManager.exit_process(82)

### Writes `count` bytes at `p` as decimal numbers.
routine show_bytes(label: @[Byte], p: @U8, count: U64) -> None
    Console.show("{label}:", end: "")

    for i in 0 til count
        value: U8 = p.stride(i).peek()
        Console.show(" {value}", end: "")
    Console.show("")
    return

### Stores 1, 2, ... count at `p`.
routine fill_counting(p: @U8, count: U64) -> None
    for i in 0 til count
        value: U8 = (i + 1).to[U8]()
        p.stride(i).poke(value)
    then
        return

routine heap() -> None
    zeroed: @U8 = ig_allocate_dynamic(8).to[@U8]()
    show_bytes(label: "zeroed", p: zeroed, count: 8)
    fill_counting(p: zeroed, count: 8)
    grown: @U8 = ig_reallocate_dynamic(ptr: zeroed, bytes: 16).to[@U8]()
    show_bytes(label: "grown, contents kept", p: grown, count: 8)
    ig_copy_bytes_at(dst_address: grown.stride(2), src_address: grown, bytes: 6)
    show_bytes(label: "copied forward over itself", p: grown, count: 8)
    ig_copy_bytes_at(dst_address: grown, src_address: grown.stride(2), bytes: 6)
    show_bytes(label: "copied back", p: grown, count: 8)
    ig_set_bytes_at(dest_address: grown.stride(1), value: 255, bytes: 3)
    show_bytes(label: "filled", p: grown, count: 8)
    ig_set_bytes_at(dest_address: Addr.zero(), value: 7, bytes: 3)
    ig_set_bytes_at(dest_address: grown, value: 7, bytes: 0)
    ig_copy_bytes_at(dst_address: Addr.zero(), src_address: grown, bytes: 4)
    ig_copy_bytes_at(dst_address: grown, src_address: Addr.zero(), bytes: 4)
    ig_copy_bytes_at(dst_address: grown.stride(4), src_address: grown, bytes: 0)
    show_bytes(label: "after the no-op calls", p: grown, count: 8)
    gone: Addr = ig_reallocate_dynamic(ptr: grown, bytes: 0)
    raw_at: Addr = ig_allocate_dynamic_uninit(4)
    has_block: Bool = raw_at.is_not_hollow()
    raw: @U8 = raw_at.to[@U8]()
    Console.show("uninitialized block: {has_block}")
    ig_invalidate(raw)
    ig_invalidate(gone)
    ig_invalidate(Addr.zero())
    return

routine region() -> None
    outer: U64 = ig_region_mark()
    Console.show("empty region mark: {outer}")
    first: @U8 = ig_region_alloc(16).to[@U8]()
    show_bytes(label: "region block, zeroed", p: first, count: 16)
    inner: U64 = ig_region_mark()
    ig_region_alloc(32)
    ig_region_alloc(8)
    moved: Bool = ig_region_mark() != inner
    ig_region_release(inner)
    back_inner: Bool = ig_region_mark() == inner
    ig_region_release(outer)
    back_outer: Bool = ig_region_mark() == outer
    Console.show("mark moved: {moved}, released to the inner mark: {back_inner}, to the outer: {back_outer}")
    return

routine start() -> None
    heap()
    region()
    ig_allocate_dynamic(U64.MAX)
    Console.show("not reached")
    return
