# The heap calls every RazorForge and Suflae program makes (memory.te): zeroed and uninitialized allocation,
# reallocation (keeping the contents, and to 0 bytes as a free), overlapping copies, fills, the no-op cases (a null
# address or no bytes), the scratch region's nested marks, and last an allocation that can't succeed, which is an
# OutOfMemoryError through the runtime's __rf_throw.
#
# __rf_throw is the RazorForge runtime library's. This program defines it: it writes the error to standard output and
# exits with status 82, as the runtime's crash does.

import Standard/Format
import Standard/Os

@export("__rf_throw")
@noreturn
routine stub_rf_throw(error_type: CStr, message: CStr) -> None
    kind: @[Byte] = error_type.getview()
    text: @[Byte] = message.getview()
    Out.write("{kind}: {text}\n")
    exit(82)

### Writes `count` bytes at `p` as decimal numbers.
routine show_bytes(label: @[Byte], p: @U8, count: U64) -> None
    Out.write("{label}:")

    each i in 0 til count
        value: U8 = p.stride(i).peek()
        Out.write(" {value}")
    Out.write("\n")
    return

### Stores 1, 2, ... count at `p`.
routine fill_counting(p: @U8, count: U64) -> None
    each i in 0 til count
        value: U8 = (i + 1).to[U8]()
        p.stride(i).poke(value)
    then
        return

routine address_of(p: @U8) -> U64
    return ptrtoint[@U8, U64](p)

routine heap() -> None
    zeroed: @U8 = rf_allocate_dynamic(8).to[@U8]()
    show_bytes(label: "zeroed", p: zeroed, count: 8)
    fill_counting(p: zeroed, count: 8)
    grown: @U8 = rf_reallocate_dynamic(ptr: zeroed, bytes: 16).to[@U8]()
    show_bytes(label: "grown, contents kept", p: grown, count: 8)
    rf_copy_bytes_at(dst_address: address_of(grown.stride(2)), src_address: address_of(grown),
        bytes: 6)
    show_bytes(label: "copied forward over itself", p: grown, count: 8)
    rf_copy_bytes_at(dst_address: address_of(grown), src_address: address_of(grown.stride(2)),
        bytes: 6)
    show_bytes(label: "copied back", p: grown, count: 8)
    rf_set_bytes_at(dest_address: address_of(grown.stride(1)), value: 255, bytes: 3)
    show_bytes(label: "filled", p: grown, count: 8)
    rf_set_bytes_at(dest_address: 0, value: 7, bytes: 3)
    rf_set_bytes_at(dest_address: address_of(grown), value: 7, bytes: 0)
    rf_copy_bytes_at(dst_address: 0, src_address: address_of(grown), bytes: 4)
    rf_copy_bytes_at(dst_address: address_of(grown), src_address: 0, bytes: 4)
    rf_copy_bytes_at(dst_address: address_of(grown.stride(4)), src_address: address_of(grown),
        bytes: 0)
    show_bytes(label: "after the no-op calls", p: grown, count: 8)
    gone: Addr = rf_reallocate_dynamic(ptr: grown, bytes: 0)
    raw: @U8 = rf_allocate_dynamic_uninit(4).to[@U8]()
    has_block: Bool = raw.is_not_hollow()
    Out.write("uninitialized block: {has_block}\n")
    rf_invalidate(raw)
    rf_invalidate(gone)
    rf_invalidate(.hollow())
    return

routine region() -> None
    outer: U64 = rf_region_mark()
    Out.write("empty region mark: {outer}\n")
    first: @U8 = rf_region_alloc(16).to[@U8]()
    show_bytes(label: "region block, zeroed", p: first, count: 16)
    inner: U64 = rf_region_mark()
    rf_region_alloc(32)
    rf_region_alloc(8)
    moved: Bool = rf_region_mark() != inner
    rf_region_release(inner)
    back_inner: Bool = rf_region_mark() == inner
    rf_region_release(outer)
    back_outer: Bool = rf_region_mark() == outer
    Out.write("mark moved: {moved}, released to the inner mark: {back_inner}, to the outer: {back_outer}\n")
    return

routine start() -> None
    heap()
    region()
    rf_allocate_dynamic(U64.MAX)
    Out.write("not reached\n")
    return
