# x^n and (a + b) / 2 rounded once, for D32, D64, D128, and Decimal. An exact power keeps the exponent n times x's
# (2.0^2 is 4.00, 10^3 is 1000), x^0 is 1, and a power with one digit too many is a tie: 2^-11 is 0.00048828125 (8
# digits, D32), 5^-24 is 1.6777216E-17 (D32 and D64 round it), 1.5^29 is 127834.03948858939111232757568359375 (35
# digits, D128 and Decimal). A midpoint of two neighbours is a tie, and the midpoint of the largest value with itself
# is that value (the sum is not rounded on its own, so it doesn't overflow). D32, D64, and D128 round a tie to the even
# neighbour, Decimal half up. decimal_powi_midpoint.expected holds the results, checked against Python's decimal module.

import Hosted
import Ingrid/Decimal

### Shows x^n for D32, D64, D128, and Decimal.
### :param text: The base.
### :param n: The exponent.
routine show_powi(text: @[Byte], n: S32) -> None
    a: D32 = text.to[D32]()
    b: D64 = text.to[D64]()
    c: D128 = text.to[D128]()
    d: Decimal = text.to[Decimal]()
    Console.show("{text}^{n}: {a.powi_unchecked(n)} {b.powi_unchecked(n)} {c.powi_unchecked(n)} {d.powi(n)}")
    return

### Shows (a + b) / 2 for D32, D64, and D128.
### :param x: The first value.
### :param y: The second value.
routine show_midpoint(x: @[Byte], y: @[Byte]) -> None
    a: D32 = x.to[D32]()
    b: D64 = x.to[D64]()
    c: D128 = x.to[D128]()
    Console.show("mid {x} {y}: {a.midpoint(y.to[D32]())} {b.midpoint(y.to[D64]())} {c.midpoint(y.to[D128]())}")
    return

### Prints the powers and midpoints.
routine start() -> None
    show_powi("2.0", 2)
    show_powi("10", 3)
    show_powi("7", 0)
    show_powi("2", -11)
    show_powi("5", -24)
    show_powi("1.5", 29)
    show_powi("-1.5", 29)
    show_powi("1.1", 30)
    show_powi("-0", 3)
    show_powi("0.5", -3)
    show_midpoint("1000001", "1000002")
    show_midpoint("1000002", "1000003")
    show_midpoint("-1000001", "-1000002")
    show_midpoint("10", "30")
    show_midpoint("1.0", "2.0")
    show_midpoint("9.999999E96", "9.999999E96")
    dm: Decimal = "9.999999999999999999999999999999999E+6144".to[Decimal]()
    d1: Decimal = "1000000000000000000000000000000001".to[Decimal]()
    d2: Decimal = "1000000000000000000000000000000002".to[Decimal]()
    Console.show("decimal mid: {dm.midpoint(dm)} {d1.midpoint(d2)} {d1.neg().midpoint(d2.neg())}")
    return
