# __emutls_get_address (builtins.te), the accessor the in-process JIT calls for a thread-local, without the rest
# of the runtime library. A thread-local is made from its initial value, then one too
# large to allocate raises OutOfMemoryError instead of copying into a null object.

module Ingrid/Runtime

import Hosted

### Whether the stand-in c_realloc fails.
global REALLOC_FAILS: &Bool

# -- what builtins.te calls in the rest of the runtime library ---------------------

@external("c")
@symbol("calloc")
routine c_calloc(count: CSize, size: CSize) -> Addr

@external("c")
@symbol("realloc")
routine c_realloc_real(ptr: Addr, size: CSize) -> Addr

@external("c")
@symbol("memcpy")
routine c_memcpy(dst: Addr, src: Addr, n: CSize) -> Addr

### C's realloc, or a failure (null) when REALLOC_FAILS says so. It takes its arguments in order, as the C one it
### stands in for.
@positional
routine c_realloc(ptr: Addr, size: CSize) -> Addr
    if REALLOC_FAILS.peek()
        return Addr.zero()
    else
        return c_realloc_real(ptr, size)

### count zeroed Ts.
routine zeroed[T](count: U64, what: CStrView) -> @T
    p: Addr = c_calloc(count.to[CSize](), sizeof[T]().to[CSize]())
    return p.to[@T]()

@external("c")
@symbol("exit")
@noreturn
routine exit(status: CInt) -> None

### Reports the error RazorForge would raise and exits with status 3.
@noreturn
routine rf_throw(error_type: CStrView, message: CStrView) -> None
    Console.show("{error_type.getview()}: {message.getview()}")
    exit(3)

routine start() -> None
    value: &U64 <- 42
    plain: &EmutlsControl <- (size: 8, align: 8, index: 0, value: value)
    huge: &EmutlsControl <- (size: U64.MAX >> 1, align: 8, index: 0, value: Addr.zero())

    first: Addr = emutls_get_address(plain)
    Console.show("first variable: {first.to[@U64]().peek()}")
    unreached: Addr = emutls_get_address(huge)
    Console.show("not reached {unreached}")
    return
