# RoamHeader's field offsets as ingrid_roam_field_offset reports them, the layout RazorForge's `RoamManager[T]` has
# to match field for field. Past the last field it answers U64.MAX. The offsets are a 64-bit target's, so
# roam_layout.arch lists the 64-bit architectures.
#
# The RazorForge runtime library's routines that roam.te calls are defined here so the program links. Nothing here
# calls them.

import Standard/Os

@export("rf_access_flow_id")
routine stub_current_task_id() -> U64
    return 1

@export("rf_coro_yield")
routine stub_coro_yield() -> None
    return

@export("rf_access_wait_begin")
routine stub_access_wait_begin(lock: Addr, holder: @U64) -> None
    return

@export("rf_access_wait_end")
routine stub_access_wait_end() -> None
    return

routine start() -> None
    loop with i: U64 = 0
        offset2: U64 = roam_field_offset(i)
        Console.show("field {i}: {offset2}")
        if offset2 == U64.MAX
            return
        else
            continue with i: i + 1
