# RoamHeader's field offsets as ingrid_roam_field_offset reports them, the layout Revare's `RoamManager[T]` has
# to match field for field. Past the last field it answers U64.MAX. The offsets are a 64-bit target's, so
# roam_layout.arch lists the 64-bit architectures.
#
# The Revare runtime library's routines that roam.lpa calls are defined here so the program links. Nothing here
# calls them.

import Hosted

@export("rf_access_flow_id")
routine stub_current_task_id() -> U64
    return 1

@export("rf_coro_yield")
routine stub_coro_yield() -> None
    return

@export("rf_access_wait_begin")
routine stub_access_wait_begin(lock: Addr, holder: @U64) -> None
    return

@export("rf_access_wait_end")
routine stub_access_wait_end() -> None
    return

### The slot store (slots.lpa) reports a failed allocation through the runtime's error report: here it writes the
### error and ends the program.
### :param error_type: The error's name.
### :param message: What went wrong.
@export("__rf_throw")
@noreturn
routine stub_rf_throw(error_type: CStrView, message: CStrView) -> None
    kind: @[Byte] = error_type.getview()
    text: @[Byte] = message.getview()
    Console.show("{kind}: {text}")
    ProcessManager.exit_process(82)

routine start() -> None
    loop with i: U64 = 0
        offset2: U64 = roam_field_offset(i)
        Console.show("field {i}: {offset2}")
        if offset2 == U64.MAX
            return
        else
            continue with i: i + 1
