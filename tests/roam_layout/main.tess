// RoamHeader's field offsets as ingrid_roam_field_offset reports them, the layout RazorForge's `RoamController[T]` has
// to match field for field. Past the last field it answers U64.MAX. The offsets are a 64-bit target's, so
// roam_layout.arch lists the 64-bit architectures.
//
// The RazorForge runtime library's routines that roam.tess and deadlock.tess call are defined here so the program
// links. Nothing here calls them.

import Standard::Format
import Standard::Os

#export("rf_current_task_id")
routine stub_current_task_id() -> U64
    block entry()
        return(1)

#export("rf_coro_yield")
routine stub_coro_yield() -> Void
    block entry()
        return()

#[export("rf_crash_exit"), noreturn]
routine stub_crash_exit() -> Void
    block entry()
        exit(82)

routine main() -> S32
    block entry()
        jump field(0)

    block field(i: U64)
        offset : U64 = roam_field_offset(i)
        Out.write("field {i}: {offset}\n")
        branch offset.eq(U64.MAX)
            ? return(0)
            : field(i.add(1))
