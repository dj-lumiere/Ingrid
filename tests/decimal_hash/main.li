# The hashes of D32, D64, and D128 are of the value, not of its digits: 1.0, 1.00, and 1E+0 hash the same, +0 and
# -0 (equal) hash the same, the same value in two widths hashes the same, and the specials hash apart from each
# other. Each line compares hashes, so it doesn't depend on the process key.

import Hosted
import Ingrid/Decimal

### Prints whether the hashes of equal and of different values match.
routine start() -> None
    a: D128 = "1.0".to[D128]()
    b: D128 = "1.00".to[D128]()
    c: D128 = "1E+0".to[D128]()
    z: D128 = "0".to[D128]()
    nz: D128 = "-0.000".to[D128]()
    two: D128 = "2".to[D128]()
    Console.show("D128 1.0 and 1.00: {a.hash() == b.hash()}, 1.0 and 1E+0: {a.hash() == c.hash()}")
    Console.show("D128 0 and -0.000: {z.hash() == nz.hash()}, 1 and 2: {a.hash() == two.hash()}")
    x: D64 = "2.50".to[D64]()
    y: D64 = "2.5".to[D64]()
    w: D32 = "2.500".to[D32]()
    v: D32 = "25E-1".to[D32]()
    Console.show("D64 2.50 and 2.5: {x.hash() == y.hash()}, D32 2.500 and 25E-1: {w.hash() == v.hash()}")
    Console.show("D64 2.50 and D32 2.500: {x.hash() == w.hash()}")
    n1: D128 = "NaN".to[D128]()
    n2: D128 = "-NaN".to[D128]()
    i1: D128 = "inf".to[D128]()
    i2: D128 = "-inf".to[D128]()
    Console.show("NaN and -NaN: {n1.hash() == n2.hash()}, NaN and inf: {n1.hash() == i1.hash()}")
    Console.show("inf and -inf: {i1.hash() == i2.hash()}")
    return
