// SipHash-2-4 through Ingrid's two entry points. The first line of each kind is the reference implementation's test
// vector (key 00..0f, message 00..07 for one U64 and 00..0f for one U128, as the bytes they are in memory). The rest
// are other keys and values, checked against a Python model of the algorithm.

import Standard/Format
import Standard/Os

/// Writes a U64 as 16 lowercase hex digits.
routine write_word(value: U64) -> Void
    block entry()
        hex: Hex[U64] = Hex[U64](value: value)
        represent_with_into(out: Out.writer(), value: hex, spec: FormatSpec.zero_padded(16))
        return()

routine check_u64(value: U64, k0: U64, k1: U64) -> Void
    block entry()
        Out.write("u64 ")
        write_word(value)
        Out.write(" key ")
        write_word(k0)
        Out.write(" ")
        write_word(k1)
        Out.write(": ")
        write_word(siphash24_u64(value, k0, k1))
        Out.write("\n")
        return()

routine check_u128(low: U64, high: U64, k0: U64, k1: U64) -> Void
    block entry()
        Out.write("u128 ")
        write_word(high)
        write_word(low)
        Out.write(" key ")
        write_word(k0)
        Out.write(" ")
        write_word(k1)
        Out.write(": ")
        write_word(siphash24_u128(low, high, k0, k1))
        Out.write("\n")
        return()

routine start() -> Void
    block entry()
        check_u64(value: 0x0706050403020100, k0: 0x0706050403020100, k1: 0x0F0E0D0C0B0A0908)
        check_u64(value: 0, k0: 0, k1: 0)
        check_u64(value: U64.MAX, k0: 0, k1: 0)
        check_u64(value: 0, k0: U64.MAX, k1: U64.MAX)
        check_u64(value: 1, k0: 2, k1: 3)
        check_u64(value: 0x123456789ABCDEF0, k0: 0xDEADBEEFCAFEBABE, k1: 0x0123456789ABCDEF)
        check_u64(value: 0x8000000000000000, k0: 1, k1: 0)
        check_u128(low: 0x0706050403020100, high: 0x0F0E0D0C0B0A0908, k0: 0x0706050403020100,
            k1: 0x0F0E0D0C0B0A0908)
        check_u128(low: 0, high: 0, k0: 0, k1: 0)
        check_u128(low: U64.MAX, high: U64.MAX, k0: U64.MAX, k1: U64.MAX)
        check_u128(low: 1, high: 0, k0: 0, k1: 1)
        check_u128(low: 0x0123456789ABCDEF, high: 0xFEDCBA9876543210, k0: 0x1111111111111111,
            k1: 0x2222222222222222)
        return()
