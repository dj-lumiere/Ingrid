// SipHash-2-4 through Ingrid's two entry points. The first line of each kind is the reference implementation's test
// vector (key 00..0f, message 00..07 for one U64 and 00..0f for one U128, as the bytes they are in memory). The rest
// are other keys and values, checked against a Python model of the algorithm.

import Standard::Format
import Standard::Os

/// Writes a U64 as 16 lowercase hex digits.
routine write_word(value: U64) -> Void
    block entry()
        hex : Hex<U64> = Hex<U64> { value: value }
        represent_with_into(Out.writer(), hex, FormatSpec.zero_padded(16))
        return()

routine check_u64(value: U64, k0: U64, k1: U64) -> Void
    block entry()
        Out.write("u64 ")
        write_word(value)
        Out.write(" key ")
        write_word(k0)
        Out.write(" ")
        write_word(k1)
        Out.write(": ")
        write_word(siphash24_u64(value, k0, k1))
        Out.write("\n")
        return()

routine check_u128(low: U64, high: U64, k0: U64, k1: U64) -> Void
    block entry()
        Out.write("u128 ")
        write_word(high)
        write_word(low)
        Out.write(" key ")
        write_word(k0)
        Out.write(" ")
        write_word(k1)
        Out.write(": ")
        write_word(siphash24_u128(low, high, k0, k1))
        Out.write("\n")
        return()

routine start() -> Void
    block entry()
        check_u64(0x0706050403020100, 0x0706050403020100, 0x0F0E0D0C0B0A0908)
        check_u64(0, 0, 0)
        check_u64(U64.MAX, 0, 0)
        check_u64(0, U64.MAX, U64.MAX)
        check_u64(1, 2, 3)
        check_u64(0x123456789ABCDEF0, 0xDEADBEEFCAFEBABE, 0x0123456789ABCDEF)
        check_u64(0x8000000000000000, 1, 0)
        check_u128(0x0706050403020100, 0x0F0E0D0C0B0A0908, 0x0706050403020100, 0x0F0E0D0C0B0A0908)
        check_u128(0, 0, 0, 0)
        check_u128(U64.MAX, U64.MAX, U64.MAX, U64.MAX)
        check_u128(1, 0, 0, 1)
        check_u128(0x0123456789ABCDEF, 0xFEDCBA9876543210, 0x1111111111111111, 0x2222222222222222)
        return()
