# The deadlock detector's bookkeeping on one thread, turned on through RF_DEADLOCK_DETECT before its first use. Waits
# that form no cycle are recorded and cleared without a report: a wait on no holder, a task waiting on itself, and a
# wait that ended before the opposite one began. Then three tasks wait in a ring (3 on 4, 4 on 5, 5 on 3), and the
# last wait closes it: the detector reports the two tasks and exits through rf_crash_exit.
#
# rf_crash_exit is the RazorForge runtime library's. This program defines it (exit status 82, as the runtime's).
# The report goes to standard error, and the test runner compares standard output, so the program first points
# standard error at standard output.

import Standard/Format
import Standard/Os

@external("c")
@symbol("dup2")
@target(os: ("linux", "macos"))
routine c_dup2(from: CInt, to: CInt) -> CInt

@external("c")
@symbol("setenv")
@target(os: ("linux", "macos"))
routine c_setenv(name: CStrView, value: CStrView, overwrite: CInt) -> CInt

@external("c")
@symbol("GetStdHandle")
@callconv("stdcall")
@target(os: "windows")
routine win_get_std_handle(which: U32) -> Addr

@external("c")
@symbol("SetStdHandle")
@callconv("stdcall")
@target(os: "windows")
routine win_set_std_handle(which: U32, handle: Addr) -> CInt

@external("c")
@symbol("_putenv_s")
@target(os: "windows")
routine c_putenv_s(name: CStrView, value: CStrView) -> CInt

@export("rf_crash_exit")
@noreturn
routine stub_crash_exit() -> None
    Console.show("crash exit")
    exit(82)

### Points standard error at standard output.
@target(os: ("linux", "macos"))
routine merge_error_into_output() -> None
    c_dup2(1, 2)
    return

@target(os: "windows")
routine merge_error_into_output() -> None
    # STD_OUTPUT_HANDLE, STD_ERROR_HANDLE
    output: Addr = win_get_std_handle(0xFFFFFFF5)
    win_set_std_handle(0xFFFFFFF4, output)
    return

@target(os: ("linux", "macos"))
routine set_detector(value: CStrView) -> None
    c_setenv("RF_DEADLOCK_DETECT", value, 1)
    return

@target(os: "windows")
routine set_detector(value: CStrView) -> None
    c_putenv_s("RF_DEADLOCK_DETECT", value)
    return

routine show_waits(label: @[Byte]) -> None
    local used: @U64 <- 0

    each i in 0 til WAIT_SLOTS
        slot: @DeadlockWait = WAITS.getslot(i)
        here: U64 = slot.used.peek().to[U64]()
        (used.peek() + here).poke_into(used)
    Console.show("{label}: {used.peek()} waiting")
    return

routine start() -> None
    merge_error_into_output()
    set_detector("1")
    on: Bool = is_detector_on()
    Console.show("detector on: {on}")
    deadlock_wait_begin(waiter: 1, holder: 0)
    deadlock_wait_begin(waiter: 1, holder: 1)
    show_waits("no holder, or itself")
    deadlock_wait_begin(waiter: 1, holder: 2)
    show_waits("1 waits on 2")
    deadlock_wait_end(1)
    deadlock_wait_begin(waiter: 2, holder: 1)
    show_waits("1 got it, 2 waits on 1")
    deadlock_wait_end(2)
    show_waits("2 got it")
    deadlock_wait_begin(waiter: 3, holder: 4)
    deadlock_wait_begin(waiter: 4, holder: 5)
    show_waits("3 waits on 4, 4 on 5")
    deadlock_wait_begin(waiter: 5, holder: 3)
    Console.show("not reached")
    return
