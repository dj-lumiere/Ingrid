# Dividing the zero quaternion by itself is 0 / 0, which crashes with RazorForge's NumericDomainError, as real
# 0 / 0 does, while a nonzero quaternion over zero is a DivisionByZeroError (quaternion.te and finite.te). The
# program's own crash handler writes the crash's name and message to standard output and exits with status 82,
# RazorForge's crash status.

import Standard/Os

@export("tessera_crash_handler")
@noreturn
routine report(name: @[Byte], message: @[Byte], place: @SourceLocation) -> None
    Console.show("{name}: {message}")
    ProcessManager.exit_process(82)

routine start() -> None
    Console.show("before")
    q: Words = q256_div(w: 0.0, x: 0.0, y: 0.0, z: 0.0, other_w: 0.0, other_x: 0.0, other_y: 0.0,
        other_z: 0.0)
    Console.show("not reached {q.w0}")
    return
