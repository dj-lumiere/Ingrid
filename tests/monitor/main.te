# RazorForge's SignalCaster (monitor.te) without the rest of the runtime library: this program stands in for the
# RazorForge scheduler and its coroutines, and prints what the SignalCaster asks of them.
#
# The handle count goes up and down. A coroutine's wait parks it on the scheduler with a promised cross-thread
# waker, and a cast during the park wakes it and leaves no node behind. A wait with a deadline reports 1 when a cast
# comes and 0 when the time runs out. With two coroutines parked, cast_one wakes the newest only and cast_all both,
# newest first. Plain threads wait on the SignalCaster: a wait with a deadline nobody casts gives 0 at its deadline,
# cast_one with one token lets exactly one of three waiting threads through each time, and one cast_all lets three
# through a gate.

module Ingrid/Runtime

import Standard/Os

### The scheduler and coroutine rf_sched_current and current_coro report: null on a plain thread.
global CURRENT_SCHED: @@Sched
global CURRENT_CORO: @@Coro

### The scheduler and the coroutine the test stands in for, for as long as the program runs.
global THE_SCHED: @Sched <- (id: 1)
global THE_CORO: @Coro <- (id: 7)

### Two parked coroutines on a monitor's wait list, the newer first.
global OLDER: @Coro <- (id: 1)
global NEWER: @Coro <- (id: 2)
global FIRST_WAITER: @ChannelWaiter <- (sched: THE_SCHED, coro: OLDER, next: .hollow())
global SECOND_WAITER: @ChannelWaiter <- (sched: THE_SCHED, coro: NEWER, next: FIRST_WAITER)

### The SignalCaster a park casts on, as another agent would meanwhile, or null to let the time run out.
global CAST_DURING_PARK: @@Monitor

### The threads at the gate.
preset GATE_THREADS: U64 = 3

### The scheduler a coroutine runs on: the test's stand-in, a number.
record Sched
    id: U32

### A coroutine: the test's stand-in, a number.
record Coro
    id: U32

### A parked coroutine, in a node on its own stack while it is linked (as in channel.te).
record ChannelWaiter
    sched: @Sched
    coro: @Coro
    next: @ChannelWaiter

### Threads at a gate: they wait for a token (cast_one) or for the gate to open (cast_all), and the main thread waits
### for them on the same SignalCaster.
record Gate
    sig: @Monitor
    arrived: U64
    tokens: U64
    passed: U64
    open: Bool

# -- what monitor.te calls in the rest of the runtime library ----------------------

@external("c")
@symbol("calloc")
routine c_calloc(count: CSize, size: CSize) -> Addr

@external("c")
@symbol("free")
routine c_free(ptr: Addr) -> None

### count zeroed Ts.
routine zeroed[T](count: U64, what: CStrView) -> @T
needs T: typename
    p: Addr = c_calloc(count.to[CSize](), sizeof[T]().to[CSize]())
    return p.to[@T]()

### Takes node off list (as in channel.te).
routine unlink(list: @@ChannelWaiter, node: @ChannelWaiter) -> None
    loop with at: @@ChannelWaiter = list
        w2: @ChannelWaiter = at.peek()
        if w2.is_hollow()
            return
        if w2 !== node
            continue with at: w2.next
        else
            at.poke(node.next.peek())
            node.next.poke(.hollow())
            return

routine rf_sched_current() -> @Sched
    return CURRENT_SCHED.peek()

routine current_coro() -> @Coro
    return CURRENT_CORO.peek()

routine rf_sched_arm_cross_waker(s: @Sched) -> None
    Console.show("  cross-thread waker armed on scheduler {s.id.peek()}")
    return

routine rf_sched_disarm_cross_waker(s: @Sched) -> None
    Console.show("  cross-thread waker disarmed on scheduler {s.id.peek()}")
    return

routine rf_sched_wake(s: @Sched, c: @Coro) -> None
    Console.show("  wake coroutine {c.id.peek()} on scheduler {s.id.peek()}")
    return

### The coroutine is off its thread: another agent casts meanwhile, if CAST_DURING_PARK says so.
routine rf_sched_park_external() -> None
    sig: @Monitor = CAST_DURING_PARK.peek()
    Console.show("  parked, {count_waiters(sig)} on the wait list")
    rf_signal_cast_one(sig)
    return

### As rf_sched_park_external, until a cast or the delay has passed.
routine rf_sched_park_deadline(delay_ns: U64) -> None
    sig: @Monitor = CAST_DURING_PARK.peek()
    if sig.is_hollow()
        Console.show("  parked with a deadline, no cast comes")
        sleep_until(Clock.monotonic() + Duration.from_nanoseconds(delay_ns.to[S64]()))
        return
    else
        Console.show("  parked with a deadline, a cast comes")
        rf_signal_cast_one(sig)
        return

# -- helpers -------------------------------------------------------------------------

### Sleeps the thread until `deadline`, in Clock.monotonic() time.
routine sleep_until(deadline: Duration) -> None
    local never: @U32 <- 0

    loop
        now2: Duration = Clock.monotonic()
        if now2 >= deadline
            return
        wait_on_for(at: never, expected: 0, timeout: deadline - now2)

### The coroutines on the SignalCaster's wait list.
routine count_waiters(sig: @Monitor) -> U64
    local found: @U64 <- 0

    until w.is_hollow() with w: @ChannelWaiter = sig.waiters.peek()
        (found.peek() + 1).poke_into(found)
        continue with w: w.next.peek()
    then
        return found.peek()

### Waits on `sig` from a plain thread until `timeout_ns` has passed, again after every wait that returns 1 (a wait
### may return without a cast).
### :returns: The last wait's result, 0 once the time is up.
routine wait_out(sig: @Monitor, timeout_ns: U64) -> U32
    local deadline: Duration = Clock.monotonic() + Duration.from_nanoseconds(timeout_ns.to[S64]())

    loop
        left2: Duration = deadline -^ Clock.monotonic()
        result2: U32 = rf_signal_wait_deadline(sig,
            timeout_ns: left2.max(0s).nanoseconds().to[U64]())
        if result2 == 1
            continue
        else
            return result2

# -- the gate ------------------------------------------------------------------------

### Counts the calling thread in, holding the SignalCaster, and wakes the main thread. A cast takes the SignalCaster
### itself, so it comes between an unlock and a lock.
routine arrive(gate: @Gate) -> None
    arrived: U64 = gate.arrived.peek() + 1
    arrived.poke_into(gate.arrived)
    rf_signal_unlock(gate.sig.peek())
    rf_signal_cast_all(gate.sig.peek())
    rf_signal_lock(gate.sig.peek())
    return

### Counts the calling thread through, holding the SignalCaster, releases it, and wakes the main thread.
routine let_through(gate: @Gate) -> None
    through: U64 = gate.passed.peek() + 1
    through.poke_into(gate.passed)
    rf_signal_unlock(gate.sig.peek())
    rf_signal_cast_all(gate.sig.peek())
    return

### A gate thread that waits for a token and takes it. It gets the gate as an Addr, which the build doesn't follow:
### the monitor, RazorForge's own exclusive access, guards it.
### :param at: The gate.
routine take_token(at: Addr) -> None
    gate: @Gate = at.to[@Gate]()
    rf_signal_lock(gate.sig.peek())
    arrive(gate)

    loop
        left2: U64 = gate.tokens.peek()
        if left2 > 0
            gate.tokens.poke(left2 - 1)
            let_through(gate)
            return
        else
            rf_signal_wait(gate.sig.peek())
            continue

### A gate thread that waits for the gate to open. It gets the gate as an Addr, which the build doesn't follow: the
### monitor guards it.
### :param at: The gate.
routine pass_open(at: Addr) -> None
    gate: @Gate = at.to[@Gate]()
    rf_signal_lock(gate.sig.peek())
    arrive(gate)

    until gate.open.peek()
        rf_signal_wait(gate.sig.peek())
    let_through(gate)
    return

### Waits, holding the SignalCaster, until `count` gate threads have arrived. Each holds it from arriving until its
### wait releases it, so all of them wait by then.
routine await_arrived(gate: @Gate, count: U64) -> None
    until gate.arrived.peek() >= count
        rf_signal_wait(gate.sig.peek())
    then
        return

### Waits, holding the SignalCaster, until `count` gate threads are through.
routine await_passed(gate: @Gate, count: U64) -> None
    until gate.passed.peek() >= count
        rf_signal_wait(gate.sig.peek())
    then
        return

### Gives the waiting gate threads one token at a time, each with one cast_one, and waits for one to go through.
### :returns: Whether each token let exactly one through.
routine hand_tokens(gate: @Gate) -> Bool
    local exact: @Bool <- true

    rf_signal_lock(gate.sig.peek())
    await_arrived(gate, count: GATE_THREADS)

    each round in 1 to GATE_THREADS
        gate.tokens.poke(1)
        rf_signal_unlock(gate.sig.peek())
        rf_signal_cast_one(gate.sig.peek())
        rf_signal_lock(gate.sig.peek())
        await_passed(gate, count: round)
        through: U64 = gate.passed.peek()
        one: Bool = through == round and gate.tokens.peek() == 0
        (exact.peek() and one).poke_into(exact)
    rf_signal_unlock(gate.sig.peek())
    return exact.peek()

### Opens the gate once every gate thread waits at it, with one cast_all, and waits for them all to go through.
routine open_gate(gate: @Gate) -> None
    rf_signal_lock(gate.sig.peek())
    await_arrived(gate, count: GATE_THREADS)
    gate.open.poke(true)
    rf_signal_unlock(gate.sig.peek())
    rf_signal_cast_all(gate.sig.peek())
    rf_signal_lock(gate.sig.peek())
    await_passed(gate, count: GATE_THREADS)
    rf_signal_unlock(gate.sig.peek())
    return

# -- the test ------------------------------------------------------------------------

### The handle count, and a coroutine parked by each kind of wait.
routine coroutines(sig: @Monitor) -> None
    Console.show("handles: {sig.refcount.peek()}")
    rf_signal_add_ref(sig)
    Console.show("after add_ref: {sig.refcount.peek()}")
    rf_signal_drop(sig)
    Console.show("after drop: {sig.refcount.peek()}")
    CURRENT_SCHED.poke(THE_SCHED)
    CURRENT_CORO.poke(THE_CORO)
    CAST_DURING_PARK.poke(sig)
    Console.show("a coroutine waits:")
    rf_signal_lock(sig)
    rf_signal_wait(sig)
    Console.show("  back, {count_waiters(sig)} on the wait list")
    Console.show("a coroutine waits with a deadline:")
    cast: U32 = rf_signal_wait_deadline(sig, timeout_ns: 1000000000)
    Console.show("  result {cast}, {count_waiters(sig)} on the wait list")
    CAST_DURING_PARK.poke(.hollow())
    late: U32 = rf_signal_wait_deadline(sig, timeout_ns: 2000000)
    Console.show("  result {late}, {count_waiters(sig)} on the wait list")
    rf_signal_unlock(sig)
    sig.waiters.poke(SECOND_WAITER)
    Console.show("two coroutines parked, cast_one:")
    rf_signal_cast_one(sig)
    Console.show("cast_all:")
    rf_signal_cast_all(sig)
    sig.waiters.poke(.hollow())
    CURRENT_SCHED.poke(.hollow())
    CURRENT_CORO.poke(.hollow())
    return

routine start() -> None
    sig: @Monitor = rf_signal_create()
    coroutines(sig)
    rf_signal_lock(sig)
    start: Duration = Clock.monotonic()
    result: U32 = wait_out(sig, timeout_ns: 2000000)
    waited: Duration = Clock.monotonic() - start
    rf_signal_unlock(sig)
    Console.show("a thread waits with a deadline: result {result}, waited it out {waited >= 2ms}")
    local tokens: @Gate <- Gate(sig: sig, arrived: 0, tokens: 0, passed: 0, open: false)
    t1: Thread[None] = get_thread[None]()
    t1.put_work(entry: take_token.to[Callable](), args: tokens.to[Addr]())
    t2: Thread[None] = get_thread[None]()
    t2.put_work(entry: take_token.to[Callable](), args: tokens.to[Addr]())
    t3: Thread[None] = get_thread[None]()
    t3.put_work(entry: take_token.to[Callable](), args: tokens.to[Addr]())
    exact: Bool = hand_tokens(tokens)
    t1.wait_finished()
    t1.give_back()
    t2.wait_finished()
    t2.give_back()
    t3.wait_finished()
    t3.give_back()
    Console.show("cast_one: {GATE_THREADS} tokens, one thread through for each: {exact}")
    local gate: @Gate <- Gate(sig: sig, arrived: 0, tokens: 0, passed: 0, open: false)
    u1: Thread[None] = get_thread[None]()
    u1.put_work(entry: pass_open.to[Callable](), args: gate.to[Addr]())
    u2: Thread[None] = get_thread[None]()
    u2.put_work(entry: pass_open.to[Callable](), args: gate.to[Addr]())
    u3: Thread[None] = get_thread[None]()
    u3.put_work(entry: pass_open.to[Callable](), args: gate.to[Addr]())
    open_gate(gate)
    u1.wait_finished()
    u1.give_back()
    u2.wait_finished()
    u2.give_back()
    u3.wait_finished()
    u3.give_back()
    Console.show("cast_all: {gate.passed.peek()} of {GATE_THREADS} through")
    rf_signal_drop(sig)
    return
