// RazorForge's SignalCaster (monitor.tess) without the rest of the runtime library: this program stands in for the
// RazorForge scheduler and its coroutines, and prints what the SignalCaster asks of them.
//
// The handle count goes up and down. A coroutine's wait parks it on the scheduler with a promised cross-thread
// waker, and a cast during the park wakes it and leaves no node behind. A wait with a deadline reports 1 when a cast
// comes and 0 when the time runs out. With two coroutines parked, cast_one wakes the newest only and cast_all both,
// newest first. Plain threads wait on the SignalCaster: a wait with a deadline nobody casts gives 0 at its deadline,
// cast_one with one token lets exactly one of three waiting threads through each time, and one cast_all lets three
// through a gate.

module Ingrid/Runtime

import Standard/Alloc
import Standard/Format
import Standard/Os

/// The scheduler and coroutine rf_sched_current and current_coro report: null on a plain thread.
global CURRENT_SCHED: @@Sched
global CURRENT_CORO: @@Coro

/// The scheduler and the coroutine the test stands in for, for as long as the program runs.
global THE_SCHED: @Sched <- (id: 1)
global THE_CORO: @Coro <- (id: 7)

/// Two parked coroutines on a monitor's wait list, the newer first.
global OLDER: @Coro <- (id: 1)
global NEWER: @Coro <- (id: 2)
global FIRST_WAITER: @ChannelWaiter <- (sched: THE_SCHED, coro: OLDER, next: null)
global SECOND_WAITER: @ChannelWaiter <- (sched: THE_SCHED, coro: NEWER, next: FIRST_WAITER)

/// The SignalCaster a park casts on, as another agent would meanwhile, or null to let the time run out.
global CAST_DURING_PARK: @@Monitor

/// The threads at the gate.
preset GATE_THREADS: USize = 3

/// The scheduler a coroutine runs on: the test's stand-in, a number.
record Sched
    id: U32

/// A coroutine: the test's stand-in, a number.
record Coro
    id: U32

/// A parked coroutine, in a node on its own stack while it is linked (as in channel.tess).
record ChannelWaiter
    sched: @Sched
    coro: @Coro
    next: @ChannelWaiter

/// Threads at a gate: they wait for a token (cast_one) or for the gate to open (cast_all), and the main thread waits
/// for them on the same SignalCaster.
record Gate
    sig: @Monitor
    arrived: USize
    tokens: USize
    passed: USize
    open: Bool

/// Makes a `Sched` from its fields.
/// :param id: Its `id`.
/// :returns: The new value.
routine Sched.construct(id: U32) -> Me
    return(Me(id))

/// Releases nothing: a `Sched` holds no memory of its own.
routine Sched.destruct(me: @Me) -> Void
    return()

/// Makes a `Coro` from its fields.
/// :param id: Its `id`.
/// :returns: The new value.
routine Coro.construct(id: U32) -> Me
    return(Me(id))

/// Releases nothing: a `Coro` holds no memory of its own.
routine Coro.destruct(me: @Me) -> Void
    return()

/// Makes a `ChannelWaiter` from its fields.
/// :param sched: Its `sched`.
/// :param coro: Its `coro`.
/// :param next: Its `next`.
/// :returns: The new value.
routine ChannelWaiter.construct(sched: @Sched, coro: @Coro, next: @Me) -> Me
    return(Me(sched, coro, next))

/// Releases nothing: a `ChannelWaiter` holds no memory of its own.
routine ChannelWaiter.destruct(me: @Me) -> Void
    return()

/// Makes a `Gate` from its fields.
/// :param sig: Its `sig`.
/// :param arrived: Its `arrived`.
/// :param tokens: Its `tokens`.
/// :param passed: Its `passed`.
/// :param open: Its `open`.
/// :returns: The new value.
routine Gate.construct(sig: @Monitor, arrived: USize, tokens: USize, passed: USize,
    open: Bool) -> Me
    return(Me(sig, arrived, tokens, passed, open))

/// Releases nothing: a `Gate` holds no memory of its own.
routine Gate.destruct(me: @Me) -> Void
    return()

// -- what monitor.tess calls in the rest of the runtime library ----------------------

#[external("c"), symbol("calloc")]
routine c_calloc(count: USize, size: USize) -> Addr

#[external("c"), symbol("free")]
routine c_free(ptr: Addr) -> Void

/// count zeroed Ts.
routine zeroed[T](count: USize, what: CStr) -> @T
require T: typename
    p: Addr = c_calloc(count, sizeof[T]())
    return(p.to[@T]())

/// Takes node off list (as in channel.tess).
routine unlink(list: @@ChannelWaiter, node: @ChannelWaiter) -> Void
    jump look(list)

    block look(at: @@ChannelWaiter)
        w: @ChannelWaiter = at.peek()
        branch w.is_null()
            ? return()
            : continue
        branch w.ptr_eq(node)
            ? continue
            : look(w.next)
        at.poke(node.next.peek())
        node.next.poke(null)
        return()

routine rf_sched_current() -> @Sched
    return(CURRENT_SCHED.peek())

routine current_coro() -> @Coro
    return(CURRENT_CORO.peek())

routine rf_sched_arm_cross_waker(s: @Sched) -> Void
    Out.write("  cross-thread waker armed on scheduler {s.id.peek()}\n")
    return()

routine rf_sched_disarm_cross_waker(s: @Sched) -> Void
    Out.write("  cross-thread waker disarmed on scheduler {s.id.peek()}\n")
    return()

routine rf_sched_wake(s: @Sched, c: @Coro) -> Void
    Out.write("  wake coroutine {c.id.peek()} on scheduler {s.id.peek()}\n")
    return()

/// The coroutine is off its thread: another agent casts meanwhile, if CAST_DURING_PARK says so.
routine rf_sched_park_external() -> Void
    sig: @Monitor = CAST_DURING_PARK.peek()
    Out.write("  parked, {count_waiters(sig)} on the wait list\n")
    rf_signal_cast_one(sig)
    return()

/// As rf_sched_park_external, until a cast or the delay has passed.
routine rf_sched_park_deadline(delay_ns: U64) -> Void
    sig: @Monitor = CAST_DURING_PARK.peek()
    branch sig.is_null()
        ? time_out()
        : continue
    Out.write("  parked with a deadline, a cast comes\n")
    rf_signal_cast_one(sig)
    return()

    block time_out()
        Out.write("  parked with a deadline, no cast comes\n")
        sleep_until(monotonic_ns().add(delay_ns))
        return()

// -- helpers -------------------------------------------------------------------------

/// Sleeps the thread until `deadline`, in monotonic_ns.
routine sleep_until(deadline: U64) -> Void
    local never: @U32 <- 0

    jump look()

    block look()
        now: U64 = monotonic_ns()
        done: Bool = now.ge(deadline)
        branch done
            ? return()
            : continue
        wait_on_for(at: never, expected: 0, timeout_ns: deadline.sub(now))
        jump look()

/// The coroutines on the SignalCaster's wait list.
routine count_waiters(sig: @Monitor) -> USize
    local found: @USize <- 0

    jump next(sig.waiters.peek())

    block next(w: @ChannelWaiter)
        branch w.is_null()
            ? return(found.peek())
            : continue
        found.peek().add(1).poke_into(found)
        jump next(w.next.peek())

/// Waits on `sig` from a plain thread until `timeout_ns` has passed, again after every wait that returns 1 (a wait
/// may return without a cast).
/// :returns: The last wait's result, 0 once the time is up.
routine wait_out(sig: @Monitor, timeout_ns: U64) -> U32
    local deadline: U64 = monotonic_ns().add(timeout_ns)

    jump again()

    block again()
        left: U64 = deadline.sub_clamp(monotonic_ns())
        result: U32 = rf_signal_wait_deadline(sig, timeout_ns: left)
        branch result.eq(1)
            ? again()
            : return(result)

// -- the gate ------------------------------------------------------------------------

/// Counts the calling thread in, holding the SignalCaster, and wakes the main thread. A cast takes the SignalCaster
/// itself, so it comes between an unlock and a lock.
routine arrive(gate: @Gate) -> Void
    arrived: USize = gate.arrived.peek().add(1)
    arrived.poke_into(gate.arrived)
    rf_signal_unlock(gate.sig.peek())
    rf_signal_cast_all(gate.sig.peek())
    rf_signal_lock(gate.sig.peek())
    return()

/// Counts the calling thread through, holding the SignalCaster, releases it, and wakes the main thread.
routine pass(gate: @Gate) -> Void
    through: USize = gate.passed.peek().add(1)
    through.poke_into(gate.passed)
    rf_signal_unlock(gate.sig.peek())
    rf_signal_cast_all(gate.sig.peek())
    return()

/// A gate thread that waits for a token and takes it.
routine take_token(gate: @Gate) -> Void
    rf_signal_lock(gate.sig.peek())
    arrive(gate)
    jump look()

    block look()
        left: USize = gate.tokens.peek()
        branch left.gt(0)
            ? take(left)
            : wait()

    block wait()
        rf_signal_wait(gate.sig.peek())
        jump look()

    block take(left: USize)
        gate.tokens.poke(left.sub(1))
        pass(gate)
        return()

/// A gate thread that waits for the gate to open.
routine pass_open(gate: @Gate) -> Void
    rf_signal_lock(gate.sig.peek())
    arrive(gate)
    jump look()

    block look()
        open: Bool = gate.open.peek()
        branch open
            ? through()
            : wait()

    block wait()
        rf_signal_wait(gate.sig.peek())
        jump look()

    block through()
        pass(gate)
        return()

/// Waits, holding the SignalCaster, until `count` gate threads have arrived. Each holds it from arriving until its
/// wait releases it, so all of them wait by then.
routine await_arrived(gate: @Gate, count: USize) -> Void
    jump look()

    block look()
        arrived: USize = gate.arrived.peek()
        branch arrived.ge(count)
            ? return()
            : wait()

    block wait()
        rf_signal_wait(gate.sig.peek())
        jump look()

/// Waits, holding the SignalCaster, until `count` gate threads are through.
routine await_passed(gate: @Gate, count: USize) -> Void
    jump look()

    block look()
        through: USize = gate.passed.peek()
        branch through.ge(count)
            ? return()
            : wait()

    block wait()
        rf_signal_wait(gate.sig.peek())
        jump look()

/// Gives the waiting gate threads one token at a time, each with one cast_one, and waits for one to go through.
/// :returns: Whether each token let exactly one through.
routine hand_tokens(gate: @Gate) -> Bool
    local exact: @Bool <- true

    rf_signal_lock(gate.sig.peek())
    await_arrived(gate, count: GATE_THREADS)
    jump give(1)

    block give(round: USize)
        branch round.gt(GATE_THREADS)
            ? done()
            : continue
        gate.tokens.poke(1)
        rf_signal_unlock(gate.sig.peek())
        rf_signal_cast_one(gate.sig.peek())
        rf_signal_lock(gate.sig.peek())
        await_passed(gate, count: round)
        through: USize = gate.passed.peek()
        one: Bool = through.eq(round).bitand(gate.tokens.peek().eq(0))
        exact.peek().bitand(one).poke_into(exact)
        jump give(round.add(1))

    block done()
        rf_signal_unlock(gate.sig.peek())
        return(exact.peek())

/// Opens the gate once every gate thread waits at it, with one cast_all, and waits for them all to go through.
routine open_gate(gate: @Gate) -> Void
    rf_signal_lock(gate.sig.peek())
    await_arrived(gate, count: GATE_THREADS)
    gate.open.poke(true)
    rf_signal_unlock(gate.sig.peek())
    rf_signal_cast_all(gate.sig.peek())
    rf_signal_lock(gate.sig.peek())
    await_passed(gate, count: GATE_THREADS)
    rf_signal_unlock(gate.sig.peek())
    return()

// -- the test ------------------------------------------------------------------------

/// The handle count, and a coroutine parked by each kind of wait.
routine coroutines(sig: @Monitor) -> Void
    Out.write("handles: {sig.refcount.peek()}\n")
    rf_signal_add_ref(sig)
    Out.write("after add_ref: {sig.refcount.peek()}\n")
    rf_signal_drop(sig)
    Out.write("after drop: {sig.refcount.peek()}\n")
    CURRENT_SCHED.poke(THE_SCHED)
    CURRENT_CORO.poke(THE_CORO)
    CAST_DURING_PARK.poke(sig)
    Out.write("a coroutine waits:\n")
    rf_signal_lock(sig)
    rf_signal_wait(sig)
    Out.write("  back, {count_waiters(sig)} on the wait list\n")
    Out.write("a coroutine waits with a deadline:\n")
    cast: U32 = rf_signal_wait_deadline(sig, timeout_ns: 1000000000)
    Out.write("  result {cast}, {count_waiters(sig)} on the wait list\n")
    CAST_DURING_PARK.poke(null)
    late: U32 = rf_signal_wait_deadline(sig, timeout_ns: 2000000)
    Out.write("  result {late}, {count_waiters(sig)} on the wait list\n")
    rf_signal_unlock(sig)
    sig.waiters.poke(SECOND_WAITER)
    Out.write("two coroutines parked, cast_one:\n")
    rf_signal_cast_one(sig)
    Out.write("cast_all:\n")
    rf_signal_cast_all(sig)
    sig.waiters.poke(null)
    CURRENT_SCHED.poke(null)
    CURRENT_CORO.poke(null)
    return()

routine start() -> Void
    sig: @Monitor = rf_signal_create()
    coroutines(sig)
    rf_signal_lock(sig)
    start: U64 = monotonic_ns()
    result: U32 = wait_out(sig, timeout_ns: 2000000)
    waited: U64 = monotonic_ns().sub(start)
    rf_signal_unlock(sig)
    Out.write("a thread waits with a deadline: result {result}, waited it out {waited.ge(2000000)}\n")
    claim tokens: @Gate <- Gate(sig: sig, arrived: 0, tokens: 0, passed: 0, open: false)
    t1: Thread[Void] = get_thread[Void]()
    t1.put_work(entry: take_token.to[Callable](), args: tokens)
    t2: Thread[Void] = get_thread[Void]()
    t2.put_work(entry: take_token.to[Callable](), args: tokens)
    t3: Thread[Void] = get_thread[Void]()
    t3.put_work(entry: take_token.to[Callable](), args: tokens)
    exact: Bool = hand_tokens(tokens)
    t1.wait_finished()
    t1.give_back()
    t2.wait_finished()
    t2.give_back()
    t3.wait_finished()
    t3.give_back()
    Out.write("cast_one: {GATE_THREADS} tokens, one thread through for each: {exact}\n")
    claim gate: @Gate <- Gate(sig: sig, arrived: 0, tokens: 0, passed: 0, open: false)
    u1: Thread[Void] = get_thread[Void]()
    u1.put_work(entry: pass_open.to[Callable](), args: gate)
    u2: Thread[Void] = get_thread[Void]()
    u2.put_work(entry: pass_open.to[Callable](), args: gate)
    u3: Thread[Void] = get_thread[Void]()
    u3.put_work(entry: pass_open.to[Callable](), args: gate)
    open_gate(gate)
    u1.wait_finished()
    u1.give_back()
    u2.wait_finished()
    u2.give_back()
    u3.wait_finished()
    u3.give_back()
    Out.write("cast_all: {gate.passed.peek()} of {GATE_THREADS} through\n")
    rf_signal_drop(sig)
    return()
