# (hi × 2^64 + lo) / d through Ingrid's word division, checked against big-integer results from a Python model. A
# normalized divisor (top bit set) goes through both entry points, the reciprocal one with rf_reciprocal_word(d) (0 on
# x86-64, where the divide is hardware), and both must agree. Any other divisor goes through rf_udivrem_128_64 alone.
# The cases sit on the edges: the smallest and largest normalized divisors, a quotient of U64.MAX (hi = d - 1, the
# most the precondition hi < d allows), a remainder of d - 1, a zero dividend, divisors on a 32-bit limb boundary,
# and two dividends each for the reciprocal form's two corrections of its quotient estimate (the second one is rare,
# and these were found by searching a Python model of the algorithm).

import Hosted

### A 128-bit dividend as its high and low words.
record Wide
    hi: U64
    lo: U64

### Writes a U64 as 16 lowercase hex digits.
routine write_word(value: U64) -> None
    hex: Hex[U64] = Hex[U64](value: value)
    represent_with_into(out: Console.output(), value: hex, spec: FormatSpec.zero_padded(16))
    return

### Writes one case: the dividend, the divisor, the quotient, and the remainder.
### :param n: The dividend.
### :param d: The divisor.
### :param q: The quotient.
### :param r: The remainder.
routine write_case(n: Wide, d: U64, q: U64, r: U64) -> None
    write_word(n.hi)
    write_word(n.lo)
    Console.show(" / ", end: "")
    write_word(d)
    Console.show(" = ", end: "")
    write_word(q)
    Console.show(" rem ", end: "")
    write_word(r)
    Console.show("")
    return

### A normalized divisor: both entry points, which must give the same quotient and remainder.
routine check_normalized(hi: U64, lo: U64, d: U64) -> None
    rem: &U64 <- 0
    rem_pre: &U64 <- 0

    q: U64 = rf_udivrem_128_64(hi, lo, d, rem)
    v: U64 = rf_reciprocal_word(d)
    q_pre: U64 = rf_udivrem_128_64_pre(hi, lo, d, v, rem: rem_pre)
    same_q: Bool = q == q_pre
    if not (same_q and rem.load() == rem_pre.load())
        throw ForeignError(kind: "LogicBreachedError",
            description: "The reciprocal division disagrees with the plain one.")
    write_case(n: Wide(hi, lo), d, q, r: rem.load())
    return

### Any divisor above hi: the plain entry point.
routine check_plain(hi: U64, lo: U64, d: U64) -> None
    rem: &U64 <- 0

    q: U64 = rf_udivrem_128_64(hi, lo, d, rem)
    write_case(n: Wide(hi, lo), d, q, r: rem.load())
    return

routine start() -> None
    check_normalized(hi: 0, lo: 0, d: 0x8000000000000000)
    check_normalized(hi: 0, lo: 0x7FFFFFFFFFFFFFFF, d: 0x8000000000000000)
    check_normalized(hi: 0, lo: 0x8000000000000000, d: 0x8000000000000000)
    check_normalized(hi: 0x7FFFFFFFFFFFFFFF, lo: U64.MAX, d: 0x8000000000000000)
    check_normalized(hi: 0x7FFFFFFFFFFFFFFF, lo: 0, d: 0x8000000000000000)
    check_normalized(hi: 0, lo: U64.MAX, d: U64.MAX)
    check_normalized(hi: 0xFFFFFFFFFFFFFFFE, lo: U64.MAX, d: U64.MAX)
    check_normalized(hi: 0xFFFFFFFFFFFFFFFE, lo: 0, d: U64.MAX)
    check_normalized(hi: 1, lo: 0, d: 0x8000000000000001)
    check_normalized(hi: 0x8000000000000000, lo: 0, d: 0x8000000000000001)
    check_normalized(hi: 0x8000000000000000, lo: U64.MAX, d: 0x8000000000000001)
    check_plain(hi: 0xFFFFFFFF, lo: U64.MAX, d: 0x100000000)
    check_normalized(hi: 0xDEADBEEF, lo: 0x0123456789ABCDEF, d: 0xFFFFFFFF00000000)
    check_normalized(hi: 0x7FFFFFFFFFFFFFFF, lo: 0xFFFFFFFFFFFFFFFE, d: 0x8000000000000001)
    check_normalized(hi: 0x123456789ABCDEF0, lo: 0xFEDCBA9876543210, d: 0xF000000000000000)
    check_normalized(hi: 0x1027C4D1C386BBC4, lo: 0x1E2FEB89414C343C, d: 0x91B7584A2265B1F5)
    check_normalized(hi: 0x35BF992DC9E9C616, lo: 0x7CE42C8218072E8C, d: 0xE3EE7FD6FEDEDD7B)
    check_normalized(hi: 0x8F192D8888B49373, lo: 0xD4D5875DEB738F63, d: 0x98DBC06B1E74880A)
    check_normalized(hi: 0x8C0CDE997F83E778, lo: 0xC24225782918F47C, d: 0x8F9ABCF77FDF7BFE)
    check_plain(hi: 0, lo: 7, d: 1)
    check_plain(hi: 0, lo: U64.MAX, d: 1)
    check_plain(hi: 0, lo: 100, d: 7)
    check_plain(hi: 5, lo: 0, d: 6)
    check_plain(hi: 0, lo: 0, d: 3)
    check_plain(hi: 2, lo: U64.MAX, d: 3)
    check_plain(hi: 0xFFFE, lo: 0x1234, d: 0xFFFF)
    check_plain(hi: 0x7FFFFFFF, lo: U64.MAX, d: 0x80000000)
    check_plain(hi: 0x80000000, lo: 0, d: 0xFFFFFFFF)
    return
