# The exact binary-float operations Ingrid exports (binfloat_ops.te), each one routine of Tessera's standard library:
# the IEEE remainder, x × 2^n (rounding once into the subnormals), the next value toward another, and the exponent
# of B32 and B64, and the midpoint, the next value, frexp, and logb of B128. binfloat_exact.expected holds the bits,
# checked against Python's math.remainder, math.ldexp, math.nextafter, and math.frexp (B32 through the B64 result
# rounded once to B32).

import Hosted
import Ingrid/Abi

### Prints each case's bits.
routine start() -> None
    Console.show("b64 rem 7 2: {Hex[U64](value: b64_rem(x: 7.0, y: 2.0).bits())}")
    Console.show("b64 rem 5 2: {Hex[U64](value: b64_rem(x: 5.0, y: 2.0).bits())}")
    Console.show("b64 rem -5.5 2: {Hex[U64](value: b64_rem(x: -5.5, y: 2.0).bits())}")
    Console.show("b64 rem 1e300 3: {Hex[U64](value: b64_rem(x: 1.0e300, y: 3.0).bits())}")
    Console.show("b64 mod 7.5 2: {Hex[U64](value: b64_mod_trunc(x: 7.5, y: 2.0).bits())}")
    Console.show("b64 scalbn 1.5 -1074: {Hex[U64](value: b64_scalbn(x: 1.5, n: -1074).bits())}")
    Console.show("b64 scalbn 3 -1075: {Hex[U64](value: b64_scalbn(x: 3.0, n: -1075).bits())}")
    Console.show("b64 scalbn 1 2000: {Hex[U64](value: b64_scalbn(x: 1.0, n: 2000).bits())}")
    Console.show("b64 scalbn min 2097: {Hex[U64](value: b64_scalbn(x: B64.from_bits(1), n: 2097).bits())}")
    Console.show("b64 next 1 2: {Hex[U64](value: b64_nextafter(x: 1.0, y: 2.0).bits())}")
    Console.show("b64 next 0 -1: {Hex[U64](value: b64_nextafter(x: 0.0, y: -1.0).bits())}")
    Console.show("b64 ilogb 0.75: {b64_ilogb(x: 0.75)} min {b64_ilogb(x: B64.from_bits(1))}")
    Console.show("b32 rem 7 2: {Hex[U32](value: b32_rem(x: 7.0, y: 2.0).bits())}")
    Console.show("b32 scalbn 1.5 -149: {Hex[U32](value: b32_scalbn(x: 1.5, n: -149).bits())}")
    Console.show("b32 scalbn 1 300: {Hex[U32](value: b32_scalbn(x: 1.0, n: 300).bits())}")
    Console.show("b32 next 1 0: {Hex[U32](value: b32_nextafter(x: 1.0, y: 0.0).bits())}")
    Console.show("b32 ilogb 1e-40: {b32_ilogb(x: B32.from_bits(0x000116C2))}")
    one: U64 = 0x3FFF000000000000
    two: U64 = 0x4000000000000000
    mid: Words = b128_midpoint(low: 0, high: one, y_low: 0, y_high: two)
    Console.show("b128 mid 1 2: {Hex[U64](value: mid.w1)} {Hex[U64](value: mid.w0)}")
    top: Words = b128_midpoint(low: 0xFFFFFFFFFFFFFFFF, high: 0x7FFEFFFFFFFFFFFF,
        y_low: 0xFFFFFFFFFFFFFFFF, y_high: 0x7FFEFFFFFFFFFFFF)
    Console.show("b128 mid max max: {Hex[U64](value: top.w1)} {Hex[U64](value: top.w0)}")
    next: Words = b128_nextafter(low: 0, high: one, y_low: 0, y_high: 0)
    Console.show("b128 next 1 0: {Hex[U64](value: next.w1)} {Hex[U64](value: next.w0)}")
    f: Words = b128_frexp(low: 0, high: 0x4002400000000000)
    Console.show("b128 frexp 10: {Hex[U64](value: f.w1)} {Hex[U64](value: f.w0)} {f.w2.to_wrap[S64]()}")
    l: Words = b128_logb(low: 0, high: 0x4002400000000000)
    Console.show("b128 logb 10: {Hex[U64](value: l.w1)} {Hex[U64](value: l.w0)}")
    return
