# The decimal transcendentals (Ingrid/tessera/decimal/dec_trans.te) at D32, D64, and D128: exp, expm1, exp2,
# exp10, the logarithms, the circular, inverse circular, hyperbolic, and inverse hyperbolic functions, erf, erfc,
# tgamma, lgamma, cbrt, pow, and atan2, on arguments shaped for each: near 1 in magnitude, next to 1 (where asin,
# acos, atanh, and log1p cancel), tiny, large enough to overflow, small integers and halves (the poles of gamma,
# exact powers), zeros, infinities, and NaNs. Each line is "width function a b result" (BID bits as decimal
# integers, b 0 for the one-argument functions). decimal_trans.expected was checked line by line against mpmath at
# 1500 digits rounded half to even to the format: every finite result is the correctly rounded value, reduced (its
# trailing zeros stripped), and the special cases follow C99.

import Standard/Format
import Standard/Os

global STATE: @U64 <- 0x6A09E667F3BCC908

### The two arguments' bits of one line (0 for an argument the function doesn't take).
record Arguments
    a: U128
    b: U128

### The next word of the generator.
### :returns: The next word.
routine draw() -> U64
    next: U64 = splitmix64(STATE.peek())
    next.poke_into(STATE)
    return next

### A coefficient of exactly p digits.
### :param p: The digits of the format.
### :returns: The coefficient.
routine full_coefficient(p: S64) -> U128
    low: U128 = dec_p10_128(p - 1)
    span: U128 = low * 9
    high: U128 = draw().to[U128]() << 64
    r: U128 = high | draw().to[U128]()
    return low + r % span

### An argument for a function of format f, shaped by a random mode.
### :param f: The format.
### :returns: The argument.
routine argument(f: DecFormat) -> Dec
    local r: U64 = draw()
    local neg: Bool = r & 1 == 1
    local p: S64 = f.digits
    local pick: U64 = r >> 8

    mode: U64 = (r >> 1) % 16
    when mode
        0, 1, 2, 3, 4, 5 =>
            # a full coefficient with its adjusted exponent at adj
            adj: S64 = (pick % 6).to[S64]() - 3
            return dec_num(neg, coeff: full_coefficient(p), exp: adj - p + 1)
        6, 7 =>
            # 1 minus (or plus) a few units in the last places
            top: U128 = dec_p10_128(p)
            units: U128 = (pick % 1000 + 1).to[U128]()
            below: Bool = (r >> 20) & 1 == 1
            c: U128 = when
                below => top - units
                else => top + units
            return dec_num(neg, coeff: c, exp: -p)
        8 =>
            adj: S64 = (pick % 50).to[S64]() - 60
            return dec_num(neg, coeff: full_coefficient(p), exp: adj - p + 1)
        9 =>
            adj: S64 = (pick % 5).to[S64]() + 2
            return dec_num(neg, coeff: full_coefficient(p), exp: adj - p + 1)
        10, 11 =>
            # k or k + 1/2 for k up to 40
            k: U128 = ((r >> 8) % 41).to[U128]()
            if (r >> 16) & 1 == 1
                return dec_num(neg, coeff: k * 10 + 5, exp: -1)
            else
                return dec_num(neg, coeff: k, exp: 0)
        12 => return dec_inf(neg)
        13 => return dec_nan()
        14 => return dec_num(neg, coeff: 0, exp: (pick % 9).to[S64]() - 4)
        else =>
            adj: S64 = (pick % 3).to[S64]() - 1
            return dec_num(neg, coeff: full_coefficient(p), exp: adj - p + 1)

### The name of a DEC_ function code.
### :param fn: The code.
### :returns: The name.
routine fn_name(fn: U32) -> @[Byte]
    when fn
        0 => return "exp"
        1 => return "exp_m1"
        2 => return "exp2"
        3 => return "exp10"
        4 => return "ln"
        5 => return "ln_1p"
        6 => return "log2"
        7 => return "log10"
        8 => return "asin"
        9 => return "acos"
        10 => return "atan"
        11 => return "sinh"
        12 => return "cosh"
        13 => return "tanh"
        14 => return "asinh"
        15 => return "acosh"
        16 => return "atanh"
        17 => return "erf"
        18 => return "erfc"
        19 => return "gamma"
        20 => return "ln_gamma"
        21 => return "sin"
        22 => return "cos"
        23 => return "tan"
        24 => return "cbrt"
        25 => return "pow"
        else => return "atan2"

### A decimal's BID bits at the width of its format.
### :param x: The decimal.
### :param width: 32, 64, or 128.
### :returns: The bits.
routine bits(x: Dec, width: U64) -> U128
    when width
        32 => return x.to32().to[U128]()
        64 => return x.to64().to[U128]()
        else => return x.to128()

### An exponent for pow: a small integer half of the time, else an argument.
### :param f: The format.
### :returns: The exponent.
routine power(f: DecFormat) -> Dec
    local r: U64 = draw()

    small: Bool = r & 1 == 1
    k: U128 = ((r >> 8) % 6).to[U128]()
    neg: Bool = (r >> 16) & 1 == 1
    if small
        return dec_num(neg, coeff: k, exp: 0)
    else
        return argument(f)

### Prints count lines of function fn at format f.
### :param fn: The DEC_ code.
### :param f: The format.
### :param width: Its width in bits.
### :param count: How many lines.
routine run(fn: U32, f: DecFormat, width: U64, count: U64) -> None
    each i in 0 til count
        a: Dec = argument(f)
        when fn
            25 =>
                b: Dec = power(f)
                show(width, name: "pow",
                    arguments: Arguments(a: bits(x: a, width), b: bits(x: b, width)),
                    r: bits(x: dec_pow(x: a, y: b, f), width))
            26 =>
                b: Dec = argument(f)
                show(width, name: "atan2",
                    arguments: Arguments(a: bits(x: a, width), b: bits(x: b, width)),
                    r: bits(x: dec_atan2(y: a, x: b, f), width))
            else => show(width, name: fn_name(fn), arguments: Arguments(a: bits(x: a, width), b: 0),
                r: bits(x: dec_unary(fn, x: a, f), width))
    then
        return

### Prints one line.
### :param width: The width in bits.
### :param name: The function.
### :param arguments: The arguments' bits.
### :param r: The result's bits.
routine show(width: U64, name: @[Byte], arguments: Arguments, r: U128) -> None
    a: U128 = arguments.a
    b: U128 = arguments.b
    Console.show("{width} {name} {a} {b} {r}")
    return

### Every function at format f.
### :param f: The format.
### :param width: Its width in bits.
### :param count: Lines per function.
routine run_all(f: DecFormat, width: U64, count: U64) -> None
    while fn <= 26 with fn: U32 = 0
        run(fn, f, width, count)
        continue with fn: fn + 1
    then
        return

### Prints the lines.
routine start() -> None
    run_all(f: dec_format32(), width: 32, count: 24)
    run_all(f: dec_format64(), width: 64, count: 16)
    run_all(f: dec_format128(), width: 128, count: 8)
    return
