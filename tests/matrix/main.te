# The 2x2, 3x3 and 4x4 inverse and solve exports of Ingrid/tessera/matrix.te, as RazorForge calls them, and the 2x2
# and 3x3 determinants. Each line is the result's singular mark or its sixteen values' bits in decimal, column after
# column (nan for a NaN, whose sign bit the target picks). The expected output comes from a Python model of the
# same elimination in B32 arithmetic (each step rounded to B32), so these lines lock the bits. The cases are
# regular matrices, a zero column (singular at the first pivot), a matrix that is singular only after pivoting, a
# matrix that needs a row swap, and the raw results of the unchecked inverse of singular matrices.

import Hosted

### Writes a value's bits, or nan.
### :param v: The value.
routine show_value(v: B32) -> None
    if v.is_nan()
        Console.show(" nan", end: "")
        return
    Console.show(" {v.bits()}", end: "")
    return

### Writes a result: singular, or its values column after column.
### :param label: What the line shows.
### :param r: The result.
routine show_result(label: @[Byte], r: MatrixResult) -> None
    if r.singular != 0
        Console.show("{label} singular")
        return
    Console.show("{label}", end: "")
    show_value(r.m00)
    show_value(r.m10)
    show_value(r.m20)
    show_value(r.m30)
    show_value(r.m01)
    show_value(r.m11)
    show_value(r.m21)
    show_value(r.m31)
    show_value(r.m02)
    show_value(r.m12)
    show_value(r.m22)
    show_value(r.m32)
    show_value(r.m03)
    show_value(r.m13)
    show_value(r.m23)
    show_value(r.m33)
    Console.show("")
    return

### Writes a B32's bits.
### :param label: What the line shows.
### :param v: The value.
routine show_b32(label: @[Byte], v: B32) -> None
    Console.show("{label} {v.bits()}")
    return

routine start() -> None
    show_result(label: "m2 regular inverse",
        r: m2_inverse(m00: B32.from_bits(0x40800000), m01: B32.from_bits(0x40E00000), m10: B32.from_bits(0x40000000), m11: B32.from_bits(0x40C00000)))
    show_b32(label: "m2 regular determinant",
        v: m2_determinant(m00: B32.from_bits(0x40800000), m01: B32.from_bits(0x40E00000), m10: B32.from_bits(0x40000000), m11: B32.from_bits(0x40C00000)))
    show_result(label: "m2 swap inverse",
        r: m2_inverse(m00: B32.from_bits(0x00000000), m01: B32.from_bits(0x3F800000), m10: B32.from_bits(0x3F800000), m11: B32.from_bits(0x00000000)))
    show_b32(label: "m2 swap determinant",
        v: m2_determinant(m00: B32.from_bits(0x00000000), m01: B32.from_bits(0x3F800000), m10: B32.from_bits(0x3F800000), m11: B32.from_bits(0x00000000)))
    show_result(label: "m2 zero column inverse",
        r: m2_inverse(m00: B32.from_bits(0x00000000), m01: B32.from_bits(0x3F800000), m10: B32.from_bits(0x00000000), m11: B32.from_bits(0x40000000)))
    show_b32(label: "m2 zero column determinant",
        v: m2_determinant(m00: B32.from_bits(0x00000000), m01: B32.from_bits(0x3F800000), m10: B32.from_bits(0x00000000), m11: B32.from_bits(0x40000000)))
    show_result(label: "m2 after pivot inverse",
        r: m2_inverse(m00: B32.from_bits(0x3F800000), m01: B32.from_bits(0x40000000), m10: B32.from_bits(0x40000000), m11: B32.from_bits(0x40800000)))
    show_b32(label: "m2 after pivot determinant",
        v: m2_determinant(m00: B32.from_bits(0x3F800000), m01: B32.from_bits(0x40000000), m10: B32.from_bits(0x40000000), m11: B32.from_bits(0x40800000)))
    show_result(label: "m3 regular inverse",
        r: m3_inverse(m00: B32.from_bits(0x40000000), m01: B32.from_bits(0xBF800000), m02: B32.from_bits(0x00000000), m10: B32.from_bits(0xBF800000), m11: B32.from_bits(0x40000000), m12: B32.from_bits(0xBF800000), m20: B32.from_bits(0x00000000), m21: B32.from_bits(0xBF800000), m22: B32.from_bits(0x40000000)))
    show_b32(label: "m3 regular determinant",
        v: m3_determinant(m00: B32.from_bits(0x40000000), m01: B32.from_bits(0xBF800000), m02: B32.from_bits(0x00000000), m10: B32.from_bits(0xBF800000), m11: B32.from_bits(0x40000000), m12: B32.from_bits(0xBF800000), m20: B32.from_bits(0x00000000), m21: B32.from_bits(0xBF800000), m22: B32.from_bits(0x40000000)))
    show_result(label: "m3 dense inverse",
        r: m3_inverse(m00: B32.from_bits(0x3F800000), m01: B32.from_bits(0x40000000), m02: B32.from_bits(0x40400000), m10: B32.from_bits(0x40800000), m11: B32.from_bits(0x40A00000), m12: B32.from_bits(0x40C00000), m20: B32.from_bits(0x40E00000), m21: B32.from_bits(0x41000000), m22: B32.from_bits(0x41200000)))
    show_b32(label: "m3 dense determinant",
        v: m3_determinant(m00: B32.from_bits(0x3F800000), m01: B32.from_bits(0x40000000), m02: B32.from_bits(0x40400000), m10: B32.from_bits(0x40800000), m11: B32.from_bits(0x40A00000), m12: B32.from_bits(0x40C00000), m20: B32.from_bits(0x40E00000), m21: B32.from_bits(0x41000000), m22: B32.from_bits(0x41200000)))
    show_result(label: "m3 zero column inverse",
        r: m3_inverse(m00: B32.from_bits(0x00000000), m01: B32.from_bits(0x3F800000), m02: B32.from_bits(0x40000000), m10: B32.from_bits(0x00000000), m11: B32.from_bits(0x40400000), m12: B32.from_bits(0x40800000), m20: B32.from_bits(0x00000000), m21: B32.from_bits(0x40A00000), m22: B32.from_bits(0x40C00000)))
    show_b32(label: "m3 zero column determinant",
        v: m3_determinant(m00: B32.from_bits(0x00000000), m01: B32.from_bits(0x3F800000), m02: B32.from_bits(0x40000000), m10: B32.from_bits(0x00000000), m11: B32.from_bits(0x40400000), m12: B32.from_bits(0x40800000), m20: B32.from_bits(0x00000000), m21: B32.from_bits(0x40A00000), m22: B32.from_bits(0x40C00000)))
    show_result(label: "m3 after pivot inverse",
        r: m3_inverse(m00: B32.from_bits(0x3F800000), m01: B32.from_bits(0x40000000), m02: B32.from_bits(0x40400000), m10: B32.from_bits(0x40000000), m11: B32.from_bits(0x40800000), m12: B32.from_bits(0x40C00000), m20: B32.from_bits(0x3F800000), m21: B32.from_bits(0x3F800000), m22: B32.from_bits(0x3F800000)))
    show_b32(label: "m3 after pivot determinant",
        v: m3_determinant(m00: B32.from_bits(0x3F800000), m01: B32.from_bits(0x40000000), m02: B32.from_bits(0x40400000), m10: B32.from_bits(0x40000000), m11: B32.from_bits(0x40800000), m12: B32.from_bits(0x40C00000), m20: B32.from_bits(0x3F800000), m21: B32.from_bits(0x3F800000), m22: B32.from_bits(0x3F800000)))
    show_result(label: "m4 identity inverse",
        r: m4_inverse(m00: B32.from_bits(0x3F800000), m01: B32.from_bits(0x00000000), m02: B32.from_bits(0x00000000), m03: B32.from_bits(0x00000000), m10: B32.from_bits(0x00000000), m11: B32.from_bits(0x3F800000), m12: B32.from_bits(0x00000000), m13: B32.from_bits(0x00000000), m20: B32.from_bits(0x00000000), m21: B32.from_bits(0x00000000), m22: B32.from_bits(0x3F800000), m23: B32.from_bits(0x00000000), m30: B32.from_bits(0x00000000), m31: B32.from_bits(0x00000000), m32: B32.from_bits(0x00000000), m33: B32.from_bits(0x3F800000)))
    show_result(label: "m4 scaling translation inverse",
        r: m4_inverse(m00: B32.from_bits(0x40000000), m01: B32.from_bits(0x00000000), m02: B32.from_bits(0x00000000), m03: B32.from_bits(0x3F800000), m10: B32.from_bits(0x00000000), m11: B32.from_bits(0x40800000), m12: B32.from_bits(0x00000000), m13: B32.from_bits(0x40000000), m20: B32.from_bits(0x00000000), m21: B32.from_bits(0x00000000), m22: B32.from_bits(0x41000000), m23: B32.from_bits(0x40400000), m30: B32.from_bits(0x00000000), m31: B32.from_bits(0x00000000), m32: B32.from_bits(0x00000000), m33: B32.from_bits(0x3F800000)))
    show_result(label: "m4 repeated column inverse",
        r: m4_inverse(m00: B32.from_bits(0x3F800000), m01: B32.from_bits(0x40000000), m02: B32.from_bits(0x00000000), m03: B32.from_bits(0x40A00000), m10: B32.from_bits(0x40000000), m11: B32.from_bits(0x40800000), m12: B32.from_bits(0x3F800000), m13: B32.from_bits(0x00000000), m20: B32.from_bits(0x40400000), m21: B32.from_bits(0x40C00000), m22: B32.from_bits(0x00000000), m23: B32.from_bits(0x3F800000), m30: B32.from_bits(0x40800000), m31: B32.from_bits(0x41000000), m32: B32.from_bits(0x3F800000), m33: B32.from_bits(0x40000000)))
    show_result(label: "m4 regular inverse",
        r: m4_inverse(m00: B32.from_bits(0x40800000), m01: B32.from_bits(0x40400000), m02: B32.from_bits(0x40000000), m03: B32.from_bits(0x3F800000), m10: B32.from_bits(0x40400000), m11: B32.from_bits(0x40800000), m12: B32.from_bits(0x40400000), m13: B32.from_bits(0x40000000), m20: B32.from_bits(0x40000000), m21: B32.from_bits(0x40400000), m22: B32.from_bits(0x40800000), m23: B32.from_bits(0x40400000), m30: B32.from_bits(0x3F800000), m31: B32.from_bits(0x40000000), m32: B32.from_bits(0x40400000), m33: B32.from_bits(0x40800000)))
    show_result(label: "m4 tenths inverse",
        r: m4_inverse(m00: B32.from_bits(0x3DCCCCCD), m01: B32.from_bits(0xBECCCCCD), m02: B32.from_bits(0x3F333333), m03: B32.from_bits(0x3F800000), m10: B32.from_bits(0x3E4CCCCD), m11: B32.from_bits(0x3F000000), m12: B32.from_bits(0x3F4CCCCD), m13: B32.from_bits(0x40000000), m20: B32.from_bits(0x3E99999A), m21: B32.from_bits(0x3F19999A), m22: B32.from_bits(0xBF666666), m23: B32.from_bits(0x40400000), m30: B32.from_bits(0x00000000), m31: B32.from_bits(0x00000000), m32: B32.from_bits(0x00000000), m33: B32.from_bits(0x3F800000)))
    show_result(label: "m4 halves inverse",
        r: m4_inverse(m00: B32.from_bits(0x3FC00000), m01: B32.from_bits(0xC0400000), m02: B32.from_bits(0x00000000), m03: B32.from_bits(0x40000000), m10: B32.from_bits(0xBF400000), m11: B32.from_bits(0x3F000000), m12: B32.from_bits(0x3F800000), m13: B32.from_bits(0x40000000), m20: B32.from_bits(0x3E800000), m21: B32.from_bits(0x40000000), m22: B32.from_bits(0xBF800000), m23: B32.from_bits(0x3E800000), m30: B32.from_bits(0x40800000), m31: B32.from_bits(0x3F800000), m32: B32.from_bits(0x3F000000), m33: B32.from_bits(0xC0400000)))
    show_result(label: "m4 zero inverse",
        r: m4_inverse(m00: B32.from_bits(0x00000000), m01: B32.from_bits(0x00000000), m02: B32.from_bits(0x00000000), m03: B32.from_bits(0x00000000), m10: B32.from_bits(0x00000000), m11: B32.from_bits(0x00000000), m12: B32.from_bits(0x00000000), m13: B32.from_bits(0x00000000), m20: B32.from_bits(0x00000000), m21: B32.from_bits(0x00000000), m22: B32.from_bits(0x00000000), m23: B32.from_bits(0x00000000), m30: B32.from_bits(0x00000000), m31: B32.from_bits(0x00000000), m32: B32.from_bits(0x00000000), m33: B32.from_bits(0x00000000)))
    show_result(label: "m4 after pivot inverse",
        r: m4_inverse(m00: B32.from_bits(0xC0000000), m01: B32.from_bits(0xC0400000), m02: B32.from_bits(0x40400000), m03: B32.from_bits(0xC0400000), m10: B32.from_bits(0xC0800000), m11: B32.from_bits(0xC0800000), m12: B32.from_bits(0x40400000), m13: B32.from_bits(0x40800000), m20: B32.from_bits(0x40400000), m21: B32.from_bits(0x40400000), m22: B32.from_bits(0xC0400000), m23: B32.from_bits(0xC0000000), m30: B32.from_bits(0x3F800000), m31: B32.from_bits(0x3F800000), m32: B32.from_bits(0x00000000), m33: B32.from_bits(0xC0000000)))
    show_result(label: "m2 solve",
        r: m2_solve(m00: B32.from_bits(0x40000000), m01: B32.from_bits(0x3F800000), m10: B32.from_bits(0x3F800000), m11: B32.from_bits(0x40400000), b0: B32.from_bits(0x40A00000), b1: B32.from_bits(0x41200000)))
    show_result(label: "m2 solve swap",
        r: m2_solve(m00: B32.from_bits(0x00000000), m01: B32.from_bits(0x3F800000), m10: B32.from_bits(0x3F800000), m11: B32.from_bits(0x00000000), b0: B32.from_bits(0x40000000), b1: B32.from_bits(0x40400000)))
    show_result(label: "m2 solve singular",
        r: m2_solve(m00: B32.from_bits(0x3F800000), m01: B32.from_bits(0x40000000), m10: B32.from_bits(0x40000000), m11: B32.from_bits(0x40800000), b0: B32.from_bits(0x3F800000), b1: B32.from_bits(0x3F800000)))
    show_result(label: "m3 solve",
        r: m3_solve(m00: B32.from_bits(0x3F800000), m01: B32.from_bits(0x3F800000), m02: B32.from_bits(0x3F800000), m10: B32.from_bits(0x00000000), m11: B32.from_bits(0x40000000), m12: B32.from_bits(0x40A00000), m20: B32.from_bits(0x40000000), m21: B32.from_bits(0x40A00000), m22: B32.from_bits(0xBF800000), b0: B32.from_bits(0x40C00000), b1: B32.from_bits(0xC0800000), b2: B32.from_bits(0x41D80000)))
    show_result(label: "m3 solve singular",
        r: m3_solve(m00: B32.from_bits(0x3F800000), m01: B32.from_bits(0x40000000), m02: B32.from_bits(0x40400000), m10: B32.from_bits(0x40000000), m11: B32.from_bits(0x40800000), m12: B32.from_bits(0x40C00000), m20: B32.from_bits(0x3F800000), m21: B32.from_bits(0x3F800000), m22: B32.from_bits(0x3F800000), b0: B32.from_bits(0x3F800000), b1: B32.from_bits(0x40000000), b2: B32.from_bits(0x40400000)))
    show_result(label: "m4 solve",
        r: m4_solve(m00: B32.from_bits(0x40800000), m01: B32.from_bits(0x40400000), m02: B32.from_bits(0x40000000), m03: B32.from_bits(0x3F800000), m10: B32.from_bits(0x40400000), m11: B32.from_bits(0x40800000), m12: B32.from_bits(0x40400000), m13: B32.from_bits(0x40000000), m20: B32.from_bits(0x40000000), m21: B32.from_bits(0x40400000), m22: B32.from_bits(0x40800000), m23: B32.from_bits(0x40400000), m30: B32.from_bits(0x3F800000), m31: B32.from_bits(0x40000000), m32: B32.from_bits(0x40400000), m33: B32.from_bits(0x40800000), b0: B32.from_bits(0x00000000), b1: B32.from_bits(0xC0800000), b2: B32.from_bits(0xC0800000), b3: B32.from_bits(0xC1200000)))
    show_result(label: "m4 solve singular",
        r: m4_solve(m00: B32.from_bits(0xC0000000), m01: B32.from_bits(0xC0400000), m02: B32.from_bits(0x40400000), m03: B32.from_bits(0xC0400000), m10: B32.from_bits(0xC0800000), m11: B32.from_bits(0xC0800000), m12: B32.from_bits(0x40400000), m13: B32.from_bits(0x40800000), m20: B32.from_bits(0x40400000), m21: B32.from_bits(0x40400000), m22: B32.from_bits(0xC0400000), m23: B32.from_bits(0xC0000000), m30: B32.from_bits(0x3F800000), m31: B32.from_bits(0x3F800000), m32: B32.from_bits(0x00000000), m33: B32.from_bits(0xC0000000), b0: B32.from_bits(0x3F800000), b1: B32.from_bits(0x3F800000), b2: B32.from_bits(0x3F800000), b3: B32.from_bits(0x3F800000)))
    show_result(label: "m2 unchecked regular",
        r: m2_inverse_unchecked(m00: B32.from_bits(0x40800000), m01: B32.from_bits(0x40E00000), m10: B32.from_bits(0x40000000), m11: B32.from_bits(0x40C00000)))
    show_result(label: "m2 unchecked after pivot",
        r: m2_inverse_unchecked(m00: B32.from_bits(0x3F800000), m01: B32.from_bits(0x40000000), m10: B32.from_bits(0x40000000), m11: B32.from_bits(0x40800000)))
    show_result(label: "m3 unchecked zero column",
        r: m3_inverse_unchecked(m00: B32.from_bits(0x00000000), m01: B32.from_bits(0x3F800000), m02: B32.from_bits(0x40000000), m10: B32.from_bits(0x00000000), m11: B32.from_bits(0x40400000), m12: B32.from_bits(0x40800000), m20: B32.from_bits(0x00000000), m21: B32.from_bits(0x40A00000), m22: B32.from_bits(0x40C00000)))
    show_result(label: "m4 unchecked zero",
        r: m4_inverse_unchecked(m00: B32.from_bits(0x00000000), m01: B32.from_bits(0x00000000), m02: B32.from_bits(0x00000000), m03: B32.from_bits(0x00000000), m10: B32.from_bits(0x00000000), m11: B32.from_bits(0x00000000), m12: B32.from_bits(0x00000000), m13: B32.from_bits(0x00000000), m20: B32.from_bits(0x00000000), m21: B32.from_bits(0x00000000), m22: B32.from_bits(0x00000000), m23: B32.from_bits(0x00000000), m30: B32.from_bits(0x00000000), m31: B32.from_bits(0x00000000), m32: B32.from_bits(0x00000000), m33: B32.from_bits(0x00000000)))
    return
