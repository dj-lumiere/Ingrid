// The inverse of the zero quaternion divides 1 by a squared norm of 0, which crashes with RazorForge's
// DivisionByZeroError, as RazorForge's checked B32 `/` does (quaternion.tess and finite.tess). The program's own crash
// handler writes the crash's name and message to standard output and exits with status 82, RazorForge's crash status.

import Standard/Format
import Standard/Os

#[export("tessera_crash_handler"), noreturn]
routine report(name: Bytes, message: Bytes, place: @SourceLocation) -> Void
    Out.write("{name}: {message}\n")
    exit(82)

routine start() -> Void
    Out.write("before\n")
    inverse: Words = q128_reciprocal(w: 0.0, x: 0.0, y: 0.0, z: 0.0)
    Out.write("not reached {inverse.w0}\n")
    return()
