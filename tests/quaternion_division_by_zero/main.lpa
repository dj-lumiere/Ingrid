# The inverse of the zero quaternion divides 1 by a squared norm of 0, which crashes with Revare's
# DivisionByZeroError, as Revare's checked B32 `/` does (quaternion.lpa and finite.lpa). The program's own crash
# handler writes the crash's name and message to standard output and exits with status 82, Revare's crash status.

import Hosted
import Ingrid/Abi

@untraced
routine report(name: @[Byte], message: @CrashMessage, place: @SourceLocation) -> None
    Console.show("{name}: {message.text()}")
    ProcessManager.exit_process(82)

routine start() -> None
    Crash.report_with(report.to[Callable]())
    Console.show("before")
    inverse: Words = q128_reciprocal(w: 0.0, x: 0.0, y: 0.0, z: 0.0)
    Console.show("not reached {inverse.w0}")
    return
