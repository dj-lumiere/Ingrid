# A crash in Tessera code (Standard/System's crash, as Ingrid's own checks raise) reaches crash.te's handler, which
# set_library_folder puts in the Crash service's slot at startup, as a program's entry does: the program exits with the runtime's crash status (82) through
# rf_crash_exit, not the default handler's 101, after flushing standard output. The report itself (on standard
# error) names the place by this file's path, which depends on where the test runs, so crash_report and
# crash_trace_ring check its text instead.
#
# The handler calls the RazorForge runtime library's routines, which this program defines itself: the flush (it
# says so on standard output), the crash exit, and an empty trace.

import Standard/Hosted

@export("rf_flush_output")
routine stub_flush_output() -> None
    Console.show("[standard output flushed]")
    return

@export("rf_crash_exit")
@noreturn
routine stub_crash_exit() -> None
    Console.show("[crash exit]")
    ProcessManager.exit_process(82)

@export("_rf_trace_get_depth_shared")
routine stub_trace_depth() -> S32
    return 0

@export("_rf_trace_get_frames_shared")
routine stub_trace_frames() -> Addr
    return .hollow()

routine start() -> None
    set_library_folder(.hollow())
    Console.show("before the crash")
    throw ForeignError(kind: "ConfigurationError", description: "The configuration file is missing.")
