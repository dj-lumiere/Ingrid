// A crash in Tessera code (Standard::Core's crash, as Ingrid's own checks raise) reaches crash.tess's handler, which
// takes the place of the standard library's default: the program exits with the runtime's crash status (82) through
// rf_crash_exit, not the default handler's 101, after flushing standard output. The report itself (on standard
// error) names the place by this file's path, which depends on where the test runs, so crash_report and
// crash_trace_ring check its text instead.
//
// The handler calls the RazorForge runtime library's routines, which this program defines itself: the flush (it
// says so on standard output), the crash exit, and an empty trace.

import Standard::Format
import Standard::Os

#export("rf_flush_output")
routine stub_flush_output() -> Void
    block entry()
        Out.write("[standard output flushed]\n")
        return()

#[export("rf_crash_exit"), noreturn]
routine stub_crash_exit() -> Void
    block entry()
        Out.write("[crash exit]\n")
        exit(82)

#export("_rf_trace_get_depth_shared")
routine stub_trace_depth() -> S32
    block entry()
        return(0)

#export("_rf_trace_get_frames_shared")
routine stub_trace_frames() -> Addr
    block entry()
        return(null)

routine main() -> S32
    block entry()
        Out.write("before the crash\n")
        crash("ConfigurationError", "The configuration file is missing.")
