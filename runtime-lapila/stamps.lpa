# Revare's `Stamped[E]` goes through the same PoolManager table as Lapila's (Standard/System/Memory/Stamped.lpa):
# a stamp is a slot of the table and the slot's generation. An entity type the program stamps keeps its slot and the
# slot's generation in eight bytes the builder adds after the entity's member variables (a U32 each), so a later
# stamp reads only the entity, and the builder hands this file where they are. The
# table is set up with HEAP on the first stamp. A Revare entity stays at one address from its construction to its
# destruct (what moves is the reference to it), so only the destruct ends a slot. The fetch is in Ingrid/lapila/
# stamps.lpa, linked into each program so it inlines: it reads the table through the two globals the PoolManager
# exports.

module Ingrid/Runtime

import Hosted

### A stamp of the entity at `at`: its slot, taken on the first stamp and kept with its generation in the entity's
### eight bytes at `offset`, and the slot's generation.
### :param at: The entity.
### :param offset: Where in the entity its slot is, in bytes from `at` (0 in it for none yet).
### :returns: The slot in the low 32 bits, the generation in the high 32 bits.
### :throws: Crashes with `OutOfMemoryError` when the table has no memory for a new slot.
@export("rf_stamp_take")
routine rf_stamp_take(at: Addr, offset: S64) -> U64
    place: @U32 = at.to[@Byte]().stride(offset).to[@U32]()
    taken: U32 = place.peek()
    if taken != 0
        return stamp_bits(taken)
    if not PoolManager.is_set_up()
        PoolManager.set_up(memory: HEAP)
    fresh: U32 = PoolManager.take(at)
    place.poke(fresh)
    place.stride(1).poke(PoolManager.generation(fresh))
    return stamp_bits(fresh)

### A slot and its generation in one U64.
### :param slot: The slot.
### :returns: The slot in the low 32 bits, the generation in the high 32 bits.
routine stamp_bits(slot: U32) -> U64
    return slot.to[U64]() | (PoolManager.generation(slot).to[U64]() << 32)

### Ends the slot an entity keeps, if it has one: the entity's destruct calls it, and every stamp of it fails from then
### on.
### :param at: The entity.
### :param offset: Where in the entity its slot is, in bytes from `at`.
@export("rf_stamp_release")
routine rf_stamp_release(at: Addr, offset: S64) -> None
    place: @U32 = at.to[@Byte]().stride(offset).to[@U32]()
    taken: U32 = place.peek()
    if taken == 0
        return
    place.poke(0)
    place.stride(1).poke(0)
    PoolManager.end(taken)
    return
