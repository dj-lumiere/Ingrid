# The table behind Revare's `Stamped[E]`, kept for Revare until Revare switches to the pool: a stamp is a slot of this
# table and the slot's generation, and an entity type the program stamps keeps its slot and generation in eight bytes
# the builder adds after the entity's member variables (a U32 each). This is the table Lapila's PoolManager had before
# Lapila's own stamps became pool stamps (System/Memory/PoolManager.lpa), moved here so Revare's runtime keeps working.
# The table is set up with HEAP on the first stamp. A Revare entity stays at one address from its construction to its
# destruct, so only the destruct ends a slot. The fetch is in Ingrid/lapila/stamps.lpa, linked into each program so it
# inlines: it reads the table through the two globals exported here under C names.

module Ingrid/Runtime

import Hosted

### The address of the directory: one Addr per chunk. Exported, with STAMP_NEXT, for a language runtime that reads a
### stamp's entry in its own code (Revare's fetch, Ingrid/lapila/stamps.lpa): the same reads as `RevareStampTable.lookup`.
@export("lapila_stamp_directory")
secret global STAMP_DIRECTORY: &Addr
### How many chunk addresses the directory has room for.
secret global STAMP_DIRECTORY_ROOM: &U64
### How many chunks there are.
secret global STAMP_CHUNKS: &U64
### The slot after the last one ever taken, 0 before the first.
@export("lapila_stamp_next")
secret global STAMP_NEXT: &U32
### The first free slot, 0 for none.
secret global STAMP_FREE: &U32
### 1 while a flow takes or ends a slot.
secret global STAMP_LOCK: &U32
### Where the chunks come from, None before set_up.
secret global STAMP_MEMORY: &(@MemoryManager?)

### How many entries a chunk holds.
secret preset STAMP_CHUNK_SLOTS: U64 = 4096

### The table of Revare's stamps, one per program. Its routines are called on the type, and its state is its own globals.
record RevareStampTable
    nothing

### One entry of the table: 16 bytes.
secret record StampEntry
    ### The entity's address while it lives, zero after it ends.
    at: Addr
    ### Goes up each time the entity in the slot ends.
    generation: U32
    ### The next free slot after this one, while this one is free.
    next_free: U32

### Sets the table up: its chunks come from `memory`. A program calls it once, in `start`, before its first `stamp()`.
### :param memory: The memory manager the chunks come from.
### :throws: Throws `UnacceptedValueError` when the table is set up already.
common routine RevareStampTable.set_up(memory: @MemoryManager) -> None
    lock_stamps()
    when STAMP_MEMORY.load()
        is @MemoryManager =>
            unlock_stamps()
            throw UnacceptedValueError(description: "The RevareStampTable is set up already: call RevareStampTable.set_up(memory: m) once, in start.")
        is None => nothing
    STAMP_MEMORY.store(memory)
    unlock_stamps()
    return

### Whether `set_up` was called: a language runtime sets the table up on its first stamp.
### :returns: True once the table is set up.
common routine RevareStampTable.is_set_up() -> Bool
    when STAMP_MEMORY.load()
        is @MemoryManager => return true
        is None => return false

### The manager the chunks come from: the one `set_up` named.
### :returns: The manager.
### :throws: Throws `UnacceptedValueError` when `set_up` wasn't called.
secret routine stamp_memory() -> @MemoryManager
    when STAMP_MEMORY.load()
        is @MemoryManager as memory => return memory
        is None =>
            throw UnacceptedValueError(description: "A stamp needs the RevareStampTable, and nothing set it up: call RevareStampTable.set_up(memory: HEAP) in start, before the first stamp().")

### Takes the table's lock.
@target(os: not "none")
secret routine lock_stamps() -> None
    loop
        if STAMP_LOCK.swap_unbroken(1) == 0
            return

### Gives the table's lock back.
@target(os: not "none")
secret routine unlock_stamps() -> None
    STAMP_LOCK.poke_unbroken(0)
    return

### Reads a word of the table that another thread may write, unbroken.
### :typeparam T: The word's type.
### :param at: The word.
### :returns: Its value.
@target(os: not "none")
@inline
secret routine stamp_read[T](at: @T) -> T
needs T obeys UnbrokenStorable
    return at.peek_unbroken[ACQUIRE]()

### Writes a word of the table that another thread may read, unbroken.
### :typeparam T: The word's type.
### :param at: The word.
### :param value: What it holds from now on.
@target(os: not "none")
@inline
secret routine stamp_write[T](at: @T, value: T) -> None
needs T obeys UnbrokenStorable
    at.poke_unbroken(value)
    return

### The entry of a slot that was taken once: the chunk from the directory, then the entry in it. No lock.
### :param slot: The slot, not 0.
### :returns: The entry.
@inline
secret routine stamp_entry(slot: U32) -> @StampEntry
    directory: @Addr = stamp_read(STAMP_DIRECTORY).to[@Addr]()
    chunk: Addr = stamp_read(directory.stride((slot >> 12).to[U64]()))
    return chunk.to[@StampEntry]().stride((slot & 4095).to[U64]())

### Adds a chunk, and a directory twice the size when the directory is full. The directory it replaces stays. Called
### with the lock held.
### :throws: Throws `OutOfMemoryError` when the manager has no memory.
secret routine add_stamp_chunk() -> None
    memory: @MemoryManager = stamp_memory()
    chunks: U64 = STAMP_CHUNKS.load()
    room: U64 = STAMP_DIRECTORY_ROOM.load()
    if chunks == room
        grown: U64 = when
            room == 0 => 4
            else => room * 2
        fresh: Addr = allocate[Addr](count: grown, manager: memory)
        if fresh.is_hollow()
            throw OutOfMemoryError()
        if chunks > 0
            fresh.to[@Addr]().copy(src: STAMP_DIRECTORY.load().to[@Addr](), count: chunks)
        stamp_write(STAMP_DIRECTORY, value: fresh)
        STAMP_DIRECTORY_ROOM.store(grown)
    chunk: Addr = allocate[StampEntry](count: STAMP_CHUNK_SLOTS, manager: memory)
    if chunk.is_hollow()
        throw OutOfMemoryError()
    chunk.to[@StampEntry]().zeroinit(STAMP_CHUNK_SLOTS)
    directory: @Addr = STAMP_DIRECTORY.load().to[@Addr]()
    stamp_write(directory.stride(chunks), value: chunk)
    STAMP_CHUNKS.store(chunks + 1)
    return

### Takes a slot for the entity at `at`: a free one, else the next one never used. For a language runtime that keeps
### the slot itself (Revare's): a Lapila program takes stamps with `stamp()`.
### :param at: The entity's address.
### :returns: The slot.
### :throws: Throws `OutOfMemoryError` when there is no memory for a chunk, or every slot is taken.
common routine RevareStampTable.take(at: Addr) -> U32
    lock_stamps()
    free: U32 = STAMP_FREE.load()
    if free != 0
        entry: @StampEntry = stamp_entry(free)
        STAMP_FREE.store(entry.next_free.peek())
        entry.next_free.poke(0)
        stamp_write(entry.at, value: at)
        unlock_stamps()
        return free
    next: U32 = when
        STAMP_NEXT.load() == 0 => 1
        else => STAMP_NEXT.load()
    if next == U32.MAX
        unlock_stamps()
        throw OutOfMemoryError()
    if (next >> 12).to[U64]() == STAMP_CHUNKS.load()
        add_stamp_chunk()
    STAMP_NEXT.store(next + 1)
    stamp_write(stamp_entry(next).at, value: at)
    unlock_stamps()
    return next

### The generation of a slot that is taken. For a language runtime that keeps the slot itself.
### :param slot: The slot.
### :returns: Its generation.
@inline
common routine RevareStampTable.generation(slot: U32) -> U32
    return stamp_read(stamp_entry(slot).generation)

### Ends the entity in a slot: its address is cleared and its generation goes up, so its stamps fail, and the slot is
### free for the next stamp. A slot whose generation reaches U32.MAX is retired instead. For a language runtime that
### keeps the slot itself.
### :param slot: The slot.
common routine RevareStampTable.end(slot: U32) -> None
    lock_stamps()
    entry: @StampEntry = stamp_entry(slot)
    stamp_write(entry.at, value: Addr.zero())
    generation: U32 = entry.generation.peek()
    if generation == U32.MAX
        unlock_stamps()
        return
    stamp_write(entry.generation, value: generation + 1)
    entry.next_free.poke(STAMP_FREE.load())
    STAMP_FREE.store(slot)
    unlock_stamps()
    return

### A stamp of the entity at `at`: its slot, taken on the first stamp and kept with its generation in the entity's
### eight bytes at `offset`, and the slot's generation.
### :param at: The entity.
### :param offset: Where in the entity its slot is, in bytes from `at` (0 in it for none yet).
### :returns: The slot in the low 32 bits, the generation in the high 32 bits.
### :throws: Crashes with `OutOfMemoryError` when the table has no memory for a new slot.
@export("rf_stamp_take")
routine rf_stamp_take(at: Addr, offset: S64) -> U64
    place: @U32 = at.to[@Byte]().stride(offset).to[@U32]()
    taken: U32 = place.peek()
    if taken != 0
        return stamp_bits(taken)
    if not RevareStampTable.is_set_up()
        RevareStampTable.set_up(memory: HEAP)
    fresh: U32 = RevareStampTable.take(at)
    place.poke(fresh)
    place.stride(1).poke(RevareStampTable.generation(fresh))
    return stamp_bits(fresh)

### A slot and its generation in one U64.
### :param slot: The slot.
### :returns: The slot in the low 32 bits, the generation in the high 32 bits.
routine stamp_bits(slot: U32) -> U64
    return slot.to[U64]() | (RevareStampTable.generation(slot).to[U64]() << 32)

### Ends the slot an entity keeps, if it has one: the entity's destruct calls it, and every stamp of it fails from then
### on.
### :param at: The entity.
### :param offset: Where in the entity its slot is, in bytes from `at`.
@export("rf_stamp_release")
routine rf_stamp_release(at: Addr, offset: S64) -> None
    place: @U32 = at.to[@Byte]().stride(offset).to[@U32]()
    taken: U32 = place.peek()
    if taken == 0
        return
    place.poke(0)
    place.stride(1).poke(0)
    RevareStampTable.end(taken)
    return
