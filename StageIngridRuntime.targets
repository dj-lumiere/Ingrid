<Project>
  <!-- Ingrid's runtime staging, imported by every project that runs the builder.
       Stage Ingrid's native runtime DLLs next to the output at BUILD TIME, not via an evaluation-time
       Content glob. On a clean build, Ingrid\native\build\bin does not exist yet when a project is
       EVALUATED (Anvila's native build produces it, racing under parallel `dotnet build`), so an
       evaluation-time `<Content Include="...**" Condition="Exists(...)">` captures nothing and the
       razorforge_runtime P/Invoke fails with DllNotFoundException (0x8007007E). Resolving the files when
       this target RUNS, after the Anvila reference (which builds the native runtime) has completed, is
       reliable on both clean and incremental builds. A project reference does not carry the referenced
       project's Content, so every project that runs the builder imports this. -->
  <Target Name="StageIngridRuntime" AfterTargets="Build">
    <ItemGroup>
      <_IngridRuntimeFile Include="$(MSBuildThisFileDirectory)native\build\bin\**\*.*"/>
      <_IngridRuntimeFile Include="$(MSBuildThisFileDirectory)native\build\lib\**\*.*"/>
    </ItemGroup>
    <Copy SourceFiles="@(_IngridRuntimeFile)"
          DestinationFiles="@(_IngridRuntimeFile->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_IngridRuntimeFile)' != ''"/>
  </Target>
</Project>
